{
  "name": "nexus-royale",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "NEXUS ROYALE: shooter 3D original en tercera persona para navegador (núcleo de simulación TypeScript + cliente Three.js).",
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p src/client",
    "test": "tsc && node --test dist/tests/*.test.js",
    "build:core": "tsc",
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "test:e2e": "vite build && node tools/build-artifact.mjs && node tests/e2e/run.mjs",
    "build:artifact": "vite build && node tools/build-artifact.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  }
}
