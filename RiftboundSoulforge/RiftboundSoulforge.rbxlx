local function buildGarden(parent: Instance)
	local model = Build.model(parent, "SocialGarden")
	local c = P.SocialGarden
	Build.cylinder(model, 44, 0.4, c + Vector3.new(0, 0.2, 0), Color3.fromRGB(80, 120, 70), Enum.Material.Grass, "Lawn")
	Build.cylinder(model, 12, 2, c + Vector3.new(0, 1, 0), MARBLE, Enum.Material.Marble, "FountainBase")
	local water = Build.cylinder(model, 10, 0.4, c + Vector3.new(0, 2.1, 0), Color3.fromRGB(90, 170, 255), Enum.Material.Glass, "Water")
	water.Transparency = 0.3
	local jet = Build.neon(model, Vector3.new(1, 6, 1), CFrame.new(c + Vector3.new(0, 5, 0)), Color3.fromRGB(150, 210, 255), "Jet")
	Build.particles(jet, Color3.fromRGB(180, 220, 255), 30, { acceleration = Vector3.new(0, -20, 0), speed = NumberRange.new(8, 12), spread = Vector2.new(25, 25) })
	for i = 1, 6 do
		local angle = i / 6 * math.pi * 2
		local pos = c + Vector3.new(math.cos(angle) * 14, 0, math.sin(angle) * 14)
		local cf = facing(pos, c)
		Build.block(model, Vector3.new(6, 0.6, 2), cf * CFrame.new(0, 1.6, 0), Color3.fromRGB(120, 86, 60), Enum.Material.WoodPlanks, "Bench")
		Build.block(model, Vector3.new(6, 2, 0.4), cf * CFrame.new(0, 2.6, 1), Color3.fromRGB(120, 86, 60), Enum.Material.WoodPlanks, "BenchBack")
		Build.tree(model, c + Vector3.new(math.cos(angle + 0.5) * 20, 0, math.sin(angle + 0.5) * 20), 0.8, i % 2 == 0)
	end
	Build.sign(model, "THE GATHERING GARDEN", CFrame.new(c + Vector3.new(0, 1.5, 22)) * CFrame.new(0, 3, 0), Vector2.new(12, 2), nil, Color3.fromRGB(190, 255, 200))
end

local function buildEchoes(parent: Instance)
	local model = Build.model(parent, "HallOfEchoes")
	local c = P.HallOfEchoes
	local cf = facing(c, Vector3.zero)
	Build.block(model, Vector3.new(30, 1, 16), cf * CFrame.new(0, 0.5, 0), TRIM, Enum.Material.Marble, "Floor")
	local board = Build.sign(model, "HALL OF ECHOES", cf * CFrame.new(0, 9, 7), Vector2.new(22, 12), Color3.fromRGB(24, 20, 34), Color3.fromRGB(230, 220, 255))
	board.Name = "EchoBoard"
	local label = board:FindFirstChildWhichIsA("SurfaceGui", true):FindFirstChildWhichIsA("TextLabel")
	if label then
		label.Name = "Text"
		label.TextScaled = true
		label.Font = Enum.Font.GothamBold
	end
	for i = -2, 2 do
		local pos = (cf * CFrame.new(i * 5, 0, 2)).Position
		Build.cylinder(model, 2.5, 3, pos + Vector3.new(0, 1.5, 0), MARBLE, Enum.Material.Marble, "Pedestal")
		local relic = Build.part(model, {
			size = Vector3.new(1.4, 1.4, 1.4),
			cframe = CFrame.new(pos + Vector3.new(0, 4.2, 0)) * CFrame.Angles(math.rad(45), math.rad(i * 20), 0),
			color = Color3.fromHSV((i + 2) / 5, 0.6, 1),
			material = Enum.Material.Neon,
			collide = false,
			name = "Relic",
		})
		relic:SetAttribute("Spin", 0.8)
	end
	station(model, "EchoStation", c, "Codex", "Open", "Codex & Achievements", "Codex")
end

local function buildKiosk(parent: Instance)
	local model = Build.model(parent, "CosmeticKiosk")
	local c = P.CosmeticKiosk
	local cf = facing(c, Vector3.zero)
	Build.block(model, Vector3.new(10, 3, 4), cf * CFrame.new(0, 1.5, 0), Color3.fromRGB(70, 50, 90), Enum.Material.WoodPlanks, "Counter")
	for _, x in { -4.5, 4.5 } do
		Build.block(model, Vector3.new(0.6, 9, 0.6), cf * CFrame.new(x, 4.5, 1.5), Color3.fromRGB(60, 40, 70), Enum.Material.Wood, "Pole")
	end
	Build.part(model, { size = Vector3.new(12, 0.6, 6), cframe = cf * CFrame.new(0, 9, 0.5) * CFrame.Angles(math.rad(10), 0, 0), color = Color3.fromRGB(200, 90, 200), material = Enum.Material.Fabric, name = "Canopy" })
	Build.sign(model, "STYLE KIOSK", cf * CFrame.new(0, 10.5, -2.2), Vector2.new(9, 1.6), nil, Color3.fromRGB(255, 190, 255))
	station(model, "KioskStation", c, "Store", "Browse", "Cosmetics", "Store")
end

local function buildAnnouncement(parent: Instance)
	local model = Build.model(parent, "Announcement")
	local p = P.Announcement
	local board = Build.part(model, {
		size = Vector3.new(36, 10, 0.6),
		cframe = CFrame.new(p),
		color = Color3.fromRGB(16, 14, 24),
		material = Enum.Material.SmoothPlastic,
		collide = false,
		name = "AnnouncementBoard",
	})
	Build.neon(model, Vector3.new(37, 0.4, 0.8), CFrame.new(p + Vector3.new(0, 5.2, 0)), RIFT, "Trim")
	Build.neon(model, Vector3.new(37, 0.4, 0.8), CFrame.new(p - Vector3.new(0, 5.2, 0)), RIFT, "Trim")
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.CanvasSize = Vector2.new(1440, 400)
	gui.LightInfluence = 0
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(0.94, 0.86)
	label.Position = UDim2.fromScale(0.03, 0.07)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = Color3.fromRGB(230, 225, 255)
	label.Text = "THE NEXUS"
	label.Parent = gui
	-- a duplicate face so it reads from both sides
	local back = gui:Clone()
	back.Face = Enum.NormalId.Front
	back.Parent = board
end

local function buildSignposts(parent: Instance)
	local model = Build.model(parent, "Signposts")
	local entries = {
		{ "FORGE", P.Forge },
		{ "FUSION", P.FusionChamber },
		{ "TRAINING", P.TrainingArena },
		{ "RIFT PORTAL", P.ExpeditionPortal },
		{ "WARDEN GATE", P.BossGate },
		{ "HALL OF ECHOES", P.HallOfEchoes },
	}
	for i, entry in entries do
		local target = entry[2]
		local dir = Vector3.new(target.X, 0, target.Z)
		dir = if dir.Magnitude > 0 then dir.Unit else Vector3.new(0, 0, 1)
		local pos = dir * 24
		Build.block(model, Vector3.new(0.6, 7, 0.6), CFrame.new(pos + Vector3.new(0, 3.5, 0)), Color3.fromRGB(90, 70, 50), Enum.Material.Wood, "Post")
		local sign = Build.sign(model, entry[1], CFrame.lookAt(pos + Vector3.new(0, 6.5, 0), pos + Vector3.new(0, 6.5, 0) - dir) * CFrame.new(0, 0, 0), Vector2.new(7, 1.4), Color3.fromRGB(50, 40, 34), Color3.fromRGB(255, 230, 180))
		sign.Name = "Signpost" .. i
	end
end

function Nexus.build(world: Instance)
	local folder = Build.folder(world, "Nexus")
	buildPlaza(folder)
	buildSpire(folder)
	for _, target in { P.Forge, P.FusionChamber, P.TrainingArena, P.ExpeditionPortal, P.QuestBoard, P.BossGate, P.SocialGarden, P.HallOfEchoes, P.CosmeticKiosk, P.ArtisanBench } do
		path(folder, Vector3.zero, target, 10)
	end
	decorate(folder)
	buildForge(folder)
	buildBench(folder)
	buildFusion(folder)
	buildTraining(folder)
	buildPortal(folder)
	buildQuestBoard(folder)
	buildBossGate(folder)
	buildGarden(folder)
	buildEchoes(folder)
	buildKiosk(folder)
	buildAnnouncement(folder)
	buildSignposts(folder)
	-- ambient lanterns along the plaza ring
	for i = 1, 12 do
		local angle = i / 12 * math.pi * 2 + 0.13
		Build.torch(folder, Vector3.new(math.cos(angle) * 58, 0, math.sin(angle) * 58), if i % 2 == 0 then GOLD else RIFT)
	end
end

return Nexus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">TerrainGen</string>
            <string name="Source"><![CDATA[--!strict
-- Smooth Terrain dressing: grass with blade decoration, dirt trails, rolling hills, mountain
-- ranges, lava beds and floating rock. Gameplay floors stay as (now invisible) Parts at y = 0,
-- so collision and telegraph raycasts are unchanged; terrain surfaces sit flush on top.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local WorldConfig = require(Shared.Config.WorldConfig)

local TerrainGen = {}

local E = WorldConfig.EmberfallOrigin
local M = Enum.Material

local function at(x: number, z: number, y: number?): Vector3
	return E + Vector3.new(x, y or 0, z)
end

local function hide(world: Instance, names: { string })
	for _, inst in world:GetDescendants() do
		if inst:IsA("BasePart") and table.find(names, inst.Name) then
			inst.Transparency = 1
		end
	end
end

-- Fills a slab whose TOP is at y = 0 (terrain voxels are 4 studs; keep slabs >= 4 thick).
local function slab(terrain: Terrain, center: Vector3, sizeX: number, sizeZ: number, depth: number, material: Enum.Material)
	terrain:FillBlock(CFrame.new(center.X, center.Y - depth / 2, center.Z), Vector3.new(sizeX, depth, sizeZ), material)
end

local function hills(terrain: Terrain, rng: Random, x1: number, x2: number, z: number, step: number)
	for x = x1, x2, step do
		local r = rng:NextNumber(28, 46)
		local p = at(x + rng:NextNumber(-8, 8), z + rng:NextNumber(-10, 10), rng:NextNumber(4, 16))
		terrain:FillBall(p, r, M.Rock)
		terrain:FillBall(p + Vector3.new(0, r * 0.55, 0), r * 0.55, M.Grass)
		if rng:NextNumber() < 0.4 then
			terrain:FillBall(p + Vector3.new(rng:NextNumber(-15, 15), r * 0.9, 0), r * 0.35, M.LeafyGrass)
		end
	end
end

function TerrainGen.build(world: Instance)
	local terrain = workspace.Terrain
	local rng = Random.new(99)

	-- Stylised autumn palette
	terrain:SetMaterialColor(M.Grass, Color3.fromRGB(126, 140, 62))
	terrain:SetMaterialColor(M.LeafyGrass, Color3.fromRGB(198, 122, 56))
	terrain:SetMaterialColor(M.Ground, Color3.fromRGB(116, 86, 60))
	terrain:SetMaterialColor(M.Rock, Color3.fromRGB(104, 90, 84))
	terrain:SetMaterialColor(M.Basalt, Color3.fromRGB(46, 40, 54))
	terrain:SetMaterialColor(M.CrackedLava, Color3.fromRGB(255, 110, 40))
	terrain:SetMaterialColor(M.Pebble, Color3.fromRGB(120, 112, 104))
	terrain.WaterColor = Color3.fromRGB(70, 120, 170)
	terrain.WaterTransparency = 0.6
	terrain.WaterWaveSize = 0.1
	terrain.WaterReflectance = 0.4
	if not terrain:FindFirstChildOfClass("Clouds") then
		local clouds = Instance.new("Clouds")
		clouds.Cover = 0.55
		clouds.Density = 0.55
		clouds.Color = Color3.fromRGB(255, 226, 210)
		clouds.Parent = terrain
	end

	-- The Nexus: grass island with rocky underside and floating islets.
	terrain:FillCylinder(CFrame.new(0, -4, 0), 8, 168, M.Grass)
	for i = 1, 16 do
		local angle = i / 16 * math.pi * 2
		local r = rng:NextNumber(110, 150)
		terrain:FillBall(Vector3.new(math.cos(angle) * r, -46, math.sin(angle) * r), rng:NextNumber(26, 36), M.Rock)
	end
	terrain:FillBall(Vector3.new(0, -100, 0), 85, M.Rock)
	terrain:FillBall(Vector3.new(0, -170, 0), 55, M.Basalt)
	for i = 1, 8 do
		local angle = i / 8 * math.pi * 2 + 0.3
		local p = Vector3.new(math.cos(angle) * 260, rng:NextNumber(-10, 40), math.sin(angle) * 260)
		local r = rng:NextNumber(14, 24)
		terrain:FillBall(p, r, M.Rock)
		terrain:FillBall(p + Vector3.new(0, r * 0.6, 0), r * 0.6, M.Grass)
	end

	-- Emberfall ground: grass with leafy autumn patches and a dirt trail.
	slab(terrain, at(109, 0), 306, 200, 12, M.Grass)
	for _ = 1, 40 do
		local x, z = rng:NextNumber(70, 255), rng:NextNumber(-92, 92)
		slab(terrain, at(x, z), rng:NextNumber(10, 24), rng:NextNumber(10, 24), 4, M.LeafyGrass)
	end
	slab(terrain, at(109, 0), 306, 12, 4, M.Ground)
	slab(terrain, at(10, 0), 80, 100, 4, M.Ground) -- camp clearing
	slab(terrain, at(176, 0), 60, 60, 4, M.Pebble) -- outpost courtyard

	-- Keep plateau
	slab(terrain, at(442, 0), 205, 200, 12, M.Ground)
	for _ = 1, 24 do
		slab(terrain, at(rng:NextNumber(345, 540), rng:NextNumber(-95, 95)), rng:NextNumber(8, 18), rng:NextNumber(8, 18), 4, M.Pebble)
	end

	-- Mountain ranges framing the valley (outside the playable cliffs).
	hills(terrain, rng, -60, 560, -165, 34)
	hills(terrain, rng, -60, 560, 165, 34)
	for z = -120, 120, 40 do
		local p = at(-90, z, 10)
		terrain:FillBall(p, 45, M.Rock)
		terrain:FillBall(p + Vector3.new(0, 26, 0), 24, M.Grass)
	end

	-- Cinder Ravine: cracked lava bed and basalt outcrops on the walls.
	terrain:FillBlock(CFrame.new(at(301, 0, -36)), Vector3.new(78, 8, 200), M.CrackedLava)
	for _ = 1, 14 do
		local side = if rng:NextNumber() < 0.5 then 262 else 340
		terrain:FillBall(at(side, rng:NextNumber(-95, 95), rng:NextNumber(-26, -6)), rng:NextNumber(5, 9), M.Basalt)
	end

	-- The Fracture Arena floats on a basalt mass with drifting shards.
	local arena = WorldConfig.Arena.center
	terrain:FillBall(arena + Vector3.new(0, -70, 0), 62, M.Basalt)
	terrain:FillBall(arena + Vector3.new(0, -130, 0), 34, M.Basalt)
	terrain:FillBall(at(562, 0, -26), 20, M.Basalt) -- under the approach walkway
	for i = 1, 6 do
		local angle = i / 6 * math.pi * 2
		terrain:FillBall(arena + Vector3.new(math.cos(angle) * 120, rng:NextNumber(-20, 25), math.sin(angle) * 120), rng:NextNumber(8, 14), M.Basalt)
	end

	-- Parts that the terrain now visually replaces (they keep their collision).
	hide(world, { "Island", "FrontierGround", "Trail", "KeepGround" })
end

return TerrainGen
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="77">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="EnableMouseLockOption">false</bool>
      <token name="GameSettingsAvatar">1</token>
    </Properties>
    <Item class="StarterPlayerScripts" referent="78">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="79">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--!strict
-- Client-side mirror of server state. Purely for display: the server owns every value here.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)

local ClientState = {}

ClientState.profile = nil :: any
ClientState.meta = nil :: any -- { state = "Loaded"|"Temporary", reason }
ClientState.expedition = { region = nil, depth = 0, expedition = false, satchel = { coins = 0, items = {} }, loss = 0 } :: any
ClientState.party = nil :: any
ClientState.boss = nil :: any
ClientState.worldEvent = nil :: any
ClientState.trial = nil :: any
ClientState.cooldowns = {} :: { [string]: { endsAt: number, duration: number } }
ClientState.lockTarget = nil :: Model?

ClientState.Changed = Signal.new() -- (key)

-- Notification sink is injected by NotificationController (avoids a require cycle).
ClientState.toast = function(_kind: string, _text: string, _extra: any?) end

local DEFAULT_SETTINGS = {
	cameraShake = 1,
	effects = 1,
	music = 0.5,
	sfx = 0.8,
	hudScale = 1,
	reducedClutter = false,
	highContrastTelegraphs = false,
}

function ClientState.settings(): any
	local profile = ClientState.profile
	return (profile and profile.settings) or DEFAULT_SETTINGS
end

function ClientState.set(key: string, value: any)
	(ClientState :: any)[key] = value
	ClientState.Changed:Fire(key)
end

-- Sends a request to the server. Shows a toast with the server's message.
function ClientState.request(kind: string, args: any?, silent: boolean?): (boolean, string?, any)
	local ok, a, b, c = pcall(function()
		return Net.func("Request"):InvokeServer(kind, args or {})
	end)
	if not ok then
		ClientState.toast("Error", "Connection problem. Try again.")
		return false, "Connection problem", nil
	end
	if not silent and b then
		ClientState.toast(if a then "Success" else "Error", b)
	end
	return a == true, b, c
end

function ClientState.serverNow(): number
	return workspace:GetServerTimeNow()
end

function ClientState.init()
	Net.event("ProfileSync").OnClientEvent:Connect(function(profile, meta)
		ClientState.profile = profile
		ClientState.meta = meta
		ClientState.Changed:Fire("profile")
	end)
	Net.event("ExpeditionSync").OnClientEvent:Connect(function(data)
		ClientState.expedition = data
		ClientState.Changed:Fire("expedition")
	end)
	Net.event("PartySync").OnClientEvent:Connect(function(data)
		ClientState.party = data
		ClientState.Changed:Fire("party")
	end)
	Net.event("BossState").OnClientEvent:Connect(function(data)
		ClientState.boss = data
		ClientState.Changed:Fire("boss")
	end)
	Net.event("WorldEvent").OnClientEvent:Connect(function(data)
		ClientState.worldEvent = data
		ClientState.Changed:Fire("worldEvent")
	end)
	Net.event("TrialSync").OnClientEvent:Connect(function(data)
		ClientState.trial = data
		ClientState.Changed:Fire("trial")
	end)
	task.spawn(function()
		task.wait(1)
		ClientState.request("Sync", {}, true)
	end)
	Net.event("Cooldown").OnClientEvent:Connect(function(slot, endsAt, duration)
		ClientState.cooldowns[slot] = { endsAt = endsAt, duration = duration }
		ClientState.Changed:Fire("cooldowns")
	end)
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="81">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">AnimationController</string>
              <string name="Source"><![CDATA[--!strict
-- Full-body procedural keyframe animator (no asset ids needed).
-- Poses are authored below as per-joint Euler offsets (degrees) applied on top of each
-- Motor6D's rest C0, interpolated with easing every frame. Every client animates every
-- character from replicated "Swing/Cast/Dodge/Awaken" effects, so all players see them.
-- If you upload real animations, put their ids in AudioConfig.Animations and they are used
-- instead (Animator tracks), keeping this file as the fallback.
--
-- R15 joint frames: +X on a shoulder/hip swings the limb forward/up, +Z on the right shoulder
-- raises it sideways (-Z for the left), +Y on Waist turns the chest to the character's left,
-- -X on knees/elbows bends them backwards/forwards respectively.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local AudioConfig = require(Shared.Config.AudioConfig)

local AnimationController = {}

type Pose = { [string]: { number } } -- joint -> { rx, ry, rz, px?, py?, pz? }
type Key = { t: number, pose: Pose, ease: string? }
type Clip = { keys: { Key }, hold: boolean? }

local R15_JOINTS = {
	Root = { "LowerTorso", "Root" },
	Waist = { "UpperTorso", "Waist" },
	Neck = { "Head", "Neck" },
	RShoulder = { "RightUpperArm", "RightShoulder" },
	RElbow = { "RightLowerArm", "RightElbow" },
	LShoulder = { "LeftUpperArm", "LeftShoulder" },
	LElbow = { "LeftLowerArm", "LeftElbow" },
	RHip = { "RightUpperLeg", "RightHip" },
	RKnee = { "RightLowerLeg", "RightKnee" },
	LHip = { "LeftUpperLeg", "LeftHip" },
	LKnee = { "LeftLowerLeg", "LeftKnee" },
}
-- R6 fallback: only the arms are driven (its joint frames differ), mapped approximately.
local R6_JOINTS = {
	RShoulder = { "Torso", "Right Shoulder" },
	LShoulder = { "Torso", "Left Shoulder" },
}

local REST: Pose = {}

-- Pose library ---------------------------------------------------------------------------------
local P = {
	-- Light 1: wide horizontal cut, right to left
	L1a = { Waist = { 0, -40, 0 }, RShoulder = { 70, 0, 75 }, RElbow = { 25, 0, 0 }, LShoulder = { 20, 0, -20 }, Root = { 0, 0, 0, 0, -0.2, 0 } },
	L1b = { Waist = { 5, 45, 0 }, RShoulder = { 85, 0, -35 }, RElbow = { 5, 0, 0 }, LShoulder = { -20, 0, -35 }, LHip = { 25, 0, 0 }, RHip = { -15, 0, 0 }, Root = { 0, 0, 0, 0, -0.35, 0 } },
	-- Light 2: backhand, left to right
	L2a = { Waist = { 0, 40, 0 }, RShoulder = { 90, 0, -45 }, RElbow = { 40, 0, 0 }, LShoulder = { 30, 0, -10 } },
	L2b = { Waist = { 5, -50, 0 }, RShoulder = { 75, 0, 85 }, RElbow = { 5, 0, 0 }, LShoulder = { -15, 0, -40 }, RHip = { 25, 0, 0 }, LHip = { -15, 0, 0 }, Root = { 0, 0, 0, 0, -0.3, 0 } },
	-- Light 3: rising diagonal
	L3a = { Waist = { 20, -25, 0 }, RShoulder = { 10, 0, 35 }, RElbow = { 15, 0, 0 }, Root = { 0, 0, 0, 0, -0.55, 0 }, RHip = { 35, 0, 0 }, RKnee = { -45, 0, 0 } },
	L3b = { Waist = { -12, 35, 0 }, RShoulder = { 165, 0, -25 }, RElbow = { 0, 0, 0 }, LShoulder = { 40, 0, -50 }, Neck = { -10, 0, 0 }, Root = { 0, 0, 0, 0, 0.1, 0 } },
	-- Light 4 (finisher): two-handed overhead cleave
	L4a = { Waist = { -18, 0, 0 }, RShoulder = { 172, 0, 5 }, LShoulder = { 165, 0, -5 }, RElbow = { 20, 0, 0 }, LElbow = { 20, 0, 0 }, Neck = { -15, 0, 0 }, Root = { 0, 0, 0, 0, 0.4, 0 } },
	L4b = { Waist = { 35, 0, 0 }, RShoulder = { 35, 0, 0 }, LShoulder = { 35, 0, 0 }, Neck = { 10, 0, 0 }, RHip = { 45, 0, 0 }, RKnee = { -60, 0, 0 }, LHip = { -30, 0, 0 }, Root = { 0, 0, 0, 0, -0.9, 0 } },
	-- Light 5 (Tempest): flurry thrust
	L5a = { Waist = { 0, -35, 0 }, RShoulder = { 60, 0, 15 }, RElbow = { 95, 0, 0 }, LShoulder = { 70, 0, -30 } },
	L5b = { Waist = { 10, 25, 0 }, RShoulder = { 92, 0, 0 }, RElbow = { 0, 0, 0 }, LShoulder = { -30, 0, -30 }, RHip = { 35, 0, 0 }, LHip = { -25, 0, 0 }, Root = { 0, 0, 0, 0, -0.4, -0.4 } },
	-- Heavy: crouch wind-up, explosive slam
	Ha = { Waist = { -25, -20, 0 }, RShoulder = { 178, 0, 15 }, LShoulder = { 150, 0, -25 }, RElbow = { 30, 0, 0 }, LElbow = { 30, 0, 0 }, RHip = { 30, 0, 0 }, RKnee = { -45, 0, 0 }, LHip = { 20, 0, 0 }, LKnee = { -35, 0, 0 }, Root = { 0, 0, 0, 0, -0.6, 0 } },
	Hb = { Waist = { 40, 10, 0 }, RShoulder = { 25, 0, 10 }, LShoulder = { 30, 0, -10 }, Neck = { 15, 0, 0 }, RHip = { 55, 0, 0 }, RKnee = { -70, 0, 0 }, LHip = { -35, 0, 0 }, Root = { 0, 0, 0, 0, -1.0, -0.3 } },
	-- Guard stance (blade across the body)
	Block = { Waist = { 5, -20, 0 }, RShoulder = { 75, 0, -15 }, RElbow = { 70, 0, 0 }, LShoulder = { 65, 0, -35 }, LElbow = { 55, 0, 0 }, RHip = { 15, 0, 0 }, RKnee = { -20, 0, 0 }, Root = { 0, 0, 0, 0, -0.35, 0 } },
	-- Dodge dash: low forward lean, arms trailing (ninja run)
	Dodge = { Waist = { 30, 0, 0 }, RShoulder = { -60, 0, 15 }, LShoulder = { -60, 0, -15 }, Neck = { -20, 0, 0 }, RHip = { 55, 0, 0 }, RKnee = { -75, 0, 0 }, LHip = { -25, 0, 0 }, LKnee = { -30, 0, 0 }, Root = { 0, 0, 0, 0, -0.7, 0 } },
	-- Essence cast: left palm thrust
	Ca = { Waist = { 0, 35, 0 }, LShoulder = { 40, 0, -60 }, LElbow = { 60, 0, 0 }, RShoulder = { -20, 0, 20 } },
	Cb = { Waist = { 5, -35, 0 }, LShoulder = { 95, 0, -5 }, LElbow = { 0, 0, 0 }, RShoulder = { -30, 0, 30 }, LHip = { 25, 0, 0 }, Root = { 0, 0, 0, 0, -0.3, 0 } },
	-- Awakening: gather then burst open
	Aa = { Waist = { 30, 0, 0 }, RShoulder = { 60, 0, -30 }, LShoulder = { 60, 0, 30 }, RElbow = { 90, 0, 0 }, LElbow = { 90, 0, 0 }, Neck = { 25, 0, 0 }, Root = { 0, 0, 0, 0, -0.8, 0 }, RHip = { 40, 0, 0 }, RKnee = { -60, 0, 0 }, LHip = { 40, 0, 0 }, LKnee = { -60, 0, 0 } },
	Ab = { Waist = { -25, 0, 0 }, RShoulder = { 30, 0, 130 }, LShoulder = { 30, 0, -130 }, Neck = { -30, 0, 0 }, Root = { 0, 0, 0, 0, 0.2, 0 } },
	-- Hit reaction
	Hurt = { Waist = { -18, 10, 0 }, Neck = { -20, 0, 0 }, RShoulder = { 20, 0, 40 }, LShoulder = { 20, 0, -40 }, Root = { 0, 0, 0, 0, 0, 0.3 } },
	-- Mining chop
	Ma = { Waist = { -15, -15, 0 }, RShoulder = { 160, 0, 10 }, LShoulder = { 140, 0, -10 }, RElbow = { 40, 0, 0 } },
	Mb = { Waist = { 30, 0, 0 }, RShoulder = { 30, 0, 0 }, LShoulder = { 35, 0, 0 }, Root = { 0, 0, 0, 0, -0.4, 0 } },
}

local function strike(a: Pose, b: Pose, windup: number, recover: number): Clip
	return {
		keys = {
			{ t = 0, pose = REST },
			{ t = windup * 0.85, pose = a, ease = "out" },
			{ t = windup + 0.07, pose = b, ease = "snap" },
			{ t = windup + 0.07 + recover * 0.5, pose = b, ease = "linear" },
			{ t = windup + 0.07 + recover, pose = REST, ease = "inout" },
		},
	}
end

local LIGHT = { { "L1a", "L1b" }, { "L2a", "L2b" }, { "L3a", "L3b" }, { "L4a", "L4b" }, { "L5a", "L5b" } }

local function clipFor(name: string, windup: number?): Clip
	local w = windup or 0.12
	if name:sub(1, 5) == "Light" then
		local index = tonumber(name:sub(6)) or 1
		local pair = LIGHT[((index - 1) % #LIGHT) + 1]
		return strike(P[pair[1]], P[pair[2]], w, if index >= 4 then 0.4 else 0.28)
	elseif name == "Heavy" then
		return strike(P.Ha, P.Hb, w, 0.45)
	elseif name == "Block" then
		return { keys = { { t = 0, pose = REST }, { t = 0.08, pose = P.Block, ease = "out" } }, hold = true }
	elseif name == "Dodge" then
		return { keys = { { t = 0, pose = REST }, { t = 0.06, pose = P.Dodge, ease = "out" }, { t = 0.22, pose = P.Dodge }, { t = 0.42, pose = REST, ease = "inout" } } }
	elseif name == "Cast" then
		return strike(P.Ca, P.Cb, 0.12, 0.35)
	elseif name == "Awaken" then
		return { keys = { { t = 0, pose = REST }, { t = 0.25, pose = P.Aa, ease = "out" }, { t = 0.45, pose = P.Aa }, { t = 0.55, pose = P.Ab, ease = "snap" }, { t = 1.1, pose = P.Ab }, { t = 1.5, pose = REST, ease = "inout" } } }
	elseif name == "Hurt" then
		return { keys = { { t = 0, pose = REST }, { t = 0.06, pose = P.Hurt, ease = "snap" }, { t = 0.3, pose = REST, ease = "inout" } } }
	elseif name == "Mine" then
		return strike(P.Ma, P.Mb, 0.35, 0.3)
	end
	return { keys = { { t = 0, pose = REST } } }
end

-- Engine -----------------------------------------------------------------------------------------

type Active = { clip: Clip, start: number, motors: { [string]: Motor6D }, releasing: number? }
local active: { [Model]: Active } = {}
local baseC0: { [Motor6D]: CFrame } = {}
local tracks: { [Humanoid]: { [string]: AnimationTrack } } = {}

local function offset(entry: { number }?): CFrame
	if not entry then
		return CFrame.identity
	end
	return CFrame.new(entry[4] or 0, entry[5] or 0, entry[6] or 0)
		* CFrame.Angles(math.rad(entry[1]), math.rad(entry[2]), math.rad(entry[3]))
end

local function ease(kind: string?, a: number): number
	if kind == "out" then
		return 1 - (1 - a) * (1 - a)
	elseif kind == "snap" then
		return 1 - (1 - a) ^ 4
	elseif kind == "inout" then
		return a * a * (3 - 2 * a)
	end
	return a
end

local function motorsOf(character: Model): { [string]: Motor6D }
	local map = if character:FindFirstChild("UpperTorso") then R15_JOINTS else R6_JOINTS
	local out = {}
	for joint, path in map do
		local part = character:FindFirstChild(path[1])
		local motor = part and part:FindFirstChild(path[2])
		if motor and motor:IsA("Motor6D") then
			out[joint] = motor
			if not baseC0[motor] then
				baseC0[motor] = motor.C0
			end
		end
	end
	return out
end

local function apply(entry: Active, pose: { [string]: CFrame })
	for joint, motor in entry.motors do
		local base = baseC0[motor]
		if base and motor.Parent then
			motor.C0 = base * (pose[joint] or CFrame.identity)
		end
	end
end

local function evaluate(clip: Clip, t: number): ({ [string]: CFrame }, boolean)
	local keys = clip.keys
	local last = keys[#keys]
	if t >= last.t then
		local out = {}
		for joint, e in last.pose do
			out[joint] = offset(e)
		end
		return out, not clip.hold
	end
	for i = 1, #keys - 1 do
		local a, b = keys[i], keys[i + 1]
		if t >= a.t and t < b.t then
			local alpha = ease(b.ease, (t - a.t) / math.max(1e-3, b.t - a.t))
			local out = {}
			for joint in R15_JOINTS do
				local from, to = a.pose[joint], b.pose[joint]
				if from or to then
					out[joint] = offset(from):Lerp(offset(to), alpha)
				end
			end
			return out, false
		end
	end
	return {}, true
end

local function trackFor(character: Model, key: string): AnimationTrack?
	local id = (AudioConfig.Animations :: any)[key]
	if not id or id == "" then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not humanoid or not animator then
		return nil
	end
	tracks[humanoid] = tracks[humanoid] or {}
	local track = tracks[humanoid][key]
	if not track then
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, result = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if not ok then
			return nil
		end
		track = result
		tracks[humanoid][key] = track
	end
	return track
end

-- Plays a named clip on a character. `windup` stretches the anticipation to match the server timing.
function AnimationController.play(character: Model, name: string, windup: number?)
	if typeof(character) ~= "Instance" or not character.Parent then
		return
	end
	local track = trackFor(character, name)
	if track then
		track:Play(0.05)
		return
	end
	local motors = motorsOf(character)
	if next(motors) == nil then
		return
	end
	active[character] = { clip = clipFor(name, windup), start = os.clock(), motors = motors }
end

function AnimationController.stop(character: Model, name: string?)
	local track = name and trackFor(character, name)
	if track then
		track:Stop(0.1)
		return
	end
	local entry = active[character]
	if entry and not entry.releasing then
		entry.releasing = os.clock()
	end
end

-- Compatibility helpers used by controllers.
function AnimationController.swing(character: Model, index: number, heavy: boolean?, windup: number?)
	local katana = character:FindFirstChild("Katana")
	local blade = katana and katana:FindFirstChild("Blade")
	local trail = blade and blade:FindFirstChild("SwingTrail") :: Trail?
	local w = windup or (if heavy then 0.35 else 0.1)
	if trail then
		task.delay(w * 0.6, function()
			trail.Enabled = true
			task.delay(0.35, function()
				trail.Enabled = false
			end)
		end)
	end
	AnimationController.play(character, if heavy then "Heavy" else ("Light" .. math.max(1, index)), w)
end

function AnimationController.block(character: Model, on: boolean)
	if on then
		AnimationController.play(character, "Block")
	else
		AnimationController.stop(character, "Block")
	end
end

function AnimationController.cast(character: Model)
	AnimationController.play(character, "Cast")
end

-- Brief freeze of animation tracks on impact (hit-stop feel).
function AnimationController.hitStop(character: Model, duration: number)
	local entry = active[character]
	if entry then
		entry.start += duration -- delays the procedural clip
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if animator then
		local playing = animator:GetPlayingAnimationTracks()
		for _, t in playing do
			t:AdjustSpeed(0.05)
		end
		task.delay(duration, function()
			for _, t in playing do
				t:AdjustSpeed(1)
			end
		end)
	end
end

function AnimationController.init()
	RunService.RenderStepped:Connect(function()
		local now = os.clock()
		for character, entry in active do
			if not character.Parent then
				active[character] = nil
				continue
			end
			local pose, finished = evaluate(entry.clip, now - entry.start)
			if entry.releasing then
				local alpha = math.clamp((now - entry.releasing) / 0.12, 0, 1)
				for joint, cf in pose do
					pose[joint] = cf:Lerp(CFrame.identity, alpha)
				end
				finished = alpha >= 1
			end
			apply(entry, pose)
			if finished then
				apply(entry, {})
				active[character] = nil
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		if player.Character then
			active[player.Character] = nil
		end
	end)
end

return AnimationController
]]></string>
            </Properties>
