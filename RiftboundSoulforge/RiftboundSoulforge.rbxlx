          <string name="Name">Inventory</string>
        </Properties>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Costs</string>
            <string name="Source"><![CDATA[--!strict
-- Pure helpers for cost checks. "Coins" is a pseudo-item mapped to profile.coins.

local Costs = {}

export type Cost = { [string]: number }

function Costs.have(profile: any, key: string): number
	if key == "Coins" then
		return profile.coins or 0
	end
	return (profile.materials and profile.materials[key]) or 0
end

function Costs.canAfford(profile: any, cost: Cost): (boolean, { string })
	local missing = {}
	for key, amount in cost do
		local have = Costs.have(profile, key)
		if have < amount then
			table.insert(missing, string.format("%s (%d/%d)", key, have, amount))
		end
	end
	table.sort(missing)
	return #missing == 0, missing
end

-- Mutates the profile. Callers must check canAfford first (done inside for safety).
function Costs.spend(profile: any, cost: Cost): boolean
	if not Costs.canAfford(profile, cost) then
		return false
	end
	for key, amount in cost do
		if key == "Coins" then
			profile.coins -= amount
		else
			profile.materials[key] -= amount
		end
	end
	return true
end

function Costs.describe(cost: Cost): string
	local parts = {}
	for key, amount in cost do
		table.insert(parts, string.format("%d %s", amount, key))
	end
	table.sort(parts)
	return table.concat(parts, ", ")
end

return Costs
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Single source of truth for remote names. The server creates them; clients wait for them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

Net.Events = {
	-- client -> server
	"CombatAction", -- (action: string, payload: table?)
	-- server -> client
	"ProfileSync", -- (snapshot)
	"Notify", -- (kind, text, extra)
	"Effect", -- (effectName, data) broadcast cosmetic effects
	"CombatFeedback", -- (kind, data) to the acting player only
	"Cooldown", -- (slot, endsAt, duration)
	"OpenView", -- (viewName, data)
	"BossState", -- (state table)
	"WorldEvent", -- (state table)
	"Present", -- (momentId, data) first-time presentation moments
	"PartySync", -- (party state)
	"ExpeditionSync", -- (satchel, depth, region)
	"TrialSync", -- (trial state)
}

Net.Functions = {
	"Request", -- (kind: string, args: table?) -> (ok: boolean, message: string?, data: any?)
}

local folder: Folder? = nil

local function getFolder(): Folder
	if folder then
		return folder
	end
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild("Remotes")
		local f: Folder = if existing and existing:IsA("Folder") then existing else Instance.new("Folder")
		f.Name = "Remotes"
		for _, name in Net.Events do
			if not f:FindFirstChild(name) then
				local remote = Instance.new("RemoteEvent")
				remote.Name = name
				remote.Parent = f
			end
		end
		for _, name in Net.Functions do
			if not f:FindFirstChild(name) then
				local remote = Instance.new("RemoteFunction")
				remote.Name = name
				remote.Parent = f
			end
		end
		f.Parent = ReplicatedStorage
		folder = f
		return f
	else
		local f = ReplicatedStorage:WaitForChild("Remotes") :: Folder
		folder = f
		return f
	end
end

function Net.event(name: string): RemoteEvent
	assert(table.find(Net.Events, name), "Unknown remote event " .. name)
	return getFolder():WaitForChild(name) :: RemoteEvent
end

function Net.func(name: string): RemoteFunction
	assert(table.find(Net.Functions, name), "Unknown remote function " .. name)
	return getFolder():WaitForChild(name) :: RemoteFunction
end

-- Server helper: fire to everyone except one player.
function Net.fireAllExcept(name: string, except: Player?, ...: any)
	local remote = Net.event(name)
	for _, player in game:GetService("Players"):GetPlayers() do
		if player ~= except then
			remote:FireClient(player, ...)
		end
	end
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="30">
        <Properties>
          <string name="Name">Progression</string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Leveling</string>
            <string name="Source"><![CDATA[--!strict
-- Pure XP maths shared by server (authoritative) and client (display).

local Leveling = {}

export type Result = { level: number, xp: number, gained: number }

-- Adds xp to (level, xp) using curve(level) = xp needed to go from level to level+1.
function Leveling.add(level: number, xp: number, amount: number, curve: (number) -> number, maxLevel: number): Result
	if amount ~= amount or amount <= 0 or amount == math.huge then
		return { level = level, xp = xp, gained = 0 }
	end
	local startLevel = level
	xp += amount
	while level < maxLevel do
		local need = curve(level)
		if xp < need then
			break
		end
		xp -= need
		level += 1
	end
	if level >= maxLevel then
		level = maxLevel
		xp = 0
	end
	return { level = level, xp = xp, gained = level - startLevel }
end

function Leveling.progress(level: number, xp: number, curve: (number) -> number, maxLevel: number): number
	if level >= maxLevel then
		return 1
	end
	return math.clamp(xp / curve(level), 0, 1)
end

return Leveling
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="32">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict

local Format = {}

function Format.number(n: number): string
	n = math.floor(n + 0.5)
	local s = tostring(math.abs(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (n < 0 and "-" or "") .. out
end

function Format.time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

function Format.percent(fraction: number): string
	return string.format("%d%%", math.floor(fraction * 100 + 0.5))
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Maid</string>
            <string name="Source"><![CDATA[--!strict
-- Tracks connections, instances, threads and callbacks so they can be cleaned up together.

local Maid = {}
Maid.__index = Maid

function Maid.new()
	return setmetatable({ _tasks = {} :: { any } }, Maid)
end

function Maid:Give<T>(task: T): T
	table.insert(self._tasks, task)
	return task
end

function Maid:Clean()
	local tasks = self._tasks
	self._tasks = {}
	for i = #tasks, 1, -1 do
		local task_ = tasks[i]
		local kind = typeof(task_)
		if kind == "RBXScriptConnection" or (kind == "table" and type(task_.Disconnect) == "function") then
			task_:Disconnect()
		elseif kind == "Instance" or (kind == "table" and type(task_.Destroy) == "function") then
			task_:Destroy()
		elseif kind == "thread" then
			pcall(task.cancel, task_)
		elseif kind == "function" then
			pcall(task_)
		end
	end
end

Maid.Destroy = Maid.Clean

return Maid
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- Minimal synchronous signal used for in-process events (no Instances, no yielding).

export type Connection = { Disconnect: (self: Connection) -> (), Connected: boolean }

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} :: { [any]: (...any) -> () } }, Signal)
end

function Signal:Connect(fn: (...any) -> ())
	local key = {}
	self._handlers[key] = fn
	local connection = { Connected = true }
	local handlers = self._handlers
	function connection.Disconnect(conn)
		conn.Connected = false
		handlers[key] = nil
	end
	return connection
end

function Signal:Fire(...: any)
	for _, fn in self._handlers do
		local ok, err = pcall(fn, ...)
		if not ok then
			warn("[Signal] handler error: " .. tostring(err))
		end
	end
end

function Signal:DisconnectAll()
	table.clear(self._handlers)
end

return Signal
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="36">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="37">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="38">
        <Properties>
          <string name="Name">Combat</string>
        </Properties>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Abilities</string>
            <string name="Source"><![CDATA[--!strict
-- Server implementations of essence abilities, fusions and awakening signatures.
-- Each receives a ctx built by CombatService.cast (damage goes through ctx.hit so every
-- hit is validated, scaled, credited and fed into fusion/co-op detection uniformly).

local Abilities = {}

local function groundOf(position: Vector3): Vector3
	return position - Vector3.new(0, 2.5, 0)
end

local impl: { [string]: (any) -> () } = {}

impl.FlareBurst = function(ctx)
	local def = ctx.def
	local origin = groundOf(ctx.origin)
	ctx.effect("FlareBurst", { origin = ctx.origin, dir = ctx.dir, length = def.range, width = def.width, color = ctx.color })
	local hits = ctx.hit({ kind = "Line", origin = origin, dir = ctx.dir, length = def.range, width = def.width }, def.damage)
	for _, h in hits do
		ctx.status(h.record, "Burning", { dps = def.burnDps * ctx.power / 12, expires = os.clock() + def.burnDuration })
	end
	ctx.finish()
end

impl.EmberNova = function(ctx)
	local def = ctx.def
	ctx.effect("Nova", { position = ctx.origin, radius = def.radius, color = ctx.color })
	local hits = ctx.hit({ kind = "Circle", center = groundOf(ctx.origin), radius = def.radius }, def.damage, { stagger = 0.4 })
	for _, h in hits do
		local away = h.record.root.Position - ctx.origin
		away = Vector3.new(away.X, 0, away.Z)
		if away.Magnitude > 0.1 then
			ctx.displace(h.record, h.record.root.Position + away.Unit * def.knockback, 0.25)
		end
		ctx.status(h.record, "Burning", { dps = def.burnDps * ctx.power / 12, expires = os.clock() + def.burnDuration })
	end
	ctx.finish()
end

impl.ArcBolt = function(ctx)
	local def = ctx.def
	local origin = ctx.origin
	local aim = ctx.aim
	-- primary: enemy closest to the aim point, in front of the caster, within range
	local candidates = ctx.query(function(position, _r)
		local to = position - origin
		local flat = Vector3.new(to.X, 0, to.Z)
		return flat.Magnitude <= def.range
			and (flat.Magnitude < 4 or flat.Unit:Dot(ctx.dir) > 0.35)
			and ctx.los(origin, position, 3)
	end, 20)
	table.sort(candidates, function(a, b)
		return (a.root.Position - aim).Magnitude < (b.root.Position - aim).Magnitude
	end)
	local primary = candidates[1]
	if not primary then
		ctx.effect("Lightning", { points = { origin + Vector3.new(0, 2, 0), aim + Vector3.new(0, 1, 0) }, color = ctx.color })
		return
	end
	local chain = { primary }
	local hitSet = { [primary] = true }
	local current = primary
	for _ = 1, def.chains do
		local nextTarget, best = nil, def.chainRange
		for _, record in ctx.query(function(position, _r)
			return (position - current.root.Position).Magnitude <= def.chainRange
		end, 20) do
			local d = (record.root.Position - current.root.Position).Magnitude
			if not hitSet[record] and d <= best then
				nextTarget, best = record, d
			end
		end
		if not nextTarget then
			break
		end
		hitSet[nextTarget] = true
		table.insert(chain, nextTarget)
		current = nextTarget
	end
	local points = { origin + Vector3.new(0, 2, 0) }
	local mult = def.damage
	local bonus = if ctx.mastery("Storm") >= 3 then 0.1 else 0
	for _, record in chain do
		table.insert(points, record.root.Position)
		local hits = ctx.hit({ kind = "Circle", center = groundOf(record.root.Position), radius = 0.5 }, mult)
		for _, h in hits do
			if h.record == record then
				ctx.status(record, "Charged", { expires = os.clock() + def.chargedDuration, bonus = bonus })
			end
		end
		mult *= def.chainFalloff
	end
	ctx.effect("Lightning", { points = points, color = ctx.color })
	ctx.finish()
end

impl.Thunderstep = function(ctx)
	local def = ctx.def
	local ps = ctx.ps
	local start = ctx.origin
	local distance = def.distance
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local world = workspace:FindFirstChild("World")
	if world then
		params.FilterDescendantsInstances = { world, workspace.Terrain }
		local hit = workspace:Raycast(start, ctx.dir * distance, params)
		if hit then
			distance = math.max(0, (hit.Position - start).Magnitude - 2.5)
		end
	end
	local finish = start + ctx.dir * distance
	ps.iframesUntil = math.max(ps.iframesUntil, os.clock() + def.iframes)
	ps.character:PivotTo(CFrame.lookAt(finish, finish + ctx.dir))
	ctx.effect("Thunderstep", { from = start, to = finish, color = ctx.color })
	local bonus = if ctx.mastery("Storm") >= 3 then 0.1 else 0
	local hits = ctx.hit({ kind = "Line", origin = groundOf(start), dir = ctx.dir, length = distance + 2, width = def.width }, def.damage)
	for _, h in hits do
		ctx.status(h.record, "Charged", { expires = os.clock() + 3, bonus = bonus })
	end
	ctx.finish()
end

impl.GravitonPull = function(ctx)
	local def = ctx.def
	local center = ctx.aim
	ctx.effect("Gravity", { position = center, radius = def.radius, duration = def.pullTime, color = ctx.color })
	local bonus = if ctx.mastery("Gravity") >= 3 then 0.15 else 0
	local hits = ctx.hit({ kind = "Circle", center = groundOf(center), radius = def.radius }, def.damage)
	for _, h in hits do
		local offset = h.record.root.Position - center
		offset = Vector3.new(offset.X, 0, offset.Z)
		local goal = center + (if offset.Magnitude > 0.1 then offset.Unit * 2 else Vector3.zero)
		ctx.displace(h.record, goal, def.pullTime)
		ctx.status(h.record, "Gathered", { expires = os.clock() + def.gatheredDuration, bonus = bonus })
	end
	ctx.finish()
end

impl.CrushingField = function(ctx)
	local def = ctx.def
	local center = ctx.aim
	ctx.effect("Field", { position = center, radius = def.radius, duration = def.duration, color = ctx.color })
	local bonus = if ctx.mastery("Gravity") >= 3 then 0.15 else 0
	task.spawn(function()
		local ticks = math.floor(def.duration / def.tick)
		for _ = 1, ticks do
			if not ctx.alive() then
				break
			end
			local hits = ctx.hit({ kind = "Circle", center = groundOf(center), radius = def.radius }, def.damage)
			for _, h in hits do
				ctx.status(h.record, "Slowed", { expires = os.clock() + def.tick + 0.2, mult = def.slow })
				ctx.status(h.record, "Gathered", { expires = os.clock() + 1.5, bonus = bonus })
			end
			task.wait(def.tick)
		end
		ctx.finish()
	end)
end

impl.CollapsingSun = function(ctx)
	local def = ctx.def
	local center = ctx.aim
	ctx.effect("CollapsingSun", { position = center, radius = def.radius, pullTime = def.pullTime, blast = def.blastRadius })
	for _, record in ctx.query(function(position, r)
		return (Vector3.new(position.X - center.X, 0, position.Z - center.Z)).Magnitude <= def.radius + r
	end, 10) do
		local offset = record.root.Position - center
		offset = Vector3.new(offset.X, 0, offset.Z)
		ctx.displace(record, center + (if offset.Magnitude > 0.1 then offset.Unit * 1.5 else Vector3.zero), def.pullTime)
		ctx.status(record, "Gathered", { expires = os.clock() + def.pullTime + 1.5, bonus = 0 })
	end
	task.delay(def.pullTime, function()
		if not ctx.alive() then
			return
		end
		local hits = ctx.hit({ kind = "Circle", center = groundOf(center), radius = def.blastRadius }, def.damage, { stagger = 0.8 })
		for _, h in hits do
			ctx.status(h.record, "Burning", { dps = def.burnDps * ctx.power / 12, expires = os.clock() + def.burnDuration })
		end
		ctx.finish()
	end)
end

impl.MagneticRift = function(ctx)
	local def = ctx.def
	local center = ctx.aim
	ctx.effect("MagneticRift", { position = center, radius = def.radius, duration = def.duration })
	task.spawn(function()
		local ticks = math.floor(def.duration / def.tick)
		for _ = 1, ticks do
			if not ctx.alive() then
				break
			end
			local inside = ctx.query(function(position, r)
				return (Vector3.new(position.X - center.X, 0, position.Z - center.Z)).Magnitude <= def.radius + r
			end, 10)
			local points = {}
			for i, record in inside do
				local offset = record.root.Position - center
				offset = Vector3.new(offset.X, 0, offset.Z)
				if offset.Magnitude > 3 then
					ctx.displace(record, center + offset.Unit * 2.5, def.tick * 0.8)
				end
				ctx.status(record, "Gathered", { expires = os.clock() + 1.5, bonus = 0 })
				ctx.status(record, "Charged", { expires = os.clock() + 2, bonus = 0 })
				if i <= def.chains then
					table.insert(points, record)
				end
			end
			for _, record in points do
				ctx.hit({ kind = "Circle", center = groundOf(record.root.Position), radius = 0.5 }, def.damage)
				ctx.effect("Lightning", { points = { center + Vector3.new(0, 3, 0), record.root.Position }, color = Color3.fromRGB(140, 190, 255) })
			end
			task.wait(def.tick)
		end
		ctx.finish()
	end)
end

-- Awakening signatures ----------------------------------------------------------------------

impl.SolarCataclysm = function(ctx)
	local def = ctx.def
	ctx.effect("Cataclysm", { position = ctx.origin, radius = def.radius, color = Color3.fromRGB(255, 120, 40) })
	local hits = ctx.hit({ kind = "Circle", center = groundOf(ctx.origin), radius = def.radius }, def.damage, { stagger = 1.0 })
	for _, h in hits do
		ctx.status(h.record, "Burning", { dps = 6, expires = os.clock() + 4 })
	end
end

impl.ThousandBolts = function(ctx)
	local def = ctx.def
	local origin = ctx.origin
	local targets = ctx.query(function(position, _r)
		return (position - origin).Magnitude <= def.radius
	end, def.targets)
	task.spawn(function()
		for _, record in targets do
			if not ctx.alive() then
				break
			end
			if record.alive then
				ctx.effect("Lightning", { points = { record.root.Position + Vector3.new(0, 40, 0), record.root.Position }, color = Color3.fromRGB(150, 220, 255) })
				ctx.hit({ kind = "Circle", center = groundOf(record.root.Position), radius = 0.5 }, def.damage, { stagger = 0.4 })
				ctx.status(record, "Charged", { expires = os.clock() + 4, bonus = 0.1 })
			end
			task.wait(0.08)
		end
	end)
end

impl.EventHorizon = function(ctx)
	local def = ctx.def
	local center = ctx.origin
	ctx.effect("CollapsingSun", { position = center, radius = def.radius, pullTime = def.pullTime, blast = def.radius * 0.6, gravityOnly = true })
	for _, record in ctx.query(function(position, _r)
		return (position - center).Magnitude <= def.radius
	end, 12) do
		local offset = record.root.Position - center
		offset = Vector3.new(offset.X, 0, offset.Z)
		ctx.displace(record, center + (if offset.Magnitude > 0.1 then offset.Unit * 3 else Vector3.zero), def.pullTime)
		ctx.status(record, "Gathered", { expires = os.clock() + def.pullTime + 2, bonus = 0.15 })
	end
	task.delay(def.pullTime, function()
		if ctx.alive() then
			ctx.hit({ kind = "Circle", center = groundOf(center), radius = def.radius * 0.6 }, def.damage, { stagger = 1.2 })
		end
	end)
end

function Abilities.cast(id: string, ctx: any)
	local fn = impl[id]
	if not fn then
		error("no implementation for ability " .. id)
	end
	fn(ctx)
end

function Abilities.has(id: string): boolean
	return impl[id] ~= nil
end

return Abilities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Hitbox</string>
            <string name="Source"><![CDATA[--!strict
-- Planar shape tests (ignoring height, with a vertical tolerance) used for BOTH player attacks
-- and enemy attacks, so what is telegraphed is exactly what can hit.

local Hitbox = {}

local VERTICAL_TOLERANCE = 10

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

function Hitbox.inCircle(position: Vector3, center: Vector3, radius: number, padding: number?): boolean
	if math.abs(position.Y - center.Y) > VERTICAL_TOLERANCE + (padding or 0) then
		return false
	end
	return (flat(position) - flat(center)).Magnitude <= radius + (padding or 0)
end

function Hitbox.inRing(position: Vector3, center: Vector3, inner: number, outer: number, padding: number?): boolean
	if math.abs(position.Y - center.Y) > VERTICAL_TOLERANCE then
		return false
	end
	local d = (flat(position) - flat(center)).Magnitude
	local p = padding or 0
	return d <= outer + p and d >= inner - p
end

-- Rectangle starting at origin, extending `length` along dir, `width` wide.
function Hitbox.inLine(position: Vector3, origin: Vector3, dir: Vector3, length: number, width: number, padding: number?): boolean
	if math.abs(position.Y - origin.Y) > VERTICAL_TOLERANCE then
		return false
	end
	local p = padding or 0
	local forward = flat(dir)
	if forward.Magnitude < 1e-3 then
		return false
	end
	forward = forward.Unit
	local right = Vector3.new(-forward.Z, 0, forward.X)
	local rel = flat(position) - flat(origin)
	local along = rel:Dot(forward)
	local side = math.abs(rel:Dot(right))
	return along >= -p and along <= length + p and side <= width / 2 + p
end

-- Axis-aligned square tile (used by the Warden's final phase).
function Hitbox.inSquare(position: Vector3, center: Vector3, half: number): boolean
	return math.abs(position.X - center.X) <= half and math.abs(position.Z - center.Z) <= half
		and math.abs(position.Y - center.Y) <= VERTICAL_TOLERANCE
end

return Hitbox
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Telegraph</string>
            <string name="Source"><![CDATA[--!strict
-- Server-created attack telegraphs. They replicate to every client, which animates the fill
-- (ExpandStart/ExpandEnd attributes) and can recolour them for high-contrast mode.
-- Every telegraph combines colour + shape + a warning glyph + motion (never colour alone).

local Debris = game:GetService("Debris")

local Telegraph = {}

local folder: Folder? = nil
local DANGER = Color3.fromRGB(255, 70, 50)
local SAFE = Color3.fromRGB(90, 255, 150)

local function getFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = workspace:FindFirstChild("Telegraphs") :: Folder?
	if not f then
		f = Instance.new("Folder")
		f.Name = "Telegraphs"
		f.Parent = workspace
	end
	folder = f
	return f :: Folder
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local function groundY(position: Vector3): number
	local world = workspace:FindFirstChild("World")
	if world then
		rayParams.FilterDescendantsInstances = { world, workspace.Terrain }
		local result = workspace:Raycast(position + Vector3.new(0, 6, 0), Vector3.new(0, -40, 0), rayParams)
		if result then
			return result.Position.Y
		end
	end
	return position.Y
end
Telegraph.groundY = groundY

local function basePart(name: string, color: Color3, transparency: number): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = transparency
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

local function glyph(parent: Instance, text: string, color: Color3)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Glyph"
	gui.Size = UDim2.fromOffset(46, 46)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 140
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Parent = gui
	gui.Parent = parent
end

export type Handle = { model: Model, destroy: (Handle) -> () }

local function finish(model: Model, duration: number, kind: string): Handle
	model:SetAttribute("Telegraph", kind)
	model:SetAttribute("Start", workspace:GetServerTimeNow())
	model:SetAttribute("Duration", duration)
	model.Parent = getFolder()
	Debris:AddItem(model, duration + 0.4)
	local handle = { model = model }
	function handle.destroy(h: Handle)
		if h.model.Parent then
			h.model:Destroy()
		end
	end
	return handle :: any
end

local function disc(model: Model, center: Vector3, radius: number, color: Color3, transparency: number, lift: number, name: string): Part
	local part = basePart(name, color, transparency)
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(0.2, radius * 2, radius * 2)
	part.CFrame = CFrame.new(center + Vector3.new(0, lift, 0)) * CFrame.Angles(0, 0, math.rad(90))
	part.Parent = model
	return part
end

function Telegraph.circle(center: Vector3, radius: number, duration: number, opts: any?): Handle
	local o = opts or {}
	local y = groundY(center)
	local c = Vector3.new(center.X, y, center.Z)
	local model = Instance.new("Model")
	model.Name = "Circle"
	local color = o.color or DANGER
	disc(model, c, radius, color, 0.72, 0.12, "Area")
	local fill = disc(model, c, radius, color, 0.45, 0.16, "Fill")
	fill:SetAttribute("FullSize", fill.Size)
	fill.Size = Vector3.new(0.2, 0.5, 0.5)
	local anchor = disc(model, c, 0.6, color, 1, 0.2, "Anchor")
	glyph(anchor, o.glyph or "!", color)
	return finish(model, duration, "Circle")
end

function Telegraph.safeZone(center: Vector3, radius: number, duration: number): Handle
	local y = groundY(center)
	local c = Vector3.new(center.X, y, center.Z)
	local model = Instance.new("Model")
	model.Name = "Safe"
	disc(model, c, radius, SAFE, 0.5, 0.2, "Area")
	local anchor = disc(model, c, 0.6, SAFE, 1, 0.22, "Anchor")
	glyph(anchor, "SAFE", SAFE)
	return finish(model, duration, "Safe")
end

function Telegraph.ring(center: Vector3, inner: number, outer: number, duration: number, opts: any?): Handle
	local o = opts or {}
	local y = groundY(center)
	local c = Vector3.new(center.X, y, center.Z)
	local model = Instance.new("Model")
	model.Name = "Ring"
	local color = o.color or DANGER
	disc(model, c, outer, color, 0.55, 0.12, "Area")
	local safe = disc(model, c, inner, Color3.fromRGB(20, 20, 30), 0.15, 0.18, "Hole")
	safe.Material = Enum.Material.SmoothPlastic
	local fill = disc(model, c, outer, color, 0.5, 0.14, "Fill")
	fill:SetAttribute("FullSize", fill.Size)
	fill.Size = Vector3.new(0.2, inner * 2, inner * 2)
	local anchor = disc(model, c + Vector3.new(outer * 0.7, 0, 0), 0.6, color, 1, 0.2, "Anchor")
	glyph(anchor, "◎", color)
	return finish(model, duration, "Ring")
end

function Telegraph.line(origin: Vector3, dir: Vector3, length: number, width: number, duration: number, opts: any?): Handle
	local o = opts or {}
	local flatDir = Vector3.new(dir.X, 0, dir.Z)
	flatDir = if flatDir.Magnitude > 1e-3 then flatDir.Unit else Vector3.new(0, 0, -1)
	local y = groundY(origin)
	local start = Vector3.new(origin.X, y, origin.Z)
	local mid = start + flatDir * (length / 2)
	local cf = CFrame.lookAt(mid, mid + flatDir)
	local model = Instance.new("Model")
	model.Name = "Line"
	local color = o.color or DANGER
	local area = basePart("Area", color, 0.7)
	area.Size = Vector3.new(width, 0.2, length)
	area.CFrame = cf + Vector3.new(0, 0.12, 0)
	area.Parent = model
	local fill = basePart("Fill", color, 0.45)
	fill.Size = Vector3.new(width, 0.2, length)
	fill:SetAttribute("FullSize", fill.Size)
	fill:SetAttribute("Grow", "Forward")
	fill.CFrame = cf + Vector3.new(0, 0.16, 0)
	fill.Parent = model
	-- arrow chevrons show direction (shape cue)
	for i = 1, 3 do
		local chevron = basePart("Chevron", Color3.new(1, 1, 1), 0.35)
		chevron.Size = Vector3.new(width * 0.5, 0.22, 0.6)
		chevron.CFrame = CFrame.lookAt(start + flatDir * (length * i / 4), start + flatDir * (length * i / 4 + 1))
			* CFrame.new(0, 0.2, 0)
		chevron.Parent = model
	end
	local anchor = basePart("Anchor", color, 1)
	anchor.Size = Vector3.new(0.5, 0.5, 0.5)
	anchor.CFrame = CFrame.new(mid + Vector3.new(0, 0.3, 0))
	anchor.Parent = model
	glyph(anchor, o.glyph or "!", color)
	model.PrimaryPart = area
	return finish(model, duration, "Line")
end

function Telegraph.square(center: Vector3, half: number, duration: number, opts: any?): Handle
	local o = opts or {}
	local model = Instance.new("Model")
	model.Name = "Square"
	local color = o.color or DANGER
	local area = basePart("Area", color, 0.55)
	area.Size = Vector3.new(half * 2 - 1, 0.25, half * 2 - 1)
	area.CFrame = CFrame.new(center + Vector3.new(0, 0.15, 0))
	area.Parent = model
	local fill = basePart("Fill", color, 0.4)
	fill.Size = area.Size
	fill:SetAttribute("FullSize", fill.Size)
	fill.Size = Vector3.new(1, 0.25, 1)
	fill.CFrame = CFrame.new(center + Vector3.new(0, 0.2, 0))
	fill.Parent = model
	glyph(area, o.glyph or "⚠", color)
	return finish(model, duration, "Square")
end

return Telegraph
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="42">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">ProfileSchema</string>
            <string name="Source"><![CDATA[--!strict
-- Versioned profile schema: defaults, migrations and validation. Pure Luau (unit tested).
-- Stores only serialisable values: numbers, strings, booleans and plain tables.

local ProfileSchema = {}

ProfileSchema.Version = 2

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in value do
		out[k] = deepCopy(v)
	end
	return out
end
ProfileSchema.deepCopy = deepCopy

function ProfileSchema.default(): { [string]: any }
	return {
		schemaVersion = ProfileSchema.Version,
		coins = 0,
		level = 1,
		xp = 0,
		materials = { Iron = 0, Cobalt = 0, Emberstone = 0, EssenceShard = 0, BossSigil = 0, FractureCore = 0, EmberTonic = 1 },
		tools = { pickTier = 1 },
		weapons = {
			Katana = { owned = true, mastery = 1, masteryXp = 0, upgrade = 1, temper = "None", evolution = "None" },
		},
		essences = {
			Ember = { unlocked = true, mastery = 1, xp = 0 },
			Storm = { unlocked = false, mastery = 1, xp = 0 },
			Gravity = { unlocked = false, mastery = 1, xp = 0 },
		},
		fusions = {
			CollapsingSun = { researched = false, attunement = 0, unlocked = false },
			MagneticRift = { researched = false, attunement = 0, unlocked = false },
		},
		blueprints = {},
		loadout = { weapon = "Katana", primary = "Ember", secondary = "" },
		loadouts = {},
		quests = { progress = {}, completed = {}, claimed = {} },
		daily = { dayKey = 0, progress = {}, claimed = {} },
		codex = { enemies = {}, discoveries = {}, regions = {} },
		bosses = { FractureWarden = { clears = 0, firstClearAt = 0, bestTime = 0 } },
		achievements = {},
		trials = {},
		cosmetics = { owned = { Default = true }, trail = "Default" },
		tutorial = { moments = {} },
		stats = {
			kills = 0,
			deaths = 0,
			perfectParries = 0,
			dodges = 0,
			extractions = 0,
			oreMined = 0,
			crafts = 0,
			awakenings = 0,
			coopCombos = 0,
			fusionsCast = 0,
			bossKills = 0,
			playTime = 0,
			lootLost = 0,
		},
		settings = {
			cameraShake = 1,
			effects = 1,
			music = 0.5,
			sfx = 0.8,
			hudScale = 1,
			reducedClutter = false,
			highContrastTelegraphs = false,
		},
		receipts = {},
		passes = {},
	}
end

-- Migrations: migrations[n] upgrades a profile FROM version n-1 TO version n.
local migrations: { [number]: (any) -> any } = {}

-- v0 -> v1: unversioned prototype data. Ensure the root shape exists.
migrations[1] = function(data)
	data.coins = tonumber(data.coins) or 0
	data.materials = type(data.materials) == "table" and data.materials or {}
	return data
end

-- v1 -> v2: essences moved from a list of unlocked names to per-essence mastery records.
migrations[2] = function(data)
	if type(data.unlockedEssences) == "table" then
		data.essences = type(data.essences) == "table" and data.essences or {}
		for _, name in data.unlockedEssences do
			if type(name) == "string" then
				data.essences[name] = data.essences[name] or { unlocked = true, mastery = 1, xp = 0 }
				data.essences[name].unlocked = true
			end
		end
		data.unlockedEssences = nil
	end
	return data
end

ProfileSchema.migrations = migrations

local function isFiniteNumber(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

-- Fill missing keys from defaults and repair wrong types. Unknown keys are preserved.
local function reconcile(target: any, defaults: any)
	for key, defaultValue in defaults do
		local current = target[key]
		if current == nil then
			target[key] = deepCopy(defaultValue)
		elseif type(defaultValue) == "table" then
			if type(current) ~= "table" then
				target[key] = deepCopy(defaultValue)
			else
				reconcile(current, defaultValue)
			end
		elseif type(defaultValue) == "number" then
			if not isFiniteNumber(current) then
				target[key] = defaultValue
			end
		elseif type(current) ~= type(defaultValue) then
			target[key] = defaultValue
		end
	end
end

function ProfileSchema.sanitize(data: any)
	data.coins = math.max(0, math.floor(data.coins))
	data.level = math.clamp(math.floor(data.level), 1, 1000)
	data.xp = math.max(0, data.xp)
	for key, amount in data.materials do
		if not isFiniteNumber(amount) then
			data.materials[key] = 0
		else
			data.materials[key] = math.max(0, math.floor(amount))
		end
	end
	for _, weapon in data.weapons do
		if type(weapon) == "table" then
			weapon.mastery = math.max(1, math.floor(tonumber(weapon.mastery) or 1))
			weapon.upgrade = math.max(1, math.floor(tonumber(weapon.upgrade) or 1))
			weapon.masteryXp = math.max(0, tonumber(weapon.masteryXp) or 0)
		end
	end
	-- Repair any sparse quest-count arrays saved by older builds (DataStores reject them).
	for _, bucket in { data.quests.progress, data.daily.progress } do
		for _, progress in bucket do
			if type(progress) == "table" and type(progress.counts) == "table" then
				local maxIndex = 0
				for k in progress.counts do
					if type(k) == "number" and k > maxIndex then
						maxIndex = k
					end
				end
				local dense = {}
				for i = 1, maxIndex do
					dense[i] = tonumber(progress.counts[i]) or 0
				end
				progress.counts = dense
			end
		end
	end
	-- receipts are an ordered list of purchase ids; keep it bounded.
	if #data.receipts > 200 then
		local trimmed = {}
		for i = #data.receipts - 199, #data.receipts do
			table.insert(trimmed, data.receipts[i])
		end
		data.receipts = trimmed
	end
end

-- Converts raw stored data into a valid current-version profile.
-- Returns nil + reason when the data must NOT be used (e.g. written by a newer server).
function ProfileSchema.load(raw: any): (any?, string?)
	if raw == nil then
		return ProfileSchema.default(), nil
	end
	if type(raw) ~= "table" then
		return nil, "stored profile is not a table"
	end
	local data = deepCopy(raw)
	local version = tonumber(data.schemaVersion) or 0
	if version > ProfileSchema.Version then
		return nil, string.format("profile schema %d is newer than this server (%d)", version, ProfileSchema.Version)
	end
	for v = version + 1, ProfileSchema.Version do
		local migrate = migrations[v]
		if migrate then
			local ok, result = pcall(migrate, data)
			if not ok then
				return nil, "migration to v" .. v .. " failed: " .. tostring(result)
			end
			data = result
		end
	end
	data.schemaVersion = ProfileSchema.Version
	reconcile(data, ProfileSchema.default())
	ProfileSchema.sanitize(data)
	return data, nil
end

ProfileSchema.reconcile = reconcile

-- Public, client-safe projection of the profile (strips receipts).
function ProfileSchema.publicView(data: any): any
	local view = deepCopy(data)
	view.receipts = nil
	return view
end

return ProfileSchema
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="44">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server entry point. Deterministic startup: every service is registered, then Init() runs
-- in order (no cross-service calls), then Start() runs in order (connections, loops).

local Registry = require(script.Parent.Registry)
local Services = script.Parent.Services

local ORDER = {
	"WorldService", -- must be first: builds workspace.World used by later Start() calls
	"SecurityService",
	"PlayerDataService",
	"RequestService",
	"InventoryService",
	"ProgressionService",
	"QuestService",
	"ExpeditionService",
	"PartyService",
	"EnemyService",
	"CombatService",
	"FusionService",
	"CoopService",
	"BossService",
	"ResourceService",
	"CraftingService",
	"DiscoveryService",
	"TrialService",
	"WorldEventService",
	"EconomyService",
	"LoadoutService",
	"InteractionService",
	"SpawnService", -- last: players spawn only once everything is ready
}

local loaded = {}
for _, name in ORDER do
	local module = Services:FindFirstChild(name)
	assert(module, "missing service module " .. name)
	local service = require(module)
	Registry.register(name, service)
	table.insert(loaded, { name = name, service = service })
end

for _, entry in loaded do
	if entry.service.Init then
		local ok, err = pcall(entry.service.Init)
		if not ok then
			warn(string.format("[Main] %s.Init failed: %s", entry.name, tostring(err)))
		end
	end
end

for _, entry in loaded do
	if entry.service.Start then
		local ok, err = pcall(entry.service.Start)
		if not ok then
			warn(string.format("[Main] %s.Start failed: %s", entry.name, tostring(err)))
		end
	end
end

print("[Main] RIFTBOUND: SOULFORGE server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">Registry</string>
          <string name="Source"><![CDATA[--!strict
-- Service locator. Services never require each other directly (avoids circular requires);
-- they fetch peers lazily through Registry.get after Main has registered everyone.

local Registry = {}
local services: { [string]: any } = {}

function Registry.register(name: string, service: any)
	assert(services[name] == nil, "service registered twice: " .. name)
	services[name] = service
end

function Registry.get(name: string): any
	local service = services[name]
	if not service then
		error("service not registered: " .. name, 2)
	end
	return service
end

return Registry
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="46">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">BossService</string>
            <string name="Source"><![CDATA[--!strict
-- The Fracture Warden encounter: seal -> countdown -> arena lock -> 4 phases -> victory/reset.
-- Phase 1 Guarded Assault (melee, sweeps, slams), Phase 2 Rift Fractures (hazards, projectiles,
-- rift steps), Phase 3 Resonance Overload (interruptible channel, weak point, suppression),
-- Final: The Last Fracture (readable tile collapses, then a long vulnerable opening; it repeats
-- rather than wiping the party, so it is never a pure damage check).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local BossConfig = require(Config.BossConfig)
local WorldConfig = require(Config.WorldConfig)
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)
local Telegraph = require(script.Parent.Parent.Combat.Telegraph)
local Hitbox = require(script.Parent.Parent.Combat.Hitbox)
local Models = require(script.Parent.Parent.World.Models)

local BossService = {}

local CFG = BossConfig.FractureWarden
local ARENA = WorldConfig.Arena

type Encounter = {
	id: number,
	state: string,
	countdownEnds: number,
	startedAt: number,
	participants: { [number]: Player },
	record: any?,
	phase: number,
	invulnerableUntil: number,
	finalActive: boolean,
	openingUntil: number,
	exposedUntil: number,
	nextAttackAt: number,
	busy: boolean,
	cooldowns: { [string]: number },
	targetUserId: number?,
	retargetAt: number,
	handles: { any },
	overload: any?,
	lastParry: any?,
	totalDamage: number,
}

local encounter: Encounter = {
	id = 0,
	state = "Dormant",
	countdownEnds = 0,
	startedAt = 0,
	participants = {},
	record = nil,
	phase = 1,
	invulnerableUntil = 0,
	finalActive = false,
	openingUntil = 0,
	exposedUntil = 0,
	nextAttackAt = 0,
	busy = false,
	cooldowns = {},
	targetUserId = nil,
	retargetAt = 0,
	handles = {},
	overload = nil,
	lastParry = nil,
	totalDamage = 0,
}
local rewarded: { [number]: { [number]: boolean } } = {}
local victoryBeaconUntil = 0
local readyAt = 0

local function now(): number
	return os.clock()
end

local function inArena(position: Vector3): boolean
	local c = ARENA.center
	local half = ARENA.size / 2
	return math.abs(position.X - c.X) <= half and math.abs(position.Z - c.Z) <= half and position.Y > c.Y - 20
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function activeParticipants(): { Player }
	local list = {}
	for _, player in encounter.participants do
		local root = player.Parent and rootOf(player)
		if root and inArena(root.Position) then
			table.insert(list, player)
		end
	end
	return list
end

local function setBarrier(closed: boolean)
	local barrier = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("ArenaBarrier", true)
	if not barrier then
		return
	end
	for _, part in barrier:GetChildren() do
		if part:IsA("BasePart") then
			part.CanCollide = closed
			part.Transparency = if closed then 0.55 else 1
		end
	end
end

local function broadcastState()
	local record = encounter.record
	local overload = encounter.overload
	Net.event("BossState"):FireAllClients({
		state = encounter.state,
		name = CFG.displayName,
		title = CFG.title,
		health = record and record.health or 0,
		maxHealth = record and record.maxHealth or 1,
		phase = encounter.phase,
		phaseName = CFG.phases[encounter.phase] and CFG.phases[encounter.phase].name or "",
		exposed = now() < encounter.exposedUntil,
		opening = now() < encounter.openingUntil,
		countdownEnds = if encounter.state == "Countdown"
			then workspace:GetServerTimeNow() + math.max(0, encounter.countdownEnds - now())
			else 0,
		overload = overload and {
			progress = math.clamp(overload.damage / overload.threshold, 0, 1),
			endsAt = workspace:GetServerTimeNow() + math.max(0, overload.endsAt - now()),
		} or nil,
		participants = (function()
			local n = 0
			for _ in encounter.participants do
				n += 1
			end
			return n
		end)(),
	})
end

local function track(handle: any): any
	if handle then
		table.insert(encounter.handles, handle)
	end
	return handle
end

local function cleanupHandles()
	for _, handle in encounter.handles do
		pcall(function()
			if type(handle) == "table" and handle.destroy then
				handle:destroy()
			elseif typeof(handle) == "Instance" then
				handle:Destroy()
			end
		end)
	end
	encounter.handles = {}
end

local function valid(id: number): boolean
	return encounter.id == id and encounter.state == "Active" and encounter.record ~= nil and encounter.record.alive
end

local function stunned(): boolean
	local record = encounter.record
	return record ~= nil and now() < record.stunUntil
end

-- Waits for `seconds`; returns false if the encounter ended or the Warden was staggered.
local function windup(id: number, seconds: number, interruptible: boolean): boolean
	local finish = now() + seconds
	while now() < finish do
		task.wait(0.05)
		if not valid(id) then
			return false
		end
		if interruptible and stunned() then
			return false
		end
	end
	return true
end

local function exposeWeakPoint(seconds: number)
	local record = encounter.record
	if not record then
		return
	end
	encounter.exposedUntil = math.max(encounter.exposedUntil, now() + seconds)
	local weak = record.model:FindFirstChild("WeakPoint") :: BasePart?
	if weak then
		weak.Transparency = 0
		local light = weak:FindFirstChildOfClass("PointLight")
		if light then
			light.Brightness = 3
		end
	end
	Net.event("Effect"):FireAllClients("WeakPoint", { model = record.model, duration = seconds })
	task.delay(seconds, function()
		if encounter.record == record and now() >= encounter.exposedUntil and weak and weak.Parent then
			weak.Transparency = 0.75
			local light = weak:FindFirstChildOfClass("PointLight")
			if light then
				light.Brightness = 0
			end
		end
	end)
end

local function face(position: Vector3)
	local record = encounter.record
	if not record then
		return
	end
	local p = record.root.Position
	local flat = Vector3.new(position.X, p.Y, position.Z)
	if (flat - p).Magnitude > 0.5 then
		record.root.CFrame = CFrame.lookAt(p, flat)
	end
end

local function targetRoot(): BasePart?
	local list = activeParticipants()
	if #list == 0 then
		return nil
	end
	local t = now()
	local current = encounter.targetUserId and Players:GetPlayerByUserId(encounter.targetUserId)
	if not current or t >= encounter.retargetAt or not table.find(list, current) then
		current = list[math.random(1, #list)]
		encounter.targetUserId = current.UserId
		encounter.retargetAt = t + 6
	end
	return rootOf(current :: Player)
end

local function strike(attack: any, shape: any)
	local Combat = Registry.get("CombatService")
	local Enemy = Registry.get("EnemyService")
	Net.event("Effect"):FireAllClients("EnemyStrike", {
		shape = shape.kind,
		position = shape.center or shape.origin,
		dir = shape.dir,
		length = shape.length,
		radius = shape.radius,
		color = Color3.fromRGB(255, 70, 140),
		big = true,
	})
	Combat.enemyStrike(encounter.record, attack, shape, Enemy.newAttackKey(), attack.damage)
end

-- Attack implementations --------------------------------------------------------------------

local attacks: { [string]: (number, any, BasePart) -> () } = {}

local function standardAttack(id: number, attack: any, target: BasePart)
	local Enemy = Registry.get("EnemyService")
	local record = encounter.record
	face(target.Position)
	record.humanoid:MoveTo(record.root.Position)
	local shape = Enemy.shapeFor(record, attack, target.Position)
	local handle = track(Enemy.telegraph(shape, attack.windup, { glyph = if attack.parryable then "!" else "⚠" }))
	record.model:SetAttribute("Attacking", attack.name)
	local ok = windup(id, attack.windup, true)
	record.model:SetAttribute("Attacking", nil)
	if handle then
		handle:destroy()
	end
	if not ok then
		return
	end
	strike(attack, shape)
	if attack.exposes then
		exposeWeakPoint(attack.exposes)
	end
end

attacks.Cleave = standardAttack
attacks.Sweep = standardAttack
attacks.FractureSlam = standardAttack
attacks.RiftLance = standardAttack
attacks.Suppression = function(id, attack, target)
	local def = table.clone(attack)
	def.endsAwakening = true
	standardAttack(id, def, target)
end

attacks.Fractures = function(id, attack, _target)
	local positions = {}
	for _, player in activeParticipants() do
		local root = rootOf(player)
		if root then
			table.insert(positions, root.Position + Vector3.new(math.random(-6, 6), 0, math.random(-6, 6)))
		end
	end
	while #positions < attack.count do
		local c = ARENA.center
		table.insert(positions, c + Vector3.new(math.random(-45, 45), 0, math.random(-45, 45)))
	end
	for _, p in positions do
		track(Telegraph.circle(p, attack.radius, attack.windup, { glyph = "☠", color = Color3.fromRGB(190, 60, 255) }))
	end
	if not windup(id, attack.windup, false) then
		return
	end
	local zones = {}
	for _, p in positions do
		local zone = Telegraph.circle(p, attack.radius, attack.duration, { glyph = "☠", color = Color3.fromRGB(150, 40, 220) })
		zone.model:SetAttribute("Hazard", true)
		track(zone)
		table.insert(zones, p)
	end
	task.spawn(function()
		local ticks = math.floor(attack.duration / attack.tick)
		local Combat = Registry.get("CombatService")
		for _ = 1, ticks do
			if encounter.id ~= id or encounter.state ~= "Active" then
				return
			end
			for _, player in activeParticipants() do
				local root = rootOf(player)
				if root then
					for _, p in zones do
						if Hitbox.inCircle(root.Position, p, attack.radius, 1) then
							Combat.hazardDamage(player, attack.damage, { telegraphed = false })
							break
						end
					end
				end
			end
			task.wait(attack.tick)
		end
	end)
end

attacks.ShardVolley = function(id, attack, _target)
	local record = encounter.record
	local targets = {}
	for _, player in activeParticipants() do
		local root = rootOf(player)
		if root then
			table.insert(targets, root.Position)
		end
	end
	local c = ARENA.center
	while #targets < attack.count do
		table.insert(targets, c + Vector3.new(math.random(-40, 40), 0, math.random(-40, 40)))
	end
	for _, p in targets do
		track(Telegraph.circle(p, attack.radius, attack.windup, { glyph = "▼", color = Color3.fromRGB(255, 80, 180) }))
		Net.event("Effect"):FireAllClients("Projectile", {
			from = record.root.Position + Vector3.new(0, 14, 0),
			to = p,
			duration = attack.windup,
			color = Color3.fromRGB(255, 90, 200),
		})
	end
	if not windup(id, attack.windup, false) then
		return
	end
	local Combat = Registry.get("CombatService")
	local Enemy = Registry.get("EnemyService")
	for _, p in targets do
		local shape = { kind = "Circle", center = Vector3.new(p.X, Telegraph.groundY(p), p.Z), radius = attack.radius }
		Combat.enemyStrike(record, attack, shape, Enemy.newAttackKey(), attack.damage)
		Net.event("Effect"):FireAllClients("Nova", { position = p, radius = attack.radius, color = Color3.fromRGB(255, 90, 200) })
	end
end

attacks.RiftStep = function(id, attack, target)
	local record = encounter.record
	local offset = Vector3.new(math.random(-8, 8), 0, math.random(-8, 8))
	local destination = target.Position + offset
	local c = ARENA.center
	local half = ARENA.size / 2 - 8
	destination = Vector3.new(math.clamp(destination.X, c.X - half, c.X + half), c.Y, math.clamp(destination.Z, c.Z - half, c.Z + half))
	local handle = track(Telegraph.circle(destination, attack.radius, attack.windup, { glyph = "✦", color = Color3.fromRGB(255, 60, 160) }))
	if not windup(id, attack.windup, true) then
		if handle then
			handle:destroy()
		end
		return
	end
	Net.event("Effect"):FireAllClients("Dash", { from = record.root.Position, to = destination, color = Color3.fromRGB(255, 60, 160) })
	record.root.CFrame = CFrame.new(destination + Vector3.new(0, 9, 0)) * record.root.CFrame.Rotation
	strike(attack, { kind = "Circle", center = Vector3.new(destination.X, Telegraph.groundY(destination), destination.Z), radius = attack.radius })
end

attacks.Overload = function(id, attack, _target)
	local record = encounter.record
	local center = ARENA.center
	Net.event("Effect"):FireAllClients("Dash", { from = record.root.Position, to = center, color = Color3.fromRGB(255, 60, 160) })
	record.root.CFrame = CFrame.new(center + Vector3.new(0, 9, 0))
	local threshold = record.maxHealth * attack.interruptFraction
	encounter.overload = { damage = 0, threshold = threshold, endsAt = now() + attack.channel }
	record.model:SetAttribute("Attacking", attack.name)
	Net.event("Notify"):FireAllClients("Boss", "RESONANCE OVERLOAD: interrupt it with damage, or reach a SAFE zone!")
	local safe = {}
	for i = 1, attack.safeZones do
		local angle = (i / attack.safeZones) * math.pi * 2 + math.random()
		local p = center + Vector3.new(math.cos(angle) * 34, 0, math.sin(angle) * 34)
		table.insert(safe, p)
		track(Telegraph.safeZone(p, attack.safeRadius, attack.channel + 0.3))
	end
	local danger = track(Telegraph.circle(center, ARENA.size * 0.7, attack.channel, { glyph = "☢", color = Color3.fromRGB(255, 40, 120) }))
	local finish = now() + attack.channel
	local interrupted = false
	while now() < finish do
		task.wait(0.1)
		if not valid(id) then
			encounter.overload = nil
			return
		end
		if encounter.overload and encounter.overload.damage >= threshold then
			interrupted = true
			break
		end
	end
	encounter.overload = nil
	record.model:SetAttribute("Attacking", nil)
	if danger then
		danger:destroy()
	end
	if interrupted then
		Registry.get("EnemyService").stagger(record, attack.stunOnInterrupt, true)
		exposeWeakPoint(attack.exposeOnInterrupt)
		Net.event("Notify"):FireAllClients("Boss", "Overload interrupted! The Warden is exposed!")
		local Combat = Registry.get("CombatService")
		for _, player in activeParticipants() do
			Combat.addResonance(player, 10)
			record.mechanicsBy[player.UserId] = (record.mechanicsBy[player.UserId] or 0) + 1
		end
		return
	end
	local Combat = Registry.get("CombatService")
	local Enemy = Registry.get("EnemyService")
	local key = Enemy.newAttackKey()
	Net.event("Effect"):FireAllClients("Cataclysm", { position = center, radius = ARENA.size * 0.7, color = Color3.fromRGB(255, 40, 120) })
	for _, player in activeParticipants() do
		local root = rootOf(player)
		if root then
			local protected = false
			for _, p in safe do
				if Hitbox.inCircle(root.Position, p, attack.safeRadius, 1) then
					protected = true
				end
			end
			if not protected then
				Combat.damagePlayer(player, attack.damage, { attacker = record, attackKey = key, telegraphed = true, unblockable = true, position = center })
			end
		end
	end
end

-- Final phase -------------------------------------------------------------------------------

local function tileCenters(): { Vector3 }
	local list = {}
	local n = ARENA.tiles
	local size = ARENA.size / n
	local c = ARENA.center
	for ix = 0, n - 1 do
		for iz = 0, n - 1 do
			local x = c.X - ARENA.size / 2 + size * (ix + 0.5)
			local z = c.Z - ARENA.size / 2 + size * (iz + 0.5)
			table.insert(list, Vector3.new(x, c.Y, z))
		end
	end
	return list
end

local function finalSequence(id: number)
	local record = encounter.record
	local final = CFG.finalPhase
	local Combat = Registry.get("CombatService")
	local Enemy = Registry.get("EnemyService")
	encounter.finalActive = true
	Net.event("Effect"):FireAllClients("ArenaTransform", { active = true })
	while valid(id) do
		encounter.invulnerableUntil = math.huge
		record.root.Anchored = true
		record.root.CFrame = CFrame.new(ARENA.center + Vector3.new(0, 22, 0))
		for wave = 1, final.waves do
			if not valid(id) then
				return
			end
			local tiles = tileCenters()
			local half = (ARENA.size / ARENA.tiles) / 2
			-- shuffle and pick
			for i = #tiles, 2, -1 do
				local j = math.random(1, i)
				tiles[i], tiles[j] = tiles[j], tiles[i]
			end
			local doomed = {}
			for i = 1, math.min(final.tilesPerWave, #tiles - 2) do
				table.insert(doomed, tiles[i])
				track(Telegraph.square(tiles[i], half, final.warnTime, { glyph = "⚠" }))
			end
			Net.event("Notify"):FireAllClients("Boss", string.format("The floor fractures! (%d/%d)", wave, final.waves))
			if not windup(id, final.warnTime, false) then
				return
			end
			local key = Enemy.newAttackKey()
			for _, center in doomed do
				Net.event("Effect"):FireAllClients("TileCollapse", { position = center, half = half })
				for _, player in activeParticipants() do
					local root = rootOf(player)
					if root and Hitbox.inSquare(root.Position, center, half) then
						Combat.damagePlayer(player, final.damage, { attacker = record, attackKey = key, telegraphed = true, unblockable = true, position = center })
					end
				end
			end
			if not windup(id, 1.0, false) then
				return
			end
		end
		-- The opening
		record.root.Anchored = false
		record.root.CFrame = CFrame.new(ARENA.center + Vector3.new(0, 9, 0))
		encounter.invulnerableUntil = 0
		encounter.openingUntil = now() + final.openingTime
		Registry.get("EnemyService").stagger(record, final.openingTime, true)
		exposeWeakPoint(final.openingTime)
		Net.event("Notify"):FireAllClients("Boss", "THE CORE IS EXPOSED! Strike now!")
		Net.event("Effect"):FireAllClients("FinalOpening", { model = record.model, duration = final.openingTime })
		if not windup(id, final.openingTime, false) then
			return
		end
		encounter.openingUntil = 0
		Net.event("Notify"):FireAllClients("Boss", "The Warden pulls itself together...")
	end
end

-- Damage hooks --------------------------------------------------------------------------------

local function onDamage(record: any, amount: number, info: any): number
	local t = now()
	local player: Player? = info.player
	if t < encounter.invulnerableUntil then
		if player then
			Net.event("CombatFeedback"):FireClient(player, "Immune")
		end
		return 0
	end
	local mult = 1
	if t < encounter.openingUntil then
		mult *= CFG.finalPhase.openingMultiplier
	end
	if t < encounter.exposedUntil and info.position and Registry.get("EnemyService").isOutsideFrontArc(record, info.position, 200) then
		mult *= CFG.weakPointMultiplier
		if player then
			Registry.get("ProgressionService").discover(player, "WardenBackCrystal")
			Net.event("CombatFeedback"):FireClient(player, "WeakPoint")
			local parry = encounter.lastParry
			if parry and parry.by ~= player.UserId and t - parry.time <= 2.5 then
				encounter.lastParry = nil
				local partner = Players:GetPlayerByUserId(parry.by)
				amount += record.maxHealth * CFG.breach.damageFraction
				Registry.get("EnemyService").stagger(record, CFG.breach.stagger, true)
				record.mechanicsBy[player.UserId] = (record.mechanicsBy[player.UserId] or 0) + 1
				if partner then
					Registry.get("CoopService").reward({ player, partner }, "Breach", record.root.Position)
				end
			end
		end
	end
	amount *= mult
	if encounter.overload then
		encounter.overload.damage += amount
	end
	-- The final phase cannot be skipped: health is floored at the final threshold until the opening.
	local floor = record.maxHealth * CFG.phases[4].threshold
	if not encounter.finalActive and record.health - amount < floor then
		amount = math.max(0, record.health - floor)
	end
	encounter.totalDamage += amount
	return amount
end

local function onParried(record: any, player: Player, attack: any)
	record.mechanicsBy[player.UserId] = (record.mechanicsBy[player.UserId] or 0) + 1
	encounter.lastParry = { by = player.UserId, time = now() }
	local Enemy = Registry.get("EnemyService")
	if attack.id == "RiftLance" then
		Enemy.stagger(record, attack.parryStagger or 2.5, true)
		exposeWeakPoint(4)
		Registry.get("ProgressionService").discover(player, "WardenLanceWeakness")
		Net.event("Notify"):FireAllClients("Boss", player.DisplayName .. " turned the Rift Lance! Strike its back!")
	else
		Enemy.stagger(record, 0.6, true)
	end
end

-- Lifecycle -----------------------------------------------------------------------------------

local function reset(reason: string)
	if encounter.state ~= "Active" and encounter.state ~= "Countdown" then
		return
	end
	encounter.state = "Reset"
	encounter.finalActive = false
	encounter.overload = nil
	cleanupHandles()
	local record = encounter.record
	if record then
		Registry.get("EnemyService").despawn(record)
		encounter.record = nil
	end
	Net.event("Effect"):FireAllClients("ArenaTransform", { active = false })
	for _, player in encounter.participants do
		if player.Parent then
			Net.event("Notify"):FireClient(player, "Boss", "The Fracture Warden resets. " .. reason)
		end
	end
	setBarrier(false)
	broadcastState()
	task.delay(CFG.resetDelay, function()
		if encounter.state == "Reset" then
			encounter.state = "Dormant"
			encounter.participants = {}
			broadcastState()
		end
	end)
end

local function eligible(userId: number, record: any): boolean
	local dealt = record.damageBy[userId] or 0
	local mechanics = record.mechanicsBy[userId] or 0
	local presence = now() - encounter.startedAt
	return mechanics > 0
		or (encounter.totalDamage > 0 and dealt / encounter.totalDamage >= CFG.rewards.minimumContribution)
		or (presence >= 60 and dealt > 0)
end

local function victory(record: any)
	if encounter.state ~= "Active" then
		return
	end
	local id = encounter.id
	encounter.state = "Victory"
	encounter.finalActive = false
	cleanupHandles()
	setBarrier(false)
	Net.event("Effect"):FireAllClients("ArenaTransform", { active = false })
	Net.event("Effect"):FireAllClients("BossDefeated", { position = record.root.Position })
	victoryBeaconUntil = now() + 180
	local elapsed = math.floor(now() - encounter.startedAt)
	rewarded[id] = rewarded[id] or {}
	local Expedition = Registry.get("ExpeditionService")
	local Progression = Registry.get("ProgressionService")
	local Quest = Registry.get("QuestService")
	local PlayerData = Registry.get("PlayerDataService")
	local rewards = CFG.rewards
	for userId, player in encounter.participants do
		if player.Parent and not rewarded[id][userId] and eligible(userId, record) then
			rewarded[id][userId] = true -- set before granting: duplicate protection
			local profile = PlayerData.get(player)
			if profile then
				local items = table.clone(rewards.materials)
				local coins = rewards.coins
				local boss = profile.bosses.FractureWarden
				local firstClear = boss.clears == 0
				if firstClear then
					coins += rewards.firstClear.coins
					for item, n in rewards.firstClear.materials do
						items[item] = (items[item] or 0) + n
					end
				end
				if math.random() < rewards.fractureCoreChance then
					items.FractureCore = (items.FractureCore or 0) + 1
				end
				boss.clears += 1
				if firstClear then
					boss.firstClearAt = os.time()
				end
				if boss.bestTime == 0 or elapsed < boss.bestTime then
					boss.bestTime = elapsed
				end
				PlayerData.markDirty(player)
				Expedition.giveLoot(player, items, coins, record.root.Position, true)
				Progression.addXp(player, rewards.xp)
				Progression.addWeaponMastery(player, "Katana", rewards.mastery)
				Progression.addEssenceXp(player, profile.loadout.primary, rewards.essenceXp)
				Progression.stat(player, "bossKills")
				Progression.recordEnemy(player, "FractureWarden", true)
				Progression.achieve(player, "WardenSlayer")
				Quest.record(player, "BossDefeated", { boss = "FractureWarden" })
				Progression.present(player, "WardenDefeated", {
					title = "The Warden Falls",
					subtitle = string.format("Cleared in %s", string.format("%d:%02d", elapsed // 60, elapsed % 60)),
					body = "Rewards are in your Satchel. Extract at the Warden's Beacon to secure them!",
					color = Color3.fromRGB(255, 210, 120),
				})
				Net.event("Notify"):FireClient(player, "Boss", "Victory! Extract at the Warden's Beacon to bank your rewards.")
			end
		elseif player.Parent and not rewarded[id][userId] then
			Net.event("Notify"):FireClient(player, "Boss", "The Warden falls, but you did not contribute enough for rewards.")
		end
	end
	encounter.record = nil
	broadcastState()
	readyAt = now() + CFG.victoryCooldown
	task.delay(CFG.victoryCooldown, function()
		if encounter.state == "Victory" then
			encounter.state = "Dormant"
			encounter.participants = {}
			broadcastState()
		end
	end)
end

local function spawnWarden(count: number)
	local Enemy = Registry.get("EnemyService")
	local model = Models.warden(ARENA.center + Vector3.new(0, 0, -30))
	local maxHealth = CFG.baseHealth * (1 + CFG.healthPerExtraPlayer * (count - 1))
	local root = model.PrimaryPart :: BasePart
	local record = {
		archetype = "FractureWarden",
		def = {
			displayName = CFG.displayName,
			kind = "Boss",
			drops = {},
			xp = 0,
			coins = { 0, 0 },
			look = { accent = Color3.fromRGB(255, 70, 140), scale = 3 },
			moveSpeed = CFG.moveSpeed,
			attacks = {},
		},
		model = model,
		root = root,
		humanoid = model:FindFirstChildOfClass("Humanoid"),
		health = maxHealth,
		maxHealth = maxHealth,
		radius = 4.5,
		spawnPos = ARENA.center,
		alive = true,
		external = true,
		state = "Active",
		stateUntil = 0,
		cooldowns = {},
		guardOpenUntil = 0,
		stunUntil = 0,
		controlledUntil = 0,
		lastHitAt = 0,
		damageBy = {},
		mechanicsBy = {},
		tags = {},
		status = {},
		surged = false,
		unyielding = true,
		kind = "Boss",
		onDamage = onDamage,
		onParried = onParried,
		onDeath = victory,
	}
	model:SetAttribute("Boss", true)
	model.Parent = Enemy.folder()
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	Enemy.registerExternal(record)
	model:SetAttribute("Health", maxHealth)
	model:SetAttribute("MaxHealth", maxHealth)
	return record
end

local function begin()
	local list = {}
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		if root and inArena(root.Position) then
			table.insert(list, player)
		end
	end
	if #list == 0 then
		encounter.state = "Dormant"
		broadcastState()
		return
	end
	encounter.participants = {}
	for _, player in list do
		encounter.participants[player.UserId] = player
	end
	encounter.state = "Active"
	encounter.startedAt = now()
	encounter.phase = 1
	encounter.invulnerableUntil = now() + 2.5
	encounter.finalActive = false
	encounter.openingUntil = 0
	encounter.exposedUntil = 0
	encounter.nextAttackAt = now() + 3
	encounter.busy = false
	encounter.cooldowns = {}
	encounter.lastParry = nil
	encounter.totalDamage = 0
	encounter.record = spawnWarden(#list)
	setBarrier(true)
	for _, player in list do
		Registry.get("ProgressionService").recordEnemy(player, "FractureWarden", false)
		Net.event("Present"):FireClient(player, "BossIntro", {
			title = CFG.displayName,
			subtitle = CFG.title,
			body = CFG.lore,
			color = Color3.fromRGB(255, 70, 140),
			always = true,
		})
	end
	Net.event("Effect"):FireAllClients("BossIntro", { model = encounter.record.model })
	broadcastState()
end

function BossService.trigger(player: Player): (boolean, string?)
	if encounter.state == "Countdown" then
		return false, "The seal is already breaking."
	end
	if encounter.state ~= "Dormant" then
		return false, "The arena is not ready."
	end
	if now() < readyAt then
		return false, "The Warden is reforming. Try again soon."
	end
	encounter.id += 1
	encounter.state = "Countdown"
	encounter.countdownEnds = now() + CFG.countdown
	encounter.participants = {}
	Net.event("Notify"):FireAllClients("Boss", player.DisplayName .. " broke the Fracture Seal! The arena locks in " .. CFG.countdown .. "s.")
	broadcastState()
	local id = encounter.id
	task.delay(CFG.countdown, function()
		if encounter.id == id and encounter.state == "Countdown" then
			begin()
		end
	end)
	return true, nil
end

local function phaseFor(fraction: number): number
	local phase = 1
	for _, p in CFG.phases do
		if fraction <= p.threshold then
			phase = p.id
		end
	end
	return phase
end

local function chooseAttack(target: BasePart): string?
	local record = encounter.record
	local options = CFG.phaseAttacks[math.min(encounter.phase, 3)]
	local distance = (Vector3.new(target.Position.X, 0, target.Position.Z) - Vector3.new(record.root.Position.X, 0, record.root.Position.Z)).Magnitude
	local candidates = {}
	local t = now()
	for _, id in options do
		local attack = CFG.attacks[id]
		if t >= (encounter.cooldowns[id] or 0) then
			local inRange = true
			if id == "Cleave" then
				inRange = distance <= 16
			elseif id == "Sweep" or id == "Suppression" then
				inRange = distance <= (attack.radius or 15)
			elseif id == "RiftLance" then
				inRange = distance <= 26
			end
			if inRange then
				table.insert(candidates, id)
			end
		end
	end
	if #candidates == 0 then
		return nil
	end
	return candidates[math.random(1, #candidates)]
end

local function tick()
	if encounter.state ~= "Active" then
		return
	end
	local record = encounter.record
	if not record or not record.alive then
		return
	end
	if #activeParticipants() == 0 then
		reset("Every challenger has fallen or left.")
		return
	end
	-- phase transitions
	local fraction = record.health / record.maxHealth
	local phase = phaseFor(fraction)
	if phase > encounter.phase then
		encounter.phase = phase
		encounter.invulnerableUntil = math.max(encounter.invulnerableUntil, now() + 2.5)
		local info = CFG.phases[phase]
		Net.event("Effect"):FireAllClients("BossPhase", { phase = phase, name = info.name, model = record.model })
		Net.event("Notify"):FireAllClients("BossPhase", string.format("Phase %d: %s", phase, info.name))
		if phase == 3 then
			record.humanoid.WalkSpeed = CFG.enrageMoveSpeed
		end
		if phase == 4 then
			local id = encounter.id
			encounter.busy = true
			task.spawn(function()
				finalSequence(id)
			end)
			return
		end
	end
	if encounter.finalActive or encounter.busy or stunned() then
		return
	end
	local target = targetRoot()
	if not target then
		return
	end
	local t = now()
	if t >= encounter.nextAttackAt then
		local attackId = chooseAttack(target)
		if attackId then
			local attack = CFG.attacks[attackId]
			encounter.cooldowns[attackId] = t + attack.cooldown
			encounter.busy = true
			local id = encounter.id
			task.spawn(function()
				local ok, err = pcall(attacks[attackId], id, attack, target)
				if not ok then
					warn("[Boss] attack " .. attackId .. " failed: " .. tostring(err))
				end
				if encounter.id == id then
					encounter.busy = false
					encounter.nextAttackAt = now() + CFG.attackGap[math.min(encounter.phase, 3)]
				end
			end)
			return
		end
	end
	-- approach
	local flat = Vector3.new(target.Position.X - record.root.Position.X, 0, target.Position.Z - record.root.Position.Z)
	if flat.Magnitude > 11 then
		record.humanoid:MoveTo(target.Position - flat.Unit * 9)
	else
		record.humanoid:MoveTo(record.root.Position)
		face(target.Position)
	end
end

-- Called by CombatService after every player hit (cheap for non-boss records).
function BossService.onPlayerHit(_player: Player, _record: any, _result: any)
	-- Contribution is tracked in record.damageBy / mechanicsBy; hook kept for future boss logic.
end

function BossService.victoryBeaconOpen(): boolean
	return now() < victoryBeaconUntil
end

function BossService.Init() end

function BossService.Start()
	-- Seal prompt
	local world = workspace:WaitForChild("World")
	local seal = world:FindFirstChild("WardenSeal", true)
	local prompt = seal and seal:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt then
		prompt.Triggered:Connect(function(player)
			if not Registry.get("SecurityService").allow(player, "Interact") then
				return
			end
			local ok, message = BossService.trigger(player)
			if not ok and message then
				Net.event("Notify"):FireClient(player, "Error", message)
			end
		end)
	end
	local retreat = world:FindFirstChild("ArenaRetreat", true)
	local retreatPrompt = retreat and retreat:FindFirstChildWhichIsA("ProximityPrompt", true)
	if retreatPrompt then
		retreatPrompt.Triggered:Connect(function(player)
			Registry.get("ExpeditionService").teleport(player, WorldConfig.Points.CampArrival)
			Net.event("Notify"):FireClient(player, "Info", "You retreat to the camp. Your Satchel is safe for now.")
		end)
	end

	local Requests = Registry.get("RequestService")
	Requests.on("WardenShortcut", "Request", function(player, _args)
		local profile = Registry.get("PlayerDataService").get(player)
		if profile.bosses.FractureWarden.clears < 1 then
			return false, "Defeat the Warden once to unlock the shortcut."
		end
		if not Registry.get("SecurityService").within(player, WorldConfig.Points.BossGate, 25) then
			return false, "Use the Warden Gate in the Nexus."
		end
		Registry.get("ExpeditionService").teleport(player, WorldConfig.Points.WardenAntechamber)
		return true, "You step through the Warden Gate."
	end)

	local accumulator, broadcastAccumulator = 0, 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		broadcastAccumulator += dt
		if accumulator >= 0.1 then
			accumulator = 0
			local ok, err = pcall(tick)
			if not ok then
				warn("[Boss] tick error: " .. tostring(err))
			end
		end
		if broadcastAccumulator >= 0.25 and (encounter.state == "Active" or encounter.state == "Countdown") then
			broadcastAccumulator = 0
			broadcastState()
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		task.delay(3, function()
			if player.Parent then
				broadcastState()
			end
		end)
	end)
end

return BossService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict
-- Authoritative combat pipeline:
--   input request -> validation (rate, state, cooldown, ownership) -> attack state ->
--   delayed hit resolution (server geometry + line of sight) -> damage -> reactions/effects ->
--   progression (resonance, mastery, quests).
-- Clients only REQUEST actions; damage, targets, parries, cooldowns and rewards are decided here.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local GameConfig = require(Config.GameConfig)
local EssenceConfig = require(Config.EssenceConfig)
local FusionConfig = require(Config.FusionConfig)
local AwakeningConfig = require(Config.AwakeningConfig)
local CombatMath = require(Shared.Combat.CombatMath)
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)
local Abilities = require(script.Parent.Parent.Combat.Abilities)

local CombatService = {}

local CFG = GameConfig.Combat
local PCFG = GameConfig.Player

type PState = {
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	build: any,
	busyUntil: number,
	actionStart: number,
	comboIndex: number,
	lastLightAt: number,
	blocking: boolean,
	blockStart: number,
	lastBlockStart: number,
	parryEligible: boolean,
	iframesUntil: number,
	dodgeReadyAt: number,
	stunUntil: number,
	stamina: number,
	lastStaminaUse: number,
	resonance: number,
	awakenedUntil: number,
	awakenForm: string?,
	signatureUsed: boolean,
	burnoutUntil: number,
	shieldUntil: number,
	shieldAmount: number,
	burnUntil: number,
	burnDps: number,
	evaded: { [string]: boolean },
	parried: { [string]: boolean },
	tonicReadyAt: number,
	healTicks: number,
	bookClearedAt: number,
	swingSerial: number,
	castSerial: number,
	aura: { Instance },
}

local states: { [Player]: PState } = {}
local cooldowns: { [Player]: { [string]: number } } = {}

local function now(): number
	return os.clock()
end

local function profileOf(player: Player): any
	return Registry.get("PlayerDataService").get(player)
end

local function feedback(player: Player, kind: string, data: any?)
	Net.event("CombatFeedback"):FireClient(player, kind, data)
end

local function setAttr(player: Player, key: string, value: any)
	player:SetAttribute(key, value)
end

-- Build ------------------------------------------------------------------------------------

function CombatService.buildFor(player: Player): any
	local profile = profileOf(player)
	local state = if profile then profile.weapons.Katana else { mastery = 1, upgrade = 1, temper = "None", evolution = "None" }
	return CombatMath.weaponBuild("Katana", state)
end

local function trailColorFor(player: Player, build: any): Color3
	local profile = profileOf(player)
	local cosmetics = require(Config.ProgressionConfig).Cosmetics
	if profile then
		local chosen = cosmetics[profile.cosmetics.trail]
		if chosen and chosen.color and profile.cosmetics.owned[chosen.id] then
			return chosen.color
		end
	end
	return build.trailColor
end

function CombatService.refresh(player: Player)
	local ps = states[player]
	if not ps then
		return
	end
	ps.build = CombatService.buildFor(player)
	local katana = ps.character:FindFirstChild("Katana")
	local color = trailColorFor(player, ps.build)
	if katana then
		for _, part in katana:GetChildren() do
			if part:IsA("BasePart") and part.Name:sub(1, 4) == "Edge" then
				part.Color = color
			end
		end
		local blade = katana:FindFirstChild("Blade")
		local trail = blade and blade:FindFirstChild("SwingTrail") :: Trail?
		if trail then
			trail.Color = ColorSequence.new(color)
		end
	end
	setAttr(player, "TrailColor", color)
	setAttr(player, "ComboLength", #ps.build.light)
	setAttr(player, "Evolution", ps.build.evolution)
end

-- Character lifecycle ----------------------------------------------------------------------

function CombatService.onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not humanoid or not root then
		return
	end
	local ps: PState = {
		character = character,
		humanoid = humanoid,
		root = root,
		build = CombatService.buildFor(player),
		busyUntil = 0,
		actionStart = 0,
		comboIndex = 0,
		lastLightAt = 0,
		blocking = false,
		blockStart = 0,
		lastBlockStart = 0,
		parryEligible = false,
		iframesUntil = 0,
		dodgeReadyAt = 0,
		stunUntil = 0,
		stamina = PCFG.MaxStamina,
		lastStaminaUse = 0,
		resonance = 0,
		awakenedUntil = 0,
		awakenForm = nil,
		signatureUsed = false,
		burnoutUntil = 0,
		shieldUntil = 0,
		shieldAmount = 0,
		burnUntil = 0,
		burnDps = 0,
		evaded = {},
		parried = {},
		tonicReadyAt = 0,
		healTicks = 0,
		bookClearedAt = 0,
		swingSerial = 0,
		castSerial = 0,
		aura = {},
	}
	states[player] = ps
	cooldowns[player] = cooldowns[player] or {}
	humanoid.WalkSpeed = PCFG.BaseWalkSpeed
	setAttr(player, "Stamina", ps.stamina)
	setAttr(player, "MaxStamina", PCFG.MaxStamina)
	setAttr(player, "Resonance", 0)
	setAttr(player, "Awakened", false)
	setAttr(player, "AwakenEnds", 0)
	setAttr(player, "Blocking", false)
	setAttr(player, "BurnoutEnds", 0)
	CombatService.refresh(player)
	humanoid.Died:Connect(function()
		if states[player] == ps then
			CombatService.endAwakening(player, false)
			states[player] = nil
		end
	end)
end

function CombatService.onLeave(player: Player)
	states[player] = nil
	cooldowns[player] = nil
end

function CombatService.state(player: Player): PState?
	return states[player]
end

local function alive(ps: PState?): boolean
	return ps ~= nil and ps.humanoid.Health > 0 and ps.character.Parent ~= nil
end

local function updateMovement(_player: Player, ps: PState)
	local t = now()
	local speed = PCFG.BaseWalkSpeed
	if t < ps.stunUntil then
		speed = 0
	elseif ps.blocking then
		speed = PCFG.BlockWalkSpeed
	elseif t < ps.awakenedUntil and ps.awakenForm == "Storm" then
		speed = PCFG.BaseWalkSpeed * 1.15
	end
	if ps.humanoid.WalkSpeed ~= speed then
		ps.humanoid.WalkSpeed = speed
	end
end

local function canAct(ps: PState, t: number): (boolean, string?)
	if not alive(ps) then
		return false, "dead"
	end
	if t < ps.stunUntil then
		return false, "stunned"
	end
	if t < ps.busyUntil - CFG.ActionTolerance then
		return false, "busy"
	end
	return true, nil
end

local function useStamina(player: Player, ps: PState, amount: number): boolean
	if ps.stamina < amount then
		return false
	end
	ps.stamina -= amount
	ps.lastStaminaUse = now()
	setAttr(player, "Stamina", math.floor(ps.stamina))
	return true
end

-- Resonance & Awakening -----------------------------------------------------------------------

function CombatService.addResonance(player: Player, amount: number)
	local ps = states[player]
	if not ps or amount <= 0 then
		return
	end
	local t = now()
	if t < ps.burnoutUntil or t < ps.awakenedUntil then
		return
	end
	local before = ps.resonance
	ps.resonance = math.min(CFG.ResonanceMax, ps.resonance + amount * ps.build.resonanceMult)
	setAttr(player, "Resonance", math.floor(ps.resonance))
	if before < CFG.ResonanceMax and ps.resonance >= CFG.ResonanceMax then
		feedback(player, "ResonanceFull")
	end
end

local function clearAura(ps: PState)
	for _, inst in ps.aura do
		if inst.Parent then
			inst:Destroy()
		end
	end
	ps.aura = {}
end

function CombatService.endAwakening(player: Player, suppressed: boolean)
	local ps = states[player]
	if not ps or ps.awakenedUntil == 0 then
		return
	end
	ps.awakenedUntil = 0
	ps.awakenForm = nil
	ps.burnoutUntil = now() + CFG.AwakeningBurnout
	clearAura(ps)
	setAttr(player, "Awakened", false)
	setAttr(player, "AwakenEnds", 0)
	setAttr(player, "BurnoutEnds", workspace:GetServerTimeNow() + CFG.AwakeningBurnout)
	Net.event("Effect"):FireAllClients("AwakenEnd", { character = ps.character, suppressed = suppressed })
	if suppressed then
		feedback(player, "Suppressed")
	end
	updateMovement(player, ps)
end

local function awaken(player: Player, ps: PState)
	local profile = profileOf(player)
	if not profile then
		return
	end
	local t = now()
	if t < ps.awakenedUntil then
		-- Second press: signature technique (once per awakening).
		if ps.signatureUsed then
			feedback(player, "Rejected", { action = "Awaken", reason = "Signature already used" })
			return
		end
		local ok = canAct(ps, t)
		if not ok then
			return
		end
		ps.signatureUsed = true
		ps.busyUntil = t + 0.6
		local form = AwakeningConfig.Forms[ps.awakenForm or "Ember"]
		CombatService.cast(player, ps, form.signature.id, nil, { signature = true, essences = { form.id } })
		return
	end
	if ps.resonance < CFG.ResonanceMax then
		feedback(player, "Rejected", { action = "Awaken", reason = "Resonance not full" })
		return
	end
	local primary = profile.loadout.primary
	local form = AwakeningConfig.Forms[primary]
	if not form then
		return
	end
	local duration = form.duration
	local essence = profile.essences[primary]
	if essence and essence.mastery >= 4 then
		duration += 3
	end
	ps.resonance = 0
	ps.awakenedUntil = t + duration
	ps.awakenForm = primary
	ps.signatureUsed = false
	setAttr(player, "Resonance", 0)
	setAttr(player, "Awakened", true)
	setAttr(player, "AwakenForm", primary)
	setAttr(player, "AwakenEnds", workspace:GetServerTimeNow() + duration)
	-- Visible to everyone: highlight + aura particles + light.
	clearAura(ps)
	local highlight = Instance.new("Highlight")
	highlight.Name = "AwakeningAura"
	highlight.FillColor = form.color
	highlight.OutlineColor = form.color
	highlight.FillTransparency = 0.78
	highlight.OutlineTransparency = 0.1
	highlight.Parent = ps.character
	table.insert(ps.aura, highlight)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "AwakeningParticles"
	emitter.Color = ColorSequence.new(form.color)
	emitter.LightEmission = 1
	emitter.Rate = 18
	emitter.Lifetime = NumberRange.new(0.6, 1.1)
	emitter.Speed = NumberRange.new(2, 4)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, 6, 0)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	emitter.Parent = ps.root
	table.insert(ps.aura, emitter)
	local light = Instance.new("PointLight")
	light.Color = form.color
	light.Range = 14
	light.Brightness = 2
	light.Parent = ps.root
	table.insert(ps.aura, light)
	Net.event("Effect"):FireAllClients("Awaken", { character = ps.character, color = form.color, form = form.id })
	updateMovement(player, ps)

	local Progression = Registry.get("ProgressionService")
	Progression.stat(player, "awakenings")
	Progression.achieve(player, "FirstAwakening")
	Progression.present(player, "FirstAwakening", {
		title = form.displayName,
		subtitle = "Resonance Awakening",
		body = form.description .. " Press G again for " .. form.signature.displayName .. ". Lasts " .. duration .. "s.",
		color = form.color,
	})
	Registry.get("QuestService").record(player, "Awaken", { form = form.id })
end

-- Hit resolution ----------------------------------------------------------------------------

local losParams = RaycastParams.new()
losParams.FilterType = Enum.RaycastFilterType.Include

local function lineOfSight(from: Vector3, to: Vector3, padding: number): boolean
	local world = workspace:FindFirstChild("World")
	if not world then
		return true
	end
	losParams.FilterDescendantsInstances = { world, workspace.Terrain }
	local origin = from + Vector3.new(0, 1.5, 0)
	local target = to + Vector3.new(0, 1.5, 0)
	local delta = target - origin
	if delta.Magnitude < 0.5 then
		return true
	end
	local hit = workspace:Raycast(origin, delta, losParams)
	if not hit then
		return true
	end
	return (hit.Position - origin).Magnitude >= delta.Magnitude - padding
end
CombatService.lineOfSight = lineOfSight

-- Damage bonus from statuses on the target (mastery passives).
local function statusBonus(record: any): number
	local Enemy = Registry.get("EnemyService")
	local bonus = 1
	local charged = Enemy.hasStatus(record, "Charged")
	if charged and charged.bonus then
		bonus += charged.bonus
	end
	local gathered = Enemy.hasStatus(record, "Gathered")
	if gathered and gathered.bonus then
		bonus += gathered.bonus
	end
	return bonus
end

local function awakenMult(ps: PState): number
	if now() < ps.awakenedUntil and ps.awakenForm then
		return AwakeningConfig.Forms[ps.awakenForm].damageMult
	end
	return 1
end

local function awakenOnHit(player: Player, ps: PState, record: any)
	if now() >= ps.awakenedUntil or not ps.awakenForm then
		return
	end
	local Enemy = Registry.get("EnemyService")
	local form = AwakeningConfig.Forms[ps.awakenForm]
	if form.onHit == "Burn" then
		Enemy.applyStatus(record, "Burning", { dps = 4, expires = now() + 3, by = player.UserId })
	elseif form.onHit == "Gather" then
		Enemy.applyStatus(record, "Gathered", { expires = now() + 3, by = player.UserId, bonus = 0 })
	elseif form.onHit == "Spark" then
		local origin = record.root.Position
		local others = Enemy.query(function(position, _r)
			return (position - origin).Magnitude <= 12
		end, 4)
		for _, other in others do
			if other ~= record then
				Enemy.damage(other, ps.build.base * 0.5, { player = player, kind = "Spark", position = ps.root.Position })
				Enemy.applyStatus(other, "Charged", { expires = now() + 3, by = player.UserId })
				Net.event("Effect"):FireAllClients("Lightning", { points = { origin, other.root.Position }, color = form.color })
				break
			end
		end
	end
end

-- Applies a weapon strike to every enemy inside `shape`. Returns hit list.
local function weaponHits(player: Player, ps: PState, shape: any, strike: any, mult: number, extra: any?): { any }
	local Enemy = Registry.get("EnemyService")
	local Quest = Registry.get("QuestService")
	local origin = ps.root.Position
	local targets = Enemy.query(function(position, radius)
		return Enemy.shapeContains(shape, position, radius)
	end, GameConfig.Combat.MaxTargetsPerSwing)
	local hits = {}
	local trainingHits, realHits = 0, 0
	for _, record in targets do
		if lineOfSight(origin, record.root.Position, record.radius + 1) then
			local amount = ps.build.base * strike.damage * mult * awakenMult(ps) * statusBonus(record)
			local result = Enemy.damage(record, amount, {
				player = player,
				position = origin,
				guardBreak = strike.guardBreak,
				stagger = (strike.stagger or 0) + ((extra and extra.staggerBonus) or 0),
				kind = "Weapon",
				weakPointCheck = true,
			})
			if result.dealt > 0 or result.guarded then
				table.insert(hits, {
					position = record.root.Position,
					amount = math.floor(result.dealt + 0.5),
					guarded = result.guarded,
					killed = result.killed,
				})
				if record.kind == "Training" then
					trainingHits += 1
				else
					realHits += 1
				end
				Quest.record(player, "Hit", { targetKind = record.kind, weapon = "Katana" })
				if result.interrupted then
					CombatService.addResonance(player, AwakeningConfig.Gains.Interrupt)
					feedback(player, "Interrupt", { position = record.root.Position })
				end
				awakenOnHit(player, ps, record)
				Registry.get("BossService").onPlayerHit(player, record, result)
			end
		end
	end
	if #hits > 0 then
		CombatService.addResonance(player, strike.resonance)
		local Progression = Registry.get("ProgressionService")
		local mastery = math.min(3, realHits) * 3 + (if trainingHits > 0 and realHits == 0 then 1 else 0)
		Progression.addWeaponMastery(player, "Katana", mastery)
		Progression.achieve(player, "FirstSteel")
		feedback(player, "Hits", { hits = hits, finisher = strike.finisher })
		Net.fireAllExcept("Effect", player, "Impacts", { hits = hits, color = ps.build.trailColor })
	end
	return hits
end

local function forwardShape(ps: PState, dir: Vector3, length: number, width: number): any
	local origin = ps.root.Position - dir * 1.5
	return { kind = "Line", origin = Vector3.new(origin.X, ps.root.Position.Y - 2.5, origin.Z), dir = dir, length = length + 1.5, width = width }
end

-- Light attack chain
local function lightAttack(player: Player, ps: PState, dir: Vector3)
	local t = now()
	local ok, reason = canAct(ps, t)
	if not ok or ps.blocking then
		feedback(player, "Rejected", { action = "Light", reason = reason or "blocking" })
		return
	end
	local build = ps.build
	local light = build.light
	local speed = build.attackSpeed
	if t < ps.awakenedUntil and ps.awakenForm then
		speed *= AwakeningConfig.Forms[ps.awakenForm].attackSpeed
	end
	local index = 1
	if t - ps.lastLightAt <= build.comboResetTime + 0.6 then
		index = (ps.comboIndex % #light) + 1
	end
	local strike = light[index]
	local duration = (strike.windup + strike.recovery) / speed
	ps.comboIndex = index
	ps.lastLightAt = t
	ps.busyUntil = t + duration
	ps.actionStart = t
	ps.swingSerial += 1
	local serial = ps.swingSerial
	Net.fireAllExcept("Effect", player, "Swing", { character = ps.character, index = index, color = trailColorFor(player, build) })
	task.delay(strike.windup / speed, function()
		if states[player] ~= ps or not alive(ps) or ps.swingSerial ~= serial then
			return
		end
		if ps.stunUntil > ps.actionStart then
			return -- interrupted
		end
		weaponHits(player, ps, forwardShape(ps, dir, strike.range, strike.width), strike, 1)
		if strike.finisher and build.finisherShockwave then
			local center = ps.root.Position + dir * 4
			weaponHits(player, ps, { kind = "Circle", center = center - Vector3.new(0, 2.5, 0), radius = 8 }, {
				damage = 1.0,
				resonance = 1,
			}, 1)
			Net.event("Effect"):FireAllClients("Nova", { position = center, radius = 8, color = Color3.fromRGB(255, 210, 90) })
		end
	end)
end

local function heavyAttack(player: Player, ps: PState, dir: Vector3)
	local t = now()
	local ok, reason = canAct(ps, t)
	if not ok or ps.blocking then
		feedback(player, "Rejected", { action = "Heavy", reason = reason or "blocking" })
		return
	end
	local build = ps.build
	local heavy = build.heavy
	if not useStamina(player, ps, heavy.stamina) then
		feedback(player, "Rejected", { action = "Heavy", reason = "stamina" })
		return
	end
	local speed = build.attackSpeed
	ps.busyUntil = t + (heavy.windup + heavy.recovery) / speed
	ps.actionStart = t
	ps.comboIndex = 0
	ps.swingSerial += 1
	local serial = ps.swingSerial
	Net.fireAllExcept("Effect", player, "Swing", { character = ps.character, index = 0, heavy = true, color = trailColorFor(player, build) })
	task.delay(heavy.windup / speed, function()
		if states[player] ~= ps or not alive(ps) or ps.swingSerial ~= serial or ps.stunUntil > ps.actionStart then
			return
		end
		local extra = { staggerBonus = build.heavyStaggerBonus }
		if heavy.lunge then
			-- Gale Thrust: dash forward (stopping at walls), damage along the path.
			local start = ps.root.Position
			local distance = heavy.lunge
			local world = workspace:FindFirstChild("World")
			if world then
				losParams.FilterDescendantsInstances = { world, workspace.Terrain }
				local hit = workspace:Raycast(start, dir * distance, losParams)
				if hit then
					distance = math.max(0, (hit.Position - start).Magnitude - 2)
				end
			end
			local finish = start + dir * distance
			ps.iframesUntil = math.max(ps.iframesUntil, now() + 0.25)
			ps.character:PivotTo(CFrame.lookAt(finish, finish + dir))
			Net.event("Effect"):FireAllClients("Dash", { from = start, to = finish, color = build.trailColor })
			weaponHits(player, ps, {
				kind = "Line",
				origin = start - Vector3.new(0, 2.5, 0),
				dir = dir,
				length = distance + heavy.range,
				width = heavy.width,
			}, heavy, build.heavyMult, extra)
		elseif heavy.radius then
			-- Bulwark Slam: area slam + protective shield.
			local center = ps.root.Position
			weaponHits(player, ps, { kind = "Circle", center = center - Vector3.new(0, 2.5, 0), radius = heavy.radius }, heavy, build.heavyMult, extra)
			ps.shieldUntil = now() + heavy.shieldDuration
			ps.shieldAmount = heavy.shield
			Net.event("Effect"):FireAllClients("Shield", { character = ps.character, duration = heavy.shieldDuration })
			Net.event("Effect"):FireAllClients("Nova", { position = center, radius = heavy.radius, color = build.trailColor })
		else
			weaponHits(player, ps, forwardShape(ps, dir, heavy.range, heavy.width), heavy, build.heavyMult, extra)
		end
	end)
end

local function blockStart(player: Player, ps: PState)
	local t = now()
	local ok = canAct(ps, t)
	if not ok or ps.blocking then
		return
	end
	ps.blocking = true
	ps.blockStart = t
	-- Parry spam guard: the perfect-parry window only opens if the previous block began >=0.7s ago.
	ps.parryEligible = t - ps.lastBlockStart >= 0.7
	ps.lastBlockStart = t
	setAttr(player, "Blocking", true)
	updateMovement(player, ps)
end

local function blockEnd(player: Player, ps: PState)
	if not ps.blocking then
		return
	end
	ps.blocking = false
	setAttr(player, "Blocking", false)
	updateMovement(player, ps)
end

local function dodge(player: Player, ps: PState, dir: Vector3)
	local t = now()
	local ok, reason = canAct(ps, t)
	if not ok then
		feedback(player, "Rejected", { action = "Dodge", reason = reason })
		return
	end
	if t < ps.dodgeReadyAt then
		feedback(player, "Rejected", { action = "Dodge", reason = "cooldown" })
		return
	end
	local d = ps.build.dodge
	if not useStamina(player, ps, d.stamina) then
		feedback(player, "Rejected", { action = "Dodge", reason = "stamina" })
		return
	end
	blockEnd(player, ps)
	local cooldown = ps.build.dodgeCooldown
	if t < ps.awakenedUntil and ps.awakenForm then
		cooldown *= AwakeningConfig.Forms[ps.awakenForm].dodgeCooldownMult or 1
	end
	ps.dodgeReadyAt = t + cooldown
	ps.iframesUntil = t + d.iframes + 0.05
	ps.busyUntil = t + d.duration
	ps.comboIndex = 0
	Net.fireAllExcept("Effect", player, "Dodge", { character = ps.character, dir = dir })
end

local function useTonic(player: Player, ps: PState)
	local t = now()
	if not alive(ps) or t < ps.tonicReadyAt then
		return
	end
	if ps.humanoid.Health >= ps.humanoid.MaxHealth then
		feedback(player, "Rejected", { action = "Tonic", reason = "Health is full" })
		return
	end
	if not Registry.get("InventoryService").spend(player, { EmberTonic = 1 }) then
		feedback(player, "Rejected", { action = "Tonic", reason = "No Ember Tonics (craft them at the Artisan Bench)" })
		return
	end
	ps.tonicReadyAt = t + 8
	ps.healTicks = 4
	Net.event("Cooldown"):FireClient(player, "H", workspace:GetServerTimeNow() + 8, 8)
	Net.event("Effect"):FireAllClients("Heal", { character = ps.character })
end

-- Abilities ----------------------------------------------------------------------------------

local function abilityForSlot(profile: any, slot: string): (string?, string?, { string }?)
	local primary = profile.loadout.primary
	if slot == "Q" or slot == "E" then
		local essence = EssenceConfig.Essences[primary]
		if not essence or not essence.implemented then
			return nil, "No essence equipped", nil
		end
		local abilityId = essence.abilities[slot]
		local ability = EssenceConfig.Abilities[abilityId]
		local record = profile.essences[primary]
		if not record or not record.unlocked then
			return nil, "Essence locked", nil
		end
		if record.mastery < ability.masteryRequired then
			return nil, string.format("%s needs %s mastery %d", ability.displayName, essence.displayName, ability.masteryRequired), nil
		end
		return abilityId, nil, { primary }
	elseif slot == "R" then
		local fusionId = FusionConfig.forPair(primary, profile.loadout.secondary)
		if not fusionId then
			return nil, "Equip two compatible essences for a fusion", nil
		end
		local def = FusionConfig.Fusions[fusionId]
		if not def.implemented then
			return nil, def.displayName .. " cannot be cast yet", nil
		end
		local record = profile.fusions[fusionId]
		if not record or not record.unlocked then
			return nil, def.displayName .. " is not unlocked (see the Fusion Codex)", nil
		end
		return def.ability, nil, def.essences
	end
	return nil, "Invalid slot", nil
end
CombatService.abilityForSlot = abilityForSlot

-- Shared context passed to ability implementations.
function CombatService.cast(player: Player, ps: PState, abilityId: string, aim: Vector3?, opts: any?): boolean
	local profile = profileOf(player)
	local def = EssenceConfig.Abilities[abilityId]
	local signature = nil
	if not def then
		for _, form in AwakeningConfig.Forms do
			if form.signature.id == abilityId then
				signature = form.signature
			end
		end
		if not signature then
			return false
		end
	end
	local essences: { string } = (opts and opts.essences) or { (def and def.essence) or "Ember" }
	local masteryBonus = 1
	if #essences == 1 then
		local record = profile.essences[essences[1]]
		masteryBonus = if record and record.mastery >= 5 then 1.15 else 1
	end
	local power = CombatMath.abilityPower(profile.level, 1, ps.build.abilityMult) * masteryBonus * awakenMult(ps)
	ps.castSerial += 1
	local castId = ps.castSerial
	local Enemy = Registry.get("EnemyService")
	local dir = ps.root.CFrame.LookVector
	dir = Vector3.new(dir.X, 0, dir.Z).Unit
	if aim then
		local flat = Vector3.new(aim.X - ps.root.Position.X, 0, aim.Z - ps.root.Position.Z)
		if flat.Magnitude > 1 then
			dir = flat.Unit
		end
	end
	local anyHit = false
	local hitCount = 0
	local ctx = {
		player = player,
		ps = ps,
		def = def or signature,
		power = power,
		origin = ps.root.Position,
		dir = dir,
		aim = aim or (ps.root.Position + dir * 10),
		castId = castId,
		essences = essences,
		mastery = function(essence: string): number
			local record = profile.essences[essence]
			return if record then record.mastery else 1
		end,
	}
	-- Damage every enemy in a shape. Returns list of { record, result }.
	function ctx.hit(shape: any, mult: number, info: any?): { any }
		local out = {}
		local targets = Enemy.query(function(position, radius)
			return Enemy.shapeContains(shape, position, radius)
		end, 10)
		for _, record in targets do
			if lineOfSight(shape.center or shape.origin or ps.root.Position, record.root.Position, record.radius + 2) then
				local amount = power * mult * statusBonus(record)
				local result = Enemy.damage(record, amount, {
					player = player,
					position = ps.root.Position,
					kind = "Ability",
					stagger = info and info.stagger,
					guardBreak = info and info.guardBreak,
				})
				if result.dealt > 0 then
					table.insert(out, { record = record, result = result })
					hitCount += 1
					if not anyHit then
						anyHit = true
						CombatService.addResonance(player, (def and def.resonance) or 4)
					end
					if result.interrupted then
						CombatService.addResonance(player, AwakeningConfig.Gains.Interrupt)
					end
					Net.event("Effect"):FireAllClients("Impacts", {
						hits = { { position = record.root.Position, amount = math.floor(result.dealt + 0.5) } },
						color = ctx.color,
					})
					if not (opts and opts.signature) then
						Registry.get("FusionService").onAbilityHit(player, record, essences, castId)
					end
					Registry.get("CoopService").onAbilityHit(player, record, essences, castId)
					Registry.get("BossService").onPlayerHit(player, record, result)
				end
			end
		end
		return out
	end
	function ctx.status(record: any, name: string, data: any)
		data.by = player.UserId
		Enemy.applyStatus(record, name, data)
	end
	function ctx.displace(record: any, position: Vector3, duration: number)
		Enemy.displace(record, position, duration)
	end
	function ctx.effect(name: string, data: any)
		Net.event("Effect"):FireAllClients(name, data)
	end
	ctx.los = lineOfSight
	function ctx.alive(): boolean
		return states[player] == ps and alive(ps)
	end
	function ctx.query(predicate: (Vector3, number) -> boolean, max: number?)
		return Enemy.query(predicate, max)
	end
	function ctx.finish()
		-- essence mastery for ability hits
		if hitCount > 0 and not (opts and opts.signature) then
			local Progression = Registry.get("ProgressionService")
			for _, essence in essences do
				Progression.addEssenceXp(player, essence, math.min(12, hitCount * 4))
			end
		end
	end
	ctx.color = if def and def.essence and EssenceConfig.Essences[def.essence]
		then EssenceConfig.Essences[def.essence].color
		else (if signature then AwakeningConfig.Forms[essences[1]].color else Color3.fromRGB(255, 200, 120))
	local ok, err = pcall(Abilities.cast, abilityId, ctx)
	if not ok then
		warn("[Combat] ability " .. abilityId .. " failed: " .. tostring(err))
		return false
	end
	return true
end

local function ability(player: Player, ps: PState, slot: string, aim: any)
	local profile = profileOf(player)
	if not profile then
		return
	end
	local t = now()
	local ok, reason = canAct(ps, t)
	if not ok or ps.blocking then
		feedback(player, "Rejected", { action = slot, reason = reason or "blocking" })
		return
	end
	local abilityId, why, essences = abilityForSlot(profile, slot)
	if not abilityId then
		feedback(player, "Rejected", { action = slot, reason = why })
		return
	end
	local def = EssenceConfig.Abilities[abilityId]
	local cds = cooldowns[player]
	if t < (cds[abilityId] or 0) - CFG.ActionTolerance then
		feedback(player, "Rejected", { action = slot, reason = "cooldown" })
		return
	end
	local Security = Registry.get("SecurityService")
	local aimPoint = Security.clampAim(player, aim, def.range or 20)
	cds[abilityId] = t + def.cooldown
	ps.busyUntil = t + 0.35
	ps.actionStart = t
	ps.comboIndex = 0
	Net.event("Cooldown"):FireClient(player, slot, workspace:GetServerTimeNow() + def.cooldown, def.cooldown)
	Net.fireAllExcept("Effect", player, "Cast", { character = ps.character, ability = abilityId })
	CombatService.cast(player, ps, abilityId, aimPoint, { essences = essences })
	if slot == "R" then
		local Progression = Registry.get("ProgressionService")
		Progression.stat(player, "fusionsCast")
		Registry.get("QuestService").record(player, "FusionCast", { fusion = abilityId })
		Net.event("Effect"):FireClient(player, "Sound", { name = "FusionActivation" })
	end
end

-- Incoming damage to players -----------------------------------------------------------------

-- src = { attacker = record?, attackKey, parryable, telegraphed, burn?, position?, endsAwakening?, unblockable? }
-- Returns "None" | "Evaded" | "Parried" | "Blocked" | "Hit"
function CombatService.damagePlayer(player: Player, amount: number, src: any): string
	local ps = states[player]
	if not ps or not alive(ps) then
		return "None"
	end
	local t = now()
	local key = src.attackKey
	if t <= ps.iframesUntil then
		if src.telegraphed and key and not ps.evaded[key] then
			ps.evaded[key] = true
			CombatService.addResonance(player, AwakeningConfig.Gains.DodgeTelegraph)
			Registry.get("QuestService").record(player, "DodgeTelegraph", {})
			Registry.get("ProgressionService").stat(player, "dodges")
			feedback(player, "Evaded")
		end
		return "Evaded"
	end
	local inFront = true
	if src.position then
		local look = ps.root.CFrame.LookVector
		local to = Vector3.new(src.position.X - ps.root.Position.X, 0, src.position.Z - ps.root.Position.Z)
		if to.Magnitude > 0.5 then
			inFront = Vector3.new(look.X, 0, look.Z).Unit:Dot(to.Unit) > -0.3
		end
	end
	if ps.blocking and inFront and not src.unblockable then
		local window = ps.build.parryWindow + CFG.ParryLatencyAllowance
		if src.parryable and ps.parryEligible and t - ps.blockStart <= window then
			if key then
				if ps.parried[key] then
					return "Parried"
				end
				ps.parried[key] = true
			end
			CombatService.addResonance(player, AwakeningConfig.Gains.PerfectParry)
			local Progression = Registry.get("ProgressionService")
			Progression.stat(player, "perfectParries")
			Progression.achieve(player, "PerfectGuard")
			Registry.get("QuestService").record(player, "PerfectParry", {})
			feedback(player, "Parry")
			Net.event("Effect"):FireAllClients("Parry", { position = ps.root.Position + ps.root.CFrame.LookVector * 2, character = ps.character })
			if ps.build.riposte and src.attacker and src.attacker.alive then
				local Enemy = Registry.get("EnemyService")
				Enemy.damage(src.attacker, ps.build.base * ps.build.riposte, {
					player = player,
					position = ps.root.Position,
					kind = "Riposte",
				})
				Net.event("Effect"):FireAllClients("Riposte", { from = ps.root.Position, to = src.attacker.root.Position })
			end
			return "Parried"
		end
		amount *= 1 - ps.build.blockReduction
		ps.stamina -= ps.build.blockStamina
		ps.lastStaminaUse = t
		if ps.stamina <= 0 then
			ps.stamina = 0
			blockEnd(player, ps)
			ps.stunUntil = t + 1.0
			feedback(player, "GuardBroken")
		else
			feedback(player, "Blocked", { amount = math.floor(amount + 0.5) })
		end
		setAttr(player, "Stamina", math.floor(ps.stamina))
	else
		if t < ps.awakenedUntil and ps.awakenForm then
			amount *= AwakeningConfig.Forms[ps.awakenForm].damageTakenMult
		end
		if t < ps.shieldUntil then
			amount *= 1 - ps.shieldAmount
		end
		if amount >= 18 then
			ps.stunUntil = math.max(ps.stunUntil, t + 0.35)
		end
		if src.burn then
			ps.burnUntil = t + src.burn.duration
			ps.burnDps = src.burn.dps
		end
		feedback(player, "Hurt", { amount = math.floor(amount + 0.5) })
	end
	if src.endsAwakening and t < ps.awakenedUntil then
		CombatService.endAwakening(player, true)
	end
	ps.humanoid:TakeDamage(amount)
	updateMovement(player, ps)
	return if ps.blocking then "Blocked" else "Hit"
end

-- Called by EnemyService/BossService when an attack resolves.
function CombatService.enemyStrike(record: any, attack: any, shape: any, key: string, damage: number)
	local Enemy = Registry.get("EnemyService")
	for player, ps in states do
		if alive(ps) and Enemy.shapeContains(shape, ps.root.Position, 1.2) then
			if record.ownerUserId and player.UserId ~= record.ownerUserId then
				continue
			end
			local outcome = CombatService.damagePlayer(player, damage, {
				attacker = record,
				attackKey = key,
				parryable = attack.parryable,
				telegraphed = true,
				burn = attack.burn,
				position = record.root.Position,
				endsAwakening = attack.endsAwakening,
			})
			if outcome == "Parried" then
				if record.onParried then
					record.onParried(record, player, attack)
				else
					Enemy.onParried(record, player)
				end
			end
		end
	end
end

-- Hazards (boss fractures, lava) that are not tied to an enemy attack key.
function CombatService.hazardDamage(player: Player, amount: number, src: any?): string
	return CombatService.damagePlayer(player, amount, src or { telegraphed = false })
end

function CombatService.statusDamage(record: any, amount: number, source: Player?, kind: string)
	Registry.get("EnemyService").damage(record, amount, { player = source, kind = kind })
end

function CombatService.onEnemyKilled(record: any, _killer: Player?)
	-- Ember mastery 3 "Wildfire": burning enemies spread their burn on death.
	local Enemy = Registry.get("EnemyService")
	local burning = Enemy.hasStatus(record, "Burning")
	if not burning or not burning.by then
		return
	end
	local source = Players:GetPlayerByUserId(burning.by)
	local profile = source and profileOf(source)
	if not profile or profile.essences.Ember.mastery < 3 then
		return
	end
	local center = record.root.Position
	for _, other in Enemy.query(function(position, _r)
		return (position - center).Magnitude <= 9
	end, 5) do
		if other ~= record then
			Enemy.applyStatus(other, "Burning", { dps = burning.dps, expires = os.clock() + 3, by = burning.by })
		end
	end
	Net.event("Effect"):FireAllClients("Nova", { position = center, radius = 9, color = Color3.fromRGB(255, 120, 50) })
end

-- Remote handling ----------------------------------------------------------------------------

local function onAction(player: Player, action: any, payload: any)
	local Security = Registry.get("SecurityService")
	if type(action) ~= "string" or #action > 16 then
		Security.flag(player, "bad combat action")
		return
	end
	if payload ~= nil and type(payload) ~= "table" then
		return
	end
	payload = payload or {}
	local category = if action == "Ability" or action == "Awaken" or action == "Tonic" then "Ability" else "Combat"
	if not Security.allow(player, category) then
		return
	end
	local ps = states[player]
	if not ps or not alive(ps) or not profileOf(player) then
		return
	end
	local dir = Security.direction(payload.dir)
	if not dir then
		local look = ps.root.CFrame.LookVector
		dir = Vector3.new(look.X, 0, look.Z).Unit
	end
	if action == "Light" then
		lightAttack(player, ps, dir :: Vector3)
	elseif action == "Heavy" then
		heavyAttack(player, ps, dir :: Vector3)
	elseif action == "BlockStart" then
		blockStart(player, ps)
	elseif action == "BlockEnd" then
		blockEnd(player, ps)
	elseif action == "Dodge" then
		dodge(player, ps, dir :: Vector3)
	elseif action == "Ability" then
		local slot = payload.slot
		if slot ~= "Q" and slot ~= "E" and slot ~= "R" then
			Security.flag(player, "bad ability slot")
			return
		end
		ability(player, ps, slot, payload.aim)
	elseif action == "Awaken" then
		awaken(player, ps)
	elseif action == "Tonic" then
		useTonic(player, ps)
	else
		Security.flag(player, "unknown combat action " .. action)
	end
end

function CombatService.Init() end

function CombatService.Start()
	Net.event("CombatAction").OnServerEvent:Connect(onAction)
	Players.PlayerRemoving:Connect(CombatService.onLeave)

	local accumulator, slow = 0, 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		slow += dt
		if accumulator < 0.1 then
			return
		end
		local step = accumulator
		accumulator = 0
		local t = now()
		for player, ps in states do
			if not alive(ps) then
				continue
			end
			-- stamina regen
			if t - ps.lastStaminaUse >= PCFG.StaminaRegenDelay and ps.stamina < PCFG.MaxStamina then
				local rate = PCFG.StaminaRegenPerSecond * (if ps.blocking then 0.4 else 1)
				ps.stamina = math.min(PCFG.MaxStamina, ps.stamina + rate * step)
				setAttr(player, "Stamina", math.floor(ps.stamina))
			end
			if ps.awakenedUntil > 0 and t >= ps.awakenedUntil then
				CombatService.endAwakening(player, false)
			end
			updateMovement(player, ps)
		end
		if slow >= 0.5 then
			slow = 0
			for _, ps in states do
				if alive(ps) then
					if t < ps.burnUntil then
						ps.humanoid:TakeDamage(ps.burnDps * 0.5)
					end
					if ps.healTicks > 0 then
						ps.healTicks -= 1
						ps.humanoid.Health = math.min(ps.humanoid.MaxHealth, ps.humanoid.Health + ps.humanoid.MaxHealth * 0.1)
					end
					-- bound the per-attack bookkeeping tables
					if t - ps.bookClearedAt > 20 then
						ps.bookClearedAt = t
						ps.evaded = {}
						ps.parried = {}
					end
				end
			end
		end
	end)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">CoopService</string>
            <string name="Source"><![CDATA[--!strict
-- Cooperative Resonance: a primer status applied by one player + a detonating essence from a
-- DIFFERENT player within the window. Validated entirely on the server: players, timing,
-- positions, ownership of the primer, per-pair cooldowns and once-per-cast limits.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local CoopConfig = require(Shared.Config.CoopConfig)
local AwakeningConfig = require(Shared.Config.AwakeningConfig)
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)

local CoopService = {}

local pairCooldowns: { [string]: number } = {}
local lastCast: { [Player]: number } = {}

local function pairKey(comboId: string, a: number, b: number): string
	return comboId .. ":" .. math.min(a, b) .. ":" .. math.max(a, b)
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Grants rewards + feedback for a successful co-op combo (also used by BossService for Breach).
function CoopService.reward(players: { Player }, comboId: string, position: Vector3)
	local combo = CoopConfig.Combos[comboId]
	local Progression = Registry.get("ProgressionService")
	local Quest = Registry.get("QuestService")
	local Combat = Registry.get("CombatService")
	local names = {}
	for _, p in players do
		table.insert(names, p.DisplayName)
	end
	for _, p in players do
		Combat.addResonance(p, AwakeningConfig.Gains.CoopResonance)
		Progression.stat(p, "coopCombos")
		Progression.achieve(p, "Bonded")
		Quest.record(p, "Coop", { combo = comboId })
		Net.event("Notify"):FireClient(p, "Coop", combo.displayName, { players = names, color = combo.color })
	end
	Net.event("Effect"):FireAllClients("Coop", { position = position, name = combo.displayName, color = combo.color, players = names })
end

function CoopService.onAbilityHit(player: Player, record: any, essences: { string }, castId: number)
	if record.kind == "Training" or lastCast[player] == castId then
		return
	end
	local Enemy = Registry.get("EnemyService")
	local t = os.clock()
	for _, id in CoopConfig.Order do
		local combo = CoopConfig.Combos[id]
		if not combo.boss and table.find(essences, combo.detonatorEssence) then
			local primer = Enemy.hasStatus(record, combo.primerTag)
			if primer and primer.by and primer.by ~= player.UserId and t - primer.time <= CoopConfig.Window then
				local partner = Players:GetPlayerByUserId(primer.by)
				local myRoot = rootOf(player)
				local partnerRoot = partner and rootOf(partner)
				local key = pairKey(id, player.UserId, primer.by)
				if
					partner
					and myRoot
					and partnerRoot
					and (myRoot.Position - record.root.Position).Magnitude <= CoopConfig.MaxDistance
					and (partnerRoot.Position - record.root.Position).Magnitude <= CoopConfig.MaxDistance
					and t >= (pairCooldowns[key] or 0)
				then
					pairCooldowns[key] = t + CoopConfig.PairCooldown
					lastCast[player] = castId
					local center = record.root.Position
					local targets = Enemy.query(function(position, r)
						return (Vector3.new(position.X - center.X, 0, position.Z - center.Z)).Magnitude <= combo.radius + r
					end, 8)
					for _, target in targets do
						local result = Enemy.damage(target, combo.damage, { player = player, kind = "Coop", stagger = 0.6, position = myRoot.Position })
						if result.dealt > 0 then
							target.mechanicsBy[partner.UserId] = (target.mechanicsBy[partner.UserId] or 0) + 1
						end
						if combo.effect == "ChainBurst" then
							Net.event("Effect"):FireAllClients("Lightning", { points = { center + Vector3.new(0, 4, 0), target.root.Position }, color = combo.color })
						end
					end
					CoopService.reward({ player, partner }, id, center)
					return
				end
			end
		end
	end
end

function CoopService.Init() end

function CoopService.Start()
	Players.PlayerRemoving:Connect(function(player)
		lastCast[player] = nil
	end)
	-- Bound the pair-cooldown table.
	task.spawn(function()
		while true do
			task.wait(60)
			local t = os.clock()
			for key, expires in pairCooldowns do
				if expires < t then
					pairCooldowns[key] = nil
				end
			end
		end
	end)
end

return CoopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">CraftingService</string>
            <string name="Source"><![CDATA[--!strict
-- Forge & Artisan Bench. Deterministic recipes; every check and mutation happens here.
-- Requests must be made near the relevant station. No recipe can destroy equipment.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local RecipeConfig = require(Config.RecipeConfig)
local WeaponConfig = require(Config.WeaponConfig)
local WorldConfig = require(Config.WorldConfig)
local Costs = require(Shared.Inventory.Costs)
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)

local CraftingService = {}

local busy: { [Player]: boolean } = {}

local function near(player: Player, point: Vector3): boolean
	return Registry.get("SecurityService").within(player, point, 30)
end

local function nearForge(player: Player): boolean
	return near(player, WorldConfig.Points.Forge) or near(player, WorldConfig.Points.ArtisanBench)
end

-- Wraps a transaction so one player cannot run two at once (double-click / duplicate requests).
local function transaction(player: Player, fn: () -> (boolean, string?)): (boolean, string?)
	if busy[player] then
		return false, "Working on your last request..."
	end
	busy[player] = true
	local ok, a, b = pcall(fn)
	busy[player] = nil
	if not ok then
		warn("[Crafting] " .. tostring(a))
		return false, "Crafting failed."
	end
	return a, b
end

local function celebrate(player: Player, title: string)
	Net.event("Effect"):FireAllClients("Craft", { character = player.Character })
	Net.event("Effect"):FireClient(player, "Sound", { name = "CraftSuccess" })
	Net.event("Notify"):FireClient(player, "Craft", title)
	Registry.get("ProgressionService").stat(player, "crafts")
end

function CraftingService.Init() end

function CraftingService.Start()
	local Requests = Registry.get("RequestService")
	local PlayerData = Registry.get("PlayerDataService")
	local Inventory = Registry.get("InventoryService")

	Requests.on("UpgradeWeapon", "Request", function(player, args)
		if args.weapon ~= "Katana" then
			return false, "Unknown weapon."
		end
		if not nearForge(player) then
			return false, "Upgrades are done at the Forge."
		end
		return transaction(player, function()
			local profile = PlayerData.get(player)
			local weapon = profile.weapons.Katana
			local target = weapon.upgrade + 1
			local recipe = RecipeConfig.Upgrades.Katana[target]
			if not recipe then
				return false, "Already at maximum upgrade."
			end
			if profile.level < recipe.level then
				return false, "Requires level " .. recipe.level
			end
			if not Inventory.spend(player, recipe.cost) then
				local _, missing = Costs.canAfford(profile, recipe.cost)
				return false, "Missing: " .. table.concat(missing, ", ")
			end
			weapon.upgrade = target
			PlayerData.markDirty(player)
			Registry.get("CombatService").refresh(player)
			Registry.get("QuestService").record(player, "Upgrade", { weapon = "Katana", level = target })
			celebrate(player, string.format("Riftsteel Katana +%d", target - 1))
			return true, "Katana upgraded to +" .. (target - 1)
		end)
	end)

	Requests.on("ApplyTemper", "Request", function(player, args)
		local temperId = args.temper
		if type(temperId) ~= "string" or not RecipeConfig.Tempers[temperId] or not WeaponConfig.Tempers[temperId] then
			return false, "Unknown temper."
		end
		if not nearForge(player) then
			return false, "Tempers are applied at the Forge."
		end
		return transaction(player, function()
			local profile = PlayerData.get(player)
			local weapon = profile.weapons.Katana
			if weapon.temper == temperId then
				return false, "That temper is already applied."
			end
			local recipe = RecipeConfig.Tempers[temperId]
			if recipe.blueprint and not profile.blueprints[recipe.blueprint] then
				return false, "Requires a blueprint you have not found."
			end
			if not Inventory.spend(player, recipe.cost) then
				local _, missing = Costs.canAfford(profile, recipe.cost)
				return false, "Missing: " .. table.concat(missing, ", ")
			end
			weapon.temper = temperId
			PlayerData.markDirty(player)
			Registry.get("CombatService").refresh(player)
			Registry.get("QuestService").record(player, "Temper", { temper = temperId })
			celebrate(player, WeaponConfig.Tempers[temperId].displayName .. " applied")
			return true, WeaponConfig.Tempers[temperId].displayName .. " applied."
		end)
	end)

	Requests.on("Craft", "Request", function(player, args)
		local recipeId = args.recipe
		local recipe = type(recipeId) == "string" and RecipeConfig.Crafts[recipeId]
		if not recipe then
			return false, "Unknown recipe."
		end
		if not nearForge(player) then
			return false, "Crafting is done at the Artisan Bench or Forge."
		end
		return transaction(player, function()
			local profile = PlayerData.get(player)
			local result = recipe.result
			if result.kind == "Tool" and profile.tools.pickTier >= result.tier then
				return false, "You already own this tool."
			end
			if not Inventory.spend(player, recipe.cost) then
				local _, missing = Costs.canAfford(profile, recipe.cost)
				return false, "Missing: " .. table.concat(missing, ", ")
			end
			if result.kind == "Tool" then
				profile.tools.pickTier = result.tier
				PlayerData.markDirty(player)
			elseif result.kind == "Item" then
				Inventory.addItem(player, result.item, result.amount)
			end
			Registry.get("QuestService").record(player, "Craft", { recipe = recipeId })
			celebrate(player, recipe.displayName .. " crafted")
			return true, recipe.displayName .. " crafted."
		end)
	end)

	Requests.on("ChooseEvolution", "Request", function(player, args)
		local branch = args.branch
		local def = WeaponConfig.Weapons.Katana
		if type(branch) ~= "string" or not def.evolutions[branch] then
			return false, "Unknown evolution."
		end
		return transaction(player, function()
			local profile = PlayerData.get(player)
			local weapon = profile.weapons.Katana
			if weapon.mastery < def.evolutionMastery then
				return false, "Requires Katana mastery " .. def.evolutionMastery
			end
			if not profile.trials[def.evolutionTrial] then
				return false, "Complete the Katana Trial first (Training Arena)."
			end
			if weapon.evolution == branch then
				return false, "Already evolved into this branch."
			end
			if weapon.evolution ~= "None" then
				-- Respec: costs coins, never mastery.
				if not nearForge(player) then
					return false, "Changing branch is done at the Forge."
				end
				if not Inventory.spend(player, RecipeConfig.EvolutionRespec.cost) then
					return false, "Changing branch costs " .. Costs.describe(RecipeConfig.EvolutionRespec.cost)
				end
			end
			weapon.evolution = branch
			PlayerData.markDirty(player)
			Registry.get("CombatService").refresh(player)
			local evo = def.evolutions[branch]
			local Progression = Registry.get("ProgressionService")
			Progression.achieve(player, "Evolved")
			Progression.present(player, "Evolution_" .. branch, {
				title = evo.displayName,
				subtitle = "Weapon Evolution",
				body = table.concat(evo.details, "  "),
				color = evo.trailColor,
			})
			Net.event("Effect"):FireAllClients("Evolve", { character = player.Character, color = evo.trailColor })
			return true, "Your katana evolves into " .. evo.displayName .. "!"
		end)
	end)

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		busy[player] = nil
	end)
end

return CraftingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">DiscoveryService</string>
            <string name="Source"><![CDATA[--!strict
-- World secrets & mechanisms: the Sunfall Chamber brazier puzzle, its tablet and cache,
-- the Cinder Ravine drawbridge lever, lava hazards and the Hall of Echoes displays.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local WorldConfig = require(Config.WorldConfig)
local DiscoveryConfig = require(Config.DiscoveryConfig)
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)

local DiscoveryService = {}

local sequence: { string } = {}
local wallOpen = false
local bridgeDownUntil = 0

local function world(): Instance
	return workspace:WaitForChild("World")
end

local function find(name: string): Instance?
	return world():FindFirstChild(name, true)
end

local function promptOf(inst: Instance?): ProximityPrompt?
	return inst and inst:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function setBrazier(id: string, lit: boolean)
	local brazier = find("Brazier_" .. id)
	if not brazier then
		return
	end
	local flame = brazier:FindFirstChild("Flame", true) :: BasePart?
	if flame then
		flame.Transparency = if lit then 0 else 1
		local light = flame:FindFirstChildOfClass("PointLight")
		if light then
			light.Enabled = lit
		end
		local emitter = flame:FindFirstChildOfClass("ParticleEmitter")
		if emitter then
			emitter.Enabled = lit
		end
	end
end

local function playersInChamber(): boolean
	local region = WorldConfig.regionById("SunfallChamber")
	if not region then
		return false
	end
	for _, player in Players:GetPlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			local p = root.Position
			if p.X >= region.min.X and p.X <= region.max.X and p.Z >= region.min.Z and p.Z <= region.max.Z then
				return true
			end
		end
	end
	return false
end

local function moveWall(open: boolean)
	local wall = find("SunfallWall") :: BasePart?
	if not wall then
		return
	end
	local closed = wall:GetAttribute("ClosedCFrame") :: CFrame?
	if not closed then
		closed = wall.CFrame
		wall:SetAttribute("ClosedCFrame", closed)
	end
	local goal = if open then (closed :: CFrame) * CFrame.new(0, -19, 0) else closed :: CFrame
	TweenService:Create(wall, TweenInfo.new(2.5, Enum.EasingStyle.Quad), { CFrame = goal }):Play()
end

local function openWall(opener: Player)
	if wallOpen then
		return
	end
	wallOpen = true
	moveWall(true)
	Net.event("Effect"):FireAllClients("Shake", { position = WorldConfig.Points.SunfallWall, intensity = 0.6 })
	Net.event("Notify"):FireAllClients("Discovery", "Stone grinds in the Frontier cliffs... (" .. opener.DisplayName .. ")")
	local function scheduleClose()
		task.delay(WorldConfig.SunfallOpenTime, function()
			if playersInChamber() then
				scheduleClose()
				return
			end
			wallOpen = false
			moveWall(false)
			sequence = {}
			for _, b in WorldConfig.Braziers do
				setBrazier(b.id, false)
			end
		end)
	end
	scheduleClose()
end

local function kindle(player: Player, id: string)
	if wallOpen then
		Net.event("Notify"):FireClient(player, "Info", "The flames already burn. The way is open.")
		return
	end
	if table.find(sequence, id) then
		return
	end
	table.insert(sequence, id)
	setBrazier(id, true)
	local expected = WorldConfig.BrazierOrder[#sequence]
	if expected ~= id then
		sequence = {}
		task.delay(0.8, function()
			for _, b in WorldConfig.Braziers do
				setBrazier(b.id, false)
			end
		end)
		Net.event("Notify"):FireClient(player, "Info", "The flames gutter out. The order was wrong.")
		return
	end
	if #sequence == #WorldConfig.BrazierOrder then
		openWall(player)
	else
		Net.event("Notify"):FireClient(player, "Info", "The flame holds.")
	end
end

local function readTablet(player: Player)
	local profile = Registry.get("PlayerDataService").get(player)
	if not profile then
		return
	end
	local Progression = Registry.get("ProgressionService")
	local first = Progression.discover(player, "SunfallChamber")
	Progression.discover(player, "SunfallTablet")
	if not profile.blueprints.SunfallBlueprint then
		profile.blueprints.SunfallBlueprint = true
		Registry.get("PlayerDataService").markDirty(player)
	end
	Progression.achieve(player, "SecretKeeper")
	Progression.present(player, "SunfallTablet", {
		title = "The Sunfall Tablet",
		subtitle = "Secret Discovered",
		body = "You learned the theory of COLLAPSING SUN (Ember + Gravity) and the Resonant Temper blueprint. Research the fusion at the Fusion Chamber.",
		color = Color3.fromRGB(255, 200, 90),
	})
	if not first then
		Net.event("Notify"):FireClient(player, "Info", "You already know what the tablet teaches.")
	end
	Net.event("Effect"):FireClient(player, "Sound", { name = "ItemDiscovery" })
end

local function openCache(player: Player)
	local profile = Registry.get("PlayerDataService").get(player)
	if not profile then
		return
	end
	if profile.codex.discoveries.SunfallCache then
		Net.event("Notify"):FireClient(player, "Info", "The cache is empty for you.")
		return
	end
	profile.codex.discoveries.SunfallCache = os.time() -- claimed flag first (idempotent)
	Registry.get("PlayerDataService").markDirty(player)
	Registry.get("ExpeditionService").giveLoot(player, { EssenceShard = 3, Emberstone = 2 }, 50, WorldConfig.Points.SunfallChest, true)
end

local function pullLever(player: Player)
	local t = os.clock()
	Registry.get("ProgressionService").discover(player, "RavineShortcut")
	if t < bridgeDownUntil then
		Net.event("Notify"):FireClient(player, "Info", "The drawbridge is already down.")
		return
	end
	bridgeDownUntil = t + 600
	local bridge = find("Drawbridge") :: BasePart?
	if bridge then
		local down = bridge:GetAttribute("DownCFrame") :: CFrame?
		local up = bridge:GetAttribute("UpCFrame") :: CFrame?
		if down and up then
			bridge.CanCollide = true
			TweenService:Create(bridge, TweenInfo.new(2.5, Enum.EasingStyle.Quart), { CFrame = down, Transparency = 0 }):Play()
			task.delay(600, function()
				if os.clock() >= bridgeDownUntil - 1 then
					bridge.CanCollide = false
					TweenService:Create(bridge, TweenInfo.new(2), { CFrame = up, Transparency = 1 }):Play()
				end
			end)
		end
	end
	Net.event("Notify"):FireAllClients("Discovery", player.DisplayName .. " lowered the Cinder Ravine drawbridge (10 min).")
end

local lavaDebounce: { [Player]: number } = {}

local function connectLava()
	for _, part in world():GetDescendants() do
		if part:IsA("BasePart") and part:GetAttribute("Lava") then
			part.Touched:Connect(function(hit)
				local character = hit.Parent
				local player = character and Players:GetPlayerFromCharacter(character)
				if not player then
					return
				end
				local t = os.clock()
				if (lavaDebounce[player] or 0) > t then
					return
				end
				lavaDebounce[player] = t + 1.5
				local humanoid = (character :: Model):FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 then
					humanoid:TakeDamage(humanoid.MaxHealth * 0.3)
					if humanoid.Health > 0 then
						Registry.get("ExpeditionService").teleport(player, WorldConfig.Points.RavineCheckpoint)
						Net.event("Notify"):FireClient(player, "Info", "Scorched! You scramble back to the ravine edge.")
					end
				end
			end)
		end
	end
end

local function updateEchoes()
	local PlayerData = Registry.get("PlayerDataService")
	local entries = {}
	for _, player in Players:GetPlayers() do
		local profile = PlayerData.get(player)
		if profile then
			local achievements = 0
			for _ in profile.achievements do
				achievements += 1
			end
			table.insert(entries, {
				name = player.DisplayName,
				level = profile.level,
				mastery = profile.weapons.Katana.mastery,
				clears = profile.bosses.FractureWarden.clears,
				achievements = achievements,
			})
		end
	end
	table.sort(entries, function(a, b)
		if a.mastery ~= b.mastery then
			return a.mastery > b.mastery
		end
		return a.level > b.level
	end)
	local lines = { "HALL OF ECHOES", "" }
	for i = 1, math.min(6, #entries) do
		local e = entries[i]
		table.insert(lines, string.format("%d. %s  Lv %d  Katana M%d  Warden x%d  ★%d", i, e.name, e.level, e.mastery, e.clears, e.achievements))
	end
	if #entries == 0 then
		table.insert(lines, "No echoes yet.")
	end
	for _, board in world():GetDescendants() do
		if board.Name == "EchoBoard" then
			local label = board:FindFirstChild("Text", true)
			if label and label:IsA("TextLabel") then
				label.Text = table.concat(lines, "\n")
			end
		end
	end
end

function DiscoveryService.Init() end

function DiscoveryService.Start()
	for _, b in WorldConfig.Braziers do
		local prompt = promptOf(find("Brazier_" .. b.id))
		setBrazier(b.id, false)
		if prompt then
			prompt.Triggered:Connect(function(player)
				if Registry.get("SecurityService").allow(player, "Interact") and Registry.get("SecurityService").within(player, b.position, 16) then
					kindle(player, b.id)
				end
			end)
		end
	end
	local tablet = promptOf(find("SunfallTablet"))
	if tablet then
		tablet.Triggered:Connect(function(player)
			if Registry.get("SecurityService").within(player, WorldConfig.Points.SunfallTablet, 16) then
				readTablet(player)
			end
		end)
	end
	local cache = promptOf(find("SunfallChest"))
	if cache then
		cache.Triggered:Connect(function(player)
			if Registry.get("SecurityService").allow(player, "Interact") and Registry.get("SecurityService").within(player, WorldConfig.Points.SunfallChest, 16) then
				openCache(player)
			end
		end)
	end
	local mural = promptOf(find("SunfallMural"))
	if mural then
		mural.Triggered:Connect(function(player)
			Net.event("Notify"):FireClient(player, "Lore", DiscoveryConfig.Discoveries.SunfallChamber.hint .. " First the Moon that rises, then the Sun at its height, last the Star that never sets.")
		end)
	end
	local lever = promptOf(find("ShortcutLever"))
	if lever then
		lever.Triggered:Connect(function(player)
			if Registry.get("SecurityService").within(player, WorldConfig.Points.ShortcutLever, 16) then
				pullLever(player)
			end
		end)
	end
	connectLava()
	Players.PlayerRemoving:Connect(function(player)
		lavaDebounce[player] = nil
	end)
	task.spawn(function()
		while true do
			pcall(updateEchoes)
			task.wait(30)
		end
	end)
end

return DiscoveryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
-- Robux monetization. Purely cosmetic / convenience. All ids live in MonetizationConfig and
-- are UNSET (0) until configured. Fulfilment is server-side and idempotent:
--  * Developer Products: ProcessReceipt records PurchaseId in the profile and only returns
--    PurchaseGranted after a successful save.
--  * Game Passes: ownership is checked with UserOwnsGamePassAsync (never trusted from client).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local MonetizationConfig = require(Shared.Config.MonetizationConfig)
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)

local EconomyService = {}

local function productById(id: number): any?
	for _, product in MonetizationConfig.Products do
		if MonetizationConfig.isConfigured(product) and product.id == id then
			return product
		end
	end
	return nil
end

local function passById(id: number): any?
	for _, pass in MonetizationConfig.GamePasses do
		if MonetizationConfig.isConfigured(pass) and pass.id == id then
			return pass
		end
	end
	return nil
end

local function grantProduct(player: Player, profile: any, product: any)
	local grant = product.grant
	if grant.cosmetic then
		profile.cosmetics.owned[grant.cosmetic] = true
	end
	Registry.get("PlayerDataService").markDirty(player)
	Net.event("Notify"):FireClient(player, "Unlock", "Thank you! " .. product.displayName .. " unlocked.")
end

local function processReceipt(receipt: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local PlayerData = Registry.get("PlayerDataService")
	local profile = PlayerData.get(player)
	-- Only grant into a profile that can actually be saved; otherwise Roblox retries later.
	if not profile or PlayerData.state(player) ~= "Loaded" then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local product = productById(receipt.ProductId)
	if not product then
		warn("[Economy] receipt for unknown product " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if not table.find(profile.receipts, purchaseId) then
		grantProduct(player, profile, product)
		table.insert(profile.receipts, purchaseId)
	end
	-- Persist before acknowledging. If the save fails, Roblox calls again and the recorded
	-- PurchaseId prevents a second grant.
	if PlayerData.save(player) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

local function refreshPasses(player: Player)
	local profile = Registry.get("PlayerDataService").get(player)
	if not profile then
		return
	end
	for key, pass in MonetizationConfig.GamePasses do
		if MonetizationConfig.isConfigured(pass) then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.id)
			if ok then
				profile.passes[key] = owns == true
			end
		else
			profile.passes[key] = nil
		end
	end
	Registry.get("PlayerDataService").markDirty(player)
end

function EconomyService.ownsPass(player: Player, key: string): boolean
	local profile = Registry.get("PlayerDataService").get(player)
	return profile ~= nil and profile.passes[key] == true
end

function EconomyService.Init() end

function EconomyService.Start()
	MarketplaceService.ProcessReceipt = processReceipt
	Registry.get("PlayerDataService").Loaded:Connect(function(player)
		task.spawn(refreshPasses, player)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passById(passId) then
			refreshPasses(player)
			Net.event("Notify"):FireClient(player, "Unlock", "Thank you! Game pass active.")
		end
	end)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">EnemyService</string>
            <string name="Source"><![CDATA[--!strict
-- Reusable enemy framework: spawning, a data-driven state machine (Idle -> Chase -> Windup ->
-- Recover/Retreat -> ... / Return when leashed), statuses, guard/stagger rules, damage intake,
-- defeat rewards and respawns. Archetype differences come from EnemyConfig + behaviour hooks.
-- The Fracture Warden registers here as an "external" record so player attacks treat it uniformly.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local EnemyConfig = require(Shared.Config.EnemyConfig)
local WorldConfig = require(Shared.Config.WorldConfig)
local GameConfig = require(Shared.Config.GameConfig)
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)
local Telegraph = require(script.Parent.Parent.Combat.Telegraph)
local Hitbox = require(script.Parent.Parent.Combat.Hitbox)
local Models = require(script.Parent.Parent.World.Models)

local EnemyService = {}

export type Record = {
	id: number,
	archetype: string,
	def: any,
	model: Model,
	root: BasePart,
	humanoid: Humanoid?,
	health: number,
	maxHealth: number,
	radius: number,
	spawnPos: Vector3,
	spawner: any?,
	alive: boolean,
	external: boolean,
	state: string,
	stateUntil: number,
	target: Player?,
	cooldowns: { [string]: number },
	pending: any?,
	guardOpenUntil: number,
	stunUntil: number,
	controlledUntil: number,
	lastHitAt: number,
	damageBy: { [number]: number },
	mechanicsBy: { [number]: number },
	tags: { [number]: { essence: string, time: number, cast: number } },
	status: { [string]: any },
	surged: boolean,
	ownerUserId: number?,
	onDamage: ((Record, number, any) -> number)?,
	onDeath: ((Record) -> ())?,
	unyielding: boolean,
	kind: string,
}

local records: { [number]: Record } = {}
local byModel: { [Model]: Record } = {}
local nextId = 0
local folder: Folder
local surgeActive = false
local attackCounter = 0

function EnemyService.Init()
	folder = Instance.new("Folder")
	folder.Name = "Enemies"
	folder.Parent = workspace
end

function EnemyService.folder(): Folder
	return folder
end

local function now(): number
	return os.clock()
end

local function updateBar(record: Record)
	local bar = record.model:FindFirstChild("HealthBar")
	local fill = bar and bar:FindFirstChild("Back") and (bar :: any).Back:FindFirstChild("Fill")
	if fill then
		fill.Size = UDim2.fromScale(math.clamp(record.health / record.maxHealth, 0, 1), 1)
	end
	record.model:SetAttribute("Health", record.health)
	record.model:SetAttribute("MaxHealth", record.maxHealth)
end

local function planar(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

function EnemyService.spawn(archetype: string, position: Vector3, opts: any?): Record?
	local def = EnemyConfig.Enemies[archetype]
	if not def then
		warn("[Enemy] unknown archetype " .. archetype)
		return nil
	end
	local o = opts or {}
	local model = Models.enemy(def, position)
	nextId += 1
	local maxHealth = def.maxHealth
	local surged = surgeActive and def.kind == "Standard" and position.X > 500
	if surged then
		maxHealth *= EnemyConfig.Surge.healthMult
	end
	local root = model.PrimaryPart :: BasePart
	local record: Record = {
		id = nextId,
		archetype = archetype,
		def = def,
		model = model,
		root = root,
		humanoid = model:FindFirstChildOfClass("Humanoid"),
		health = maxHealth,
		maxHealth = maxHealth,
		radius = 1.5 * def.look.scale,
		spawnPos = position,
		spawner = o.spawner,
		alive = true,
		external = false,
		state = "Idle",
		stateUntil = 0,
		target = nil,
		cooldowns = {},
		pending = nil,
		guardOpenUntil = 0,
		stunUntil = 0,
		controlledUntil = 0,
		lastHitAt = 0,
		damageBy = {},
		mechanicsBy = {},
		tags = {},
		status = {},
		surged = surged,
		ownerUserId = o.ownerUserId,
		onDamage = nil,
		onDeath = o.onDeath,
		unyielding = def.unyielding == true,
		kind = def.kind,
	}
	model:SetAttribute("EnemyId", record.id)
	model:SetAttribute("Archetype", archetype)
	model:SetAttribute("Kind", def.kind)
	if surged then
		model:SetAttribute("Surged", true)
	end
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil) -- server-owned physics: clients cannot move enemies
	end)
	records[record.id] = record
	byModel[model] = record
	updateBar(record)
	return record
end

function EnemyService.registerExternal(record: Record)
	nextId += 1
	record.id = nextId
	record.external = true
	records[record.id] = record
	byModel[record.model] = record
	record.model:SetAttribute("EnemyId", record.id)
end

function EnemyService.unregister(record: Record)
	records[record.id] = nil
	byModel[record.model] = nil
end

function EnemyService.fromModel(model: Instance?): Record?
	while model and model ~= workspace do
		if model:IsA("Model") and byModel[model :: Model] then
			return byModel[model :: Model]
		end
		model = model.Parent
	end
	return nil
end

function EnemyService.all(): { Record }
	local list = {}
	for _, record in records do
		if record.alive then
			table.insert(list, record)
		end
	end
	return list
end

-- Returns alive records whose root satisfies the predicate (position, radius) -> boolean.
function EnemyService.query(predicate: (Vector3, number) -> boolean, max: number?): { Record }
	local list = {}
	for _, record in records do
		if record.alive and record.root.Parent and predicate(record.root.Position, record.radius) then
			table.insert(list, record)
			if max and #list >= max then
				break
			end
		end
	end
	return list
end

local function cancelPending(record: Record)
	if record.pending then
		if record.pending.telegraph then
			record.pending.telegraph:destroy()
		end
		record.pending = nil
	end
	if record.state == "Windup" then
		record.state = "Recover"
		record.stateUntil = now() + 0.3
	end
end

-- Stagger. Returns true if it interrupted a windup.
function EnemyService.stagger(record: Record, seconds: number, force: boolean?): boolean
	if not record.alive or seconds <= 0 then
		return false
	end
	if record.unyielding and not force then
		return false
	end
	local interrupted = record.state == "Windup"
	cancelPending(record)
	record.stunUntil = math.max(record.stunUntil, now() + seconds)
	record.model:SetAttribute("StaggeredUntil", workspace:GetServerTimeNow() + seconds)
	if record.humanoid then
		record.humanoid:MoveTo(record.root.Position)
	end
	return interrupted
end

function EnemyService.openGuard(record: Record, seconds: number)
	record.guardOpenUntil = math.max(record.guardOpenUntil, now() + seconds)
	record.model:SetAttribute("GuardOpenUntil", workspace:GetServerTimeNow() + seconds)
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

-- Moves an enemy toward a point over `duration` (pulls, knockbacks). Server-owned, wall-aware.
function EnemyService.displace(record: Record, target: Vector3, duration: number)
	if not record.alive or record.unyielding or record.external or record.def.moveSpeed == 0 then
		return
	end
	record.controlledUntil = now() + duration
	cancelPending(record)
	local start = record.root.Position
	local goal = Vector3.new(target.X, start.Y, target.Z)
	local world = workspace:FindFirstChild("World")
	if world then
		rayParams.FilterDescendantsInstances = { world, workspace.Terrain }
		local delta = goal - start
		if delta.Magnitude > 0.1 then
			local hit = workspace:Raycast(start, delta, rayParams)
			if hit then
				goal = hit.Position - delta.Unit * (record.radius + 1)
				goal = Vector3.new(goal.X, start.Y, goal.Z)
			end
		end
	end
	task.spawn(function()
		local steps = math.max(3, math.floor(duration / 0.05))
		for i = 1, steps do
			if not record.alive or not record.root.Parent then
				return
			end
			local current = record.root.CFrame
			local p = start:Lerp(goal, i / steps)
			record.root.CFrame = CFrame.new(Vector3.new(p.X, current.Position.Y, p.Z)) * current.Rotation
			task.wait(duration / steps)
		end
	end)
end

function EnemyService.applyStatus(record: Record, name: string, data: any)
	if not record.alive then
		return
	end
	data.time = now()
	record.status[name] = data
	record.model:SetAttribute(name, true)
end

function EnemyService.hasStatus(record: Record, name: string): any?
	local status = record.status[name]
	if status and status.expires > now() then
		return status
	end
	return nil
end

local function isBehind(record: Record, position: Vector3, arcDegrees: number): boolean
	local look = record.root.CFrame.LookVector
	local toAttacker = Vector3.new(position.X - record.root.Position.X, 0, position.Z - record.root.Position.Z)
	if toAttacker.Magnitude < 0.1 then
		return false
	end
	local dot = Vector3.new(look.X, 0, look.Z).Unit:Dot(toAttacker.Unit)
	return dot < math.cos(math.rad(arcDegrees / 2))
end
EnemyService.isOutsideFrontArc = isBehind

-- Damage intake. info = { player?, position?, guardBreak?, stagger?, kind, forceStagger?, mechanic? }
-- Returns { dealt, killed, guarded, interrupted }
function EnemyService.damage(record: Record, amount: number, info: any): any
	local result = { dealt = 0, killed = false, guarded = false, interrupted = false }
	if not record.alive or amount <= 0 or amount ~= amount then
		return result
	end
	local player: Player? = info.player
	if record.ownerUserId and (not player or player.UserId ~= record.ownerUserId) then
		return result -- trial champions only take damage from their challenger
	end
	local t = now()
	local def = record.def

	if def.guard and t >= record.guardOpenUntil and info.position and record.stunUntil < t then
		if not isBehind(record, info.position, def.guard.arc) then
			if info.guardBreak then
				EnemyService.openGuard(record, 1.4)
				result.interrupted = EnemyService.stagger(record, 0.8, true)
				Net.event("Effect"):FireAllClients("GuardBreak", { position = record.root.Position })
			elseif info.kind == "Weapon" then
				amount *= 1 - def.guard.frontalReduction
				result.guarded = true
			end
		end
	end

	if record.onDamage then
		amount = record.onDamage(record, amount, info)
		if amount <= 0 then
			return result
		end
	end

	-- Static Charge / Event Pressure mastery bonuses are applied by CombatService before this call.
	amount = math.min(amount, record.health)
	record.health -= amount
	record.lastHitAt = t
	result.dealt = amount
	if player then
		record.damageBy[player.UserId] = (record.damageBy[player.UserId] or 0) + amount
	end
	updateBar(record)

	if info.stagger and info.stagger > 0 and record.health > 0 then
		if EnemyService.stagger(record, info.stagger, info.forceStagger) then
			result.interrupted = true
		end
	end

	if record.health <= 0 then
		if def.regen then
			record.health = record.maxHealth -- training targets never die
			updateBar(record)
		else
			result.killed = true
			EnemyService.kill(record, player)
		end
	end
	return result
end

local function contributors(record: Record): { Player }
	local list = {}
	for userId, dealt in record.damageBy do
		local player = Players:GetPlayerByUserId(userId)
		if player and dealt > 0 then
			table.insert(list, player)
		end
	end
	for userId in record.mechanicsBy do
		local player = Players:GetPlayerByUserId(userId)
		if player and not table.find(list, player) then
			table.insert(list, player)
		end
	end
	return list
end
EnemyService.contributors = contributors

function EnemyService.kill(record: Record, killer: Player?)
	if not record.alive then
		return
	end
	record.alive = false
	record.state = "Dead"
	cancelPending(record)
	local def = record.def
	local position = record.root.Position

	if not record.external then
		local Progression = Registry.get("ProgressionService")
		local Quest = Registry.get("QuestService")
		local Expedition = Registry.get("ExpeditionService")
		local Party = Registry.get("PartyService")
		local credited: { [Player]: boolean } = {}
		for _, player in contributors(record) do
			credited[player] = true
			Progression.addXp(player, math.floor(def.xp * (if record.surged then 1.2 else 1)))
			Progression.recordEnemy(player, record.archetype, true)
			Progression.stat(player, "kills")
			Quest.record(player, "Kill", { archetype = record.archetype, kind = def.kind })
			-- Individual loot per contributor: no loot stealing between players.
			local items = {}
			for _, drop in def.drops do
				if math.random() <= drop.chance then
					items[drop.item] = (items[drop.item] or 0) + math.random(drop.min, drop.max)
				end
			end
			if record.surged then
				local extra = EnemyConfig.Surge.extraDrop
				if math.random() <= extra.chance then
					items[extra.item] = (items[extra.item] or 0) + math.random(extra.min, extra.max)
				end
			end
			local coins = if def.coins[2] > 0 then math.random(def.coins[1], def.coins[2]) else 0
			Expedition.giveLoot(player, items, coins, position)
			if def.kind == "Champion" then
				Progression.present(player, "Champion_" .. record.archetype, {
					title = def.displayName .. " Defeated",
					subtitle = "Champion",
					body = def.lore,
					color = def.look.accent,
				})
			end
		end
		-- Party members nearby share kill credit for contracts (not loot or XP).
		for player in table.clone(credited) do
			for _, member in Party.membersNear(player, position, GameConfig.Party.SharedCreditRadius) do
				if not credited[member] then
					credited[member] = true
					Quest.record(member, "Kill", { archetype = record.archetype, kind = def.kind })
				end
			end
		end
		-- Burn spread (Ember mastery 3) is handled by CombatService via this hook.
		Registry.get("CombatService").onEnemyKilled(record, killer)
	end

	if record.onDeath then
		task.spawn(record.onDeath, record)
	end

	Net.event("Effect"):FireAllClients("EnemyDeath", { model = record.model, position = position })
	local model = record.model
	task.delay(1.0, function()
		byModel[model] = nil
		records[record.id] = nil
		if model.Parent then
			model:Destroy()
		end
	end)

	local spawner = record.spawner
	if spawner and spawner.respawn and spawner.respawn > 0 then
		task.delay(spawner.respawn, function()
			EnemyService.spawn(spawner.archetype, spawner.position, { spawner = spawner })
		end)
	end
end

function EnemyService.despawn(record: Record)
	record.alive = false
	cancelPending(record)
	byModel[record.model] = nil
	records[record.id] = nil
	if record.model.Parent then
		record.model:Destroy()
	end
end

function EnemyService.setSurge(active: boolean)
	surgeActive = active
	if active then
		for _, record in records do
			if record.alive and not record.external and record.kind == "Standard" and record.spawnPos.X > 500 and not record.surged then
				record.surged = true
				record.maxHealth *= EnemyConfig.Surge.healthMult
				record.health *= EnemyConfig.Surge.healthMult
				record.model:SetAttribute("Surged", true)
				updateBar(record)
			end
		end
	end
end

-- AI ---------------------------------------------------------------------------------------

local function validTarget(record: Record, player: Player?): boolean
	if not player or not player.Parent then
		return false
	end
	if record.ownerUserId and player.UserId ~= record.ownerUserId then
		return false
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root or humanoid.Health <= 0 then
		return false
	end
	if math.abs(root.Position.Y - record.root.Position.Y) > 30 then
		return false
	end
	if record.kind ~= "Training" and not record.ownerUserId then
		local region = WorldConfig.regionAt(root.Position)
		if not region or region.safe then
			return false
		end
	end
	return planar(root.Position, record.root.Position) <= math.max(record.def.aggroRange * 1.6, 20)
end

local function acquire(record: Record): Player?
	local best, bestDistance = nil, record.def.aggroRange
	for _, player in Players:GetPlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			local d = planar(root.Position, record.root.Position)
			if d <= bestDistance and validTarget(record, player) then
				best, bestDistance = player, d
			end
		end
	end
	return best
end

local function face(record: Record, position: Vector3)
	local p = record.root.Position
	local flat = Vector3.new(position.X, p.Y, position.Z)
	if (flat - p).Magnitude > 0.1 then
		record.root.CFrame = CFrame.lookAt(p, flat)
	end
end

local function shapeFor(record: Record, attack: any, targetPos: Vector3?): any
	local p = record.root.Position
	local ground = Vector3.new(p.X, Telegraph.groundY(p), p.Z)
	local look = record.root.CFrame.LookVector
	local dir = Vector3.new(look.X, 0, look.Z).Unit
	if attack.shape == "Line" then
		return { kind = "Line", origin = ground, dir = dir, length = attack.length, width = attack.width }
	elseif attack.shape == "Circle" then
		return { kind = "Circle", center = ground, radius = attack.radius }
	elseif attack.shape == "CircleAtTarget" then
		local c = targetPos or ground
		return { kind = "Circle", center = Vector3.new(c.X, ground.Y, c.Z), radius = attack.radius }
	elseif attack.shape == "Ring" then
		return { kind = "Ring", center = ground, inner = attack.inner, radius = attack.radius }
	end
	return nil
end
EnemyService.shapeFor = shapeFor

function EnemyService.telegraph(shape: any, duration: number, opts: any?): any
	if shape.kind == "Line" then
		return Telegraph.line(shape.origin, shape.dir, shape.length, shape.width, duration, opts)
	elseif shape.kind == "Circle" then
		return Telegraph.circle(shape.center, shape.radius, duration, opts)
	elseif shape.kind == "Ring" then
		return Telegraph.ring(shape.center, shape.inner, shape.radius, duration, opts)
	end
	return nil
end

function EnemyService.shapeContains(shape: any, position: Vector3, padding: number?): boolean
	if shape.kind == "Line" then
		return Hitbox.inLine(position, shape.origin, shape.dir, shape.length, shape.width, padding)
	elseif shape.kind == "Circle" then
		return Hitbox.inCircle(position, shape.center, shape.radius, padding)
	elseif shape.kind == "Ring" then
		return Hitbox.inRing(position, shape.center, shape.inner, shape.radius, padding)
	end
	return false
end

function EnemyService.newAttackKey(): string
	attackCounter += 1
	return "atk" .. attackCounter
end

local function startWindup(record: Record, attack: any, targetRoot: BasePart, repeatIndex: number)
	face(record, targetRoot.Position)
	if record.humanoid then
		record.humanoid:MoveTo(record.root.Position)
	end
	local shape = shapeFor(record, attack, targetRoot.Position)
	if not shape then
		return
	end
	local t = now()
	record.state = "Windup"
	record.stateUntil = t + attack.windup
	record.pending = {
		attack = attack,
		shape = shape,
		key = EnemyService.newAttackKey(),
		repeatIndex = repeatIndex,
		telegraph = EnemyService.telegraph(shape, attack.windup, { glyph = if attack.parryable then "!" else "⚠" }),
	}
	record.model:SetAttribute("Attacking", attack.name)
end

local function resolve(record: Record)
	local pending = record.pending
	record.pending = nil
	record.model:SetAttribute("Attacking", nil)
	if not pending or not record.alive then
		return
	end
	if pending.telegraph then
		pending.telegraph:destroy()
	end
	local attack = pending.attack
	local shape = pending.shape
	local t = now()
	if attack.dash and shape.kind == "Line" then
		local goal = shape.origin + shape.dir * (shape.length - 2)
		local saved = record.unyielding
		record.unyielding = false
		EnemyService.displace(record, goal, 0.25)
		record.unyielding = saved
	end
	local damage = attack.damage * (if record.surged then EnemyConfig.Surge.damageMult else 1)
	Net.event("Effect"):FireAllClients("EnemyStrike", {
		shape = shape.kind,
		position = shape.center or shape.origin,
		dir = shape.dir,
		length = shape.length,
		radius = shape.radius,
		color = record.def.look.accent,
	})
	Registry.get("CombatService").enemyStrike(record, attack, shape, pending.key, damage)
	if not record.alive then
		return
	end
	record.cooldowns[attack.id] = t + attack.cooldown
	if attack.repeats and pending.repeatIndex < attack.repeats and record.target then
		local root = record.target.Character and record.target.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			startWindup(record, attack, root, pending.repeatIndex + 1)
			return
		end
	end
	if attack.opensGuard and record.def.punishWindow then
		EnemyService.openGuard(record, record.def.punishWindow)
		record.state = "Recover"
		record.stateUntil = t + record.def.punishWindow
	elseif record.def.behaviour == "Stalker" then
		record.state = "Retreat"
		record.stateUntil = t + (record.def.retreatTime or 1)
	else
		record.state = "Recover"
		record.stateUntil = t + 0.6
	end
end

-- Called by CombatService when a player perfect-parries this enemy's attack.
function EnemyService.onParried(record: Record, player: Player)
	if not record.alive then
		return
	end
	record.mechanicsBy[player.UserId] = (record.mechanicsBy[player.UserId] or 0) + 1
	EnemyService.stagger(record, if record.unyielding then 1.0 else 1.6, true)
	EnemyService.openGuard(record, 1.6)
end

local function tick(record: Record, t: number)
	local def = record.def
	local humanoid = record.humanoid
	if not humanoid then
		return
	end
	if def.regen and t - record.lastHitAt > 4 and record.health < record.maxHealth then
		record.health = record.maxHealth
		updateBar(record)
	end
	if t < record.controlledUntil or t < record.stunUntil then
		return
	end
	if record.state == "Windup" then
		if t >= record.stateUntil then
			resolve(record)
		end
		return
	end
	if record.state == "Recover" or record.state == "Retreat" then
		if t < record.stateUntil then
			if record.state == "Retreat" and record.target then
				local tr = record.target.Character and record.target.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if tr then
					local away = record.root.Position - tr.Position
					away = Vector3.new(away.X, 0, away.Z)
					if away.Magnitude > 0.1 then
						humanoid.WalkSpeed = def.moveSpeed
						humanoid:MoveTo(record.root.Position + away.Unit * 10)
					end
				end
			end
			return
		end
		record.state = "Chase"
	end
	if record.state == "Return" then
		humanoid.WalkSpeed = def.moveSpeed * 1.4
		humanoid:MoveTo(record.spawnPos)
		if planar(record.root.Position, record.spawnPos) < 5 then
			record.state = "Idle"
			record.health = record.maxHealth
			record.damageBy = {}
			record.mechanicsBy = {}
			updateBar(record)
		end
		return
	end

	if not validTarget(record, record.target) then
		record.target = acquire(record)
	end
	local target = record.target
	if not target then
		record.state = "Idle"
		if def.moveSpeed > 0 and planar(record.root.Position, record.spawnPos) > 4 then
			humanoid.WalkSpeed = def.moveSpeed * 0.6
			humanoid:MoveTo(record.spawnPos)
		end
		return
	end
	if def.leashRange > 0 and planar(record.root.Position, record.spawnPos) > def.leashRange then
		record.state = "Return"
		record.target = nil
		return
	end
	local targetRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not targetRoot then
		return
	end
	local distance = planar(targetRoot.Position, record.root.Position)
	for _, attack in def.attacks do
		if t >= (record.cooldowns[attack.id] or 0) and distance <= attack.triggerRange and distance >= (attack.minRange or 0) then
			startWindup(record, attack, targetRoot, 1)
			return
		end
	end
	record.state = "Chase"
	if def.moveSpeed > 0 then
		local slow = EnemyService.hasStatus(record, "Slowed")
		humanoid.WalkSpeed = def.moveSpeed * (if slow then slow.mult else 1)
		local goal = targetRoot.Position
		local toward = Vector3.new(goal.X - record.root.Position.X, 0, goal.Z - record.root.Position.Z)
		if toward.Magnitude > 3 then
			humanoid:MoveTo(goal - toward.Unit * 2.5)
		else
			humanoid:MoveTo(record.root.Position)
			face(record, goal)
		end
	elseif distance < 40 then
		face(record, targetRoot.Position)
	end
end

local function anyPlayerNear(position: Vector3, range: number): boolean
	for _, player in Players:GetPlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and (root.Position - position).Magnitude <= range then
			return true
		end
	end
	return false
end

local function statusTick()
	local t = now()
	local Combat = Registry.get("CombatService")
	for _, record in records do
		if record.alive then
			for name, status in record.status do
				if status.expires <= t then
					record.status[name] = nil
					record.model:SetAttribute(name, nil)
				elseif name == "Burning" then
					local source = status.by and Players:GetPlayerByUserId(status.by)
					Combat.statusDamage(record, status.dps * 0.5, source, "Burn")
				end
			end
		end
	end
end

function EnemyService.Start()
	for _, spawner in WorldConfig.Spawners do
		EnemyService.spawn(spawner.archetype, spawner.position, { spawner = spawner })
	end
	local accumulator, statusAccumulator = 0, 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		statusAccumulator += dt
		if accumulator >= 0.1 then
			accumulator = 0
			local t = now()
			for _, record in records do
				if record.alive and not record.external and record.root.Parent then
					if record.state == "Windup" or anyPlayerNear(record.root.Position, 180) then
						local ok, err = pcall(tick, record, t)
						if not ok then
							warn("[Enemy] tick error: " .. tostring(err))
						end
					end
				end
			end
		end
		if statusAccumulator >= 0.5 then
			statusAccumulator = 0
			statusTick()
		end
	end)
end

return EnemyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">ExpeditionService</string>
            <string name="Source"><![CDATA[--!strict
-- Expedition risk & extraction: region tracking, the unbanked Satchel, depth-based drop
-- multipliers, death penalties, idempotent banking at beacons, and teleports.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local WorldConfig = require(Config.WorldConfig)
local ExpeditionConfig = require(Config.ExpeditionConfig)
local ItemConfig = require(Config.ItemConfig)
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)

local ExpeditionService = {}

type Satchel = { coins: number, items: { [string]: number } }
type PlayerState = { region: string?, depth: number, expedition: boolean, satchel: Satchel, banking: boolean }

local states: { [Player]: PlayerState } = {}

local function stateOf(player: Player): PlayerState
	local s = states[player]
	if not s then
		s = { region = nil, depth = 0, expedition = false, satchel = { coins = 0, items = {} }, banking = false }
		states[player] = s
	end
	return s
end

local function sync(player: Player)
	local s = stateOf(player)
	Net.event("ExpeditionSync"):FireClient(player, {
		region = s.region,
		depth = s.depth,
		expedition = s.expedition,
		satchel = s.satchel,
		loss = ExpeditionConfig.Depths[s.depth] and ExpeditionConfig.Depths[s.depth].lossOnDeath or 0,
	})
end

local function satchelEmpty(s: PlayerState): boolean
	if s.satchel.coins > 0 then
		return false
	end
	for _, n in s.satchel.items do
		if n > 0 then
			return false
		end
	end
	return true
end

function ExpeditionService.regionOf(player: Player): string?
	return stateOf(player).region
end

function ExpeditionService.depthOf(player: Player): number
	return stateOf(player).depth
end

-- Loot from enemies/nodes/bosses. Inside Emberfall it goes to the Satchel (with the depth
-- multiplier), elsewhere straight to the bank. `noMultiplier` for fixed rewards (boss).
function ExpeditionService.giveLoot(player: Player, items: { [string]: number }, coins: number, position: Vector3?, noMultiplier: boolean?)
	local s = stateOf(player)
	local depthInfo = ExpeditionConfig.Depths[s.depth] or ExpeditionConfig.Depths[0]
	local mult = if noMultiplier then 1 else depthInfo.dropMultiplier
	local function scale(n: number): number
		local scaled = n * mult
		local whole = math.floor(scaled)
		if math.random() < scaled - whole then
			whole += 1
		end
		return whole
	end
	local granted = {}
	if s.expedition then
		s.satchel.coins += scale(coins)
		for item, n in items do
			if ItemConfig.isValid(item) and n > 0 then
				local amount = scale(n)
				s.satchel.items[item] = (s.satchel.items[item] or 0) + amount
				granted[item] = amount
			end
		end
		sync(player)
	else
		local Inventory = Registry.get("InventoryService")
		if coins > 0 then
			Inventory.addCoins(player, coins)
		end
		for item, n in items do
			if n > 0 then
				Inventory.addItem(player, item, n)
				granted[item] = n
			end
		end
	end
	if next(granted) or coins > 0 then
		Net.event("Notify"):FireClient(player, "Loot", "", {
			items = granted,
			coins = coins,
			satchel = s.expedition,
			position = position,
		})
	end
end

-- Moves the Satchel into the permanent inventory. Idempotent: the Satchel is swapped out
-- before anything is granted, so duplicate requests find it empty.
function ExpeditionService.bank(player: Player, beaconId: string): (boolean, string?)
	local s = stateOf(player)
	if s.banking then
		return false, "Already banking."
	end
	if satchelEmpty(s) then
		return false, "Your Satchel is empty."
	end
	s.banking = true
	local satchel = s.satchel
	s.satchel = { coins = 0, items = {} }
	local Inventory = Registry.get("InventoryService")
	Inventory.grant(player, { coins = satchel.coins, items = satchel.items })
	s.banking = false
	local Progression = Registry.get("ProgressionService")
	Progression.stat(player, "extractions")
	if beaconId == "Keep" or beaconId == "Arena" then
		Progression.achieve(player, "DeepDelver")
	end
	Registry.get("QuestService").record(player, "Extract", { beacon = beaconId })
	Registry.get("PartyService").onExtract(player)
	Net.event("Notify"):FireClient(player, "Extract", "Loot secured!", { items = satchel.items, coins = satchel.coins })
	Net.event("Effect"):FireAllClients("Extract", { character = player.Character })
	Progression.present(player, "FirstExtraction", {
		title = "Loot Secured",
		subtitle = "Extraction",
		body = "Banked loot is permanent. Spend it at the Forge and Artisan Bench in the Nexus.",
		color = Color3.fromRGB(120, 255, 190),
	})
	sync(player)
	return true, nil
end

-- Applies the death penalty for the player's current depth. Returns what was lost.
function ExpeditionService.applyLoss(player: Player): (number, { [string]: number })
	local s = stateOf(player)
	local info = ExpeditionConfig.Depths[s.depth]
	local loss = info and info.lossOnDeath or 0
	local lostItems = {}
	local lostCoins = 0
	if loss > 0 and not satchelEmpty(s) then
		lostCoins = math.floor(s.satchel.coins * loss)
		s.satchel.coins -= lostCoins
		for item, n in s.satchel.items do
			local lost = math.floor(n * loss + 0.5)
			if lost > 0 then
				lostItems[item] = lost
				s.satchel.items[item] = n - lost
			end
		end
		Registry.get("ProgressionService").stat(player, "lootLost")
	end
	return lostCoins, lostItems
end

function ExpeditionService.onDeath(player: Player)
	local s = stateOf(player)
	if not s.expedition then
		return
	end
	local lostCoins, lostItems = ExpeditionService.applyLoss(player)
	Net.event("Notify"):FireClient(player, "Death", "", {
		depth = s.depth,
		lostCoins = lostCoins,
		lostItems = lostItems,
	})
	sync(player)
end

function ExpeditionService.respawnPoint(player: Player): Vector3
	local s = stateOf(player)
	if s.expedition then
		return WorldConfig.Points.CampArrival
	end
	return WorldConfig.Points.NexusSpawn
end

function ExpeditionService.teleport(player: Player, position: Vector3)
	local character = player.Character
	if character and character.PrimaryPart then
		character:PivotTo(CFrame.new(position + Vector3.new(0, 3, 0)))
	end
end

local function updateRegion(player: Player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local s = stateOf(player)
	local region = WorldConfig.regionAt(root.Position)
	local id = region and region.id or nil
	if id == s.region then
		return
	end
	s.region = id
	s.depth = region and region.depth or 0
	local wasExpedition = s.expedition
	s.expedition = region ~= nil and region.expedition == true
	player:SetAttribute("Region", id or "")
	player:SetAttribute("Depth", s.depth)
	if region then
		local Progression = Registry.get("ProgressionService")
		Progression.recordRegion(player, region.id)
		Registry.get("QuestService").record(player, "EnterRegion", { region = region.id })
		if region.id == "Frontier" then
			Progression.present(player, "Region_Frontier", {
				title = "Emberfall Frontier",
				subtitle = "Depth 1 - 25% of your Satchel is lost if you fall",
				body = "Mine ore, hunt Rift Stalkers and find what the cliffs hide.",
				color = Color3.fromRGB(255, 140, 80),
			})
		elseif region.id == "Keep" then
			Progression.present(player, "Region_Keep", {
				title = "The Ruined Keep",
				subtitle = "Depth 2 - drops x1.3, 50% Satchel loss on death",
				body = "Rune Guardians block light strikes from the front. Break them with heavy attacks.",
				color = Color3.fromRGB(150, 140, 255),
			})
		elseif region.id == "Arena" or region.id == "Approach" then
			Progression.present(player, "Region_Arena", {
				title = "The Rift Edge",
				subtitle = "Depth 3 - drops x1.6, 75% Satchel loss on death",
				body = "The Fracture Warden waits beyond the seal.",
				color = Color3.fromRGB(255, 80, 160),
			})
		end
	end
	-- Leaving Emberfall through any safe route banks nothing automatically except via portals.
	if wasExpedition and not s.expedition and not satchelEmpty(s) then
		-- e.g. Warden Gate shortcut never leaves Emberfall; this only happens via teleports
		ExpeditionService.bank(player, "Camp")
	end
	sync(player)
end

function ExpeditionService.Init() end

local function connectBeacon(prompt: ProximityPrompt, beaconId: string, position: Vector3)
	prompt.Triggered:Connect(function(player)
		local Security = Registry.get("SecurityService")
		if not Security.allow(player, "Interact") then
			return
		end
		if not Security.within(player, position, prompt.MaxActivationDistance + 6) then
			Security.flag(player, "beacon out of range")
			return
		end
		local beacon = ExpeditionConfig.Beacons[beaconId]
		if beacon.requiresVictory and not Registry.get("BossService").victoryBeaconOpen() then
			Net.event("Notify"):FireClient(player, "Error", "The Warden's Beacon only ignites after the Warden falls.")
			return
		end
		local ok, message = ExpeditionService.bank(player, beaconId)
		if not ok and message then
			Net.event("Notify"):FireClient(player, "Info", message)
		end
	end)
end

function ExpeditionService.Start()
	local world = workspace:WaitForChild("World")
	local points = WorldConfig.Points
	local function promptAt(name: string): ProximityPrompt?
		local holder = world:FindFirstChild(name, true)
		return holder and holder:FindFirstChildWhichIsA("ProximityPrompt", true)
	end
	local camp = promptAt("CampBeacon")
	if camp then
		connectBeacon(camp, "Camp", points.CampBeacon)
	end
	local keep = promptAt("KeepBeacon")
	if keep then
		connectBeacon(keep, "Keep", points.KeepBeacon)
	end
	local arena = promptAt("ArenaVictoryBeacon")
	if arena then
		connectBeacon(arena, "Arena", points.ArenaVictoryBeacon)
	end
	local returnPortal = promptAt("CampReturnPortal")
	if returnPortal then
		returnPortal.Triggered:Connect(function(player)
			if not Registry.get("SecurityService").within(player, points.CampReturnPortal, 16) then
				return
			end
			local s = stateOf(player)
			if not satchelEmpty(s) then
				ExpeditionService.bank(player, "Camp") -- the camp is safe: returning banks your Satchel
			end
			ExpeditionService.teleport(player, points.NexusSpawn)
		end)
	end

	local Requests = Registry.get("RequestService")
	Requests.on("EnterExpedition", "Request", function(player, args)
		if not Registry.get("SecurityService").within(player, points.ExpeditionPortal, 22) then
			return false, "Stand at the Rift Portal to launch."
		end
		local moved = { player }
		if args.withParty == true then
			for _, member in Registry.get("PartyService").membersNear(player, points.ExpeditionPortal, 30) do
				table.insert(moved, member)
			end
		end
		for _, p in moved do
			ExpeditionService.teleport(p, points.CampArrival + Vector3.new(math.random(-4, 4), 0, math.random(-4, 4)))
			if p ~= player then
				Net.event("Notify"):FireClient(p, "Info", player.DisplayName .. " launched the expedition with your party.")
			end
		end
		return true, "Entering Emberfall Frontier..."
	end)

	-- Region tracking (cheap: a handful of AABB checks per player twice a second).
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, player in Players:GetPlayers() do
				local ok, err = pcall(updateRegion, player)
				if not ok then
					warn("[Expedition] region update failed: " .. tostring(err))
				end
			end
		end
	end)

	-- Disconnect rule: treated like a death at the current depth; the rest is banked.
	Registry.get("PlayerDataService").Releasing:Connect(function(player)
		local s = states[player]
		if s and not satchelEmpty(s) then
			ExpeditionService.applyLoss(player)
			local satchel = s.satchel
			s.satchel = { coins = 0, items = {} }
			Registry.get("InventoryService").grant(player, { coins = satchel.coins, items = satchel.items })
		end
		states[player] = nil
	end)
end

return ExpeditionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">FusionService</string>
            <string name="Source"><![CDATA[--!strict
-- Power Fusion: research (discovery + masteries + cost, at the Fusion Chamber), attunement
-- (the playable challenge: chain essence A into essence B on the same enemy) and essence attunement.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local FusionConfig = require(Config.FusionConfig)
local EssenceConfig = require(Config.EssenceConfig)
local WorldConfig = require(Config.WorldConfig)
local Costs = require(Shared.Inventory.Costs)
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)

local FusionService = {}

local lastAttuneCast: { [Player]: number } = {}
local hinted: { [Player]: { [string]: boolean } } = {}

local function data(player: Player): any
	return Registry.get("PlayerDataService").get(player)
end

local function notify(player: Player, kind: string, text: string, extra: any?)
	Net.event("Notify"):FireClient(player, kind, text, extra)
end

-- Returns (ok, missing list) for research requirements.
function FusionService.researchStatus(profile: any, fusionId: string): (boolean, { string })
	local def = FusionConfig.Fusions[fusionId]
	local missing = {}
	if not def or not def.implemented then
		return false, { "Not available in this version" }
	end
	for _, essence in def.essences do
		if not profile.essences[essence] or not profile.essences[essence].unlocked then
			table.insert(missing, essence .. " essence")
		end
	end
	local research = def.research
	for essence, level in research.masteries do
		local record = profile.essences[essence]
		if not record or record.mastery < level then
			table.insert(missing, string.format("%s mastery %d", essence, level))
		end
	end
	if research.discovery and not profile.codex.discoveries[research.discovery] then
		table.insert(missing, "Discovery: ???")
	end
	local affordable, lacking = Costs.canAfford(profile, research.cost)
	if not affordable then
		for _, item in lacking do
			table.insert(missing, item)
		end
	end
	return #missing == 0, missing
end

local function unlockFusion(player: Player, profile: any, fusionId: string)
	local def = FusionConfig.Fusions[fusionId]
	local record = profile.fusions[fusionId]
	record.unlocked = true
	Registry.get("PlayerDataService").markDirty(player)
	local Progression = Registry.get("ProgressionService")
	Progression.achieve(player, "FirstFusion")
	Progression.present(player, "Fusion_" .. fusionId, {
		title = def.displayName,
		subtitle = "Fusion Technique Unlocked",
		body = def.summary .. " Equip " .. table.concat(def.essences, " + ") .. " and press R.",
		color = def.color,
	})
	notify(player, "Unlock", def.displayName .. " unlocked! (R)", { color = def.color })
	Net.event("Effect"):FireClient(player, "Sound", { name = "FusionActivation" })
end

function FusionService.onAbilityHit(player: Player, record: any, essences: { string }, castId: number)
	if #essences ~= 1 or record.kind == "Training" then
		return
	end
	local essence = essences[1]
	local profile = data(player)
	if not profile then
		return
	end
	local t = os.clock()
	local uid = player.UserId
	local prev = record.tags[uid]
	if prev and prev.essence ~= essence and prev.cast ~= castId then
		local fusionId = FusionConfig.forPair(prev.essence, essence)
		local def = fusionId and FusionConfig.Fusions[fusionId]
		if fusionId and def and def.implemented and t - prev.time <= def.attunement.window then
			local fusion = profile.fusions[fusionId]
			if fusion and not fusion.unlocked then
				if fusion.researched then
					if lastAttuneCast[player] ~= castId then
						lastAttuneCast[player] = castId
						fusion.attunement = math.min(def.attunement.count, fusion.attunement + 1)
						Registry.get("PlayerDataService").markDirty(player)
						notify(player, "Attune", string.format("%s attunement %d/%d", def.displayName, fusion.attunement, def.attunement.count), { color = def.color })
						if fusion.attunement >= def.attunement.count then
							unlockFusion(player, profile, fusionId)
						end
					end
				else
					hinted[player] = hinted[player] or {}
					if not hinted[player][fusionId] then
						hinted[player][fusionId] = true
						notify(
							player,
							"Hint",
							string.format("%s and %s resonate... Research this union at the Fusion Chamber.", def.essences[1], def.essences[2]),
							{ color = def.color }
						)
					end
				end
			end
		end
	end
	record.tags[uid] = { essence = essence, time = t, cast = castId }
end

function FusionService.refreshResearchHints(_player: Player)
	-- Research availability is computed client-side from the synced profile (Fusion Codex);
	-- this hook exists so future systems can push proactive hints.
end

local function nearChamber(player: Player): boolean
	return Registry.get("SecurityService").within(player, WorldConfig.Points.FusionChamber, 28)
end

function FusionService.Init() end

function FusionService.Start()
	local Requests = Registry.get("RequestService")
	Requests.on("ResearchFusion", "Request", function(player, args)
		local id = args.id
		if type(id) ~= "string" or not FusionConfig.Fusions[id] then
			return false, "Unknown fusion."
		end
		if not nearChamber(player) then
			return false, "Research happens at the Fusion Chamber."
		end
		local profile = data(player)
		local fusion = profile.fusions[id]
		if not fusion then
			return false, "This fusion cannot be researched yet."
		end
		if fusion.researched then
			return false, "Already researched."
		end
		local ok, missing = FusionService.researchStatus(profile, id)
		if not ok then
			return false, "Missing: " .. table.concat(missing, ", ")
		end
		if not Registry.get("InventoryService").spend(player, FusionConfig.Fusions[id].research.cost) then
			return false, "Cannot afford research."
		end
		fusion.researched = true
		Registry.get("PlayerDataService").markDirty(player)
		local def = FusionConfig.Fusions[id]
		return true, "Research complete. Now attune: " .. def.attunement.description
	end)

	Requests.on("AttuneEssence", "Request", function(player, args)
		local essence = args.essence
		if not EssenceConfig.isPlayable(essence) then
			return false, "Unknown essence."
		end
		if not nearChamber(player) then
			return false, "Attunement happens at the Fusion Chamber."
		end
		local profile = data(player)
		local def = EssenceConfig.Essences[essence]
		if profile.essences[essence].unlocked then
			return false, "Already attuned."
		end
		if not def.attuneCost then
			return false, "This essence cannot be attuned here."
		end
		if profile.level < (def.attuneLevel or 1) then
			return false, "Requires level " .. tostring(def.attuneLevel)
		end
		if not Registry.get("InventoryService").spend(player, def.attuneCost) then
			return false, "Missing: " .. Costs.describe(def.attuneCost)
		end
		Registry.get("ProgressionService").unlockEssence(player, essence, "Attuned at the Fusion Chamber.")
		return true, def.displayName .. " attuned."
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastAttuneCast[player] = nil
		hinted[player] = nil
	end)
end

return FusionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">InteractionService</string>
            <string name="Source"><![CDATA[--!strict
-- Generic station prompts in the world (Forge, Fusion Chamber, Quest Board, ...). The world
-- builder tags a ProximityPrompt with a "View" attribute; triggering it opens that view on the
-- client after a server-side distance check. Stations never grant anything by themselves.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)

local InteractionService = {}

function InteractionService.Init() end

function InteractionService.Start()
	local world = workspace:WaitForChild("World")
	for _, prompt in world:GetDescendants() do
		if prompt:IsA("ProximityPrompt") and prompt:GetAttribute("View") then
			local holder = prompt.Parent :: BasePart
			prompt.Triggered:Connect(function(player)
				local Security = Registry.get("SecurityService")
				if not Security.allow(player, "Interact") then
					return
				end
				if not Security.within(player, holder.Position, prompt.MaxActivationDistance + 8) then
					Security.flag(player, "station out of range")
					return
				end
				Net.event("OpenView"):FireClient(player, prompt:GetAttribute("View"), { station = prompt:GetAttribute("Station") })
			end)
		end
	end
end

return InteractionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--!strict
-- The only code path that changes banked coins and materials. Everything is server-owned.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ItemConfig = require(Shared.Config.ItemConfig)
local Costs = require(Shared.Inventory.Costs)
local Registry = require(script.Parent.Parent.Registry)

local InventoryService = {}

local MAX_STACK = 1_000_000

function InventoryService.Init() end
function InventoryService.Start() end

local function data(player: Player): any
	return Registry.get("PlayerDataService").get(player)
end

function InventoryService.addItem(player: Player, item: string, amount: number): boolean
	if not ItemConfig.isValid(item) or type(amount) ~= "number" or amount <= 0 or amount % 1 ~= 0 then
		return false
	end
	local profile = data(player)
	if not profile then
		return false
	end
	profile.materials[item] = math.min(MAX_STACK, (profile.materials[item] or 0) + amount)
	Registry.get("PlayerDataService").markDirty(player)
	return true
end

function InventoryService.addCoins(player: Player, amount: number): boolean
	if type(amount) ~= "number" or amount <= 0 or amount ~= amount then
		return false
	end
	local profile = data(player)
	if not profile then
		return false
	end
	profile.coins = math.min(1e12, profile.coins + math.floor(amount))
	Registry.get("PlayerDataService").markDirty(player)
	return true
end

-- rewards = { coins = n?, items = { [item] = n }? }
function InventoryService.grant(player: Player, rewards: any)
	if rewards.coins and rewards.coins > 0 then
		InventoryService.addCoins(player, rewards.coins)
	end
	if rewards.items then
		for item, amount in rewards.items do
			InventoryService.addItem(player, item, amount)
		end
	end
end

function InventoryService.count(player: Player, item: string): number
	local profile = data(player)
	if not profile then
		return 0
	end
	return Costs.have(profile, item)
end

function InventoryService.canAfford(player: Player, cost: any): (boolean, { string })
	local profile = data(player)
	if not profile then
		return false, { "profile" }
	end
	return Costs.canAfford(profile, cost)
end

-- Atomic check-and-spend (no yields between check and mutation).
function InventoryService.spend(player: Player, cost: any): boolean
	local profile = data(player)
	if not profile then
		return false
	end
	local ok = Costs.spend(profile, cost)
	if ok then
		Registry.get("PlayerDataService").markDirty(player)
	end
	return ok
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">LoadoutService</string>
            <string name="Source"><![CDATA[--!strict
-- Build management: essence slots, saved loadouts, cosmetics and settings.
-- Essence swaps are allowed only in safe zones so builds are chosen before an expedition.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local EssenceConfig = require(Config.EssenceConfig)
local ProgressionConfig = require(Config.ProgressionConfig)
local WorldConfig = require(Config.WorldConfig)
local Registry = require(script.Parent.Parent.Registry)

local LoadoutService = {}

local function inSafeZone(player: Player): boolean
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return true -- respawning: allowed
	end
	local region = WorldConfig.regionAt(root.Position)
	return region ~= nil and region.safe == true
end

local function slotCount(player: Player): number
	local Economy = Registry.get("EconomyService")
	return ProgressionConfig.FreeLoadoutSlots + (if Economy.ownsPass(player, "ExtraLoadouts") then ProgressionConfig.PassLoadoutSlots else 0)
end

local function validateEssence(profile: any, essence: any, allowEmpty: boolean): (boolean, string?)
	if allowEmpty and essence == "" then
		return true, nil
	end
	if not EssenceConfig.isPlayable(essence) then
		return false, "That essence is not available."
	end
	if not profile.essences[essence] or not profile.essences[essence].unlocked then
		return false, "You have not unlocked " .. tostring(essence) .. "."
	end
	return true, nil
end

local SETTINGS = {
	cameraShake = { kind = "number", min = 0, max = 1 },
	effects = { kind = "number", min = 0.2, max = 1 },
	music = { kind = "number", min = 0, max = 1 },
	sfx = { kind = "number", min = 0, max = 1 },
	hudScale = { kind = "number", min = 0.7, max = 1.3 },
	reducedClutter = { kind = "boolean" },
	highContrastTelegraphs = { kind = "boolean" },
}

function LoadoutService.Init() end

function LoadoutService.Start()
	local Requests = Registry.get("RequestService")
	local PlayerData = Registry.get("PlayerDataService")

	Requests.on("EquipEssence", "Request", function(player, args)
		local profile = PlayerData.get(player)
		local slot = args.slot
		if slot ~= "primary" and slot ~= "secondary" then
			return false, "Invalid slot."
		end
		if not inSafeZone(player) then
			return false, "Change essences in the Nexus or at camp."
		end
		local ok, err = validateEssence(profile, args.essence, slot == "secondary")
		if not ok then
			return false, err
		end
		if slot == "secondary" and args.essence ~= "" and profile.level < EssenceConfig.SecondarySlotLevel then
			return false, "Secondary slot unlocks at level " .. EssenceConfig.SecondarySlotLevel .. "."
		end
		local loadout = profile.loadout
		if slot == "primary" then
			if loadout.secondary == args.essence then
				loadout.secondary = loadout.primary
			end
			loadout.primary = args.essence
		else
			if loadout.primary == args.essence then
				return false, "Already your primary essence."
			end
			loadout.secondary = args.essence
		end
		PlayerData.markDirty(player)
		return true, "Loadout updated."
	end)

	Requests.on("SaveLoadout", "Request", function(player, args)
		local profile = PlayerData.get(player)
		local index = args.index
		if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > slotCount(player) then
			return false, "That loadout slot is locked."
		end
		if index == 2 and profile.level < 4 then
			return false, "Second loadout slot unlocks at level 4."
		end
		profile.loadouts[tostring(index)] = {
			primary = profile.loadout.primary,
			secondary = profile.loadout.secondary,
			saved = os.time(),
		}
		PlayerData.markDirty(player)
		return true, "Loadout " .. index .. " saved."
	end)

	Requests.on("ApplyLoadout", "Request", function(player, args)
		local profile = PlayerData.get(player)
		local saved = type(args.index) == "number" and profile.loadouts[tostring(args.index)]
		if not saved then
			return false, "Empty loadout slot."
		end
		if not inSafeZone(player) then
			return false, "Change loadouts in the Nexus or at camp."
		end
		local ok, err = validateEssence(profile, saved.primary, false)
		if not ok then
			return false, err
		end
		local ok2, err2 = validateEssence(profile, saved.secondary, true)
		if not ok2 then
			return false, err2
		end
		profile.loadout.primary = saved.primary
		profile.loadout.secondary = if profile.level >= EssenceConfig.SecondarySlotLevel then saved.secondary else ""
		PlayerData.markDirty(player)
		return true, "Loadout applied."
	end)

	Requests.on("SelectCosmetic", "Request", function(player, args)
		local profile = PlayerData.get(player)
		local id = args.id
		if type(id) ~= "string" or not ProgressionConfig.Cosmetics[id] or not profile.cosmetics.owned[id] then
			return false, "You do not own that cosmetic."
		end
		profile.cosmetics.trail = id
		PlayerData.markDirty(player)
		Registry.get("CombatService").refresh(player)
		return true, "Cosmetic equipped."
	end)

	Requests.on("UpdateSettings", "Request", function(player, args)
		local profile = PlayerData.get(player)
		for key, value in args do
			local rule = SETTINGS[key]
			if rule then
				if rule.kind == "number" and type(value) == "number" and value == value then
					profile.settings[key] = math.clamp(value, rule.min, rule.max)
				elseif rule.kind == "boolean" and type(value) == "boolean" then
					profile.settings[key] = value
				end
			end
		end
		PlayerData.markDirty(player)
		return true, nil
	end)
end

return LoadoutService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">PartyService</string>
            <string name="Source"><![CDATA[--!strict
-- Server-local parties (max 4): invite, accept/decline, leave, kick, leader hand-off and
-- cleanup on disconnect. Parties share contract kill credit and can launch expeditions together.
-- Cross-server parties are NOT implemented.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)

local PartyService = {}

type Party = { id: number, leader: Player, members: { Player } }
local parties: { [number]: Party } = {}
local membership: { [Player]: number } = {}
local invites: { [Player]: { [Player]: number } } = {} -- invitee -> inviter -> expiry
local nextId = 0

local function partyOf(player: Player): Party?
	local id = membership[player]
	return id and parties[id] or nil
end

local function syncParty(party: Party?)
	if not party then
		return
	end
	local members = {}
	for _, m in party.members do
		table.insert(members, { userId = m.UserId, name = m.DisplayName })
	end
	for _, m in party.members do
		Net.event("PartySync"):FireClient(m, { id = party.id, leader = party.leader.UserId, members = members })
	end
end

local function clearFor(player: Player)
	Net.event("PartySync"):FireClient(player, nil)
end

local function removeMember(player: Player, reason: string?)
	local party = partyOf(player)
	if not party then
		return
	end
	membership[player] = nil
	local index = table.find(party.members, player)
	if index then
		table.remove(party.members, index)
	end
	if player.Parent then
		clearFor(player)
		if reason then
			Net.event("Notify"):FireClient(player, "Party", reason)
		end
	end
	if #party.members <= 1 then
		for _, m in party.members do
			membership[m] = nil
			clearFor(m)
			Net.event("Notify"):FireClient(m, "Party", "Your party was disbanded.")
		end
		parties[party.id] = nil
		return
	end
	if party.leader == player then
		party.leader = party.members[1]
		Net.event("Notify"):FireClient(party.leader, "Party", "You are now the party leader.")
	end
	syncParty(party)
end

function PartyService.membersNear(player: Player, position: Vector3, radius: number): { Player }
	local party = partyOf(player)
	local list = {}
	if not party then
		return list
	end
	for _, m in party.members do
		if m ~= player then
			local root = m.Character and m.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local humanoid = m.Character and m.Character:FindFirstChildOfClass("Humanoid")
			if root and humanoid and humanoid.Health > 0 and (root.Position - position).Magnitude <= radius then
				table.insert(list, m)
			end
		end
	end
	return list
end

function PartyService.onExtract(_player: Player)
	-- hook for future party objectives
end

function PartyService.Init() end

function PartyService.Start()
	local Requests = Registry.get("RequestService")

	Requests.on("PartyInvite", "Party", function(player, args)
		local target = type(args.userId) == "number" and Players:GetPlayerByUserId(args.userId)
		if not target or target == player then
			return false, "Player not found."
		end
		local party = partyOf(player)
		if party and party.leader ~= player then
			return false, "Only the leader can invite."
		end
		if party and #party.members >= GameConfig.Party.MaxSize then
			return false, "Party is full (max " .. GameConfig.Party.MaxSize .. ")."
		end
		if partyOf(target) then
			return false, target.DisplayName .. " is already in a party."
		end
		invites[target] = invites[target] or {}
		invites[target][player] = os.clock() + GameConfig.Party.InviteTimeout
		Net.event("Notify"):FireClient(target, "PartyInvite", player.DisplayName .. " invited you to a party.", { from = player.UserId, name = player.DisplayName })
		return true, "Invite sent to " .. target.DisplayName .. "."
	end)

	Requests.on("PartyRespond", "Party", function(player, args)
		local inviter = type(args.userId) == "number" and Players:GetPlayerByUserId(args.userId)
		local pending = invites[player]
		if not inviter or not pending or not pending[inviter] or pending[inviter] < os.clock() then
			return false, "That invite expired."
		end
		pending[inviter] = nil
		if args.accept ~= true then
			Net.event("Notify"):FireClient(inviter, "Party", player.DisplayName .. " declined your invite.")
			return true, "Invite declined."
		end
		if partyOf(player) then
			return false, "Leave your current party first."
		end
		local party = partyOf(inviter)
		if not party then
			nextId += 1
			party = { id = nextId, leader = inviter, members = { inviter } }
			parties[party.id] = party
			membership[inviter] = party.id
		end
		if #party.members >= GameConfig.Party.MaxSize then
			return false, "Party is full."
		end
		table.insert(party.members, player)
		membership[player] = party.id
		invites[player] = nil
		syncParty(party)
		for _, m in party.members do
			Net.event("Notify"):FireClient(m, "Party", player.DisplayName .. " joined the party.")
		end
		return true, "Joined " .. inviter.DisplayName .. "'s party."
	end)

	Requests.on("PartyLeave", "Party", function(player, _args)
		if not partyOf(player) then
			return false, "You are not in a party."
		end
		removeMember(player, "You left the party.")
		return true, nil
	end)

	Requests.on("PartyKick", "Party", function(player, args)
		local party = partyOf(player)
		local target = type(args.userId) == "number" and Players:GetPlayerByUserId(args.userId)
		if not party or party.leader ~= player then
			return false, "Only the leader can remove members."
		end
		if not target or partyOf(target) ~= party or target == player then
			return false, "Not in your party."
		end
		removeMember(target, "You were removed from the party.")
		return true, target.DisplayName .. " removed."
	end)

	Players.PlayerRemoving:Connect(function(player)
		removeMember(player, nil)
		invites[player] = nil
		for _, pending in invites do
			pending[player] = nil
		end
	end)
end

return PartyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[--!strict
-- Persistent player profiles via DataStoreService.
--  * Session locking through UpdateAsync (one server owns a profile at a time).
--  * Versioned schema + migrations (Data/ProfileSchema).
--  * Bounded retries with exponential backoff, autosave, PlayerRemoving + BindToClose saves.
--  * A failed load NEVER falls back to blank data that could overwrite a real save:
--    the player gets a temporary, non-saving profile and a clear on-screen warning.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local ProfileSchema = require(script.Parent.Parent.Data.ProfileSchema)

type ProfileState = "Loading" | "Loaded" | "Temporary" | "Released"

type Profile = {
	data: any,
	state: ProfileState,
	reason: string?,
	dirty: boolean,
	syncDirty: boolean,
	saving: boolean,
	pendingSave: boolean,
	lastSave: number,
	joinedAt: number,
}

local PlayerDataService = {}
PlayerDataService.Loaded = Signal.new() -- (player, data)
PlayerDataService.Releasing = Signal.new() -- (player, data) fired before the final save

local CFG = GameConfig.Data
local profiles: { [Player]: Profile } = {}
local store: DataStore? = nil
local storeError: string? = nil
local JOB_ID = if game.JobId ~= "" then game.JobId else ("studio-" .. tostring(math.random(1, 1e9)))
local shuttingDown = false

local function keyFor(player: Player): string
	return CFG.KeyPrefix .. tostring(player.UserId)
end

local function backoff(attempt: number)
	task.wait(math.min(CFG.RetryBaseDelay * 2 ^ (attempt - 1), 8))
end

function PlayerDataService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(CFG.DataStoreName)
	end)
	if ok then
		store = result
	else
		storeError = tostring(result)
		warn("[PlayerData] DataStore unavailable: " .. storeError)
	end
end

local function notifyState(player: Player, profile: Profile)
	local remote = Net.event("Notify")
	if profile.state == "Temporary" then
		remote:FireClient(
			player,
			"DataWarning",
			"Progress is NOT being saved this session: " .. (profile.reason or "data unavailable"),
			{ persistent = true }
		)
	end
end

-- Loads (or creates) the profile. Yields. Returns the data table.
function PlayerDataService.load(player: Player): any
	local profile: Profile = {
		data = nil,
		state = "Loading",
		dirty = false,
		syncDirty = true,
		saving = false,
		pendingSave = false,
		lastSave = os.clock(),
		joinedAt = os.clock(),
	}
	profiles[player] = profile

	if not store then
		profile.data = ProfileSchema.default()
		profile.state = "Temporary"
		profile.reason = if RunService:IsStudio()
			then "Studio has no DataStore access (enable 'Studio Access to API Services')"
			else "DataStore unavailable"
	else
		local loadedRaw: any = nil
		local lockedBy: any = nil
		local success = false
		local lastError = ""
		for attempt = 1, CFG.LoadAttempts do
			lockedBy = nil
			local ok, err = pcall(function()
				(store :: DataStore):UpdateAsync(keyFor(player), function(old)
					old = if type(old) == "table" then old else {}
					local lock = old.lock
					if
						type(lock) == "table"
						and lock.jobId ~= JOB_ID
						and type(lock.time) == "number"
						and os.time() - lock.time < CFG.SessionLockTimeout
					then
						lockedBy = lock
						return nil -- abort: another server owns this profile
					end
					loadedRaw = old.data
					old.lock = { jobId = JOB_ID, time = os.time() }
					return old
				end)
			end)
			if not player.Parent then
				profiles[player] = nil
				return nil
			end
			if ok and not lockedBy then
				success = true
				break
			end
			lastError = if ok then "profile is locked by another server" else tostring(err)
			-- Studio without API access (or an unpublished place) will never succeed: stop now.
			if
				not ok
				and (
					string.find(lastError, "StudioAccessToApisNotAllowed", 1, true)
					or string.find(lastError, "publish", 1, true)
				)
			then
				break
			end
			backoff(attempt)
		end

		if success then
			local data, reason = ProfileSchema.load(loadedRaw)
			if data then
				profile.data = data
				profile.state = "Loaded"
			else
				-- Data exists but is unusable (e.g. newer schema). Never overwrite it.
				profile.data = ProfileSchema.default()
				profile.state = "Temporary"
				profile.reason = reason
				-- Release our lock so the newer server can still use it.
				task.spawn(function()
					pcall(function()
						(store :: DataStore):UpdateAsync(keyFor(player), function(old)
							if type(old) == "table" and type(old.lock) == "table" and old.lock.jobId == JOB_ID then
								old.lock = nil
								return old
							end
							return nil
						end)
					end)
				end)
			end
		else
			profile.data = ProfileSchema.default()
			profile.state = "Temporary"
			profile.reason = lastError
		end
	end

	if profile.state == "Temporary" then
		warn(string.format("[PlayerData] %s using temporary profile: %s", player.Name, tostring(profile.reason)))
	end
	notifyState(player, profile)
	PlayerDataService.Loaded:Fire(player, profile.data)
	return profile.data
end

function PlayerDataService.get(player: Player): any
	local profile = profiles[player]
	if profile and (profile.state == "Loaded" or profile.state == "Temporary") then
		return profile.data
	end
	return nil
end

function PlayerDataService.state(player: Player): string?
	local profile = profiles[player]
	return profile and profile.state
end

function PlayerDataService.isSaving(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.state == "Loaded"
end

function PlayerDataService.markDirty(player: Player)
	local profile = profiles[player]
	if profile then
		profile.dirty = true
		profile.syncDirty = true
	end
end

-- Performs one save. Returns true on success. Yields.
local function doSave(player: Player, profile: Profile, release: boolean): boolean
	if profile.state ~= "Loaded" or not store then
		return profile.state == "Temporary" -- nothing to save, not an error
	end
	if profile.saving then
		profile.pendingSave = true
		local start = os.clock()
		while profile.saving and os.clock() - start < 30 do
			task.wait(0.1)
		end
	end
	profile.saving = true
	profile.pendingSave = false
	local snapshot = ProfileSchema.deepCopy(profile.data)
	snapshot.stats.playTime += math.floor(os.clock() - profile.joinedAt)
	local lostLock = false
	local success = false
	for attempt = 1, CFG.SaveAttempts do
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(keyFor(player), function(old)
				if type(old) == "table" and type(old.lock) == "table" and old.lock.jobId ~= JOB_ID then
					lostLock = true
					return nil
				end
				return {
					data = snapshot,
					lock = if release then nil else { jobId = JOB_ID, time = os.time() },
					savedAt = os.time(),
				}
			end)
		end)
		if ok then
			success = not lostLock
			break
		end
		warn(string.format("[PlayerData] save attempt %d for %s failed: %s", attempt, player.Name, tostring(err)))
		if attempt < CFG.SaveAttempts then
			backoff(attempt)
		end
	end
	if lostLock then
		profile.state = "Temporary"
		profile.reason = "another server took ownership of this profile"
		warn("[PlayerData] session lock lost for " .. player.Name)
		if player.Parent then
			notifyState(player, profile)
		end
	end
	if success then
		profile.dirty = false
		profile.lastSave = os.clock()
		-- playTime is accumulated in the snapshot; reset the baseline.
		profile.data.stats.playTime = snapshot.stats.playTime
		profile.joinedAt = os.clock()
	end
	profile.saving = false
	return success
end

function PlayerDataService.save(player: Player): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	return doSave(player, profile, false)
end

local function release(player: Player)
	local profile = profiles[player]
	if not profile or profile.state == "Released" or profile.state == "Loading" then
		profiles[player] = nil
		return
	end
	PlayerDataService.Releasing:Fire(player, profile.data)
	doSave(player, profile, true)
	profile.state = "Released"
	profiles[player] = nil
end

function PlayerDataService.Start()
	-- Clients ask for a full snapshot once their listeners are connected.
	require(script.Parent.Parent.Registry).get("RequestService").on("Sync", "Request", function(player, _args)
		local profile = profiles[player]
		if profile then
			profile.syncDirty = true
		end
		return true, nil
	end, false)
	Players.PlayerRemoving:Connect(function(player)
		release(player)
	end)

	game:BindToClose(function()
		shuttingDown = true
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				release(player)
				pending -= 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.1)
		end
	end)

	-- Autosave
	task.spawn(function()
		while not shuttingDown do
			task.wait(5)
			for player, profile in profiles do
				if
					profile.state == "Loaded"
					and profile.dirty
					and not profile.saving
					and os.clock() - profile.lastSave >= CFG.AutosaveInterval
				then
					task.spawn(doSave, player, profile, false)
				end
			end
		end
	end)

	-- Client sync (throttled)
	local remote = Net.event("ProfileSync")
	task.spawn(function()
		while true do
			task.wait(0.2)
			for player, profile in profiles do
				if profile.syncDirty and profile.data and player.Parent then
					profile.syncDirty = false
					remote:FireClient(player, ProfileSchema.publicView(profile.data), {
						state = profile.state,
						reason = profile.reason,
					})
				end
			end
		end
	end)
end

return PlayerDataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--!strict
-- XP, levels, weapon/essence mastery, unlocks, achievements, codex and first-time moments.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local ProgressionConfig = require(Config.ProgressionConfig)
local WeaponConfig = require(Config.WeaponConfig)
local EssenceConfig = require(Config.EssenceConfig)
local Leveling = require(Shared.Progression.Leveling)
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)

local ProgressionService = {}

local function data(player: Player): any
	return Registry.get("PlayerDataService").get(player)
end

local function dirty(player: Player)
	Registry.get("PlayerDataService").markDirty(player)
end

local function notify(player: Player, kind: string, text: string, extra: any?)
	Net.event("Notify"):FireClient(player, kind, text, extra)
end

function ProgressionService.Init() end
function ProgressionService.Start() end

-- First-time presentation moments (shown once per profile).
function ProgressionService.present(player: Player, momentId: string, payload: any)
	local profile = data(player)
	if not profile then
		return
	end
	if profile.tutorial.moments[momentId] then
		return
	end
	profile.tutorial.moments[momentId] = true
	dirty(player)
	Net.event("Present"):FireClient(player, momentId, payload)
end

function ProgressionService.addXp(player: Player, amount: number)
	local profile = data(player)
	if not profile or amount <= 0 then
		return
	end
	local result = Leveling.add(profile.level, profile.xp, amount, ProgressionConfig.levelXp, ProgressionConfig.MaxLevel)
	profile.level, profile.xp = result.level, result.xp
	dirty(player)
	if result.gained > 0 then
		local unlock = ProgressionConfig.LevelUnlocks[profile.level]
		notify(player, "LevelUp", "Level " .. profile.level .. "!", { unlock = unlock })
		Net.event("Effect"):FireAllClients("LevelUp", { player = player })
	end
end

function ProgressionService.addWeaponMastery(player: Player, weaponId: string, amount: number)
	local profile = data(player)
	if not profile or amount <= 0 then
		return
	end
	local weapon = profile.weapons[weaponId]
	local def = WeaponConfig.Weapons[weaponId]
	if not weapon or not def or not def.implemented then
		return
	end
	local result =
		Leveling.add(weapon.mastery, weapon.masteryXp, amount, ProgressionConfig.weaponMasteryXp, def.maxMastery)
	weapon.mastery, weapon.masteryXp = result.level, result.xp
	dirty(player)
	if result.gained > 0 then
		local unlock = def.masteryUnlocks[weapon.mastery]
		notify(
			player,
			"Mastery",
			string.format("%s mastery %d", def.displayName, weapon.mastery),
			{ unlock = unlock, color = def.trailColor }
		)
		if weapon.mastery >= def.evolutionMastery and weapon.evolution == "None" then
			if profile.trials[def.evolutionTrial] then
				ProgressionService.present(player, "EvolutionReady", { weapon = weaponId })
			else
				notify(player, "Info", "Complete the Katana Trial at the Training Arena to unlock evolution.")
			end
		end
	end
end

function ProgressionService.addEssenceXp(player: Player, essence: string, amount: number)
	local profile = data(player)
	if not profile or amount <= 0 then
		return
	end
	local record = profile.essences[essence]
	local def = EssenceConfig.Essences[essence]
	if not record or not record.unlocked or not def or not def.implemented then
		return
	end
	local result = Leveling.add(record.mastery, record.xp, amount, ProgressionConfig.essenceMasteryXp, def.maxMastery)
	record.mastery, record.xp = result.level, result.xp
	dirty(player)
	if result.gained > 0 then
		notify(
			player,
			"Mastery",
			string.format("%s mastery %d", def.displayName, record.mastery),
			{ unlock = def.masteryUnlocks[record.mastery], color = def.color }
		)
		Registry.get("FusionService").refreshResearchHints(player)
	end
end

function ProgressionService.unlockEssence(player: Player, essence: string, reason: string): boolean
	local profile = data(player)
	if not profile or not EssenceConfig.isPlayable(essence) then
		return false
	end
	local record = profile.essences[essence]
	if record.unlocked then
		return false
	end
	record.unlocked = true
	dirty(player)
	local def = EssenceConfig.Essences[essence]
	Registry.get("PlayerDataService").markDirty(player)
	ProgressionService.present(player, "Essence_" .. essence, {
		title = def.displayName .. " Essence Awakened",
		subtitle = def.theme,
		body = reason .. " Equip it in Loadout (Tab).",
		color = def.color,
	})
	notify(player, "Unlock", def.displayName .. " essence unlocked!", { color = def.color })
	local unlockedCount = 0
	for _, r in profile.essences do
		if r.unlocked then
			unlockedCount += 1
		end
	end
	if unlockedCount >= 2 then
		ProgressionService.achieve(player, "SecondSoul")
	end
	Registry.get("QuestService").record(player, "EssenceUnlocked", { essence = essence })
	return true
end

function ProgressionService.achieve(player: Player, id: string)
	local profile = data(player)
	local def = ProgressionConfig.Achievements[id]
	if not profile or not def or profile.achievements[id] then
		return
	end
	profile.achievements[id] = os.time()
	dirty(player)
	notify(player, "Achievement", def.name, { description = def.description })
	-- Achievement cosmetics
	for _, cosmetic in ProgressionConfig.Cosmetics do
		if cosmetic.achievement == id then
			profile.cosmetics.owned[cosmetic.id] = true
			notify(player, "Unlock", "Cosmetic unlocked: " .. cosmetic.name)
		end
	end
end

-- Increments a lifetime stat and checks stat-based achievements.
function ProgressionService.stat(player: Player, key: string, amount: number?)
	local profile = data(player)
	if not profile then
		return
	end
	profile.stats[key] = (profile.stats[key] or 0) + (amount or 1)
	dirty(player)
	for id, def in ProgressionConfig.Achievements do
		if def.stat == key and profile.stats[key] >= def.target then
			ProgressionService.achieve(player, id)
		end
	end
end

function ProgressionService.discover(player: Player, discoveryId: string): boolean
	local profile = data(player)
	if not profile or profile.codex.discoveries[discoveryId] then
		return false
	end
	profile.codex.discoveries[discoveryId] = os.time()
	dirty(player)
	Registry.get("QuestService").record(player, "Discover", { id = discoveryId })
	return true
end

function ProgressionService.recordEnemy(player: Player, archetype: string, defeated: boolean)
	local profile = data(player)
	if not profile then
		return
	end
	local entry = profile.codex.enemies[archetype]
	if not entry then
		entry = { seen = true, defeated = 0 }
		profile.codex.enemies[archetype] = entry
	end
	if defeated then
		entry.defeated += 1
	end
	dirty(player)
end

function ProgressionService.recordRegion(player: Player, regionId: string)
	local profile = data(player)
	if not profile or profile.codex.regions[regionId] then
		return
	end
	profile.codex.regions[regionId] = os.time()
	dirty(player)
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[--!strict
-- Tracks server-validated gameplay events against QuestConfig. Rewards are claimed explicitly
-- and exactly once (the claim flag is written before any reward is granted).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local QuestConfig = require(Shared.Config.QuestConfig)
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)

local QuestService = {}

local function data(player: Player): any
	return Registry.get("PlayerDataService").get(player)
end

local function dayKey(): number
	return os.time() // 86400
end

local function refreshDaily(profile: any)
	local key = dayKey()
	if profile.daily.dayKey ~= key then
		profile.daily.dayKey = key
		profile.daily.progress = {}
		profile.daily.claimed = {}
	end
end

local function requirementsMet(profile: any, def: any): boolean
	if def.requires then
		for _, req in def.requires do
			if not profile.quests.completed[req] then
				return false
			end
		end
	end
	return true
end

-- Returns the progress table + completion flags for a quest given the profile.
local function questSlot(profile: any, def: any): (any, boolean, boolean)
	if def.daily or def.dailyPick then
		local progress = profile.daily.progress[def.id]
		local claimed = profile.daily.claimed[def.id] == true
		local complete = profile.daily.claimed[def.id] ~= nil or (progress and progress.done == true) or false
		return progress, complete, claimed
	end
	local progress = profile.quests.progress[def.id]
	return progress, profile.quests.completed[def.id] == true, profile.quests.claimed[def.id] == true
end

local function advance(player: Player, profile: any, def: any, event: string, eventData: any, amount: number): boolean
	local progress, complete = questSlot(profile, def)
	if complete then
		return false
	end
	local changed = false
	for i, objective in def.objectives do
		if QuestConfig.matches(objective, event, eventData) then
			if not progress then
				-- Dense array of zeros: DataStores reject sparse arrays (e.g. { [2] = 1 }).
				local counts = table.create(#def.objectives, 0)
				progress = { counts = counts }
				if def.daily or def.dailyPick then
					profile.daily.progress[def.id] = progress
				else
					profile.quests.progress[def.id] = progress
				end
			end
			local current = progress.counts[i] or 0
			if current < objective.count then
				progress.counts[i] = math.min(objective.count, current + amount)
				changed = true
			end
		end
	end
	if not changed then
		return false
	end
	local done = true
	for i, objective in def.objectives do
		if (progress.counts[i] or 0) < objective.count then
			done = false
			break
		end
	end
	if done then
		if def.daily or def.dailyPick then
			progress.done = true
		else
			profile.quests.completed[def.id] = true
		end
		Net.event("Notify"):FireClient(player, "QuestComplete", def.title, { id = def.id })
		Net.event("Effect"):FireClient(player, "Sound", { name = "QuestComplete" })
	end
	return true
end

function QuestService.dailyDefs(): { any }
	local defs = {}
	for _, idx in QuestConfig.dailyPicks(dayKey()) do
		local entry = QuestConfig.DailyPool[idx]
		table.insert(defs, {
			id = entry.id,
			title = entry.title,
			category = "Daily",
			description = "Daily challenge. Resets at 00:00 UTC.",
			objectives = entry.objectives,
			rewards = entry.rewards,
			dailyPick = true,
		})
	end
	return defs
end

-- Record a gameplay event. Only server code calls this.
function QuestService.record(player: Player, event: string, eventData: any?, amount: number?)
	local profile = data(player)
	if not profile then
		return
	end
	refreshDaily(profile)
	local n = amount or 1
	local changed = false
	for _, id in QuestConfig.Order do
		local def = QuestConfig.Quests[id]
		if requirementsMet(profile, def) then
			if advance(player, profile, def, event, eventData, n) then
				changed = true
			end
		end
	end
	if profile.level >= QuestConfig.DailyLevel then
		for _, def in QuestService.dailyDefs() do
			if advance(player, profile, def, event, eventData, n) then
				changed = true
			end
		end
	end
	if changed then
		Registry.get("PlayerDataService").markDirty(player)
	end
	Registry.get("TrialService").onEvent(player, event, eventData)
end

local function grantRewards(player: Player, rewards: any)
	local Inventory = Registry.get("InventoryService")
	local Progression = Registry.get("ProgressionService")
	Inventory.grant(player, rewards)
	if rewards.xp then
		Progression.addXp(player, rewards.xp)
	end
	if rewards.weaponMastery then
		Progression.addWeaponMastery(player, "Katana", rewards.weaponMastery)
	end
	if rewards.essence then
		Progression.unlockEssence(player, rewards.essence, "Contract reward.")
	end
end

function QuestService.claim(player: Player, questId: string): (boolean, string?)
	local profile = data(player)
	if not profile then
		return false, "Profile not loaded."
	end
	refreshDaily(profile)
	local def = QuestConfig.Quests[questId]
	if def and not def.daily then
		if not profile.quests.completed[questId] then
			return false, "Not complete yet."
		end
		if profile.quests.claimed[questId] then
			return false, "Already claimed."
		end
		profile.quests.claimed[questId] = true -- set BEFORE granting: duplicate requests fail here
		Registry.get("PlayerDataService").markDirty(player)
		grantRewards(player, def.rewards)
		return true, "Reward claimed: " .. def.title
	end
	-- Daily quest or daily pick
	local dailyDef = def
	if not dailyDef then
		for _, d in QuestService.dailyDefs() do
			if d.id == questId then
				dailyDef = d
			end
		end
	end
	if not dailyDef then
		return false, "Unknown quest."
	end
	local progress = profile.daily.progress[questId]
	if not progress or not progress.done then
		return false, "Not complete yet."
	end
	if profile.daily.claimed[questId] then
		return false, "Already claimed today."
	end
	profile.daily.claimed[questId] = true
	Registry.get("PlayerDataService").markDirty(player)
	grantRewards(player, dailyDef.rewards)
	return true, "Reward claimed: " .. dailyDef.title
end

function QuestService.Init() end

function QuestService.Start()
	local Requests = Registry.get("RequestService")
	Requests.on("ClaimQuest", "Request", function(player, args)
		if type(args.id) ~= "string" or #args.id > 40 then
			return false, "Invalid quest."
		end
		return QuestService.claim(player, args.id)
	end)
	Registry.get("PlayerDataService").Loaded:Connect(function(_player, profile)
		refreshDaily(profile)
	end)
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">RequestService</string>
            <string name="Source"><![CDATA[--!strict
-- Routes the single "Request" RemoteFunction to registered handlers with rate limiting,
-- profile checks and error isolation. Handlers: (player, args) -> (ok, message?, data?).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)

type Handler = (Player, any) -> (boolean, string?, any)

local RequestService = {}
local handlers: { [string]: { category: string, fn: Handler, needsProfile: boolean } } = {}

function RequestService.Init() end

function RequestService.on(kind: string, category: string, fn: Handler, needsProfile: boolean?)
	assert(handlers[kind] == nil, "duplicate request handler " .. kind)
	handlers[kind] = { category = category, fn = fn, needsProfile = needsProfile ~= false }
end

function RequestService.Start()
	local Security = Registry.get("SecurityService")
	local PlayerData = Registry.get("PlayerDataService")
	Net.func("Request").OnServerInvoke = function(player: Player, kind: any, args: any)
		if type(kind) ~= "string" or #kind > 40 then
			Security.flag(player, "bad request kind")
			return false, "Invalid request."
		end
		local entry = handlers[kind]
		if not entry then
			Security.flag(player, "unknown request " .. kind)
			return false, "Unknown request."
		end
		if not Security.allow(player, entry.category) then
			return false, "Slow down a little."
		end
		if args ~= nil and type(args) ~= "table" then
			return false, "Invalid arguments."
		end
		if entry.needsProfile and not PlayerData.get(player) then
			return false, "Your profile is still loading."
		end
		local ok, a, b, c = pcall(entry.fn, player, args or {})
		if not ok then
			warn(string.format("[Request] %s failed for %s: %s", kind, player.Name, tostring(a)))
			return false, "Something went wrong. Try again."
		end
		return a, b, c
	end
end

return RequestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">ResourceService</string>
            <string name="Source"><![CDATA[--!strict
-- Mining nodes: discoverable models with hold-to-mine prompts. Charges are shared and
-- decremented synchronously (no yield between check and claim), so two players can never
-- claim the same last charge. Rewards are granted only here, on the server.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local ResourceConfig = require(Config.ResourceConfig)
local WorldConfig = require(Config.WorldConfig)
local ItemConfig = require(Config.ItemConfig)
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)
local Models = require(script.Parent.Parent.World.Models)

local ResourceService = {}

type Node = {
	id: number,
	def: any,
	model: Model,
	base: BasePart,
	prompt: ProximityPrompt,
	charges: number,
	position: Vector3,
	temporary: boolean,
	softTier: boolean,
	depleted: boolean,
}

local nodes: { [number]: Node } = {}
local nextId = 0
local folder: Folder

local function setDepleted(node: Node, depleted: boolean)
	node.depleted = depleted
	node.prompt.Enabled = not depleted
	for _, part in node.model:GetChildren() do
		if part:IsA("BasePart") and part.Name:sub(1, 4) == "Vein" then
			part.Transparency = if depleted then 1 else 0
		end
	end
	local light = node.base:FindFirstChildOfClass("PointLight")
	if light then
		light.Enabled = not depleted
	end
end

local function onMine(node: Node, player: Player)
	local Security = Registry.get("SecurityService")
	if not Security.allow(player, "Interact") then
		return
	end
	if node.depleted or node.charges <= 0 then
		return
	end
	if not Security.within(player, node.position, node.prompt.MaxActivationDistance + 5) then
		Security.flag(player, "mining out of range")
		return
	end
	local profile = Registry.get("PlayerDataService").get(player)
	if not profile then
		return
	end
	if profile.tools.pickTier < node.def.tier and not node.softTier then
		Net.event("Notify"):FireClient(
			player,
			"Error",
			string.format("%s requires a %s (craft one at the Artisan Bench).", node.def.displayName, ResourceConfig.ToolTiers[node.def.tier])
		)
		return
	end
	-- claim (synchronous)
	node.charges -= 1
	local amount = math.random(node.def.yield[1], node.def.yield[2])
	local item = node.def.item
	Registry.get("ExpeditionService").giveLoot(player, { [item] = amount }, 0, node.position)
	Registry.get("ProgressionService").addXp(player, node.def.xp)
	Registry.get("ProgressionService").stat(player, "oreMined", amount)
	Registry.get("QuestService").record(player, "Mine", { item = item, node = node.def.id }, amount)
	Net.event("Effect"):FireAllClients("Mine", { position = node.position, color = node.def.glow, item = ItemConfig.Items[item].name })
	if node.charges <= 0 then
		if node.temporary or node.def.respawn <= 0 then
			nodes[node.id] = nil
			node.model:Destroy()
		else
			setDepleted(node, true)
			task.delay(node.def.respawn, function()
				if nodes[node.id] then
					node.charges = node.def.charges
					setDepleted(node, false)
				end
			end)
		end
	end
end

function ResourceService.spawnNode(nodeId: string, position: Vector3, opts: any?): Node?
	local def = ResourceConfig.Nodes[nodeId]
	if not def then
		return nil
	end
	local o = opts or {}
	local model, base = Models.node(def, position, folder)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Mine"
	prompt.ObjectText = def.displayName .. (if def.tier > 1 and not o.softTier then " (Cobalt Pick)" else "")
	prompt.HoldDuration = def.holdDuration
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Parent = base
	nextId += 1
	local node: Node = {
		id = nextId,
		def = def,
		model = model,
		base = base,
		prompt = prompt,
		charges = def.charges,
		position = position,
		temporary = o.temporary == true,
		softTier = o.softTier == true,
		depleted = false,
	}
	model:SetAttribute("Resource", def.item)
	nodes[node.id] = node
	prompt.Triggered:Connect(function(player)
		onMine(node, player)
	end)
	prompt.PromptButtonHoldBegan:Connect(function(player)
		Net.event("Effect"):FireAllClients("MineSwing", { character = player.Character, position = position })
	end)
	return node
end

function ResourceService.removeNode(node: Node)
	nodes[node.id] = nil
	if node.model.Parent then
		node.model:Destroy()
	end
end

function ResourceService.Init()
	folder = Instance.new("Folder")
	folder.Name = "Resources"
	folder.Parent = workspace
end

function ResourceService.Start()
	for _, placement in WorldConfig.Nodes do
		ResourceService.spawnNode(placement.node, placement.position)
	end
end

return ResourceService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">SecurityService</string>
            <string name="Source"><![CDATA[--!strict
-- Untrusted-input helpers: token-bucket rate limits, type validation, state checks and
-- bounded diagnostics. Malformed requests are rejected quietly; nobody is kicked for them.

local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)

local SecurityService = {}

type Bucket = { tokens: number, last: number }
local buckets: { [Player]: { [string]: Bucket } } = {}
local strikes: { [Player]: { count: number, lastWarn: number } } = {}

function SecurityService.Init() end

function SecurityService.Start()
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
		strikes[player] = nil
	end)
end

-- Returns true if the player may perform an action in this category now.
function SecurityService.allow(player: Player, category: string): boolean
	local limits = GameConfig.RateLimits[category]
	if not limits then
		return false
	end
	local perPlayer = buckets[player]
	if not perPlayer then
		perPlayer = {}
		buckets[player] = perPlayer
	end
	local now = os.clock()
	local bucket = perPlayer[category]
	if not bucket then
		bucket = { tokens = limits.burst, last = now }
		perPlayer[category] = bucket
	end
	bucket.tokens = math.min(limits.burst, bucket.tokens + (now - bucket.last) * limits.rate)
	bucket.last = now
	if bucket.tokens < 1 then
		SecurityService.flag(player, "rate limit: " .. category)
		return false
	end
	bucket.tokens -= 1
	return true
end

-- Bounded diagnostic logging: counts everything, prints at most every 10s per player.
function SecurityService.flag(player: Player, reason: string)
	local entry = strikes[player]
	if not entry then
		entry = { count = 0, lastWarn = 0 }
		strikes[player] = entry
	end
	entry.count += 1
	if os.clock() - entry.lastWarn > 10 then
		entry.lastWarn = os.clock()
		warn(string.format("[Security] %s (%d): %s [total flags: %d]", player.Name, player.UserId, reason, entry.count))
	end
end

function SecurityService.flagCount(player: Player): number
	local entry = strikes[player]
	return entry and entry.count or 0
end

-- Validators -----------------------------------------------------------------------------

function SecurityService.isFiniteNumber(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

function SecurityService.isVector3(v: any): boolean
	return typeof(v) == "Vector3"
		and SecurityService.isFiniteNumber(v.X)
		and SecurityService.isFiniteNumber(v.Y)
		and SecurityService.isFiniteNumber(v.Z)
end

-- A direction must be a finite vector with a sane magnitude; returns a flattened unit vector.
function SecurityService.direction(v: any): Vector3?
	if not SecurityService.isVector3(v) then
		return nil
	end
	local flat = Vector3.new(v.X, 0, v.Z)
	if flat.Magnitude < 0.2 or v.Magnitude > 2 then
		return nil
	end
	return flat.Unit
end

function SecurityService.isString(v: any, maxLength: number?): boolean
	return type(v) == "string" and #v <= (maxLength or 64)
end

function SecurityService.isInteger(v: any, min: number, max: number): boolean
	return SecurityService.isFiniteNumber(v) and v % 1 == 0 and v >= min and v <= max
end

-- Character helpers -----------------------------------------------------------------------

function SecurityService.alive(player: Player): (BasePart?, Humanoid?)
	local character = player.Character
	if not character or not character.Parent then
		return nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then
		return nil, nil
	end
	return root :: BasePart, humanoid
end

function SecurityService.within(player: Player, position: Vector3, maxDistance: number): boolean
	local root = SecurityService.alive(player)
	if not root then
		return false
	end
	return (root.Position - position).Magnitude <= maxDistance
end

-- Clamp an aim point to a maximum range from the player (prevents casting at the far side of the map).
function SecurityService.clampAim(player: Player, point: any, maxRange: number): Vector3?
	local root = SecurityService.alive(player)
	if not root then
		return nil
	end
	if not SecurityService.isVector3(point) then
		return root.Position + root.CFrame.LookVector * math.min(maxRange, 12)
	end
	local offset = point - root.Position
	local flat = Vector3.new(offset.X, 0, offset.Z)
	if flat.Magnitude > maxRange then
		flat = flat.Unit * maxRange
	end
	return root.Position + flat
end

return SecurityService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">SpawnService</string>
            <string name="Source"><![CDATA[--!strict
-- Player lifecycle: load profile -> spawn character -> equip katana -> combat state.
-- Deaths apply the expedition penalty, fail trials and respawn after a short delay at the
-- camp (if mid-expedition) or the Nexus.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Registry = require(script.Parent.Parent.Registry)
local Models = require(script.Parent.Parent.World.Models)

local SpawnService = {}

local loaded: { [Player]: boolean } = {}

local function onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not humanoid or not root then
		return
	end
	local profile = Registry.get("PlayerDataService").get(player)
	local level = profile and profile.level or 1
	humanoid.MaxHealth = 100 + (level - 1) * 5
	humanoid.Health = humanoid.MaxHealth
	humanoid.BreakJointsOnDeath = false

	local spawnAt = Registry.get("ExpeditionService").respawnPoint(player)
	task.defer(function()
		if character.Parent then
			character:PivotTo(CFrame.new(spawnAt + Vector3.new(math.random(-3, 3), 0, math.random(-3, 3))))
		end
	end)

	character:WaitForChild("RightHand", 5)
	local build = Registry.get("CombatService").buildFor(player)
	Models.katana(character, build.trailColor)
	Registry.get("CombatService").onCharacter(player, character)

	humanoid.Died:Connect(function()
		Registry.get("ProgressionService").stat(player, "deaths")
		Registry.get("ExpeditionService").onDeath(player)
		Registry.get("TrialService").fail(player, "you were defeated")
		task.delay(GameConfig.Player.RespawnDelay, function()
			if player.Parent and loaded[player] then
				player:LoadCharacter()
			end
		end)
	end)
end

local function onPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	local data = Registry.get("PlayerDataService").load(player)
	if not player.Parent or not data then
		return
	end
	loaded[player] = true
	player:LoadCharacter()
end

function SpawnService.Init() end

function SpawnService.Start()
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayer, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		loaded[player] = nil
	end)
end

return SpawnService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">TrialService</string>
            <string name="Source"><![CDATA[--!strict
-- Mastery trials (Katana Trial). Teaches the moveset: strikes, a perfect parry, a dodge,
-- and defeating a champion inside a time limit. No currency cost.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local TrialConfig = require(Config.TrialConfig)
local WorldConfig = require(Config.WorldConfig)
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)

local TrialService = {}

type Active = { id: string, deadline: number, counts: { [string]: number }, record: any?, done: boolean }
local active: { [Player]: Active } = {}

local function sync(player: Player)
	local a = active[player]
	if not a then
		Net.event("TrialSync"):FireClient(player, nil)
		return
	end
	local def = TrialConfig.Trials[a.id]
	local objectives = {}
	for _, o in def.objectives do
		table.insert(objectives, { label = o.label, count = o.count, current = math.min(o.count, a.counts[o.key] or 0) })
	end
	Net.event("TrialSync"):FireClient(player, {
		id = a.id,
		name = def.displayName,
		endsAt = workspace:GetServerTimeNow() + math.max(0, a.deadline - os.clock()),
		objectives = objectives,
	})
end

local function finish(player: Player, success: boolean, reason: string?)
	local a = active[player]
	if not a or a.done then
		return
	end
	a.done = true
	active[player] = nil
	if a.record and a.record.alive then
		Registry.get("EnemyService").despawn(a.record)
	end
	if success then
		local profile = Registry.get("PlayerDataService").get(player)
		if profile then
			profile.trials[a.id] = os.time()
			Registry.get("PlayerDataService").markDirty(player)
		end
		Registry.get("QuestService").record(player, "Trial", { id = a.id })
		Registry.get("ProgressionService").present(player, "Trial_" .. a.id, {
			title = "Trial Complete",
			subtitle = TrialConfig.Trials[a.id].displayName,
			body = TrialConfig.Trials[a.id].reward,
			color = Color3.fromRGB(120, 230, 255),
		})
		Net.event("Notify"):FireClient(player, "QuestComplete", "Katana Trial complete!")
	else
		Net.event("Notify"):FireClient(player, "Error", "Trial failed: " .. (reason or "time ran out"))
	end
	sync(player)
end

local function complete(a: Active): boolean
	local def = TrialConfig.Trials[a.id]
	for _, o in def.objectives do
		if (a.counts[o.key] or 0) < o.count then
			return false
		end
	end
	return true
end

local function spawnChampion(player: Player, a: Active)
	local def = TrialConfig.Trials[a.id]
	a.record = Registry.get("EnemyService").spawn(def.champion, WorldConfig.Points.TrainingArena + Vector3.new(0, 0, 6), {
		ownerUserId = player.UserId,
		onDeath = function()
			if active[player] ~= a then
				return
			end
			a.counts.kill = (a.counts.kill or 0) + 1
			if complete(a) then
				finish(player, true)
			else
				Net.event("Notify"):FireClient(player, "Info", "The echo reforms. Finish your remaining objectives!")
				task.delay(1.5, function()
					if active[player] == a then
						spawnChampion(player, a)
					end
				end)
			end
			sync(player)
		end,
	})
end

function TrialService.onEvent(player: Player, event: string, data: any?)
	local a = active[player]
	if not a then
		return
	end
	if event == "Hit" and data and data.weapon == "Katana" then
		a.counts.hits = (a.counts.hits or 0) + 1
	elseif event == "PerfectParry" then
		a.counts.parry = (a.counts.parry or 0) + 1
	elseif event == "DodgeTelegraph" then
		a.counts.dodge = (a.counts.dodge or 0) + 1
	else
		return
	end
	if complete(a) then
		finish(player, true)
	else
		sync(player)
	end
end

function TrialService.fail(player: Player, reason: string)
	finish(player, false, reason)
end

function TrialService.Init() end

function TrialService.Start()
	local Requests = Registry.get("RequestService")
	Requests.on("StartTrial", "Request", function(player, args)
		local def = TrialConfig.Trials[args.id or ""]
		if not def then
			return false, "Unknown trial."
		end
		if active[player] then
			return false, "You are already in a trial."
		end
		if not Registry.get("SecurityService").within(player, WorldConfig.Points.TrialPedestal, 25) then
			return false, "Start the trial at the Training Arena pedestal."
		end
		local profile = Registry.get("PlayerDataService").get(player)
		if profile.weapons[def.weapon].mastery < def.masteryRequired then
			return false, string.format("Requires %s mastery %d.", def.weapon, def.masteryRequired)
		end
		local a: Active = { id = def.id, deadline = os.clock() + def.timeLimit, counts = {}, record = nil, done = false }
		active[player] = a
		spawnChampion(player, a)
		sync(player)
		task.delay(def.timeLimit, function()
			if active[player] == a then
				finish(player, false, "time ran out")
			end
		end)
		return true, "The Echo Duel begins!"
	end)
	Requests.on("AbandonTrial", "Request", function(player, _args)
		if not active[player] then
			return false, "No active trial."
		end
		finish(player, false, "abandoned")
		return true, nil
	end)
	-- leaving the arena area fails the trial
	task.spawn(function()
		while true do
			task.wait(1)
			for player, a in active do
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if not root or (root.Position - WorldConfig.Points.TrainingArena).Magnitude > 70 then
					finish(player, false, "you left the Training Arena")
				elseif not a.done and os.clock() > a.deadline then
					finish(player, false, "time ran out")
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		local a = active[player]
		if a then
			a.done = true
			active[player] = nil
			if a.record and a.record.alive then
				Registry.get("EnemyService").despawn(a.record)
			end
		end
	end)
end

return TrialService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">WorldEventService</string>
            <string name="Source"><![CDATA[--!strict
-- Server-local world event scheduler. Exactly one event can be in Warning/Active at a time;
-- timers are server-authoritative and broadcast with absolute server timestamps.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local WorldEventConfig = require(Config.WorldEventConfig)
local WorldConfig = require(Config.WorldConfig)
local GameConfig = require(Config.GameConfig)
local Net = require(Shared.Net)
local Registry = require(script.Parent.Parent.Registry)

local WorldEventService = {}

type State = { phase: string, eventId: string?, phaseEnds: number }
local state: State = { phase = "Idle", eventId = nil, phaseEnds = 0 }
local forced: string? = nil
local spawned: { any } = {}
local spawnedEnemies: { any } = {}

local scale = if RunService:IsStudio() then GameConfig.Dev.StudioEventScale else 1

local function serverTimeFor(clockTime: number): number
	return workspace:GetServerTimeNow() + math.max(0, clockTime - os.clock())
end

local function snapshot()
	local def = state.eventId and WorldEventConfig.Events[state.eventId]
	return {
		phase = state.phase,
		id = state.eventId,
		name = def and def.displayName,
		description = def and def.description,
		color = def and def.color,
		endsAt = serverTimeFor(state.phaseEnds),
	}
end

local function updateBoard()
	local world = workspace:FindFirstChild("World")
	local board = world and world:FindFirstChild("AnnouncementBoard", true)
	local label = board and board:FindFirstChild("Text", true)
	if not label or not label:IsA("TextLabel") then
		return
	end
	local def = state.eventId and WorldEventConfig.Events[state.eventId]
	local remaining = math.max(0, math.floor(state.phaseEnds - os.clock()))
	local timeText = string.format("%d:%02d", remaining // 60, remaining % 60)
	if state.phase == "Warning" and def then
		label.Text = string.format("⚠ %s IN %s\n%s", string.upper(def.displayName), timeText, def.description)
		label.TextColor3 = def.color
	elseif state.phase == "Active" and def then
		label.Text = string.format("★ %s ACTIVE — %s left\n%s", string.upper(def.displayName), timeText, def.description)
		label.TextColor3 = def.color
	else
		label.Text = string.format("THE NEXUS\nNext rift disturbance in ~%s", timeText)
		label.TextColor3 = Color3.fromRGB(230, 225, 255)
	end
end

local function broadcast()
	Net.event("WorldEvent"):FireAllClients(snapshot())
	updateBoard()
end

local function pickEvent(): string
	local total = 0
	for _, def in WorldEventConfig.Events do
		if def.implemented then
			total += def.weight
		end
	end
	local roll = math.random() * total
	for id, def in WorldEventConfig.Events do
		if def.implemented then
			roll -= def.weight
			if roll <= 0 then
				return id
			end
		end
	end
	return "RiftSurge"
end

local function begin(id: string)
	local Resource = Registry.get("ResourceService")
	local Enemy = Registry.get("EnemyService")
	if id == "RiftSurge" then
		Enemy.setSurge(true)
		for _, p in WorldConfig.RiftCrystalSites do
			local node = Resource.spawnNode("RiftCrystal", p, { temporary = true })
			if node then
				table.insert(spawned, node)
			end
		end
	elseif id == "CrystalBloom" then
		for i, p in WorldConfig.BloomSites do
			local nodeId = if i % 2 == 0 then "CobaltCluster" else "EmberstoneDeposit"
			local node = Resource.spawnNode(nodeId, p, { temporary = true, softTier = true })
			if node then
				table.insert(spawned, node)
			end
		end
	elseif id == "EclipseHunt" then
		local site = WorldConfig.EclipseSites[math.random(1, #WorldConfig.EclipseSites)]
		local record = Enemy.spawn("EclipseStalker", site)
		if record then
			table.insert(spawnedEnemies, record)
		end
	end
	Net.event("Notify"):FireAllClients("WorldEvent", WorldEventConfig.Events[id].displayName .. " has begun!", { color = WorldEventConfig.Events[id].color })
end

local function finish(id: string)
	local Resource = Registry.get("ResourceService")
	local Enemy = Registry.get("EnemyService")
	if id == "RiftSurge" then
		Enemy.setSurge(false)
	end
	for _, node in spawned do
		Resource.removeNode(node)
	end
	spawned = {}
	for _, record in spawnedEnemies do
		if record.alive then
			Enemy.despawn(record)
		end
	end
	spawnedEnemies = {}
	Net.event("Notify"):FireAllClients("WorldEvent", WorldEventConfig.Events[id].displayName .. " has ended.")
end

-- Waits until the deadline unless an event is forced (dev). Returns true if forced.
local function waitUntil(deadline: number, interruptible: boolean): boolean
	while os.clock() < deadline do
		task.wait(1)
		updateBoard()
		if interruptible and forced then
			return true
		end
	end
	return false
end

local function loop()
	local schedule = WorldEventConfig.Schedule
	state.phase = "Idle"
	state.phaseEnds = os.clock() + schedule.firstDelay * scale
	broadcast()
	while true do
		waitUntil(state.phaseEnds, true)
		local id = forced or pickEvent()
		forced = nil
		local def = WorldEventConfig.Events[id]
		state.phase = "Warning"
		state.eventId = id
		state.phaseEnds = os.clock() + schedule.warning * scale
		broadcast()
		waitUntil(state.phaseEnds, false)
		state.phase = "Active"
		state.phaseEnds = os.clock() + def.duration * scale
		local ok, err = pcall(begin, id)
		if not ok then
			warn("[WorldEvent] begin failed: " .. tostring(err))
		end
		broadcast()
		waitUntil(state.phaseEnds, false)
		local ok2, err2 = pcall(finish, id)
		if not ok2 then
			warn("[WorldEvent] finish failed: " .. tostring(err2))
		end
		state.phase = "Idle"
		state.eventId = nil
		state.phaseEnds = os.clock() + math.random(schedule.minGap, schedule.maxGap) * scale
		broadcast()
	end
end

function WorldEventService.current()
	return snapshot()
end

function WorldEventService.Init() end

function WorldEventService.Start()
	task.spawn(loop)
	Players.PlayerAdded:Connect(function(player)
		task.delay(3, function()
			if player.Parent then
				Net.event("WorldEvent"):FireClient(player, snapshot())
			end
		end)
	end)
	Registry.get("RequestService").on("DevStartEvent", "Request", function(_player, args)
		if not (RunService:IsStudio() and GameConfig.Dev.AllowStudioCommands) then
			return false, "Dev commands are only available in Studio."
		end
		local def = WorldEventConfig.Events[args.id or ""]
		if not def or not def.implemented then
			return false, "Unknown or unimplemented event."
		end
		if state.phase ~= "Idle" then
			return false, "An event is already scheduled or running."
		end
		forced = args.id
		return true, "Event forced: " .. def.displayName
	end)
end

return WorldEventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the procedural world synchronously during Init so every later service can find
-- its stations, prompts and markers in workspace.World.

local Workspace = game:GetService("Workspace")

local Build = require(script.Parent.Parent.World.Build)
local Lighting = require(script.Parent.Parent.World.Lighting)
local Nexus = require(script.Parent.Parent.World.Nexus)
local Emberfall = require(script.Parent.Parent.World.Emberfall)
local TerrainGen = require(script.Parent.Parent.World.TerrainGen)

local WorldService = {}

function WorldService.Init()
	local existing = Workspace:FindFirstChild("World")
	if existing then
		existing:Destroy() -- a stale copy (e.g. saved into the place file) would duplicate everything
	end
	local world = Build.folder(Workspace, "World")
	Lighting.apply()
	local started = os.clock()
	Nexus.build(world)
	Emberfall.build(world)
	local ok, err = pcall(TerrainGen.build, world)
	if not ok then
		warn("[World] terrain generation failed (parts remain visible): " .. tostring(err))
	end
	-- Remove the default baseplate if the place template had one.
	local baseplate = Workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
	print(string.format("[World] built %d instances in %.2fs", #world:GetDescendants(), os.clock() - started))
end

function WorldService.Start() end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="70">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">Build</string>
            <string name="Source"><![CDATA[--!strict
-- Procedural geometry primitives. Everything is built from Parts + built-in materials so the
-- game runs with zero external assets. Swap any generator for a modelled asset later: callers
-- only depend on the returned Model/Part and its attributes.

local Build = {}

export type PartProps = {
	size: Vector3,
	cframe: CFrame,
	color: Color3?,
	material: Enum.Material?,
	name: string?,
	transparency: number?,
	shape: Enum.PartType?,
	collide: boolean?,
	query: boolean?,
	reflectance: number?,
	castShadow: boolean?,
	class: string?,
}

function Build.part(parent: Instance, p: PartProps): BasePart
	local part: BasePart
	if p.class == "WedgePart" then
		part = Instance.new("WedgePart")
	elseif p.class == "CornerWedgePart" then
		part = Instance.new("CornerWedgePart")
	else
		local basic = Instance.new("Part")
		if p.shape then
			basic.Shape = p.shape
		end
		part = basic
	end
	part.Name = p.name or "Part"
	part.Anchored = true
	part.Size = p.size
	part.CFrame = p.cframe
	part.Color = p.color or Color3.fromRGB(120, 120, 120)
	part.Material = p.material or Enum.Material.SmoothPlastic
	part.Transparency = p.transparency or 0
	part.Reflectance = p.reflectance or 0
	part.CanCollide = if p.collide == nil then true else p.collide
	part.CanQuery = if p.query == nil then true else p.query
	part.CastShadow = if p.castShadow == nil then true else p.castShadow
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

function Build.block(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, name: string?): BasePart
	return Build.part(parent, { size = size, cframe = cf, color = color, material = material, name = name })
end

-- Upright cylinder (Roblox cylinders run along X, so rotate).
function Build.cylinder(parent: Instance, diameter: number, height: number, position: Vector3, color: Color3, material: Enum.Material?, name: string?): BasePart
	return Build.part(parent, {
		size = Vector3.new(height, diameter, diameter),
		cframe = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
		color = color,
		material = material,
		shape = Enum.PartType.Cylinder,
		name = name,
	})
end

function Build.ball(parent: Instance, diameter: number, position: Vector3, color: Color3, material: Enum.Material?, name: string?): BasePart
	return Build.part(parent, {
		size = Vector3.new(diameter, diameter, diameter),
		cframe = CFrame.new(position),
		color = color,
		material = material,
		shape = Enum.PartType.Ball,
		name = name,
	})
end

function Build.neon(parent: Instance, size: Vector3, cf: CFrame, color: Color3, name: string?): BasePart
	local part = Build.part(parent, {
		size = size,
		cframe = cf,
		color = color,
		material = Enum.Material.Neon,
		name = name or "Glow",
		collide = false,
		castShadow = false,
	})
	return part
end

function Build.light(parent: Instance, color: Color3, range: number, brightness: number?)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness or 1.5
	light.Shadows = false
	light.Parent = parent
	return light
end

function Build.model(parent: Instance, name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

function Build.folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function Build.particles(parent: Instance, color: Color3, rate: number, props: any?): ParticleEmitter
	local p = props or {}
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.Rate = rate
	emitter.Lifetime = p.lifetime or NumberRange.new(1, 2)
	emitter.Speed = p.speed or NumberRange.new(1, 3)
	emitter.SpreadAngle = p.spread or Vector2.new(180, 180)
	emitter.LightEmission = p.lightEmission or 1
	emitter.Size = p.size or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = p.transparency
		or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	emitter.Acceleration = p.acceleration or Vector3.zero
	emitter.LockedToPart = p.locked or false
	emitter.Parent = parent
	return emitter
end

-- A sign with text on its front face (SurfaceGui, no assets).
function Build.sign(parent: Instance, text: string, cf: CFrame, size: Vector2, color: Color3?, textColor: Color3?): BasePart
	local board = Build.part(parent, {
		size = Vector3.new(size.X, size.Y, 0.4),
		cframe = cf,
		color = color or Color3.fromRGB(28, 30, 42),
		material = Enum.Material.SmoothPlastic,
		name = "Sign",
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(size.X * 40, size.Y * 40)
	gui.LightInfluence = 0
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(0.92, 0.84)
	label.Position = UDim2.fromScale(0.04, 0.08)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = textColor or Color3.fromRGB(255, 236, 200)
	label.Parent = gui
	return board
end

-- Floating label that always faces the camera.
function Build.label(parent: Instance, text: string, offset: Vector3, color: Color3?, maxDistance: number?)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromOffset(220, 40)
	gui.StudsOffset = offset
	gui.MaxDistance = maxDistance or 90
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
	gui.Parent = parent
	return gui
end

function Build.prompt(parent: Instance, action: string, object: string, hold: number?, distance: number?): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = distance or 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Parent = parent
	return prompt
end

-- Nature + ruins generators ------------------------------------------------------------------

local rng = Random.new(7331)
Build.rng = rng

local LEAVES_AUTUMN = {
	Color3.fromRGB(214, 104, 44),
	Color3.fromRGB(232, 150, 52),
	Color3.fromRGB(190, 70, 46),
	Color3.fromRGB(240, 186, 74),
}
local LEAVES_GREEN = { Color3.fromRGB(74, 132, 66), Color3.fromRGB(96, 150, 70), Color3.fromRGB(60, 112, 70) }

-- Broadleaf tree: tapered trunk, two branches and a clustered, colour-varied canopy.
function Build.tree(parent: Instance, position: Vector3, scale: number, autumn: boolean?)
	local model = Build.model(parent, "Tree")
	local h = 12 * scale
	local bark = Color3.fromRGB(86, 60, 44)
	Build.cylinder(model, 2.4 * scale, h * 0.55, position + Vector3.new(0, h * 0.275, 0), bark, Enum.Material.Wood, "Trunk")
	Build.cylinder(model, 1.6 * scale, h * 0.5, position + Vector3.new(0, h * 0.75, 0), bark, Enum.Material.Wood, "Trunk2")
	local palette = if autumn then LEAVES_AUTUMN else LEAVES_GREEN
	local lean = rng:NextNumber(0, math.pi * 2)
	for b = 1, 2 do
		local dir = lean + b * math.pi
		Build.part(model, {
			size = Vector3.new(0.8 * scale, 5 * scale, 0.8 * scale),
			cframe = CFrame.new(position + Vector3.new(0, h * 0.7, 0)) * CFrame.Angles(0, dir, 0) * CFrame.Angles(0, 0, math.rad(40)) * CFrame.new(0, 2 * scale, 0),
			color = bark,
			material = Enum.Material.Wood,
			name = "Branch",
		})
	end
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local spread = if i == 6 then 0 else rng:NextNumber(2.2, 3.6)
		local center = position + Vector3.new(math.cos(a) * spread * scale, h + rng:NextNumber(-1, 2.5) * scale, math.sin(a) * spread * scale)
		if i == 6 then
			center = position + Vector3.new(0, h + 3 * scale, 0)
		end
		Build.ball(model, rng:NextNumber(4.5, 6.5) * scale, center, palette[rng:NextInteger(1, #palette)], Enum.Material.Grass, "Canopy")
	end
	return model
end

-- Stylised low-poly conifer: stacked, rotated tiers.
function Build.pine(parent: Instance, position: Vector3, scale: number)
	local model = Build.model(parent, "Pine")
	Build.cylinder(model, 1.4 * scale, 5 * scale, position + Vector3.new(0, 2.5 * scale, 0), Color3.fromRGB(80, 56, 42), Enum.Material.Wood, "Trunk")
	local y = 4 * scale
	for i = 1, 4 do
		local w = (9 - i * 1.8) * scale
		local h = 3.2 * scale
		Build.part(model, {
			size = Vector3.new(w, h, w),
			cframe = CFrame.new(position + Vector3.new(0, y + h / 2, 0)) * CFrame.Angles(0, math.rad(i * 25), 0),
			color = Color3.fromRGB(46, 92 + i * 8, 60),
			material = Enum.Material.Grass,
			name = "Tier",
		})
		y += h * 0.78
	end
	return model
end

-- Small flower bed: a mossy mound with coloured blossoms.
function Build.flowers(parent: Instance, position: Vector3, r: Random)
	local model = Build.model(parent, "Flowers")
	local colors = { Color3.fromRGB(255, 120, 160), Color3.fromRGB(255, 220, 110), Color3.fromRGB(180, 140, 255), Color3.fromRGB(255, 255, 255) }
	for _ = 1, 9 do
		local p = position + Vector3.new(r:NextNumber(-3, 3), 0, r:NextNumber(-3, 3))
		Build.part(model, { size = Vector3.new(0.15, 1, 0.15), cframe = CFrame.new(p + Vector3.new(0, 0.5, 0)), color = Color3.fromRGB(70, 130, 60), material = Enum.Material.Grass, name = "Stem", collide = false })
		local bloom = Build.ball(model, 0.55, p + Vector3.new(0, 1.05, 0), colors[r:NextInteger(1, #colors)], Enum.Material.SmoothPlastic, "Bloom")
		bloom.CanCollide = false
	end
	return model
end

function Build.rock(parent: Instance, position: Vector3, scale: number, color: Color3?)
	local model = Build.model(parent, "Rock")
	local c = color or Color3.fromRGB(92, 84, 80)
	for i = 1, 3 do
		local s = Vector3.new(rng:NextNumber(3, 6), rng:NextNumber(2, 5), rng:NextNumber(3, 6)) * scale
		Build.block(
			model,
			s,
			CFrame.new(position + Vector3.new(rng:NextNumber(-2, 2) * scale, s.Y / 2 - 0.5, rng:NextNumber(-2, 2) * scale))
				* CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, math.pi), rng:NextNumber(-0.3, 0.3)),
			c,
			Enum.Material.Slate,
			"Stone" .. i
		)
	end
	return model
end

function Build.crystal(parent: Instance, position: Vector3, color: Color3, scale: number, collide: boolean?)
	local model = Build.model(parent, "Crystal")
	for _ = 1, 4 do
		local h = rng:NextNumber(3, 7) * scale
		local part = Build.part(model, {
			size = Vector3.new(1.2 * scale, h, 1.2 * scale),
			cframe = CFrame.new(position + Vector3.new(rng:NextNumber(-1.5, 1.5) * scale, h / 2 - 0.3, rng:NextNumber(-1.5, 1.5) * scale))
				* CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, math.pi), rng:NextNumber(-0.4, 0.4)),
			color = color,
			material = Enum.Material.Neon,
			collide = collide == true,
			name = "Shard",
			castShadow = false,
		})
		part.Transparency = 0.15
	end
	return model
end

function Build.wall(parent: Instance, from: Vector3, to: Vector3, height: number, thickness: number, color: Color3, material: Enum.Material?, ruined: boolean?)
	local delta = to - from
	local length = Vector3.new(delta.X, 0, delta.Z).Magnitude
	local mid = (from + to) / 2
	local cf = CFrame.lookAt(Vector3.new(mid.X, from.Y + height / 2, mid.Z), Vector3.new(to.X, from.Y + height / 2, to.Z))
	if not ruined then
		return Build.block(parent, Vector3.new(thickness, height, length), cf, color, material or Enum.Material.Cobblestone, "Wall")
	end
	-- ruined: segmented, uneven heights
	local model = Build.model(parent, "RuinedWall")
	local segments = math.max(1, math.floor(length / 6))
	for i = 1, segments do
		local segLen = length / segments
		local h = height * rng:NextNumber(0.35, 1)
		local offset = -length / 2 + segLen * (i - 0.5)
		Build.block(model, Vector3.new(thickness, h, segLen - 0.2), cf * CFrame.new(0, (h - height) / 2, offset), color, material or Enum.Material.Cobblestone, "Segment")
	end
	return model
end

function Build.torch(parent: Instance, position: Vector3, color: Color3?)
	local model = Build.model(parent, "Torch")
	Build.cylinder(model, 0.6, 5, position + Vector3.new(0, 2.5, 0), Color3.fromRGB(60, 46, 36), Enum.Material.Wood, "Pole")
	local flame = Build.neon(model, Vector3.new(0.9, 1.2, 0.9), CFrame.new(position + Vector3.new(0, 5.4, 0)), color or Color3.fromRGB(255, 150, 60), "Flame")
	Build.light(flame, color or Color3.fromRGB(255, 160, 80), 18, 1.6)
	Build.particles(flame, color or Color3.fromRGB(255, 140, 50), 6, {
		speed = NumberRange.new(1, 2),
		spread = Vector2.new(10, 10),
		acceleration = Vector3.new(0, 4, 0),
		lifetime = NumberRange.new(0.5, 1),
	})
	return model
end

return Build
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">Emberfall</string>
            <string name="Source"><![CDATA[--!strict
-- EMBERFALL FRONTIER: camp (safe) -> forest & ruined outpost (depth 1) -> hidden Sunfall
-- Chamber -> Cinder Ravine traversal (pillar route / ledge route / drawbridge shortcut) ->
-- Ruined Keep interior (depth 2, Ashen Sentinel) -> Warden's Approach -> Fracture Arena (depth 3).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local WorldConfig = require(Shared.Config.WorldConfig)
local Build = require(script.Parent.Build)

local Emberfall = {}

local E = WorldConfig.EmberfallOrigin
local P = WorldConfig.Points

local function at(x: number, z: number, y: number?): Vector3
	return E + Vector3.new(x, y or 0, z)
end

local GRASS = Color3.fromRGB(128, 106, 62)
local DIRT = Color3.fromRGB(112, 82, 56)
local CLIFF = Color3.fromRGB(92, 70, 60)
local KEEP = Color3.fromRGB(78, 74, 84)
local KEEP_DARK = Color3.fromRGB(46, 42, 52)
local LAVA = Color3.fromRGB(255, 90, 30)
local RIFT = Color3.fromRGB(255, 60, 150)

local function box(parent: Instance, x1: number, x2: number, z1: number, z2: number, y1: number, y2: number, color: Color3, material: Enum.Material, name: string): BasePart
	local size = Vector3.new(math.abs(x2 - x1), math.abs(y2 - y1), math.abs(z2 - z1))
	return Build.block(parent, size, CFrame.new(at((x1 + x2) / 2, (z1 + z2) / 2, (y1 + y2) / 2)), color, material, name)
end

local function holder(parent: Instance, name: string, position: Vector3, action: string, object: string, hold: number?): BasePart
	local part = Build.part(parent, {
		size = Vector3.new(3, 5, 3),
		cframe = CFrame.new(position + Vector3.new(0, 2.5, 0)),
		transparency = 1,
		collide = false,
		name = name,
	})
	Build.prompt(part, action, object, hold or 0, 12)
	return part
end

local function signFacing(parent: Instance, text: string, position: Vector3, toward: Vector3, size: Vector2, textColor: Color3?)
	return Build.sign(parent, text, CFrame.lookAt(position, Vector3.new(toward.X, position.Y, toward.Z)), size, Color3.fromRGB(34, 26, 24), textColor)
end

local function beacon(parent: Instance, name: string, position: Vector3, color: Color3, action: string, object: string, hold: number)
	local model = Build.model(parent, name .. "Model")
	Build.cylinder(model, 5, 2, position + Vector3.new(0, 1, 0), KEEP_DARK, Enum.Material.Slate, "Base")
	Build.part(model, { size = Vector3.new(1.6, 9, 1.6), cframe = CFrame.new(position + Vector3.new(0, 6.5, 0)), color = KEEP, material = Enum.Material.Slate, name = "Spire" })
	local crystal = Build.part(model, {
		size = Vector3.new(2.2, 3.2, 2.2),
		cframe = CFrame.new(position + Vector3.new(0, 12.5, 0)) * CFrame.Angles(0, math.rad(45), 0),
		color = color,
		material = Enum.Material.Neon,
		collide = false,
		name = "BeaconCrystal",
	})
	crystal:SetAttribute("Spin", 1)
	Build.light(crystal, color, 26, 2.5)
	Build.particles(crystal, color, 10, { acceleration = Vector3.new(0, 6, 0), speed = NumberRange.new(1, 2) })
	Build.label(crystal, "EXTRACTION", Vector3.new(0, 3.5, 0), color, 160)
	holder(model, name, position, action, object, hold)
end

-- Ground, boundaries --------------------------------------------------------------------------

local function terrain(parent: Instance)
	box(parent, -44, 262, -100, 100, -4, 0, GRASS, Enum.Material.Grass, "FrontierGround")
	Build.part(parent, { size = Vector3.new(306, 0.2, 12), cframe = CFrame.new(at(109, 0, 0.1)), color = DIRT, material = Enum.Material.Ground, name = "Trail", castShadow = false })
	box(parent, 340, 545, -100, 100, -4, 0, Color3.fromRGB(74, 64, 60), Enum.Material.Slate, "KeepGround")
	-- north cliff with the Sunfall doorway gap (x 194..206)
	box(parent, -44, 194, -108, -100, 0, 36, CLIFF, Enum.Material.Slate, "NorthCliff")
	box(parent, 206, 262, -108, -100, 0, 36, CLIFF, Enum.Material.Slate, "NorthCliff")
	box(parent, 194, 206, -108, -100, 18, 36, CLIFF, Enum.Material.Slate, "DoorLintel")
	box(parent, -44, 262, 100, 108, 0, 36, CLIFF, Enum.Material.Slate, "SouthCliff")
	box(parent, -52, -44, -108, 108, 0, 36, CLIFF, Enum.Material.Slate, "WestCliff")
	-- ravine cliffs and faces
	box(parent, 262, 340, -108, -100, -32, 36, CLIFF, Enum.Material.Slate, "RavineNorth")
	box(parent, 262, 340, 100, 108, -32, 36, CLIFF, Enum.Material.Slate, "RavineSouth")
	box(parent, 260, 262, -100, 100, -32, 0, Color3.fromRGB(70, 46, 36), Enum.Material.Basalt, "RavineFaceW")
	box(parent, 340, 342, -100, 100, -32, 0, Color3.fromRGB(70, 46, 36), Enum.Material.Basalt, "RavineFaceE")
	-- keep surroundings
	box(parent, 340, 545, -108, -100, 0, 36, CLIFF, Enum.Material.Slate, "KeepNorth")
	box(parent, 340, 545, 100, 108, 0, 36, CLIFF, Enum.Material.Slate, "KeepSouth")
	box(parent, 545, 553, -108, -12, 0, 36, CLIFF, Enum.Material.Slate, "KeepEast")
	box(parent, 545, 553, 12, 108, 0, 36, CLIFF, Enum.Material.Slate, "KeepEast")
	-- jagged cliff tops for silhouette
	for i = 1, 40 do
		local x = Build.rng:NextNumber(-40, 540)
		local z = if i % 2 == 0 then -104 else 104
		Build.part(parent, {
			size = Vector3.new(Build.rng:NextNumber(8, 16), Build.rng:NextNumber(6, 16), 8),
			cframe = CFrame.new(at(x, z, 38)) * CFrame.Angles(0, Build.rng:NextNumber(0, math.pi), 0),
			color = CLIFF:Lerp(Color3.new(0, 0, 0), 0.15),
			material = Enum.Material.Slate,
			class = "WedgePart",
			name = "CliffSpike",
		})
	end
end

-- Camp ---------------------------------------------------------------------------------------

local function tent(parent: Instance, position: Vector3, yaw: number, color: Color3)
	local cf = CFrame.new(position) * CFrame.Angles(0, math.rad(yaw), 0)
	Build.part(parent, { size = Vector3.new(8, 6, 5), cframe = cf * CFrame.new(0, 3, 2.5), color = color, material = Enum.Material.Fabric, class = "WedgePart", name = "TentSide" })
	Build.part(parent, { size = Vector3.new(8, 6, 5), cframe = cf * CFrame.new(0, 3, -2.5) * CFrame.Angles(0, math.rad(180), 0), color = color, material = Enum.Material.Fabric, class = "WedgePart", name = "TentSide" })
end

local function camp(parent: Instance)
	local model = Build.model(parent, "Camp")
	tent(model, at(-12, -34), 20, Color3.fromRGB(150, 70, 50))
	tent(model, at(8, -40), -10, Color3.fromRGB(70, 100, 140))
	tent(model, at(-18, 32), 160, Color3.fromRGB(120, 110, 70))
	-- campfire
	local fire = at(4, -20)
	for i = 1, 4 do
		Build.part(model, { size = Vector3.new(0.8, 0.8, 4), cframe = CFrame.new(fire + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, i * math.pi / 4, 0), color = Color3.fromRGB(70, 46, 30), material = Enum.Material.Wood, name = "Log" })
	end
	local flame = Build.neon(model, Vector3.new(1.6, 2.4, 1.6), CFrame.new(fire + Vector3.new(0, 1.6, 0)), Color3.fromRGB(255, 140, 50), "CampFlame")
	Build.light(flame, Color3.fromRGB(255, 150, 70), 34, 2.5)
	Build.particles(flame, Color3.fromRGB(255, 140, 50), 14, { acceleration = Vector3.new(0, 7, 0), spread = Vector2.new(15, 15) })
	for i = 1, 6 do
		Build.block(model, Vector3.new(3, 3, 3), CFrame.new(at(-30 + i * 2.5, 40 + (i % 2) * 3, 1.5)) * CFrame.Angles(0, i, 0), Color3.fromRGB(120, 90, 60), Enum.Material.WoodPlanks, "Crate")
	end
	-- palisade with a gap for the trail
	for z = -60, 60, 4 do
		if math.abs(z) > 10 then
			Build.part(model, { size = Vector3.new(1.4, 7, 1.4), cframe = CFrame.new(at(58, z, 3.5)) * CFrame.Angles(0, 0, math.rad((z % 8) - 4)), color = Color3.fromRGB(96, 70, 48), material = Enum.Material.Wood, name = "Stake" })
		end
	end
	beacon(model, "CampBeacon", P.CampBeacon, Color3.fromRGB(110, 255, 210), "Extract", "Bank your Satchel", 1)
	-- return portal
	local portal = P.CampReturnPortal
	for i = 1, 16 do
		local angle = i / 16 * math.pi * 2
		Build.part(model, {
			size = Vector3.new(1.4, 1.6, 1.6),
			cframe = CFrame.new(portal + Vector3.new(0, 7 + math.sin(angle) * 6, math.cos(angle) * 6)) * CFrame.Angles(angle, 0, 0),
			color = Color3.fromRGB(170, 110, 255),
			material = Enum.Material.Neon,
			name = "PortalStone",
			collide = false,
		})
	end
	local disc = Build.part(model, { size = Vector3.new(0.3, 11, 11), cframe = CFrame.new(portal + Vector3.new(0, 7, 0)), color = Color3.fromRGB(150, 100, 255), material = Enum.Material.Neon, shape = Enum.PartType.Cylinder, collide = false, name = "PortalSurface" })
	disc.Transparency = 0.4
	Build.light(disc, Color3.fromRGB(170, 120, 255), 24, 2)
	holder(model, "CampReturnPortal", portal + Vector3.new(3, 0, 0), "Return", "Nexus (banks your Satchel)", 0.5)
	signFacing(model, "EMBERFALL CAMP\nSAFE ZONE", at(40, -14, 6), at(0, -14), Vector2.new(10, 3.5), Color3.fromRGB(150, 255, 200))
	signFacing(model, "FRONTIER AHEAD\nDEPTH 1 • 25% SATCHEL RISK", at(60, 14, 6), at(0, 14), Vector2.new(12, 3.5), Color3.fromRGB(255, 180, 120))
end

-- Frontier -------------------------------------------------------------------------------------

local function clearOf(x: number, z: number): boolean
	if math.abs(z) < 12 then
		return false
	end
	if x > 142 and x < 210 and math.abs(z) < 34 then
		return false
	end
	if x > 176 and x < 224 and z < -82 then
		return false
	end
	local p = at(x, z)
	for _, placement in WorldConfig.Nodes do
		if (placement.position - p).Magnitude < 9 then
			return false
		end
	end
	for _, spawner in WorldConfig.Spawners do
		if (spawner.position - p).Magnitude < 7 then
			return false
		end
	end
	for _, b in WorldConfig.Braziers do
		if (b.position - p).Magnitude < 10 then
			return false
		end
	end
	for _, site in WorldConfig.RiftCrystalSites do
		if (site - p).Magnitude < 7 then
			return false
		end
	end
	for _, site in WorldConfig.BloomSites do
		if (site - p).Magnitude < 7 then
			return false
		end
	end
	return true
end

local function frontier(parent: Instance)
	local model = Build.model(parent, "Frontier")
	local rng = Random.new(2024)
	local placed = 0
	local attempts = 0
	while placed < 60 and attempts < 600 do
		attempts += 1
		local x = rng:NextNumber(66, 256)
		local z = rng:NextNumber(-94, 94)
		if clearOf(x, z) then
			placed += 1
			if placed % 3 == 0 then
				Build.rock(model, at(x, z), rng:NextNumber(0.8, 1.6), CLIFF)
			else
				if placed % 5 == 1 then
					Build.pine(model, at(x, z), rng:NextNumber(0.9, 1.3))
				else
					Build.tree(model, at(x, z), rng:NextNumber(0.9, 1.4), true)
				end
			end
		end
	end
	-- glowing rift cracks in the ground (environmental storytelling)
	for _ = 1, 10 do
		local x, z = rng:NextNumber(70, 250), rng:NextNumber(-90, 90)
		if clearOf(x, z) then
			Build.neon(model, Vector3.new(0.5, 0.1, rng:NextNumber(6, 14)), CFrame.new(at(x, z, 0.06)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), Color3.fromRGB(200, 90, 255), "RiftCrack")
		end
	end
	-- ruined outpost
	local outpost = Build.model(model, "RuinedOutpost")
	local stone = Color3.fromRGB(120, 110, 100)
	Build.wall(outpost, at(148, -28), at(148, -8), 9, 2, stone, Enum.Material.Cobblestone, true)
	Build.wall(outpost, at(148, 8), at(148, 28), 9, 2, stone, Enum.Material.Cobblestone, true)
	Build.wall(outpost, at(204, -28), at(204, -8), 9, 2, stone, Enum.Material.Cobblestone, true)
	Build.wall(outpost, at(204, 8), at(204, 28), 9, 2, stone, Enum.Material.Cobblestone, true)
	Build.wall(outpost, at(148, -28), at(170, -28), 9, 2, stone, Enum.Material.Cobblestone, true)
	Build.wall(outpost, at(182, -28), at(204, -28), 9, 2, stone, Enum.Material.Cobblestone, true)
	Build.wall(outpost, at(148, 28), at(204, 28), 9, 2, stone, Enum.Material.Cobblestone, true)
	-- watchtower
	local tower = at(196, 20)
	for _, o in { Vector3.new(-3, 0, -3), Vector3.new(3, 0, -3), Vector3.new(-3, 0, 3), Vector3.new(3, 0, 3) } do
		Build.block(outpost, Vector3.new(1, 14, 1), CFrame.new(tower + o + Vector3.new(0, 7, 0)), Color3.fromRGB(90, 66, 46), Enum.Material.Wood, "TowerPost")
	end
	Build.block(outpost, Vector3.new(8, 1, 8), CFrame.new(tower + Vector3.new(0, 12, 0)), Color3.fromRGB(110, 80, 56), Enum.Material.WoodPlanks, "TowerDeck")
	Build.part(outpost, { size = Vector3.new(9, 3, 9), cframe = CFrame.new(tower + Vector3.new(0, 16, 0)), color = Color3.fromRGB(140, 60, 40), material = Enum.Material.Fabric, name = "TowerRoof" })
	Build.torch(outpost, at(150, -10), Color3.fromRGB(255, 150, 70))
	Build.torch(outpost, at(150, 10), Color3.fromRGB(255, 150, 70))
	signFacing(outpost, "OLD WATCH OUTPOST", at(146, 14, 7), at(100, 14), Vector2.new(9, 2), Color3.fromRGB(255, 220, 180))
end

-- Sunfall secret ---------------------------------------------------------------------------------

local function brazier(parent: Instance, info: any)
	local model = Build.model(parent, "Brazier_" .. info.id)
	local p = info.position
	Build.cylinder(model, 4, 3, p + Vector3.new(0, 1.5, 0), Color3.fromRGB(70, 64, 60), Enum.Material.Slate, "Pedestal")
	Build.cylinder(model, 5.5, 1, p + Vector3.new(0, 3.5, 0), Color3.fromRGB(50, 46, 44), Enum.Material.Metal, "Bowl")
	local flame = Build.neon(model, Vector3.new(2, 2.6, 2), CFrame.new(p + Vector3.new(0, 5.3, 0)), Color3.fromRGB(255, 170, 70), "Flame")
	flame.Transparency = 1
	local light = Build.light(flame, Color3.fromRGB(255, 170, 70), 22, 2.5)
	light.Enabled = false
	local emitter = Build.particles(flame, Color3.fromRGB(255, 160, 60), 12, { acceleration = Vector3.new(0, 6, 0), spread = Vector2.new(15, 15) })
	emitter.Enabled = false
	Build.label(model:FindFirstChild("Pedestal") :: BasePart, info.symbol, Vector3.new(0, 6.5, 0), Color3.fromRGB(255, 230, 160), 70)
	holder(model, "BrazierHolder_" .. info.id, p, "Kindle", "Brazier of the " .. info.id, 0.6)
end

local function sunfall(parent: Instance)
	local model = Build.model(parent, "Sunfall")
	for _, b in WorldConfig.Braziers do
		brazier(model, b)
	end
	-- mural on the cliff face, beside the cracked wall
	local mural = Build.part(model, {
		size = Vector3.new(10, 8, 1),
		cframe = CFrame.new(P.SunfallMural + Vector3.new(0, 5, -2.5)),
		color = Color3.fromRGB(150, 130, 110),
		material = Enum.Material.Sandstone,
		name = "MuralStone",
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.CanvasSize = Vector2.new(400, 320)
	gui.LightInfluence = 0.4
	gui.Parent = mural
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "☾   ☀   ✦\n\nThree flames remember\nthe order of the sky."
	label.TextScaled = true
	label.Font = Enum.Font.Fantasy
	label.TextColor3 = Color3.fromRGB(70, 40, 20)
	label.Parent = gui
	holder(model, "SunfallMural", P.SunfallMural, "Read", "Ancient Mural", 0)
	-- the cracked wall (slides down when solved)
	local wall = Build.block(model, Vector3.new(12, 18, 4), CFrame.new(at(200, -102, 9)), Color3.fromRGB(112, 92, 80), Enum.Material.Rock, "SunfallWall")
	wall:SetAttribute("ClosedCFrame", wall.CFrame)
	for i = 1, 3 do
		Build.neon(model, Vector3.new(0.2, 4 + i, 0.1), CFrame.new(at(196 + i * 2, -99.9, 6 + i)) * CFrame.Angles(0, 0, math.rad(20 * i - 40)), Color3.fromRGB(255, 200, 100), "Crack")
	end
	-- chamber interior (x 186..214, z -132..-104)
	box(model, 186, 214, -132, -104, -1, 0, Color3.fromRGB(150, 120, 80), Enum.Material.Sandstone, "ChamberFloor")
	box(model, 184, 186, -134, -100, 0, 24, Color3.fromRGB(120, 96, 70), Enum.Material.Sandstone, "ChamberWall")
	box(model, 214, 216, -134, -100, 0, 24, Color3.fromRGB(120, 96, 70), Enum.Material.Sandstone, "ChamberWall")
	box(model, 184, 216, -134, -132, 0, 24, Color3.fromRGB(120, 96, 70), Enum.Material.Sandstone, "ChamberWall")
	box(model, 184, 216, -134, -100, 18, 20, Color3.fromRGB(90, 70, 50), Enum.Material.Sandstone, "ChamberCeiling")
	for i = 1, 6 do
		local glyph = Build.neon(model, Vector3.new(0.2, 2, 2), CFrame.new(at(if i % 2 == 0 then 186.2 else 213.8, -106 - i * 4, 8)), Color3.fromRGB(255, 200, 90), "Glyph")
		glyph.Transparency = 0.2
	end
	local t = P.SunfallTablet
	Build.cylinder(model, 4, 3, t + Vector3.new(0, 1.5, 0), Color3.fromRGB(80, 60, 40), Enum.Material.Sandstone, "TabletBase")
	local slab = Build.neon(model, Vector3.new(4, 5, 0.6), CFrame.new(t + Vector3.new(0, 5.5, 0)), Color3.fromRGB(255, 210, 110), "TabletSlab")
	Build.light(slab, Color3.fromRGB(255, 200, 110), 30, 2.5)
	holder(model, "SunfallTablet", t, "Read", "Sunfall Tablet", 1.2)
	local c = P.SunfallChest
	Build.block(model, Vector3.new(4, 2.5, 3), CFrame.new(c + Vector3.new(0, 1.25, 0)), Color3.fromRGB(110, 70, 40), Enum.Material.WoodPlanks, "Cache")
	Build.neon(model, Vector3.new(4.1, 0.3, 3.1), CFrame.new(c + Vector3.new(0, 2.2, 0)), Color3.fromRGB(255, 210, 110), "CacheTrim")
	holder(model, "SunfallChest", c, "Open", "Forgotten Cache", 0.8)
end

-- Ravine -----------------------------------------------------------------------------------------

local function ravine(parent: Instance)
	local model = Build.model(parent, "CinderRavine")
	local lava = box(model, 262, 340, -100, 100, -33, -30, LAVA, Enum.Material.Neon, "Lava")
	lava:SetAttribute("Lava", true)
	for i = 1, 5 do
		local glow = Build.part(model, { size = Vector3.new(2, 2, 2), cframe = CFrame.new(at(270 + i * 13, (i % 2) * 40 - 20, -28)), transparency = 1, collide = false, name = "LavaGlow" })
		Build.light(glow, Color3.fromRGB(255, 110, 40), 60, 3)
		Build.particles(glow, Color3.fromRGB(255, 120, 40), 8, { acceleration = Vector3.new(0, 10, 0), speed = NumberRange.new(2, 6), lifetime = NumberRange.new(1.5, 3) })
	end
	-- main route: basalt pillars
	local pillars = { { 272, 0, 0 }, { 283, 3, 1 }, { 294, -3, 2 }, { 305, 2, 1.5 }, { 316, -2, 0.5 }, { 327, 0, 0 } }
	for i, p in pillars do
		local top = p[3]
		local h = top + 31
		Build.block(model, Vector3.new(5.5, h, 5.5), CFrame.new(at(p[1], p[2], top - h / 2)), Color3.fromRGB(60, 46, 44), Enum.Material.Basalt, "Pillar" .. i)
		Build.neon(model, Vector3.new(5.6, 0.15, 5.6), CFrame.new(at(p[1], p[2], top - 0.5)), Color3.fromRGB(255, 120, 50), "PillarGlow")
	end
	-- ledge route (south, longer)
	for _, seg in { { 262, 283 }, { 287, 309 }, { 313, 340 } } do
		box(model, seg[1], seg[2], 82, 87, -2, 0, Color3.fromRGB(90, 70, 60), Enum.Material.Slate, "Ledge")
	end
	-- drawbridge shortcut (lowered by the lever on the far side)
	local hinge = at(340, -30, -0.75)
	local down = CFrame.new(hinge) * CFrame.new(-39, 0, 0)
	-- Raised = folded away under the far ledge and invisible; lowering it slides it into place.
	local up = down * CFrame.new(39, -6, 0)
	local bridge = Build.block(model, Vector3.new(78, 1.5, 10), up, Color3.fromRGB(100, 72, 50), Enum.Material.WoodPlanks, "Drawbridge")
	bridge.CanCollide = false
	bridge.Transparency = 1
	bridge:SetAttribute("DownCFrame", down)
	bridge:SetAttribute("UpCFrame", up)
	local lever = P.ShortcutLever
	Build.block(model, Vector3.new(2, 3, 2), CFrame.new(lever + Vector3.new(0, 1.5, 0)), KEEP_DARK, Enum.Material.Metal, "LeverBase")
	Build.neon(model, Vector3.new(0.4, 3, 0.4), CFrame.new(lever + Vector3.new(0, 4, 0)) * CFrame.Angles(0, 0, math.rad(30)), Color3.fromRGB(255, 200, 80), "LeverHandle")
	holder(model, "ShortcutLever", lever, "Pull", "Drawbridge Lever", 0.8)
	signFacing(model, "CINDER RAVINE\nJump the pillars or take the south ledge", at(256, 16, 6), at(200, 16), Vector2.new(12, 3), Color3.fromRGB(255, 170, 110))
end

-- Keep --------------------------------------------------------------------------------------------

local function keep(parent: Instance)
	local model = Build.model(parent, "RuinedKeep")
	box(model, 342, 538, -48, 48, 0, 0.2, Color3.fromRGB(60, 56, 64), Enum.Material.Slate, "KeepFloor")
	-- perimeter walls (gates at z -7..7 on west and east)
	box(model, 340, 344, -52, -7, 0, 30, KEEP, Enum.Material.Cobblestone, "KeepWall")
	box(model, 340, 344, 7, 52, 0, 30, KEEP, Enum.Material.Cobblestone, "KeepWall")
	box(model, 340, 344, -7, 7, 14, 30, KEEP, Enum.Material.Cobblestone, "GateLintel")
	box(model, 536, 540, -52, -7, 0, 30, KEEP, Enum.Material.Cobblestone, "KeepWall")
	box(model, 536, 540, 7, 52, 0, 30, KEEP, Enum.Material.Cobblestone, "KeepWall")
	box(model, 536, 540, -7, 7, 14, 30, KEEP, Enum.Material.Cobblestone, "GateLintel")
	box(model, 340, 540, -52, -48, 0, 30, KEEP, Enum.Material.Cobblestone, "KeepWall")
	box(model, 340, 540, 48, 52, 0, 30, KEEP, Enum.Material.Cobblestone, "KeepWall")
	box(model, 338, 542, -54, 54, 30, 32, KEEP_DARK, Enum.Material.Slate, "KeepRoof")
	-- inner walls: hall | corridor | court
	box(model, 419, 421, -48, -8, 0, 30, KEEP, Enum.Material.Cobblestone, "InnerWall")
	box(model, 419, 421, 8, 48, 0, 30, KEEP, Enum.Material.Cobblestone, "InnerWall")
	box(model, 449, 451, -48, -10, 0, 30, KEEP, Enum.Material.Cobblestone, "InnerWall")
	box(model, 449, 451, 10, 48, 0, 30, KEEP, Enum.Material.Cobblestone, "InnerWall")
	box(model, 421, 449, -10, -8, 0, 30, KEEP, Enum.Material.Cobblestone, "CorridorWall")
	box(model, 421, 449, 8, 10, 0, 30, KEEP, Enum.Material.Cobblestone, "CorridorWall")
	-- hall pillars
	for _, x in { 362, 392 } do
		for _, z in { -26, 26 } do
			Build.cylinder(model, 4, 30, at(x, z, 15), KEEP_DARK, Enum.Material.Cobblestone, "Pillar")
		end
	end
	-- torches & rune lights
	for _, p in { { 350, -44 }, { 350, 44 }, { 412, -44 }, { 412, 44 }, { 435, 6 }, { 458, -44 }, { 458, 44 }, { 534, -44 }, { 512, 45 } } do
		Build.torch(model, at(p[1], p[2]), Color3.fromRGB(150, 140, 255))
	end
	local rune = Build.cylinder(model, 30, 0.1, at(496, 0, 0.26), Color3.fromRGB(170, 120, 255), Enum.Material.Neon, "SentinelRune")
	rune.Transparency = 0.6
	rune.CanCollide = false
	Build.light(Build.part(model, { size = Vector3.new(1, 1, 1), cframe = CFrame.new(at(496, 0, 20)), transparency = 1, collide = false, name = "CourtLight" }), Color3.fromRGB(170, 130, 255), 50, 1.5)
	-- debris
	for i = 1, 12 do
		Build.rock(model, at(Build.rng:NextNumber(350, 530), if i % 2 == 0 then Build.rng:NextNumber(30, 44) else Build.rng:NextNumber(-44, -30)), 0.6, KEEP)
	end
	beacon(model, "KeepBeacon", P.KeepBeacon, Color3.fromRGB(90, 220, 255), "Extract", "Keep Beacon (deep extraction)", 4)
	signFacing(model, "THE RUINED KEEP\nDEPTH 2 • DROPS x1.3", at(336, 12, 18), at(300, 12), Vector2.new(12, 3.5), Color3.fromRGB(190, 180, 255))
	signFacing(model, "SENTINEL'S COURT", at(452, 14, 14), at(430, 14), Vector2.new(8, 2), Color3.fromRGB(210, 180, 255))
end

-- Approach & Arena -----------------------------------------------------------------------------

local function arena(parent: Instance)
	local model = Build.model(parent, "FractureArena")
	box(model, 545, 580, -12, 12, -4, 0, Color3.fromRGB(44, 36, 54), Enum.Material.Basalt, "Walkway")
	box(model, 545, 580, -12.5, -11.5, 0, 3, KEEP_DARK, Enum.Material.Slate, "Parapet")
	box(model, 545, 580, 11.5, 12.5, 0, 3, KEEP_DARK, Enum.Material.Slate, "Parapet")
	for _, x in { 552, 566 } do
		for _, z in { -10.5, 10.5 } do
			local obelisk = Build.part(model, { size = Vector3.new(1.6, 12, 1.6), cframe = CFrame.new(at(x, z, 6)) * CFrame.Angles(0, math.rad(45), 0), color = RIFT, material = Enum.Material.Neon, name = "Obelisk" })
			Build.light(obelisk, RIFT, 16, 1.2)
		end
	end
	-- seal
	local seal = P.ArenaSeal + Vector3.new(0, 0, -8)
	Build.cylinder(model, 4, 3, seal + Vector3.new(0, 1.5, 0), KEEP_DARK, Enum.Material.Slate, "SealBase")
	local sealCrystal = Build.part(model, { size = Vector3.new(2, 4, 2), cframe = CFrame.new(seal + Vector3.new(0, 5.5, 0)) * CFrame.Angles(0, math.rad(45), 0), color = RIFT, material = Enum.Material.Neon, collide = false, name = "SealCrystal" })
	sealCrystal:SetAttribute("Spin", 1.5)
	Build.label(sealCrystal, "FRACTURE SEAL", Vector3.new(0, 4, 0), RIFT, 120)
	holder(model, "WardenSeal", seal, "Break the Seal", "Challenge the Fracture Warden", 1.5)
	signFacing(model, "FRACTURE ARENA\nDEPTH 3 • DROPS x1.6", at(574, 11, 10), at(540, 11), Vector2.new(10, 3), Color3.fromRGB(255, 140, 200))

	-- arena tiles
	local c = WorldConfig.Arena.center
	local size = WorldConfig.Arena.size
	local n = WorldConfig.Arena.tiles
	local tile = size / n
	for ix = 0, n - 1 do
		for iz = 0, n - 1 do
			local x = c.X - size / 2 + tile * (ix + 0.5)
			local z = c.Z - size / 2 + tile * (iz + 0.5)
			local shade = if (ix + iz) % 2 == 0 then Color3.fromRGB(40, 34, 52) else Color3.fromRGB(54, 46, 68)
			Build.block(model, Vector3.new(tile - 0.4, 4, tile - 0.4), CFrame.new(Vector3.new(x, c.Y - 2, z)), shade, Enum.Material.Basalt, "ArenaTile")
		end
	end
	for i = 0, n do
		local offset = -size / 2 + tile * i
		Build.neon(model, Vector3.new(0.4, 0.1, size), CFrame.new(c + Vector3.new(offset, 0.02, 0)), Color3.fromRGB(150, 60, 220), "Seam")
		Build.neon(model, Vector3.new(size, 0.1, 0.4), CFrame.new(c + Vector3.new(0, 0.02, offset)), Color3.fromRGB(150, 60, 220), "Seam")
	end
	-- parapets (west edge open around the entrance)
	local half = size / 2
	Build.block(model, Vector3.new(size, 3, 1), CFrame.new(c + Vector3.new(0, 1.5, -half)), KEEP_DARK, Enum.Material.Slate, "ArenaParapet")
	Build.block(model, Vector3.new(size, 3, 1), CFrame.new(c + Vector3.new(0, 1.5, half)), KEEP_DARK, Enum.Material.Slate, "ArenaParapet")
	Build.block(model, Vector3.new(1, 3, size), CFrame.new(c + Vector3.new(half, 1.5, 0)), KEEP_DARK, Enum.Material.Slate, "ArenaParapet")
	Build.block(model, Vector3.new(1, 3, half - 12), CFrame.new(c + Vector3.new(-half, 1.5, -(half + 12) / 2)), KEEP_DARK, Enum.Material.Slate, "ArenaParapet")
	Build.block(model, Vector3.new(1, 3, half - 12), CFrame.new(c + Vector3.new(-half, 1.5, (half + 12) / 2)), KEEP_DARK, Enum.Material.Slate, "ArenaParapet")
	-- barrier (closed during the encounter)
	local barrier = Build.model(model, "ArenaBarrier")
	for _, spec in {
		{ Vector3.new(1, 40, size), Vector3.new(-half, 20, 0) },
		{ Vector3.new(1, 40, size), Vector3.new(half, 20, 0) },
		{ Vector3.new(size, 40, 1), Vector3.new(0, 20, -half) },
		{ Vector3.new(size, 40, 1), Vector3.new(0, 20, half) },
	} do
		local wall = Build.part(barrier, { size = spec[1], cframe = CFrame.new(c + spec[2]), color = RIFT, material = Enum.Material.ForceField, collide = false, name = "Barrier", castShadow = false })
		wall.Transparency = 1
	end
	-- corner pylons
	for _, corner in { Vector3.new(-half, 0, -half), Vector3.new(half, 0, -half), Vector3.new(-half, 0, half), Vector3.new(half, 0, half) } do
		Build.crystal(model, c + corner * 0.92, Color3.fromRGB(170, 90, 255), 2.4)
	end
	-- floating ruins around the platform (silhouette)
	for i = 1, 10 do
		local angle = i / 10 * math.pi * 2
		Build.part(model, {
			size = Vector3.new(Build.rng:NextNumber(8, 16), Build.rng:NextNumber(4, 10), Build.rng:NextNumber(8, 16)),
			cframe = CFrame.new(c + Vector3.new(math.cos(angle) * 95, Build.rng:NextNumber(-10, 30), math.sin(angle) * 95)) * CFrame.Angles(Build.rng:NextNumber(0, 1), Build.rng:NextNumber(0, 3), 0),
			color = Color3.fromRGB(50, 42, 60),
			material = Enum.Material.Basalt,
			name = "FloatingRuin",
		})
	end
	for i = 1, 8 do
		local angle = i / 8 * math.pi * 2
		Build.part(model, {
			size = Vector3.new(24, 30, 24),
			cframe = CFrame.new(c + Vector3.new(math.cos(angle) * 40, -20, math.sin(angle) * 40)) * CFrame.Angles(0, angle, math.rad(180)),
			color = Color3.fromRGB(40, 34, 48),
			material = Enum.Material.Basalt,
			class = "WedgePart",
			name = "Underside",
		})
	end
	-- retreat & victory beacon
	local retreat = P.ArenaRetreat
	Build.cylinder(model, 6, 0.4, retreat + Vector3.new(0, 0.2, 0), Color3.fromRGB(120, 255, 220), Enum.Material.Neon, "RetreatSigil")
	holder(model, "ArenaRetreat", retreat, "Retreat", "Teleport to camp", 1)
	beacon(model, "ArenaVictoryBeacon", P.ArenaVictoryBeacon, Color3.fromRGB(255, 215, 120), "Extract", "Warden's Beacon (after victory)", 2)
end

function Emberfall.build(world: Instance)
	local folder = Build.folder(world, "Emberfall")
	terrain(folder)
	camp(folder)
	frontier(folder)
	sunfall(folder)
	ravine(folder)
	keep(folder)
	arena(folder)
end

return Emberfall
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">Lighting</string>
            <string name="Source"><![CDATA[--!strict
-- Base lighting + post-processing. The client ZoneController tweens these per region.

local Lighting = game:GetService("Lighting")

local LightingSetup = {}

local function ensure(className: string, name: string): Instance
	local existing = Lighting:FindFirstChild(name)
	if existing and existing.ClassName == className then
		return existing
	end
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = Lighting
	return inst
end

function LightingSetup.apply()
	Lighting.Ambient = Color3.fromRGB(70, 60, 90)
	Lighting.OutdoorAmbient = Color3.fromRGB(120, 105, 140)
	Lighting.Brightness = 2.2
	Lighting.ClockTime = 17.4
	Lighting.GeographicLatitude = 30
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.ExposureCompensation = 0.1

	local atmosphere = ensure("Atmosphere", "RiftAtmosphere") :: Atmosphere
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(150, 130, 190)
	atmosphere.Decay = Color3.fromRGB(110, 80, 140)
	atmosphere.Glare = 0.4
	atmosphere.Haze = 1.4

	local bloom = ensure("BloomEffect", "RiftBloom") :: BloomEffect
	bloom.Intensity = 0.7
	bloom.Size = 28
	bloom.Threshold = 1.6

	local color = ensure("ColorCorrectionEffect", "RiftGrade") :: ColorCorrectionEffect
	color.Contrast = 0.08
	color.Saturation = 0.12
	color.Brightness = 0.02
	color.TintColor = Color3.fromRGB(240, 235, 255)

	local rays = ensure("SunRaysEffect", "RiftRays") :: SunRaysEffect
	rays.Intensity = 0.06
	rays.Spread = 0.6
end

return LightingSetup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">Models</string>
            <string name="Source"><![CDATA[--!strict
-- Procedural character models: enemies, the Fracture Warden, the katana and resource nodes.
-- Gameplay code only relies on: HumanoidRootPart, Humanoid, the "HealthBar" billboard,
-- and named parts "Shield" / "WeakPoint" / "Blade". Replace with authored models freely.

local Build = require(script.Parent.Build)

local Models = {}

local function weldTo(part: BasePart, root: BasePart)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part
end

local function bodyPart(model: Model, root: BasePart, base: CFrame, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, class: string?): BasePart
	local part = Build.part(model, {
		size = size,
		cframe = base * offset,
		color = color,
		material = material or Enum.Material.SmoothPlastic,
		name = name,
		collide = false,
		class = class,
	})
	part.Anchored = false
	part.Massless = true
	part.CanTouch = false
	weldTo(part, root)
	return part
end

local function healthBar(model: Model, root: BasePart, height: number, name: string, color: Color3)
	local gui = Instance.new("BillboardGui")
	gui.Name = "HealthBar"
	gui.Adornee = root
	gui.Size = UDim2.fromOffset(150, 30)
	gui.StudsOffset = Vector3.new(0, height, 0)
	gui.MaxDistance = 80
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(1, 0, 0.5, 0)
	title.BackgroundTransparency = 1
	title.Text = name
	title.TextScaled = true
	title.Font = Enum.Font.GothamBold
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextStrokeTransparency = 0.4
	title.Parent = gui
	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Size = UDim2.new(1, 0, 0.32, 0)
	back.Position = UDim2.new(0, 0, 0.6, 0)
	back.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
	back.BorderSizePixel = 0
	back.Parent = gui
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = color
	fill.BorderSizePixel = 0
	fill.Parent = back
	gui.Parent = model
end

-- Builds a standard enemy rig at `position` (ground level) facing -Z.
function Models.enemy(def: any, position: Vector3): Model
	local s = def.look.scale
	local body, accent = def.look.body, def.look.accent
	local model = Instance.new("Model")
	model.Name = def.id

	local hip = s
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 2) * s
	root.Transparency = 1
	root.CanCollide = true
	root.CanTouch = false
	root.TopSurface = Enum.SurfaceType.Smooth
	root.BottomSurface = Enum.SurfaceType.Smooth
	root.CFrame = CFrame.new(position + Vector3.new(0, hip + s, 0))
	root.Parent = model
	model.PrimaryPart = root

	local g = root.CFrame * CFrame.new(0, -(hip + s), 0) -- ground point under the root
	local behaviour = def.behaviour
	local height = 4 * s

	if behaviour == "Stalker" then
		bodyPart(model, root, g, "Body", Vector3.new(3, 1.6, 5) * s, CFrame.new(0, 2.3 * s, 0), body, Enum.Material.Slate)
		bodyPart(model, root, g, "Head", Vector3.new(2, 1.4, 2.2) * s, CFrame.new(0, 2.8 * s, -3.1 * s), body, Enum.Material.Slate, "WedgePart")
		bodyPart(model, root, g, "EyeL", Vector3.new(0.3, 0.3, 0.3) * s, CFrame.new(-0.5 * s, 3.1 * s, -4 * s), accent, Enum.Material.Neon)
		bodyPart(model, root, g, "EyeR", Vector3.new(0.3, 0.3, 0.3) * s, CFrame.new(0.5 * s, 3.1 * s, -4 * s), accent, Enum.Material.Neon)
		for i = -1, 1 do
			bodyPart(model, root, g, "Spike", Vector3.new(0.4, 1.4, 1.2) * s, CFrame.new(0, 3.5 * s, i * 1.4 * s) * CFrame.Angles(math.rad(-25), 0, 0), accent, Enum.Material.Neon, "WedgePart")
		end
		for _, x in { -1.1, 1.1 } do
			for _, z in { -1.6, 1.6 } do
				bodyPart(model, root, g, "Leg", Vector3.new(0.5, 2, 0.5) * s, CFrame.new(x * s, 1 * s, z * s), body, Enum.Material.Slate)
			end
		end
		bodyPart(model, root, g, "Tail", Vector3.new(0.4, 0.4, 3) * s, CFrame.new(0, 2.6 * s, 3.8 * s) * CFrame.Angles(math.rad(20), 0, 0), accent, Enum.Material.Neon)
		height = 4.6 * s
	elseif behaviour == "Guardian" or behaviour == "Golem" then
		for _, x in { -0.8, 0.8 } do
			bodyPart(model, root, g, "Leg", Vector3.new(1.2, 2.4, 1.2) * s, CFrame.new(x * s, 1.2 * s, 0), body, Enum.Material.Slate)
		end
		bodyPart(model, root, g, "Torso", Vector3.new(3, 3, 2) * s, CFrame.new(0, 4 * s, 0), body, Enum.Material.Slate)
		bodyPart(model, root, g, "Rune", Vector3.new(1.2, 1.2, 0.2) * s, CFrame.new(0, 4.3 * s, -1.05 * s), accent, Enum.Material.Neon)
		bodyPart(model, root, g, "Head", Vector3.new(1.6, 1.4, 1.6) * s, CFrame.new(0, 6.2 * s, 0), body, Enum.Material.Slate)
		bodyPart(model, root, g, "Eye", Vector3.new(1.0, 0.25, 0.2) * s, CFrame.new(0, 6.3 * s, -0.82 * s), accent, Enum.Material.Neon)
		bodyPart(model, root, g, "ArmL", Vector3.new(1, 3, 1) * s, CFrame.new(-2.1 * s, 3.9 * s, 0), body, Enum.Material.Slate)
		bodyPart(model, root, g, "ArmR", Vector3.new(1, 3, 1) * s, CFrame.new(2.1 * s, 3.9 * s, 0), body, Enum.Material.Slate)
		bodyPart(model, root, g, "Shoulders", Vector3.new(5.2, 0.8, 1.6) * s, CFrame.new(0, 5.5 * s, 0), body:Lerp(Color3.new(0, 0, 0), 0.3), Enum.Material.Slate)
		if behaviour == "Guardian" then
			local shield = bodyPart(model, root, g, "Shield", Vector3.new(0.3, 3.2, 3.2) * s, CFrame.new(-2.3 * s, 3.9 * s, -1.2 * s) * CFrame.Angles(0, math.rad(90), 0), accent, Enum.Material.ForceField)
			if shield:IsA("Part") then
				shield.Shape = Enum.PartType.Cylinder
			end
			shield.Transparency = 0.2
		end
		height = 7.6 * s
	elseif behaviour == "Beast" then
		bodyPart(model, root, g, "Body", Vector3.new(4, 3, 6) * s, CFrame.new(0, 2.9 * s, 0), body, Enum.Material.Basalt)
		bodyPart(model, root, g, "Head", Vector3.new(2.6, 2.2, 2.6) * s, CFrame.new(0, 3.5 * s, -3.9 * s), body, Enum.Material.Basalt)
		bodyPart(model, root, g, "Maw", Vector3.new(1.8, 0.4, 0.3) * s, CFrame.new(0, 3.0 * s, -5.25 * s), accent, Enum.Material.Neon)
		bodyPart(model, root, g, "HornL", Vector3.new(0.5, 1.6, 0.5) * s, CFrame.new(-0.9 * s, 5 * s, -3.6 * s) * CFrame.Angles(math.rad(-20), 0, math.rad(15)), accent, Enum.Material.Neon)
		bodyPart(model, root, g, "HornR", Vector3.new(0.5, 1.6, 0.5) * s, CFrame.new(0.9 * s, 5 * s, -3.6 * s) * CFrame.Angles(math.rad(-20), 0, math.rad(-15)), accent, Enum.Material.Neon)
		for i = -1, 1 do
			bodyPart(model, root, g, "Crack", Vector3.new(3.4, 0.15, 0.3) * s, CFrame.new(0, 4.45 * s, i * 1.6 * s), accent, Enum.Material.Neon)
		end
		for _, x in { -1.4, 1.4 } do
			for _, z in { -2, 2 } do
				bodyPart(model, root, g, "Leg", Vector3.new(1, 1.8, 1) * s, CFrame.new(x * s, 0.9 * s, z * s), body, Enum.Material.Basalt)
			end
		end
		local core = model:FindFirstChild("Body") :: BasePart
		Build.light(core, accent, 14, 1.2)
		height = 5.2 * s
	elseif behaviour == "Dummy" then
		bodyPart(model, root, g, "Post", Vector3.new(0.6, 6, 0.6), CFrame.new(0, 3, 0), Color3.fromRGB(90, 66, 44), Enum.Material.Wood)
		bodyPart(model, root, g, "Straw", Vector3.new(2.2, 3, 1.6), CFrame.new(0, 4.4, 0), body, Enum.Material.Fabric)
		bodyPart(model, root, g, "Arms", Vector3.new(5, 0.6, 0.6), CFrame.new(0, 5.2, 0), Color3.fromRGB(90, 66, 44), Enum.Material.Wood)
		bodyPart(model, root, g, "Head", Vector3.new(1.6, 1.6, 1.6), CFrame.new(0, 6.6, 0), body, Enum.Material.Fabric)
		bodyPart(model, root, g, "Target", Vector3.new(1.4, 1.4, 0.15), CFrame.new(0, 4.6, -0.86), accent, Enum.Material.Neon)
		height = 8
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15 -- R15 honours HipHeight for limbless custom rigs
	humanoid.HipHeight = hip
	humanoid.WalkSpeed = def.moveSpeed
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	humanoid.Parent = model

	local barColor = if def.kind == "Champion" then Color3.fromRGB(255, 190, 60) else Color3.fromRGB(235, 70, 70)
	healthBar(model, root, height - (hip + s) + 1.5, def.displayName, barColor)
	model:SetAttribute("Height", height)
	return model
end

-- The Fracture Warden.
function Models.warden(position: Vector3): Model
	local model = Instance.new("Model")
	model.Name = "FractureWarden"
	local hip, half = 6, 3
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(6, 6, 6)
	root.Transparency = 1
	root.CanCollide = true
	root.CanTouch = false
	root.CFrame = CFrame.new(position + Vector3.new(0, hip + half, 0))
	root.Parent = model
	model.PrimaryPart = root
	local g = root.CFrame * CFrame.new(0, -(hip + half), 0)
	local stone = Color3.fromRGB(34, 30, 44)
	local trim = Color3.fromRGB(70, 62, 90)
	local rift = Color3.fromRGB(255, 60, 140)
	local crystal = Color3.fromRGB(150, 90, 255)

	for _, x in { -3, 3 } do
		bodyPart(model, root, g, "Leg", Vector3.new(3, 8, 3.4), CFrame.new(x, 4, 0), stone, Enum.Material.Basalt)
		bodyPart(model, root, g, "Greave", Vector3.new(3.4, 2, 3.8), CFrame.new(x, 6.5, -0.2), trim, Enum.Material.Slate)
	end
	bodyPart(model, root, g, "Pelvis", Vector3.new(8, 3, 5), CFrame.new(0, 9, 0), trim, Enum.Material.Slate)
	bodyPart(model, root, g, "Torso", Vector3.new(10, 8, 6), CFrame.new(0, 14.5, 0), stone, Enum.Material.Basalt)
	for i, x in { -3, 0.5, 3 } do
		bodyPart(model, root, g, "Fracture" .. i, Vector3.new(0.4, 6, 0.3), CFrame.new(x, 14.5, -3.05) * CFrame.Angles(0, 0, math.rad(15 * (i - 2))), rift, Enum.Material.Neon)
	end
	bodyPart(model, root, g, "Core", Vector3.new(2.4, 2.4, 0.6), CFrame.new(0, 15.5, -3.1) * CFrame.Angles(0, 0, math.rad(45)), rift, Enum.Material.Neon)
	bodyPart(model, root, g, "Head", Vector3.new(4, 4, 4), CFrame.new(0, 20.5, 0), stone, Enum.Material.Basalt)
	bodyPart(model, root, g, "Visor", Vector3.new(3.2, 0.6, 0.3), CFrame.new(0, 20.8, -2.05), rift, Enum.Material.Neon)
	bodyPart(model, root, g, "Crown", Vector3.new(1, 3, 1), CFrame.new(0, 23.5, 0) * CFrame.Angles(0, math.rad(45), 0), crystal, Enum.Material.Neon)
	for _, x in { -7, 7 } do
		bodyPart(model, root, g, "Pauldron", Vector3.new(5, 3, 5), CFrame.new(x, 18.5, 0), trim, Enum.Material.Slate)
		bodyPart(model, root, g, "ShoulderShard", Vector3.new(1.2, 5, 1.2), CFrame.new(x, 21.5, 0) * CFrame.Angles(0, 0, math.rad(x > 0 and -20 or 20)), crystal, Enum.Material.Neon)
		bodyPart(model, root, g, "Arm", Vector3.new(3, 9, 3), CFrame.new(x * 1.07, 13, 0), stone, Enum.Material.Basalt)
	end
	-- Cleaver in the right hand
	bodyPart(model, root, g, "CleaverHilt", Vector3.new(1, 4, 1), CFrame.new(7.5, 7.5, -1.5), trim, Enum.Material.Slate)
	bodyPart(model, root, g, "Cleaver", Vector3.new(1, 14, 5), CFrame.new(7.5, 2, -3.5) * CFrame.Angles(math.rad(-20), 0, 0), Color3.fromRGB(60, 56, 70), Enum.Material.Metal)
	bodyPart(model, root, g, "CleaverEdge", Vector3.new(1.1, 14, 0.5), CFrame.new(7.5, 2.4, -6.1) * CFrame.Angles(math.rad(-20), 0, 0), rift, Enum.Material.Neon)
	-- Rift orb in the left hand
	local orb = bodyPart(model, root, g, "RiftOrb", Vector3.new(3, 3, 3), CFrame.new(-7.5, 8, -1), crystal, Enum.Material.Neon)
	if orb:IsA("Part") then
		orb.Shape = Enum.PartType.Ball
	end
	Build.light(orb, crystal, 20, 2)
	-- Weak point on the back (dim until exposed)
	local weak = bodyPart(model, root, g, "WeakPoint", Vector3.new(3.4, 5, 1.6), CFrame.new(0, 15, 3.6), Color3.fromRGB(255, 230, 120), Enum.Material.Neon)
	weak.Transparency = 0.75
	Build.light(weak, Color3.fromRGB(255, 220, 120), 16, 0)
	Build.particles(model:FindFirstChild("Torso") :: BasePart, rift, 8, {
		speed = NumberRange.new(2, 5),
		lifetime = NumberRange.new(0.6, 1.2),
		size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) }),
	})

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15 -- R15 honours HipHeight for limbless custom rigs
	humanoid.HipHeight = hip
	humanoid.WalkSpeed = 13
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	humanoid.Parent = model
	model:SetAttribute("Height", 25)
	return model
end

-- Katana welded to a character's right hand. Returns the model (trail disabled by default).
function Models.katana(character: Model, trailColor: Color3): Model?
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if not hand or not hand:IsA("BasePart") then
		return nil
	end
	local old = character:FindFirstChild("Katana")
	if old then
		old:Destroy()
	end
	local isR6 = hand.Name == "Right Arm"
	local grip = hand.CFrame * CFrame.new(0, if isR6 then -1 else -0.2, 0)
	local model = Instance.new("Model")
	model.Name = "Katana"
	local function piece(name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material): BasePart
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.CFrame = grip * offset
		part.Color = color
		part.Material = material
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part.CastShadow = false
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = hand :: BasePart
		weld.Part1 = part
		weld.Parent = part
		return part
	end
	-- Handle: dark wrap with diamond-pattern bands, gold pommel
	piece("Handle", Vector3.new(0.3, 0.3, 1.5), CFrame.new(0, 0, 0), Color3.fromRGB(30, 22, 36), Enum.Material.Fabric)
	for i = -2, 2 do
		piece("Wrap", Vector3.new(0.33, 0.33, 0.08), CFrame.new(0, 0, i * 0.28) * CFrame.Angles(0, 0, math.rad(45)), Color3.fromRGB(150, 30, 50), Enum.Material.Fabric)
	end
	piece("Pommel", Vector3.new(0.36, 0.36, 0.14), CFrame.new(0, 0, 0.8), Color3.fromRGB(220, 175, 80), Enum.Material.Metal)
	-- Tsuba (round guard) + habaki collar
	local guard = piece("Guard", Vector3.new(0.14, 1.0, 1.0), CFrame.new(0, 0, -0.8) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(215, 170, 75), Enum.Material.Metal)
	if guard:IsA("Part") then
		guard.Shape = Enum.PartType.Cylinder
	end
	piece("Collar", Vector3.new(0.16, 0.36, 0.25), CFrame.new(0, 0.02, -1.0), Color3.fromRGB(230, 190, 110), Enum.Material.Metal)
	-- Curved blade: four segments with a slight upward sori, a glowing hamon edge on each
	local blade
	local z, y, angle = -1.1, 0.02, 0
	for i = 1, 4 do
		local length = 1.15
		local center = CFrame.new(0, y, z) * CFrame.Angles(math.rad(angle), 0, 0) * CFrame.new(0, 0, -length / 2)
		local seg = piece(if i == 2 then "Blade" else "BladeSeg" .. i, Vector3.new(0.1, 0.3 - i * 0.025, length + 0.04), center, Color3.fromRGB(220, 226, 238), Enum.Material.Metal)
		seg.Reflectance = 0.25
		piece(if i == 2 then "Edge" else "EdgeSeg" .. i, Vector3.new(0.11, 0.07, length), center * CFrame.new(0, -0.13 + i * 0.01, 0), trailColor, Enum.Material.Neon)
		if i == 2 then
			blade = seg
		end
		local tip = center * CFrame.new(0, 0, -length / 2)
		z, y = tip.Position.Z, tip.Position.Y
		angle += 4
	end
	piece("Tip", Vector3.new(0.09, 0.18, 0.4), CFrame.new(0, y + 0.03, z - 0.15) * CFrame.Angles(math.rad(angle + 10), 0, 0), Color3.fromRGB(235, 240, 250), Enum.Material.Metal)
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailBase"
	a0.Position = Vector3.new(0, 0, 1.2)
	a0.Parent = blade
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailTip"
	a1.Position = Vector3.new(0, 0.1, -3.4)
	a1.Parent = blade
	local trail = Instance.new("Trail")
	trail.Name = "SwingTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.22
	trail.MinLength = 0.05
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(trailColor)
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	trail.Enabled = false
	trail.Parent = blade
	model.Parent = character
	return model
end

-- Mineable node: a rock base with glowing veins. Returns model + the part holding the prompt.
function Models.node(def: any, position: Vector3, parent: Instance): (Model, BasePart)
	local model = Instance.new("Model")
	model.Name = def.id
	local base = Build.part(model, {
		size = Vector3.new(6, 4, 6),
		cframe = CFrame.new(position + Vector3.new(0, 1.8, 0)) * CFrame.Angles(0, Build.rng:NextNumber(0, math.pi), 0),
		color = def.color,
		material = Enum.Material.Slate,
		name = "Base",
	})
	for i = 1, 5 do
		local h = Build.rng:NextNumber(1.5, 3.5)
		Build.part(model, {
			size = Vector3.new(0.8, h, 0.8),
			cframe = base.CFrame * CFrame.new(Build.rng:NextNumber(-2.2, 2.2), 1.5 + h / 2 - 0.6, Build.rng:NextNumber(-2.2, 2.2))
				* CFrame.Angles(Build.rng:NextNumber(-0.5, 0.5), 0, Build.rng:NextNumber(-0.5, 0.5)),
			color = def.glow,
			material = Enum.Material.Neon,
			name = "Vein" .. i,
			collide = false,
			castShadow = false,
		})
	end
	Build.light(base, def.glow, 10, 0.8)
	model.PrimaryPart = base
	model.Parent = parent
	return model, base
end

return Models
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">Nexus</string>
            <string name="Source"><![CDATA[--!strict
-- THE NEXUS: the social hub. Every system has a physical station with a readable sign,
-- a light landmark and a prompt. Positions come from WorldConfig.Points.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local WorldConfig = require(Shared.Config.WorldConfig)
local Build = require(script.Parent.Build)

local Nexus = {}

local P = WorldConfig.Points
local STONE = Color3.fromRGB(58, 54, 74)
local TRIM = Color3.fromRGB(96, 88, 120)
local MARBLE = Color3.fromRGB(196, 190, 214)
local GOLD = Color3.fromRGB(255, 205, 110)
local RIFT = Color3.fromRGB(170, 110, 255)

local function facing(from: Vector3, to: Vector3): CFrame
	return CFrame.lookAt(from, Vector3.new(to.X, from.Y, to.Z))
end

local function station(parent: Instance, name: string, position: Vector3, view: string, action: string, object: string, stationId: string?): BasePart
	local holder = Build.part(parent, {
		size = Vector3.new(3, 4, 3),
		cframe = CFrame.new(position + Vector3.new(0, 2, 0)),
		transparency = 1,
		collide = false,
		name = name,
	})
	local prompt = Build.prompt(holder, action, object, 0, 14)
	prompt:SetAttribute("View", view)
	if stationId then
		prompt:SetAttribute("Station", stationId)
	end
	return holder
end

local function path(parent: Instance, from: Vector3, to: Vector3, width: number)
	local delta = to - from
	local length = Vector3.new(delta.X, 0, delta.Z).Magnitude
	local mid = (from + to) / 2
	Build.part(parent, {
		size = Vector3.new(width, 0.3, length),
		cframe = CFrame.lookAt(Vector3.new(mid.X, 0.15, mid.Z), Vector3.new(to.X, 0.15, to.Z)),
		color = Color3.fromRGB(120, 112, 140),
		material = Enum.Material.Pavement,
		name = "Path",
		castShadow = false,
	})
	-- glowing edge lines guide the eye
	for _, side in { -1, 1 } do
		local cf = CFrame.lookAt(Vector3.new(mid.X, 0.32, mid.Z), Vector3.new(to.X, 0.32, to.Z)) * CFrame.new(side * (width / 2 - 0.3), 0, 0)
		Build.neon(parent, Vector3.new(0.3, 0.05, length), cf, RIFT, "PathGlow")
	end
end

local function buildPlaza(parent: Instance)
	-- base island
	Build.cylinder(parent, 340, 8, Vector3.new(0, -4, 0), STONE, Enum.Material.Slate, "Island")
	Build.cylinder(parent, 120, 0.4, Vector3.new(0, 0.2, 0), MARBLE, Enum.Material.Marble, "Plaza")
	Build.cylinder(parent, 92, 0.5, Vector3.new(0, 0.25, 0), Color3.fromRGB(150, 140, 175), Enum.Material.Marble, "PlazaInner")
	Build.cylinder(parent, 40, 0.6, Vector3.new(0, 0.3, 0), TRIM, Enum.Material.Slate, "SpireBase")
	-- (the island underside is sculpted in Smooth Terrain by TerrainGen)
	-- rim: crystal pillars + invisible safety wall
	for i = 1, 24 do
		local angle = i / 24 * math.pi * 2
		local pos = Vector3.new(math.cos(angle) * 166, 0, math.sin(angle) * 166)
		Build.part(parent, {
			size = Vector3.new(4, 40, 4),
			cframe = CFrame.lookAt(pos + Vector3.new(0, 20, 0), Vector3.new(0, 20, 0)),
			transparency = 1,
			name = "RimBarrier",
		})
		Build.part(parent, {
			size = Vector3.new(44, 40, 2),
			cframe = CFrame.lookAt(pos + Vector3.new(0, 20, 0), Vector3.new(0, 20, 0)),
			transparency = 1,
			name = "RimWall",
		})
		if i % 2 == 0 then
			Build.crystal(parent, pos, if i % 4 == 0 then RIFT else Color3.fromRGB(110, 190, 255), 1.4)
		end
	end
	-- spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "NexusSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(P.NexusSpawn.X, 0.1, P.NexusSpawn.Z)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = parent
end

local function buildSpire(parent: Instance)
	local model = Build.model(parent, "SoulforgeSpire")
	-- stepped marble plinth with gold inlay rings
	Build.cylinder(model, 22, 1.6, Vector3.new(0, 0.8, 0), MARBLE, Enum.Material.Marble, "Plinth1")
	Build.cylinder(model, 17, 1.6, Vector3.new(0, 2.4, 0), TRIM, Enum.Material.Slate, "Plinth2")
	Build.cylinder(model, 12, 1.4, Vector3.new(0, 3.9, 0), STONE, Enum.Material.Slate, "Plinth3")
	Build.cylinder(model, 17.4, 0.25, Vector3.new(0, 3.25, 0), GOLD, Enum.Material.Neon, "InlayRing")
	Build.cylinder(model, 22.4, 0.25, Vector3.new(0, 1.65, 0), RIFT, Enum.Material.Neon, "InlayRing")
	-- tapered obsidian obelisk with glowing veins
	local y = 4.6
	for i, w in { 4.2, 3.4, 2.6, 1.8 } do
		local h = 6 - i * 0.6
		Build.part(model, {
			size = Vector3.new(w, h, w),
			cframe = CFrame.new(0, y + h / 2, 0) * CFrame.Angles(0, math.rad(45), 0),
			color = Color3.fromRGB(30, 26, 42),
			material = Enum.Material.Basalt,
			name = "Obelisk" .. i,
		})
		for _, side in { 0, 90, 180, 270 } do
			Build.part(model, {
				size = Vector3.new(0.18, h * 0.8, 0.12),
				cframe = CFrame.new(0, y + h / 2, 0) * CFrame.Angles(0, math.rad(45 + side), 0) * CFrame.new(0, 0, -w / 2 - 0.02),
				color = RIFT,
				material = Enum.Material.Neon,
				collide = false,
				castShadow = false,
				name = "Vein",
			})
		end
		y += h
	end
	-- four slender crystal shards leaning outward, glass shell + thin neon core
	for i = 1, 4 do
		local angle = i / 4 * math.pi * 2 + math.pi / 4
		local base = CFrame.new(math.cos(angle) * 6.5, 0, math.sin(angle) * 6.5)
			* CFrame.Angles(0, -angle, 0)
			* CFrame.Angles(0, 0, math.rad(-14))
		local shell = Build.part(model, {
			size = Vector3.new(1.3, 14, 1.3),
			cframe = base * CFrame.new(0, 10, 0) * CFrame.Angles(0, math.rad(45), 0),
			color = Color3.fromRGB(150, 110, 230),
			material = Enum.Material.Glass,
			collide = false,
			name = "Shard",
		})
		shell.Transparency = 0.35
		Build.part(model, {
			size = Vector3.new(0.35, 13, 0.35),
			cframe = base * CFrame.new(0, 10, 0),
			color = RIFT,
			material = Enum.Material.Neon,
			collide = false,
			castShadow = false,
			name = "ShardCore",
		})
	end
	-- floating soul core: glass diamond around a smaller neon heart
	local core = Build.part(model, {
		size = Vector3.new(4.5, 4.5, 4.5),
		cframe = CFrame.new(0, 34, 0) * CFrame.Angles(math.rad(45), 0, math.rad(35)),
		color = Color3.fromRGB(190, 150, 255),
		material = Enum.Material.Glass,
		collide = false,
		name = "Core",
	})
	core.Transparency = 0.3
	local heart = Build.part(model, {
		size = Vector3.new(2.2, 2.2, 2.2),
		cframe = CFrame.new(0, 34, 0) * CFrame.Angles(math.rad(45), 0, math.rad(35)),
		color = Color3.fromRGB(210, 170, 255),
		material = Enum.Material.Neon,
		collide = false,
		castShadow = false,
		name = "CoreHeart",
	})
	Build.light(heart, Color3.fromRGB(190, 140, 255), 60, 3)
	Build.particles(heart, Color3.fromRGB(200, 160, 255), 18, {
		speed = NumberRange.new(3, 6),
		lifetime = NumberRange.new(1.5, 2.5),
		size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) }),
	})
	core:SetAttribute("Spin", 0.6)
	heart:SetAttribute("Spin", -0.9)
	-- orbiting rune ring (rotated client-side)
	local ring = Build.model(model, "Ring")
	for i = 1, 24 do
		local angle = i / 24 * math.pi * 2
		Build.part(ring, {
			size = Vector3.new(0.5, 0.5, 2.2),
			cframe = CFrame.lookAt(Vector3.new(math.cos(angle) * 9, 34, math.sin(angle) * 9), Vector3.new(0, 34, 0)),
			color = if i % 3 == 0 then RIFT else GOLD,
			material = Enum.Material.Neon,
			collide = false,
			name = "RingShard",
			castShadow = false,
		})
	end
	ring:SetAttribute("SpinModel", 0.25)
	ring.PrimaryPart = ring:FindFirstChildWhichIsA("BasePart")
end

-- Scatter trees, rocks, flower beds and lanterns over the grass ring, away from paths/stations.
local function decorate(parent: Instance)
	local model = Build.model(parent, "Decoration")
	local rng = Random.new(4242)
	local blockers = {}
	for _, point in P do
		if typeof(point) == "Vector3" and point.Magnitude < 200 then
			table.insert(blockers, point)
		end
	end
	local function nearPath(pos: Vector3): boolean
		for _, target in blockers do
			local flatTarget = Vector3.new(target.X, 0, target.Z)
			local len = flatTarget.Magnitude
			if len > 1 then
				local along = math.clamp(pos:Dot(flatTarget.Unit), 0, len)
				if (pos - flatTarget.Unit * along).Magnitude < 9 then
					return true
				end
			end
			if (pos - flatTarget).Magnitude < 32 then
				return true
			end
		end
		return false
	end
	local placed = 0
	for _ = 1, 400 do
		if placed >= 70 then
			break
		end
		local angle = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(66, 158)
		local pos = Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
		if not nearPath(pos) then
			placed += 1
			local roll = rng:NextNumber()
			if roll < 0.45 then
				Build.tree(model, pos, rng:NextNumber(0.8, 1.25), rng:NextNumber() < 0.6)
			elseif roll < 0.6 then
				Build.pine(model, pos, rng:NextNumber(0.8, 1.2))
			elseif roll < 0.75 then
				Build.rock(model, pos, rng:NextNumber(0.6, 1.1), Color3.fromRGB(110, 104, 120))
			elseif roll < 0.92 then
				Build.flowers(model, pos, rng)
			else
				Build.crystal(model, pos, if rng:NextNumber() < 0.5 then RIFT else Color3.fromRGB(110, 190, 255), 0.9)
			end
		end
	end
end

local function buildForge(parent: Instance)
	local model = Build.model(parent, "Forge")
	local c = P.Forge
	local base = CFrame.new(c) * CFrame.Angles(0, 0, 0) -- faces +Z (towards the plaza)
	Build.block(model, Vector3.new(34, 1, 22), base * CFrame.new(0, 0.5, -4), TRIM, Enum.Material.Slate, "Floor")
	Build.block(model, Vector3.new(34, 18, 2), base * CFrame.new(0, 9, -15), STONE, Enum.Material.Brick, "BackWall")
	Build.block(model, Vector3.new(2, 18, 22), base * CFrame.new(-17, 9, -4), STONE, Enum.Material.Brick, "SideWall")
	Build.block(model, Vector3.new(2, 18, 22), base * CFrame.new(17, 9, -4), STONE, Enum.Material.Brick, "SideWall")
	Build.part(model, { size = Vector3.new(38, 2, 26), cframe = base * CFrame.new(0, 19, -4) * CFrame.Angles(math.rad(-8), 0, 0), color = Color3.fromRGB(70, 40, 40), material = Enum.Material.WoodPlanks, name = "Roof" })
	-- furnace
	Build.block(model, Vector3.new(12, 12, 8), base * CFrame.new(-7, 6, -10), Color3.fromRGB(50, 44, 50), Enum.Material.Brick, "Furnace")
	local mouth = Build.neon(model, Vector3.new(6, 4, 0.5), base * CFrame.new(-7, 4, -5.8), Color3.fromRGB(255, 120, 40), "FurnaceMouth")
	Build.light(mouth, Color3.fromRGB(255, 140, 60), 30, 3)
	Build.particles(mouth, Color3.fromRGB(255, 150, 60), 10, { acceleration = Vector3.new(0, 8, 0), spread = Vector2.new(20, 20) })
	Build.block(model, Vector3.new(4, 16, 4), base * CFrame.new(-7, 20, -11), STONE, Enum.Material.Brick, "Chimney")
	-- anvil
	Build.block(model, Vector3.new(3, 2.5, 2), base * CFrame.new(6, 1.25, -4), Color3.fromRGB(40, 40, 46), Enum.Material.Metal, "AnvilBase")
	Build.block(model, Vector3.new(5, 1.2, 2.4), base * CFrame.new(6, 3.1, -4), Color3.fromRGB(70, 72, 82), Enum.Material.Metal, "AnvilTop")
	Build.neon(model, Vector3.new(0.3, 0.2, 3.5), base * CFrame.new(6, 3.9, -4) * CFrame.Angles(0, math.rad(70), 0), GOLD, "GlowingBlade")
	-- weapon rack showing planned families (not functional, clearly labelled)
	for i = 1, 5 do
		Build.block(model, Vector3.new(0.4, 6, 0.4), base * CFrame.new(10 + i * 1.2, 4, -13.6) * CFrame.Angles(0, 0, math.rad(8)), Color3.fromRGB(150, 150, 160), Enum.Material.Metal, "RackBlade")
	end
	Build.sign(model, "THE SOULFORGE", base * CFrame.new(0, 15, 7.2) * CFrame.Angles(0, math.rad(180), 0), Vector2.new(20, 3.5), Color3.fromRGB(30, 22, 30), GOLD)
	station(model, "ForgeStation", c + Vector3.new(6, 0, 0), "Forge", "Forge", "Upgrades & Tempers", "Forge")
end

