			[2] = "Thunderstep (E).",
			[3] = "Static Charge: Charged enemies take +10% damage.",
			[4] = "Tempest Sovereign awakening lasts 3s longer.",
			[5] = "Storm abilities +15% damage.",
		},
		unlockHint = "Complete the contract 'Stalker Cull' in Emberfall, or attune at the Fusion Chamber.",
		attuneCost = { EssenceShard = 6, Coins = 250 },
		attuneLevel = 3,
	},
	Gravity = {
		id = "Gravity",
		implemented = true,
		displayName = "Gravity",
		theme = "Attraction, displacement, battlefield control.",
		color = Color3.fromRGB(162, 123, 255),
		maxMastery = 5,
		abilities = {
			Q = "GravitonPull",
			E = "CrushingField",
		},
		masteryUnlocks = {
			[1] = "Graviton Pull (Q).",
			[2] = "Crushing Field (E).",
			[3] = "Event Pressure: Gathered enemies take +15% damage.",
			[4] = "Singularity Throne awakening lasts 3s longer.",
			[5] = "Gravity abilities +15% damage.",
		},
		unlockHint = "Defeat the Ashen Sentinel in the Ruined Keep, or attune at the Fusion Chamber.",
		attuneCost = { EssenceShard = 10, Coins = 400 },
		attuneLevel = 5,
	},
	-- Planned essences: data only, never equippable while implemented = false.
	Frost = {
		id = "Frost",
		implemented = false,
		displayName = "Frost",
		theme = "Freezing, defensive structures, area control.",
		color = Color3.fromRGB(170, 230, 255),
		unlockHint = "Sealed. Expected with the Frostgrave region.",
	},
	Umbra = {
		id = "Umbra",
		implemented = false,
		displayName = "Umbra",
		theme = "Shadows, deception, mobility.",
		color = Color3.fromRGB(120, 90, 160),
		unlockHint = "Sealed. Its whispers have not reached the Nexus yet.",
	},
	Verdant = {
		id = "Verdant",
		implemented = false,
		displayName = "Verdant",
		theme = "Roots, regeneration, battlefield manipulation.",
		color = Color3.fromRGB(110, 210, 120),
		unlockHint = "Sealed. Expected with the Verdant Reach region.",
	},
}

EssenceConfig.Order = { "Ember", "Storm", "Gravity", "Frost", "Umbra", "Verdant" }

-- Player level required before a secondary essence slot opens.
EssenceConfig.SecondarySlotLevel = 3

-- Ability definitions. `essence` drives mastery gain and fusion attunement.
EssenceConfig.Abilities = {
	FlareBurst = {
		id = "FlareBurst",
		essence = "Ember",
		displayName = "Flare Burst",
		description = "A cone of flame in front of you. Burns for 4s.",
		cooldown = 6,
		damage = 1.8,
		range = 14,
		width = 9,
		burnDps = 4,
		burnDuration = 4,
		resonance = 3,
		masteryRequired = 1,
	},
	EmberNova = {
		id = "EmberNova",
		essence = "Ember",
		displayName = "Ember Nova",
		description = "Detonate around yourself, knocking enemies back and burning them.",
		cooldown = 12,
		damage = 2.2,
		radius = 12,
		knockback = 12,
		burnDps = 3,
		burnDuration = 3,
		resonance = 4,
		masteryRequired = 2,
	},
	ArcBolt = {
		id = "ArcBolt",
		essence = "Storm",
		displayName = "Arc Bolt",
		description = "Lightning strikes the enemy you aim at and chains to 3 more. Applies Charged.",
		cooldown = 5,
		damage = 1.6,
		range = 32,
		chainRange = 14,
		chains = 3,
		chainFalloff = 0.85,
		chargedDuration = 4,
		resonance = 3,
		masteryRequired = 1,
	},
	Thunderstep = {
		id = "Thunderstep",
		essence = "Storm",
		displayName = "Thunderstep",
		description = "Blink forward in a bolt, damaging everything on the path. Brief invulnerability.",
		cooldown = 9,
		damage = 1.5,
		distance = 18,
		width = 6,
		iframes = 0.3,
		resonance = 3,
		masteryRequired = 2,
	},
	GravitonPull = {
		id = "GravitonPull",
		essence = "Gravity",
		displayName = "Graviton Pull",
		description = "Pull enemies around the aim point together. Applies Gathered for 3s.",
		cooldown = 8,
		damage = 1.0,
		range = 30,
		radius = 12,
		pullTime = 0.6,
		gatheredDuration = 3,
		resonance = 3,
		masteryRequired = 1,
	},
	CrushingField = {
		id = "CrushingField",
		essence = "Gravity",
		displayName = "Crushing Field",
		description = "A zone of heavy gravity: slows enemies by 50% and crushes them every 0.5s.",
		cooldown = 14,
		damage = 0.5,
		range = 30,
		radius = 10,
		duration = 4,
		tick = 0.5,
		slow = 0.5,
		resonance = 1,
		masteryRequired = 2,
	},
	-- Fusion techniques (slot R). Unlocked through FusionConfig.
	CollapsingSun = {
		id = "CollapsingSun",
		essence = "Fusion",
		displayName = "Collapsing Sun",
		description = "A compact gravity well drags enemies in, then erupts in a solar blast that burns.",
		cooldown = 20,
		damage = 4.0,
		range = 30,
		radius = 14,
		blastRadius = 12,
		pullTime = 1.2,
		burnDps = 6,
		burnDuration = 4,
		resonance = 8,
	},
	MagneticRift = {
		id = "MagneticRift",
		essence = "Fusion",
		displayName = "Magnetic Rift",
		description = "Tear a magnetic rift that holds enemies together and lashes them with chained lightning for 3s.",
		cooldown = 22,
		damage = 0.9,
		range = 30,
		radius = 13,
		duration = 3,
		tick = 0.5,
		chains = 3,
		resonance = 8,
	},
}

function EssenceConfig.isPlayable(id: any): boolean
	if type(id) ~= "string" then
		return false
	end
	local def = EssenceConfig.Essences[id]
	return def ~= nil and def.implemented == true
end

return EssenceConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">ExpeditionConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Risk and reward. Unbanked loot ("satchel") is only moved into the permanent inventory
-- at an extraction beacon. Death at a given depth forfeits a share of the satchel.
-- Permanent unlocks, mastery, XP, achievements and anything bought with Robux are NEVER at risk.

local ExpeditionConfig = {}

ExpeditionConfig.Depths = {
	[0] = { name = "Safe", lossOnDeath = 0, dropMultiplier = 1.0 },
	[1] = { name = "Frontier", lossOnDeath = 0.25, dropMultiplier = 1.0 },
	[2] = { name = "Deep", lossOnDeath = 0.5, dropMultiplier = 1.3 },
	[3] = { name = "Rift Edge", lossOnDeath = 0.75, dropMultiplier = 1.6 },
}

ExpeditionConfig.Beacons = {
	Camp = { id = "Camp", displayName = "Camp Beacon", holdDuration = 1.0, deep = false },
	Keep = { id = "Keep", displayName = "Keep Beacon", holdDuration = 4.0, deep = true },
	Arena = { id = "Arena", displayName = "Warden's Beacon", holdDuration = 2.0, deep = true, requiresVictory = true },
}

-- Leaving the server mid-expedition is treated like a death at the current depth;
-- whatever remains is banked automatically. In a safe zone nothing is lost.
ExpeditionConfig.DisconnectRule = "death"

ExpeditionConfig.Rules = {
	"Loot found in Emberfall goes into your Satchel first.",
	"Bank it at an Extraction Beacon (Camp, Keep, or after the Warden falls).",
	"Dying loses part of the Satchel: 25% in the Frontier, 50% in the Keep, 75% at the Rift Edge.",
	"XP, mastery, unlocks, achievements and purchases are never lost.",
	"Deeper zones drop more: x1.3 in the Keep, x1.6 at the Rift Edge.",
}

return ExpeditionConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">FusionConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Power Fusion recipes. A fusion becomes castable only when `implemented` is true AND the
-- player has completed every step: research (discovery + essences) and attunement (the
-- playable challenge: chain ability A into ability B on the same enemy).

local FusionConfig = {}

FusionConfig.Fusions = {
	CollapsingSun = {
		id = "CollapsingSun",
		implemented = true,
		displayName = "Collapsing Sun",
		essences = { "Ember", "Gravity" },
		ability = "CollapsingSun",
		color = Color3.fromRGB(255, 160, 70),
		summary = "Gravity well that implodes into a solar blast.",
		research = {
			discovery = "SunfallTablet",
			masteries = { Ember = 2, Gravity = 1 },
			cost = { EssenceShard = 4 },
		},
		attunement = {
			description = "Hit an enemy with a Gravity ability, then an Ember ability within 3s (or the reverse). 3 times.",
			count = 3,
			window = 3,
		},
		hint = "Three flames in Emberfall remember the order of the sky.",
	},
	MagneticRift = {
		id = "MagneticRift",
		implemented = true,
		displayName = "Magnetic Rift",
		essences = { "Storm", "Gravity" },
		ability = "MagneticRift",
		color = Color3.fromRGB(120, 170, 255),
		summary = "A held rift that chains lightning through grouped enemies.",
		research = {
			masteries = { Storm = 2, Gravity = 2 },
			cost = { EssenceShard = 6, Cobalt = 2 },
		},
		attunement = {
			description = "Hit an enemy with a Storm ability, then a Gravity ability within 3s (or the reverse). 3 times.",
			count = 3,
			window = 3,
		},
		hint = "Charge them, then pull them close. Lightning loves a crowd.",
	},
	-- Defined for the Codex, not castable: its moveset does not exist yet.
	PlasmaLance = {
		id = "PlasmaLance",
		implemented = false,
		displayName = "Plasma Lance",
		essences = { "Ember", "Storm" },
		color = Color3.fromRGB(255, 120, 200),
		summary = "Unstable. The Fusion Chamber cannot hold this resonance yet.",
		hint = "Research sealed until a future update.",
	},
}

FusionConfig.Order = { "CollapsingSun", "MagneticRift", "PlasmaLance" }

-- Returns the fusion id for an (unordered) essence pair, or nil.
function FusionConfig.forPair(a: string?, b: string?): string?
	if not a or not b or a == b then
		return nil
	end
	for id, def in FusionConfig.Fusions do
		local e = def.essences
		if (e[1] == a and e[2] == b) or (e[1] == b and e[2] == a) then
			return id
		end
	end
	return nil
end

return FusionConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Global tuning values that are not owned by a single feature.

local GameConfig = {
	Version = "0.1.0",

	Data = {
		DataStoreName = "RiftboundProfiles_v1",
		KeyPrefix = "Player_",
		SchemaVersion = 2,
		AutosaveInterval = 120, -- seconds
		SessionLockTimeout = 1800, -- a lock older than this is considered abandoned
		LoadAttempts = 5,
		SaveAttempts = 4,
		RetryBaseDelay = 1, -- exponential backoff base, seconds
		MaxReceiptHistory = 200,
	},

	Player = {
		BaseWalkSpeed = 18,
		BlockWalkSpeed = 8,
		MaxStamina = 100,
		StaminaRegenPerSecond = 22,
		StaminaRegenDelay = 0.8,
		RespawnDelay = 4,
	},

	Combat = {
		MaxTargetsPerSwing = 6,
		ActionTolerance = 0.08, -- latency tolerance on action timing (seconds)
		ParryLatencyAllowance = 0.1, -- extra parry window granted for network delay
		ResonanceMax = 100,
		AwakeningBurnout = 10, -- seconds with no resonance gain after awakening ends
		PvPEnabled = false, -- foundation flag only; no PvP mode ships in this build
		HitStop = 0.05,
	},

	Party = {
		MaxSize = 4,
		InviteTimeout = 60,
		SharedCreditRadius = 150,
	},

	-- Server-side request rate limits: tokens per second and burst capacity, per player per category.
	RateLimits = {
		Combat = { rate = 12, burst = 16 },
		Ability = { rate = 4, burst = 6 },
		Request = { rate = 6, burst = 12 },
		Interact = { rate = 4, burst = 6 },
		Party = { rate = 2, burst = 4 },
	},

	-- Dev helpers (only honoured inside Roblox Studio).
	Dev = {
		AllowStudioCommands = true,
		StudioEventScale = 0.25, -- world event timers run 4x faster in Studio
	},
}

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">ItemConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Every persistent material has a defined purpose; see GAME_DESIGN.md "Economy".

export type ItemDef = {
	id: string,
	name: string,
	description: string,
	color: Color3,
	rarity: string,
	kind: string, -- "Material" | "Consumable" | "Component"
}

local ItemConfig = {}

ItemConfig.Items = {
	Iron = {
		id = "Iron",
		name = "Iron Ore",
		description = "Basic forging metal. Used for katana upgrades, tempers and the Cobalt Pick.",
		color = Color3.fromRGB(176, 170, 162),
		rarity = "Common",
		kind = "Material",
	},
	Cobalt = {
		id = "Cobalt",
		name = "Cobalt Crystal",
		description = "Resonant crystal for advanced upgrades and energy devices. Needs a Cobalt Pick.",
		color = Color3.fromRGB(72, 132, 255),
		rarity = "Uncommon",
		kind = "Material",
	},
	Emberstone = {
		id = "Emberstone",
		name = "Emberstone",
		description = "Smouldering stone. Fire tempers, Ember Tonics and high upgrades.",
		color = Color3.fromRGB(255, 112, 52),
		rarity = "Uncommon",
		kind = "Material",
	},
	EssenceShard = {
		id = "EssenceShard",
		name = "Essence Shard",
		description = "Condensed rift energy. Fuels essence attunement and fusion research.",
		color = Color3.fromRGB(190, 120, 255),
		rarity = "Rare",
		kind = "Material",
	},
	BossSigil = {
		id = "BossSigil",
		name = "Warden Sigil",
		description = "Torn from the Fracture Warden. High-level upgrades and the Fracture Core.",
		color = Color3.fromRGB(255, 70, 110),
		rarity = "Epic",
		kind = "Material",
	},
	FractureCore = {
		id = "FractureCore",
		name = "Fracture Core",
		description = "A stabilised shard of the Warden's heart. Required for the Fracture Temper.",
		color = Color3.fromRGB(255, 210, 90),
		rarity = "Legendary",
		kind = "Component",
	},
	EmberTonic = {
		id = "EmberTonic",
		name = "Ember Tonic",
		description = "Restores 40% health over 2 seconds. Press H (or the tonic button) to drink.",
		color = Color3.fromRGB(255, 150, 90),
		rarity = "Common",
		kind = "Consumable",
	},
} :: { [string]: ItemDef }

ItemConfig.Order = { "Iron", "Cobalt", "Emberstone", "EssenceShard", "BossSigil", "FractureCore", "EmberTonic" }

function ItemConfig.isValid(id: any): boolean
	return type(id) == "string" and ItemConfig.Items[id] ~= nil
end

return ItemConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">MonetizationConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Central monetization configuration.
-- ALL IDS ARE 0 (UNSET) ON PURPOSE. Create the products on the Roblox Creator Dashboard
-- (Monetization > Passes / Developer Products), then paste the numeric ids here.
-- An id of 0 makes the store show "Unavailable" and no purchase prompt is ever opened.
-- Nothing here sells power or random rewards.

local MonetizationConfig = {}

MonetizationConfig.GamePasses = {
	ExtraLoadouts = {
		id = 0,
		key = "ExtraLoadouts",
		displayName = "Loadout Archive",
		description = "+3 saved loadout slots. Pure convenience.",
	},
	AuraPack = {
		id = 0,
		key = "AuraPack",
		displayName = "Resonant Aura Pack",
		description = "Cosmetic: awakening auras gain a prismatic shimmer.",
	},
}

MonetizationConfig.Products = {
	SupporterDye = {
		id = 0,
		key = "SupporterDye",
		displayName = "Supporter Dye Pack",
		description = "Cosmetic: unlocks the Prismatic Edge katana trail. Granted once; re-purchasing has no extra effect.",
		grant = { cosmetic = "Prismatic" },
	},
}

MonetizationConfig.PassOrder = { "ExtraLoadouts", "AuraPack" }
MonetizationConfig.ProductOrder = { "SupporterDye" }

function MonetizationConfig.isConfigured(entry: { id: number }): boolean
	return type(entry.id) == "number" and entry.id > 0
end

return MonetizationConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">ProgressionConfig</string>
            <string name="Source"><![CDATA[--!strict
-- XP curves and level unlocks. The pure maths live in Shared/Progression/Leveling.luau.

local ProgressionConfig = {}

ProgressionConfig.MaxLevel = 40

function ProgressionConfig.levelXp(level: number): number
	return math.floor(100 * level ^ 1.45)
end

function ProgressionConfig.weaponMasteryXp(level: number): number
	return math.floor(60 * level ^ 1.4)
end

function ProgressionConfig.essenceMasteryXp(level: number): number
	return math.floor(45 * level ^ 1.35)
end

ProgressionConfig.LevelUnlocks = {
	[2] = "Daily challenges appear on the Quest Board.",
	[3] = "Secondary essence slot.",
	[4] = "Second saved loadout slot.",
	[5] = "Gravity attunement available at the Fusion Chamber.",
}

ProgressionConfig.FreeLoadoutSlots = 2
ProgressionConfig.PassLoadoutSlots = 3 -- extra slots from the optional game pass

-- Achievements: unlocked by ProgressionService when the matching stat/event happens.
ProgressionConfig.Achievements = {
	FirstSteel = { id = "FirstSteel", name = "First Steel", description = "Land your first katana strike." },
	PerfectGuard = { id = "PerfectGuard", name = "Perfect Guard", description = "Perform a perfect parry." },
	Unbroken = { id = "Unbroken", name = "Unbroken", description = "Perform 25 perfect parries.", stat = "perfectParries", target = 25 },
	SecondSoul = { id = "SecondSoul", name = "Second Soul", description = "Unlock a second essence." },
	FirstFusion = { id = "FirstFusion", name = "Impossible Union", description = "Unlock your first fusion technique." },
	FirstAwakening = { id = "FirstAwakening", name = "Resonant", description = "Activate a Resonance Awakening." },
	Evolved = { id = "Evolved", name = "Living Steel", description = "Evolve your katana." },
	SecretKeeper = { id = "SecretKeeper", name = "Secret Keeper", description = "Discover the Sunfall Chamber." },
	Bonded = { id = "Bonded", name = "Bonded", description = "Trigger a Cooperative Resonance." },
	Extractor = { id = "Extractor", name = "Safe Hands", description = "Extract from 10 expeditions.", stat = "extractions", target = 10 },
	DeepDelver = { id = "DeepDelver", name = "Deep Delver", description = "Extract from the Keep Beacon." },
	WardenSlayer = { id = "WardenSlayer", name = "Seal Breaker", description = "Defeat the Fracture Warden." },
	Prospector = { id = "Prospector", name = "Prospector", description = "Mine 100 ore.", stat = "oreMined", target = 100 },
}

ProgressionConfig.AchievementOrder = {
	"FirstSteel",
	"PerfectGuard",
	"Unbroken",
	"SecondSoul",
	"FirstFusion",
	"FirstAwakening",
	"Evolved",
	"SecretKeeper",
	"Bonded",
	"Extractor",
	"DeepDelver",
	"WardenSlayer",
	"Prospector",
}

-- Cosmetics earned through play (no Robux). Paid cosmetics are listed in MonetizationConfig.
ProgressionConfig.Cosmetics = {
	Default = { id = "Default", name = "Riftsteel", color = nil, source = "Starter" },
	Wardenbane = {
		id = "Wardenbane",
		name = "Wardenbane Edge",
		color = Color3.fromRGB(255, 80, 120),
		source = "Achievement: Seal Breaker",
		achievement = "WardenSlayer",
	},
	Parrymaster = {
		id = "Parrymaster",
		name = "Mirror Edge",
		color = Color3.fromRGB(200, 255, 250),
		source = "Achievement: Unbroken",
		achievement = "Unbroken",
	},
	Prismatic = {
		id = "Prismatic",
		name = "Prismatic Edge",
		color = Color3.fromRGB(255, 140, 255),
		source = "Supporter Dye Pack (optional purchase)",
		product = "SupporterDye",
	},
}
ProgressionConfig.CosmeticOrder = { "Default", "Wardenbane", "Parrymaster", "Prismatic" }

return ProgressionConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">QuestConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Quests track server-validated gameplay events recorded through QuestService.record.
-- Adding a quest = adding a table entry; no other system needs to change.

export type Objective = { event: string, filter: { [string]: any }?, count: number, label: string }

local QuestConfig = {}

QuestConfig.Quests = {
	-- Main path (doubles as the onboarding tutorial)
	m01_steel = {
		id = "m01_steel",
		category = "Main",
		title = "Steel and Spark",
		description = "Head to the Training Arena east of the plaza and strike the training dummies.",
		hint = "Left Mouse = light combo. V = heavy attack.",
		objectives = { { event = "Hit", filter = { targetKind = "Training" }, count = 8, label = "Strike training targets" } },
		rewards = { coins = 50, xp = 60 },
	},
	m02_guard = {
		id = "m02_guard",
		category = "Main",
		title = "The Perfect Guard",
		description = "Face the Sparring Golem. Block right before its strike lands, and dodge through its slam.",
		hint = "Right Mouse = block (tap just before impact for a Perfect Parry). Shift = dodge.",
		requires = { "m01_steel" },
		objectives = {
			{ event = "PerfectParry", count = 1, label = "Perfect parry" },
			{ event = "DodgeTelegraph", count = 1, label = "Dodge through a telegraphed attack" },
		},
		rewards = { coins = 75, xp = 80, items = { EmberTonic = 2 } },
	},
	m03_rift = {
		id = "m03_rift",
		category = "Main",
		title = "Through the Rift",
		description = "Read the expedition briefing at the Rift Portal (south) and enter Emberfall Frontier.",
		hint = "Walk into the portal and press E/F on the prompt.",
		requires = { "m02_guard" },
		objectives = { { event = "EnterRegion", filter = { region = "Frontier" }, count = 1, label = "Reach the Frontier" } },
		rewards = { coins = 40, xp = 60 },
	},
	m04_ore = {
		id = "m04_ore",
		category = "Main",
		title = "Ore of the Frontier",
		description = "Mine Iron Veins (grey rock with pale glints). Mined ore goes into your Satchel.",
		hint = "Hold the prompt on an Iron Vein.",
		requires = { "m03_rift" },
		objectives = { { event = "Mine", filter = { item = "Iron" }, count = 4, label = "Mine Iron Ore" } },
		rewards = { coins = 60, xp = 80 },
	},
	m05_stalkers = {
		id = "m05_stalkers",
		category = "Main",
		title = "Stalker Cull",
		description = "Rift Stalkers hunt in packs near the outpost. Defeat three.",
		hint = "Their lunge is a straight red line. Step aside, then punish.",
		requires = { "m04_ore" },
		objectives = { { event = "Kill", filter = { archetype = "RiftStalker" }, count = 3, label = "Defeat Rift Stalkers" } },
		rewards = { coins = 100, xp = 140, essence = "Storm" },
	},
	m06_extract = {
		id = "m06_extract",
		category = "Main",
		title = "Bring It Home",
		description = "Return to the Camp Beacon and bank your Satchel before something takes it from you.",
		hint = "Unbanked loot is at risk if you fall.",
		requires = { "m05_stalkers" },
		objectives = { { event = "Extract", count = 1, label = "Extract with loot" } },
		rewards = { coins = 80, xp = 100 },
	},
	m07_forge = {
		id = "m07_forge",
		category = "Main",
		title = "Temper the Blade",
		description = "Visit the Forge in the Nexus and upgrade your katana.",
		hint = "Upgrade to +2 costs 6 Iron and 120 coins.",
		requires = { "m06_extract" },
		objectives = { { event = "Upgrade", count = 1, label = "Upgrade a weapon" } },
		rewards = { coins = 100, xp = 120, items = { Iron = 4 } },
	},
	m08_keep = {
		id = "m08_keep",
		category = "Main",
		title = "The Ashen Sentinel",
		description = "Cross the Cinder Ravine, enter the Ruined Keep and defeat its champion.",
		hint = "Heavy attacks break guards. Its Shockwave ring has a safe centre.",
		requires = { "m07_forge" },
		objectives = { { event = "Kill", filter = { archetype = "AshenSentinel" }, count = 1, label = "Defeat the Ashen Sentinel" } },
		rewards = { coins = 250, xp = 300, essence = "Gravity" },
	},
	m09_secret = {
		id = "m09_secret",
		category = "Main",
		title = "Whispers in Stone",
		description = "A mural on the Frontier's north cliff speaks of three flames. Find what it hides.",
		hint = "Look at the mural, then find the three braziers.",
		requires = { "m08_keep" },
		objectives = { { event = "Discover", filter = { id = "SunfallChamber" }, count = 1, label = "Find the hidden chamber" } },
		rewards = { coins = 200, xp = 250 },
	},
	m10_warden = {
		id = "m10_warden",
		category = "Main",
		title = "Break the Warden",
		description = "Beyond the Keep lies the Fracture Arena. Challenge the Fracture Warden, ideally with friends.",
		hint = "Study its attacks: some can be parried, and its back hides a weakness.",
		requires = { "m09_secret" },
		objectives = { { event = "BossDefeated", filter = { boss = "FractureWarden" }, count = 1, label = "Defeat the Fracture Warden" } },
		rewards = { coins = 500, xp = 600 },
	},

	-- Exploration / discovery contracts
	x_cartographer = {
		id = "x_cartographer",
		category = "Exploration",
		title = "Cartographer",
		description = "Chart Emberfall: reach the Ruined Keep and the Fracture Arena.",
		requires = { "m03_rift" },
		objectives = {
			{ event = "EnterRegion", filter = { region = "Keep" }, count = 1, label = "Enter the Ruined Keep" },
			{ event = "EnterRegion", filter = { region = "Arena" }, count = 1, label = "See the Fracture Arena" },
		},
		rewards = { coins = 120, xp = 150 },
	},
	x_delver = {
		id = "x_delver",
		category = "Exploration",
		title = "Deep Delver",
		description = "Extract from the Keep Beacon, deep inside the Ruined Keep.",
		requires = { "m06_extract" },
		objectives = { { event = "Extract", filter = { beacon = "Keep" }, count = 1, label = "Extract at the Keep Beacon" } },
		rewards = { coins = 200, xp = 200, items = { EssenceShard = 2 } },
	},
	-- Gathering
	g_cobalt = {
		id = "g_cobalt",
		category = "Gathering",
		title = "Blue Fire",
		description = "Craft a Cobalt Pick at the Artisan Bench and mine Cobalt Crystal in the Keep.",
		requires = { "m07_forge" },
		objectives = { { event = "Mine", filter = { item = "Cobalt" }, count = 5, label = "Mine Cobalt Crystal" } },
		rewards = { coins = 150, xp = 160 },
	},
	-- Mastery challenge
	w_parry = {
		id = "w_parry",
		category = "Mastery",
		title = "Blade Discipline",
		description = "Perfect-parry 10 enemy attacks anywhere.",
		requires = { "m02_guard" },
		objectives = { { event = "PerfectParry", count = 10, label = "Perfect parries" } },
		rewards = { coins = 150, xp = 150, weaponMastery = 120 },
	},
	-- Cooperative
	c_bond = {
		id = "c_bond",
		category = "Coop",
		title = "Resonant Bond",
		description = "Trigger a Cooperative Resonance with another player (e.g. their Gravity + your Ember).",
		requires = { "m05_stalkers" },
		objectives = { { event = "Coop", count = 1, label = "Cooperative Resonance" } },
		rewards = { coins = 200, xp = 200, items = { EssenceShard = 3 } },
	},
	-- Boss contract (repeatable once per day)
	b_warden = {
		id = "b_warden",
		category = "Boss",
		title = "Warden Contract",
		description = "The Nexus pays for every Warden that falls. Repeatable daily.",
		requires = { "m08_keep" },
		daily = true,
		objectives = { { event = "BossDefeated", filter = { boss = "FractureWarden" }, count = 1, label = "Defeat the Fracture Warden" } },
		rewards = { coins = 300, xp = 300, items = { BossSigil = 1 } },
	},
}

-- Daily challenges: 3 are picked deterministically from this pool each UTC day.
QuestConfig.DailyPool = {
	{ id = "d_hunter", title = "Rift Hunter", objectives = { { event = "Kill", count = 12, label = "Defeat enemies" } }, rewards = { coins = 120, xp = 120 } },
	{ id = "d_miner", title = "Deep Veins", objectives = { { event = "Mine", count = 12, label = "Mine ore" } }, rewards = { coins = 100, xp = 100 } },
	{ id = "d_parry", title = "Iron Wall", objectives = { { event = "PerfectParry", count = 5, label = "Perfect parries" } }, rewards = { coins = 120, xp = 120 } },
	{ id = "d_extract", title = "Safe Return", objectives = { { event = "Extract", count = 2, label = "Extractions" } }, rewards = { coins = 140, xp = 120 } },
	{ id = "d_fusion", title = "Impossible Arts", objectives = { { event = "FusionCast", count = 3, label = "Cast fusion techniques" } }, rewards = { coins = 150, xp = 150, items = { EssenceShard = 1 } } },
	{ id = "d_coop", title = "Together", objectives = { { event = "Coop", count = 1, label = "Cooperative Resonance" } }, rewards = { coins = 180, xp = 150 } },
	{ id = "d_awaken", title = "Resonate", objectives = { { event = "Awaken", count = 2, label = "Awakenings" } }, rewards = { coins = 120, xp = 120 } },
	{ id = "d_dodge", title = "Untouchable", objectives = { { event = "DodgeTelegraph", count = 6, label = "Dodge telegraphed attacks" } }, rewards = { coins = 110, xp = 110 } },
}
QuestConfig.DailyCount = 3
QuestConfig.DailyLevel = 2

QuestConfig.Order = {
	"m01_steel",
	"m02_guard",
	"m03_rift",
	"m04_ore",
	"m05_stalkers",
	"m06_extract",
	"m07_forge",
	"m08_keep",
	"m09_secret",
	"m10_warden",
	"x_cartographer",
	"x_delver",
	"g_cobalt",
	"w_parry",
	"c_bond",
	"b_warden",
}

-- Returns the indices of today's daily challenges (deterministic per day key).
function QuestConfig.dailyPicks(dayKey: number): { number }
	local picks = {}
	local n = #QuestConfig.DailyPool
	local seed = dayKey
	while #picks < math.min(QuestConfig.DailyCount, n) do
		seed = (seed * 1103515245 + 12345) % 2147483648
		local idx = (seed % n) + 1
		if not table.find(picks, idx) then
			table.insert(picks, idx)
		end
	end
	return picks
end

function QuestConfig.matches(objective: Objective, event: string, data: { [string]: any }?): boolean
	if objective.event ~= event then
		return false
	end
	if objective.filter then
		if not data then
			return false
		end
		for key, value in objective.filter do
			if data[key] ~= value then
				return false
			end
		end
	end
	return true
end

return QuestConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">RecipeConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic forge and crafting recipes. Costs may include "Coins".
-- CraftingService validates every requirement server-side; the client only previews.

local RecipeConfig = {}

-- Katana upgrade costs indexed by the TARGET level (2..5).
RecipeConfig.Upgrades = {
	Katana = {
		[2] = { cost = { Iron = 6, Coins = 120 }, level = 1 },
		[3] = { cost = { Iron = 10, Cobalt = 3, Coins = 280 }, level = 3 },
		[4] = { cost = { Cobalt = 8, Emberstone = 6, Coins = 600 }, level = 6 },
		[5] = { cost = { Cobalt = 10, BossSigil = 2, Coins = 1000 }, level = 9 },
	},
}

RecipeConfig.Tempers = {
	Swift = { cost = { Iron = 8, Emberstone = 3, Coins = 200 } },
	Heavy = { cost = { Iron = 12, Coins = 220 } },
	Guard = { cost = { Cobalt = 5, Coins = 260 } },
	Resonant = { cost = { EssenceShard = 6, Emberstone = 4, Coins = 300 }, blueprint = "SunfallBlueprint" },
	Fracture = { cost = { FractureCore = 1, BossSigil = 2, Coins = 800 } },
	None = { cost = {} },
}

RecipeConfig.Crafts = {
	CobaltPick = {
		id = "CobaltPick",
		displayName = "Cobalt Pick",
		description = "Mining tool tier 2. Lets you harvest Cobalt Crystal.",
		cost = { Iron = 10, Coins = 120 },
		result = { kind = "Tool", tier = 2 },
		once = true,
	},
	EmberTonic = {
		id = "EmberTonic",
		displayName = "Ember Tonic x2",
		description = "Two healing tonics (40% health each).",
		cost = { Emberstone = 2, EssenceShard = 1 },
		result = { kind = "Item", item = "EmberTonic", amount = 2 },
	},
	FractureCore = {
		id = "FractureCore",
		displayName = "Fracture Core",
		description = "Guaranteed alternative to the Warden's rare drop.",
		cost = { BossSigil = 4, Cobalt = 6 },
		result = { kind = "Item", item = "FractureCore", amount = 1 },
	},
	ShardCondenser = {
		id = "ShardCondenser",
		displayName = "Condense Essence Shard",
		description = "Refine raw ore into one Essence Shard.",
		cost = { Iron = 6, Emberstone = 2, Coins = 60 },
		result = { kind = "Item", item = "EssenceShard", amount = 1 },
	},
}

RecipeConfig.CraftOrder = { "CobaltPick", "EmberTonic", "ShardCondenser", "FractureCore" }

-- Changing evolution branch never deletes mastery; it only costs coins.
RecipeConfig.EvolutionRespec = { cost = { Coins = 500 } }

return RecipeConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">ResourceConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Mineable nodes. `charges` = harvests before depletion; respawn in seconds.

