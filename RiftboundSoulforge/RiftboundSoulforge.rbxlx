        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">CoopConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Cooperative Resonance: two different players, complementary abilities, short window.
-- Fully server-validated in CombatService (CoopResonance section).

local CoopConfig = {}

CoopConfig.Window = 3.0 -- seconds between primer and detonator
CoopConfig.PairCooldown = 6 -- seconds before the same two players can trigger the same combo again
CoopConfig.MaxDistance = 60 -- both players must be within this distance of the target

CoopConfig.Combos = {
	SingularityDetonation = {
		id = "SingularityDetonation",
		displayName = "Singularity Detonation",
		description = "One player Gathers enemies with Gravity, another detonates them with Ember.",
		primerTag = "Gathered",
		detonatorEssence = "Ember",
		effect = "Explosion",
		radius = 12,
		damage = 40,
		color = Color3.fromRGB(255, 140, 60),
	},
	ConductiveCollapse = {
		id = "ConductiveCollapse",
		displayName = "Conductive Collapse",
		description = "One player Charges enemies with Storm, another pulls them together with Gravity.",
		primerTag = "Charged",
		detonatorEssence = "Gravity",
		effect = "ChainBurst",
		radius = 14,
		damage = 32,
		color = Color3.fromRGB(120, 200, 255),
	},
	Breach = {
		id = "Breach",
		displayName = "Warden Breach",
		description = "One player perfect-parries the Fracture Warden, another strikes its exposed weak point within 2.5s.",
		boss = true,
		window = 2.5,
		damage = 0, -- resolved by BossService (percentage of max health)
		color = Color3.fromRGB(255, 230, 120),
	},
}

CoopConfig.Order = { "SingularityDetonation", "ConductiveCollapse", "Breach" }

return CoopConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">DiscoveryConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Codex discoveries. Undiscovered entries show only their hint.

local DiscoveryConfig = {}

DiscoveryConfig.Discoveries = {
	SunfallChamber = {
		id = "SunfallChamber",
		displayName = "The Sunfall Chamber",
		category = "Secret",
		hint = "Three flames remember the order of the sky.",
		text = "A sealed chamber behind the Frontier cliffs. Its tablet describes a sun that collapses into itself.",
	},
	SunfallTablet = {
		id = "SunfallTablet",
		displayName = "Sunfall Tablet",
		category = "Fusion",
		hint = "Something in the Sunfall Chamber can be read.",
		text = "Teaches the theory of Collapsing Sun (Ember + Gravity) and the Resonant Temper blueprint.",
	},
	WardenLanceWeakness = {
		id = "WardenLanceWeakness",
		displayName = "Warden Weakness: Rift Lance",
		category = "Boss",
		hint = "One of the Warden's attacks can be turned back on it.",
		text = "A perfect parry against Rift Lance staggers the Warden and exposes the crystal on its back.",
	},
	WardenBackCrystal = {
		id = "WardenBackCrystal",
		displayName = "Warden Weakness: Back Crystal",
		category = "Boss",
		hint = "The Warden hides something behind it.",
		text = "When the crystal on its back glows, strikes from behind deal double damage.",
	},
	RavineShortcut = {
		id = "RavineShortcut",
		displayName = "Ravine Drawbridge",
		category = "World",
		hint = "There must be an easier way back across the ravine.",
		text = "A lever on the far side of the Cinder Ravine lowers a drawbridge for everyone in the server.",
	},
}

DiscoveryConfig.Order = { "SunfallChamber", "SunfallTablet", "RavineShortcut", "WardenLanceWeakness", "WardenBackCrystal" }

return DiscoveryConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">EnemyConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Enemy archetypes. Behaviour ids map to brains in ServerScriptService/Server/Combat/EnemyBrains.luau.
-- Attack shapes: "Line" (rectangle in front), "Circle" (around self or at target), "Ring" (donut around self).
-- Every attack is telegraphed for its full windup; hit tests use exactly the telegraphed shape.

local EnemyConfig = {}

EnemyConfig.Enemies = {
	RiftStalker = {
		id = "RiftStalker",
		displayName = "Rift Stalker",
		kind = "Standard",
		behaviour = "Stalker",
