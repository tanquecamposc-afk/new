          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!strict
-- Camera feel: trauma-based shake, FOV punches and brief screen flashes ("impact frames").
-- All scaled by the Camera Shake / Effects accessibility settings.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local ClientState = require(script.Parent.Parent.ClientState)

local CameraController = {}

local trauma = 0
local fovOffset = 0
local flashFrame: Frame? = nil

function CameraController.shake(intensity: number)
	local scale = ClientState.settings().cameraShake
	trauma = math.min(1, trauma + intensity * scale)
end

-- Quick field-of-view kick that springs back (heavy hits, awakenings).
function CameraController.punch(degrees: number)
	fovOffset = math.clamp(fovOffset + degrees * ClientState.settings().cameraShake, -12, 12)
end

function CameraController.flash(color: Color3, strength: number)
	local frame = flashFrame
	if not frame then
		return
	end
	local s = strength * ClientState.settings().effects
	if s <= 0.05 then
		return
	end
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = 1 - math.clamp(s, 0, 0.6)
	TweenService:Create(frame, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
end

function CameraController.init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "ImpactFlash"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 50
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Active = false
	frame.Parent = gui
	flashFrame = frame

	local baseFov = 70
	RunService:BindToRenderStep("RiftShake", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local camera = workspace.CurrentCamera
		if math.abs(fovOffset) > 0.01 then
			camera.FieldOfView = baseFov + fovOffset
			fovOffset *= math.max(0, 1 - dt * 7)
		elseif camera.FieldOfView ~= baseFov then
			camera.FieldOfView = baseFov
		end
		if trauma <= 0 then
			return
		end
		local amount = trauma * trauma
		local t = os.clock() * 40
		local offset = CFrame.Angles(
			math.rad(math.noise(t, 0) * 2.2 * amount),
			math.rad(math.noise(0, t) * 2.2 * amount),
			math.rad(math.noise(t, t) * 1.2 * amount)
		)
		camera.CFrame = camera.CFrame * offset
		trauma = math.max(0, trauma - dt * 1.8)
	end)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">CombatController</string>
              <string name="Source"><![CDATA[--!strict
-- Client side of combat: immediate local feedback (pose, trail, dodge movement, facing) and
-- REQUESTS to the server. Local timers only gate spam; the server re-validates everything.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local CombatMath = require(Shared.Combat.CombatMath)
local EssenceConfig = require(Shared.Config.EssenceConfig)
local GameConfig = require(Shared.Config.GameConfig)
local ClientState = require(script.Parent.Parent.ClientState)
local AnimationController = require(script.Parent.AnimationController)
local EffectsController = require(script.Parent.EffectsController)
local CameraController = require(script.Parent.CameraController)
local SoundController = require(script.Parent.SoundController)

local CombatController = {}

local player = Players.LocalPlayer
local remote: RemoteEvent
local busyUntil = 0
local comboIndex = 0
local lastLight = 0
local dodgeReadyAt = 0
local blocking = false
local lockMarker: BillboardGui? = nil

local function character(): (Model?, BasePart?, Humanoid?)
	local c = player.Character
	local root = c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = c and c:FindFirstChildOfClass("Humanoid")
	if not c or not root or not humanoid or humanoid.Health <= 0 then
		return nil, nil, nil
	end
	return c, root, humanoid
end

local function build()
	local profile = ClientState.profile
	if not profile then
		return CombatMath.weaponBuild("Katana", { mastery = 1, upgrade = 1, temper = "None", evolution = "None" })
	end
	return CombatMath.weaponBuild("Katana", profile.weapons.Katana)
end

local function speedMult(b: any): number
	local s = b.attackSpeed
	if player:GetAttribute("Awakened") and player:GetAttribute("AwakenForm") == "Storm" then
		s *= 1.3
	end
	return s
end

-- Aim direction: lock target > camera look (flattened).
local function aimDirection(root: BasePart): Vector3
	local target = ClientState.lockTarget
	local targetRoot = target and target.Parent and target:FindFirstChild("HumanoidRootPart") :: BasePart?
	if targetRoot then
		local flat = Vector3.new(targetRoot.Position.X - root.Position.X, 0, targetRoot.Position.Z - root.Position.Z)
		if flat.Magnitude > 0.5 then
			return flat.Unit
		end
	end
	local look = workspace.CurrentCamera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.1 then
		flat = root.CFrame.LookVector
	end
	return flat.Unit
end

local function face(root: BasePart, dir: Vector3)
	root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
end

-- Aim point for targeted abilities.
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local function aimPoint(root: BasePart): Vector3
	local target = ClientState.lockTarget
	local targetRoot = target and target.Parent and target:FindFirstChild("HumanoidRootPart") :: BasePart?
	if targetRoot then
		return targetRoot.Position
	end
	if UserInputService.MouseEnabled and not UserInputService.TouchEnabled then
		local mouse = UserInputService:GetMouseLocation()
		local ray = workspace.CurrentCamera:ViewportPointToRay(mouse.X, mouse.Y)
		rayParams.FilterDescendantsInstances = { player.Character :: Instance, workspace:FindFirstChild("ClientFX") :: Instance, workspace:FindFirstChild("Telegraphs") :: Instance }
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 200, rayParams)
		if hit then
			return hit.Position
		end
	end
	return root.Position + aimDirection(root) * 14
end

function CombatController.light()
	local c, root = character()
	if not c or not root or blocking then
		return
	end
	local now = os.clock()
	if now < busyUntil then
		return
	end
	local b = build()
	local count = #b.light
	if now - lastLight <= b.comboResetTime + 0.6 then
		comboIndex = (comboIndex % count) + 1
	else
		comboIndex = 1
	end
	lastLight = now
	local strike = b.light[comboIndex]
	local speed = speedMult(b)
	busyUntil = now + (strike.windup + strike.recovery) / speed
	local dir = aimDirection(root)
	face(root, dir)
	AnimationController.swing(c, comboIndex, false, strike.windup / speed)
	EffectsController.slash(c, comboIndex, player:GetAttribute("TrailColor"), false, strike.windup / speed * 0.7)
	SoundController.play("LightAttack")
	remote:FireServer("Light", { dir = dir })
end

function CombatController.heavy()
	local c, root = character()
	if not c or not root or blocking then
		return
	end
	local now = os.clock()
	if now < busyUntil then
		return
	end
	local b = build()
	if (player:GetAttribute("Stamina") or 0) < b.heavy.stamina then
		EffectsController.floatText(root.Position + Vector3.new(0, 4, 0), "NO STAMINA", Color3.fromRGB(255, 160, 120), 22, 0.6)
		return
	end
	local speed = b.attackSpeed
	busyUntil = now + (b.heavy.windup + b.heavy.recovery) / speed
	comboIndex = 0
	local dir = aimDirection(root)
	face(root, dir)
	AnimationController.swing(c, 0, true, b.heavy.windup / speed)
	EffectsController.slash(c, 0, player:GetAttribute("TrailColor"), true, b.heavy.windup / speed * 0.8)
	task.delay(b.heavy.windup / speed, function()
		CameraController.punch(4)
	end)
	SoundController.play("HeavyAttack")
	remote:FireServer("Heavy", { dir = dir })
end

function CombatController.block(active: boolean)
	local c = character()
	if not c then
		return
	end
	if active == blocking then
		return
	end
	blocking = active
	AnimationController.block(c, active)
	remote:FireServer(if active then "BlockStart" else "BlockEnd", {})
end

function CombatController.dodge()
	local c, root, humanoid = character()
	if not c or not root or not humanoid then
		return
	end
	local now = os.clock()
	local b = build()
	if now < dodgeReadyAt or now < busyUntil - 0.1 then
		return
	end
	if (player:GetAttribute("Stamina") or 0) < b.dodge.stamina then
		return
	end
	if blocking then
		CombatController.block(false)
	end
	local cooldown = b.dodgeCooldown
	if player:GetAttribute("Awakened") and player:GetAttribute("AwakenForm") == "Storm" then
		cooldown *= 0.5
	end
	dodgeReadyAt = now + cooldown
	busyUntil = now + b.dodge.duration
	comboIndex = 0
	local move = humanoid.MoveDirection
	local dir = if move.Magnitude > 0.1 then Vector3.new(move.X, 0, move.Z).Unit else -Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit
	remote:FireServer("Dodge", { dir = dir })
	AnimationController.play(c, "Dodge")
	EffectsController.burst(root.Position, Color3.fromRGB(200, 220, 255), 10, 8)
	local finish = now + b.dodge.duration
	local connection
	connection = RunService.Heartbeat:Connect(function()
		if os.clock() >= finish or not root.Parent then
			connection:Disconnect()
			return
		end
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(dir.X * b.dodge.speed, math.min(v.Y, 5), dir.Z * b.dodge.speed)
	end)
end

function CombatController.ability(slot: string)
	local c, root = character()
	if not c or not root or blocking then
		return
	end
	local cd = ClientState.cooldowns[slot]
	if cd and cd.endsAt > ClientState.serverNow() + 0.05 then
		return
	end
	if os.clock() < busyUntil then
		return
	end
	busyUntil = os.clock() + 0.35
	local point = aimPoint(root)
	local flat = Vector3.new(point.X - root.Position.X, 0, point.Z - root.Position.Z)
	if flat.Magnitude > 1 then
		face(root, flat.Unit)
	end
	AnimationController.cast(c)
	remote:FireServer("Ability", { slot = slot, aim = point })
end

function CombatController.awaken()
	if character() then
		remote:FireServer("Awaken", {})
	end
end

function CombatController.tonic()
	if character() then
		remote:FireServer("Tonic", {})
	end
end

-- Lock-on targeting ----------------------------------------------------------------------------

local function clearLock()
	ClientState.lockTarget = nil
	if lockMarker then
		lockMarker:Destroy()
		lockMarker = nil
	end
	ClientState.Changed:Fire("lock")
end

function CombatController.toggleLock()
	if ClientState.lockTarget then
		clearLock()
		return
	end
	local _, root = character()
	local enemies = workspace:FindFirstChild("Enemies")
	if not root or not enemies then
		return
	end
	local camLook = workspace.CurrentCamera.CFrame.LookVector
	local best, bestScore = nil, math.huge
	for _, model in enemies:GetChildren() do
		local r = model:FindFirstChild("HumanoidRootPart") :: BasePart?
		if r then
			local offset = r.Position - root.Position
			local d = offset.Magnitude
			if d < 60 then
				local facing = Vector3.new(offset.X, 0, offset.Z).Unit:Dot(Vector3.new(camLook.X, 0, camLook.Z).Unit)
				local score = d * (1.6 - facing)
				if score < bestScore then
					best, bestScore = model, score
				end
			end
		end
	end
	if best then
		ClientState.lockTarget = best
		local r = best:FindFirstChild("HumanoidRootPart") :: BasePart
		local gui = Instance.new("BillboardGui")
		gui.Name = "LockMarker"
		gui.Size = UDim2.fromOffset(46, 46)
		gui.AlwaysOnTop = true
		gui.Adornee = r
		gui.Parent = player:WaitForChild("PlayerGui")
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = "◎"
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 240, 160)
		label.TextStrokeTransparency = 0.3
		label.Parent = gui
		lockMarker = gui
		ClientState.Changed:Fire("lock")
	end
end

-- Server feedback ------------------------------------------------------------------------------

local function onFeedback(kind: string, data: any)
	local c, root = character()
	if kind == "Hits" then
		for _, hit in data.hits do
			local color = if hit.guarded then Color3.fromRGB(160, 170, 190) else Color3.fromRGB(255, 255, 255)
			EffectsController.damageNumber(hit.position, hit.amount, color, data.finisher)
			EffectsController.burst(hit.position, Color3.fromRGB(255, 240, 220), 10, 16)
			if hit.guarded then
				EffectsController.floatText(hit.position + Vector3.new(0, 5, 0), "GUARDED", color, 22, 0.6)
			end
		end
		SoundController.play("EnemyHit")
		CameraController.shake(if data.finisher then 0.3 else 0.12)
		if data.finisher then
			CameraController.flash(Color3.new(1, 1, 1), 0.25)
			CameraController.punch(-3)
		end
		if c then
			AnimationController.hitStop(c, GameConfig.Combat.HitStop)
		end
	elseif kind == "Rejected" then
		busyUntil = 0 -- resync with the server's view
		local reason = data and data.reason
		if root and type(reason) == "string" and reason ~= "busy" and reason ~= "cooldown" and reason ~= "dead" then
			EffectsController.floatText(root.Position + Vector3.new(0, 4, 0), reason, Color3.fromRGB(255, 180, 140), 20, 1.0)
		end
	elseif kind == "Parry" and root then
		CameraController.flash(Color3.fromRGB(255, 250, 220), 0.35)
		SoundController.play("ParrySuccess")
		CameraController.shake(0.3)
		EffectsController.floatText(root.Position + Vector3.new(0, 5, 0), "PERFECT PARRY", Color3.fromRGB(255, 240, 180), 34, 0.9)
	elseif kind == "Evaded" and root then
		EffectsController.floatText(root.Position + Vector3.new(0, 4, 0), "EVADED", Color3.fromRGB(180, 220, 255), 26, 0.7)
	elseif kind == "Blocked" and root then
		EffectsController.burst(root.Position + root.CFrame.LookVector * 2, Color3.fromRGB(200, 210, 230), 10, 10)
	elseif kind == "GuardBroken" and root then
		blocking = false
		if c then
			AnimationController.block(c, false)
		end
		EffectsController.floatText(root.Position + Vector3.new(0, 4, 0), "GUARD BROKEN", Color3.fromRGB(255, 120, 120), 30, 1)
		CameraController.shake(0.4)
	elseif kind == "Hurt" then
		if c and (data.amount or 0) >= 8 then
			AnimationController.play(c, "Hurt")
			CameraController.flash(Color3.fromRGB(255, 40, 40), 0.18)
		end
		CameraController.shake(math.clamp((data.amount or 10) / 40, 0.1, 0.6))
	elseif kind == "Interrupt" then
		EffectsController.floatText(data.position + Vector3.new(0, 6, 0), "INTERRUPT!", Color3.fromRGB(120, 255, 200), 30, 0.9)
	elseif kind == "WeakPoint" and root then
		EffectsController.floatText(root.Position + root.CFrame.LookVector * 6 + Vector3.new(0, 6, 0), "WEAK POINT x2", Color3.fromRGB(255, 230, 120), 26, 0.6)
	elseif kind == "Immune" and root then
		EffectsController.floatText(root.Position + root.CFrame.LookVector * 6 + Vector3.new(0, 6, 0), "IMMUNE", Color3.fromRGB(200, 200, 220), 22, 0.5)
	elseif kind == "ResonanceFull" then
		ClientState.toast("Resonance", "Resonance full! Press G to AWAKEN.")
	elseif kind == "Suppressed" then
		ClientState.toast("Error", "Your Awakening was suppressed!")
	end
end

-- Abilities shown on the HUD (slot -> ability def or nil + lock reason), derived from profile.
function CombatController.slotInfo(slot: string): (any?, string?)
	local profile = ClientState.profile
	if not profile then
		return nil, "Loading"
	end
	local primary = profile.loadout.primary
	if slot == "Q" or slot == "E" then
		local essence = EssenceConfig.Essences[primary]
		if not essence then
			return nil, "No essence"
		end
		local ability = EssenceConfig.Abilities[essence.abilities[slot]]
		local record = profile.essences[primary]
		if record.mastery < ability.masteryRequired then
			return ability, string.format("%s mastery %d", essence.displayName, ability.masteryRequired)
		end
		return ability, nil
	end
	local FusionConfig = require(Shared.Config.FusionConfig)
	local fusionId = FusionConfig.forPair(primary, profile.loadout.secondary)
	if not fusionId then
		return nil, "Equip 2 essences"
	end
	local def = FusionConfig.Fusions[fusionId]
	local record = profile.fusions[fusionId]
	if not def.implemented then
		return nil, "Unavailable"
	end
	if not record or not record.unlocked then
		return EssenceConfig.Abilities[def.ability], "Locked (Codex)"
	end
	return EssenceConfig.Abilities[def.ability], nil
end

function CombatController.init()
	remote = Net.event("CombatAction")
	Net.event("CombatFeedback").OnClientEvent:Connect(function(kind, data)
		local ok, err = pcall(onFeedback, kind, data or {})
		if not ok then
			warn("[Combat] feedback error: " .. tostring(err))
		end
	end)
	player.CharacterAdded:Connect(function()
		busyUntil = 0
		comboIndex = 0
		blocking = false
		clearLock()
	end)
	-- drop the lock when the target dies or leaves range
	RunService.Heartbeat:Connect(function()
		local target = ClientState.lockTarget
		if target then
			local r = target.Parent and target:FindFirstChild("HumanoidRootPart") :: BasePart?
			local _, root = character()
			if not r or not root or (r.Position - root.Position).Magnitude > 80 then
				clearLock()
			end
		end
	end)
end

return CombatController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[--!strict
-- All cosmetic effects. Driven by server "Effect" broadcasts and local feedback. Nothing here
-- affects gameplay. Effects scale with the Effects Intensity setting; Reduced Clutter hides
-- other players' minor effects but never hides telegraphs.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local ClientState = require(script.Parent.Parent.ClientState)
local CameraController = require(script.Parent.CameraController)
local AnimationController = require(script.Parent.AnimationController)
local SoundController = require(script.Parent.SoundController)

local EffectsController = {}

local player = Players.LocalPlayer
local folder: Folder

local function fxScale(): number
	return ClientState.settings().effects
end

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = props.material or Enum.Material.Neon
	p.Color = props.color or Color3.new(1, 1, 1)
	p.Transparency = props.transparency or 0
	p.Size = props.size or Vector3.one
	p.Shape = props.shape or Enum.PartType.Block
	p.CFrame = props.cframe or CFrame.new()
	p.Parent = folder
	return p
end

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

function EffectsController.sphere(position: Vector3, fromSize: number, toSize: number, color: Color3, duration: number, startTransparency: number?)
	local p = part({ shape = Enum.PartType.Ball, size = Vector3.one * fromSize, cframe = CFrame.new(position), color = color, transparency = startTransparency or 0.2 })
	tween(p, duration, { Size = Vector3.one * toSize, Transparency = 1 })
	Debris:AddItem(p, duration + 0.05)
	return p
end

function EffectsController.ring(position: Vector3, radius: number, color: Color3, duration: number)
	local p = part({
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(0.3, 1, 1),
		cframe = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
		color = color,
		transparency = 0.2,
	})
	tween(p, duration, { Size = Vector3.new(0.3, radius * 2, radius * 2), Transparency = 1 })
	Debris:AddItem(p, duration + 0.05)
end

function EffectsController.beam(points: { Vector3 }, color: Color3, duration: number, width: number?, jagged: boolean?)
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local segments = if jagged then 4 else 1
		local prev = a
		for s = 1, segments do
			local target = a:Lerp(b, s / segments)
			if jagged and s < segments then
				target += Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2.5
			end
			local length = (target - prev).Magnitude
			if length > 0.05 then
				local p = part({
					size = Vector3.new(width or 0.35, width or 0.35, length),
					cframe = CFrame.lookAt((prev + target) / 2, target),
					color = color,
				})
				tween(p, duration, { Transparency = 1, Size = Vector3.new(0.05, 0.05, length) })
				Debris:AddItem(p, duration + 0.05)
			end
			prev = target
		end
	end
end

function EffectsController.burst(position: Vector3, color: Color3, count: number, speed: number?)
	local n = math.floor(count * fxScale())
	if n <= 0 then
		return
	end
	local holder = part({ size = Vector3.one * 0.2, cframe = CFrame.new(position), transparency = 1 })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Rate = 0
	emitter.Speed = NumberRange.new((speed or 14) * 0.5, speed or 14)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(0.25, 0.6)
	emitter.Drag = 4
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	emitter.Parent = holder
	emitter:Emit(n)
	Debris:AddItem(holder, 1)
end

function EffectsController.floatText(position: Vector3, text: string, color: Color3, size: number?, duration: number?)
	local holder = part({ size = Vector3.one * 0.2, cframe = CFrame.new(position), transparency = 1 })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, size or 34)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 120
	gui.Parent = holder
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	local d = duration or 0.8
	tween(holder, d, { CFrame = CFrame.new(position + Vector3.new(math.random(-10, 10) / 10, 3, 0)) })
	tween(label, d, { TextTransparency = 1, TextStrokeTransparency = 1 }, Enum.EasingStyle.Quint)
	Debris:AddItem(holder, d + 0.05)
end

function EffectsController.damageNumber(position: Vector3, amount: number, color: Color3?, big: boolean?)
	EffectsController.floatText(position + Vector3.new(0, 2.5, 0), tostring(amount), color or Color3.new(1, 1, 1), if big then 40 else 28, 0.7)
end

local function flash(model: Instance?, color: Color3, duration: number)
	if not model or not model:IsA("Model") then
		return
	end
	local highlight = Instance.new("Highlight")
	highlight.FillColor = color
	highlight.OutlineColor = color
	highlight.FillTransparency = 0.4
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Adornee = model
	highlight.Parent = folder
	tween(highlight, duration, { FillTransparency = 1, OutlineTransparency = 1 })
	Debris:AddItem(highlight, duration + 0.05)
end
EffectsController.flash = flash

local function rootOf(character: any): BasePart?
	if typeof(character) ~= "Instance" or not character.Parent then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function nearLocal(position: Vector3, range: number): number
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return 0
	end
	local d = (root.Position - position).Magnitude
	return math.clamp(1 - d / range, 0, 1)
end

local function isOther(character: any): boolean
	return character ~= player.Character
end

local function clutter(character: any): boolean
	return ClientState.settings().reducedClutter and isOther(character)
end

-- Anime-style crescent slash: a tapered neon arc swept around the character.
-- index picks the arc plane (matches the procedural animation of that strike).
local ARCS = {
	{ tilt = 0, from = -85, to = 85, radius = 6.5 }, -- 1 right -> left
	{ tilt = 12, from = 85, to = -85, radius = 6.5 }, -- 2 backhand
	{ tilt = -55, from = -80, to = 90, radius = 7 }, -- 3 rising diagonal
	{ tilt = 88, from = -70, to = 95, radius = 7.5 }, -- 4 overhead cleave
	{ tilt = 0, from = -25, to = 25, radius = 9 }, -- 5 thrust burst
}

function EffectsController.slash(character: any, index: number, color: Color3?, heavy: boolean?, delay: number?)
	local root = rootOf(character)
	if not root then
		return
	end
	local arc = if heavy then { tilt = 80, from = -100, to = 75, radius = 10 } else ARCS[((math.max(1, index) - 1) % #ARCS) + 1]
	local c = color or Color3.fromRGB(235, 240, 255)
	local segments = if fxScale() < 0.5 then 8 else 14
	local width = if heavy then 2.6 else 1.7
	task.delay(delay or 0, function()
		if not root.Parent then
			return
		end
		local base = root.CFrame * CFrame.new(0, 0.6, -0.5) * CFrame.Angles(0, 0, math.rad(arc.tilt))
		local normal = base.UpVector
		local function point(i: number): Vector3
			local theta = arc.from + (arc.to - arc.from) * (i / segments)
			return (base * CFrame.Angles(0, math.rad(theta), 0) * CFrame.new(0, 0, -arc.radius)).Position
		end
		local sweep = if heavy then 0.12 else 0.08
		for i = 0, segments - 1 do
			task.delay(sweep * i / segments, function()
				local a, b = point(i), point(i + 1)
				local length = (b - a).Magnitude + 0.15
				local taper = math.sin(math.pi * (i + 0.5) / segments)
				local cf = CFrame.lookAt((a + b) / 2, b, normal)
				local outer = part({ size = Vector3.new(width * taper + 0.15, 0.08, length), cframe = cf, color = c, transparency = 0.15 })
				tween(outer, 0.22, { Transparency = 1, Size = Vector3.new(0.05, 0.05, length) })
				Debris:AddItem(outer, 0.25)
				if fxScale() >= 0.5 then
					local core = part({ size = Vector3.new(width * taper * 0.35 + 0.05, 0.1, length), cframe = cf, color = Color3.new(1, 1, 1), transparency = 0 })
					tween(core, 0.16, { Transparency = 1 })
					Debris:AddItem(core, 0.2)
				end
			end)
		end
	end)
end

-- Handlers ----------------------------------------------------------------------------------

local handlers: { [string]: (any) -> () } = {}

handlers.Swing = function(d)
	if typeof(d.character) == "Instance" then
		AnimationController.swing(d.character, d.index, d.heavy)
		if not clutter(d.character) then
			EffectsController.slash(d.character, d.index, d.color, d.heavy, if d.heavy then 0.3 else 0.08)
		end
	end
end

handlers.Impacts = function(d)
	if ClientState.settings().reducedClutter then
		return
	end
	for _, hit in d.hits do
		EffectsController.burst(hit.position, d.color or Color3.new(1, 1, 1), 8)
	end
end

handlers.EnemyDeath = function(d)
	EffectsController.burst(d.position, Color3.fromRGB(200, 120, 255), 30, 20)
	EffectsController.ring(d.position - Vector3.new(0, 2, 0), 8, Color3.fromRGB(200, 120, 255), 0.5)
	local model = d.model
	if typeof(model) == "Instance" then
		for _, p in model:GetDescendants() do
			if p:IsA("BasePart") and p.Transparency < 1 then
				tween(p, 0.8, { Transparency = 1 })
			end
		end
	end
end

handlers.EnemyStrike = function(d)
	local color = d.color or Color3.fromRGB(255, 80, 60)
	local pos = d.position
	if typeof(pos) ~= "Vector3" then
		return
	end
	if d.shape == "Line" and typeof(d.dir) == "Vector3" then
		local finish = pos + d.dir * (d.length or 10)
		EffectsController.beam({ pos + Vector3.new(0, 0.5, 0), finish + Vector3.new(0, 0.5, 0) }, color, 0.25, 1.2)
	else
		EffectsController.ring(pos + Vector3.new(0, 0.3, 0), d.radius or 8, color, 0.35)
	end
	local near = nearLocal(pos, if d.big then 70 else 30)
	if near > 0 then
		CameraController.shake((if d.big then 0.5 else 0.2) * near)
	end
end

handlers.GuardBreak = function(d)
	EffectsController.burst(d.position, Color3.fromRGB(255, 255, 255), 20, 18)
	EffectsController.floatText(d.position + Vector3.new(0, 4, 0), "GUARD BREAK", Color3.fromRGB(255, 220, 120), 30, 0.9)
end

handlers.Parry = function(d)
	EffectsController.burst(d.position, Color3.fromRGB(255, 255, 230), 26, 24)
	EffectsController.ring(d.position, 6, Color3.fromRGB(255, 240, 200), 0.3)
end

handlers.Riposte = function(d)
	EffectsController.beam({ d.from, d.to }, Color3.fromRGB(255, 220, 120), 0.3, 0.6)
end

handlers.Dodge = function(d)
	if typeof(d.character) == "Instance" then
		AnimationController.play(d.character, "Dodge")
	end
	local root = rootOf(d.character)
	if root and not clutter(d.character) then
		EffectsController.burst(root.Position, Color3.fromRGB(200, 220, 255), 10, 8)
	end
end

handlers.Cast = function(d)
	if typeof(d.character) == "Instance" then
		AnimationController.cast(d.character)
	end
end

handlers.Awaken = function(d)
	local root = rootOf(d.character)
	if not root then
		return
	end
	EffectsController.sphere(root.Position, 2, 22, d.color, 0.6)
	EffectsController.ring(root.Position - Vector3.new(0, 2.5, 0), 18, d.color, 0.7)
	EffectsController.burst(root.Position, d.color, 40, 26)
	AnimationController.play(d.character, "Awaken")
	CameraController.shake(0.6 * nearLocal(root.Position, 60))
	if not isOther(d.character) then
		SoundController.play("Awakening")
		CameraController.punch(8)
		CameraController.flash(d.color, 0.45)
	end
end

handlers.AwakenEnd = function(d)
	local root = rootOf(d.character)
	if root then
		EffectsController.burst(root.Position, Color3.fromRGB(150, 150, 170), 16, 8)
		if d.suppressed then
			EffectsController.floatText(root.Position + Vector3.new(0, 4, 0), "SUPPRESSED", Color3.fromRGB(255, 120, 160), 30, 1)
		end
	end
end

handlers.Lightning = function(d)
	if typeof(d.points) == "table" and #d.points >= 2 then
		EffectsController.beam(d.points, d.color or Color3.fromRGB(140, 210, 255), 0.25, 0.3, true)
		EffectsController.burst(d.points[#d.points], d.color or Color3.fromRGB(140, 210, 255), 8)
	end
end

handlers.Nova = function(d)
	EffectsController.sphere(d.position, 1, d.radius * 2, d.color or Color3.fromRGB(255, 140, 60), 0.4)
	EffectsController.ring(d.position - Vector3.new(0, 2.4, 0), d.radius, d.color or Color3.fromRGB(255, 140, 60), 0.45)
end

handlers.FlareBurst = function(d)
	local steps = 6
	for i = 1, steps do
		task.delay(i * 0.03, function()
			local pos = d.origin + d.dir * (d.length * i / steps)
			EffectsController.sphere(pos, 1, d.width * (0.4 + i / steps * 0.6), d.color, 0.35)
		end)
	end
end

handlers.Gravity = function(d)
	local p = part({ shape = Enum.PartType.Ball, size = Vector3.one * d.radius * 2, cframe = CFrame.new(d.position), color = d.color, transparency = 0.7 })
	tween(p, d.duration or 0.6, { Size = Vector3.one * 2, Transparency = 0.2 })
	Debris:AddItem(p, (d.duration or 0.6) + 0.1)
	EffectsController.ring(d.position, d.radius, d.color, 0.5)
end

handlers.Field = function(d)
	local p = part({
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(0.3, d.radius * 2, d.radius * 2),
		cframe = CFrame.new(d.position - Vector3.new(0, 2.3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		color = d.color,
		transparency = 0.55,
	})
	Debris:AddItem(p, d.duration)
	task.delay(math.max(0, d.duration - 0.3), function()
		if p.Parent then
			tween(p, 0.3, { Transparency = 1 })
		end
	end)
end

handlers.CollapsingSun = function(d)
	local core = part({ shape = Enum.PartType.Ball, size = Vector3.one * d.radius * 2, cframe = CFrame.new(d.position), color = Color3.fromRGB(40, 10, 60), transparency = 0.5 })
	tween(core, d.pullTime, { Size = Vector3.one * 3, Transparency = 0 })
	Debris:AddItem(core, d.pullTime + 0.05)
	task.delay(d.pullTime, function()
		local color = if d.gravityOnly then Color3.fromRGB(170, 110, 255) else Color3.fromRGB(255, 170, 60)
		EffectsController.sphere(d.position, 2, d.blast * 2.2, color, 0.55, 0)
		EffectsController.ring(d.position - Vector3.new(0, 2.4, 0), d.blast * 1.2, color, 0.6)
		EffectsController.burst(d.position, color, 50, 30)
		CameraController.shake(0.5 * nearLocal(d.position, 60))
	end)
end

handlers.MagneticRift = function(d)
	local disc = part({
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(0.3, d.radius * 2, d.radius * 2),
		cframe = CFrame.new(d.position - Vector3.new(0, 2.3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		color = Color3.fromRGB(110, 150, 255),
		transparency = 0.5,
	})
	local orb = part({ shape = Enum.PartType.Ball, size = Vector3.one * 3, cframe = CFrame.new(d.position + Vector3.new(0, 3, 0)), color = Color3.fromRGB(180, 210, 255) })
	Debris:AddItem(disc, d.duration)
	Debris:AddItem(orb, d.duration)
end

handlers.Cataclysm = function(d)
	EffectsController.sphere(d.position, 2, d.radius * 2.2, d.color, 0.8, 0)
	EffectsController.ring(d.position - Vector3.new(0, 2.4, 0), d.radius, d.color, 0.9)
	EffectsController.burst(d.position, d.color, 60, 40)
	CameraController.shake(0.8 * nearLocal(d.position, 90))
end

handlers.Thunderstep = function(d)
	EffectsController.beam({ d.from, d.to }, d.color or Color3.fromRGB(140, 210, 255), 0.35, 0.8, true)
end

handlers.Dash = function(d)
	EffectsController.beam({ d.from, d.to }, d.color or Color3.fromRGB(255, 255, 255), 0.3, 1)
end

handlers.Shield = function(d)
	if typeof(d.character) == "Instance" then
		local highlight = Instance.new("Highlight")
		highlight.FillColor = Color3.fromRGB(255, 210, 100)
		highlight.FillTransparency = 0.75
		highlight.OutlineColor = Color3.fromRGB(255, 230, 150)
		highlight.Adornee = d.character
		highlight.Parent = folder
		Debris:AddItem(highlight, d.duration or 3)
	end
end

handlers.Heal = function(d)
	local root = rootOf(d.character)
	if root then
		EffectsController.burst(root.Position, Color3.fromRGB(120, 255, 150), 20, 6)
	end
end

handlers.Mine = function(d)
	EffectsController.burst(d.position + Vector3.new(0, 3, 0), d.color, 18, 14)
	EffectsController.floatText(d.position + Vector3.new(0, 6, 0), "+" .. (d.item or "ore"), d.color, 24, 0.8)
end

handlers.MineSwing = function(d)
	if typeof(d.character) == "Instance" then
		AnimationController.play(d.character, "Mine")
	end
end

handlers.Craft = function(d)
	local root = rootOf(d.character)
	if root then
		EffectsController.burst(root.Position, Color3.fromRGB(255, 210, 120), 30, 10)
	end
end

handlers.Evolve = function(d)
	local root = rootOf(d.character)
	if root then
		EffectsController.beam({ root.Position - Vector3.new(0, 3, 0), root.Position + Vector3.new(0, 60, 0) }, d.color, 1.2, 3)
		EffectsController.sphere(root.Position, 2, 30, d.color, 0.9)
		CameraController.shake(0.6 * nearLocal(root.Position, 60))
	end
end

handlers.Extract = function(d)
	local root = rootOf(d.character)
	if root then
		EffectsController.beam({ root.Position - Vector3.new(0, 3, 0), root.Position + Vector3.new(0, 40, 0) }, Color3.fromRGB(110, 255, 210), 0.8, 2)
	end
end

handlers.LevelUp = function(d)
	local target = d.player
	local root = target and target.Character and rootOf(target.Character)
	if root then
		EffectsController.ring(root.Position - Vector3.new(0, 2.5, 0), 10, Color3.fromRGB(255, 220, 120), 0.8)
		EffectsController.burst(root.Position, Color3.fromRGB(255, 220, 120), 30, 10)
	end
end

handlers.Coop = function(d)
	EffectsController.sphere(d.position, 2, 30, d.color, 0.7, 0)
	EffectsController.ring(d.position - Vector3.new(0, 2.4, 0), 16, d.color, 0.8)
	EffectsController.burst(d.position, d.color, 60, 30)
	EffectsController.floatText(d.position + Vector3.new(0, 8, 0), "CO-OP RESONANCE", d.color, 44, 1.5)
	CameraController.shake(0.6 * nearLocal(d.position, 80))
end

handlers.WeakPoint = function(d)
	local model = d.model
	local weak = typeof(model) == "Instance" and model:FindFirstChild("WeakPoint")
	if weak then
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(120, 40)
		gui.AlwaysOnTop = true
		gui.StudsOffset = Vector3.new(0, 4, 0)
		gui.Adornee = weak
		gui.Parent = folder
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = "◆ WEAK POINT ◆"
		label.TextScaled = true
		label.Font = Enum.Font.GothamBlack
		label.TextColor3 = Color3.fromRGB(255, 235, 140)
		label.TextStrokeTransparency = 0
		label.Parent = gui
		Debris:AddItem(gui, d.duration)
		EffectsController.burst(weak.Position, Color3.fromRGB(255, 230, 140), 20, 10)
	end
end

handlers.BossIntro = function(_d)
	CameraController.shake(0.8)
	SoundController.play("BossWarning")
end

handlers.BossPhase = function(d)
	CameraController.shake(0.7)
	SoundController.play("BossPhase")
	local model = d.model
	local root = typeof(model) == "Instance" and model:FindFirstChild("HumanoidRootPart")
	if root then
		EffectsController.ring(root.Position - Vector3.new(0, 8, 0), 40, Color3.fromRGB(255, 60, 150), 1.0)
	end
end

handlers.TileCollapse = function(d)
	EffectsController.burst(d.position + Vector3.new(0, 1, 0), Color3.fromRGB(255, 80, 120), 40, 30)
	CameraController.shake(0.3 * nearLocal(d.position, 80))
end

handlers.Projectile = function(d)
	local ball = part({ shape = Enum.PartType.Ball, size = Vector3.one * 2.5, cframe = CFrame.new(d.from), color = d.color })
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = math.clamp((os.clock() - start) / d.duration, 0, 1)
		local pos = d.from:Lerp(d.to, t) + Vector3.new(0, math.sin(t * math.pi) * 18, 0)
		ball.CFrame = CFrame.new(pos)
		if t >= 1 then
			connection:Disconnect()
			ball:Destroy()
		end
	end)
end

handlers.FinalOpening = function(d)
	if typeof(d.model) == "Instance" then
		local highlight = Instance.new("Highlight")
		highlight.FillColor = Color3.fromRGB(255, 230, 140)
		highlight.FillTransparency = 0.6
		highlight.OutlineColor = Color3.fromRGB(255, 255, 200)
		highlight.Adornee = d.model
		highlight.Parent = folder
		Debris:AddItem(highlight, d.duration)
	end
end

handlers.BossDefeated = function(d)
	CameraController.flash(Color3.fromRGB(255, 240, 200), 0.6)
	EffectsController.sphere(d.position, 4, 80, Color3.fromRGB(255, 220, 160), 1.6, 0)
	EffectsController.burst(d.position, Color3.fromRGB(255, 200, 120), 120, 50)
	CameraController.shake(1)
end

handlers.Shake = function(d)
	CameraController.shake((d.intensity or 0.4) * nearLocal(d.position, 120))
end

handlers.Sound = function(d)
	SoundController.play(d.name)
end

-- ArenaTransform is handled by ZoneController via this hook.
EffectsController.onArenaTransform = function(_active: boolean) end
handlers.ArenaTransform = function(d)
	EffectsController.onArenaTransform(d.active == true)
end

-- Telegraph animation + accessibility ------------------------------------------------------------

local function animateTelegraph(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local start = model:GetAttribute("Start") or ClientState.serverNow()
	local duration = model:GetAttribute("Duration") or 1
	local remaining = math.max(0.05, start + duration - ClientState.serverNow())
	local highContrast = ClientState.settings().highContrastTelegraphs
	if highContrast and model.Name ~= "Safe" then
		for _, p in model:GetChildren() do
			if p:IsA("BasePart") and (p.Name == "Area" or p.Name == "Fill") then
				p.Color = Color3.fromRGB(255, 235, 0)
				p.Transparency = math.max(0.15, p.Transparency - 0.25)
			end
		end
	end
	local fill = model:FindFirstChild("Fill") :: BasePart?
	if not fill or model:GetAttribute("Hazard") then
		return
	end
	local full = fill:GetAttribute("FullSize") :: Vector3?
	if not full then
		return
	end
	if fill:GetAttribute("Grow") == "Forward" then
		local cf = fill.CFrame
		local origin = cf.Position - cf.LookVector * (full.Z / 2)
		fill.Size = Vector3.new(full.X, full.Y, 0.1)
		fill.CFrame = CFrame.lookAt(origin + cf.LookVector * 0.05, origin + cf.LookVector) 
		tween(fill, remaining, { Size = full, CFrame = cf }, Enum.EasingStyle.Linear)
	else
		tween(fill, remaining, { Size = full }, Enum.EasingStyle.Linear)
	end
end

local function watchTelegraphs(container: Instance)
	container.ChildAdded:Connect(function(child)
		task.defer(animateTelegraph, child)
	end)
	for _, child in container:GetChildren() do
		animateTelegraph(child)
	end
end

-- Spinning decorations -----------------------------------------------------------------------------

local spinners: { { inst: Instance, speed: number } } = {}

local function collectSpinners(world: Instance)
	for _, inst in world:GetDescendants() do
		local speed = inst:GetAttribute("Spin") or inst:GetAttribute("SpinModel")
		if type(speed) == "number" and (inst:IsA("BasePart") or inst:IsA("Model")) then
			table.insert(spinners, { inst = inst, speed = speed })
		end
	end
end

-- Enemy status visuals -----------------------------------------------------------------------------

local function statusBillboard(model: Model, text: string, color: Color3, duration: number)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(140, 26)
	gui.StudsOffset = Vector3.new(0, (model:GetAttribute("Height") or 6) - 1, 0)
	gui.AlwaysOnTop = true
	gui.Adornee = root
	gui.Parent = folder
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	Debris:AddItem(gui, duration)
end

local function statusEmitter(model: Model, name: string, color: Color3, enabled: boolean)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local existing = root:FindFirstChild("FX_" .. name)
	if not enabled then
		if existing then
			existing:Destroy()
		end
		return
	end
	if existing then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "FX_" .. name
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Rate = 12 * fxScale()
	emitter.Lifetime = NumberRange.new(0.4, 0.8)
	emitter.Speed = NumberRange.new(2, 4)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	emitter.Parent = root
end

local function watchEnemy(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local function onAttr(attr: string)
		local value = model:GetAttribute(attr)
		if attr == "Burning" then
			statusEmitter(model, "Burning", Color3.fromRGB(255, 120, 40), value == true)
		elseif attr == "Charged" then
			statusEmitter(model, "Charged", Color3.fromRGB(120, 200, 255), value == true)
		elseif attr == "Gathered" then
			statusEmitter(model, "Gathered", Color3.fromRGB(170, 120, 255), value == true)
		elseif attr == "Surged" and value then
			local highlight = Instance.new("Highlight")
			highlight.FillColor = Color3.fromRGB(200, 80, 255)
			highlight.FillTransparency = 0.8
			highlight.OutlineColor = Color3.fromRGB(220, 120, 255)
			highlight.DepthMode = Enum.HighlightDepthMode.Occluded
			highlight.Parent = model
		elseif attr == "StaggeredUntil" and type(value) == "number" then
			statusBillboard(model, "STAGGERED", Color3.fromRGB(255, 230, 120), math.max(0.3, value - ClientState.serverNow()))
		elseif attr == "GuardOpenUntil" and type(value) == "number" then
			statusBillboard(model, "OPEN! STRIKE", Color3.fromRGB(120, 255, 170), math.max(0.3, value - ClientState.serverNow()))
		elseif attr == "Attacking" and type(value) == "string" then
			statusBillboard(model, value, Color3.fromRGB(255, 120, 100), 0.9)
		end
	end
	model.AttributeChanged:Connect(onAttr)
	for _, attr in { "Burning", "Charged", "Gathered", "Surged" } do
		if model:GetAttribute(attr) then
			onAttr(attr)
		end
	end
end

function EffectsController.init()
	folder = Instance.new("Folder")
	folder.Name = "ClientFX"
	folder.Parent = workspace

	Net.event("Effect").OnClientEvent:Connect(function(name, data)
		local handler = handlers[name]
		if handler and type(data) == "table" then
			local ok, err = pcall(handler, data)
			if not ok then
				warn("[FX] " .. tostring(name) .. ": " .. tostring(err))
			end
		end
	end)

	task.spawn(function()
		local telegraphs = workspace:FindFirstChild("Telegraphs")
		if telegraphs then
			watchTelegraphs(telegraphs)
		else
			local connection
			connection = workspace.ChildAdded:Connect(function(child)
				if child.Name == "Telegraphs" then
					connection:Disconnect()
					watchTelegraphs(child)
				end
			end)
		end
	end)

	task.spawn(function()
		local enemies = workspace:WaitForChild("Enemies", 30)
		if enemies then
			enemies.ChildAdded:Connect(watchEnemy)
			for _, child in enemies:GetChildren() do
				watchEnemy(child)
			end
		end
	end)

	task.spawn(function()
		local world = workspace:WaitForChild("World", 30)
		if world then
			task.wait(2)
			collectSpinners(world)
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		for _, entry in spinners do
			local inst = entry.inst
			if inst.Parent then
				if inst:IsA("BasePart") then
					inst.CFrame = inst.CFrame * CFrame.Angles(0, entry.speed * dt, 0)
				elseif inst:IsA("Model") then
					inst:PivotTo(inst:GetPivot() * CFrame.Angles(0, entry.speed * dt, 0))
				end
			end
		end
	end)
end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--!strict
-- The always-on HUD: vitals, resonance, ability bar with cooldowns, build line, currencies,
-- satchel/depth risk, quest + trial trackers, party frames, world event strip, boss bar,
-- lock-on status and touch controls. Display only.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local ItemConfig = require(Config.ItemConfig)
local WeaponConfig = require(Config.WeaponConfig)
local EssenceConfig = require(Config.EssenceConfig)
local AwakeningConfig = require(Config.AwakeningConfig)
local ProgressionConfig = require(Config.ProgressionConfig)
local Leveling = require(Shared.Progression.Leveling)
local Format = require(Shared.Util.Format)
local CombatMath = require(Shared.Combat.CombatMath)
local ClientState = require(script.Parent.Parent.ClientState)
local CombatController = require(script.Parent.CombatController)
local InputController = require(script.Parent.InputController)
local Kit = require(script.Parent.Parent.UI.Kit)
local Theme = require(script.Parent.Parent.UI.Theme)
local QuestLogic = require(script.Parent.Parent.UI.QuestLogic)

local C = Theme.Colors
local HUDController = {}

local player = Players.LocalPlayer
local gui: ScreenGui
local scale: UIScale
local refs: { [string]: any } = {}
local slots: { [string]: any } = {}

local function makeSlot(parent: Instance, id: string, key: string, order: number, accent: Color3?)
	local frame = Kit.panel({ parent = parent, size = UDim2.fromOffset(66, 66), color = C.Panel, order = order, strokeColor = accent, name = "Slot" .. id })
	frame.BackgroundTransparency = 0.15
	local title = Kit.text({ parent = frame, text = "", textSize = 11, font = Theme.Fonts.Bold, alignX = Enum.TextXAlignment.Center, size = UDim2.new(1, -6, 0, 30), position = UDim2.fromOffset(3, 14) })
	title.TextScaled = false
	local keyLabel = Kit.text({ parent = frame, text = key, textSize = 11, font = Theme.Fonts.Bold, color = C.Gold, alignX = Enum.TextXAlignment.Left, size = UDim2.new(1, -8, 0, 14), position = UDim2.fromOffset(5, 2) })
	local sub = Kit.text({ parent = frame, text = "", textSize = 10, color = C.TextDim, alignX = Enum.TextXAlignment.Center, size = UDim2.new(1, -4, 0, 14), position = UDim2.new(0, 2, 1, -17) })
	local overlay = Kit.new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, BorderSizePixel = 0, Size = UDim2.fromScale(1, 0), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), ZIndex = 3, Parent = frame })
	Kit.corner(overlay, 10)
	local cd = Kit.text({ parent = frame, text = "", textSize = 20, font = Theme.Fonts.Title, alignX = Enum.TextXAlignment.Center, size = UDim2.fromScale(1, 1), strokeT = 0.3 })
	cd.ZIndex = 4
	local lock = Kit.text({ parent = frame, text = "🔒", textSize = 18, alignX = Enum.TextXAlignment.Right, size = UDim2.new(1, -4, 0, 18), position = UDim2.fromOffset(0, 1) })
	lock.Visible = false
	slots[id] = { frame = frame, title = title, sub = sub, overlay = overlay, cd = cd, lock = lock, key = keyLabel }
	return slots[id]
end

local function buildVitals(root: Instance)
	local panel = Kit.panel({ parent = root, size = UDim2.fromOffset(300, 108), anchor = Vector2.new(0, 1), position = UDim2.new(0, 16, 1, -16), pad = 10, name = "Vitals" })
	panel.BackgroundTransparency = 0.25
	Kit.list(panel, 6)
	refs.health = Kit.bar({ parent = panel, color = C.Health, size = UDim2.new(1, 0, 0, 20), order = 1, textSize = 13 })
	refs.stamina = Kit.bar({ parent = panel, color = C.Stamina, size = UDim2.new(1, 0, 0, 10), order = 2, instant = true })
	local resRow = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 3, Parent = panel })
	refs.resonance = Kit.bar({ parent = resRow, color = C.Resonance, size = UDim2.new(1, -86, 1, 0), textSize = 11 })
	refs.resonanceLabel = Kit.text({ parent = resRow, text = "RESONANCE", textSize = 11, font = Theme.Fonts.Bold, color = C.Resonance, size = UDim2.new(0, 82, 1, 0), position = UDim2.new(1, -82, 0, 0), alignX = Enum.TextXAlignment.Right })
	refs.awaken = Kit.text({ parent = panel, text = "", textSize = 13, font = Theme.Fonts.Bold, color = C.Gold, order = 4 })
end

local function buildAbilityBar(root: Instance)
	local holder = Kit.new("Frame", { Name = "Abilities", BackgroundTransparency = 1, Size = UDim2.fromOffset(620, 110), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Parent = root })
	refs.build = Kit.text({ parent = holder, text = "", textSize = 14, font = Theme.Fonts.Bold, alignX = Enum.TextXAlignment.Center, size = UDim2.new(1, 0, 0, 20), strokeT = 0.5, rich = true })
	local row = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 70), Position = UDim2.fromOffset(0, 32), Parent = holder })
	local layout = Kit.list(row, 6, true, Enum.HorizontalAlignment.Center)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	makeSlot(row, "Light", "LMB", 1)
	makeSlot(row, "Heavy", "V", 2)
	makeSlot(row, "Dodge", "SHIFT", 3)
	makeSlot(row, "Q", "Q", 4)
	makeSlot(row, "E", "E", 5)
	makeSlot(row, "R", "R", 6, C.Gold)
	makeSlot(row, "G", "G", 7, C.Resonance)
	makeSlot(row, "H", "H", 8)
end

local function buildTopLeft(root: Instance)
	local panel = Kit.panel({ parent = root, size = UDim2.fromOffset(320, 0), autoSize = Enum.AutomaticSize.Y, position = UDim2.fromOffset(16, 16), pad = 10, name = "Profile" })
	panel.BackgroundTransparency = 0.25
	Kit.list(panel, 4)
	refs.level = Kit.text({ parent = panel, text = "Lv 1", textSize = 16, font = Theme.Fonts.Bold, order = 1, rich = true })
	refs.xp = Kit.bar({ parent = panel, color = C.Gold, size = UDim2.new(1, 0, 0, 8), order = 2 })
	refs.currency = Kit.text({ parent = panel, text = "", textSize = 13, color = C.TextDim, order = 3, size = UDim2.new(1, 0, 0, 0), autoSize = Enum.AutomaticSize.Y, rich = true })
	-- satchel / expedition
	local satchel = Kit.panel({ parent = root, size = UDim2.fromOffset(320, 0), autoSize = Enum.AutomaticSize.Y, position = UDim2.fromOffset(16, 120), pad = 10, name = "Satchel", strokeColor = C.Warn })
	satchel.BackgroundTransparency = 0.25
	Kit.list(satchel, 3)
	refs.region = Kit.text({ parent = satchel, text = "", textSize = 15, font = Theme.Fonts.Bold, order = 1 })
	refs.risk = Kit.text({ parent = satchel, text = "", textSize = 13, color = C.Warn, order = 2, rich = true })
	refs.satchel = Kit.text({ parent = satchel, text = "", textSize = 13, color = C.Text, order = 3, size = UDim2.new(1, 0, 0, 0), autoSize = Enum.AutomaticSize.Y })
	refs.satchelPanel = satchel
	-- party
	local party = Kit.panel({ parent = root, size = UDim2.fromOffset(220, 0), autoSize = Enum.AutomaticSize.Y, anchor = Vector2.new(0, 1), position = UDim2.new(0, 16, 1, -140), pad = 8, name = "Party" })
	party.BackgroundTransparency = 0.3
	Kit.list(party, 4)
	refs.partyPanel = party
end

local function buildRight(root: Instance)
	local menu = Kit.button({ parent = root, text = "☰  MENU  (M)", size = UDim2.fromOffset(150, 38), anchor = Vector2.new(1, 0), position = UDim2.new(1, -16, 0, 16), color = C.PanelLight, onClick = function()
		InputController.toggleMenu()
	end })
	menu.instance.Name = "MenuButton"
	local tracker = Kit.panel({ parent = root, size = UDim2.fromOffset(300, 0), autoSize = Enum.AutomaticSize.Y, anchor = Vector2.new(1, 0), position = UDim2.new(1, -16, 0, 66), pad = 10, name = "Quests" })
	tracker.BackgroundTransparency = 0.3
	Kit.list(tracker, 4)
	refs.tracker = tracker
	local trial = Kit.panel({ parent = root, size = UDim2.fromOffset(300, 0), autoSize = Enum.AutomaticSize.Y, anchor = Vector2.new(1, 0), position = UDim2.new(1, -16, 0, 300), pad = 10, name = "Trial", strokeColor = Color3.fromRGB(120, 230, 255) })
	trial.BackgroundTransparency = 0.25
	Kit.list(trial, 3)
	refs.trial = trial
	refs.lock = Kit.text({ parent = root, text = "", textSize = 14, font = Theme.Fonts.Bold, color = Color3.fromRGB(255, 240, 160), alignX = Enum.TextXAlignment.Center, size = UDim2.fromOffset(300, 20), anchor = Vector2.new(0.5, 1), position = UDim2.new(0.5, 0, 1, -128), strokeT = 0.4 })
end

local function buildTop(root: Instance)
	local event = Kit.panel({ parent = root, size = UDim2.fromOffset(460, 0), autoSize = Enum.AutomaticSize.Y, anchor = Vector2.new(0.5, 0), position = UDim2.new(0.5, 0, 0, 10), pad = 8, name = "Event" })
	event.BackgroundTransparency = 0.25
	Kit.list(event, 2, false, Enum.HorizontalAlignment.Center)
	refs.eventTitle = Kit.text({ parent = event, text = "", textSize = 16, font = Theme.Fonts.Bold, alignX = Enum.TextXAlignment.Center, order = 1 })
	refs.eventBody = Kit.text({ parent = event, text = "", textSize = 12, color = C.TextDim, alignX = Enum.TextXAlignment.Center, order = 2, size = UDim2.new(1, 0, 0, 0), autoSize = Enum.AutomaticSize.Y })
	refs.event = event
	local boss = Kit.panel({ parent = root, size = UDim2.fromOffset(620, 0), autoSize = Enum.AutomaticSize.Y, anchor = Vector2.new(0.5, 0), position = UDim2.new(0.5, 0, 0, 74), pad = 10, name = "Boss", strokeColor = Color3.fromRGB(255, 70, 140) })
	boss.BackgroundTransparency = 0.2
	Kit.list(boss, 4, false, Enum.HorizontalAlignment.Center)
	refs.bossName = Kit.text({ parent = boss, text = "", textSize = 18, font = Theme.Fonts.Title, alignX = Enum.TextXAlignment.Center, order = 1 })
	local barHolder = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 2, Parent = boss })
	refs.bossBar = Kit.bar({ parent = barHolder, color = Color3.fromRGB(230, 60, 120), size = UDim2.fromScale(1, 1), textSize = 12 })
	for _, threshold in { 0.7, 0.4, 0.15 } do
		local pip = Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Size = UDim2.new(0, 2, 1, 4), Position = UDim2.new(threshold, -1, 0, -2), ZIndex = 5, Parent = barHolder })
		local _ = pip
	end
	refs.bossPhase = Kit.text({ parent = boss, text = "", textSize = 13, color = C.TextDim, alignX = Enum.TextXAlignment.Center, order = 3, rich = true })
	refs.overload = Kit.bar({ parent = boss, color = Color3.fromRGB(120, 255, 200), size = UDim2.new(0.7, 0, 0, 12), order = 4, textSize = 10 })
	refs.boss = boss
end

-- Touch controls --------------------------------------------------------------------------------

local function touchButton(parent: Instance, text: string, action: string, position: UDim2, size: number, color: Color3)
	local button = Kit.new("TextButton", {
		Name = "Touch" .. action,
		Text = text,
		Font = Theme.Fonts.Bold,
		TextSize = 14,
		TextColor3 = Color3.new(1, 1, 1),
		TextWrapped = true,
		BackgroundColor3 = color,
		BackgroundTransparency = 0.25,
		AutoButtonColor = false,
		Size = UDim2.fromOffset(size, size),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Parent = parent,
	})
	Kit.corner(button, size)
	Kit.stroke(button, Color3.new(1, 1, 1), 2, 0.5)
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			button.BackgroundTransparency = 0
			InputController.press(action, true)
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			button.BackgroundTransparency = 0.25
			InputController.press(action, false)
		end
	end)
	return button
end

local function buildTouch(root: Instance)
	local pad = Kit.new("Frame", { Name = "TouchControls", BackgroundTransparency = 1, Size = UDim2.fromOffset(330, 300), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -10, 1, -110), Parent = root })
	touchButton(pad, "ATTACK", "Light", UDim2.new(1, -60, 1, -60), 96, Color3.fromRGB(200, 60, 80))
	touchButton(pad, "HEAVY", "Heavy", UDim2.new(1, -170, 1, -40), 62, Color3.fromRGB(160, 80, 60))
	touchButton(pad, "BLOCK", "Block", UDim2.new(1, -60, 1, -170), 62, Color3.fromRGB(80, 90, 130))
	touchButton(pad, "DODGE", "Dodge", UDim2.new(1, -150, 1, -130), 62, Color3.fromRGB(70, 120, 150))
	touchButton(pad, "Q", "Q", UDim2.new(1, -250, 1, -40), 54, C.Ember)
	touchButton(pad, "E", "E", UDim2.new(1, -240, 1, -110), 54, C.Storm)
	touchButton(pad, "R", "R", UDim2.new(1, -200, 1, -180), 54, C.Gold)
	touchButton(pad, "AWAKEN", "Awaken", UDim2.new(1, -120, 1, -230), 58, C.Resonance)
	touchButton(pad, "LOCK", "Lock", UDim2.new(1, -30, 1, -250), 44, Color3.fromRGB(110, 110, 130))
	touchButton(pad, "TONIC", "Tonic", UDim2.new(1, -290, 1, -170), 44, Color3.fromRGB(200, 120, 70))
	refs.touch = pad
end

-- Refresh --------------------------------------------------------------------------------------

local function refreshProfile()
	local profile = ClientState.profile
	if not profile then
		return
	end
	refs.level.Text = string.format("<b>Lv %d</b>  <font color=\"#a0a5bc\">%s</font>", profile.level, player.DisplayName)
	refs.xp.set(Leveling.progress(profile.level, profile.xp, ProgressionConfig.levelXp, ProgressionConfig.MaxLevel))
	local m = profile.materials
	refs.currency.Text = string.format(
		"<font color=\"#ffcd6e\">◆ %s</font>   Iron %d  •  Cobalt %d  •  Ember %d\nShards %d  •  Sigils %d  •  Cores %d",
		Format.number(profile.coins),
		m.Iron or 0,
		m.Cobalt or 0,
		m.Emberstone or 0,
		m.EssenceShard or 0,
		m.BossSigil or 0,
		m.FractureCore or 0
	)
	local weapon = profile.weapons.Katana
	local def = WeaponConfig.Weapons.Katana
	local evo = def.evolutions[weapon.evolution]
	local primary = EssenceConfig.Essences[profile.loadout.primary]
	local secondary = EssenceConfig.Essences[profile.loadout.secondary]
	local function hex(c: Color3): string
		return string.format("#%02x%02x%02x", math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255))
	end
	refs.build.Text = string.format(
		"%s +%d%s  •  <font color=\"%s\">%s</font>%s",
		def.displayName,
		weapon.upgrade - 1,
		if evo then " (" .. evo.displayName .. ")" else "",
		hex(primary and primary.color or C.TextDim),
		primary and primary.displayName or "—",
		if secondary then string.format(" + <font color=\"%s\">%s</font>", hex(secondary.color), secondary.displayName) else ""
	)
	local build = CombatMath.weaponBuild("Katana", weapon)
	slots.Light.title.Text = string.format("Combo\n%d hits", #build.light)
	slots.Heavy.title.Text = build.heavy.name
	slots.Heavy.sub.Text = build.heavy.stamina .. " stam"
	slots.Dodge.title.Text = "Dodge"
	slots.Dodge.sub.Text = build.dodge.stamina .. " stam"
	for _, key in { "Q", "E", "R" } do
		local ability, reason = CombatController.slotInfo(key)
		local slot = slots[key]
		slot.title.Text = if ability then ability.displayName else (reason or "—")
		slot.lock.Visible = reason ~= nil
		slot.sub.Text = if reason and ability then reason else ""
		slot.title.TextColor3 = if reason then C.TextMuted else C.Text
	end
	local form = AwakeningConfig.Forms[profile.loadout.primary]
	slots.G.title.Text = if form then form.displayName else "Awaken"
	slots.H.title.Text = "Ember Tonic"
	slots.H.sub.Text = "x" .. tostring(m.EmberTonic or 0)
	-- quest tracker
	Kit.clear(refs.tracker)
	Kit.text({ parent = refs.tracker, text = "CONTRACTS", textSize = 12, font = Theme.Fonts.Bold, color = C.Gold, order = 0 })
	local tracked = QuestLogic.tracked(profile, 3)
	for i, entry in tracked do
		local def2 = entry.def
		Kit.text({ parent = refs.tracker, text = def2.title, textSize = 14, font = Theme.Fonts.Bold, order = i * 10, color = if entry.complete then C.Good else C.Text })
		if entry.complete then
			Kit.text({ parent = refs.tracker, text = "✔ Complete — claim in Menu > Quests", textSize = 12, color = C.Good, order = i * 10 + 1 })
		else
			for j, objective in def2.objectives do
				Kit.text({
					parent = refs.tracker,
					text = string.format("• %s %d/%d", objective.label, math.min(entry.counts[j] or 0, objective.count), objective.count),
					textSize = 12,
					color = C.TextDim,
					order = i * 10 + j,
				})
			end
			if def2.hint and def2.category == "Main" then
				Kit.text({ parent = refs.tracker, text = def2.hint, textSize = 11, color = C.TextMuted, order = i * 10 + 9, size = UDim2.new(1, 0, 0, 0), autoSize = Enum.AutomaticSize.Y })
			end
		end
	end
	if #tracked == 0 then
		Kit.text({ parent = refs.tracker, text = "Visit the Quest Board for new contracts.", textSize = 12, color = C.TextDim, order = 1 })
	end
end

local function refreshExpedition()
	local e = ClientState.expedition
	local inExpedition = e and e.expedition
	refs.satchelPanel.Visible = inExpedition == true
	if not inExpedition then
		return
	end
	local WorldConfig = require(Config.WorldConfig)
	local region = WorldConfig.regionById(e.region or "")
	refs.region.Text = region and region.name or "Emberfall"
	if e.depth > 0 then
		refs.risk.Text = string.format("<b>DEPTH %d</b> • death loses %d%% of your Satchel", e.depth, math.floor(e.loss * 100))
		refs.risk.TextColor3 = if e.depth >= 3 then C.Bad elseif e.depth == 2 then C.Warn else Color3.fromRGB(255, 220, 140)
	else
		refs.risk.Text = "<b>SAFE ZONE</b> • nothing can be lost here"
		refs.risk.TextColor3 = C.Good
	end
	local lines = {}
	if e.satchel.coins > 0 then
		table.insert(lines, string.format("◆ %d coins", e.satchel.coins))
	end
	for _, id in ItemConfig.Order do
		local n = e.satchel.items[id]
		if n and n > 0 then
			table.insert(lines, string.format("%s x%d", ItemConfig.Items[id].name, n))
		end
	end
	refs.satchel.Text = if #lines > 0 then "SATCHEL (unbanked):\n" .. table.concat(lines, "\n") else "Satchel empty. Loot found here must be extracted at a beacon."
end

local function refreshParty()
	local party = ClientState.party
	local panel = refs.partyPanel
	Kit.clear(panel)
	panel.Visible = party ~= nil
	if not party then
		return
	end
	Kit.text({ parent = panel, text = "PARTY", textSize = 12, font = Theme.Fonts.Bold, color = Color3.fromRGB(140, 200, 255), order = 0 })
	for i, member in party.members do
		local row = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = i, Parent = panel })
		Kit.text({ parent = row, text = (if member.userId == party.leader then "★ " else "") .. member.name, textSize = 12, size = UDim2.new(1, 0, 0, 14) })
		local bar = Kit.bar({ parent = row, color = C.Health, size = UDim2.new(1, 0, 0, 8), position = UDim2.fromOffset(0, 18), instant = true })
		bar.frame:SetAttribute("UserId", member.userId)
	end
end

local function refreshTrial()
	local trial = ClientState.trial
	local panel = refs.trial
	Kit.clear(panel)
	panel.Visible = trial ~= nil
	if not trial then
		return
	end
	Kit.text({ parent = panel, text = trial.name, textSize = 14, font = Theme.Fonts.Bold, color = Color3.fromRGB(120, 230, 255), order = 0 })
	refs.trialTimer = Kit.text({ parent = panel, text = "", textSize = 13, color = C.Warn, order = 1 })
	for i, o in trial.objectives do
		Kit.text({
			parent = panel,
			text = string.format("%s %s %d/%d", if o.current >= o.count then "✔" else "•", o.label, o.current, o.count),
			textSize = 12,
			color = if o.current >= o.count then C.Good else C.TextDim,
			order = i + 1,
		})
	end
end

local function refreshTimers()
	local now = ClientState.serverNow()
	-- world event
	local event = ClientState.worldEvent
	if event and event.phase ~= "Idle" and event.name then
		refs.event.Visible = true
		local remaining = Format.time(event.endsAt - now)
		refs.eventTitle.Text = if event.phase == "Warning" then string.format("⚠ %s begins in %s", event.name, remaining) else string.format("★ %s — %s left", event.name, remaining)
		refs.eventTitle.TextColor3 = event.color or C.Text
		refs.eventBody.Text = event.description or ""
	else
		refs.event.Visible = false
	end
	-- boss
	local boss = ClientState.boss
	local region = player:GetAttribute("Region")
	local showBoss = boss and (boss.state == "Active" or boss.state == "Countdown") and (region == "Arena" or region == "Approach")
	refs.boss.Visible = showBoss == true
	if showBoss then
		refs.bossName.Text = string.upper(boss.name) .. "  —  " .. boss.title
		if boss.state == "Countdown" then
			refs.bossBar.set(1, string.format("The arena seals in %ds — step inside!", math.max(0, math.ceil(boss.countdownEnds - now))))
			refs.bossPhase.Text = ""
			refs.overload.frame.Visible = false
		else
			local fraction = boss.health / math.max(1, boss.maxHealth)
			refs.bossBar.set(fraction, string.format("%s / %s", Format.number(boss.health), Format.number(boss.maxHealth)))
			local tags = {}
			if boss.exposed then
				table.insert(tags, "<font color=\"#ffe68c\"><b>◆ WEAK POINT EXPOSED — strike its back</b></font>")
			end
			if boss.opening then
				table.insert(tags, "<font color=\"#ffffff\"><b>FINAL OPENING x3</b></font>")
			end
			refs.bossPhase.Text = string.format("Phase %d: %s   %s", boss.phase, boss.phaseName, table.concat(tags, "  "))
			refs.overload.frame.Visible = boss.overload ~= nil
			if boss.overload then
				refs.overload.set(boss.overload.progress, string.format("INTERRUPT %d%%  (%ds)", math.floor(boss.overload.progress * 100), math.max(0, math.ceil(boss.overload.endsAt - now))))
			end
		end
	end
	-- trial timer
	local trial = ClientState.trial
	if trial and refs.trialTimer then
		refs.trialTimer.Text = "Time left: " .. Format.time(trial.endsAt - now)
	end
	-- cooldowns
	for _, key in { "Q", "E", "R", "H" } do
		local slot = slots[key]
		local cd = ClientState.cooldowns[key]
		if cd and cd.endsAt > now then
			local left = cd.endsAt - now
			slot.overlay.Size = UDim2.fromScale(1, math.clamp(left / cd.duration, 0, 1))
			slot.cd.Text = string.format("%d", math.ceil(left))
		else
			slot.overlay.Size = UDim2.fromScale(1, 0)
			slot.cd.Text = ""
		end
	end
	-- awakening
	local awakened = player:GetAttribute("Awakened") == true
	local resonance = player:GetAttribute("Resonance") or 0
	local burnout = (player:GetAttribute("BurnoutEnds") or 0) - now
	local gslot = slots.G
	if awakened then
		local left = (player:GetAttribute("AwakenEnds") or 0) - now
		refs.awaken.Text = string.format("AWAKENED — %ds  •  press G for your signature", math.max(0, math.ceil(left)))
		gslot.sub.Text = "SIGNATURE"
		gslot.overlay.Size = UDim2.fromScale(1, 0)
	elseif burnout > 0 then
		refs.awaken.Text = string.format("Burnout: resonance returns in %ds", math.ceil(burnout))
		gslot.sub.Text = "burnout"
		gslot.overlay.Size = UDim2.fromScale(1, 1)
	elseif resonance >= 100 then
		refs.awaken.Text = "RESONANCE FULL — press G to Awaken"
		gslot.sub.Text = "READY"
		gslot.overlay.Size = UDim2.fromScale(1, 0)
	else
		refs.awaken.Text = ""
		gslot.sub.Text = string.format("%d%%", resonance)
		gslot.overlay.Size = UDim2.fromScale(1, 1 - resonance / 100)
	end
	-- party health
	for _, child in refs.partyPanel:GetDescendants() do
		local userId = child:GetAttribute("UserId")
		if userId then
			local member = Players:GetPlayerByUserId(userId)
			local humanoid = member and member.Character and member.Character:FindFirstChildOfClass("Humanoid")
			local fill = child:FindFirstChild("Fill")
			if fill and humanoid then
				fill.Size = UDim2.fromScale(math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1), 1)
			end
		end
	end
	-- lock on
	local target = ClientState.lockTarget
	refs.lock.Text = if target then "LOCKED: " .. tostring(target.Name) .. "  (T to release)" else ""
end

local function bindCharacter(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	local function update()
		refs.health.set(humanoid.Health / humanoid.MaxHealth, string.format("%d / %d", math.ceil(humanoid.Health), humanoid.MaxHealth))
	end
	humanoid.HealthChanged:Connect(update)
	humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(update)
	update()
end

local function applyScale()
	local settings = ClientState.settings()
	local viewport = workspace.CurrentCamera.ViewportSize
	local auto = if viewport.Y < 600 then 0.75 elseif viewport.Y < 800 then 0.88 else 1
	scale.Scale = settings.hudScale * auto
end

function HUDController.init()
	gui = Kit.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	scale = Kit.new("UIScale", { Parent = gui })
	buildVitals(gui)
	buildAbilityBar(gui)
	buildTopLeft(gui)
	buildRight(gui)
	buildTop(gui)
	if UserInputService.TouchEnabled then
		buildTouch(gui)
	end
	refs.trial.Visible = false
	refs.partyPanel.Visible = false
	refs.boss.Visible = false
	refs.event.Visible = false
	refs.satchelPanel.Visible = false

	ClientState.Changed:Connect(function(key)
		if key == "profile" or key == "lock" then
			refreshProfile()
			applyScale()
		elseif key == "expedition" then
			refreshExpedition()
		elseif key == "party" then
			refreshParty()
		elseif key == "trial" then
			refreshTrial()
		end
	end)
	player:GetAttributeChangedSignal("Stamina"):Connect(function()
		local stamina = player:GetAttribute("Stamina") or 0
		local max = player:GetAttribute("MaxStamina") or 100
		refs.stamina.set(stamina / max)
	end)
	player:GetAttributeChangedSignal("Resonance"):Connect(function()
		local r = player:GetAttribute("Resonance") or 0
		refs.resonance.set(r / 100, if r >= 100 then "FULL" else "")
		refs.resonance.fill.BackgroundColor3 = if r >= 100 then C.Gold else C.Resonance
	end)
	player.CharacterAdded:Connect(bindCharacter)
	if player.Character then
		task.spawn(bindCharacter, player.Character)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
	applyScale()

	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.1 then
			accumulator = 0
			local ok, err = pcall(refreshTimers)
			if not ok then
				warn("[HUD] " .. tostring(err))
			end
		end
	end)
end

function HUDController.setVisible(visible: boolean)
	if gui then
		gui.Enabled = visible
	end
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!strict
-- Cross-platform input. Keyboard/mouse and gamepad via UserInputService (respecting
-- gameProcessed so typing in chat or clicking UI never triggers combat); touch via the
-- on-screen buttons created by the HUD, which call InputController.press().
--
-- Desktop: LMB light (hold to chain) • RMB block/parry • V heavy • Shift dodge • Q/E abilities
--          R fusion • G awaken • H tonic • T lock-on • M menu
-- Gamepad: R2 light • L2 block • R1 heavy • B dodge • X/Y abilities • L1 fusion
--          DPadUp awaken • DPadDown tonic • R3 lock-on • Select menu

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local CombatController = require(script.Parent.CombatController)

local InputController = {}

-- Injected by UIController: returns true while a modal window should swallow combat input.
InputController.isBlocked = function(): boolean
	return false
end
InputController.toggleMenu = function() end

local holdingLight = false

local KEYS: { [Enum.KeyCode]: string } = {
	[Enum.KeyCode.V] = "Heavy",
	[Enum.KeyCode.LeftShift] = "Dodge",
	[Enum.KeyCode.Q] = "Q",
	[Enum.KeyCode.E] = "E",
	[Enum.KeyCode.R] = "R",
	[Enum.KeyCode.G] = "Awaken",
	[Enum.KeyCode.H] = "Tonic",
	[Enum.KeyCode.T] = "Lock",
	[Enum.KeyCode.M] = "Menu",
	[Enum.KeyCode.ButtonR2] = "Light",
	[Enum.KeyCode.ButtonL2] = "Block",
	[Enum.KeyCode.ButtonR1] = "Heavy",
	[Enum.KeyCode.ButtonB] = "Dodge",
	[Enum.KeyCode.ButtonX] = "Q",
	[Enum.KeyCode.ButtonY] = "E",
	[Enum.KeyCode.ButtonL1] = "R",
	[Enum.KeyCode.DPadUp] = "Awaken",
	[Enum.KeyCode.DPadDown] = "Tonic",
	[Enum.KeyCode.ButtonR3] = "Lock",
	[Enum.KeyCode.ButtonSelect] = "Menu",
}

-- Single entry point for every input source.
function InputController.press(action: string, began: boolean)
	if action == "Menu" then
		if began then
			InputController.toggleMenu()
		end
		return
	end
	if InputController.isBlocked() then
		if not began and action == "Block" then
			CombatController.block(false)
		end
		holdingLight = false
		return
	end
	if action == "Light" then
		holdingLight = began
		if began then
			CombatController.light()
		end
	elseif action == "Block" then
		CombatController.block(began)
	elseif not began then
		return
	elseif action == "Heavy" then
		CombatController.heavy()
	elseif action == "Dodge" then
		CombatController.dodge()
	elseif action == "Q" or action == "E" or action == "R" then
		CombatController.ability(action)
	elseif action == "Awaken" then
		CombatController.awaken()
	elseif action == "Tonic" then
		CombatController.tonic()
	elseif action == "Lock" then
		CombatController.toggleLock()
	end
end

function InputController.init()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or UserInputService:GetFocusedTextBox() then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			InputController.press("Light", true)
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			InputController.press("Block", true)
		else
			local action = KEYS[input.KeyCode]
			if action then
				InputController.press(action, true)
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input, _gameProcessed)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			InputController.press("Light", false)
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			InputController.press("Block", false)
		else
			local action = KEYS[input.KeyCode]
			if action == "Light" or action == "Block" then
				InputController.press(action, false)
			end
		end
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		holdingLight = false
		CombatController.block(false)
	end)
	-- Holding light attack chains the combo as soon as each strike recovers.
	RunService.Heartbeat:Connect(function()
		if holdingLight and not InputController.isBlocked() then
			CombatController.light()
		end
	end)
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">NotificationController</string>
              <string name="Source"><![CDATA[--!strict
-- Toasts, loot feed, banners, presentation moments (first essence/fusion/evolution/awakening,
-- boss intro/defeat, secrets), death summaries and party invites. Concise by design.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local ItemConfig = require(Shared.Config.ItemConfig)
local ClientState = require(script.Parent.Parent.ClientState)
local SoundController = require(script.Parent.SoundController)
local Kit = require(script.Parent.Parent.UI.Kit)
local Theme = require(script.Parent.Parent.UI.Theme)

local C = Theme.Colors
local NotificationController = {}

local player = Players.LocalPlayer
local gui: ScreenGui
local toastHolder: Frame
local lootHolder: Frame
local bannerLabel: TextLabel
local warningBar: TextLabel
local presentQueue: { any } = {}
local presenting = false

local KIND_COLORS: { [string]: Color3 } = {
	Error = C.Bad,
	Success = C.Good,
	Info = C.TextDim,
	Hint = C.Accent,
	Lore = Color3.fromRGB(255, 220, 160),
	Achievement = C.Gold,
	Unlock = C.Gold,
	QuestComplete = C.Good,
	Mastery = Color3.fromRGB(150, 220, 255),
	Craft = C.Gold,
	Attune = C.Accent,
	Party = Color3.fromRGB(140, 200, 255),
	Discovery = Color3.fromRGB(255, 220, 140),
	Resonance = C.Resonance,
	Extract = Color3.fromRGB(110, 255, 210),
}

function NotificationController.toast(kind: string, text: string, extra: any?)
	if not toastHolder or text == "" then
		return
	end
	local color = (extra and extra.color) or KIND_COLORS[kind] or C.TextDim
	local frame = Kit.panel({
		parent = toastHolder,
		size = UDim2.new(1, 0, 0, 0),
		autoSize = Enum.AutomaticSize.Y,
		color = C.Panel,
		strokeColor = color,
		pad = 10,
		order = -math.floor(os.clock() * 100),
	})
	frame.BackgroundTransparency = 0.08
	Kit.list(frame, 2)
	local title = if kind == "Achievement" then "★ ACHIEVEMENT" elseif kind == "QuestComplete" then "✔ CONTRACT COMPLETE" else nil
	if title then
		Kit.text({ parent = frame, text = title, color = color, font = Theme.Fonts.Bold, textSize = 13, order = 1 })
	end
	local body = Kit.text({ parent = frame, text = text, color = C.Text, textSize = 15, order = 2, size = UDim2.new(1, 0, 0, 0), autoSize = Enum.AutomaticSize.Y })
	body.Font = Theme.Fonts.Medium
	if extra and extra.description then
		Kit.text({ parent = frame, text = extra.description, color = C.TextDim, textSize = 13, order = 3, size = UDim2.new(1, 0, 0, 0), autoSize = Enum.AutomaticSize.Y })
	end
	if extra and extra.unlock then
		Kit.text({ parent = frame, text = "Unlocked: " .. extra.unlock, color = C.Gold, textSize = 13, order = 4, size = UDim2.new(1, 0, 0, 0), autoSize = Enum.AutomaticSize.Y })
	end
	if extra and extra.actions then
		local row = Kit.row(frame, 5, 32)
		for _, action in extra.actions do
			Kit.button({ parent = row, text = action.text, size = UDim2.fromOffset(100, 30), color = action.color, onClick = function()
				action.fn()
				frame:Destroy()
			end })
		end
	end
	local children = toastHolder:GetChildren()
	local count = 0
	for _, child in children do
		if child:IsA("Frame") then
			count += 1
		end
	end
	if count > 5 then
		local oldest, oldestOrder = nil, math.huge
		for _, child in children do
			if child:IsA("Frame") and child.LayoutOrder > -oldestOrder then
				oldest, oldestOrder = child, -child.LayoutOrder
			end
		end
		if oldest and oldest ~= frame then
			oldest:Destroy()
		end
	end
	task.delay((extra and extra.duration) or 4, function()
		if frame.Parent then
			TweenService:Create(frame, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			task.wait(0.3)
			frame:Destroy()
		end
	end)
end

local function loot(items: any, coins: number, satchel: boolean)
	local lines = {}
	if coins and coins > 0 then
		table.insert(lines, string.format("+%d coins", coins))
	end
	for item, n in items or {} do
		local def = ItemConfig.Items[item]
		table.insert(lines, string.format("+%d %s", n, def and def.name or item))
	end
	for _, line in lines do
		local label = Kit.text({
			parent = lootHolder,
			text = line .. (if satchel then "  (Satchel)" else ""),
			color = if satchel then Color3.fromRGB(255, 220, 150) else C.Good,
			font = Theme.Fonts.Bold,
			textSize = 15,
			strokeT = 0.4,
			order = -math.floor(os.clock() * 100),
		})
		task.delay(2.6, function()
			TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			task.wait(0.4)
			label:Destroy()
		end)
	end
end

function NotificationController.banner(text: string, color: Color3?, duration: number?)
	bannerLabel.Text = text
	bannerLabel.TextColor3 = color or C.Text
	bannerLabel.Visible = true
	bannerLabel.TextTransparency = 0
	local token = os.clock()
	bannerLabel:SetAttribute("Token", token)
	task.delay(duration or 3, function()
		if bannerLabel:GetAttribute("Token") == token then
			TweenService:Create(bannerLabel, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		end
	end)
end

local function showNextPresentation()
	if presenting or #presentQueue == 0 then
		return
	end
	presenting = true
	local data = table.remove(presentQueue, 1)
	local color = data.color or C.Gold
	local card = Kit.panel({
		parent = gui,
		size = UDim2.fromOffset(520, 0),
		autoSize = Enum.AutomaticSize.Y,
		anchor = Vector2.new(0.5, 0.5),
		position = UDim2.fromScale(0.5, 0.36),
		color = Color3.fromRGB(12, 12, 20),
		strokeColor = color,
		pad = 20,
	})
	card.ZIndex = 10
	Kit.new("UISizeConstraint", { MaxSize = Vector2.new(560, 400), Parent = card })
	Kit.list(card, 6, false, Enum.HorizontalAlignment.Center)
	Kit.text({ parent = card, text = string.upper(data.subtitle or ""), color = color, font = Theme.Fonts.Bold, textSize = 14, alignX = Enum.TextXAlignment.Center, order = 1 })
	Kit.text({ parent = card, text = data.title or "", color = C.Text, font = Theme.Fonts.Title, textSize = 34, alignX = Enum.TextXAlignment.Center, order = 2, size = UDim2.new(1, 0, 0, 0), autoSize = Enum.AutomaticSize.Y })
	Kit.text({ parent = card, text = data.body or "", color = C.TextDim, textSize = 16, alignX = Enum.TextXAlignment.Center, order = 3, size = UDim2.new(1, 0, 0, 0), autoSize = Enum.AutomaticSize.Y })
	Kit.text({ parent = card, text = "click to dismiss", color = C.TextMuted, textSize = 12, alignX = Enum.TextXAlignment.Center, order = 4 })
	local scale = Kit.new("UIScale", { Scale = 0.8, Parent = card })
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	SoundController.play("ItemDiscovery")
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		card:Destroy()
		presenting = false
		showNextPresentation()
	end
	local hit = Kit.new("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 20, Parent = card })
	hit.Activated:Connect(close)
	task.delay(5.5, close)
end

function NotificationController.present(data: any)
	table.insert(presentQueue, data)
	showNextPresentation()
end

local function onNotify(kind: string, text: string, extra: any)
	extra = extra or {}
	if kind == "DataWarning" then
		warningBar.Text = "⚠ " .. text
		warningBar.Visible = true
	elseif kind == "Loot" then
		loot(extra.items, extra.coins or 0, extra.satchel == true)
	elseif kind == "Extract" then
		SoundController.play("Extraction")
		NotificationController.toast("Extract", "Loot banked! It is now permanent.", { color = KIND_COLORS.Extract })
	elseif kind == "Death" then
		local lines = {}
		for item, n in extra.lostItems or {} do
			local def = ItemConfig.Items[item]
			table.insert(lines, string.format("-%d %s", n, def and def.name or item))
		end
		if (extra.lostCoins or 0) > 0 then
			table.insert(lines, string.format("-%d coins", extra.lostCoins))
		end
		NotificationController.present({
			title = "You Fell",
			subtitle = string.format("Depth %d", extra.depth or 0),
			body = if #lines > 0 then "Lost from your Satchel: " .. table.concat(lines, ", ") .. ". Mastery, XP and unlocks are safe." else "Nothing was lost. Mastery, XP and unlocks are always safe.",
			color = C.Bad,
		})
	elseif kind == "LevelUp" then
		SoundController.play("LevelUp")
		NotificationController.banner(text, C.Gold, 3)
		if extra.unlock then
			NotificationController.toast("Unlock", "Unlocked: " .. extra.unlock)
		end
	elseif kind == "Coop" then
		NotificationController.banner("CO-OP RESONANCE: " .. string.upper(text), extra.color, 3)
		NotificationController.toast("Success", table.concat(extra.players or {}, " + ") .. " triggered " .. text .. "!", { color = extra.color })
	elseif kind == "Boss" or kind == "BossPhase" or kind == "WorldEvent" then
		NotificationController.banner(text, extra.color or Color3.fromRGB(255, 120, 170), 3.5)
	elseif kind == "QuestComplete" then
		SoundController.play("QuestComplete")
		NotificationController.toast(kind, text .. "  (claim it in the Quests menu)", extra)
	elseif kind == "PartyInvite" then
		NotificationController.toast("Party", text, {
			duration = 30,
			actions = {
				{ text = "Accept", color = C.Good, fn = function()
					ClientState.request("PartyRespond", { userId = extra.from, accept = true })
				end },
				{ text = "Decline", color = C.Bad, fn = function()
					ClientState.request("PartyRespond", { userId = extra.from, accept = false })
				end },
			},
		})
	else
		NotificationController.toast(kind, text, extra)
	end
end

function NotificationController.init()
	gui = Kit.new("ScreenGui", {
		Name = "Notifications",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 30,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	toastHolder = Kit.new("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(320, 400),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -150),
		Parent = gui,
	})
	local layout = Kit.list(toastHolder, 6)
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	lootHolder = Kit.new("Frame", {
		Name = "Loot",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(300, 200),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -190),
		Parent = gui,
	})
	local lootLayout = Kit.list(lootHolder, 2)
	lootLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	bannerLabel = Kit.text({
		parent = gui,
		text = "",
		font = Theme.Fonts.Title,
		textSize = 30,
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(0.8, 0, 0, 40),
		position = UDim2.fromScale(0.5, 0.2),
		anchor = Vector2.new(0.5, 0.5),
		strokeT = 0.3,
	})
	bannerLabel.Visible = false
	warningBar = Kit.text({
		parent = gui,
		text = "",
		color = Color3.new(1, 1, 1),
		font = Theme.Fonts.Bold,
		textSize = 14,
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 26),
		position = UDim2.new(0, 0, 0, 0),
	})
	warningBar.BackgroundTransparency = 0.1
	warningBar.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
	warningBar.Visible = false

	ClientState.toast = NotificationController.toast
	Net.event("Notify").OnClientEvent:Connect(function(kind, text, extra)
		local ok, err = pcall(onNotify, kind, text or "", extra)
		if not ok then
			warn("[Notify] " .. tostring(err))
		end
	end)
	Net.event("Present").OnClientEvent:Connect(function(_momentId, data)
		if type(data) == "table" then
			NotificationController.present(data)
		end
	end)
end

return NotificationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">SoundController</string>
              <string name="Source"><![CDATA[--!strict
-- Plays named sounds from AudioConfig. Empty ids are skipped (safe fallback: silence).

local SoundService = game:GetService("SoundService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local AudioConfig = require(Shared.Config.AudioConfig)
local ClientState = require(script.Parent.Parent.ClientState)

local SoundController = {}

local cache: { [string]: Sound } = {}
local music: Sound? = nil

local function soundFor(name: string): Sound?
	local def = AudioConfig.Sounds[name]
	if not def or def.id == "" then
		return nil
	end
	local sound = cache[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = name
		sound.SoundId = def.id
		sound.Volume = def.volume
		sound.Looped = def.music == true
		sound.Parent = SoundService
		cache[name] = sound
	end
	return sound
end

function SoundController.play(name: string)
	local sound = soundFor(name)
	if not sound then
		return
	end
	local settings = ClientState.settings()
	sound.Volume = AudioConfig.Sounds[name].volume * settings.sfx
	SoundService:PlayLocalSound(sound)
end

function SoundController.music(name: string?)
	if music then
		music:Stop()
		music = nil
	end
	if not name then
		return
	end
	local sound = soundFor(name)
	if sound then
		sound.Volume = AudioConfig.Sounds[name].volume * ClientState.settings().music
		sound:Play()
		music = sound
	end
end

function SoundController.init() end

return SoundController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--!strict
-- Window manager. One modal window at a time: the main menu (tabs) or a station view opened
-- by the server (OpenView). Each view is a module in UI/Views with mount(container, ctx) and
-- an optional refresh(); views re-render when the synced profile changes.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local ClientState = require(script.Parent.Parent.ClientState)
local InputController = require(script.Parent.InputController)
local Kit = require(script.Parent.Parent.UI.Kit)
local Theme = require(script.Parent.Parent.UI.Theme)

local C = Theme.Colors
local Views = script.Parent.Parent.UI.Views
local UIController = {}

local player = Players.LocalPlayer
local gui: ScreenGui
local window: Frame? = nil
local content: Frame? = nil
local activeView: any = nil
local activeName: string? = nil
local tabButtons: { [string]: any } = {}

local MENU_TABS = {
	{ id = "Inventory", label = "Inventory" },
	{ id = "Loadout", label = "Loadout" },
	{ id = "Mastery", label = "Mastery" },
	{ id = "Quests", label = "Quests" },
	{ id = "Codex", label = "Codex" },
	{ id = "Party", label = "Party" },
	{ id = "Stats", label = "Stats" },
	{ id = "Settings", label = "Settings" },
	{ id = "Store", label = "Store" },
	{ id = "Help", label = "Help" },
}

local STATION_TITLES = {
	Forge = "THE SOULFORGE",
	Fusion = "FUSION CHAMBER",
	Expedition = "RIFT PORTAL",
	BossGate = "WARDEN GATE",
	Trial = "KATANA TRIAL",
}

local function close()
	if activeView and activeView.destroy then
		pcall(activeView.destroy)
	end
	activeView = nil
	activeName = nil
	if window then
		window:Destroy()
		window = nil
		content = nil
	end
	tabButtons = {}
end

local function mountView(name: string, data: any?)
	if not content then
		return
	end
	if activeView and activeView.destroy then
		pcall(activeView.destroy)
	end
	Kit.clear(content :: Frame)
	local module = Views:FindFirstChild(name .. "View")
	if not module then
		Kit.text({ parent = content, text = "This view is not available yet.", color = C.TextDim })
		return
	end
	local view = require(module) :: any
	activeName = name
	activeView = view.mount(content, { data = data, close = close, open = UIController.open })
	for id, button in tabButtons do
		button.instance.BackgroundColor3 = if id == name then C.Accent else C.PanelLight
	end
end

local function buildWindow(title: string, withTabs: boolean)
	close()
	local frame = Kit.panel({
		parent = gui,
		size = UDim2.fromScale(0.86, 0.82),
		anchor = Vector2.new(0.5, 0.5),
		position = UDim2.fromScale(0.5, 0.52),
		color = C.Background,
		name = "Window",
		strokeColor = C.Accent,
	})
	frame.BackgroundTransparency = 0.04
	Kit.new("UISizeConstraint", { MaxSize = Vector2.new(1100, 760), MinSize = Vector2.new(320, 300), Parent = frame })
	Kit.text({ parent = frame, text = title, font = Theme.Fonts.Title, textSize = 24, position = UDim2.fromOffset(20, 12), size = UDim2.new(1, -120, 0, 32) })
	Kit.button({ parent = frame, text = "✕", size = UDim2.fromOffset(40, 36), anchor = Vector2.new(1, 0), position = UDim2.new(1, -12, 0, 10), color = C.PanelLight, onClick = close })
	local top = 54
	if withTabs then
		local tabs = Kit.new("ScrollingFrame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -40, 0, 44),
			Position = UDim2.fromOffset(20, 50),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.X,
			ScrollingDirection = Enum.ScrollingDirection.X,
			ScrollBarThickness = 3,
			BorderSizePixel = 0,
			Parent = frame,
		})
		Kit.list(tabs, 6, true)
		for i, tab in MENU_TABS do
			tabButtons[tab.id] = Kit.button({ parent = tabs, text = tab.label, size = UDim2.fromOffset(98, 36), color = C.PanelLight, order = i, textSize = 14, onClick = function()
				mountView(tab.id)
			end })
		end
		top = 100
	end
	local body = Kit.new("Frame", { Name = "Content", BackgroundTransparency = 1, Size = UDim2.new(1, -40, 1, -top - 16), Position = UDim2.fromOffset(20, top), Parent = frame })
	window = frame
	content = body
end

function UIController.open(name: string, data: any?)
	local station = STATION_TITLES[name]
	if station then
		buildWindow(station, false)
	else
		buildWindow("RIFTBOUND: SOULFORGE", true)
	end
	mountView(name, data)
end

function UIController.isOpen(): boolean
	return window ~= nil
end

function UIController.toggleMenu()
	if window then
		close()
	else
		UIController.open("Inventory")
	end
end

function UIController.init()
	gui = Kit.new("ScreenGui", {
		Name = "Menus",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		DisplayOrder = 20,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	InputController.isBlocked = UIController.isOpen
	InputController.toggleMenu = UIController.toggleMenu
	Net.event("OpenView").OnClientEvent:Connect(function(name, data)
		if type(name) == "string" then
			UIController.open(name, data)
		end
	end)
	ClientState.Changed:Connect(function(key)
		if activeView and activeView.refresh and (key == "profile" or key == "party" or key == "boss" or key == "trial" or key == "expedition") then
			local ok, err = pcall(activeView.refresh, key)
			if not ok then
				warn("[UI] refresh " .. tostring(activeName) .. ": " .. tostring(err))
			end
		end
	end)
	player.CharacterRemoving:Connect(function()
		-- keep menus open across respawn; nothing to clean
	end)
end

return UIController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">WaypointController</string>
              <string name="Source"><![CDATA[--!strict
-- Onboarding guide: a soft beam + marker pointing at the current main-quest destination.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local QuestConfig = require(Shared.Config.QuestConfig)
local WorldConfig = require(Shared.Config.WorldConfig)
local ClientState = require(script.Parent.Parent.ClientState)

local WaypointController = {}

local player = Players.LocalPlayer
local marker: Part? = nil
local playerAttachment: Attachment? = nil
local enabled = true

-- The first unclaimed main quest whose requirements are met.
function WaypointController.currentMainQuest(): any?
	local profile = ClientState.profile
	if not profile then
		return nil
	end
	for _, id in QuestConfig.Order do
		local def = QuestConfig.Quests[id]
		if def.category == "Main" and not profile.quests.claimed[id] then
			local ok = true
			for _, req in def.requires or {} do
				if not profile.quests.completed[req] then
					ok = false
				end
			end
			if ok then
				return def
			end
		end
	end
	return nil
end

local function targetPosition(): Vector3?
	local quest = WaypointController.currentMainQuest()
	if not quest then
		return nil
	end
	local profile = ClientState.profile
	if profile.quests.completed[quest.id] then
		return nil -- complete: claim it from the menu, no destination needed
	end
	local key = WorldConfig.QuestWaypoints[quest.id]
	local region = player:GetAttribute("Region")
	if not key then
		-- Emberfall quests without a fixed point: guide to the portal while in the Nexus.
		if region == "Nexus" then
			return WorldConfig.Points.ExpeditionPortal
		end
		return nil
	end
	local position = WorldConfig.Points[key]
	if not position then
		return nil
	end
	-- Emberfall destinations seen from the Nexus: point to the portal first.
	local inNexus = region == "Nexus"
	if quest.id == "m03_rift" and not inNexus then
		return WorldConfig.Points.FrontierGate
	end
	if inNexus and position.X > 500 then
		return WorldConfig.Points.ExpeditionPortal
	end
	if not inNexus and position.X < 500 and quest.id ~= "m06_extract" then
		return WorldConfig.Points.CampReturnPortal
	end
	return position
end

function WaypointController.setEnabled(value: boolean)
	enabled = value
end

function WaypointController.init()
	marker = Instance.new("Part")
	local m = marker :: Part
	m.Name = "QuestWaypoint"
	m.Anchored = true
	m.CanCollide = false
	m.CanQuery = false
	m.CanTouch = false
	m.Transparency = 1
	m.Size = Vector3.one
	m.Parent = workspace
	local a1 = Instance.new("Attachment")
	a1.Parent = m
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(60, 60)
	gui.AlwaysOnTop = true
	gui.StudsOffset = Vector3.new(0, 6, 0)
	gui.Parent = m
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "▼"
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 220, 120)
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
	local distance = Instance.new("TextLabel")
	distance.Name = "Distance"
	distance.Size = UDim2.new(2, 0, 0.4, 0)
	distance.Position = UDim2.new(-0.5, 0, 1, 0)
	distance.BackgroundTransparency = 1
	distance.TextScaled = true
	distance.Font = Enum.Font.GothamBold
	distance.TextColor3 = Color3.fromRGB(255, 235, 180)
	distance.TextStrokeTransparency = 0.3
	distance.Parent = gui

	local b = Instance.new("Beam")
	b.Attachment1 = a1
	b.Color = ColorSequence.new(Color3.fromRGB(255, 220, 120))
	b.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0.9) })
	b.Width0 = 0.4
	b.Width1 = 0.4
	b.FaceCamera = true
	b.LightEmission = 1
	b.Segments = 1
	b.Parent = m

	local function attach()
		local character = player.Character or player.CharacterAdded:Wait()
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root then
			local a0 = Instance.new("Attachment")
			a0.Name = "WaypointAttachment"
			a0.Position = Vector3.new(0, -2, 0)
			a0.Parent = root
			playerAttachment = a0
			b.Attachment0 = a0
		end
	end
	player.CharacterAdded:Connect(function()
		task.defer(attach)
	end)
	task.spawn(attach)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.25 then
			return
		end
		accumulator = 0
		local target = if enabled then targetPosition() else nil
		if target then
			m.CFrame = CFrame.new(target + Vector3.new(0, 2, 0))
			gui.Enabled = true
			b.Enabled = true
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local d = (root.Position - target).Magnitude
				distance.Text = string.format("%dm", math.floor(d))
				if d < 12 then
					b.Enabled = false
				end
			end
		else
			gui.Enabled = false
			b.Enabled = false
		end
		local _ = playerAttachment
	end)
end

return WaypointController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">ZoneController</string>
              <string name="Source"><![CDATA[--!strict
-- Region mood: tweens atmosphere / colour grading per region and swaps music hooks.
-- Also applies the Warden arena's "Last Fracture" transformation tint.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local WorldConfig = require(Shared.Config.WorldConfig)
local SoundController = require(script.Parent.SoundController)
local EffectsController = require(script.Parent.EffectsController)

local ZoneController = {}

local player = Players.LocalPlayer
local current: string? = nil
local arenaOverride = false

local function apply(regionId: string)
	local mood = WorldConfig.Moods[regionId]
	if not mood then
		return
	end
	local info = TweenInfo.new(2.5, Enum.EasingStyle.Sine)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		TweenService:Create(atmosphere, info, { Color = mood.fog, Haze = mood.haze, Density = mood.density }):Play()
	end
	local grade = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
	if grade then
		local tint = if arenaOverride then Color3.fromRGB(255, 170, 190) else mood.tint
		TweenService:Create(grade, info, { TintColor = tint }):Play()
	end
	TweenService:Create(Lighting, info, { ClockTime = mood.clock }):Play()
	if regionId == "Nexus" then
		SoundController.music("MusicNexus")
	elseif regionId == "Arena" then
		SoundController.music("MusicBoss")
	else
		SoundController.music("MusicEmberfall")
	end
end

function ZoneController.init()
	EffectsController.onArenaTransform = function(active: boolean)
		arenaOverride = active
		if current then
			apply(current)
		end
	end
	local function check()
		local region = player:GetAttribute("Region")
		if type(region) == "string" and region ~= "" and region ~= current then
			current = region
			apply(region)
		end
	end
	player:GetAttributeChangedSignal("Region"):Connect(check)
	check()
end

return ZoneController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="93">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Client entry point. Controllers initialise in dependency order; each is isolated so one
-- failing (e.g. a missing optional asset) never stops the rest of the client.

local Controllers = script.Parent.Controllers
local ClientState = require(script.Parent.ClientState)

ClientState.init()

local ORDER = {
	"SoundController",
	"CameraController",
	"AnimationController",
	"EffectsController",
	"NotificationController",
	"CombatController",
	"InputController",
	"UIController",
	"HUDController",
	"ZoneController",
	"WaypointController",
}

for _, name in ORDER do
	local ok, err = pcall(function()
		local controller = require(Controllers:WaitForChild(name)) :: any
		controller.init()
	end)
	if not ok then
		warn(string.format("[Client] %s failed to start: %s", name, tostring(err)))
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="94">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!strict
-- Reusable UI building blocks. Views compose these; no view builds raw styling by hand.

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)
local C = Theme.Colors

local Kit = {}

function Kit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	if props then
		for key, value in props do
			if key ~= "Parent" then
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function Kit.corner(parent: Instance, radius: number?)
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, radius or 10), Parent = parent })
end

function Kit.stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?)
	return Kit.new("UIStroke", {
		Color = color or C.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0.2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function Kit.padding(parent: Instance, px: number)
	return Kit.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

function Kit.list(parent: Instance, padding: number?, horizontal: boolean?, align: Enum.HorizontalAlignment?)
	return Kit.new("UIListLayout", {
		Padding = UDim.new(0, padding or 6),
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

function Kit.panel(props: { [string]: any }): Frame
	local frame = Kit.new("Frame", {
		BackgroundColor3 = props.color or C.Panel,
		BackgroundTransparency = props.transparency or 0.05,
		BorderSizePixel = 0,
		Size = props.size or UDim2.fromScale(1, 1),
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		AutomaticSize = props.autoSize or Enum.AutomaticSize.None,
		LayoutOrder = props.order or 0,
		Name = props.name or "Panel",
		Visible = if props.visible == nil then true else props.visible,
		ClipsDescendants = props.clip or false,
		Parent = props.parent,
	})
	Kit.corner(frame, props.radius)
	if props.stroke ~= false then
		Kit.stroke(frame, props.strokeColor)
	end
	if props.pad then
		Kit.padding(frame, props.pad)
	end
	return frame
end

function Kit.text(props: { [string]: any }): TextLabel
	return Kit.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = props.text or "",
		TextColor3 = props.color or C.Text,
		Font = props.font or Theme.Fonts.Body,
		TextSize = props.textSize or 16,
		TextWrapped = if props.wrap == nil then true else props.wrap,
		TextXAlignment = props.alignX or Enum.TextXAlignment.Left,
		TextYAlignment = props.alignY or Enum.TextYAlignment.Center,
		Size = props.size or UDim2.new(1, 0, 0, (props.textSize or 16) + 6),
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		AutomaticSize = props.autoSize or Enum.AutomaticSize.None,
		RichText = props.rich or false,
		LayoutOrder = props.order or 0,
		Name = props.name or "Text",
		TextScaled = props.scaled or false,
		TextStrokeTransparency = props.strokeT or 1,
		Parent = props.parent,
	})
end

export type Button = { instance: TextButton, setEnabled: (boolean, string?) -> (), setText: (string) -> () }

function Kit.button(props: { [string]: any }): Button
	local base = props.color or C.Accent
	local button: TextButton = Kit.new("TextButton", {
		BackgroundColor3 = base,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = props.text or "Button",
		TextColor3 = props.textColor or Color3.new(1, 1, 1),
		Font = Theme.Fonts.Bold,
		TextSize = props.textSize or 16,
		TextWrapped = true,
		Size = props.size or UDim2.new(0, 160, 0, 38),
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		LayoutOrder = props.order or 0,
		Name = props.name or "Button",
		Parent = props.parent,
	})
	Kit.corner(button, 8)
	local enabled = true
	local hover = base:Lerp(Color3.new(1, 1, 1), 0.15)
	button.MouseEnter:Connect(function()
		if enabled then
			TweenService:Create(button, TweenInfo.new(0.12), { BackgroundColor3 = hover }):Play()
		end
	end)
	button.MouseLeave:Connect(function()
		if enabled then
			TweenService:Create(button, TweenInfo.new(0.12), { BackgroundColor3 = base }):Play()
		end
	end)
	button.Activated:Connect(function()
		if enabled and props.onClick then
			props.onClick()
		end
	end)
	local api = { instance = button }
	function api.setEnabled(value: boolean, reason: string?)
		enabled = value
		button.BackgroundColor3 = if value then base else C.PanelLight
		button.TextColor3 = if value then (props.textColor or Color3.new(1, 1, 1)) else C.TextMuted
		if reason and not value then
			button.Text = reason
		elseif value then
			button.Text = props.text or button.Text
		end
	end
	function api.setText(text: string)
		props.text = text
		button.Text = text
	end
	return api :: any
end

function Kit.scroll(props: { [string]: any }): ScrollingFrame
	local frame = Kit.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = props.size or UDim2.fromScale(1, 1),
		Position = props.position or UDim2.new(),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.Stroke,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		LayoutOrder = props.order or 0,
		Name = props.name or "Scroll",
		Parent = props.parent,
	})
	Kit.list(frame, props.padding or 8)
	Kit.new("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = frame })
	return frame
end

-- Progress bar. Returns setter.
function Kit.bar(props: { [string]: any }): { frame: Frame, fill: Frame, label: TextLabel, set: (number, string?) -> () }
	local frame = Kit.new("Frame", {
		BackgroundColor3 = props.back or Color3.fromRGB(10, 10, 16),
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Size = props.size or UDim2.new(1, 0, 0, 14),
		Position = props.position or UDim2.new(),
		LayoutOrder = props.order or 0,
		Name = props.name or "Bar",
		Parent = props.parent,
	})
	Kit.corner(frame, props.radius or 6)
	local fill = Kit.new("Frame", {
		BackgroundColor3 = props.color or C.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Name = "Fill",
		Parent = frame,
	})
	Kit.corner(fill, props.radius or 6)
	local label = Kit.text({
		parent = frame,
		text = "",
		textSize = props.textSize or 12,
		font = Theme.Fonts.Bold,
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.fromScale(1, 1),
		strokeT = 0.5,
	})
	label.ZIndex = 3
	local api = { frame = frame, fill = fill, label = label }
	function api.set(fraction: number, text: string?)
		fraction = math.clamp(fraction, 0, 1)
		if props.instant then
			fill.Size = UDim2.fromScale(fraction, 1)
		else
			TweenService:Create(fill, TweenInfo.new(0.15), { Size = UDim2.fromScale(fraction, 1) }):Play()
		end
		if text then
			label.Text = text
		end
	end
	return api :: any
end

function Kit.chip(parent: Instance, text: string, color: Color3, order: number?): TextLabel
	local label = Kit.text({
		parent = parent,
		text = text,
		textSize = 13,
		font = Theme.Fonts.Bold,
		color = color,
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.fromOffset(0, 24),
		autoSize = Enum.AutomaticSize.X,
		wrap = false,
		order = order,
	})
	label.BackgroundTransparency = 0.75
	label.BackgroundColor3 = color
	Kit.corner(label, 12)
	Kit.new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = label })
	return label
end

-- A card with a title row and a vertical content list (auto height).
function Kit.card(parent: Instance, title: string?, order: number?, accent: Color3?): Frame
	local card = Kit.panel({
		parent = parent,
		color = C.Card,
		size = UDim2.new(1, 0, 0, 0),
		autoSize = Enum.AutomaticSize.Y,
		order = order,
		pad = 12,
		strokeColor = accent,
		name = "Card",
	})
	Kit.list(card, 6)
	if title then
		Kit.text({ parent = card, text = title, font = Theme.Fonts.Bold, textSize = 18, color = accent or C.Text, order = 0 })
	end
	return card
end

-- Requirement line list: each entry { text, met }.
function Kit.requirements(parent: Instance, entries: { { text: string, met: boolean } }, order: number?)
	local holder = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order or 0,
		Parent = parent,
	})
	Kit.list(holder, 2)
	for i, entry in entries do
		Kit.text({
			parent = holder,
			text = (if entry.met then "✔ " else "✖ ") .. entry.text,
			color = if entry.met then C.Good else C.Bad,
			textSize = 14,
			order = i,
		})
	end
	return holder
end

function Kit.row(parent: Instance, order: number?, height: number?): Frame
	local row = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height or 40),
		AutomaticSize = if height then Enum.AutomaticSize.None else Enum.AutomaticSize.Y,
		LayoutOrder = order or 0,
		Parent = parent,
	})
	Kit.list(row, 8, true)
	return row
end

function Kit.clear(container: Instance)
	for _, child in container:GetChildren() do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") and not child:IsA("UIGridLayout") then
			child:Destroy()
		end
	end
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">QuestLogic</string>
              <string name="Source"><![CDATA[--!strict
-- Derives quest display state from the synced profile (display only; server is authoritative).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local QuestConfig = require(Shared.Config.QuestConfig)

local QuestLogic = {}

export type Entry = {
	def: any,
	counts: { number },
	complete: boolean,
	claimed: boolean,
	available: boolean,
	daily: boolean,
}

local function dayKey(): number
	return math.floor(workspace:GetServerTimeNow() / 86400)
end

function QuestLogic.dailyDefs(): { any }
	local defs = {}
	for _, idx in QuestConfig.dailyPicks(dayKey()) do
		local entry = QuestConfig.DailyPool[idx]
		table.insert(defs, {
			id = entry.id,
			title = entry.title,
			category = "Daily",
			description = "Daily challenge. Resets at 00:00 UTC.",
			objectives = entry.objectives,
			rewards = entry.rewards,
			dailyPick = true,
		})
	end
	return defs
end

local function requirementsMet(profile: any, def: any): boolean
	for _, req in def.requires or {} do
		if not profile.quests.completed[req] then
			return false
		end
	end
	return true
end

function QuestLogic.entries(profile: any): { Entry }
	local list = {}
	local sameDay = profile.daily.dayKey == dayKey()
	for _, id in QuestConfig.Order do
		local def = QuestConfig.Quests[id]
		local isDaily = def.daily == true
		local progress, complete, claimed
		if isDaily then
			progress = sameDay and profile.daily.progress[id] or nil
			claimed = sameDay and profile.daily.claimed[id] == true
			complete = progress ~= nil and progress.done == true
		else
			progress = profile.quests.progress[id]
			complete = profile.quests.completed[id] == true
			claimed = profile.quests.claimed[id] == true
		end
		table.insert(list, {
			def = def,
			counts = (progress and progress.counts) or {},
			complete = complete,
			claimed = claimed,
			available = requirementsMet(profile, def),
			daily = isDaily,
		})
	end
	if profile.level >= QuestConfig.DailyLevel then
		for _, def in QuestLogic.dailyDefs() do
			local progress = sameDay and profile.daily.progress[def.id] or nil
			table.insert(list, {
				def = def,
				counts = (progress and progress.counts) or {},
				complete = progress ~= nil and progress.done == true,
				claimed = sameDay and profile.daily.claimed[def.id] == true,
				available = true,
				daily = true,
			})
		end
	end
	return list
end

-- Short list for the HUD tracker: claimable first, then the main path, then others.
function QuestLogic.tracked(profile: any, max: number): { Entry }
	local out = {}
	local entries = QuestLogic.entries(profile)
	for _, e in entries do
		if e.available and e.complete and not e.claimed then
			table.insert(out, e)
		end
	end
	for _, e in entries do
		if #out >= max then
			break
		end
		if e.available and not e.complete and e.def.category == "Main" then
			table.insert(out, e)
			break
		end
	end
	for _, e in entries do
		if #out >= max then
			break
		end
		if e.available and not e.complete and not table.find(out, e) and next(e.counts) then
			table.insert(out, e)
		end
	end
	while #out > max do
		table.remove(out)
	end
	return out
end

return QuestLogic
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
-- Visual language: dark neutral panels, strong text contrast, restrained essence accents.

local Theme = {}

Theme.Colors = {
	Background = Color3.fromRGB(14, 15, 22),
	Panel = Color3.fromRGB(22, 24, 34),
	PanelLight = Color3.fromRGB(32, 35, 50),
	Card = Color3.fromRGB(28, 31, 44),
	Stroke = Color3.fromRGB(64, 68, 92),
	Text = Color3.fromRGB(238, 240, 248),
	TextDim = Color3.fromRGB(160, 165, 188),
	TextMuted = Color3.fromRGB(110, 114, 136),
	Accent = Color3.fromRGB(170, 120, 255),
	Gold = Color3.fromRGB(255, 205, 110),
	Good = Color3.fromRGB(110, 230, 150),
	Bad = Color3.fromRGB(255, 100, 100),
	Warn = Color3.fromRGB(255, 180, 80),
	Health = Color3.fromRGB(230, 72, 88),
	Stamina = Color3.fromRGB(110, 210, 140),
	Resonance = Color3.fromRGB(190, 130, 255),
	Ember = Color3.fromRGB(255, 106, 61),
	Storm = Color3.fromRGB(79, 195, 255),
	Gravity = Color3.fromRGB(162, 123, 255),
}

Theme.Fonts = {
	Title = Enum.Font.GothamBlack,
	Bold = Enum.Font.GothamBold,
	Medium = Enum.Font.GothamMedium,
	Body = Enum.Font.Gotham,
}

Theme.Radius = UDim.new(0, 10)

function Theme.essenceColor(id: string?): Color3
	if id == "Ember" then
		return Theme.Colors.Ember
	elseif id == "Storm" then
		return Theme.Colors.Storm
	elseif id == "Gravity" then
		return Theme.Colors.Gravity
	end
	return Theme.Colors.TextDim
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">ViewUtil</string>
              <string name="Source"><![CDATA[--!strict
-- Small helpers shared by views: a re-renderable scroll body and paragraph text.

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local ClientState = require(script.Parent.Parent.ClientState)
local Costs = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Inventory.Costs)
local ItemConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Config.ItemConfig)

local C = Theme.Colors
local ViewUtil = {}

-- Creates a scroll body and returns a view object that re-renders via `render(body, profile)`.
function ViewUtil.simple(container: Instance, render: (ScrollingFrame, any) -> (), keys: { string }?)
	local body = Kit.scroll({ parent = container })
	local function draw()
		Kit.clear(body)
		local profile = ClientState.profile
		if not profile then
			Kit.text({ parent = body, text = "Loading your profile...", color = C.TextDim })
			return
		end
		render(body, profile)
	end
	draw()
	return {
		refresh = function(key: string)
			if not keys or table.find(keys, key) then
				draw()
			end
		end,
		destroy = function()
			body:Destroy()
		end,
		redraw = draw,
	}
end

function ViewUtil.para(parent: Instance, text: string, color: Color3?, order: number?, size: number?)
	return Kit.text({
		parent = parent,
		text = text,
		color = color or C.TextDim,
		textSize = size or 14,
		order = order,
		size = UDim2.new(1, 0, 0, 0),
		autoSize = Enum.AutomaticSize.Y,
		rich = true,
	})
end

function ViewUtil.heading(parent: Instance, text: string, order: number?, color: Color3?)
	return Kit.text({ parent = parent, text = text, font = Theme.Fonts.Title, textSize = 20, color = color or C.Text, order = order })
end

local function itemName(key: string): string
	if key == "Coins" then
		return "Coins"
	end
	local def = ItemConfig.Items[key]
	return def and def.name or key
end

-- Requirement lines for a cost table against the current profile.
function ViewUtil.costLines(profile: any, cost: any): { { text: string, met: boolean } }
	local lines = {}
	local keys = {}
	for key in cost do
		table.insert(keys, key)
	end
	table.sort(keys)
	for _, key in keys do
		local have = Costs.have(profile, key)
		table.insert(lines, { text = string.format("%s %d/%d", itemName(key), have, cost[key]), met = have >= cost[key] })
	end
	return lines
end

ViewUtil.itemName = itemName

return ViewUtil
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="99">
            <Properties>
              <string name="Name">Views</string>
            </Properties>
            <Item class="ModuleScript" referent="100">
              <Properties>
                <string name="Name">BossGateView</string>
                <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local BossConfig = require(Shared.Config.BossConfig)
local DiscoveryConfig = require(Shared.Config.DiscoveryConfig)
local Kit = require(script.Parent.Parent.Kit)
local Theme = require(script.Parent.Parent.Theme)
local ViewUtil = require(script.Parent.Parent.ViewUtil)
local ClientState = require(script.Parent.Parent.Parent.ClientState)

local C = Theme.Colors
local View = {}

function View.mount(container: Instance, ctx: any)
	return ViewUtil.simple(container, function(body, profile)
		local def = BossConfig.FractureWarden
		local card = Kit.card(body, def.displayName .. " — " .. def.title, 1, Color3.fromRGB(255, 70, 140))
		ViewUtil.para(card, def.lore, C.TextDim, 1)
		ViewUtil.para(card, "Location: the Fracture Arena, beyond the Ruined Keep (depth 3). Break the Fracture Seal; the arena locks 10 seconds later with everyone inside.", C.Text, 2)
		for i, phase in def.phases do
			ViewUtil.para(card, string.format("Phase %d — %s (from %d%% health)", phase.id, phase.name, math.floor(phase.threshold * 100)), C.Warn, 2 + i, 13)
		end
		ViewUtil.para(card, "Scales with party size. Rewards go to everyone who contributed (damage, parries, interrupts or Breaches).", C.TextDim, 10, 13)
		local intel = Kit.card(body, "Your intel", 2)
		for i, key in { "WardenLanceWeakness", "WardenBackCrystal" } do
			local d = DiscoveryConfig.Discoveries[key]
			local found = profile.codex.discoveries[key] ~= nil
			ViewUtil.para(intel, if found then "◆ " .. d.text else "◇ " .. d.hint, if found then C.Good else C.TextMuted, i)
		end
		local record = profile.bosses.FractureWarden
		ViewUtil.para(intel, string.format("Clears: %d", record.clears), C.Gold, 5)
		local shortcut = Kit.card(body, "Warden Gate shortcut", 3, C.Accent)
		ViewUtil.para(shortcut, "Veterans can step straight to the Warden's Approach (depth 3 — your Satchel is at risk there).", C.TextDim, 1)
		local b = Kit.button({ parent = shortcut, text = "Step through the gate", color = Color3.fromRGB(255, 70, 140), order = 2, size = UDim2.fromOffset(240, 38), onClick = function()
			local ok = ClientState.request("WardenShortcut", {})
			if ok then
				ctx.close()
			end
		end })
		b.setEnabled(record.clears > 0, if record.clears == 0 then "Defeat the Warden once to unlock" else nil)
	end, { "profile" })
end

return View
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="101">
              <Properties>
                <string name="Name">CodexView</string>
                <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local FusionConfig = require(Config.FusionConfig)
local EnemyConfig = require(Config.EnemyConfig)
local BossConfig = require(Config.BossConfig)
local DiscoveryConfig = require(Config.DiscoveryConfig)
local ProgressionConfig = require(Config.ProgressionConfig)
local WeaponConfig = require(Config.WeaponConfig)
local WorldConfig = require(Config.WorldConfig)
local CoopConfig = require(Config.CoopConfig)
local Kit = require(script.Parent.Parent.Kit)
local Theme = require(script.Parent.Parent.Theme)
local ViewUtil = require(script.Parent.Parent.ViewUtil)

local C = Theme.Colors
local View = {}

function View.mount(container: Instance, _ctx: any)
	return ViewUtil.simple(container, function(body, profile)
		local order = 0
		local function next(): number
			order += 1
			return order
		end
		ViewUtil.heading(body, "Fusion Codex", next())
		for _, id in FusionConfig.Order do
			local def = FusionConfig.Fusions[id]
			local record = profile.fusions[id]
			local card = Kit.card(body, def.displayName .. "  (" .. table.concat(def.essences, " + ") .. ")", next(), def.color)
			if not def.implemented then
				ViewUtil.para(card, def.summary, C.TextMuted, 1)
			elseif record and record.unlocked then
				ViewUtil.para(card, "UNLOCKED — " .. def.summary, C.Good, 1)
			else
				ViewUtil.para(card, def.summary, C.TextDim, 1)
				ViewUtil.para(card, "Hint: " .. def.hint, C.Accent, 2, 13)
				ViewUtil.para(card, if record and record.researched then string.format("Research done. Attunement %d/%d — %s", record.attunement, def.attunement.count, def.attunement.description) else "Research it at the Fusion Chamber in the Nexus.", C.Warn, 3, 13)
			end
		end
		ViewUtil.heading(body, "Cooperative Resonance", next())
		for _, id in CoopConfig.Order do
			local def = CoopConfig.Combos[id]
			local card = Kit.card(body, def.displayName, next(), def.color)
			ViewUtil.para(card, def.description, C.TextDim, 1)
		end
		ViewUtil.heading(body, "Bestiary", next())
		for _, id in EnemyConfig.BestiaryOrder do
			local entry = profile.codex.enemies[id]
			local def = EnemyConfig.Enemies[id] or BossConfig[id]
			local card = Kit.card(body, if entry then def.displayName else "??? (not yet encountered)", next())
			if entry then
				ViewUtil.para(card, def.lore, C.TextDim, 1)
				if def.tip then
					ViewUtil.para(card, "Tip: " .. def.tip, C.Accent, 2, 13)
				end
				ViewUtil.para(card, "Defeated: " .. entry.defeated, C.Text, 3, 13)
			end
			if id == "FractureWarden" then
				local boss = profile.bosses.FractureWarden
				ViewUtil.para(card, string.format("Clears: %d   Best time: %s", boss.clears, if boss.bestTime > 0 then string.format("%d:%02d", boss.bestTime // 60, boss.bestTime % 60) else "—"), C.Gold, 4, 13)
				for i, key in { "WardenLanceWeakness", "WardenBackCrystal" } do
					local d = DiscoveryConfig.Discoveries[key]
					ViewUtil.para(card, if profile.codex.discoveries[key] then "◆ " .. d.text else "◇ " .. d.hint, if profile.codex.discoveries[key] then C.Good else C.TextMuted, 4 + i, 13)
				end
			end
		end
		ViewUtil.heading(body, "Discoveries", next())
		for _, id in DiscoveryConfig.Order do
			local d = DiscoveryConfig.Discoveries[id]
			local found = profile.codex.discoveries[id] ~= nil
			local card = Kit.card(body, if found then d.displayName else "Undiscovered (" .. d.category .. ")", next(), if found then C.Gold else nil)
			ViewUtil.para(card, if found then d.text else "Hint: " .. d.hint, if found then C.TextDim else C.TextMuted, 1)
		end
		ViewUtil.heading(body, "Weapons", next())
		for _, id in WeaponConfig.Order do
			local def = WeaponConfig.Weapons[id]
			local card = Kit.card(body, def.displayName, next())
			ViewUtil.para(card, if def.implemented then def.description else "Not yet forged — planned for a future update.", if def.implemented then C.TextDim else C.TextMuted, 1)
		end
		ViewUtil.heading(body, "Regions", next())
		for _, region in WorldConfig.Regions do
			local seen = profile.codex.regions[region.id] ~= nil
			local card = Kit.card(body, if seen then region.name else "??? ", next())
			ViewUtil.para(card, if seen then "Depth " .. region.depth .. (if region.safe then " • safe" else "") else "Unexplored.", C.TextDim, 1)
		end
		for _, region in WorldConfig.FutureRegions do
			local card = Kit.card(body, region.name .. "  (coming later)", next())
			ViewUtil.para(card, region.teaser .. " Not playable in this version.", C.TextMuted, 1)
		end
		ViewUtil.heading(body, "Achievements", next())
		for _, id in ProgressionConfig.AchievementOrder do
			local def = ProgressionConfig.Achievements[id]
			local got = profile.achievements[id] ~= nil
			ViewUtil.para(body, string.format("%s <b>%s</b> — %s", if got then "★" else "☆", def.name, def.description), if got then C.Gold else C.TextMuted, next(), 14)
		end
	end, { "profile" })
end

return View
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="102">
              <Properties>
                <string name="Name">ExpeditionView</string>
                <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ExpeditionConfig = require(Shared.Config.ExpeditionConfig)
local Kit = require(script.Parent.Parent.Kit)
local Theme = require(script.Parent.Parent.Theme)
local ViewUtil = require(script.Parent.Parent.ViewUtil)
local ClientState = require(script.Parent.Parent.Parent.ClientState)

local C = Theme.Colors
local View = {}

function View.mount(container: Instance, ctx: any)
	return ViewUtil.simple(container, function(body, profile)
		local card = Kit.card(body, "Emberfall Frontier", 1, Color3.fromRGB(255, 140, 80))
		ViewUtil.para(card, "A burning frontier: ruined outpost, Cinder Ravine, the Ruined Keep and the Fracture Arena. Mine, hunt, explore, then extract.", C.TextDim, 1)
		ViewUtil.heading(card, "Before you go", 2, C.Warn)
		for i, rule in ExpeditionConfig.Rules do
			ViewUtil.para(card, "• " .. rule, C.Text, 2 + i, 14)
		end
		ViewUtil.para(card, "Leaving the game mid-expedition counts as a fall at your current depth; the rest is banked.", C.TextMuted, 20, 12)
		local row = Kit.row(card, 30, 44)
		Kit.button({ parent = row, text = "Launch expedition", color = Color3.fromRGB(255, 120, 60), size = UDim2.fromOffset(220, 40), order = 1, onClick = function()
			local ok = ClientState.request("EnterExpedition", { withParty = false })
			if ok then
				ctx.close()
			end
		end })
		local party = Kit.button({ parent = row, text = "Launch with party", color = Color3.fromRGB(110, 170, 255), size = UDim2.fromOffset(220, 40), order = 2, onClick = function()
			local ok = ClientState.request("EnterExpedition", { withParty = true })
			if ok then
				ctx.close()
			end
		end })
		party.setEnabled(ClientState.party ~= nil, if ClientState.party == nil then "No party" else nil)
		ViewUtil.para(card, "Party launch brings members standing at the portal with you.", C.TextMuted, 31, 12)
		local loadout = Kit.card(body, "Your build", 2)
		ViewUtil.para(loadout, string.format("Katana +%d • %s%s • Tonics x%d", profile.weapons.Katana.upgrade - 1, profile.loadout.primary, if profile.loadout.secondary ~= "" then " + " .. profile.loadout.secondary else "", profile.materials.EmberTonic or 0), C.Text, 1)
		Kit.button({ parent = loadout, text = "Change loadout", color = C.PanelLight, order = 2, onClick = function()
			ctx.open("Loadout")
		end })
	end, { "profile", "party" })
end

return View
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="103">
              <Properties>
                <string name="Name">ForgeView</string>
                <string name="Source"><![CDATA[--!strict
-- Forge (upgrades, tempers, evolution respec) + Artisan Bench crafting. Shows requirements,
-- current stats and resulting stats before confirming. The server re-validates everything.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local RecipeConfig = require(Config.RecipeConfig)
local WeaponConfig = require(Config.WeaponConfig)
local CombatMath = require(Shared.Combat.CombatMath)
local Costs = require(Shared.Inventory.Costs)
local Kit = require(script.Parent.Parent.Kit)
local Theme = require(script.Parent.Parent.Theme)
local ViewUtil = require(script.Parent.Parent.ViewUtil)
local ClientState = require(script.Parent.Parent.Parent.ClientState)

local C = Theme.Colors
local View = {}

local function compare(parent: Instance, before: any, after: any, order: number)
	local a = CombatMath.summary(before)
	local b = CombatMath.summary(after)
	for i, entry in a do
		local changed = entry.value ~= b[i].value
		ViewUtil.para(parent, string.format("%s: %s%s", entry.label, entry.value, if changed then "  →  <b>" .. b[i].value .. "</b>" else ""), if changed then C.Good else C.TextMuted, order + i, 13)
	end
end

function View.mount(container: Instance, ctx: any)
	local tab = if ctx.data and ctx.data.station == "Bench" then "Craft" else "Forge"
	local view
	view = ViewUtil.simple(container, function(body, profile)
		local row = Kit.row(body, 0, 40)
		for i, name in { "Forge", "Craft" } do
			Kit.button({ parent = row, text = if name == "Forge" then "Weapon Forge" else "Artisan Crafting", size = UDim2.fromOffset(180, 36), order = i, color = if tab == name then C.Accent else C.PanelLight, onClick = function()
				tab = name
				view.redraw()
			end })
		end
		local weapon = profile.weapons.Katana
		local current = CombatMath.weaponBuild("Katana", weapon)
		if tab == "Forge" then
			-- upgrade
			local target = weapon.upgrade + 1
			local recipe = RecipeConfig.Upgrades.Katana[target]
			local up = Kit.card(body, string.format("Upgrade Riftsteel Katana +%d", weapon.upgrade - 1), 1, C.Gold)
			if recipe then
				local lines = ViewUtil.costLines(profile, recipe.cost)
				table.insert(lines, 1, { text = "Player level " .. recipe.level, met = profile.level >= recipe.level })
				Kit.requirements(up, lines, 1)
				local after = table.clone(weapon)
				after.upgrade = target
				compare(up, current, CombatMath.weaponBuild("Katana", after), 10)
				local ok = Costs.canAfford(profile, recipe.cost) and profile.level >= recipe.level
				local b = Kit.button({ parent = up, text = "Upgrade to +" .. (target - 1), color = C.Gold, textColor = Color3.new(0, 0, 0), order = 30, size = UDim2.fromOffset(220, 38), onClick = function()
					ClientState.request("UpgradeWeapon", { weapon = "Katana" })
				end })
				b.setEnabled(ok, if not ok then "Missing requirements" else nil)
			else
				ViewUtil.para(up, "Maximum upgrade reached.", C.Good, 1)
			end
			-- tempers
			local tempers = Kit.card(body, "Tempers (one active): current " .. WeaponConfig.Tempers[weapon.temper].displayName, 2, C.Accent)
			for i, id in WeaponConfig.TemperOrder do
				if id ~= "None" then
					local def = WeaponConfig.Tempers[id]
					local recipe2 = RecipeConfig.Tempers[id]
					local card = Kit.card(tempers, def.displayName .. (if weapon.temper == id then "  (applied)" else ""), 10 + i)
					ViewUtil.para(card, def.description, C.TextDim, 1, 13)
					local lines = ViewUtil.costLines(profile, recipe2.cost)
					if recipe2.blueprint then
						table.insert(lines, 1, { text = "Blueprint: Sunfall (hidden somewhere in Emberfall)", met = profile.blueprints[recipe2.blueprint] == true })
					end
					Kit.requirements(card, lines, 2)
					local after = table.clone(weapon)
					after.temper = id
					compare(card, current, CombatMath.weaponBuild("Katana", after), 10)
					local ok = Costs.canAfford(profile, recipe2.cost) and (not recipe2.blueprint or profile.blueprints[recipe2.blueprint] == true) and weapon.temper ~= id
					local b = Kit.button({ parent = card, text = "Apply temper", order = 30, onClick = function()
						ClientState.request("ApplyTemper", { temper = id })
					end })
					b.setEnabled(ok, if weapon.temper == id then "Applied" elseif not ok then "Missing requirements" else nil)
				end
			end
			ViewUtil.para(body, "Tempers and upgrades never break or destroy your weapon. Switching tempers replaces the old one.", C.TextMuted, 3, 12)
			if weapon.evolution ~= "None" then
				local respec = Kit.card(body, "Change evolution branch", 4)
				ViewUtil.para(respec, "Costs " .. Costs.describe(RecipeConfig.EvolutionRespec.cost) .. ". Mastery is kept. Use the Mastery tab to pick the other branch while standing here.", C.TextDim, 1, 13)
			end
		else
			local tools = Kit.card(body, "Artisan Bench", 1, Color3.fromRGB(150, 210, 255))
			for i, id in RecipeConfig.CraftOrder do
				local recipe = RecipeConfig.Crafts[id]
				local card = Kit.card(tools, recipe.displayName, 10 + i)
				ViewUtil.para(card, recipe.description, C.TextDim, 1, 13)
				Kit.requirements(card, ViewUtil.costLines(profile, recipe.cost), 2)
				local done = recipe.result.kind == "Tool" and profile.tools.pickTier >= recipe.result.tier
				local ok = Costs.canAfford(profile, recipe.cost) and not done
				local b = Kit.button({ parent = card, text = "Craft", order = 3, onClick = function()
					ClientState.request("Craft", { recipe = id })
				end })
				b.setEnabled(ok, if done then "Owned" elseif not ok then "Missing materials" else nil)
			end
		end
	end, { "profile" })
	return view
end

return View
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="104">
              <Properties>
                <string name="Name">FusionView</string>
                <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local FusionConfig = require(Config.FusionConfig)
local EssenceConfig = require(Config.EssenceConfig)
local Costs = require(Shared.Inventory.Costs)
local Kit = require(script.Parent.Parent.Kit)
local Theme = require(script.Parent.Parent.Theme)
local ViewUtil = require(script.Parent.Parent.ViewUtil)
local ClientState = require(script.Parent.Parent.Parent.ClientState)

local C = Theme.Colors
local View = {}

function View.mount(container: Instance, _ctx: any)
	return ViewUtil.simple(container, function(body, profile)
		ViewUtil.para(body, "Fusions are new techniques, not damage multipliers. Step 1: research here. Step 2: attune in combat by chaining the two essences on the same enemy. Then equip both essences and press R.", C.TextDim, 0)
		for i, id in FusionConfig.Order do
			local def = FusionConfig.Fusions[id]
			local record = profile.fusions[id]
			local card = Kit.card(body, def.displayName .. "  (" .. table.concat(def.essences, " + ") .. ")", i, def.color)
			ViewUtil.para(card, def.summary, C.TextDim, 1)
			if not def.implemented then
				ViewUtil.para(card, "This resonance cannot be stabilised yet (future update).", C.TextMuted, 2)
			elseif record.unlocked then
				ViewUtil.para(card, "✔ Unlocked. Equip " .. table.concat(def.essences, " + ") .. " and press R.", C.Good, 2)
			elseif record.researched then
				ViewUtil.para(card, string.format("Research complete. Attunement %d/%d: %s", record.attunement, def.attunement.count, def.attunement.description), C.Warn, 2)
			else
				local lines = {}
				for _, essence in def.essences do
					table.insert(lines, { text = essence .. " essence unlocked", met = profile.essences[essence].unlocked })
				end
				for essence, level in def.research.masteries do
					table.insert(lines, { text = essence .. " mastery " .. level, met = profile.essences[essence].mastery >= level and profile.essences[essence].unlocked })
				end
				if def.research.discovery then
					local found = profile.codex.discoveries[def.research.discovery] ~= nil
					table.insert(lines, { text = if found then "Sunfall Tablet studied" else "Missing knowledge — " .. def.hint, met = found })
				end
				for _, line in ViewUtil.costLines(profile, def.research.cost) do
					table.insert(lines, line)
				end
				Kit.requirements(card, lines, 3)
				local all = true
				for _, line in lines do
					all = all and line.met
				end
				local b = Kit.button({ parent = card, text = "Research", color = def.color, order = 4, onClick = function()
					ClientState.request("ResearchFusion", { id = id })
				end })
				b.setEnabled(all, if not all then "Requirements missing" else nil)
			end
		end
		local attune = Kit.card(body, "Essence attunement", 10, C.Accent)
		ViewUtil.para(attune, "Essences can also be earned through contracts. Attunement is the deterministic alternative.", C.TextDim, 0, 13)
		for i, id in { "Storm", "Gravity" } do
			local def = EssenceConfig.Essences[id]
			local card = Kit.card(attune, def.displayName, i, def.color)
			if profile.essences[id].unlocked then
				ViewUtil.para(card, "✔ Attuned.", C.Good, 1)
			else
				local lines = ViewUtil.costLines(profile, def.attuneCost)
				table.insert(lines, 1, { text = "Player level " .. def.attuneLevel, met = profile.level >= def.attuneLevel })
				Kit.requirements(card, lines, 1)
				local ok = profile.level >= def.attuneLevel and Costs.canAfford(profile, def.attuneCost)
				local b = Kit.button({ parent = card, text = "Attune " .. def.displayName, color = def.color, order = 2, onClick = function()
					ClientState.request("AttuneEssence", { essence = id })
				end })
				b.setEnabled(ok, if not ok then "Requirements missing" else nil)
			end
		end
	end, { "profile" })
end

return View
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="105">
              <Properties>
                <string name="Name">HelpView</string>
                <string name="Source"><![CDATA[--!strict
local UserInputService = game:GetService("UserInputService")
local Kit = require(script.Parent.Parent.Kit)
local Theme = require(script.Parent.Parent.Theme)
local ViewUtil = require(script.Parent.Parent.ViewUtil)

local C = Theme.Colors
local View = {}

local SECTIONS = {
	{ "Getting started", {
		"1. Follow the golden beam: it points to your current main contract.",
		"2. Training Arena (east): strike the dummies, then parry and dodge the Sparring Golem.",
		"3. Rift Portal (south): enter Emberfall Frontier. Mine ore, hunt, explore.",
		"4. Bank your Satchel at an Extraction Beacon, then upgrade at the Forge.",
	} },
	{ "Keyboard & mouse", {
		"LMB light combo (hold to chain) • V heavy • RMB block (tap right before a hit = Perfect Parry)",
		"Shift dodge (invulnerable briefly) • Q / E essence abilities • R fusion technique",
		"G Awaken when Resonance is full (G again = signature) • H Ember Tonic • T lock-on • M menu • F interact",
	} },
	{ "Gamepad", { "R2 light • R1 heavy • L2 block • B dodge • X / Y abilities • L1 fusion • D-Pad Up awaken • D-Pad Down tonic • R3 lock-on • Select menu" } },
	{ "Touch", { "On-screen buttons on the right: ATTACK, HEAVY, BLOCK (hold), DODGE, Q, E, R, AWAKEN, LOCK, TONIC. Tap prompts to interact." } },
	{ "Reading attacks", {
		"Red areas fill up before they hit. '!' = can be parried. '⚠' = dodge or leave. '◎' ring = stand in the centre or outside.",
		"'OPEN! STRIKE' above an enemy = punish window. Guardians block light hits from the front: use heavy attacks.",
	} },
	{ "Resonance & Awakening", { "Resonance builds from hits, combos, perfect parries, dodging telegraphs and interrupting. Full = press G. After an awakening you burn out for 10s. The Warden's Suppression Pulse ends awakenings." } },
	{ "Fusion", { "Find the right knowledge, research the union at the Fusion Chamber, then attune it in combat by chaining one essence into the other on the same enemy." } },
	{ "Co-op", { "Different players chaining complementary essences on the same enemies trigger Cooperative Resonance. Against the Warden, a perfect parry followed by a teammate's strike on its back opens a Breach." } },
	{ "Risk", { "Depth 1/2/3 loses 25/50/75% of your Satchel on death. Mastery, XP, unlocks, achievements and purchases are never lost." } },
}

function View.mount(container: Instance, _ctx: any)
	return ViewUtil.simple(container, function(body, _profile)
		for i, section in SECTIONS do
			local card = Kit.card(body, section[1], i)
			for j, line in section[2] do
				ViewUtil.para(card, line, C.TextDim, j, 14)
			end
		end
		if UserInputService.TouchEnabled then
			ViewUtil.para(body, "Touch device detected: touch controls are enabled.", C.Good, 99)
		end
	end, {})
end

return View
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="106">
              <Properties>
                <string name="Name">InventoryView</string>
                <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ItemConfig = require(Shared.Config.ItemConfig)
local ResourceConfig = require(Shared.Config.ResourceConfig)
local Format = require(Shared.Util.Format)
local Kit = require(script.Parent.Parent.Kit)
local Theme = require(script.Parent.Parent.Theme)
local ViewUtil = require(script.Parent.Parent.ViewUtil)
local ClientState = require(script.Parent.Parent.Parent.ClientState)

local C = Theme.Colors
local View = {}

function View.mount(container: Instance, _ctx: any)
	return ViewUtil.simple(container, function(body, profile)
		local bank = Kit.card(body, "Bank (permanent)", 1, C.Gold)
		ViewUtil.para(bank, string.format("<font color=\"#ffcd6e\"><b>◆ %s coins</b></font>", Format.number(profile.coins)), C.Text, 1, 16)
		for i, id in ItemConfig.Order do
			local def = ItemConfig.Items[id]
			local row = Kit.row(bank, 10 + i, 0)
			Kit.chip(row, def.rarity, def.color, 1)
			Kit.text({ parent = row, text = string.format("%s  x%d", def.name, profile.materials[id] or 0), font = Theme.Fonts.Bold, textSize = 15, size = UDim2.fromOffset(240, 24), order = 2, wrap = false })
			ViewUtil.para(bank, def.description, C.TextDim, 10 + i, 12)
		end
		local tool = Kit.card(body, "Tools", 2)
		ViewUtil.para(tool, "Mining pick: <b>" .. (ResourceConfig.ToolTiers[profile.tools.pickTier] or "?") .. "</b> (tier " .. profile.tools.pickTier .. ")", C.Text, 1)
		local e = ClientState.expedition
		local satchel = Kit.card(body, "Satchel (unbanked expedition loot)", 3, C.Warn)
		local any = false
		if e and e.satchel then
			if e.satchel.coins > 0 then
				any = true
				ViewUtil.para(satchel, "◆ " .. e.satchel.coins .. " coins", C.Text, 1)
			end
			for i, id in ItemConfig.Order do
				local n = e.satchel.items[id]
				if n and n > 0 then
					any = true
					ViewUtil.para(satchel, ItemConfig.Items[id].name .. " x" .. n, C.Text, 1 + i)
				end
			end
		end
		if not any then
			ViewUtil.para(satchel, "Empty.", C.TextDim, 1)
		end
		ViewUtil.para(satchel, "Bank the Satchel at an Extraction Beacon. Dying in Emberfall loses part of it.", C.Warn, 50, 12)
	end, { "profile", "expedition" })
end

return View
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="107">
              <Properties>
                <string name="Name">LoadoutView</string>
                <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local EssenceConfig = require(Config.EssenceConfig)
local FusionConfig = require(Config.FusionConfig)
local ProgressionConfig = require(Config.ProgressionConfig)
local MonetizationConfig = require(Config.MonetizationConfig)
local Kit = require(script.Parent.Parent.Kit)
local Theme = require(script.Parent.Parent.Theme)
local ViewUtil = require(script.Parent.Parent.ViewUtil)
local ClientState = require(script.Parent.Parent.Parent.ClientState)

local C = Theme.Colors
local View = {}

function View.mount(container: Instance, _ctx: any)
	return ViewUtil.simple(container, function(body, profile)
		ViewUtil.para(body, "Change essences in the Nexus or at camp. Your build = Katana + primary essence (Q/E + Awakening) + secondary essence (fusion on R).", C.TextDim, 0)
		local slots = Kit.card(body, "Essence slots", 1, C.Accent)
		local primary = EssenceConfig.Essences[profile.loadout.primary]
		local secondary = EssenceConfig.Essences[profile.loadout.secondary]
		ViewUtil.para(slots, "Primary: <b>" .. (primary and primary.displayName or "—") .. "</b>   Secondary: <b>" .. (secondary and secondary.displayName or "—") .. "</b>", C.Text, 1, 16)
		local fusionId = FusionConfig.forPair(profile.loadout.primary, profile.loadout.secondary)
		if fusionId then
			local f = FusionConfig.Fusions[fusionId]
			local unlocked = profile.fusions[fusionId] and profile.fusions[fusionId].unlocked
			ViewUtil.para(slots, "Fusion pair: <b>" .. f.displayName .. "</b> " .. (if unlocked then "(ready on R)" else "(locked — see Fusion Codex)"), if unlocked then C.Good else C.Warn, 2)
		end
		if profile.level < EssenceConfig.SecondarySlotLevel then
			ViewUtil.para(slots, "Secondary slot unlocks at level " .. EssenceConfig.SecondarySlotLevel .. ".", C.Warn, 3)
		end
		for i, id in EssenceConfig.Order do
			local def = EssenceConfig.Essences[id]
			local record = profile.essences[id]
			local card = Kit.card(body, def.displayName, 10 + i, def.color)
			ViewUtil.para(card, def.theme, C.TextDim, 1)
			if not def.implemented then
				ViewUtil.para(card, "Sealed — " .. def.unlockHint, C.TextMuted, 2)
			elseif not record or not record.unlocked then
				ViewUtil.para(card, "Locked — " .. def.unlockHint, C.Warn, 2)
			else
				ViewUtil.para(card, "Mastery " .. record.mastery .. "/" .. def.maxMastery, C.Text, 2)
				local row = Kit.row(card, 3, 40)
				local isPrimary = profile.loadout.primary == id
				local isSecondary = profile.loadout.secondary == id
				local p = Kit.button({ parent = row, text = if isPrimary then "Primary ✔" else "Set Primary", color = def.color, order = 1, onClick = function()
					ClientState.request("EquipEssence", { slot = "primary", essence = id })
				end })
				p.setEnabled(not isPrimary)
				local s = Kit.button({ parent = row, text = if isSecondary then "Remove Secondary" else "Set Secondary", color = C.PanelLight, order = 2, onClick = function()
					ClientState.request("EquipEssence", { slot = "secondary", essence = if isSecondary then "" else id })
				end })
				s.setEnabled(not isPrimary and profile.level >= EssenceConfig.SecondarySlotLevel)
			end
		end
		-- saved loadouts
		local saved = Kit.card(body, "Saved loadouts", 30)
		local extra = profile.passes and profile.passes.ExtraLoadouts
		local count = ProgressionConfig.FreeLoadoutSlots + (if extra then ProgressionConfig.PassLoadoutSlots else 0)
		for i = 1, count do
			local entry = profile.loadouts[tostring(i)]
			local row = Kit.row(saved, i, 40)
			local label = if entry then string.format("Slot %d: %s + %s", i, entry.primary, if entry.secondary ~= "" then entry.secondary else "—") else string.format("Slot %d: empty", i)
			Kit.text({ parent = row, text = label, size = UDim2.fromOffset(260, 36), order = 1 })
			Kit.button({ parent = row, text = "Save current", size = UDim2.fromOffset(130, 34), color = C.PanelLight, order = 2, onClick = function()
				ClientState.request("SaveLoadout", { index = i })
			end })
			local apply = Kit.button({ parent = row, text = "Apply", size = UDim2.fromOffset(90, 34), order = 3, onClick = function()
				ClientState.request("ApplyLoadout", { index = i })
			end })
			apply.setEnabled(entry ~= nil)
		end
		if not extra then
			local pass = MonetizationConfig.GamePasses.ExtraLoadouts
			ViewUtil.para(saved, if MonetizationConfig.isConfigured(pass) then "More slots: " .. pass.displayName .. " (Store tab)." else "More slots: Loadout Archive pass (not available yet).", C.TextMuted, 99, 12)
		end
		-- cosmetics
		local cos = Kit.card(body, "Katana trail cosmetics", 40, C.Gold)
		for i, id in ProgressionConfig.CosmeticOrder do
			local def = ProgressionConfig.Cosmetics[id]
			local owned = profile.cosmetics.owned[id] == true
			local row = Kit.row(cos, i, 40)
			Kit.text({ parent = row, text = def.name .. "  •  " .. def.source, size = UDim2.fromOffset(380, 36), order = 1, color = if owned then C.Text else C.TextMuted })
			local b = Kit.button({ parent = row, text = if profile.cosmetics.trail == id then "Equipped" else "Equip", size = UDim2.fromOffset(110, 34), order = 2, onClick = function()
				ClientState.request("SelectCosmetic", { id = id })
			end })
			b.setEnabled(owned and profile.cosmetics.trail ~= id, if not owned then "Locked" else nil)
		end
	end, { "profile" })
end

return View
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="108">
              <Properties>
                <string name="Name">MasteryView</string>
                <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = Shared.Config
local WeaponConfig = require(Config.WeaponConfig)
local EssenceConfig = require(Config.EssenceConfig)
local ProgressionConfig = require(Config.ProgressionConfig)
local Leveling = require(Shared.Progression.Leveling)
local CombatMath = require(Shared.Combat.CombatMath)
local Kit = require(script.Parent.Parent.Kit)
local Theme = require(script.Parent.Parent.Theme)
local ViewUtil = require(script.Parent.Parent.ViewUtil)
local ClientState = require(script.Parent.Parent.Parent.ClientState)

local C = Theme.Colors
local View = {}

function View.mount(container: Instance, _ctx: any)
	return ViewUtil.simple(container, function(body, profile)
		local def = WeaponConfig.Weapons.Katana
		local weapon = profile.weapons.Katana
		local card = Kit.card(body, def.displayName .. " — Mastery " .. weapon.mastery .. "/" .. def.maxMastery, 1, def.trailColor)
		local bar = Kit.bar({ parent = card, color = C.Gold, order = 1 })
		bar.set(Leveling.progress(weapon.mastery, weapon.masteryXp, ProgressionConfig.weaponMasteryXp, def.maxMastery), string.format("%d / %d XP", math.floor(weapon.masteryXp), ProgressionConfig.weaponMasteryXp(weapon.mastery)))
		ViewUtil.para(card, "Mastery grows by landing katana strikes on real enemies (training targets give a trickle), defeating champions and bosses.", C.TextDim, 2, 12)
		local levels = {}
		for level in def.masteryUnlocks do
			table.insert(levels, level)
		end
		table.sort(levels)
		for i, level in levels do
			local reached = weapon.mastery >= level
			ViewUtil.para(card, string.format("%s M%d — %s", if reached then "✔" else "○", level, def.masteryUnlocks[level]), if reached then C.Good else C.TextDim, 10 + i)
		end
		-- current stats
		local stats = Kit.card(body, "Current moveset", 2)
		for i, entry in CombatMath.summary(CombatMath.weaponBuild("Katana", weapon)) do
			ViewUtil.para(stats, entry.label .. ": <b>" .. entry.value .. "</b>", C.Text, i)
		end
		-- evolution
		local evoCard = Kit.card(body, "Weapon Evolution", 3, C.Accent)
		local trialDone = profile.trials[def.evolutionTrial] ~= nil
		Kit.requirements(evoCard, {
			{ text = "Katana mastery " .. def.evolutionMastery .. " (now " .. weapon.mastery .. ")", met = weapon.mastery >= def.evolutionMastery },
			{ text = "Katana Trial completed (Training Arena pedestal)", met = trialDone },
		}, 1)
		local eligible = weapon.mastery >= def.evolutionMastery and trialDone
		for i, branch in { "Tempest", "Aegis" } do
			local evo = def.evolutions[branch]
			local c = Kit.card(evoCard, evo.displayName .. (if weapon.evolution == branch then "  (CURRENT)" else ""), 10 + i, evo.trailColor)
			ViewUtil.para(c, evo.summary, C.Text, 1)
			for j, line in evo.details do
				ViewUtil.para(c, "• " .. line, C.TextDim, 1 + j, 13)
			end
			local label = if weapon.evolution == "None" then "Evolve" else "Switch (500 coins, at Forge)"
			local b = Kit.button({ parent = c, text = label, color = evo.trailColor, textColor = Color3.new(0, 0, 0), size = UDim2.fromOffset(240, 36), order = 20, onClick = function()
				ClientState.request("ChooseEvolution", { branch = branch })
			end })
			b.setEnabled(eligible and weapon.evolution ~= branch, if not eligible then "Locked" else nil)
		end
		-- essences
		for i, id in { "Ember", "Storm", "Gravity" } do
			local ess = EssenceConfig.Essences[id]
			local record = profile.essences[id]
			local c = Kit.card(body, ess.displayName .. " mastery " .. (if record.unlocked then tostring(record.mastery) else "—"), 10 + i, ess.color)
			if record.unlocked then
				local b2 = Kit.bar({ parent = c, color = ess.color, order = 1 })
				b2.set(Leveling.progress(record.mastery, record.xp, ProgressionConfig.essenceMasteryXp, ess.maxMastery), string.format("%d XP", math.floor(record.xp)))
				for level = 1, ess.maxMastery do
					ViewUtil.para(c, string.format("%s M%d — %s", if record.mastery >= level then "✔" else "○", level, ess.masteryUnlocks[level]), if record.mastery >= level then C.Good else C.TextDim, 1 + level)
				end
			else
				ViewUtil.para(c, "Locked — " .. ess.unlockHint, C.Warn, 1)
			end
		end
	end, { "profile" })
end

return View
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="109">
              <Properties>
                <string name="Name">PartyView</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Kit = require(script.Parent.Parent.Kit)
local Theme = require(script.Parent.Parent.Theme)
local ViewUtil = require(script.Parent.Parent.ViewUtil)
local ClientState = require(script.Parent.Parent.Parent.ClientState)

local C = Theme.Colors
local View = {}

function View.mount(container: Instance, _ctx: any)
	local view
	view = ViewUtil.simple(container, function(body, _profile)
		local party = ClientState.party
		local me = Players.LocalPlayer
		local card = Kit.card(body, "Your party", 1, Color3.fromRGB(140, 200, 255))
		ViewUtil.para(card, "Server-local parties (max " .. GameConfig.Party.MaxSize .. "). Party members share contract kill credit and can launch expeditions together from the Rift Portal. Cross-server parties are not available.", C.TextDim, 1, 13)
		if party then
			for i, member in party.members do
				local row = Kit.row(card, 10 + i, 40)
				Kit.text({ parent = row, text = (if member.userId == party.leader then "★ " else "") .. member.name, size = UDim2.fromOffset(260, 36), order = 1 })
				if party.leader == me.UserId and member.userId ~= me.UserId then
					Kit.button({ parent = row, text = "Remove", size = UDim2.fromOffset(100, 34), color = C.Bad, order = 2, onClick = function()
						ClientState.request("PartyKick", { userId = member.userId })
					end })
				end
			end
			Kit.button({ parent = card, text = "Leave party", color = C.Bad, order = 50, onClick = function()
				ClientState.request("PartyLeave", {})
			end })
		else
			ViewUtil.para(card, "You are not in a party. Invite someone below.", C.Text, 2)
		end
		local invite = Kit.card(body, "Players in this server", 2)
		local count = 0
		for _, other in Players:GetPlayers() do
			if other ~= me then
				count += 1
				local row = Kit.row(invite, count, 40)
				Kit.text({ parent = row, text = other.DisplayName .. "  (@" .. other.Name .. ")", size = UDim2.fromOffset(300, 36), order = 1 })
				local canInvite = not party or party.leader == me.UserId
				local b = Kit.button({ parent = row, text = "Invite", size = UDim2.fromOffset(100, 34), order = 2, onClick = function()
					ClientState.request("PartyInvite", { userId = other.UserId })
				end })
				b.setEnabled(canInvite)
			end
		end
		if count == 0 then
			ViewUtil.para(invite, "Nobody else is here yet. Test with friends or Studio's multi-client test (see README).", C.TextDim, 1)
		end
	end, { "party", "profile" })
	return view
end

return View
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="110">
              <Properties>
                <string name="Name">QuestsView</string>
                <string name="Source"><![CDATA[--!strict
local Kit = require(script.Parent.Parent.Kit)
local Theme = require(script.Parent.Parent.Theme)
local ViewUtil = require(script.Parent.Parent.ViewUtil)
local QuestLogic = require(script.Parent.Parent.QuestLogic)
local ClientState = require(script.Parent.Parent.Parent.ClientState)

local C = Theme.Colors
local View = {}

local CATEGORY_COLORS = {
	Main = C.Gold,
	Exploration = Color3.fromRGB(150, 220, 255),
	Gathering = Color3.fromRGB(180, 200, 140),
	Mastery = Color3.fromRGB(200, 170, 255),
	Coop = Color3.fromRGB(120, 230, 200),
	Boss = Color3.fromRGB(255, 110, 160),
	Daily = Color3.fromRGB(255, 190, 110),
}

local function rewardText(r: any): string
	local parts = {}
	if r.coins then
		table.insert(parts, r.coins .. " coins")
	end
	if r.xp then
		table.insert(parts, r.xp .. " XP")
	end
	for item, n in r.items or {} do
		table.insert(parts, n .. " " .. ViewUtil.itemName(item))
	end
	if r.essence then
		table.insert(parts, r.essence .. " essence")
	end
	if r.weaponMastery then
		table.insert(parts, r.weaponMastery .. " katana mastery")
	end
	return table.concat(parts, ", ")
end

function View.mount(container: Instance, _ctx: any)
	return ViewUtil.simple(container, function(body, profile)
		local order = 0
		local entries = QuestLogic.entries(profile)
		local sections = {
			{ "Ready to claim", function(e)
				return e.available and e.complete and not e.claimed
			end },
			{ "Active", function(e)
				return e.available and not e.complete
			end },
			{ "Locked", function(e)
				return not e.available
			end },
			{ "Completed", function(e)
				return e.claimed
			end },
		}
		for _, section in sections do
			local list = {}
			for _, e in entries do
				if section[2](e) then
					table.insert(list, e)
				end
			end
			if #list > 0 then
				order += 1
				ViewUtil.heading(body, section[1], order)
				for _, e in list do
					order += 1
					local def = e.def
					local color = CATEGORY_COLORS[def.category] or C.Text
					local card = Kit.card(body, def.title, order, color)
					Kit.chip(card, def.category .. (if e.daily then " • resets daily" else ""), color, 1)
					ViewUtil.para(card, def.description or "", C.TextDim, 2, 13)
					if section[1] == "Locked" then
						ViewUtil.para(card, "Requires: " .. table.concat(def.requires or {}, ", "), C.TextMuted, 3, 12)
					elseif not e.claimed then
						for j, objective in def.objectives do
							local n = math.min(e.counts[j] or 0, objective.count)
							ViewUtil.para(card, string.format("%s %s  %d/%d", if n >= objective.count then "✔" else "•", objective.label, n, objective.count), if n >= objective.count then C.Good else C.Text, 3 + j, 13)
						end
						if def.hint then
							ViewUtil.para(card, "Tip: " .. def.hint, C.TextMuted, 10, 12)
						end
					end
					ViewUtil.para(card, "Rewards: " .. rewardText(def.rewards), C.Gold, 11, 12)
					if e.complete and not e.claimed and e.available then
						Kit.button({ parent = card, text = "Claim reward", color = C.Good, order = 12, onClick = function()
							ClientState.request("ClaimQuest", { id = def.id })
						end })
					end
				end
			end
		end
	end, { "profile" })
end

return View
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="111">
              <Properties>
                <string name="Name">SettingsView</string>
                <string name="Source"><![CDATA[--!strict
local Kit = require(script.Parent.Parent.Kit)
local Theme = require(script.Parent.Parent.Theme)
local ViewUtil = require(script.Parent.Parent.ViewUtil)
local ClientState = require(script.Parent.Parent.Parent.ClientState)

local C = Theme.Colors
local View = {}

local NUMBERS = {
	{ key = "cameraShake", label = "Camera shake", min = 0, max = 1, step = 0.25 },
	{ key = "effects", label = "Effects intensity", min = 0.2, max = 1, step = 0.2 },
	{ key = "music", label = "Music volume", min = 0, max = 1, step = 0.1 },
	{ key = "sfx", label = "Effects volume", min = 0, max = 1, step = 0.1 },
	{ key = "hudScale", label = "HUD scale", min = 0.7, max = 1.3, step = 0.1 },
}

local TOGGLES = {
	{ key = "reducedClutter", label = "Reduced visual clutter (hide other players' minor effects)" },
	{ key = "highContrastTelegraphs", label = "High-contrast attack telegraphs (bright yellow)" },
}

local function apply(key: string, value: any)
	local profile = ClientState.profile
	if profile then
		profile.settings[key] = value -- optimistic; the server validates and re-syncs
		ClientState.Changed:Fire("profile")
	end
	ClientState.request("UpdateSettings", { [key] = value }, true)
end

function View.mount(container: Instance, _ctx: any)
	return ViewUtil.simple(container, function(body, profile)
		local s = profile.settings
		local card = Kit.card(body, "Accessibility & audio", 1)
		for i, opt in NUMBERS do
			local row = Kit.row(card, i, 40)
			Kit.text({ parent = row, text = string.format("%s: %d%%", opt.label, math.floor(s[opt.key] * 100 + 0.5)), size = UDim2.fromOffset(260, 36), order = 1 })
			Kit.button({ parent = row, text = "−", size = UDim2.fromOffset(44, 34), color = C.PanelLight, order = 2, onClick = function()
				apply(opt.key, math.clamp(s[opt.key] - opt.step, opt.min, opt.max))
			end })
			Kit.button({ parent = row, text = "+", size = UDim2.fromOffset(44, 34), color = C.PanelLight, order = 3, onClick = function()
				apply(opt.key, math.clamp(s[opt.key] + opt.step, opt.min, opt.max))
			end })
		end
		for i, opt in TOGGLES do
			local row = Kit.row(card, 20 + i, 40)
			Kit.button({ parent = row, text = if s[opt.key] then "ON" else "OFF", size = UDim2.fromOffset(70, 34), color = if s[opt.key] then C.Good else C.PanelLight, order = 1, onClick = function()
				apply(opt.key, not s[opt.key])
			end })
			Kit.text({ parent = row, text = opt.label, size = UDim2.fromOffset(460, 36), order = 2 })
		end
		ViewUtil.para(body, "Telegraphs always combine colour with a shape, a growing fill and a warning glyph (! parryable, ⚠ not parryable, ◎ ring with safe centre, ☠ hazard), so they never rely on colour alone.", C.TextDim, 2, 13)
	end, { "profile" })
end

return View
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="112">
              <Properties>
                <string name="Name">StatsView</string>
                <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Format = require(Shared.Util.Format)
local Kit = require(script.Parent.Parent.Kit)
local Theme = require(script.Parent.Parent.Theme)
local ViewUtil = require(script.Parent.Parent.ViewUtil)
local ClientState = require(script.Parent.Parent.Parent.ClientState)

local C = Theme.Colors
local View = {}

local LABELS = {
	{ "kills", "Enemies defeated" },
	{ "bossKills", "Fracture Wardens defeated" },
	{ "perfectParries", "Perfect parries" },
	{ "dodges", "Telegraphs dodged" },
	{ "awakenings", "Awakenings" },
	{ "fusionsCast", "Fusions cast" },
	{ "coopCombos", "Co-op resonances" },
	{ "oreMined", "Ore mined" },
	{ "crafts", "Items crafted" },
	{ "extractions", "Extractions" },
	{ "lootLost", "Times loot was lost" },
	{ "deaths", "Deaths" },
}

function View.mount(container: Instance, _ctx: any)
	return ViewUtil.simple(container, function(body, profile)
		local card = Kit.card(body, "Lifetime statistics", 1)
		ViewUtil.para(card, string.format("Level %d  •  %s coins  •  play time %s", profile.level, Format.number(profile.coins), Format.time(profile.stats.playTime)), C.Text, 0, 15)
		for i, entry in LABELS do
			ViewUtil.para(card, entry[2] .. ": <b>" .. tostring(profile.stats[entry[1]] or 0) .. "</b>", C.TextDim, i, 14)
		end
		local meta = ClientState.meta
		local data = Kit.card(body, "Save status", 2)
		if meta and meta.state == "Loaded" then
			ViewUtil.para(data, "Progress is saved automatically (every 2 minutes, on leave and on server shutdown).", C.Good, 1)
		else
			ViewUtil.para(data, "Progress is NOT being saved: " .. tostring(meta and meta.reason or "loading"), C.Bad, 1)
		end
	end, { "profile" })
end

return View
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="113">
              <Properties>
                <string name="Name">StoreView</string>
                <string name="Source"><![CDATA[--!strict
-- Cosmetic/convenience store. Unconfigured products (id 0) show "Unavailable" and never prompt.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local MonetizationConfig = require(Shared.Config.MonetizationConfig)
local Kit = require(script.Parent.Parent.Kit)
local Theme = require(script.Parent.Parent.Theme)
local ViewUtil = require(script.Parent.Parent.ViewUtil)

local C = Theme.Colors
local View = {}

function View.mount(container: Instance, _ctx: any)
	return ViewUtil.simple(container, function(body, profile)
		ViewUtil.para(body, "Everything here is cosmetic or convenience. No power, no random rolls. Purchases are verified by the server.", C.TextDim, 0)
		local order = 1
		for _, key in MonetizationConfig.PassOrder do
			local pass = MonetizationConfig.GamePasses[key]
			order += 1
			local card = Kit.card(body, pass.displayName .. "  (Game Pass)", order, C.Gold)
			ViewUtil.para(card, pass.description, C.TextDim, 1)
			local owned = profile.passes[key] == true
			local b = Kit.button({ parent = card, text = if owned then "Owned" else "Buy", order = 2, onClick = function()
				MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, pass.id)
			end })
			if not MonetizationConfig.isConfigured(pass) then
				b.setEnabled(false, "Unavailable")
			elseif owned then
				b.setEnabled(false, "Owned")
			end
		end
		for _, key in MonetizationConfig.ProductOrder do
			local product = MonetizationConfig.Products[key]
			order += 1
			local card = Kit.card(body, product.displayName, order, C.Accent)
			ViewUtil.para(card, product.description, C.TextDim, 1)
			local owned = product.grant.cosmetic and profile.cosmetics.owned[product.grant.cosmetic]
			local b = Kit.button({ parent = card, text = "Buy", order = 2, onClick = function()
				MarketplaceService:PromptProductPurchase(Players.LocalPlayer, product.id)
			end })
			if not MonetizationConfig.isConfigured(product) then
				b.setEnabled(false, "Unavailable")
			elseif owned then
				b.setEnabled(false, "Owned")
			end
		end
	end, { "profile" })
end

return View
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="114">
              <Properties>
                <string name="Name">TrialView</string>
                <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local TrialConfig = require(Shared.Config.TrialConfig)
local Kit = require(script.Parent.Parent.Kit)
local Theme = require(script.Parent.Parent.Theme)
local ViewUtil = require(script.Parent.Parent.ViewUtil)
local ClientState = require(script.Parent.Parent.Parent.ClientState)

local C = Theme.Colors
local View = {}

function View.mount(container: Instance, ctx: any)
	return ViewUtil.simple(container, function(body, profile)
		local def = TrialConfig.Trials.KatanaTrial
		local card = Kit.card(body, def.displayName, 1, Color3.fromRGB(120, 230, 255))
		ViewUtil.para(card, def.description, C.TextDim, 1)
		ViewUtil.para(card, string.format("Time limit: %ds. Leaving the arena or falling fails the trial (retry any time, no cost).", def.timeLimit), C.Text, 2)
		for i, o in def.objectives do
			ViewUtil.para(card, "• " .. o.label .. (if o.count > 1 then " x" .. o.count else ""), C.Text, 2 + i)
		end
		ViewUtil.para(card, "Reward: " .. def.reward, C.Gold, 10)
		local mastery = profile.weapons[def.weapon].mastery
		local done = profile.trials[def.id] ~= nil
		Kit.requirements(card, { { text = "Katana mastery " .. def.masteryRequired .. " (now " .. mastery .. ")", met = mastery >= def.masteryRequired } }, 11)
		if done then
			ViewUtil.para(card, "✔ Completed. You may replay it for practice.", C.Good, 12)
		end
		if ClientState.trial then
			Kit.button({ parent = card, text = "Abandon trial", color = C.Bad, order = 20, onClick = function()
				ClientState.request("AbandonTrial", {})
			end })
		else
			local b = Kit.button({ parent = card, text = "Begin the Echo Duel", color = Color3.fromRGB(120, 230, 255), textColor = Color3.new(0, 0, 0), size = UDim2.fromOffset(240, 40), order = 20, onClick = function()
				local ok = ClientState.request("StartTrial", { id = def.id })
				if ok then
					ctx.close()
				end
			end })
			b.setEnabled(mastery >= def.masteryRequired, if mastery < def.masteryRequired then "Mastery too low" else nil)
		end
	end, { "profile", "trial" })
end

return View
]]></string>
              </Properties>
            </Item>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
