<Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">Dimensiones</string><ProtectedString name="Source"><![CDATA[--!native
--!optimize 2
--[[
	Blockverse para Roblox · El Nether y el End
	Traducción de generarNether() y generarEnd() de mundo.js del juego web,
	con sus estructuras: fortalezas del Nether, bastiones en ruinas
	(estructuras27.js), ciudades del End con barco (mundo.js y v26.js) y el
	desgaste de estructuras28.js. Con la misma semilla sale lo mismo.
	Trabaja con coordenadas «locales» de cada dimensión; MundoDatos coloca
	cada dimensión en su propia zona del mapa de Roblox.
]]
local Registro = require(script.Parent.Registro)
local Ruido = require(script.Parent.Ruido)
local Biomas = require(script.Parent.Datos.Biomas)
local Estructuras = require(script.Parent.Estructuras)

local hash2, hash3, mulberry32 = Ruido.hash2, Ruido.hash3, Ruido.mulberry32
local valueNoise3, fbm = Ruido.valueNoise3, Ruido.fbm
local redondear = Ruido.redondear
local floor, abs, sqrt, min, max = math.floor, math.abs, math.sqrt, math.min, math.max

local CO = Biomas.constantes
local CX, CZ, CY, OY = CO.CX, CO.CZ, CO.CY, CO.OY
local BR = Registro.B
local B = setmetatable({}, {
	__index = function(_, k)
		local v = BR[k]
		if v == nil then
			error("Dimensiones: falta el bloque " .. tostring(k))
		end
		return v
	end,
})
local esLiquido = Registro.esLiquido
local DIRF = Registro.DIRF
local LANA_COLOR, VIDRIO_COLOR = Estructuras.LANA_COLOR, Estructuras.VIDRIO_COLOR

local function idx(x, y, z)
	return x + z * CX + y * CX * CZ
end
local function rd(d, i)
	return buffer.readu16(d, i * 2)
end
local function wr(d, i, v)
	buffer.writeu16(d, i * 2, v)
end
local function hypot(a, b)
	return sqrt(a * a + b * b)
end

local D = {}
D.BN = { desierto = 0, carmesi = 1, distorsionado = 2, valle = 3, deltas = 4 }
D.NOMBRES_BIOMA_NETHER = { "Desiertos del Nether", "Bosque carmesí", "Bosque distorsionado", "Valle de almas", "Deltas de basalto" }
D.NIEBLA_NETHER = { 0x3a100a, 0x4a0808, 0x0e2a30, 0x1a2a36, 0x3a3440 }
local BN = D.BN

------------------------------------------------------------------
-- Rejilla de densidad (Float32Array en el juego web)
------------------------------------------------------------------
local GR = 4
local GNY = CY // GR + 1
local rejN = buffer.create(5 * 5 * GNY * 4)
local function rej(i)
	return buffer.readf32(rejN, i * 4)
end
local function muestraRejilla(x, y, z)
	local gx, gy, gz = x / GR, y / GR, z / GR
	local x0, y0, z0 = min(3, floor(gx)), min(GNY - 2, floor(gy)), min(3, floor(gz))
	local fx, fy, fz = gx - x0, gy - y0, gz - z0
	local b0 = (y0 * 5 + z0) * 5 + x0
	local b1 = b0 + 25
	local v000, v100, v001, v101 = rej(b0), rej(b0 + 1), rej(b0 + 5), rej(b0 + 6)
	local v010, v110, v011, v111 = rej(b1), rej(b1 + 1), rej(b1 + 5), rej(b1 + 6)
	local a0 = v000 + (v100 - v000) * fx
	local a1 = v001 + (v101 - v001) * fx
	local a = a0 + (a1 - a0) * fz
	local c0 = v010 + (v110 - v010) * fx
	local c1 = v011 + (v111 - v011) * fx
	local c = c0 + (c1 - c0) * fz
	return a + (c - a) * fy
end

------------------------------------------------------------------
-- Nether
------------------------------------------------------------------
function D.biomaNether(semilla, x, z)
	local s = semilla + 7100
	local v1, v2 = fbm(x * 0.009, z * 0.009, s, 3), fbm(x * 0.009, z * 0.009, s + 1, 3)
	if v1 > 0.57 then
		return BN.carmesi
	end
	if v1 < 0.43 then
		return BN.distorsionado
	end
	if v2 > 0.57 then
		return BN.valle
	end
	if v2 < 0.43 then
		return BN.deltas
	end
	return BN.desierto
end

function D.fortalezaNetherEn(semilla, rx, rz)
	local s = semilla + 8000
	if hash2(rx, rz, s) > 0.8 then
		return nil
	end
	return { x = rx * 176 + 40 + floor(hash2(rx, rz, s + 1) * 96), y = OY + 64, z = rz * 176 + 40 + floor(hash2(rx, rz, s + 2) * 96) }
end
function D.fortalezasCerca(semilla, x, z)
	local rx, rz = floor(x / 176), floor(z / 176)
	local res = {}
	for a = -1, 1 do
		for b = -1, 1 do
			local f = D.fortalezaNetherEn(semilla, rx + a, rz + b)
			if f then
				table.insert(res, f)
			end
		end
	end
	return res
end

local function bloqueFortalezaNether(x, y, z, f, semilla)
	local rx, ry, rz = x - f.x, y - f.y, z - f.z
	local L = 46
	local enX = abs(rz) <= 2 and abs(rx) <= L
	local enZ = abs(rx) <= 2 and abs(rz) <= L
	local plaza = abs(rx) <= 7 and abs(rz) <= 7
	if not (enX or enZ or plaza) then
		return -1
	end
	if ry == 0 then
		return (plaza and rx <= -4 and rx >= -6 and rz >= 4 and rz <= 6) and B.arenaAlmas or B.ladrilloNether
	end
	if ry < 0 then
		local pilar = (enX and abs(rz) <= 1 and rx % 8 == 0) or (enZ and abs(rx) <= 1 and rz % 8 == 0) or (plaza and abs(rx) == 7 and abs(rz) == 7)
		return (pilar and ry > -60) and B.ladrilloNether or -1
	end
	if ry > 5 then
		return -1
	end
	if plaza then
		local borde = abs(rx) == 7 or abs(rz) == 7
		local abertura = (abs(rx) <= 2 and abs(rz) == 7) or (abs(rz) <= 2 and abs(rx) == 7)
		if borde and not abertura then
			return ry <= 2 and B.ladrilloNether or 0
		end
		if ry == 1 and rx == 0 and rz == 0 then
			return B.generador
		end
		if ry == 1 and rx == 5 and rz == 5 then
			return B.cofre
		end
		if ry == 1 and rx <= -4 and rx >= -6 and rz >= 4 and rz <= 6 then
			return B.verruga0 + floor(hash3(x, y, z, semilla) * 4)
		end
		if ry == 5 then
			return B.ladrilloNether
		end
		return 0
	end
	local lado = enX and abs(rz) == 2 or (not enX and abs(rx) == 2)
	if lado then
		return ry == 1 and B.ladrilloNether or 0
	end
	local extremo = enX and abs(rx) == L or (not enX and abs(rz) == L)
	if extremo and ry == 1 and (rx == 0 or rz == 0) then
		return B.generador
	end
	return 0
end

-- Bastión en ruinas (estructuras27.js)
local BAST = 26
function D.bastionEn(semilla, rx, rz)
	local s = semilla + 27600
	if hash2(rx, rz, s) > 0.45 then
		return nil
	end
	return { x = rx * 240 + 60 + floor(hash2(rx, rz, s + 1) * 120), z = rz * 240 + 60 + floor(hash2(rx, rz, s + 2) * 120), y = OY + 36 }
end
function D.bastionesCerca(semilla, x, z)
	local rx, rz = floor(x / 240), floor(z / 240)
	local res = {}
	for a = -1, 1 do
		for b = -1, 1 do
			local m = D.bastionEn(semilla, rx + a, rz + b)
			if m then
				table.insert(res, m)
			end
		end
	end
	return res
end
local function bloqueBastion(lx, y, lz, Bs, cofres, semilla)
	local rel = y - Bs.y
	local h = hash3(Bs.x + lx, y, Bs.z + lz, semilla + 27601)
	if rel < -3 or rel > 16 then
		return -1
	end
	if rel < 0 then
		return B.piedraNegra
	end
	local perim = lx == 0 or lx == BAST - 1 or lz == 0 or lz == BAST - 1
	local dentroPatio = lx > 7 and lx < 18 and lz > 7 and lz < 18
	if rel == 0 then
		return (dentroPatio and lx > 10 and lx < 15 and lz > 10 and lz < 15) and (h < 0.5 and B.bloqueOro or B.piedraNegra) or B.piedraNegra
	end
	if perim then
		if h < 0.08 and rel > 6 then
			return 0
		end
		return rel % 5 == 0 and B.basalto or B.piedraNegra
	end
	if rel == 6 or rel == 11 then
		if dentroPatio then
			return 0
		end
		return h < 0.05 and 0 or B.piedraNegra
	end
	if (lx == 7 or lx == 18 or lz == 7 or lz == 18) and not ((lx == 12 or lx == 13 or lz == 12 or lz == 13) and (rel % 6) < 4) then
		return (rel > 11 and h < 0.3) and 0 or B.piedraNegra
	end
	if dentroPatio and rel == 1 and lx == 12 and lz == 12 then
		table.insert(cofres, { lx, y, lz })
		return B.cofre
	end
	if rel == 1 and not dentroPatio and h < 0.01 then
		table.insert(cofres, { lx, y, lz })
		return B.cofre
	end
	if rel == 1 and dentroPatio and h < 0.1 then
		return B.bloqueOro
	end
	if rel == 7 and not dentroPatio and h < 0.02 then
		return B.lava
	end
	return 0
end

local function estructurasNether(datos, cx, cz, semilla, cofres)
	local bx, bz = cx * CX, cz * CZ
	for _, f in D.fortalezasCerca(semilla, bx + 8, bz + 8) do
		if bx + CX < f.x - 50 or bx > f.x + 50 or bz + CZ < f.z - 50 or bz > f.z + 50 then
			continue
		end
		for z = 0, CZ - 1 do
			for x = 0, CX - 1 do
				for y = f.y - 60, f.y + 5 do
					local b = bloqueFortalezaNether(bx + x, y, bz + z, f, semilla)
					if b >= 0 then
						wr(datos, idx(x, y, z), b)
						if b == B.cofre then
							table.insert(cofres, { bx + x, y, bz + z, "fortalezaNether" })
						end
					end
				end
			end
		end
	end
	for _, Bs in D.bastionesCerca(semilla, bx + 8, bz + 8) do
		if bx + CX <= Bs.x or bx >= Bs.x + BAST or bz + CZ <= Bs.z or bz >= Bs.z + BAST then
			continue
		end
		local cf = {}
		for x = max(bx, Bs.x), min(bx + CX, Bs.x + BAST) - 1 do
			for z = max(bz, Bs.z), min(bz + CZ, Bs.z + BAST) - 1 do
				for y = Bs.y - 3, Bs.y + 16 do
					local b = bloqueBastion(x - Bs.x, y, z - Bs.z, Bs, cf, semilla)
					if b >= 0 then
						wr(datos, idx(x - bx, y, z - bz), b)
					end
				end
			end
		end
		for _, q in cf do
			table.insert(cofres, { Bs.x + q[1], q[2], Bs.z + q[3], "bastion" })
		end
	end
end

function D.generarNether(datos, cx, cz, semilla)
	local bx, bz = cx * CX, cz * CZ
	local s = semilla + 7000
	local cofres = {}
	for gx = 0, 4 do
		for gz = 0, 4 do
			for gy = 0, GNY - 1 do
				local x, z, y = bx + gx * GR, bz + gz * GR, gy * GR
				buffer.writef32(rejN, ((gy * 5 + gz) * 5 + gx) * 4, valueNoise3(x / 26, y / 16, z / 26, s) * 0.7 + valueNoise3(x / 9, y / 9, z / 9, s + 1) * 0.3)
			end
		end
	end
	local biomaN = buffer.create(256)
	local Bl = {
		lecho = B.lecho, netherrack = B.netherrack, basalto = B.basalto, piedraNegra = B.piedraNegra, arenaAlmas = B.arenaAlmas,
		sueloAlmas = B.sueloAlmas, menaCuarzo = B.menaCuarzo, menaOroNether = B.menaOroNether, bloqueMagma = B.bloqueMagma, lava = B.lava,
	}
	for z = 0, CZ - 1 do
		for x = 0, CX - 1 do
			local wx, wz = bx + x, bz + z
			local bio = D.biomaNether(semilla, wx, wz)
			buffer.writeu8(biomaN, z * CX + x, bio)
			local almas = fbm(wx * 0.04, wz * 0.04, s + 5, 2) > 0.6
			for y = OY, CY - 1 do
				local id = 0
				if y <= OY + 4 and (y == OY or hash3(wx, y, wz, s + 2) < (OY + 5 - y) / 5) then
					id = Bl.lecho
				elseif y >= CY - 5 and (y == CY - 1 or hash3(wx, y, wz, s + 3) < (y - (CY - 6)) / 5) then
					id = Bl.lecho
				else
					local t = (y - OY) / 127
					local d = muestraRejilla(x, y, z) + max(0, 0.24 - t) * 3 + max(0, t - 0.8) * 3
					if d > 0.6 then
						id = Bl.netherrack
						local r = hash3(wx, y, wz, s + 4)
						if bio == BN.deltas then
							id = r < 0.45 and Bl.basalto or r < 0.9 and Bl.piedraNegra or Bl.netherrack
						elseif bio == BN.valle and y < OY + 60 then
							id = r < 0.5 and Bl.arenaAlmas or Bl.sueloAlmas
						elseif almas and y < OY + 45 and bio == BN.desierto then
							id = Bl.arenaAlmas
						end
						if id == Bl.netherrack or id == Bl.piedraNegra then
							if hash3(wx // 2, y // 2, wz // 2, s + 6) < 0.03 and r < 0.6 then
								id = Bl.menaCuarzo
							elseif hash3(wx // 2, y // 2, wz // 2, s + 7) < 0.012 and r < 0.5 then
								id = Bl.menaOroNether
							end
						end
					elseif y <= OY + 31 then
						id = (bio == BN.deltas and hash3(wx, y, wz, s + 9) < 0.3 and y == OY + 31) and Bl.bloqueMagma or Bl.lava
					end
				end
				if id ~= 0 then
					wr(datos, idx(x, y, z), id)
				end
			end
		end
	end
	-- Restos ancestrales
	local rdm = mulberry32(floor(hash2(cx, cz, s + 60) * 4294967296))
	for _ = 0, 1 do
		local x, z = floor(rdm() * 16), floor(rdm() * 16)
		local y = OY + 8 + redondear((rdm() + rdm()) / 2 * 14)
		local n = rdm() < 0.35 and 2 or 1
		for q = 0, n - 1 do
			local X = min(15, x + q)
			local i = idx(X, y, z)
			local b = rd(datos, i)
			if b == B.netherrack or b == B.basalto or b == B.piedraNegra then
				wr(datos, i, B.restosAncestrales)
			end
		end
	end
	-- Superficies y vegetación
	local r = mulberry32(floor(hash2(cx, cz, s + 50) * 4294967296))
	local function hongoGigante(x, y, z, dist)
		local alto = 4 + floor(r() * 5)
		local tallo = dist and B.talloDistorsionado or B.talloCarmesi
		local verr = dist and B.verrugaDistBloque or B.verrugaBloque
		local function set(X, Y, Z, id, solo)
			if X < 0 or Z < 0 or X >= CX or Z >= CZ or Y >= CY - 5 then
				return
			end
			local i = idx(X, Y, Z)
			if solo and rd(datos, i) ~= 0 then
				return
			end
			wr(datos, i, id)
		end
		for k = 1, alto do
			set(x, y + k, z, tallo, false)
		end
		local rad = 2 + floor(r() * 2)
		for dy = -2, 1 do
			for dx = -rad, rad do
				for dz = -rad, rad do
					local borde = abs(dx) == rad or abs(dz) == rad
					if dy == 1 and (abs(dx) > rad - 1 or abs(dz) > rad - 1) then
						continue
					end
					if dy < 1 and not borde then
						continue
					end
					if dy < 0 and r() < 0.4 then
						continue
					end
					set(x + dx, y + alto + dy, z + dz, r() < 0.08 and B.luzHongo or verr, true)
				end
			end
		end
	end
	for z = 0, CZ - 1 do
		for x = 0, CX - 1 do
			local bio = buffer.readu8(biomaN, z * CX + x)
			for y = OY + 6, CY - 9 do
				local i = idx(x, y, z)
				local abajo = rd(datos, idx(x, y - 1, z))
				if rd(datos, i) ~= 0 or abajo == 0 or esLiquido(abajo) or abajo == B.lecho then
					continue
				end
				if bio == BN.carmesi and abajo == B.netherrack then
					wr(datos, idx(x, y - 1, z), B.nilioCarmesi)
				end
				if bio == BN.distorsionado and abajo == B.netherrack then
					wr(datos, idx(x, y - 1, z), B.nilioDistorsionado)
				end
				local rr = r()
				if bio == BN.carmesi or bio == BN.distorsionado then
					local dist = bio == BN.distorsionado
					local libre = x > 2 and x < 13 and z > 2 and z < 13 and rr < 0.065
					local k = 0
					while libre and k < 11 do
						if y + k >= CY - 6 or rd(datos, idx(x, y + k, z)) ~= 0 then
							libre = false
						end
						k += 1
					end
					if libre then
						hongoGigante(x, y - 1, z, dist)
					elseif rr < 0.15 then
						wr(datos, i, dist and B.raicesDist or B.raicesCarmesi)
					elseif rr < 0.2 then
						wr(datos, i, dist and B.hongoDist or B.hongoCarmesi)
					end
				elseif bio == BN.deltas then
					if rr < 0.03 then
						local h = 2 + floor(r() * 5)
						local k = 0
						while k < h and rd(datos, idx(x, y + k, z)) == 0 do
							wr(datos, idx(x, y + k, z), B.basalto)
							k += 1
						end
					elseif rr < 0.12 and abajo ~= B.lava then
						wr(datos, idx(x, y - 1, z), B.bloqueMagma)
					end
				elseif bio == BN.valle then
					if rr < 0.006 then
						local h = 3 + floor(r() * 4)
						local k = 0
						while k < h and rd(datos, idx(x, y + k, z)) == 0 do
							wr(datos, idx(x, y + k, z), B.bloqueHueso)
							k += 1
						end
					elseif rr < 0.02 and (abajo == B.arenaAlmas or abajo == B.sueloAlmas) then
						wr(datos, i, B.fuegoAlmas)
					end
				elseif rr < 0.004 and abajo == B.netherrack then
					wr(datos, i, B.fuego)
				end
			end
		end
	end
	-- Piedra luminosa colgando del techo
	for z = 0, CZ - 1 do
		for x = 0, CX - 1 do
			for y = OY + 80, CY - 7 do
				local i = idx(x, y, z)
				if rd(datos, i) == 0 and rd(datos, idx(x, y + 1, z)) == B.netherrack and hash3(bx + x, y, bz + z, s + 8) < 0.006 then
					local n = 2 + floor(hash3(bx + x, y, bz + z, s + 9) * 5)
					for k = 0, n - 1 do
						local dx = k ~= 0 and floor(hash3(k, x, y, s) * 3) - 1 or 0
						local dz = k ~= 0 and floor(hash3(k, z, y, s + 1) * 3) - 1 or 0
						local dy = -floor(k / 2)
						local X, Z, Y = x + dx, z + dz, y + dy
						if X < 0 or Z < 0 or X >= CX or Z >= CZ then
							continue
						end
						if rd(datos, idx(X, Y, Z)) == 0 then
							wr(datos, idx(X, Y, Z), B.piedraLuminosa)
						end
					end
				end
			end
		end
	end
	-- Cascadas de lava
	for k = 0, 1 do
		if hash2(cx * 7 + k, cz, s + 80) > 0.28 then
			continue
		end
		local x = 1 + floor(hash2(cx, cz * 5 + k, s + 81) * 14)
		local z = 1 + floor(hash2(cx + k, cz, s + 82) * 14)
		for y = CY - 7, OY + 41, -1 do
			local i = idx(x, y, z)
			if rd(datos, i) ~= 0 or rd(datos, idx(x, y + 1, z)) ~= B.netherrack then
				continue
			end
			local fondo = y
			while fondo > OY + 6 and rd(datos, idx(x, fondo - 1, z)) == 0 do
				fondo -= 1
			end
			if y - fondo < 6 then
				break
			end
			wr(datos, idx(x, y + 1, z), B.lava)
			for yy = y, fondo, -1 do
				wr(datos, idx(x, yy, z), B.lava + 1)
			end
			break
		end
	end
	estructurasNether(datos, cx, cz, semilla, cofres)
	-- Ghasts secos en el valle de almas
	if hash2(cx, cz, s + 70) < 0.12 then
		local x = 2 + floor(hash2(cx, cz, s + 71) * 12)
		local z = 2 + floor(hash2(cx, cz, s + 72) * 12)
		if buffer.readu8(biomaN, z * CX + x) == BN.valle then
			for y = OY + 34, OY + 89 do
				local a, b = rd(datos, idx(x, y, z)), rd(datos, idx(x, y + 1, z))
				if (a == B.arenaAlmas or a == B.sueloAlmas) and b == 0 then
					wr(datos, idx(x, y + 1, z), B.ghastSeco)
					break
				end
			end
		end
	end
	Estructuras.desgastar(datos, cx, cz, semilla, false)
	return biomaN, cofres
end

------------------------------------------------------------------
-- End
------------------------------------------------------------------
local END_TOP = OY + 60
local EPY = END_TOP + 3
D.END_TOP, D.EPY = END_TOP, EPY
local PILARES = {}
for i = 0, 9 do
	local a = math.pi * 2 * i / 10 + 0.3
	PILARES[i + 1] = { x = redondear(math.cos(a) * 42), z = redondear(math.sin(a) * 42), r = 2 + (i * 7) % 4, alto = OY + 76 + 3 * ((i * 3) % 10) }
end
D.PILARES = PILARES

function D.salidaAcceso(semilla)
	local a = (semilla % 628) / 100
	return redondear(math.cos(a) * 1000), redondear(math.sin(a) * 1000)
end

local function columnaEnd(wx, wz, semilla)
	local s = semilla + 9100
	local m = fbm(wx * 0.011, wz * 0.011, s, 3) * 1.25 - 0.62 + fbm(wx * 0.04, wz * 0.04, s + 3, 2) * 0.12
	local px, pz = D.salidaAcceso(semilla)
	local dp = hypot(wx - px, wz - pz)
	if dp < 24 then
		m = max(m, 0.28 * (1 - dp / 24) + 0.05)
	end
	if m <= 0 then
		return nil
	end
	local top = END_TOP - 4 + redondear(m * 14 + fbm(wx * 0.06, wz * 0.06, s + 5, 2) * 2)
	return { top = top, bot = top - redondear(3 + m * 55), m = m }
end
D.columnaEnd = columnaEnd

local function generarIslaExterior(datos, x, z, wx, wz, semilla)
	local c = columnaEnd(wx, wz, semilla)
	if not c then
		return
	end
	for y = max(1, c.bot), c.top do
		wr(datos, idx(x, y, z), B.piedraEnd)
	end
	if c.m > 0.08 and hash2(wx, wz, semilla + 77) < 0.004 then
		local r = mulberry32(floor(hash2(wx, wz, semilla + 78) * 1e9))
		local alto = 3 + floor(r() * 5)
		for y = 1, alto do
			wr(datos, idx(x, c.top + y, z), B.plantaCoro)
		end
		wr(datos, idx(x, c.top + alto + 1, z), B.florCoro)
		for _ = 0, 2 do
			if r() < 0.5 then
				continue
			end
			local d = DIRF[floor(r() * 4) + 1]
			local nx, nz = x + d[1], z + d[2]
			if nx < 0 or nx >= CX or nz < 0 or nz >= CZ then
				continue
			end
			local y0 = c.top + 2 + floor(r() * (alto - 1))
			local l = 1 + floor(r() * 3)
			for y = y0, y0 + l - 1 do
				wr(datos, idx(nx, y, nz), B.plantaCoro)
			end
			wr(datos, idx(nx, y0 + l, nz), B.florCoro)
		end
	end
end

function D.ciudadesCerca(semilla, cx, cz)
	local res = {}
	local R = 96
	local x0, x1 = floor((cx * CX - 60) / R), floor((cx * CX + CX + 60) / R)
	local z0, z1 = floor((cz * CZ - 60) / R), floor((cz * CZ + CZ + 60) / R)
	for rx = x0, x1 do
		for rz = z0, z1 do
			local h = hash2(rx, rz, semilla + 555)
			if h > 0.55 then
				continue
			end
			local x = rx * R + 16 + floor(hash2(rx, rz, semilla + 556) * 64)
			local z = rz * R + 16 + floor(hash2(rx, rz, semilla + 557) * 64)
			if hypot(x, z) < 750 then
				continue
			end
			local c = columnaEnd(x, z, semilla)
			if not c or c.m < 0.1 then
				continue
			end
			table.insert(res, { x = x, z = z, y = c.top + 1, alto = 14 + floor(hash2(rx, rz, semilla + 558) * 14) })
		end
	end
	return res
end
function D.datosCiudadEnd(c, semilla)
	local t = c.y + 4 + c.alto
	local barco = hash2(c.x, c.z, semilla + 559) < 0.65
	return { t = t, barco = barco, bx = c.x - 26, by = t + 8, bz = c.z }
end

local function construirCiudadEnd(datos, cx, cz, semilla, cofres)
	local bx, bz = cx * CX, cz * CZ
	for _, c in D.ciudadesCerca(semilla, cx, cz) do
		local function pon(x, y, z, b)
			local lx, lz = x - bx, z - bz
			if lx < 0 or lx >= CX or lz < 0 or lz >= CZ or y < 1 or y >= CY then
				return
			end
			wr(datos, idx(lx, y, lz), b)
			if b == B.cofre then
				table.insert(cofres, { x, y, z, "ciudadEnd" })
			end
		end
		local function caja(x0, y0, z0, x1, y1, z1, borde, dentro)
			for x = x0, x1 do
				for y = y0, y1 do
					for z = z0, z1 do
						local b = x == x0 or x == x1 or z == z0 or z == z1 or y == y0 or y == y1
						pon(x, y, z, b and borde or dentro)
					end
				end
			end
		end
		local VM = VIDRIO_COLOR(10)
		local Dt = D.datosCiudadEnd(c, semilla)
		local t = Dt.t
		local function esquinas(x0, z0, x1, z1, y0, y1, b)
			for y = y0, y1 do
				for _, q in { { x0, z0 }, { x1, z0 }, { x0, z1 }, { x1, z1 } } do
					pon(q[1], y, q[2], b)
				end
			end
		end
		local function varas(x0, z0, x1, z1, y)
			for _, q in { { x0, z0, -1, -1 }, { x1, z0, 1, -1 }, { x0, z1, -1, 1 }, { x1, z1, 1, 1 } } do
				pon(q[1] + q[3], y, q[2], B.varaEnd)
				pon(q[1], y, q[2] + q[4], B.varaEnd)
			end
		end
		for x = c.x - 7, c.x + 7 do
			for z = c.z - 7, c.z + 7 do
				local d = max(abs(x - c.x), abs(z - c.z))
				for y = c.y - 6, c.y - 1 do
					if d <= 7 - max(0, c.y - 1 - y) then
						pon(x, y, z, B.ladrillosEnd)
					end
				end
			end
		end
		caja(c.x - 5, c.y, c.z - 5, c.x + 5, c.y + 4, c.z + 5, B.purpur, 0)
		esquinas(c.x - 5, c.z - 5, c.x + 5, c.z + 5, c.y, c.y + 4, B.pilarPurpur)
		for x = c.x - 4, c.x + 4 do
			for z = c.z - 4, c.z + 4 do
				pon(x, c.y, z, bit32.band(x + z, 1) ~= 0 and B.ladrillosEnd or B.purpur)
			end
		end
		for _, dx in { -2, 2 } do
			for _, dz in { -5, 5 } do
				pon(c.x + dx, c.y + 2, c.z + dz, VM)
				pon(c.x + dx, c.y + 3, c.z + dz, VM)
			end
		end
		for y = c.y + 1, c.y + 3 do
			pon(c.x, y, c.z - 5, 0)
			pon(c.x - 1, y, c.z - 5, 0)
		end
		varas(c.x - 5, c.z - 5, c.x + 5, c.z + 5, c.y + 4)
		local r, y0 = 3, c.y + 4
		caja(c.x - r, y0, c.z - r, c.x + r, t, c.z + r, B.purpur, 0)
		esquinas(c.x - r, c.z - r, c.x + r, c.z + r, y0, t, B.pilarPurpur)
		for y = y0, t - 1 do
			pon(c.x + r - 1, y, c.z, 146)
		end
		local y = y0 + 5
		while y < t do
			for x = c.x - r + 1, c.x + r - 1 do
				for z = c.z - r + 1, c.z + r - 1 do
					if x ~= c.x + r - 1 or z ~= c.z then
						pon(x, y, z, B.purpur)
					end
				end
			end
			for _, q in { { c.x - r, c.z }, { c.x, c.z + r }, { c.x, c.z - r } } do
				pon(q[1], y + 2, q[2], VM)
				pon(q[1], y + 3, q[2], VM)
			end
			varas(c.x - r, c.z - r, c.x + r, c.z + r, y)
			y += 5
		end
		local ym = y0 + 5 * max(1, floor(c.alto / 10))
		for x = c.x + r, c.x + r + 9 do
			for z = c.z - 1, c.z + 1 do
				pon(x, ym, z, B.purpur)
				if abs(z - c.z) == 1 then
					pon(x, ym + 1, z, B.ladrillosEnd)
				end
			end
		end
		for yy = ym + 1, ym + 2 do
			pon(c.x + r, yy, c.z, 0)
		end
		local sx = c.x + r + 12
		caja(sx - 2, ym - 6, c.z - 2, sx + 2, ym + 6, c.z + 2, B.purpur, 0)
		esquinas(sx - 2, c.z - 2, sx + 2, c.z + 2, ym - 6, ym + 6, B.pilarPurpur)
		for yy = ym + 1, ym + 2 do
			pon(sx - 2, yy, c.z, 0)
		end
		for x = sx - 1, sx + 1 do
			for z = c.z - 1, c.z + 1 do
				pon(x, ym, z, B.purpur)
			end
		end
		pon(sx, ym + 1, c.z + 1, B.cofre)
		pon(sx + 1, ym + 1, c.z - 1, B.varaEnd)
		for yy = ym + 7, ym + 9 do
			pon(sx, yy, c.z, yy == ym + 9 and B.varaEnd or B.pilarPurpur)
		end
		varas(sx - 2, c.z - 2, sx + 2, c.z + 2, ym + 6)
		caja(c.x - 5, t, c.z - 5, c.x + 5, t + 6, c.z + 5, B.purpur, 0)
		for x = c.x - 4, c.x + 4 do
			for z = c.z - 4, c.z + 4 do
				pon(x, t, z, (abs(x - c.x) + abs(z - c.z)) % 3 == 0 and B.purpur or B.ladrillosEnd)
			end
		end
		pon(c.x + r - 1, t, c.z, 0)
		for k = -3, 3 do
			for _, q in { { c.x + k, c.z - 5 }, { c.x + k, c.z + 5 }, { c.x - 5, c.z + k }, { c.x + 5, c.z + k } } do
				pon(q[1], t + 3, q[2], VM)
				if abs(k) <= 1 then
					pon(q[1], t + 4, q[2], VM)
				end
			end
		end
		esquinas(c.x - 5, c.z - 5, c.x + 5, c.z + 5, t, t + 6, B.pilarPurpur)
		for L = 0, 5 do
			for x = c.x - 5 + L, c.x + 5 - L do
				for z = c.z - 5 + L, c.z + 5 - L do
					if x == c.x - 5 + L or x == c.x + 5 - L or z == c.z - 5 + L or z == c.z + 5 - L then
						pon(x, t + 7 + L, z, B.purpur)
					end
				end
			end
		end
		for yy = t + 13, t + 15 do
			pon(c.x, yy, c.z, B.varaEnd)
		end
		for _, q in { { -4, -4 }, { 4, -4 }, { -4, 4 }, { 4, 4 } } do
			pon(c.x + q[1], t + 1, c.z + q[2], B.varaEnd)
		end
		pon(c.x - 2, t + 1, c.z + 4, B.cofre)
		pon(c.x + 2, t + 1, c.z + 4, B.cofre)
		if not Dt.barco then
			pon(c.x, t + 1, c.z, B.obsidiana)
			pon(c.x, t + 2, c.z, B.cofre)
			-- Este cofre guarda los élitros
			if c.x - bx >= 0 and c.x - bx < CX and c.z - bz >= 0 and c.z - bz < CZ then
				cofres[#cofres][4] = "elitros"
			end
		end
		if Dt.barco then
			local X0, Y, Z = Dt.bx - 10, Dt.by, Dt.bz
			for u = 0, 21 do
				local w = u < 3 and 1 or u > 17 and max(0, 21 - u) or 3
				local x = X0 + u
				for v = -w, w do
					pon(x, Y, Z + v, B.purpur)
					if abs(v) == w then
						pon(x, Y + 1, Z + v, B.purpur)
						if u % 3 == 0 then
							pon(x, Y + 2, Z + v, B.varaEnd)
						end
					else
						pon(x, Y + 1, Z + v, 0)
					end
					if abs(v) < w and u > 2 and u < 18 then
						pon(x, Y - 1, Z + v, B.purpur)
						if abs(v) < w - 1 then
							pon(x, Y - 2, Z + v, B.obsidiana)
						end
					end
				end
			end
			for x = X0 + 6, X0 + 14 do
				for z = Z - 2, Z + 2 do
					for yy = Y - 3, Y - 1 do
						local borde = x == X0 + 6 or x == X0 + 14 or abs(z - Z) == 2 or yy == Y - 3
						pon(x, yy, z, borde and B.ladrillosEnd or 0)
					end
				end
			end
			pon(X0 + 10, Y, Z, 0)
			for yy = Y - 2, Y do
				pon(X0 + 10, yy, Z + 1, 146)
			end
			pon(X0 + 8, Y - 2, Z - 1, B.cofre)
			pon(X0 + 12, Y - 2, Z - 1, B.cofre)
			pon(X0 + 7, Y - 2, Z + 1, B.varaEnd)
			pon(X0 + 13, Y - 2, Z + 1, B.varaEnd)
			for yy = Y + 1, Y + 12 do
				pon(X0 + 10, yy, Z, B.pilarPurpur)
			end
			for yy = Y + 5, Y + 10 do
				for v = -3, 3 do
					if v ~= 0 then
						pon(X0 + 10, yy, Z + v, LANA_COLOR(15))
					end
				end
			end
			for yy = Y + 1, Y + 4 do
				pon(X0 + 17, yy, Z, B.pilarPurpur)
			end
			for yy = Y + 2, Y + 4 do
				for v = -2, 2 do
					if v ~= 0 then
						pon(X0 + 17, yy, Z + v, LANA_COLOR(15))
					end
				end
			end
			pon(X0 + 21, Y + 1, Z, B.cabezaDragon)
		end
		-- Segunda rama con sala colgante y estandartes (v26.js)
		local MAG = LANA_COLOR(2)
		local ym2 = min(t - 4, y0 + 5 * max(2, floor(c.alto / 7)))
		for z = c.z - r - 10, c.z - r do
			for x = c.x - 1, c.x + 1 do
				pon(x, ym2, z, B.purpur)
				if abs(x - c.x) == 1 then
					pon(x, ym2 + 1, z, B.ladrillosEnd)
				end
			end
		end
		for yy = ym2 + 1, ym2 + 2 do
			pon(c.x, yy, c.z - r, 0)
		end
		local sz = c.z - r - 14
		for x = c.x - 3, c.x + 3 do
			for z = sz - 3, sz + 3 do
				for yy = ym2, ym2 + 5 do
					local borde = abs(x - c.x) == 3 or abs(z - sz) == 3
					local techo, suelo = yy == ym2 + 5, yy == ym2
					local b
					if suelo then
						b = bit32.band(x + z, 1) ~= 0 and B.ladrillosEnd or B.purpur
					elseif techo or borde then
						b = (abs(x - c.x) == 3 and abs(z - sz) == 3) and B.pilarPurpur or B.purpur
					else
						b = 0
					end
					pon(x, yy, z, b)
				end
			end
		end
		for k = -1, 1 do
			pon(c.x + k, ym2 + 2, sz - 3, VM)
			pon(c.x + k, ym2 + 3, sz - 3, VM)
			pon(c.x - 3, ym2 + 2, sz + k, VM)
			pon(c.x + 3, ym2 + 2, sz + k, VM)
		end
		for yy = ym2 + 1, ym2 + 2 do
			pon(c.x, yy, sz + 3, 0)
		end
		pon(c.x + 2, ym2 + 1, sz - 2, B.cofre)
		pon(c.x - 2, ym2 + 1, sz - 2, B.varaEnd)
		local negra = BR.lanaNegra or MAG
		for _, q in { { c.x - 3, sz - 4 }, { c.x + 3, sz - 4 }, { c.x - 4, sz }, { c.x + 4, sz } } do
			for yy = ym2 + 1, ym2 + 3 do
				pon(q[1], yy, q[2], yy == ym2 + 1 and negra or MAG)
			end
		end
		for _, q in { { c.x - 6, c.z }, { c.x + 6, c.z }, { c.x, c.z + 6 } } do
			for yy = t + 2, t + 4 do
				pon(q[1], yy, q[2], yy == t + 2 and LANA_COLOR(15) or MAG)
			end
		end
		for yy = ym2 - 3, ym2 - 1 do
			pon(c.x, yy, sz, B.varaEnd)
		end
	end
end

function D.generarEnd(datos, cx, cz, semilla)
	local bx, bz = cx * CX, cz * CZ
	local s = semilla + 9000
	local cofres = {}
	for z = 0, CZ - 1 do
		for x = 0, CX - 1 do
			local wx, wz = bx + x, bz + z
			local d = hypot(wx, wz)
			local R = 76 + fbm(wx * 0.02, wz * 0.02, s, 2) * 26
			if d < R then
				local f = 1 - d / R
				local top = END_TOP + redondear(f * 3 + fbm(wx * 0.08, wz * 0.08, s + 1, 2) * 2)
				local bot = top - redondear(4 + f * 46 * (0.6 + 0.4 * fbm(wx * 0.05, wz * 0.05, s + 2, 2)))
				for y = bot, top do
					wr(datos, idx(x, y, z), B.piedraEnd)
				end
			end
			for _, p in PILARES do
				local dd = (wx - p.x) ^ 2 + (wz - p.z) ^ 2
				if dd <= p.r * p.r + p.r * 0.5 then
					for y = END_TOP - 20, p.alto do
						wr(datos, idx(x, y, z), B.obsidiana)
					end
				end
				if wx == p.x and wz == p.z then
					wr(datos, idx(x, p.alto + 1, z), B.lecho)
				end
			end
			local r = hypot(wx, wz)
			if r < 3.5 then
				wr(datos, idx(x, EPY, z), B.lecho)
				for y = EPY + 1, EPY + 8 do
					wr(datos, idx(x, y, z), 0)
				end
				if r >= 2.5 then
					wr(datos, idx(x, EPY + 1, z), B.lecho)
				end
				if wx == 0 and wz == 0 then
					for y = EPY + 1, EPY + 4 do
						wr(datos, idx(x, y, z), B.lecho)
					end
				end
			end
			if d > 600 then
				generarIslaExterior(datos, x, z, wx, wz, semilla)
			end
			if abs(wx - 100) <= 2 and abs(wz) <= 2 then
				wr(datos, idx(x, OY + 48, z), B.obsidiana)
				for y = OY + 49, OY + 51 do
					wr(datos, idx(x, y, z), 0)
				end
			end
		end
	end
	if hypot(bx + 8, bz + 8) > 620 then
		construirCiudadEnd(datos, cx, cz, semilla, cofres)
	end
	return cofres
end

return D
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">Encantamientos</string><ProtectedString name="Source"><![CDATA[--[[
	Blockverse para Roblox · Encantamientos
	Traducción de encantamientos.js del juego web (como en Java 1.21):
	peso y rango de poder de cada nivel, encantabilidad de cada objeto,
	incompatibilidades, la mesa de encantamientos (tres opciones según
	las librerías) y los libros encantados de los cofres.
]]
local Ruido = require(script.Parent.Ruido)
local Datos = require(script.Parent.Datos.Encantos)

local floor, max = math.floor, math.max
local redondear = Ruido.redondear

local Enc = {}
Enc.LISTA = Datos.lista
Enc.POR_CLAVE = {}
for _, d in Datos.lista do
	Enc.POR_CLAVE[d.k] = d
end
Enc.ROMANOS = { [0] = "", "I", "II", "III", "IV", "V" }
local PODER, SOLO_YUNQUE = Datos.poder, Datos.soloYunque
local CATS, ENCAB = Datos.categorias, Datos.encantabilidad
local LIBRO, LIBRO_ENC = 248, Datos.libroEncantado

local function tiene(lista, v)
	if not lista then
		return false
	end
	for _, x in lista do
		if x == v then
			return true
		end
	end
	return false
end
local function algunaEn(a, b)
	for _, x in a do
		if tiene(b, x) then
			return true
		end
	end
	return false
end

function Enc.categorias(id)
	return CATS[id] or {}
end
function Enc.encantabilidad(id)
	return ENCAB[id] or 0
end
function Enc.peso(k)
	return (PODER[k] or { 1 })[1]
end
function Enc.costeMin(k, l)
	local p = PODER[k] or { 1, 1, 10, 50, 10 }
	return p[2] + p[3] * (l - 1)
end
function Enc.costeMax(k, l)
	local p = PODER[k] or { 1, 1, 10, 50, 10 }
	return p[4] + p[5] * (l - 1)
end
function Enc.multRareza(k)
	return ({ [10] = 1, [5] = 2, [2] = 4, [1] = 8 })[Enc.peso(k)] or 8
end
function Enc.conflicto(a, b)
	return tiene(Enc.POR_CLAVE[a].excluye, b) or tiene(Enc.POR_CLAVE[b].excluye, a)
end
function Enc.nombre(k, l)
	local d = Enc.POR_CLAVE[k]
	if not d then
		return k
	end
	return d.max > 1 and (d.nombre .. " " .. (Enc.ROMANOS[l] or tostring(l))) or d.nombre
end

function Enc.admiteEnMesa(k, id, esArmaduraPecho)
	local d = Enc.POR_CLAVE[k]
	if not d or d.tesoro or d.maldicion then
		return false
	end
	local cats = Enc.categorias(id)
	if tiene(cats, "libro") then
		return true
	end
	if not algunaEn(d.para, cats) then
		return false
	end
	if SOLO_YUNQUE[k] and algunaEn(SOLO_YUNQUE[k], cats) then
		return false
	end
	if k == "espinas" and not esArmaduraPecho then
		return false
	end
	return true
end

-- ¿Se puede poner este encantamiento en este objeto (yunque)?
function Enc.admite(k, id)
	local d = Enc.POR_CLAVE[k]
	if not d then
		return false
	end
	local cats = Enc.categorias(id)
	return tiene(cats, "libro") or algunaEn(d.para, cats)
end

local function elegirPorPeso(lista, r)
	local t = 0
	for _, o in lista do
		t += Enc.peso(o.k)
	end
	local x = floor(r() * t)
	for _, o in lista do
		x -= Enc.peso(o.k)
		if x < 0 then
			return o
		end
	end
	return lista[#lista]
end

-- ¿Es una pechera? (la mesa solo pone Espinas en las pecheras)
local Registro = require(script.Parent.Registro)
local function piezaPecho(id)
	local o = Registro.objetos[id]
	return o ~= nil and o.armadura ~= nil and o.armadura.pieza == 1
end

function Enc.disponibles(id, poder, tesoro)
	local res = {}
	local cats = Enc.categorias(id)
	for _, d in Enc.LISTA do
		local k = d.k
		if tesoro then
			if d.maldicion or k == "velocidadAlmas" or k == "sigilo" or k == "rafaga" then
				continue
			end
			if not tiene(cats, "libro") and not algunaEn(d.para, cats) then
				continue
			end
		elseif not Enc.admiteEnMesa(k, id, piezaPecho(id)) then
			continue
		end
		for l = d.max, 1, -1 do
			if poder >= Enc.costeMin(k, l) and poder <= Enc.costeMax(k, l) then
				table.insert(res, { k = k, l = l })
				break
			end
		end
	end
	return res
end

-- Algoritmo del original: poder modificado por la encantabilidad y un ±15 % al azar
function Enc.elegir(id, nivel, r, tesoro)
	local e = max(1, Enc.encantabilidad(id))
	local poder = nivel + 1 + floor(r() * (floor(e / 4) + 1)) + floor(r() * (floor(e / 4) + 1))
	local f = (r() + r() - 1) * 0.15
	poder = max(1, redondear(poder + poder * f))
	local lista = Enc.disponibles(id, poder, tesoro)
	local res = {}
	if #lista == 0 then
		return res
	end
	table.insert(res, elegirPorPeso(lista, r))
	while floor(r() * 50) <= poder do
		local nueva = {}
		for _, o in lista do
			local ok = true
			for _, x in res do
				if x.k == o.k or Enc.conflicto(x.k, o.k) then
					ok = false
					break
				end
			end
			if ok then
				table.insert(nueva, o)
			end
		end
		lista = nueva
		if #lista == 0 then
			break
		end
		table.insert(res, elegirPorPeso(lista, r))
		poder = floor(poder / 2)
	end
	return res
end

function Enc.aObjeto(lista)
	local o = {}
	for _, e in lista do
		o[e.k] = e.l
	end
	return o
end

-- Libros de los cofres: nivel 5-30 con encantamientos de tesoro
function Enc.libroAleatorio(r)
	local l = Enc.elegir(LIBRO, 5 + floor(r() * 26), r, true)
	if #l > 0 then
		return Enc.aObjeto(l)
	end
	return { irrompibilidad = 1 }
end

-- Mesa de encantamientos: tres opciones (coste, lapislázuli, encantamientos y pista)
function Enc.opciones(id, librerias, semillaEnc)
	local e = Enc.encantabilidad(id)
	if e == 0 then
		return {}
	end
	local r = Ruido.mulberry32(semillaEnc)
	local base = 1 + floor(r() * 8) + bit32.rshift(librerias, 1) + floor(r() * (librerias + 1))
	local costes = { max(floor(base / 3), 1), floor(base * 2 / 3) + 1, max(base, librerias * 2) }
	local res = {}
	for i, c in costes do
		if c < i then
			res[i] = false
			continue
		end
		local rr = Ruido.mulberry32((semillaEnc + (i - 1) * 7919) % 4294967296)
		local lista = Enc.elegir(id, c, rr, false)
		if id == LIBRO and #lista > 1 then
			table.remove(lista, floor(rr() * #lista) + 1)
		end
		local pista = false
		if #lista > 0 then
			local rp = Ruido.mulberry32(bit32.bxor(semillaEnc, (i * 104729) % 4294967296))
			pista = lista[floor(rp() * #lista) + 1]
		end
		res[i] = { coste = c, lapis = i, niveles = i, enc = Enc.aObjeto(lista), pista = pista }
	end
	return res
end

Enc.LIBRO, Enc.LIBRO_ENC = LIBRO, LIBRO_ENC
function Enc.nivel(pila, k)
	return pila and pila.enc and pila.enc[k] or 0
end

return Enc
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Estructuras</string><ProtectedString name="Source"><![CDATA[--!native
--!optimize 2
--[[
	Blockverse para Roblox · Estructuras de la Superficie
	Traducción a Luau de las estructuras del juego web, en el mismo orden
	en que las genera:
	· mundo.js: fortaleza (con el portal del End), mazmorras, portales
	  en ruinas, pozos del desierto y aldeas.
	· v120.js: Deep Dark (sculk), ciudades antiguas, ruinas de sendero.
	· v121.js: cámaras de prueba. final.js: monumentos oceánicos.
	· completo.js: minas abandonadas, iglús, templos de la jungla,
	  cabañas de bruja, puestos de saqueadores y naufragios.
	· v26.js: pirámides del desierto. estructuras27.js: rocas, geodas,
	  fósiles, tesoros, ruinas oceánicas, sótanos de iglú y mansiones.
	· biomas27.js: decoración de biomas y cuevas. estructuras28.js: desgaste.
	Con la misma semilla salen los mismos bloques que en la versión web.
	Los cofres se apuntan en `cofres` como {x, y, z, tipo} (coordenadas del mundo).
]]
local Registro = require(script.Parent.Registro)
local Ruido = require(script.Parent.Ruido)
local Biomas = require(script.Parent.Datos.Biomas)

local hash2, hash3, mulberry32 = Ruido.hash2, Ruido.hash3, Ruido.mulberry32
local valueNoise, valueNoise3, fbm = Ruido.valueNoise, Ruido.valueNoise3, Ruido.fbm
local redondear = Ruido.redondear
local floor, abs, sqrt, min, max = math.floor, math.abs, math.sqrt, math.min, math.max
local fmod = math.fmod

local CO = Biomas.constantes
local CX, CZ, CY, OY, NIVEL_MAR = CO.CX, CO.CZ, CO.CY, CO.OY, CO.NIVEL_MAR
local BIOMA = Biomas.claves
local BR = Registro.B
local B = setmetatable({}, {
	__index = function(_, k)
		local v = BR[k]
		if v == nil then
			error("Estructuras: falta el bloque " .. tostring(k))
		end
		return v
	end,
})
local BL = Registro.bloques
local SOLIDO, REEMPL = Registro.SOLIDO, Registro.REEMPL
local esAgua, esLiquido, esHojas, esTronco = Registro.esAgua, Registro.esLiquido, Registro.esHojas, Registro.esTronco
local DIRF = Registro.DIRF

local function idx(x, y, z)
	return x + z * CX + y * CX * CZ
end
local function rd(d, i)
	return buffer.readu16(d, i * 2)
end
local function wr(d, i, v)
	buffer.writeu16(d, i * 2, v)
end
local function esOceano(b)
	return b == 0 or b == 21 or b == 22 or b == 29
end
local function hypot(...)
	local t = 0
	for _, v in { ... } do
		t += v * v
	end
	return sqrt(t)
end
-- Colores (registro.js): lana, hormigón, vidrio tintado y alfombras
local function LANA_COLOR(k)
	return k == 0 and 37 or 1339 + k
end
local function HORMIGON(k)
	return 1355 + k
end
local function VIDRIO_COLOR(k)
	return 1371 + k
end
local function ALFOMBRA(k)
	return 1387 + k
end

local E = {}
E.LANA_COLOR, E.HORMIGON, E.VIDRIO_COLOR, E.ALFOMBRA = LANA_COLOR, HORMIGON, VIDRIO_COLOR, ALFOMBRA

------------------------------------------------------------------
-- Contexto de un chunk
------------------------------------------------------------------
-- c = {gen, s, datos, cx, cz, bx, bz, info, bioma (buffer), cofres}
local function infoH(c, x, z)
	local h = c.gen:infoColumna(x, z)
	return h
end
local function cofreReg(c, x, y, z, tipo)
	table.insert(c.cofres, { x, y, z, tipo })
end

------------------------------------------------------------------
-- Fortaleza (mundo.js)
------------------------------------------------------------------
function E.posFortaleza(s)
	local a = hash2(1, 2, s) * math.pi * 2
	local d = 520 + hash2(3, 4, s) * 260
	return { x = redondear(math.cos(a) * d), y = 40, z = redondear(math.sin(a) * d) }
end

local function bloqueFortaleza(x, y, z, f, s)
	local rx, ry, rz = x - f.x, y - f.y, z - f.z
	local function piedra()
		local h = hash3(x, y, z, s + 40)
		return h < 0.25 and B.ladrillosMusgo or B.ladrillosPiedra
	end
	if abs(rx) <= 5 and abs(rz) <= 8 and ry >= 0 and ry <= 7 then
		local borde = abs(rx) == 5 or abs(rz) == 8 or ry == 0 or ry == 7
		local puerta = (abs(rz) == 8 or abs(rx) == 5) and ry >= 1 and ry <= 3
			and ((abs(rx) <= 1 and abs(rz) == 8) or (abs(rz) <= 1 and abs(rx) == 5))
		if borde and not puerta then
			return piedra()
		end
		if ry == 1 and abs(rx) <= 2 and rz >= 1 and rz <= 5 then
			if abs(rx) <= 1 and rz >= 2 and rz <= 4 then
				return B.lava
			end
			return piedra()
		end
		if ry == 2 then
			local marco = (abs(rx) == 2 and rz >= 2 and rz <= 4) or ((rz == 1 or rz == 5) and abs(rx) <= 1)
			if marco then
				return hash3(x, y, z, s + 41) < 0.1 and B.marcoEndOjo or B.marcoEnd
			end
		end
		if ry == 1 and rz == -5 and rx == 3 then
			return B.generador
		end
		return 0
	end
	local function pasillo(u, v, len)
		if u < 0 or u > len then
			return -1
		end
		if abs(v) > 2 or ry < 0 or ry > 4 then
			return -1
		end
		return (abs(v) == 2 or ry == 0 or ry == 4) and piedra() or 0
	end
	local function salaFinal(u, v, len)
		local du = u - len - 3
		if abs(du) > 3 or abs(v) > 3 or ry < 0 or ry > 5 then
			return -1
		end
		if abs(du) == 3 or abs(v) == 3 or ry == 0 or ry == 5 then
			if du == -3 and abs(v) <= 1 and ry >= 1 and ry <= 3 then
				return 0
			end
			return piedra()
		end
		if du == 2 and v == 0 and ry == 1 then
			return B.cofre
		end
		return 0
	end
	for _, t in { { -rz - 9, rx, 26 }, { rx - 6, rz, 22 }, { -rx - 6, rz, 30 } } do
		local b = pasillo(t[1], t[2], t[3])
		if b >= 0 then
			return b
		end
		b = salaFinal(t[1], t[2], t[3])
		if b >= 0 then
			return b
		end
	end
	return -1
end

------------------------------------------------------------------
-- Aldeas (mundo.js)
------------------------------------------------------------------
local ESTILOS = {
	[BIOMA.llanura] = "llanura", [BIOMA.desierto] = "desierto", [BIOMA.sabana] = "sabana", [BIOMA.taiga] = "taiga",
	[BIOMA.nevado] = "taiga", [BIOMA.abedul] = "llanura", [BIOMA.taigaNevada] = "taiga", [BIOMA.prado] = "llanura",
}
local TAM_EDIF = { casa = { 5, 5 }, casaGrande = { 7, 6 }, granja = { 7, 9 }, herreria = { 6, 6 } }
local TIPOS_EDIF = { "casa", "casa", "casaGrande", "granja", "herreria", "casa" }

function E.aldeaEnRegion(gen, rx, rz)
	gen._aldeas = gen._aldeas or {}
	local k = rx .. "," .. rz
	local cache = gen._aldeas[k]
	if cache ~= nil then
		return cache or nil
	end
	local res = false
	local s = gen.semilla + 12000
	if hash2(rx, rz, s) < 0.6 then
		local x = rx * 320 + 60 + floor(hash2(rx, rz, s + 1) * 200)
		local z = rz * 320 + 60 + floor(hash2(rx, rz, s + 2) * 200)
		local h0, bio0 = gen:infoColumna(x, z)
		if ESTILOS[bio0] and h0 > NIVEL_MAR + 1 then
			local r = mulberry32(floor(hash2(rx, rz, s + 3) * 4294967296))
			local al = { x = x, z = z, y = h0, estilo = ESTILOS[bio0], brazos = {}, edificios = {}, farolas = {} }
			local ocupa = { { x - 3, z - 3, x + 3, z + 3 } }
			local function libre(a)
				for _, o in ocupa do
					if a[1] <= o[3] + 1 and a[3] >= o[1] - 1 and a[2] <= o[4] + 1 and a[4] >= o[2] - 1 then
						return false
					end
				end
				return true
			end
			for d = 0, 3 do
				local len = 16 + floor(r() * 12)
				table.insert(al.brazos, { d = d, len = len })
				local dx, dz = DIRF[d + 1][1], DIRF[d + 1][2]
				local px, pz = -dz, dx
				local dist = 7
				while dist < len - 2 do
					if r() < 0.35 then
						table.insert(al.farolas, { x + dx * dist + px * 2, z + dz * dist + pz * 2 })
					end
					for _, lado in { -1, 1 } do
						if r() > 0.8 then
							continue
						end
						local tipo = TIPOS_EDIF[floor(r() * 6) + 1]
						local w, p = TAM_EDIF[tipo][1], TAM_EDIF[tipo][2]
						local off = 3 + math.ceil(max(w, p) / 2)
						local ecx, ecz = x + dx * dist + px * lado * off, z + dz * dist + pz * lado * off
						local x0, z0 = ecx - floor(w / 2), ecz - floor(p / 2)
						local caja = { x0, z0, x0 + w - 1, z0 + p - 1 }
						if not libre(caja) then
							continue
						end
						local hc = gen:infoColumna(ecx, ecz)
						if hc <= NIVEL_MAR or abs(hc - h0) > 8 then
							continue
						end
						table.insert(ocupa, caja)
						local vx, vz = -px * lado, -pz * lado
						local puerta = vz < 0 and 0 or vx > 0 and 1 or vz > 0 and 2 or 3
						table.insert(al.edificios, { tipo = tipo, x0 = x0, z0 = z0, w = w, p = p, y = hc, puerta = puerta, r = floor(r() * 1e9) })
					end
					dist += 8
				end
			end
			local cj = { x - 30, z - 30, x + 30, z + 30 }
			for _, o in ocupa do
				cj = { min(cj[1], o[1]), min(cj[2], o[2]), max(cj[3], o[3]), max(cj[4], o[4]) }
			end
			al.caja = cj
			res = al
		end
	end
	gen._aldeas[k] = res
	return res or nil
end

function E.aldeasCerca(gen, x, z)
	local rx, rz = floor(x / 320), floor(z / 320)
	local res = {}
	for a = -1, 1 do
		for b = -1, 1 do
			local al = E.aldeaEnRegion(gen, rx + a, rz + b)
			if al then
				table.insert(res, al)
			end
		end
	end
	return res
end

local MATERIALES = {
	llanura = { pared = "tablones", esquina = "tronco", suelo = "roca", techo = "tablones", losa = "losaMadera" },
	desierto = { pared = "arenisca", esquina = "arenisca", suelo = "arenisca", techo = "arenisca", losa = "losaPiedra" },
	sabana = { pared = "tablones", esquina = "troncoAcacia", suelo = "roca", techo = "tablones", losa = "losaMadera" },
	taiga = { pared = "tablones", esquina = "troncoAbeto", suelo = "roca", techo = "tablones", losa = "losaMadera" },
}

local function construirEdificio(e, estilo, set, alt, cofre)
	local Mc = MATERIALES[estilo]
	local M = { pared = B[Mc.pared], esquina = B[Mc.esquina], suelo = B[Mc.suelo], techo = B[Mc.techo], losa = B[Mc.losa] }
	local x0, z0, w, p, y = e.x0, e.z0, e.w, e.p, e.y
	local x1, z1 = x0 + w - 1, z0 + p - 1
	local r = mulberry32(e.r)
	for x = x0, x1 do
		for z = z0, z1 do
			local h = alt(x, z)
			for yy = min(h, y - 1), y - 1 do
				set(x, yy, z, M.suelo)
			end
			for yy = y + 1, max(h, y) + 2 do
				set(x, yy, z, 0)
			end
		end
	end
	if e.tipo == "granja" then
		local mid = x0 + floor(w / 2)
		for x = x0, x1 do
			for z = z0, z1 do
				local borde = x == x0 or x == x1 or z == z0 or z == z1
				if borde then
					set(x, y, z, M.esquina == B.arenisca and B.arenisca or B.tronco)
				elseif x == mid then
					set(x, y, z, B.agua)
				else
					set(x, y, z, B.cultivo)
					local t = fmod(x * 7 + z * 3, 9)
					local cult = nil
					if BR.zanahorias0 ~= nil and t > 5 then
						cult = ({ B.zanahorias0, B.patatas0, B.remolachas0 })[t - 5]
					end
					set(x, y + 1, z, cult and cult + floor(r() * 4) or B.trigo0 + floor(r() * 8))
				end
			end
		end
		return
	end
	local alto = 4
	local pdx, pdz = DIRF[e.puerta + 1][1], DIRF[e.puerta + 1][2]
	local puertaX = pdx ~= 0 and (pdx > 0 and x1 or x0) or x0 + floor(w / 2)
	local puertaZ = pdz ~= 0 and (pdz > 0 and z1 or z0) or z0 + floor(p / 2)
	for x = x0, x1 do
		for z = z0, z1 do
			set(x, y, z, M.suelo)
			local bx, bz = x == x0 or x == x1, z == z0 or z == z1
			local esquina = bx and bz
			for yy = y + 1, y + alto - 1 do
				if esquina then
					set(x, yy, z, M.esquina)
				elseif bx or bz then
					local ventana = yy == y + 2 and ((bx and (z - z0) % 2 == 0 and z ~= z0 and z ~= z1) or (bz and (x - x0) % 2 == 0 and x ~= x0 and x ~= x1))
					set(x, yy, z, ventana and B.panel or (e.tipo == "herreria" and B.roca or M.pared))
				else
					set(x, yy, z, 0)
				end
			end
		end
	end
	for x = x0 - 1, x1 + 1 do
		for z = z0 - 1, z1 + 1 do
			local borde = x < x0 or x > x1 or z < z0 or z > z1
			set(x, y + alto, z, borde and M.losa or M.techo)
		end
	end
	for x = x0 + 1, x1 - 1 do
		for z = z0 + 1, z1 - 1 do
			set(x, y + alto + 1, z, M.losa)
		end
	end
	local fPuerta = ({ 2, 3, 0, 1 })[e.puerta + 1]
	set(puertaX, y + 1, puertaZ, 149 + fPuerta * 4)
	set(puertaX, y + 2, puertaZ, 149 + fPuerta * 4 + 1)
	set(puertaX + pdx, y, puertaZ + pdz, M.suelo)
	set(puertaX + pdx, y + 1, puertaZ + pdz, 0)
	set(puertaX + pdx, y + 2, puertaZ + pdz, 0)
	local ix, iz = x0 + 1, z0 + 1
	if e.tipo == "herreria" then
		set(x1 - 1, y + 1, z1 - 1, B.horno)
		set(x1 - 2, y + 1, z1 - 1, B.horno)
		set(x0 + 1, y, z1 - 1, B.lava)
		set(x0 + 1, y + 1, z0 + 1, B.cofre)
		cofre(x0 + 1, y + 1, z0 + 1, "herreria")
	else
		set(ix, y + 1, iz, B.cama)
		set(x1 - 1, y + 1, iz, B.mesa)
		if e.tipo == "casaGrande" then
			set(x1 - 1, y + 1, z1 - 1, B.cofre)
			cofre(x1 - 1, y + 1, z1 - 1, "aldea")
		end
	end
	set(x0 + floor(w / 2), y + 3, z0 + floor(p / 2), 0)
	set(x0 + floor(w / 2) + (pdx ~= 0 and -pdx or 0), y + 1, z0 + floor(p / 2) + (pdz ~= 0 and -pdz or 0), B.antorcha)
end

local function estampar(c, x0, z0, x1, z1, fn)
	local bx, bz = c.bx, c.bz
	if x1 < bx or x0 > bx + CX - 1 or z1 < bz or z0 > bz + CZ - 1 then
		return false
	end
	local datos = c.datos
	local function set(x, y, z, id)
		local lx, lz = x - bx, z - bz
		if lx < 0 or lz < 0 or lx >= CX or lz >= CZ or y < 1 or y >= CY then
			return
		end
		wr(datos, idx(lx, y, lz), id)
	end
	fn(set)
	return true
end

local function estructuraAldea(c, al)
	local bx, bz, datos = c.bx, c.bz, c.datos
	local function alt(x, z)
		if x >= bx and x < bx + CX and z >= bz and z < bz + CZ then
			return c.info[(z - bz) * CX + x - bx + 1][1]
		end
		return infoH(c, x, z)
	end
	local function cofre(x, y, z, t)
		if x >= bx and x < bx + CX and z >= bz and z < bz + CZ then
			cofreReg(c, x, y, z, t)
		end
	end
	for _, br in al.brazos do
		local dx, dz = DIRF[br.d + 1][1], DIRF[br.d + 1][2]
		local px, pz = -dz, dx
		for i = 2, br.len do
			for k = -1, 1 do
				local x, z = al.x + dx * i + px * k, al.z + dz * i + pz * k
				if x < bx or x >= bx + CX or z < bz or z >= bz + CZ then
					continue
				end
				local h = alt(x, z)
				local i2 = idx(x - bx, h, z - bz)
				local b = rd(datos, i2)
				if b == B.cesped or b == B.tierra or b == B.arena or b == B.cespedNevado or b == B.arenaRoja then
					wr(datos, i2, B.senda)
					local a = idx(x - bx, h + 1, z - bz)
					if REEMPL[rd(datos, a)] then
						wr(datos, a, 0)
					end
				elseif esAgua(b) then
					wr(datos, i2, B.tablones)
				end
			end
		end
	end
	estampar(c, al.x - 2, al.z - 2, al.x + 1, al.z + 1, function(set)
		local y = al.y
		for x = al.x - 2, al.x + 1 do
			for z = al.z - 2, al.z + 1 do
				local dentro = x > al.x - 2 and x < al.x + 1 and z > al.z - 2 and z < al.z + 1
				set(x, y - 2, z, B.roca)
				if dentro then
					set(x, y - 1, z, B.agua)
					set(x, y, z, B.agua)
					set(x, y + 1, z, 0)
				else
					set(x, y - 1, z, B.roca)
					set(x, y, z, B.roca)
					set(x, y + 1, z, B.roca)
				end
				local esq = (x == al.x - 2 or x == al.x + 1) and (z == al.z - 2 or z == al.z + 1)
				for yy = y + 2, y + 3 do
					set(x, yy, z, esq and B.valla or 0)
				end
				set(x, y + 4, z, B.losaRoca)
			end
		end
	end)
	for _, e in al.edificios do
		estampar(c, e.x0 - 1, e.z0 - 1, e.x0 + e.w, e.z0 + e.p, function(set)
			construirEdificio(e, al.estilo, set, alt, cofre)
		end)
	end
	for _, f in al.farolas do
		local fx, fz = f[1], f[2]
		estampar(c, fx, fz, fx, fz, function(set)
			local h = alt(fx, fz)
			set(fx, h + 1, fz, B.valla)
			set(fx, h + 2, fz, B.valla)
			set(fx, h + 3, fz, B.linternaCalabaza)
		end)
	end
end

------------------------------------------------------------------
-- estructurasSuperficie (mundo.js)
------------------------------------------------------------------
local function estructurasSuperficie(c)
	local datos, cx, cz, bx, bz, s, info = c.datos, c.cx, c.cz, c.bx, c.bz, c.s, c.info
	local f = E.posFortaleza(s)
	if bx + CX > f.x - 45 and bx < f.x + 45 and bz + CZ > f.z - 45 and bz < f.z + 45 then
		for z = 0, CZ - 1 do
			for x = 0, CX - 1 do
				for y = f.y, f.y + 7 do
					local b = bloqueFortaleza(bx + x, y, bz + z, f, s)
					if b >= 0 then
						wr(datos, idx(x, y, z), b)
						if b == B.cofre then
							cofreReg(c, bx + x, y, bz + z, "fortaleza")
						end
					end
				end
			end
		end
	end
	-- Mazmorra
	if hash2(cx, cz, s + 900) < 0.035 then
		local cy = 18 + floor(hash2(cx, cz, s + 901) * 50)
		local hx = hash2(cx, cz, s + 903) < 0.5 and 4 or 5
		local hz = hash2(cx, cz, s + 904) < 0.5 and 4 or 5
		for z = 8 - hz, 8 + hz do
			for x = 8 - hx, 8 + hx do
				for y = cy, cy + 5 do
					local rx, rz, ry = x - 8, z - 8, y - cy
					local i = idx(x, y, z)
					local borde = abs(rx) == hx or abs(rz) == hz or ry == 0 or ry == 5
					if borde then
						if rd(datos, i) ~= 0 then
							wr(datos, i, (ry == 0 and hash3(x, y, z, s + 44) < 0.5) and B.rocaMusgo or B.roca)
						end
					else
						wr(datos, i, 0)
					end
				end
			end
		end
		wr(datos, idx(8, cy + 1, 8), B.generador)
		local huecos = {}
		for x = 9 - hx, 7 + hx do
			table.insert(huecos, { x, 8 - hz + 1 })
			table.insert(huecos, { x, 8 + hz - 1 })
		end
		for z = 10 - hz, 6 + hz do
			table.insert(huecos, { 8 - hx + 1, z })
			table.insert(huecos, { 8 + hx - 1, z })
		end
		local ncof = hash2(cx, cz, s + 902) < 0.5 and 2 or 1
		for k = 0, ncof - 1 do
			local hq = huecos[floor(hash2(cx + k * 7, cz, s + 905) * #huecos) + 1]
			local x, z = hq[1], hq[2]
			if rd(datos, idx(x, cy + 1, z)) == B.cofre then
				continue
			end
			wr(datos, idx(x, cy + 1, z), B.cofre)
			cofreReg(c, bx + x, cy + 1, bz + z, "mazmorra")
		end
	end
	local centro = info[8 * CX + 8 + 1]
	local hC = centro[1]
	-- Portal en ruinas
	if hash2(cx, cz, s + 950) < 0.006 and hC > NIVEL_MAR then
		local rr = mulberry32(floor(hash2(cx, cz, s + 951) * 4294967296))
		for _ = 0, 29 do
			local x, z = 4 + floor(rr() * 8), 4 + floor(rr() * 8)
			local h = info[z * CX + x + 1][1]
			if abs(h - hC) < 3 then
				wr(datos, idx(x, h, z), rr() < 0.8 and B.netherrack or B.bloqueOro)
			end
		end
		for a = -1, 2 do
			for hh = 0, 4 do
				local marco = a == -1 or a == 2 or hh == 0 or hh == 4
				local x, y, z = 6 + a, hC + hh, 8
				if marco then
					if rr() < 0.72 then
						wr(datos, idx(x, y, z), rr() < 0.2 and B.obsidianaLlorosa or B.obsidiana)
					end
				else
					wr(datos, idx(x, y, z), 0)
				end
			end
		end
		for _ = 0, 2 do
			local x, z = 4 + floor(rr() * 8), 4 + floor(rr() * 8)
			local h = info[z * CX + x + 1][1]
			wr(datos, idx(x, h + 1, z), B.obsidiana)
		end
		wr(datos, idx(5, hC + 1, 11), B.cofre)
		cofreReg(c, bx + 5, hC + 1, bz + 11, "portalRuinas")
	end
	-- Pozo del desierto
	if centro[2] == BIOMA.desierto and hash2(cx, cz, s + 960) < 0.01 then
		for x = 6, 10 do
			for z = 6, 10 do
				wr(datos, idx(x, hC, z), B.arenisca)
				for y = hC + 1, hC + 5 do
					wr(datos, idx(x, y, z), 0)
				end
			end
		end
		wr(datos, idx(8, hC, 8), B.agua)
		wr(datos, idx(8, hC - 1, 8), B.agua)
		for x = 7, 9 do
			for z = 7, 9 do
				if x ~= 8 or z ~= 8 then
					wr(datos, idx(x, hC + 1, z), B.arenisca)
				end
				wr(datos, idx(x, hC + 4, z), B.arenisca)
			end
		end
		for _, q in { { 7, 7 }, { 9, 7 }, { 7, 9 }, { 9, 9 } } do
			for y = hC + 2, hC + 3 do
				wr(datos, idx(q[1], y, q[2]), B.arenisca)
			end
		end
	end
	for _, al in E.aldeasCerca(c.gen, bx + 8, bz + 8) do
		local cj = al.caja
		if bx + CX > cj[1] and bx <= cj[3] and bz + CZ > cj[2] and bz <= cj[4] then
			estructuraAldea(c, al)
		end
	end
end

------------------------------------------------------------------
-- 1.19 / 1.20 (v120.js): Deep Dark, ciudades antiguas y ruinas
------------------------------------------------------------------
local Y_CIUDAD = OY - 51
local R_CIUDAD = 288
local function esDeepDark(s, x, z)
	return fbm(x * 0.0032, z * 0.0032, s + 8800, 2) > 0.6
end
E.esDeepDark = esDeepDark
local ROCA_SCULK

function E.ciudadesAntiguasCerca(s, x0, z0, x1, z1)
	local res = {}
	for rx = floor((x0 - 48) / R_CIUDAD), floor((x1 + 48) / R_CIUDAD) do
		for rz = floor((z0 - 48) / R_CIUDAD), floor((z1 + 48) / R_CIUDAD) do
			if hash2(rx, rz, s + 8900) > 0.65 then
				continue
			end
			local x = rx * R_CIUDAD + 48 + floor(hash2(rx, rz, s + 8901) * (R_CIUDAD - 96))
			local z = rz * R_CIUDAD + 48 + floor(hash2(rx, rz, s + 8902) * (R_CIUDAD - 96))
			if not esDeepDark(s, x, z) then
				continue
			end
			table.insert(res, { x = x, z = z, y = Y_CIUDAD })
		end
	end
	return res
end

local function construirCiudadesAntiguas(c)
	local bx, bz, d, s = c.bx, c.bz, c.datos, c.s
	for _, ci in E.ciudadesAntiguasCerca(s, bx, bz, bx + CX - 1, bz + CZ - 1) do
		if bx + CX < ci.x - 44 or bx > ci.x + 44 or bz + CZ < ci.z - 36 or bz > ci.z + 36 then
			continue
		end
		local F = ci.y
		local function pon(x, y, z, b)
			if not (x >= bx and x < bx + CX and z >= bz and z < bz + CZ) or y < 1 or y >= CY then
				return
			end
			wr(d, idx(x - bx, y, z - bz), b)
			if b == B.cofre then
				cofreReg(c, x, y, z, "ciudadAntigua")
			end
		end
		local function get(x, y, z)
			return rd(d, idx(x - bx, y, z - bz))
		end
		for x = max(bx, ci.x - 42), min(bx + CX - 1, ci.x + 42) do
			for z = max(bz, ci.z - 34), min(bz + CZ - 1, ci.z + 34) do
				local dx, dz = x - ci.x, z - ci.z
				local e = (dx / 42) ^ 2 + (dz / 34) ^ 2
				if e > 1 then
					continue
				end
				local techo = F + 9 + redondear((1 - e) * 9 + hash2(x, z, s + 8910) * 2)
				for y = F, techo do
					pon(x, y, z, 0)
				end
				local t = get(x, techo + 1, z)
				if t == 0 or esLiquido(t) then
					pon(x, techo + 1, z, B.pizarra)
				end
				for y = F - 4, F - 2 do
					local b = get(x, y, z)
					if b == 0 or esLiquido(b) then
						pon(x, y, z, B.pizarra)
					end
				end
				local camino = abs(dz) <= 1 or abs(dx) <= 1
				local v = valueNoise(x * 0.18, z * 0.18, s + 8911)
				pon(x, F - 1, z, camino and B.baldosasPizarra or (v > 0.55 and B.sculk or (bit32.band(bit32.bxor(x, z), 7) == 0 and B.baldosasPizarra or B.ladrillosPizarra)))
				if not camino and v > 0.6 then
					local h = hash2(x, z, s + 8912)
					if h < 0.035 then
						pon(x, F, z, B.sensorSculk)
					elseif h < 0.05 then
						pon(x, F, z, B.chillador)
					elseif h < 0.14 then
						pon(x, F, z, B.vetaSculk)
					end
				end
				if (abs(dz) == 3 and dx % 8 == 0 and abs(dx) > 13) or (abs(dx) == 3 and dz % 8 == 0 and abs(dz) > 5) then
					pon(x, F, z, B.baldosasPizarra)
					pon(x, F + 1, z, B.baldosasPizarra)
					pon(x, F + 2, z, B.farolAlmas)
				end
			end
		end
		for dx = -12, 12 do
			for dz = -4, 4 do
				local x, z = ci.x + dx, ci.z + dz
				pon(x, F, z, (abs(dx) == 12 or abs(dz) == 4) and B.baldosasPizarra or B.ladrillosPizarra)
				for y = F + 1, F + 15 do
					pon(x, y, z, 0)
				end
			end
		end
		for dx = -9, 9 do
			for y = F + 1, F + 14 do
				local a = abs(dx)
				local marco = (a >= 7 and a <= 8) or (y >= F + 12 and a <= 8) or (y == F + 11 and a >= 5 and a <= 8) or (y == F + 13 and a == 9)
				if marco then
					pon(ci.x + dx, y, ci.z, B.pizarraReforzada)
				end
				if a == 9 and y <= F + 4 then
					for _, dz in { -1, 0, 1 } do
						pon(ci.x + dx, y, ci.z + dz, B.ladrillosPizarra)
					end
				end
			end
		end
		for _, o in { { -10, 2 }, { 10, -2 } } do
			pon(ci.x + o[1], F + 1, ci.z + o[2], B.cofre)
		end
		for _, o in { { -5, 3 }, { 5, -3 }, { -5, -3 }, { 5, 3 } } do
			pon(ci.x + o[1], F + 1, ci.z + o[2], B.farolAlmas)
		end
		for _, o in { { -26, -18 }, { 26, -18 }, { -26, 18 }, { 26, 18 }, { -34, 0 }, { 34, 0 }, { 0, -24 }, { 0, 24 } } do
			local ox, oz = o[1], o[2]
			if hash2(ci.x + ox, ci.z + oz, s + 8913) < 0.2 then
				continue
			end
			local x0, z0 = ci.x + ox - 3, ci.z + oz - 3
			for x = x0, x0 + 6 do
				for z = z0, z0 + 6 do
					local borde = x == x0 or x == x0 + 6 or z == z0 or z == z0 + 6
					local esq = (x == x0 or x == x0 + 6) and (z == z0 or z == z0 + 6)
					pon(x, F - 1, z, B.baldosasPizarra)
					for y = F, F + 4 do
						if y == F + 4 then
							pon(x, y, z, hash3(x, y, z, s + 8916) < 0.2 and 0 or B.ladrillosPizarra)
						elseif borde then
							pon(x, y, z, (hash3(x, y, z, s + 8914) < 0.15 and y > F + 1) and 0 or (esq and B.baldosasPizarra or B.ladrillosPizarra))
						else
							pon(x, y, z, 0)
						end
					end
				end
			end
			local px = ox == 0 and ci.x or (ox < 0 and x0 + 6 or x0)
			local pz = ox == 0 and (oz < 0 and z0 + 6 or z0) or ci.z + oz
			for y = F, F + 2 do
				pon(px, y, pz, 0)
			end
			pon(x0 + 3, F, z0 + 3, B.cofre)
			pon(x0 + 1, F, z0 + 1, B.farolAlmas)
			pon(x0 + 5, F, z0 + 1, B.farolAlmas)
			if hash2(x0, z0, s + 8915) < 0.6 then
				pon(x0 + 5, F, z0 + 5, B.chillador)
			end
			if hash2(x0, z0, s + 8917) < 0.5 then
				pon(x0 + 1, F, z0 + 5, B.sensorSculk)
			end
		end
	end
end

------------------------------------------------------------------
-- Cámaras de prueba (v121.js)
------------------------------------------------------------------
local R_CAMARA, F_CAMARA = 320, OY - 28
function E.camarasPruebaCerca(s, x0, z0, x1, z1)
	local res = {}
	for rx = floor((x0 - 48) / R_CAMARA), floor((x1 + 48) / R_CAMARA) do
		for rz = floor((z0 - 48) / R_CAMARA), floor((z1 + 48) / R_CAMARA) do
			if hash2(rx, rz, s + 9300) > 0.55 then
				continue
			end
			table.insert(res, {
				x = rx * R_CAMARA + 60 + floor(hash2(rx, rz, s + 9301) * (R_CAMARA - 120)),
				z = rz * R_CAMARA + 60 + floor(hash2(rx, rz, s + 9302) * (R_CAMARA - 120)),
				y = F_CAMARA,
			})
		end
	end
	return res
end

local function construirCamarasPrueba(c)
	local bx, bz, d, s = c.bx, c.bz, c.datos, c.s
	for _, cm in E.camarasPruebaCerca(s, bx, bz, bx + CX - 1, bz + CZ - 1) do
		if bx + CX < cm.x - 47 or bx > cm.x + 47 or bz + CZ < cm.z - 47 or bz > cm.z + 47 then
			continue
		end
		local F = cm.y
		local function pon(x, y, z, b)
			if x < bx or x >= bx + CX or z < bz or z >= bz + CZ or y < 1 or y >= CY then
				return
			end
			wr(d, idx(x - bx, y, z - bz), b)
			if b == B.cofre then
				cofreReg(c, x, y, z, "camaraPrueba")
			end
		end
		local function sala(x0, z0, x1, z1, alto, techoLuz)
			for x = x0, x1 do
				for z = z0, z1 do
					for y = F - 1, F + alto do
						local borde = x == x0 or x == x1 or z == z0 or z == z1 or y == F - 1 or y == F + alto
						local b = 0
						if borde then
							b = B.ladrillosToba
							if y == F - 1 and (x + z) % 6 == 0 then
								b = B.cobreCortado
							end
							if y == F + alto and techoLuz and (x - x0) % 5 == 2 and (z - z0) % 5 == 2 then
								b = B.bombillaCobre
							end
							if y > F - 1 and y < F + alto and (y - F) % 4 == 3 then
								b = B.cobreCortado
							end
						end
						pon(x, y, z, b)
					end
				end
			end
		end
		local DIRS = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }
		for _, u2 in DIRS do
			local ux, uz = u2[1], u2[2]
			for u = 9, 35 do
				for v = -3, 3 do
					for y = F - 1, F + 5 do
						local x, z = cm.x + ux * u + uz * v, cm.z + uz * u + ux * v
						local borde = abs(v) == 3 or y == F - 1 or y == F + 5
						pon(x, y, z, borde and ((y == F + 5 and v == 0 and u % 7 == 0) and B.bombillaCobre or (y == F - 1 and B.toba or B.ladrillosToba)) or 0)
					end
				end
			end
		end
		sala(cm.x - 9, cm.z - 9, cm.x + 9, cm.z + 9, 9, true)
		for _, u2 in DIRS do
			local ux, uz = u2[1], u2[2]
			for v = -2, 2 do
				for y = F, F + 4 do
					pon(cm.x + ux * 9 + uz * v, y, cm.z + uz * 9 + ux * v, 0)
				end
			end
		end
		pon(cm.x, F, cm.z, B.ladrillosToba)
		pon(cm.x, F + 1, cm.z, B.generadorPruebas)
		pon(cm.x - 6, F, cm.z - 7, B.boveda)
		pon(cm.x + 6, F, cm.z - 7, B.boveda)
		pon(cm.x, F, cm.z + 7, B.cofre)
		for _, o in { { -7, 6 }, { 7, 6 }, { -7, -4 }, { 7, -4 } } do
			pon(cm.x + o[1], F, cm.z + o[2], B.vasija)
		end
		for _, u2 in DIRS do
			local ux, uz = u2[1], u2[2]
			local rx, rz = cm.x + ux * 41, cm.z + uz * 41
			sala(rx - 6, rz - 6, rx + 6, rz + 6, 7, true)
			for v = -2, 2 do
				for y = F, F + 4 do
					pon(rx - ux * 6 + uz * v, y, rz - uz * 6 + ux * v, 0)
				end
			end
			pon(rx, F, rz, B.generadorPruebas)
			pon(rx + uz * 4 + ux * 4, F, rz + ux * 4 + uz * 4, B.boveda)
			if hash2(rx, rz, s + 9303) < 0.6 then
				pon(rx - uz * 4 + ux * 4, F, rz - ux * 4 + uz * 4, B.cofre)
			end
			pon(rx + 3, F, rz - 4, B.vasija)
			pon(rx - 4, F, rz + 3, B.vasija)
		end
	end
end

------------------------------------------------------------------
-- Monumentos oceánicos (final.js)
------------------------------------------------------------------
local R_MON = 448
function E.monumentoEn(gen, rx, rz)
	gen._mon = gen._mon or {}
	local k = rx .. "," .. rz
	local cache = gen._mon[k]
	if cache ~= nil then
		return cache or nil
	end
	local s = gen.semilla
	local res = false
	if hash2(rx, rz, s + 9800) < 0.6 then
		local x = rx * R_MON + 60 + floor(hash2(rx, rz, s + 9801) * (R_MON - 120))
		local z = rz * R_MON + 60 + floor(hash2(rx, rz, s + 9802) * (R_MON - 120))
		local ok, hmin = true, 999
		for _, q in { { 0, 0 }, { -18, -18 }, { 18, -18 }, { -18, 18 }, { 18, 18 } } do
			local h, bio = gen:infoColumna(x + q[1], z + q[2])
			if not esOceano(bio) or h > NIVEL_MAR - 12 then
				ok = false
			end
			hmin = min(hmin, h)
		end
		if ok then
			local F = max(hmin + 1, NIVEL_MAR - 24)
			res = { x = x, z = z, F = F, H = NIVEL_MAR - 2 - F }
		end
	end
	gen._mon[k] = res
	return res or nil
end
function E.monumentosCerca(gen, x0, z0, x1, z1)
	local res = {}
	for rx = floor((x0 - 24) / R_MON), floor((x1 + 24) / R_MON) do
		for rz = floor((z0 - 24) / R_MON), floor((z1 + 24) / R_MON) do
			local m = E.monumentoEn(gen, rx, rz)
			if m then
				table.insert(res, m)
			end
		end
	end
	return res
end

local function bloqueMonumento(dx, y, dz, M)
	local rel, ax, az, H = y - M.F, abs(dx), abs(dz), M.H
	if ax > 20 or az > 20 then
		return -1
	end
	if rel == -1 then
		return B.ladrillosPrismarina
	end
	if rel < 0 then
		return -1
	end
	local alaTecho, salaTecho = 8, min(H - 5, 14)
	local techo
	if ax <= 5 and az <= 5 then
		techo = H
	elseif ax <= 11 and az <= 16 then
		techo = salaTecho
	else
		techo = alaTecho
	end
	if rel > techo then
		return -1
	end
	local agua = y <= NIVEL_MAR and B.agua or 0
	if dz <= -15 and ax <= 2 and rel <= 4 then
		return agua
	end
	if ax <= 2 and az <= 2 and rel <= 2 then
		if dx >= -1 and dx <= 0 and dz >= -1 and dz <= 0 and rel <= 1 then
			return B.bloqueOro
		end
		return B.prismarinaOscura
	end
	local muro = (ax == 20 or az == 20) or (rel > alaTecho and ((ax == 11 and az <= 16) or (az == 16 and ax <= 11)))
		or (rel > salaTecho and ((ax == 5 and az <= 5) or (az == 5 and ax <= 5)))
	if rel == techo then
		if ((dx + dz) % 5 + 5) % 5 == 0 and (ax + az) % 2 == 0 then
			return B.farolMarino
		end
		return techo == H and B.prismarinaOscura or B.prismarina
	end
	if muro then
		if ax % 5 == 0 and az % 5 == 0 then
			return B.prismarinaOscura
		end
		if rel % 4 == 2 and (dx % 3 == 0 or dz % 3 == 0) and not (ax == 20 and az == 20) then
			return agua
		end
		return (rel + dx + dz) % 3 == 0 and B.ladrillosPrismarina or B.prismarina
	end
	if rel == 6 and ax <= 11 and az <= 16 and not (ax <= 3 and az <= 3) and not (dx % 7 == 0 and dz % 5 == 0) then
		return B.ladrillosPrismarina
	end
	if rel < techo and ax % 6 == 3 and az % 6 == 3 and ax <= 17 then
		return B.prismarinaOscura
	end
	if rel == techo - 1 and ax % 4 == 0 and az % 4 == 0 then
		return B.farolMarino
	end
	if rel == 7 and ax >= 13 and ax <= 16 and az <= 2 then
		return B.esponjaMojada
	end
	return agua
end

local function construirMonumentos(c)
	local bx, bz, d = c.bx, c.bz, c.datos
	for _, M in E.monumentosCerca(c.gen, bx, bz, bx + CX - 1, bz + CZ - 1) do
		if bx + CX < M.x - 21 or bx > M.x + 21 or bz + CZ < M.z - 21 or bz > M.z + 21 then
			continue
		end
		for x = max(bx, M.x - 20), min(bx + CX - 1, M.x + 20) do
			for z = max(bz, M.z - 20), min(bz + CZ - 1, M.z + 20) do
				local lx, lz = x - bx, z - bz
				for y = M.F - 1, M.F + M.H do
					local b = bloqueMonumento(x - M.x, y, z - M.z, M)
					if b >= 0 then
						wr(d, idx(lx, y, lz), b)
					end
				end
				local y = M.F - 2
				while y > M.F - 14 and y > 1 do
					local b = rd(d, idx(lx, y, lz))
					if b ~= 0 and not esLiquido(b) then
						break
					end
					wr(d, idx(lx, y, lz), B.prismarina)
					y -= 1
				end
			end
		end
	end
end

------------------------------------------------------------------
-- Ruinas de sendero (v120.js)
------------------------------------------------------------------
local function ruinasSendero(c, hC)
	local datos, info, bx, bz, s = c.datos, c.info, c.bx, c.bz, c.s
	for x = 3, 12 do
		for z = 3, 12 do
			local borde = x == 3 or x == 12 or z == 3 or z == 12
			local h = info[z * CX + x + 1][1]
			for y = hC - 6, min(h, hC) - 1 do
				local k = hash3(bx + x, y, bz + z, s + 9701)
				local i = idx(x, y, z)
				if borde then
					wr(datos, i, k < 0.5 and B.ladrillosBarro or k < 0.8 and B.terracota or B.terracota2)
				else
					wr(datos, i, k < 0.14 and B.gravaSospechosa or k < 0.62 and B.grava or k < 0.66 and B.ladrillosBarro or B.tierra)
				end
			end
			if borde and hash2(bx + x, bz + z, s + 9702) < 0.45 then
				local alto = 1 + floor(hash2(bx + x, bz + z, s + 9703) * 3)
				for y = h + 1, h + alto do
					wr(datos, idx(x, y, z), hash3(bx + x, y, bz + z, s + 9704) < 0.7 and B.ladrillosBarro or B.terracota)
				end
			end
		end
	end
	wr(datos, idx(7, hC - 4, 8), B.vasija)
end

------------------------------------------------------------------
-- Minas abandonadas (completo.js)
------------------------------------------------------------------
local function minaAbandonada(c)
	local datos, cx, cz, s = c.datos, c.cx, c.cz, c.s
	local rx, rz = floor(cx / 5), floor(cz / 5)
	if hash2(rx, rz, s + 9950) > 0.22 then
		return
	end
	local Y = OY - 8 + floor(hash2(rx, rz, s + 9951) * 36)
	local bx, bz = c.bx, c.bz
	local function P(x, y, z, b)
		if x >= 0 and x < CX and z >= 0 and z < CZ and y > 0 and y < CY then
			wr(datos, idx(x, y, z), b)
		end
	end
	local conX = hash2(cx, cz, s + 9952) < 0.75
	local conZ = hash2(cx, cz, s + 9953) < 0.75
	local function pasillo(eje)
		for u = 0, 15 do
			for v = 7, 9 do
				local x, z = eje and u or v, eje and v or u
				for y = Y, Y + 2 do
					P(x, y, z, 0)
				end
				local suelo = rd(datos, idx(x, Y - 1, z))
				if suelo == 0 or esLiquido(suelo) then
					P(x, Y - 1, z, B.tablones)
				end
				if v == 8 and (eje and abs(z - 8) or abs(x - 8)) == 0 and u ~= 8 and hash3(bx + x, Y, bz + z, s + 9954) < 0.7 then
					P(x, Y, z, eje and 1261 or 1260)
				end
				if hash3(bx + x, Y + 2, bz + z, s + 9955) < 0.05 and v ~= 8 then
					P(x, Y + 2, z, B.telarana)
				end
			end
			if u % 4 == 2 then
				local a, b
				if eje then
					a, b = { u, 7 }, { u, 9 }
				else
					a, b = { 7, u }, { 9, u }
				end
				for y = Y, Y + 1 do
					P(a[1], y, a[2], B.valla)
					P(b[1], y, b[2], B.valla)
				end
				for v = 7, 9 do
					P(eje and u or v, Y + 2, eje and v or u, B.tablones)
				end
				if hash3(bx + u, Y, bz, s + 9956) < 0.12 then
					P(eje and u or 8, Y + 1, eje and 8 or u, B.antorcha)
				end
			end
		end
	end
	if conX then
		pasillo(true)
	end
	if conZ then
		pasillo(false)
	end
	if (conX or conZ) and hash2(cx, cz, s + 9957) < 0.3 then
		local x, z = conX and 4 or 9, conX and 9 or 4
		P(x, Y, z, B.cofre)
		cofreReg(c, bx + x, Y, bz + z, "mina")
	end
end

------------------------------------------------------------------
-- Iglús, templos, brujas, puestos y naufragios (completo.js)
------------------------------------------------------------------
function E.esPuestoAvanzada(s, cx, cz)
	return hash2(cx, cz, s + 9940) < 0.004
end

local function estructurasCompletoBase(c)
	local datos, cx, cz, bx, bz, s, info = c.datos, c.cx, c.cz, c.bx, c.bz, c.s, c.info
	minaAbandonada(c)
	local centro = info[8 * CX + 8 + 1]
	local hC, bio = centro[1], centro[2]
	local function P(x, y, z, b)
		if x >= 0 and x < CX and z >= 0 and z < CZ and y > 0 and y < CY then
			wr(datos, idx(x, y, z), b)
		end
	end
	local function cofre(x, y, z, t)
		P(x, y, z, B.cofre)
		cofreReg(c, bx + x, y, bz + z, t)
	end
	local function plano()
		local mn, mx = 999, 0
		for z = 3, 12 do
			for x = 3, 12 do
				local h = info[z * CX + x + 1][1]
				mn = min(mn, h)
				mx = max(mx, h)
			end
		end
		return mx - mn <= 3
	end
	if bio == BIOMA.nevado and hash2(cx, cz, s + 9900) < 0.035 and hC > NIVEL_MAR and plano() then
		for x = 3, 12 do
			for z = 3, 12 do
				local dx, dz = x - 7.5, z - 7.5
				for y = hC - 2, hC do
					P(x, y, z, B.bloqueNieve)
				end
				for y = hC + 1, hC + 5 do
					local d = hypot(dx, dz, (y - hC - 0.5) * 1.1)
					if d <= 4.6 and d > 3.5 then
						P(x, y, z, B.bloqueNieve)
					elseif d <= 3.5 then
						P(x, y, z, 0)
					end
				end
			end
		end
		for y = hC + 1, hC + 2 do
			P(7, y, 3, 0)
			P(7, y, 4, 0)
		end
		P(9, hC + 1, 9, B.cama)
		P(5, hC + 1, 9, B.mesa)
		P(9, hC + 1, 6, B.horno)
		P(5, hC + 1, 6, B.antorcha)
		for x = 6, 9 do
			for z = 6, 9 do
				if rd(datos, idx(x, hC + 1, z)) == 0 then
					P(x, hC + 1, z, ALFOMBRA(0))
				end
			end
		end
		cofre(6, hC + 1, 10, "iglu")
	elseif bio == BIOMA.jungla and hash2(cx, cz, s + 9910) < 0.008 and hC > NIVEL_MAR then
		local function piedra(x, y, z)
			return hash3(bx + x, y, bz + z, s + 9911) < 0.4 and B.rocaMusgo or B.roca
		end
		for x = 2, 13 do
			for z = 1, 14 do
				for y = hC - 3, hC do
					P(x, y, z, piedra(x, y, z))
				end
				for y = hC + 1, hC + 7 do
					local nivel = y - hC
					local m = nivel > 4 and 2 or 0
					local borde = x == 2 + m or x == 13 - m or z == 1 + m or z == 14 - m
					if nivel > 7 then
						continue
					end
					if x < 2 + m or x > 13 - m or z < 1 + m or z > 14 - m then
						continue
					end
					P(x, y, z, (borde or y == hC + 4 or y == hC + 7) and piedra(x, y, z) or 0)
				end
			end
		end
		for y = hC + 1, hC + 3 do
			P(7, y, 1, 0)
			P(8, y, 1, 0)
		end
		for x = 4, 11, 7 do
			for y = hC + 1, hC + 3 do
				P(x, y, 7, B.ladrillosPiedra)
			end
		end
		cofre(4, hC + 1, 12, "templo")
		cofre(11, hC + 5, 10, "templo")
		for _, q in { { 5, 4 }, { 10, 4 } } do
			P(q[1], hC + 1, q[2], B.antorcha)
		end
		for z = 3, 11, 2 do
			P(7, hC + 1, z, B.escaleraRoca)
		end
	elseif (bio == BIOMA.pantano or bio == BIOMA.manglar) and hash2(cx, cz, s + 9920) < 0.018 then
		local base = max(hC, NIVEL_MAR) + 3
		for _, q in { { 5, 5 }, { 10, 5 }, { 5, 10 }, { 10, 10 } } do
			for y = min(hC, NIVEL_MAR) - 1, base - 1 do
				P(q[1], y, q[2], B.troncoAbeto)
			end
		end
		for x = 5, 10 do
			for z = 5, 10 do
				P(x, base, z, B.tablonesAbeto)
				local borde = x == 5 or x == 10 or z == 5 or z == 10
				for y = base + 1, base + 3 do
					P(x, y, z, borde and ((y == base + 2 and (x == 7 or z == 7)) and B.panel or B.tablonesAbeto) or 0)
				end
				P(x, base + 4, z, B.losaAbeto)
			end
		end
		for x = 4, 11 do
			P(x, base + 4, 4, B.losaAbeto)
			P(x, base + 4, 11, B.losaAbeto)
		end
		for y = base + 1, base + 2 do
			P(7, y, 5, 0)
		end
		P(9, base + 1, 9, B.mesa)
		P(6, base + 1, 9, B.champinonRojo)
		P(9, base + 1, 6, B.farol)
		cofre(6, base + 1, 6, "bruja")
	elseif (bio == BIOMA.llanura or bio == BIOMA.sabana or bio == BIOMA.taiga or bio == BIOMA.desierto) and E.esPuestoAvanzada(s, cx, cz) and plano() then
		local t = hC + 1
		for x = 5, 10 do
			for z = 5, 10 do
				local borde = x == 5 or x == 10 or z == 5 or z == 10
				local esq = (x == 5 or x == 10) and (z == 5 or z == 10)
				for y = hC - 2, hC do
					P(x, y, z, B.roca)
				end
				for y = t, t + 14 do
					if y == t + 5 or y == t + 10 then
						P(x, y, z, B.tablonesAbeto)
					elseif y == t + 14 then
						P(x, y, z, borde and B.valla or 0)
					elseif esq then
						P(x, y, z, B.troncoAbeto)
					elseif borde then
						P(x, y, z, ((y - t) % 5 == 2 and (x == 7 or z == 7)) and 0 or B.tablonesAbeto)
					else
						P(x, y, z, 0)
					end
				end
				P(x, t + 13, z, borde and B.tablonesAbeto or B.losaAbeto)
			end
		end
		for y = t, t + 12 do
			P(9, y, 6, 146)
		end
		P(7, t + 5, 7, 0)
		P(9, t + 5, 6, 146)
		P(9, t + 10, 6, 146)
		cofre(6, t + 11, 9, "puesto")
		P(8, t + 11, 8, B.farol)
		P(6, t + 1, 6, B.farol)
		for y = t, t + 2 do
			P(7, y, 5, 0)
		end
	elseif (bio == BIOMA.playa or esOceano(bio)) and hash2(cx, cz, s + 9930) < 0.012 and hC <= NIVEL_MAR + 1 and hC > NIVEL_MAR - 14 then
		local y0 = hC + 1
		local roto = hash2(cx, cz, s + 9931) < 0.5
		local madera = ({ B.tablones, B.tablonesAbeto, B.tablonesJungla })[floor(hash2(cx, cz, s + 9932) * 3) + 1]
		for x = 1, 14 do
			local f = min(x - 1, 14 - x)
			local ancho = min(3, 1 + floor(f / 1.5))
			for z = 8 - ancho, 8 + ancho do
				if roto and x > 10 and hash3(bx + x, 0, bz + z, s + 9933) < 0.6 then
					continue
				end
				P(x, y0, z, madera)
				local borde = z == 8 - ancho or z == 8 + ancho
				for y = y0 + 1, y0 + 2 do
					if borde and not (roto and hash3(bx + x, y, bz + z, s + 9934) < 0.3) then
						P(x, y, z, madera)
					elseif not borde then
						P(x, y, z, y <= NIVEL_MAR and B.agua or 0)
					end
				end
				if x >= 3 and x <= 12 and not borde then
					P(x, y0 + 3, z, x % 3 == 0 and 0 or madera)
				end
			end
		end
		for y = y0 + 1, y0 + 7 do
			P(7, y, 8, B.troncoAbeto)
		end
		cofre(3, y0 + 1, 8, "naufragio")
		cofre(11, y0 + 1, 8, "naufragio")
	end
end

------------------------------------------------------------------
-- Pirámides del desierto de 21 × 21 (v26.js)
------------------------------------------------------------------
function E.piramideEnRegion(gen, rx, rz)
	gen._pir = gen._pir or {}
	local k = rx .. "," .. rz
	local cache = gen._pir[k]
	if cache ~= nil then
		return cache or nil
	end
	local s = gen.semilla
	local res = false
	if hash2(rx, rz, s + 9810) < 0.5 then
		local x = rx * 256 + 30 + floor(hash2(rx, rz, s + 9811) * 190)
		local z = rz * 256 + 30 + floor(hash2(rx, rz, s + 9812) * 190)
		local ok, hs = true, {}
		for _, q in { { 10, 10 }, { 0, 0 }, { 20, 0 }, { 0, 20 }, { 20, 20 } } do
			local h, bio = gen:infoColumna(x + q[1], z + q[2])
			if bio ~= BIOMA.desierto then
				ok = false
			end
			table.insert(hs, h)
		end
		if ok and math.max(table.unpack(hs)) - math.min(table.unpack(hs)) <= 4 then
			res = { x = x, z = z, y = hs[1] }
		end
	end
	gen._pir[k] = res
	return res or nil
end
function E.piramidesCerca(gen, x, z)
	local rx, rz = floor(x / 256), floor(z / 256)
	local r = {}
	for a = -1, 1 do
		for b = -1, 1 do
			local p = E.piramideEnRegion(gen, rx + a, rz + b)
			if p then
				table.insert(r, p)
			end
		end
	end
	return r
end

local function bloquePiramide(dx, y, dz, h)
	local A, C = B.arenisca, BR.areniscaCortada or B.arenisca
	local N, Z = B.terracota0, HORMIGON(11)
	local R = h - 14
	local ry = y - h
	local torre = dz <= 4 and (dx <= 4 or dx >= 16)
	if torre then
		local tx = dx <= 4 and dx or dx - 16
		local borde = tx == 0 or tx == 4 or dz == 0 or dz == 4
		if ry < 0 and ry >= -4 then
			return A
		end
		if ry >= 0 and ry <= 12 then
			if ry == 12 then
				return (borde and (tx + dz) % 2 == 0) and (BR.losaArenisca or C) or (borde and 0 or C)
			end
			if not borde then
				return ry == 0 and A or 0
			end
			if dz == 0 and tx == 2 and ry >= 6 and ry <= 10 then
				return ry == 8 and Z or N
			end
			if dz == 0 and (tx == 1 or tx == 3) and ry == 8 then
				return N
			end
			if ry == 11 or ry == 5 then
				return C
			end
			if dz == 4 and tx == 2 and ry >= 1 and ry <= 2 then
				return 0
			end
			return A
		end
		return -1
	end
	if ry < 0 and ry >= -4 then
		return A
	end
	if ry >= 0 and ry <= 10 then
		local L = ry
		local dentro = dx >= L and dx <= 20 - L and dz >= L and dz <= 20 - L
		if not dentro then
			return -1
		end
		local borde = dx == L or dx == 20 - L or dz == L or dz == 20 - L
		if L == 0 then
			if dx == 10 and dz == 10 then
				return 0
			end
			local ax, az = abs(dx - 10), abs(dz - 10)
			if ax + az <= 1 then
				return Z
			end
			if (ax == 0 or az == 0) and ax + az <= 3 then
				return N
			end
			if ax == az and ax <= 2 then
				return N
			end
			return A
		end
		if borde then
			if dz == L and dx >= 9 and dx <= 11 and ry >= 1 and ry <= 3 then
				return 0
			end
			if dz == L and (dx == 8 or dx == 12) and ry <= 4 then
				return N
			end
			if dz == L and dx >= 8 and dx <= 12 and ry == 4 then
				return C
			end
			if (dx == L or dx == 20 - L) and dz >= 9 and dz <= 11 and ry >= 1 and ry <= 2 and L == 1 then
				return 0
			end
			return L % 3 == 2 and C or A
		end
		if ry <= 4 and (dx == 6 or dx == 14) and (dz == 6 or dz == 14) then
			return C
		end
		return 0
	end
	if y < h and y > R + 4 and dx == 10 and dz == 10 then
		return 0
	end
	if y >= R - 2 and y <= R + 4 and dx >= 6 and dx <= 14 and dz >= 6 and dz <= 14 then
		local borde = dx == 6 or dx == 14 or dz == 6 or dz == 14
		if y == R - 1 and dx >= 9 and dx <= 11 and dz >= 9 and dz <= 11 then
			return B.tnt
		end
		if y <= R or y == R + 4 then
			return y == R and (((abs(dx - 10) + abs(dz - 10)) % 3 == 0) and N or A) or A
		end
		if borde then
			return (y == R + 2 and (dx == 10 or dz == 10)) and N or C
		end
		if y == R + 1 and dx == 10 and dz == 10 then
			return B.placa
		end
		if y == R + 1 and ((dx == 10 and (dz == 7 or dz == 13)) or (dz == 10 and (dx == 7 or dx == 13))) then
			return B.cofre
		end
		return 0
	end
	return -1
end

local function construirPiramides(c)
	local bx, bz, d, s = c.bx, c.bz, c.datos, c.s
	for _, p in E.piramidesCerca(c.gen, bx + 8, bz + 8) do
		if p.x > bx + CX or p.x + 20 < bx or p.z > bz + CZ or p.z + 20 < bz then
			continue
		end
		for lx = 0, CX - 1 do
			for lz = 0, CZ - 1 do
				local dx, dz = bx + lx - p.x, bz + lz - p.z
				if dx < 0 or dx > 20 or dz < 0 or dz > 20 then
					continue
				end
				for y = p.y - 20, p.y + 13 do
					if y < 1 or y >= CY then
						continue
					end
					local b = bloquePiramide(dx, y, dz, p.y)
					if b < 0 then
						continue
					end
					wr(d, idx(lx, y, lz), b)
					if b == B.cofre then
						cofreReg(c, bx + lx, y, bz + lz, "piramide")
					end
				end
				if dx >= 3 and dx <= 17 and dz >= 6 and dz <= 17 and hash2(bx + lx, bz + lz, s + 9813) < 0.05 and rd(d, idx(lx, p.y, lz)) == B.arenisca then
					wr(d, idx(lx, p.y, lz), B.arenaSospechosa)
				end
			end
		end
	end
end

------------------------------------------------------------------
-- Estructuras pequeñas de estructuras27.js
------------------------------------------------------------------
local function estructuras27(c)
	local datos, cx, cz, bx, bz, info = c.datos, c.cx, c.cz, c.bx, c.bz, c.info
	local s = c.s + 27000
	local function P(x, y, z, b)
		if x >= 0 and x < CX and z >= 0 and z < CZ and y > 0 and y < CY then
			wr(datos, idx(x, y, z), b)
		end
	end
	local function G(x, y, z)
		if x >= 0 and x < CX and z >= 0 and z < CZ and y > 0 and y < CY then
			return rd(datos, idx(x, y, z))
		end
		return 0
	end
	local function cofre(x, y, z, t)
		P(x, y, z, B.cofre)
		cofreReg(c, bx + x, y, bz + z, t)
	end
	local centro = info[8 * CX + 8 + 1]
	local hC, bio = centro[1], centro[2]
	local r = mulberry32(floor(hash2(cx, cz, s) * 4294967296))
	-- Roca del bosque
	if (bio == BIOMA.taiga or bio == BIOMA.taigaNevada) and r() < 0.12 then
		local x0, z0 = 3 + floor(r() * 10), 3 + floor(r() * 10)
		local h = info[z0 * CX + x0 + 1][1]
		for dx = -2, 2 do
			for dz = -2, 2 do
				for dy = 0, 2 do
					if dx * dx + dz * dz + dy * dy * 1.4 <= 4.5 + r() then
						P(x0 + dx, h + dy, z0 + dz, r() < 0.75 and B.rocaMusgo or B.roca)
					end
				end
			end
		end
	end
	-- Geoda de amatista
	if hash2(cx, cz, s + 1) < 0.035 then
		local cy = OY + 14 + floor(hash2(cx, cz, s + 2) * 40)
		if cy < hC - 10 then
			local brotes = { B.racimoAmatista, B.broteAmatistaGrande, B.broteAmatistaMediano, B.broteAmatistaPequeno }
			for x = 2, 13 do
				for z = 2, 13 do
					for y = cy - 6, cy + 6 do
						local d = hypot(x - 7.5, (y - cy) * 1.1, z - 7.5) + (hash3(bx + x, y, bz + z, s + 3) - 0.5) * 0.6
						if d > 5.6 then
							continue
						end
						if d > 5 then
							P(x, y, z, B.basaltoLiso)
						elseif d > 4.2 then
							P(x, y, z, B.calcita)
						elseif d > 3.4 then
							P(x, y, z, hash3(bx + x, y, bz + z, s + 4) < 0.1 and B.amatistaBrotante or B.bloqueAmatista)
						else
							local h = hash3(bx + x, y, bz + z, s + 5)
							P(x, y, z, (d > 2.6 and h < 0.18) and brotes[floor(h * 22) % 4 + 1] or 0)
						end
					end
				end
			end
		end
	end
	-- Fósiles
	if (bio == BIOMA.desierto or bio == BIOMA.pantano) and hash2(cx, cz, s + 6) < 0.03 then
		local y0 = hC - 10 - floor(r() * 8)
		local eje = r() < 0.5
		local largo = 6 + floor(r() * 4)
		for k = 0, largo - 1 do
			local x, z = eje and 4 + k or 8, eje and 8 or 4 + k
			P(x, y0, z, B.bloqueHueso)
			if k % 2 == 0 then
				for a = 1, 3 do
					local ox, oz = eje and 0 or a, eje and a or 0
					P(x + ox, y0 + min(a, 2), z + oz, B.bloqueHueso)
					P(x - ox, y0 + min(a, 2), z - oz, B.bloqueHueso)
				end
			end
			if r() < 0.12 then
				P(x, y0 - 1, z, B.menaCarbon)
			end
		end
	end
	-- Tesoro enterrado
	if bio == BIOMA.playa and hash2(cx, cz, s + 7) < 0.05 then
		local x, z = 4 + floor(r() * 8), 4 + floor(r() * 8)
		local h = info[z * CX + x + 1][1]
		for y = h - 3, h do
			if G(x, y, z) ~= 0 then
				P(x, y, z, B.arena)
			end
		end
		cofre(x, h - 2, z, "tesoroEnterrado")
	end
	-- Ruinas oceánicas
	if esOceano(bio) and hash2(cx, cz, s + 8) < 0.04 then
		local calida = bio == BIOMA.oceanoCalido
		local x0, z0 = 3, 3
		local w = 5 + floor(r() * 4)
		local p = 5 + floor(r() * 4)
		local fondo = hC
		while fondo > 2 and (esAgua(G(8, fondo, 8)) or G(8, fondo, 8) == 0) do
			fondo -= 1
		end
		local AC = BR.areniscaCortada or B.arenisca
		local LA = BR.ladrillosAgrietados or B.rocaMusgo
		local function mat()
			if calida then
				return r() < 0.7 and B.arenisca or AC
			end
			if r() < 0.5 then
				return B.ladrillosPiedra
			end
			return r() < 0.5 and B.ladrillosMusgo or LA
		end
		for x = x0, x0 + w - 1 do
			for z = z0, z0 + p - 1 do
				P(x, fondo, z, mat())
				local borde = x == x0 or x == x0 + w - 1 or z == z0 or z == z0 + p - 1
				if borde then
					for y = fondo + 1, fondo + 3 do
						if r() < 0.62 - (y - fondo) * 0.12 then
							P(x, y, z, mat())
						end
					end
				end
			end
		end
		if r() < 0.7 then
			cofre(x0 + 1, fondo + 1, z0 + 1, "ruinasOceano")
		end
		local CORALES = { "tubo", "cerebro", "burbuja", "fuego", "cuerno" }
		for k = 0, 5 do
			local x, z = floor(r() * 16), floor(r() * 16)
			local y = hC
			while y > 2 and (esAgua(G(x, y, z)) or G(x, y, z) == 0) do
				y -= 1
			end
			if esAgua(G(x, y + 1, z)) then
				P(x, y + 1, z, calida and BR["coral_" .. CORALES[k % 5 + 1]] or B.alga)
			end
		end
	end
	-- Sótano del iglú
	if bio == BIOMA.nevado and hash2(cx, cz, c.s + 9900) < 0.035 and hC > NIVEL_MAR and hash2(cx, cz, s + 9) < 0.5 and G(9, hC + 1, 9) == B.cama then
		local fondo = hC - 9
		for y = fondo + 1, hC do
			P(7, y, 7, 0)
			P(7, y, 6, B.piedra)
			P(8, y, 7, B.escaleraMano + 2)
		end
		for x = 3, 12 do
			for z = 3, 12 do
				for y = fondo - 4, fondo do
					local borde = x == 3 or x == 12 or z == 3 or z == 12 or y == fondo - 4 or y == fondo
					P(x, y, z, borde and (r() < 0.3 and B.rocaMusgo or B.ladrillosPiedra) or 0)
				end
			end
		end
		P(7, fondo, 7, 0)
		P(5, fondo - 3, 5, B.soporte)
		cofre(9, fondo - 3, 5, "igluSotano")
		P(6, fondo - 3, 9, B.antorcha)
		P(10, fondo - 3, 9, B.antorcha)
		for _, x0 in { 4, 9 } do
			for x = x0, x0 + 2 do
				for y = fondo - 3, fondo - 1 do
					P(x, y, 11, B.valla)
				end
			end
		end
	end
end

------------------------------------------------------------------
-- Mansiones del bosque (estructuras27.js)
------------------------------------------------------------------
local MANS_W, MANS_P = 32, 24
function E.mansionEn(gen, rx, rz)
	local s = gen.semilla + 27500
	if hash2(rx, rz, s) > 0.5 then
		return nil
	end
	local x = rx * 480 + 80 + floor(hash2(rx, rz, s + 1) * 320)
	local z = rz * 480 + 80 + floor(hash2(rx, rz, s + 2) * 320)
	gen._mans = gen._mans or {}
	local k = rx .. "," .. rz
	local cache = gen._mans[k]
	if cache == nil then
		local h, bio = gen:infoColumna(x + 16, z + 12)
		cache = (bio == BIOMA.bosqueOscuro and h > NIVEL_MAR) and { x = x, z = z, y = h + 1 } or false
		gen._mans[k] = cache
	end
	return cache or nil
end
function E.mansionesCerca(gen, x, z)
	local rx, rz = floor(x / 480), floor(z / 480)
	local res = {}
	for a = -1, 1 do
		for b = -1, 1 do
			local m = E.mansionEn(gen, rx + a, rz + b)
			if m then
				table.insert(res, m)
			end
		end
	end
	return res
end

local function bloqueMansion(lx, y, lz, M, cofres, s)
	local y0 = M.y
	local rel = y - y0
	if rel < 0 then
		return y >= y0 - 4 and B.roca or -1
	end
	local piso = floor(rel / 6)
	local ry = rel % 6
	if piso >= 3 then
		local L = rel - 18
		if L > 6 then
			return -1
		end
		local bordeX = min(lx, MANS_W - 1 - lx)
		local bordeZ = min(lz, MANS_P - 1 - lz)
		local m = min(bordeX, bordeZ)
		if m < L then
			return -1
		end
		if m == L or L == 6 then
			return B.tablonesRobleOscuro
		end
		return 0
	end
	local perim = lx == 0 or lx == MANS_W - 1 or lz == 0 or lz == MANS_P - 1
	if ry == 0 then
		return piso == 0 and B.roca or B.tablonesRobleOscuro
	end
	if perim then
		local esquina = (lx % 6 == 0 or lx == MANS_W - 1) and (lz % 6 == 0 or lz == MANS_P - 1)
		if esquina then
			return B.troncoRobleOscuro
		end
		if piso == 0 and lz == 0 and (lx == 15 or lx == 16) and ry <= 3 then
			return 0
		end
		if (ry == 2 or ry == 3) and (lx % 6 == 3 or lz % 6 == 3) then
			return B.panel
		end
		return piso == 0 and B.roca or B.tablonesRobleOscuro
	end
	if (lx == 10 or lx == 21) and not (lz % 8 == 4 and ry <= 2) then
		return B.tablonesRobleOscuro
	end
	if lz == 12 and not (lx % 10 == 5 and ry <= 2) then
		return B.tablonesRobleOscuro
	end
	if ry == 1 then
		if piso == 1 and lx > 10 and lx < 21 then
			return ALFOMBRA(14)
		end
		if piso == 2 and lz < 12 and lx < 10 and (lx + lz) % 7 == 0 then
			return B.estanteria
		end
		local h = hash3(M.x + lx, y, M.z + lz, s + 27501)
		if h < 0.012 then
			table.insert(cofres, { lx, y, lz })
			return B.cofre
		end
		if h < 0.03 then
			return B.antorcha
		end
	end
	return 0
end

local function estampaMansiones(c)
	local bx, bz, d = c.bx, c.bz, c.datos
	for _, M in E.mansionesCerca(c.gen, bx + 8, bz + 8) do
		if bx + CX <= M.x or bx >= M.x + MANS_W or bz + CZ <= M.z or bz >= M.z + MANS_P then
			continue
		end
		local cofresM = {}
		for x = max(bx, M.x), min(bx + CX, M.x + MANS_W) - 1 do
			for z = max(bz, M.z), min(bz + CZ, M.z + MANS_P) - 1 do
				local y = M.y - 4
				while y <= M.y + 25 and y < CY do
					local b = bloqueMansion(x - M.x, y, z - M.z, M, cofresM, c.s)
					if b >= 0 then
						wr(d, idx(x - bx, y, z - bz), b)
					end
					y += 1
				end
			end
		end
		for _, q in cofresM do
			cofreReg(c, M.x + q[1], q[2], M.z + q[3], "mansion")
		end
	end
end

------------------------------------------------------------------
-- Decoración de biomas y cuevas (biomas27.js)
------------------------------------------------------------------
local function decorarBiomas(c)
	local datos, bx, bz = c.datos, c.bx, c.bz
	local s = c.s + 31000
	local function G(x, y, z)
		return rd(datos, idx(x, y, z))
	end
	local function P(x, y, z, b)
		if b and x >= 0 and x < CX and z >= 0 and z < CZ and y > 0 and y < CY then
			wr(datos, idx(x, y, z), b)
		end
	end
	local function cima(x, z)
		for y = CY - 2, 2, -1 do
			local b = G(x, y, z)
			if b ~= 0 and not esHojas(b) and not esLiquido(b) and BL[b].forma ~= "cruz" and not esTronco(b) then
				return y
			end
		end
		return 0
	end
	local FLORES = {}
	for _, k in { "florAmarilla", "florRoja", "aciano", "margarita", "orquidea", "floresSilvestres", "girasol" } do
		if BR[k] then
			table.insert(FLORES, BR[k])
		end
	end
	local agujas = {}
	for _, col in { "naranja", "amarillo", "blanco", "marron", "rojo", "grisClaro" } do
		if BR["terracota_" .. col] then
			table.insert(agujas, BR["terracota_" .. col])
		end
	end
	local CORALES = { "tubo", "cerebro", "burbuja", "fuego", "cuerno" }
	for z = 0, CZ - 1 do
		for x = 0, CX - 1 do
			local bio = buffer.readu8(c.bioma, z * CX + x)
			local wx, wz = bx + x, bz + z
			local r, r2 = hash2(wx, wz, s), hash2(wx, wz, s + 1)
			local y = cima(x, z)
			if y == 0 then
				continue
			end
			local sup = G(x, y, z)
			local libre = G(x, y + 1, z) == 0
			if bio == BIOMA.champinones and sup == B.micelio and libre and r < 0.05 then
				P(x, y + 1, z, r2 < 0.5 and B.champinonRojo or B.champinonMarron)
			elseif bio == BIOMA.bosqueFlores and sup == B.cesped and libre and r < 0.3 then
				P(x, y + 1, z, FLORES[floor(r2 * #FLORES) + 1])
			elseif bio == BIOMA.llanuraGirasoles and sup == B.cesped and libre and r < 0.09 then
				P(x, y + 1, z, B.girasol)
			elseif bio == BIOMA.junglaBambu and (sup == B.cesped or sup == B.podzol) and libre and r < 0.16 then
				local h = 4 + floor(r2 * 10)
				local k = 1
				while k <= h and G(x, y + k, z) == 0 do
					P(x, y + k, z, B.bambu)
					k += 1
				end
			elseif bio == BIOMA.espigasHielo and r < 0.004 and x > 1 and x < 14 and z > 1 and z < 14 then
				local alto = 8 + floor(r2 * 22)
				local grosor = r2 > 0.7 and 2 or 1
				for k = 0, alto - 1 do
					local g = k < alto * 0.3 and grosor or k < alto * 0.7 and min(1, grosor) or 0
					for a = -g, g do
						for b = -g, g do
							if abs(a) + abs(b) <= g then
								P(x + a, y + 1 + k, z + b, B.hieloCompacto)
							end
						end
					end
				end
			elseif bio == BIOMA.badlandsErosionados and r < 0.006 and x > 0 and x < 15 and z > 0 and z < 15 then
				local alto = 10 + floor(r2 * 20)
				for k = 1, alto do
					local b = agujas[floor((y + k) / 2) % #agujas + 1] or B.terracota
					P(x, y + k, z, b)
					if k < alto * 0.5 then
						P(x + 1, y + k, z, b)
						P(x, y + k, z + 1, b)
					end
				end
			elseif bio == BIOMA.taigaGigante and sup == B.podzol and libre and r < 0.03 then
				P(x, y + 1, z, BR.helecho or B.hierbaAlta)
			end
			-- Océanos
			if esOceano(bio) and esAgua(G(x, y + 1, z)) and G(x, y + 2, z) ~= 0 and esAgua(G(x, y + 2, z)) then
				if bio == BIOMA.oceanoCalido then
					local rv = fbm(wx * 0.08, wz * 0.08, s + 5, 2)
					if rv > 0.52 then
						local k = floor(hash2(wx // 4, wz // 4, s + 6) * 5)
						local t = CORALES[k + 1]
						P(x, y, z, BR["bloqueCoral_" .. t])
						if r < 0.35 then
							P(x, y + 1, z, r2 < 0.5 and BR["coral_" .. t] or BR["abanicoCoral_" .. t])
						elseif r < 0.4 then
							P(x, y + 1, z, B.pepinoMar)
						end
						if r > 0.9 and esAgua(G(x, y + 2, z)) then
							P(x, y + 1, z, BR["bloqueCoral_" .. t])
							if esAgua(G(x, y + 3, z)) then
								P(x, y + 2, z, BR["coral_" .. t])
							end
						end
					elseif r < 0.2 then
						P(x, y + 1, z, B.pastoMarino)
					end
				elseif bio ~= BIOMA.oceanoHelado or r > 0.5 then
					if r < 0.06 then
						local prof = NIVEL_MAR - y
						local alto = max(1, floor(prof * (0.4 + r2 * 0.5)))
						local k = 1
						while k <= alto and esAgua(G(x, y + k, z)) do
							P(x, y + k, z, B.alga)
							k += 1
						end
					elseif r < 0.22 then
						P(x, y + 1, z, B.pastoMarino)
					end
				end
			end
		end
	end
	-- Cuevas frondosas y de espeleotemas
	local nc = fbm((bx + 8) * 0.006, (bz + 8) * 0.006, s + 7, 2)
	local tipo = nc > 0.63 and "frondosa" or nc < 0.35 and "espeleotema" or nil
	if not tipo then
		return
	end
	local PI, PZ, AN, DI, GR, TO = B.piedra, B.pizarra, B.andesita, B.diorita, B.granito, B.toba
	local function piedra(q)
		return q == PI or q == PZ or q == AN or q == DI or q == GR or q == TO
	end
	for z = 0, CZ - 1 do
		for x = 0, CX - 1 do
			local wx, wz = bx + x, bz + z
			local techo = cima(x, z) - 8
			for y = 4, techo - 1 do
				local b = G(x, y, z)
				if b ~= 0 then
					continue
				end
				local abajo, arriba = G(x, y - 1, z), G(x, y + 1, z)
				local h = hash3(wx, y, wz, s + 8)
				if tipo == "frondosa" then
					if piedra(abajo) then
						P(x, y - 1, z, h < 0.12 and B.arcilla or B.bloqueMusgo)
						if h > 0.93 then
							P(x, y, z, h > 0.985 and B.azaleaFlorida or B.azalea)
						elseif h > 0.8 then
							P(x, y, z, B.alfombraMusgo)
						end
					elseif piedra(arriba) then
						if h < 0.5 then
							P(x, y + 1, z, B.bloqueMusgo)
						end
						if h > 0.97 then
							P(x, y, z, B.floresEsporas)
						elseif h > 0.86 then
							P(x, y, z, B.raicesColgantes)
						end
					end
				else
					if piedra(abajo) then
						if h < 0.45 then
							P(x, y - 1, z, B.bloqueEspeleotema)
						end
						if h > 0.9 then
							P(x, y, z, B.espeleotema)
						end
					elseif piedra(arriba) then
						if h < 0.45 then
							P(x, y + 1, z, B.bloqueEspeleotema)
						end
						if h > 0.88 then
							P(x, y, z, B.espeleotema)
						end
					end
				end
			end
		end
	end
end

------------------------------------------------------------------
-- Desgaste (estructuras28.js)
------------------------------------------------------------------
function E.desgastar(datos, cx, cz, semilla, sub)
	local s = semilla + 28000
	local bx, bz = cx * CX, cz * CZ
	local LP, LM, LA, R, RM, TEL, LN = B.ladrillosPiedra, B.ladrillosMusgo, BR.ladrillosAgrietados, B.roca, B.rocaMusgo, BR.telarana, B.ladrilloNether
	local LNA = BR.ladrillosNetherAgrietados
	local TA, VA = B.tablones, B.valla
	local bajo = NIVEL_MAR - 6
	for y = 1, CY - 2 do
		for z = 0, CZ - 1 do
			for x = 0, CX - 1 do
				local i = idx(x, y, z)
				local b = rd(datos, i)
				if b == 0 then
					continue
				end
				local h = hash3(bx + x, y, bz + z, s)
				if b == LP then
					if h < 0.14 then
						wr(datos, i, LM)
					elseif h < 0.24 and LA then
						wr(datos, i, LA)
					end
				elseif b == R and sub and y < bajo then
					if h < 0.18 then
						wr(datos, i, RM)
					end
				elseif b == LN and LNA and h < 0.08 then
					wr(datos, i, LNA)
				end
				if sub and TEL and y < bajo and (b == TA or b == VA) and h > 0.965 then
					local a = idx(x, y - 1, z)
					if y > 1 and rd(datos, a) == 0 then
						wr(datos, a, TEL)
					end
				end
			end
		end
	end
end

------------------------------------------------------------------
-- generarV120 y la cadena completa
------------------------------------------------------------------
local function generarV120(c)
	local datos, cx, cz, bx, bz, s, info = c.datos, c.cx, c.cz, c.bx, c.bz, c.s, c.info
	if not ROCA_SCULK then
		ROCA_SCULK = { [B.pizarra] = true, [B.piedra] = true, [B.granito] = true, [B.diorita] = true, [B.andesita] = true, [B.grava] = true, [B.tierra] = true }
	end
	local hay = false
	local mask = table.create(256, false)
	for z = 0, CZ - 1 do
		for x = 0, CX - 1 do
			if esDeepDark(s, bx + x, bz + z) then
				mask[z * CX + x + 1] = true
				hay = true
			end
		end
	end
	if hay then
		local r = mulberry32(floor(hash2(cx, cz, s + 8801) * 4294967296))
		for z = 0, CZ - 1 do
			for x = 0, CX - 1 do
				if not mask[z * CX + x + 1] then
					continue
				end
				local wx, wz = bx + x, bz + z
				for y = 6, OY - 3 do
					local i = idx(x, y, z)
					if not ROCA_SCULK[rd(datos, i)] then
						continue
					end
					local arriba, abajo = rd(datos, idx(x, y + 1, z)), rd(datos, idx(x, y - 1, z))
					local v = valueNoise3(wx / 7, y / 7, wz / 7, s + 8802)
					if arriba == 0 then
						if v > 0.42 then
							wr(datos, i, B.sculk)
							local p = r()
							if p < 0.012 then
								wr(datos, idx(x, y + 1, z), B.sensorSculk)
							elseif p < 0.0155 then
								wr(datos, idx(x, y + 1, z), B.chillador)
							elseif p < 0.017 then
								wr(datos, i, B.catalizador)
							end
						elseif v > 0.35 then
							wr(datos, idx(x, y + 1, z), B.vetaSculk)
						end
					elseif abajo == 0 and v > 0.5 then
						wr(datos, i, B.sculk)
					end
				end
			end
		end
	end
	construirCiudadesAntiguas(c)
	construirCamarasPrueba(c)
	construirMonumentos(c)
	local centro = info[8 * CX + 8 + 1]
	local hC = centro[1]
	local pozo = centro[2] == BIOMA.desierto and hash2(cx, cz, s + 960) < 0.01
	if pozo then
		for _, q in { { 7, 7 }, { 9, 9 }, { 7, 9 }, { 9, 7 } } do
			if hash2(bx + q[1], bz + q[2], s + 961) < 0.6 then
				wr(datos, idx(q[1], hC - 1, q[2]), B.arenaSospechosa)
			end
		end
	end
	-- (La pirámide pequeña la sustituye la de 21×21 de v26.js)
	local b = centro[2]
	if (b == BIOMA.taiga or b == BIOMA.jungla or b == BIOMA.bosque or b == BIOMA.abedul or b == BIOMA.cerezo or b == BIOMA.bosqueOscuro or b == BIOMA.taigaNevada)
		and hash2(cx, cz, s + 9700) < 0.007 and hC > NIVEL_MAR + 1 then
		ruinasSendero(c, hC)
	end
	-- estructurasCompleto con sus añadidos (v26.js y estructuras27.js)
	estructurasCompletoBase(c)
	construirPiramides(c)
	estructuras27(c)
	estampaMansiones(c)
end

-- Todo lo que el juego web añade después del terreno de la Superficie
function E.superficie(gen, datos, cx, cz, info, biomasCh)
	local c = {
		gen = gen, s = gen.semilla, datos = datos, cx = cx, cz = cz, bx = cx * CX, bz = cz * CZ,
		info = info, bioma = biomasCh, cofres = {},
	}
	estructurasSuperficie(c)
	generarV120(c)
	decorarBiomas(c)
	E.desgastar(datos, cx, cz, gen.semilla, true)
	return c.cofres
end

return E
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Fisica</string><ProtectedString name="Source"><![CDATA[--!native
--[[
	Blockverse para Roblox · Física de entidades
	Igual que choca/moverEje/pasoFisico de jugador.js: cajas que chocan
	contra los bloques (con escaleras, losas, vallas…), suben escalones
	bajos y detectan el suelo. La usan las criaturas, los objetos tirados
	y las flechas. Unidades: bloques (pos = pies de la entidad).
]]
local Registro = require(script.Parent:WaitForChild("Registro"))

local BL = Registro.bloques
local SOLIDO, FORMA = Registro.SOLIDO, Registro.FORMA

local Fisica = {}

local CUBO = { { 0, 0, 0, 1, 1, 1 } }
local cacheCajas = {}
local function cajasColision(b)
	local c = cacheCajas[b]
	if c then
		return c
	end
	local def = BL[b]
	local f = FORMA[b]
	if f == 6 then
		c = def.cajas or CUBO
	elseif f == 7 then
		c = { { 0, 0, 0, 1, def.colAlta or 1, 1 } }
	elseif f == 1 then
		c = { { 0, 0, 0, 1, def.altura or 0.5, 1 } }
	else
		c = CUBO
	end
	cacheCajas[b] = c
	return c
end
Fisica.cajasColision = cajasColision

-- ¿La caja de la entidad en p (ancho = medio ancho, alto) choca con algo? Devuelve la caja del bloque.
function Fisica.choca(md, px, py, pz, a, h)
	local x0, x1 = math.floor(px - a), math.floor(px + a)
	local y0, y1 = math.floor(py), math.floor(py + h)
	local z0, z1 = math.floor(pz - a), math.floor(pz + a)
	for x = x0, x1 do
		for y = y0, y1 do
			for z = z0, z1 do
				local b = md:get(x, y, z)
				if b ~= 0 and SOLIDO[b] then
					for _, c in cajasColision(b) do
						local X0, Y0, Z0, X1, Y1, Z1 = x + c[1], y + c[2], z + c[3], x + c[4], y + c[5], z + c[6]
						if px - a < X1 - 1e-7 and px + a > X0 + 1e-7 and pz - a < Z1 - 1e-7 and pz + a > Z0 + 1e-7 and py < Y1 - 1e-7 and py + h > Y0 + 1e-7 then
							return X0, Y0, Z0, X1, Y1, Z1
						end
					end
				end
			end
		end
	end
	return nil
end
local choca = Fisica.choca

-- e = {x, y, z, vx, vy, vz, ancho, alto, suelo, subir}
local function moverEje(md, e, eje, d)
	if eje == 1 then
		e.x += d
	elseif eje == 2 then
		e.y += d
	else
		e.z += d
	end
	local hubo = false
	for _ = 1, 6 do
		local X0, Y0, Z0, X1, Y1, Z1 = choca(md, e.x, e.y, e.z, e.ancho, e.alto)
		if not X0 then
			return hubo
		end
		-- Subir escalones bajos (losas, escaleras, caminos)
		if eje ~= 2 and e.suelo and e.subir then
			local sub = Y1 - e.y
			if sub > 0 and sub <= 0.6 then
				local py = e.y
				e.y += sub + 1e-4
				if not choca(md, e.x, e.y, e.z, e.ancho, e.alto) then
					return hubo
				end
				e.y = py
			end
		end
		hubo = true
		if eje == 2 then
			e.y = d > 0 and Y0 - e.alto - 1e-4 or Y1 + 1e-4
		elseif eje == 1 then
			e.x = d > 0 and X0 - e.ancho - 1e-4 or X1 + e.ancho + 1e-4
		else
			e.z = d > 0 and Z0 - e.ancho - 1e-4 or Z1 + e.ancho + 1e-4
		end
	end
	return hubo
end

function Fisica.paso(md, e, dt)
	local pasos = math.ceil(math.max(math.abs(e.vx), math.abs(e.vy), math.abs(e.vz)) * dt / 0.25)
	if pasos < 1 then
		pasos = 1
	end
	local h = dt / pasos
	local suelo = false
	e.chocoH = false
	for _ = 1, pasos do
		if moverEje(md, e, 1, e.vx * h) then
			e.chocoH = true
			e.vx = 0
		end
		if moverEje(md, e, 3, e.vz * h) then
			e.chocoH = true
			e.vz = 0
		end
		local vy = e.vy
		if moverEje(md, e, 2, vy * h) then
			if vy < 0 then
				suelo = true
			end
			e.vy = 0
		end
	end
	e.suelo = suelo or (not e.vuela and e.vy <= 0 and choca(md, e.x, e.y - 0.02, e.z, e.ancho, e.alto) ~= nil)
end

return Fisica
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">Generador</string><ProtectedString name="Source"><![CDATA[--!native
--!optimize 2
--[[
	Blockverse para Roblox · Generador del mundo
	Traducción a Luau de mundo.js del juego web: infoColumna (alturas,
	32 biomas, ríos, islas de champiñones), cuevas, vetas de mineral,
	los 13 tipos de árbol, lagos y la vegetación. Con la misma semilla
	sale el mismo terreno que en la versión web.
	Datos de un chunk: buffer de 16 × 16 × 192 enteros de 16 bits,
	índice = x + z * 16 + y * 256 (igual que en el juego web).
]]
local Registro = require(script.Parent.Registro)
local Ruido = require(script.Parent.Ruido)
local Biomas = require(script.Parent.Datos.Biomas)
local Estructuras = require(script.Parent.Estructuras)
local Dimensiones = require(script.Parent.Dimensiones)
local Arenas = require(script.Parent.Arenas)

local hash2, hash3, mulberry32 = Ruido.hash2, Ruido.hash3, Ruido.mulberry32
local valueNoise, valueNoise3, fbm, smooth = Ruido.valueNoise, Ruido.valueNoise3, Ruido.fbm, Ruido.smooth
local clamp, lerp, redondear = Ruido.clamp, Ruido.lerp, Ruido.redondear
local floor, ceil, abs, sqrt, sin, cos, pi = math.floor, math.ceil, math.abs, math.sqrt, math.sin, math.cos, math.pi

local CO = Biomas.constantes
local CX, CZ, CY, OY, NIVEL_MAR = CO.CX, CO.CZ, CO.CY, CO.OY, CO.NIVEL_MAR
local BIOMA = Biomas.claves
local B = setmetatable({}, {
	__index = function(_, k)
		local v = Registro.B[k]
		if v == nil then
			error("Generador: falta el bloque " .. tostring(k))
		end
		return v
	end,
})
local SOLIDO, OPACO, REEMPL = Registro.SOLIDO, Registro.OPACO, Registro.REEMPL
local esHojas, esTronco, esAgua = Registro.esHojas, Registro.esTronco, Registro.esAgua
local DIRF = Registro.DIRF

local Generador = {}
Generador.__index = Generador
Generador.CX, Generador.CZ, Generador.CY, Generador.OY, Generador.NIVEL_MAR = CX, CZ, CY, OY, NIVEL_MAR
Generador.BIOMA = BIOMA

local function idx(x, y, z)
	return x + z * CX + y * CX * CZ
end
Generador.idx = idx
local function rd(d, i)
	return buffer.readu16(d, i * 2)
end
local function wr(d, i, v)
	buffer.writeu16(d, i * 2, v)
end
Generador.leer, Generador.escribir = rd, wr

local function esOceano(b)
	return b == 0 or b == 21 or b == 22 or b == 29
end
local function esBiomaFrio(b)
	return b == 5 or b == 18 or b == 20 or b == 22 or b == 25
end
local function esBadlands(b)
	return b == 12 or b == 27
end
Generador.esOceano, Generador.esBiomaFrio, Generador.esBadlands = esOceano, esBiomaFrio, esBadlands

function Generador.new(semilla)
	local self = setmetatable({}, Generador)
	self.semilla = semilla
	-- Rejillas de cuevas (como _rejA y _rejV)
	self.GR = 4
	self.GNY = CY // 4 + 1
	self.rejA = table.create(25 * self.GNY, 0)
	self.rejV = table.create(25 * self.GNY, 0)
	return self
end

------------------------------------------------------------------
-- infoColumna
------------------------------------------------------------------
local function ssC(a, b, v)
	return smooth(clamp((v - a) / (b - a), 0, 1))
end

function Generador:infoColumna(x, z)
	local s = self.semilla
	local c = fbm(x * 0.0022, z * 0.0022, s, 4)
	local colinas = fbm(x * 0.012, z * 0.012, s + 50, 4)
	local montes = clamp((fbm(x * 0.005, z * 0.005, s + 90, 3) - 0.52) * 3.2, 0, 1)
	local temp = fbm(x * 0.0014, z * 0.0014, s + 500, 3) + (valueNoise(x * 0.05, z * 0.05, s + 510) - 0.5) * 0.03
	local hum = fbm(x * 0.0014, z * 0.0014, s + 600, 3) + (valueNoise(x * 0.05, z * 0.05, s + 610) - 0.5) * 0.03
	local rara = fbm(x * 0.003, z * 0.003, s + 1700, 2)
	local h
	if c < 0.43 then
		h = NIVEL_MAR - 1 - (0.43 - c) * 150 + (colinas - 0.5) * 6 * clamp((0.43 - c) / 0.02, 0, 1)
	else
		local k = smooth(clamp((c - 0.43) / 0.05, 0, 1))
		h = NIVEL_MAR - 1 + (c - 0.43) * 55 + ((colinas - 0.5) * 12 + 7) * k + montes * montes * 70 * k
	end
	local bioma
	local tierra = h >= NIVEL_MAR - 1
	local isla = fbm(x * 0.0028, z * 0.0028, s + 2100, 2)
	local kIsla = tierra and 0 or ssC(0.3, 0.32, c) * ssC(0.35, 0.37, temp) * (1 - ssC(0.62, 0.64, temp)) * ssC(0.715, 0.745, isla)
	if kIsla > 0 then
		h = lerp(h, NIVEL_MAR + 1 + math.min(7, math.max(0, isla - 0.73) * 120), kIsla)
	end
	if kIsla > 0 and h >= NIVEL_MAR - 0.5 then
		bioma = BIOMA.champinones
	elseif not tierra then
		bioma = temp < 0.33 and BIOMA.oceanoHelado or temp > 0.64 and BIOMA.oceanoCalido or c < 0.33 and BIOMA.oceanoProfundo or BIOMA.oceano
	elseif c < 0.452 and montes < 0.3 and h < NIVEL_MAR + 3.5 then
		bioma = temp < 0.33 and BIOMA.nevado or BIOMA.playa
	elseif montes > 0.45 and h > 150 then
		bioma = temp < 0.45 and BIOMA.picosNevados or (temp > 0.58 and h > 162) and BIOMA.picosPiedra or BIOMA.montana
	elseif temp < 0.33 then
		bioma = hum > 0.5 and BIOMA.taigaNevada or rara > 0.63 and BIOMA.espigasHielo or BIOMA.nevado
	elseif temp < 0.405 then
		bioma = (montes > 0.28 and h > NIVEL_MAR + 24 and hum < 0.46) and BIOMA.prado or (hum > 0.47 and rara > 0.52) and BIOMA.taigaGigante or BIOMA.taiga
	elseif temp < 0.6 then
		if montes > 0.18 and hum < 0.5 and h > NIVEL_MAR + 12 and rara < 0.47 then
			bioma = BIOMA.cerezo
		elseif montes > 0.22 and h > NIVEL_MAR + 20 and rara > 0.53 then
			bioma = BIOMA.prado
		elseif hum > 0.67 then
			bioma = BIOMA.pantano
		elseif hum > 0.55 then
			bioma = (rara > 0.64 and montes < 0.15) and BIOMA.jardinPalido or rara > 0.49 and BIOMA.bosqueOscuro or BIOMA.bosque
		elseif hum > 0.48 then
			bioma = rara < 0.36 and BIOMA.bosqueFlores or BIOMA.bosque
		elseif hum > 0.44 then
			bioma = BIOMA.abedul
		else
			bioma = rara > 0.62 and BIOMA.llanuraGirasoles or BIOMA.llanura
		end
	elseif temp < 0.67 then
		if hum > 0.64 and montes < 0.1 then
			bioma = BIOMA.manglar
		elseif hum > 0.55 then
			bioma = rara < 0.38 and BIOMA.junglaBambu or BIOMA.jungla
		else
			bioma = BIOMA.sabana
		end
	else
		if hum > 0.6 then
			bioma = BIOMA.jungla
		elseif rara > 0.6 or (montes > 0.2 and rara > 0.5) then
			bioma = rara > 0.68 and BIOMA.badlandsErosionados or BIOMA.badlands
		else
			bioma = BIOMA.desierto
		end
	end
	if tierra then
		local sinMonte = 1 - ssC(0.3, 0.45, montes)
		local templada = ssC(0.405, 0.425, temp) * (1 - ssC(0.58, 0.6, temp))
		local calida = ssC(0.6, 0.62, temp) * (1 - ssC(0.65, 0.67, temp))
		local arida = ssC(0.67, 0.69, temp)
		local fP = ssC(0.655, 0.69, hum) * templada * sinMonte
		local fM = ssC(0.625, 0.66, hum) * calida * (1 - ssC(0.07, 0.1, montes)) * sinMonte
		local seco = (1 - ssC(0.57, 0.6, hum)) * arida
		local fB = seco * math.max(ssC(0.58, 0.62, rara), ssC(0.48, 0.52, rara) * ssC(0.18, 0.22, montes)) * (1 - ssC(0.4, 0.5, montes))
		local fD = seco * (1 - fB) * sinMonte
		if fP > 0 then
			h = lerp(h, NIVEL_MAR + (h - NIVEL_MAR) * 0.22 - 0.4, fP)
		end
		if fM > 0 then
			h = lerp(h, NIVEL_MAR + (h - NIVEL_MAR) * 0.15 - 0.9, fM)
		end
		if fD > 0 then
			h = lerp(h, NIVEL_MAR + 1 + (h - NIVEL_MAR - 1) * 0.7, fD)
		end
		if fB > 0 then
			local hb = h + montes * 18 + colinas * 6
			local t = floor(hb / 5) * 5
			hb = t + math.min(5, (hb - t) * 2.5)
			h = lerp(h, hb, fB)
		end
	end
	local rio = abs(fbm(x * 0.0035, z * 0.0035, s + 70, 3) - 0.5)
	if tierra and bioma ~= BIOMA.champinones and rio < 0.022 then
		local f = 1 - rio / 0.022
		local sube = 1 - ssC(136, 164, h)
		if sube > 0 then
			h = h - (h - (NIVEL_MAR - 3)) * math.min(1, f * 2.2) * sube
			if h < NIVEL_MAR then
				bioma = BIOMA.rio
			end
		end
	end
	h = redondear(clamp(h, 70, 188))
	return h, bioma, montes, temp
end

------------------------------------------------------------------
-- Cuevas
------------------------------------------------------------------
function Generador:prepararCuevas(bx, bz)
	local s = self.semilla
	local GR, GNY, A, V = self.GR, self.GNY, self.rejA, self.rejV
	for gx = 0, 4 do
		for gz = 0, 4 do
			for gy = 0, GNY - 1 do
				local x, z, y = bx + gx * GR, bz + gz * GR, gy * GR
				local i = (gy * 5 + gz) * 5 + gx + 1
				A[i] = valueNoise3(x / 30, y / 18, z / 30, s + 300) * 0.65 + valueNoise3(x / 11, y / 11, z / 11, s + 301) * 0.35
				local b = valueNoise3(x / 26, y / 15, z / 26, s + 302)
				local c = valueNoise3(x / 26, y / 15, z / 26, s + 303)
				V[i] = 0.5 - math.max(abs(b - 0.5), abs(c - 0.5))
			end
		end
	end
end

local function muestraRejilla(rej, GR, GNY, x, y, z)
	local gx, gy, gz = x / GR, y / GR, z / GR
	local x0, y0, z0 = math.min(3, floor(gx)), math.min(GNY - 2, floor(gy)), math.min(3, floor(gz))
	local fx, fy, fz = gx - x0, gy - y0, gz - z0
	local b0 = (y0 * 5 + z0) * 5 + x0 + 1 -- (j=0, k=0, i=0)
	local b1 = b0 + 25 -- j=1
	local v000, v100, v001, v101 = rej[b0], rej[b0 + 1], rej[b0 + 5], rej[b0 + 6]
	local v010, v110, v011, v111 = rej[b1], rej[b1 + 1], rej[b1 + 5], rej[b1 + 6]
	local a0 = v000 + (v100 - v000) * fx
	local a1 = v001 + (v101 - v001) * fx
	local a = a0 + (a1 - a0) * fz
	local c0 = v010 + (v110 - v010) * fx
	local c1 = v011 + (v111 - v011) * fx
	local c = c0 + (c1 - c0) * fz
	return a + (c - a) * fy
end

function Generador:esCuevaLocal(lx, y, lz, h, oceano)
	if y < 5 then
		return false
	end
	if oceano and y > h - 6 then
		return false
	end
	local a = muestraRejilla(self.rejA, self.GR, self.GNY, lx, y, lz)
	local v = muestraRejilla(self.rejV, self.GR, self.GNY, lx, y, lz)
	if y > h - 4 then
		return a > 0.76 or v > 0.48
	end
	return a > 0.675 or v > 0.462
end

------------------------------------------------------------------
-- Vetas de mineral
------------------------------------------------------------------
local VETAS
local function vetas()
	if VETAS then
		return VETAS
	end
	VETAS = {
		{ B.menaCarbon, B.pCarbon, 20, 17, "tri", 0, 192 },
		{ B.menaCobre, B.pCobre, 16, 10, "tri", -16, 112 },
		{ B.menaHierro, B.pHierro, 10, 9, "tri", -24, 56 },
		{ B.menaHierro, B.pHierro, 10, 4, "uni", -64, 72 },
		{ B.menaOro, B.pOro, 3, 9, "tri", -64, 32 },
		{ B.menaOro, B.pOro, 0.5, 9, "uni", -64, -48 },
		{ B.menaRedstone, B.pRedstone, 4, 8, "uni", -64, 15 },
		{ B.menaRedstone, B.pRedstone, 8, 8, "tri", -96, -32 },
		{ B.menaLapis, B.pLapis, 2, 7, "tri", -32, 32 },
		{ B.menaLapis, B.pLapis, 2, 7, "uni", -64, 64 },
		{ B.menaDiamante, B.pDiamante, 7, 3, "tri", -144, 16 },
		{ B.menaDiamante, B.pDiamante, 0.11, 8, "tri", -144, 16 },
		{ B.menaDiamante, B.pDiamante, 1, 5, "tri", -144, 16 },
		{ B.tierra, B.tierra, 7, 33, "uni", 0, 160 },
		{ B.grava, B.grava, 14, 33, "uni", -64, 127 },
		{ B.granito, B.granito, 2, 64, "uni", 0, 60 },
		{ B.diorita, B.diorita, 2, 64, "uni", 0, 60 },
		{ B.andesita, B.andesita, 2, 64, "uni", 0, 60 },
	}
	return VETAS
end

local function colocarVeta(datos, r, lx, y, lz, tam, id, ds)
	local a = r() * pi
	local f = tam / 8
	local x0, x1 = lx + sin(a) * f, lx - sin(a) * f
	local z0, z1 = lz + cos(a) * f, lz - cos(a) * f
	local y0 = y + r() * 3 - 1
	local y1 = y + r() * 3 - 1
	local piedra, granito, diorita, andesita, pizarra, tierra = B.piedra, B.granito, B.diorita, B.andesita, B.pizarra, B.tierra
	for i = 0, tam - 1 do
		local t = i / tam
		local cx, cy, cz = lerp(x0, x1, t), lerp(y0, y1, t), lerp(z0, z1, t)
		local rad = ((sin(pi * t) + 1) * r() * tam / 16 + 1) / 2
		for X = floor(cx - rad), ceil(cx + rad) do
			if X >= 0 and X < CX then
				for Y = floor(cy - rad), ceil(cy + rad) do
					if Y >= 1 and Y < CY then
						for Z = floor(cz - rad), ceil(cz + rad) do
							if Z >= 0 and Z < CZ then
								local dx, dy, dz = (X + 0.5 - cx) / rad, (Y + 0.5 - cy) / rad, (Z + 0.5 - cz) / rad
								if dx * dx + dy * dy + dz * dz < 1 then
									local i2 = idx(X, Y, Z)
									local b = rd(datos, i2)
									if b == piedra or b == granito or b == diorita or b == andesita then
										wr(datos, i2, id)
									elseif b == pizarra and ds ~= tierra and ds ~= granito and ds ~= diorita and ds ~= andesita then
										wr(datos, i2, ds)
									end
								end
							end
						end
					end
				end
			end
		end
	end
end

function Generador:generarVetas(datos, cx, cz, montana)
	local r = mulberry32(floor(hash2(cx, cz, self.semilla + 4000) * 4294967296))
	local lista = vetas()
	if montana then
		lista = table.clone(lista)
		table.insert(lista, { B.menaEsmeralda, B.menaEsmeralda, 12, 3, "uni", -16, 127 })
		table.insert(lista, { B.menaHierro, B.pHierro, 90, 9, "tri", 80, 384 })
	end
	for _, v in lista do
		local id, ds, intentos, tam, forma, y0, y1 = v[1], v[2], v[3], v[4], v[5], v[6], v[7]
		local n = floor(intentos) + ((r() < intentos % 1) and 1 or 0)
		for _ = 1, n do
			local my
			if forma == "tri" then
				local a = r()
				local b = r()
				my = redondear(y0 + (a + b) / 2 * (y1 - y0))
			else
				my = redondear(y0 + r() * (y1 - y0))
			end
			local y = my + OY
			if y >= 1 and y < CY - 1 then
				local lx = floor(r() * 16)
				local lz = floor(r() * 16)
				colocarVeta(datos, r, lx, y, lz, tam, id, ds)
			end
		end
	end
end

------------------------------------------------------------------
-- Árboles
------------------------------------------------------------------
local function ponerArbolTipo(poner, tipo, wx, h, wz, r)
	local function tronco(x, y, z, id)
		poner(x, y, z, id, false)
	end
	local function hoja(x, y, z, id)
		poner(x, y, z, id, true)
	end
	local function bola(cx, cy, cz, rad, id)
		for dx = -ceil(rad), rad do
			for dy = -ceil(rad), rad do
				for dz = -ceil(rad), rad do
					if dx * dx + dy * dy * 1.6 + dz * dz <= rad * rad + r() * 0.8 then
						hoja(cx + dx, cy + dy, cz + dz, id)
					end
				end
			end
		end
	end
	local function copaRoble(cima, id)
		for y = cima - 2, cima + 1 do
			local rad = y >= cima and 1 or 2
			for dx = -rad, rad do
				for dz = -rad, rad do
					local saltar = abs(dx) == rad and abs(dz) == rad and (y == cima + 1 or r() < 0.5)
					if not saltar then
						hoja(wx + dx, y, wz + dz, id)
					end
				end
			end
		end
	end
	if tipo == "roble" or tipo == "abedul" or tipo == "pantano" then
		local alto = (tipo == "abedul" and 5 or 4) + floor(r() * 3)
		local cima = h + alto
		local hojaId = tipo == "abedul" and B.hojasAbedul or B.hojas
		if tipo == "pantano" then
			for y = cima - 2, cima + 1 do
				local rad = y >= cima and 2 or 3
				for dx = -rad, rad do
					for dz = -rad, rad do
						if not (abs(dx) == rad and abs(dz) == rad) then
							hoja(wx + dx, y, wz + dz, hojaId)
						end
					end
				end
			end
		else
			copaRoble(cima, hojaId)
		end
		for y = h + 1, cima do
			tronco(wx, y, wz, tipo == "abedul" and B.troncoAbedul or B.tronco)
		end
	elseif tipo == "robleGrande" then
		local alto = 7 + floor(r() * 4)
		local cima = h + alto
		for y = h + 1, cima do
			tronco(wx, y, wz, B.tronco)
		end
		bola(wx, cima, wz, 2.6, B.hojas)
		local ramas = 2 + floor(r() * 2)
		for k = 0, ramas - 1 do
			local a = r() * pi * 2
			local l = 2 + floor(r() * 2)
			local by = h + floor(alto * 0.55) + k
			local bx, bz = wx, wz
			for i = 1, l do
				bx = wx + redondear(cos(a) * i)
				bz = wz + redondear(sin(a) * i)
				tronco(bx, by + floor(i / 2), bz, B.tronco)
			end
			bola(bx, by + floor(l / 2) + 1, bz, 2, B.hojas)
		end
	elseif tipo == "abeto" then
		local alto = 7 + floor(r() * 5)
		local cima = h + alto
		local rad = 0
		local y = cima + 1
		while y >= h + 2 + floor(r() * 2) do
			for dx = -rad, rad do
				for dz = -rad, rad do
					if abs(dx) + abs(dz) <= rad + (rad > 1 and 1 or 0) then
						hoja(wx + dx, y, wz + dz, B.hojasAbeto)
					end
				end
			end
			if rad >= floor((cima - y) / 3) + 1 then
				rad = rad > 1 and rad - 1 or rad + 1
			else
				rad += 1
			end
			if rad > 3 then
				rad = 1
			end
			y -= 1
		end
		hoja(wx, cima + 2, wz, B.hojasAbeto)
		for yy = h + 1, cima do
			tronco(wx, yy, wz, B.troncoAbeto)
		end
	elseif tipo == "jungla" then
		local alto = 9 + floor(r() * 7)
		local cima = h + alto
		bola(wx, cima, wz, 3.2, B.hojasJungla)
		local y = h + 4
		while y < cima - 2 do
			local a = r() * pi * 2
			bola(wx + redondear(cos(a) * 2), y, wz + redondear(sin(a) * 2), 1.3, B.hojasJungla)
			y += 2 + floor(r() * 3)
		end
		for yy = h + 1, cima do
			tronco(wx, yy, wz, B.troncoJungla)
		end
	elseif tipo == "arbusto" then
		tronco(wx, h + 1, wz, B.troncoJungla)
		bola(wx, h + 2, wz, 1.8, B.hojasJungla)
	elseif tipo == "acacia" then
		local alto = 4 + floor(r() * 2)
		local a = floor(r() * 4)
		local dx, dz = DIRF[a + 1][1], DIRF[a + 1][2]
		local x, z, y = wx, wz, h
		for _ = 1, alto do
			y += 1
			tronco(x, y, z, B.troncoAcacia)
		end
		local i = 0
		while i < 2 + floor(r() * 2) do
			x += dx
			z += dz
			y += 1
			tronco(x, y, z, B.troncoAcacia)
			i += 1
		end
		for ddx = -3, 3 do
			for ddz = -3, 3 do
				local d = abs(ddx) + abs(ddz)
				if d <= 4 then
					hoja(x + ddx, y + 1, z + ddz, B.hojasAcacia)
				end
				if d <= 2 then
					hoja(x + ddx, y + 2, z + ddz, B.hojasAcacia)
				end
			end
		end
	elseif tipo == "cerezo" then
		local alto = 4 + floor(r() * 3)
		local y = h
		for _ = 1, alto do
			y += 1
			tronco(wx, y, wz, B.troncoCerezo)
		end
		local copas = { { wx, y, wz } }
		local nr = 1 + floor(r() * 2)
		local usadas = {}
		for _ = 1, nr do
			local d = floor(r() * 4)
			while usadas[d] do
				d = (d + 1) % 4
			end
			usadas[d] = true
			local dx, dz = DIRF[d + 1][1], DIRF[d + 1][2]
			local bx2, bz2 = wx, wz
			local by = y - 1 - floor(r() * 2)
			for i = 0, 2 do
				bx2 += dx
				bz2 += dz
				if i > 0 then
					by += 1
				end
				tronco(bx2, by, bz2, B.troncoCerezo)
			end
			table.insert(copas, { bx2, by, bz2 })
		end
		for _, cp in copas do
			local cx2, cy2, cz2 = cp[1], cp[2], cp[3]
			for dx = -3, 3 do
				for dz = -3, 3 do
					for dy = -1, 2 do
						local d = (dx * dx + dz * dz) / 10.5 + (dy - 0.5) * (dy - 0.5) / 2.2
						if d <= 1 + r() * 0.15 then
							hoja(cx2 + dx, cy2 + dy, cz2 + dz, B.hojasCerezo)
						end
					end
				end
			end
			for _ = 1, 5 do
				local ax = cx2 + floor(r() * 5) - 2
				local az = cz2 + floor(r() * 7) - 3
				hoja(ax, cy2 - 2, az, B.hojasCerezo)
			end
		end
	elseif tipo == "palido" then
		local alto = 6 + floor(r() * 3)
		local cima = h + alto
		for y = h + 1, cima do
			for _, ab in { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } } do
				tronco(wx + ab[1], y, wz + ab[2], B.troncoPalido)
			end
		end
		if r() < 0.14 then
			local ax = wx + floor(r() * 2)
			local ay = h + 2 + floor(r() * 3)
			local az = wz + floor(r() * 2)
			tronco(ax, ay, az, B.corazonCreaking)
		end
		for dx = -3, 4 do
			for dz = -3, 4 do
				for dy = -1, 1 do
					local d = sqrt((dx - 0.5) ^ 2 + (dz - 0.5) ^ 2)
					if d <= 3.7 - (dy == 1 and 1.4 or 0) + r() * 0.4 then
						hoja(wx + dx, cima + dy, wz + dz, B.hojasPalidas)
					end
				end
			end
		end
		for _ = 1, 12 do
			local hx = wx + floor(r() * 8) - 3
			local hz = wz + floor(r() * 8) - 3
			local l = 1 + floor(r() * 3)
			for q = 0, l - 1 do
				hoja(hx, cima - 2 - q, hz, B.musgoColgante)
			end
		end
	elseif tipo == "robleOscuro" then
		local alto = 5 + floor(r() * 3)
		local cima = h + alto
		local H = B.hojasRobleOscuro
		for y = h + 1, cima do
			for _, ab in { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } } do
				tronco(wx + ab[1], y, wz + ab[2], B.troncoRobleOscuro)
			end
		end
		local k = 0
		while k < 2 + floor(r() * 2) do
			local di = DIRF[floor(r() * 4) + 1]
			local dx, dz = di[1], di[2]
			local bx2 = wx + (dx > 0 and 2 or dx < 0 and -1 or floor(r() * 2))
			local bz2 = wz + (dz > 0 and 2 or dz < 0 and -1 or floor(r() * 2))
			tronco(bx2, cima - 1, bz2, B.troncoRobleOscuro)
			tronco(bx2 + dx, cima, bz2 + dz, B.troncoRobleOscuro)
			k += 1
		end
		for dx = -3, 4 do
			for dz = -3, 4 do
				local d = sqrt((dx - 0.5) ^ 2 + (dz - 0.5) ^ 2)
				if d <= 3.8 + r() * 0.5 then
					hoja(wx + dx, cima, wz + dz, H)
				end
				if d <= 2.8 + r() * 0.4 then
					hoja(wx + dx, cima + 1, wz + dz, H)
				end
				if d > 1.6 and d <= 3.4 and r() < 0.45 then
					hoja(wx + dx, cima - 1, wz + dz, H)
				end
			end
		end
	elseif tipo == "setaRoja" or tipo == "setaMarron" then
		local alto = 4 + floor(r() * 3)
		local cima = h + alto
		for y = h + 1, cima - 1 do
			tronco(wx, y, wz, B.talloSeta)
		end
		if tipo == "setaRoja" then
			for dx = -2, 2 do
				for dz = -2, 2 do
					if not (abs(dx) == 2 and abs(dz) == 2) then
						hoja(wx + dx, cima, wz + dz, B.setaRojaGigante)
						if abs(dx) == 2 or abs(dz) == 2 then
							for dy = 1, 3 do
								hoja(wx + dx, cima - dy, wz + dz, B.setaRojaGigante)
							end
						end
					end
				end
			end
		else
			for dx = -3, 3 do
				for dz = -3, 3 do
					if not (abs(dx) == 3 and abs(dz) == 3) then
						hoja(wx + dx, cima, wz + dz, B.setaMarronGigante)
					end
				end
			end
		end
	elseif tipo == "mangle" then
		local base = h + 2 + floor(r() * 2)
		local cima = base + 5 + floor(r() * 4)
		local nr = 4 + floor(r() * 3)
		for k = 0, nr - 1 do
			local a = k / nr * pi * 2 + r() * 0.6
			for y = base, h - 2, -1 do
				local t = (base - y) / (base - h + 2)
				tronco(wx + redondear(cos(a) * t * 2.4), y, wz + redondear(sin(a) * t * 2.4), B.raicesMangle)
			end
		end
		for y = base, cima do
			tronco(wx, y, wz, B.troncoMangle)
		end
		bola(wx, cima, wz, 2.8, B.hojasMangle)
		local ax = wx + redondear(r() * 2 - 1)
		local az = wz + redondear(r() * 2 - 1)
		bola(ax, cima - 2, az, 2.2, B.hojasMangle)
		for k = 0, 2 do
			if r() < 0.6 then
				local di = DIRF[floor(r() * 4) + 1]
				tronco(wx + di[1], cima - 1 - k, wz + di[2], B.troncoMangle)
			end
		end
	end
end
Generador.ponerArbolTipo = ponerArbolTipo

local ARBOLES_BIOMA = {
	[0] = false, false,
	{ 0.003, function(r) return r < 0.15 and "robleGrande" or "roble" end },
	{ 0.05, function(r) return r < 0.2 and "abedul" or r < 0.3 and "robleGrande" or "roble" end },
	false,
	{ 0.004, function() return "abeto" end },
	{ 0.006, function() return "abeto" end },
	{ 0.045, function() return "abeto" end },
	{ 0.05, function(r) return r < 0.08 and "roble" or "abedul" end },
	{ 0.1, function(r) return r < 0.45 and "arbusto" or r < 0.55 and "robleGrande" or "jungla" end },
	{ 0.006, function() return "acacia" end },
	{ 0.014, function() return "pantano" end },
	false, false,
	{ 0.012, function() return "cerezo" end },
	{ 0.075, function() return "mangle" end },
	{ 0.06, function() return "palido" end },
	{ 0.1, function(r) return r < 0.05 and "setaRoja" or r < 0.1 and "setaMarron" or r < 0.82 and "robleOscuro" or r < 0.95 and "roble" or "abedul" end },
	{ 0.035, function() return "abeto" end },
	{ 0.0012, function(r) return r < 0.6 and "roble" or "abedul" end },
	false, false, false,
	{ 0.012, function(r) return r < 0.5 and "setaRoja" or "setaMarron" end },
	{ 0.03, function(r) return r < 0.3 and "abedul" or r < 0.4 and "robleGrande" or "roble" end },
	false,
	{ 0.02, function(r) return r < 0.7 and "arbusto" or "jungla" end },
	false,
	{ 0.075, function() return "abeto" end },
	false, false,
	{ 0.0015, function() return "roble" end },
}

------------------------------------------------------------------
-- Lagos
------------------------------------------------------------------
local function lagos(datos, info, r)
	if r() < 0.035 then
		local cx = 5 + floor(r() * 6)
		local cz = 5 + floor(r() * 6)
		local inf = info[cz * CX + cx + 1]
		local h, bioma = inf[1], inf[2]
		if h <= NIVEL_MAR + 1 or bioma == BIOMA.desierto or bioma == BIOMA.badlands or bioma == BIOMA.montana then
			return
		end
		local lava = r() < 0.1
		local rx = 3 + r() * 2.5
		local rz = 3 + r() * 2.5
		local prof = 2 + floor(r() * 2)
		for x = 0, CX - 1 do
			for z = 0, CZ - 1 do
				local d = ((x - cx) / rx) ^ 2 + ((z - cz) / rz) ^ 2
				if d < 1 then
					local hh = info[z * CX + x + 1][1]
					if abs(hh - h) <= 3 then
						local fondo = h - 1 - floor((1 - d) * prof)
						for y = fondo, hh + 3 do
							if y >= 1 and y < CY then
								local i = idx(x, y, z)
								if y < h then
									wr(datos, i, lava and B.lava or ((esBiomaFrio(info[z * CX + x + 1][2]) and y == h - 1) and B.hielo or B.agua))
								elseif not esTronco(rd(datos, i)) then
									wr(datos, i, 0)
								end
							end
						end
						if lava then
							for _, ab in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
								local X, Z = x + ab[1], z + ab[2]
								if X >= 0 and Z >= 0 and X < CX and Z < CZ then
									local i = idx(X, h - 1, Z)
									local v = rd(datos, i)
									if v ~= 0 and v ~= B.lava then
										wr(datos, i, B.piedra)
									end
								end
							end
						end
						if not lava and fondo > 0 and rd(datos, idx(x, fondo - 1, z)) == B.tierra then
							wr(datos, idx(x, fondo - 1, z), r() < 0.3 and B.arcilla or B.arena)
						end
					end
				end
			end
		end
	end
end

------------------------------------------------------------------
-- Superficie (generarSuperficie)
------------------------------------------------------------------
local PASTO = { [2] = 0.25, [3] = 0.1, [8] = 0.1, [9] = 0.3, [10] = 0.3, [11] = 0.1, [7] = 0.05, [6] = 0.05, [13] = 0.1, [17] = 0.08, [19] = 0.2 }
local FLOR = { [2] = 0.03, [3] = 0.015, [8] = 0.02, [11] = 0.02, [9] = 0.01 }

-- Zona vacía (islas de One Block): todo aire
-- Zonas del mapa de Roblox (en chunks a lo largo de Z):
-- · cz >= 600: el Nether (su chunk 0 está en cz = 800)
-- · -600 >= cz > -760: vacío (islas de One Block y arenas de los modos)
-- · cz <= -760: el End (su chunk 0 está en cz = -900)
-- · el resto: la Superficie
Generador.ZONA_VACIA_CZ = -600
Generador.NETHER_DESDE, Generador.NETHER_CZ = 600, 800
Generador.END_HASTA, Generador.END_CZ = -760, -900
function Generador.dimensionDe(cz)
	if cz >= Generador.NETHER_DESDE then
		return "nether", Generador.NETHER_CZ
	elseif cz <= Generador.END_HASTA then
		return "end", Generador.END_CZ
	elseif cz <= Generador.ZONA_VACIA_CZ then
		return "vacio", 0
	end
	return "superficie", 0
end
-- Dimensión de un bloque (x, z) del mapa de Roblox y su z dentro de esa dimensión
function Generador.dimensionBloque(z)
	local d, off = Generador.dimensionDe(z // CZ)
	return d, z - off * CZ
end
function Generador.esZonaVacia(cx, cz)
	return Generador.dimensionDe(cz) == "vacio"
end
-- ¿Le da la luz del cielo? (no en el Nether ni en el End)
function Generador.conCielo(cz)
	local d = Generador.dimensionDe(cz)
	return d == "superficie" or d == "vacio"
end

-- Genera un chunk del Nether o del End (coordenadas de esa dimensión)
function Generador:llenarDim(dim, datos, cx, cz)
	if dim == "nether" then
		local bn, cofres = Dimensiones.generarNether(datos, cx, cz, self.semilla)
		local bio = buffer.create(256)
		for i = 0, 255 do
			buffer.writeu8(bio, i, 100 + buffer.readu8(bn, i))
		end
		return bio, cofres
	end
	local cofres = Dimensiones.generarEnd(datos, cx, cz, self.semilla)
	local bio = buffer.create(256)
	buffer.fill(bio, 0, 120)
	return bio, cofres
end

function Generador:llenar(datos, cx, cz, ceder)
	local dim, off = Generador.dimensionDe(cz)
	if dim == "vacio" then
		local bio = buffer.create(256)
		buffer.fill(bio, 0, 2)
		-- Arenas de Bed Wars, Mazmorras y Leyendas
		Arenas.llenar(datos, cx, cz)
		return bio
	elseif dim ~= "superficie" then
		local bio, cofres = self:llenarDim(dim, datos, cx, cz - off)
		for _, c in cofres do
			c[3] += off * CZ
		end
		return bio, cofres
	end
	local s = self.semilla
	local bx, bz = cx * CX, cz * CZ
	self:prepararCuevas(bx, bz)
	local info = table.create(256)
	local biomasCh = buffer.create(256)
	local montana = false
	for z = 0, CZ - 1 do
		for x = 0, CX - 1 do
			local h, bioma, montes, temp = self:infoColumna(bx + x, bz + z)
			info[z * CX + x + 1] = { h, bioma, montes, temp }
			buffer.writeu8(biomasCh, z * CX + x, bioma)
			if bioma == BIOMA.montana then
				montana = true
			end
		end
	end
	local Bl = {
		lecho = B.lecho, agua = B.agua, hielo = B.hielo, lava = B.lava, arena = B.arena, arenaRoja = B.arenaRoja, barro = B.barro,
		cesped = B.cesped, musgoPalido = B.musgoPalido, arcilla = B.arcilla, grava = B.grava, bloqueNieve = B.bloqueNieve,
		piedra = B.piedra, hieloCompacto = B.hieloCompacto, micelio = B.micelio, calcita = B.calcita, podzol = B.podzol,
		cespedNevado = B.cespedNevado, arenisca = B.arenisca, terracota = B.terracota, tierra = B.tierra, terracota0 = B.terracota0,
		pizarra = B.pizarra,
	}
	for z = 0, CZ - 1 do
		for x = 0, CX - 1 do
			local wx, wz = bx + x, bz + z
			local inf = info[z * CX + x + 1]
			local h, bioma = inf[1], inf[2]
			local agua = h < NIVEL_MAR
			local top = math.max(h, NIVEL_MAR)
			local frio = esBiomaFrio(bioma) or (bioma == BIOMA.rio and inf[4] < 0.33)
			local iceberg = 0
			if bioma == BIOMA.oceanoHelado then
				local v = fbm(wx * 0.035, wz * 0.035, s + 1800, 2)
				if v > 0.66 then
					iceberg = floor((v - 0.66) * 90)
				end
			end
			if iceberg > 0 then
				for y = NIVEL_MAR - math.min(6, iceberg), NIVEL_MAR + iceberg do
					if y > h then
						wr(datos, idx(x, y, z), (y > NIVEL_MAR + iceberg - 2 and hash3(wx, y, wz, s + 36) < 0.4) and Bl.bloqueNieve or Bl.hieloCompacto)
					end
				end
			end
			for y = 0, top do
				local id
				local saltar = false
				if y <= 4 and (y == 0 or hash3(wx, y, wz, s + 5) < (5 - y) / 5) then
					id = Bl.lecho
				elseif y > h then
					if rd(datos, idx(x, y, z)) ~= 0 then
						saltar = true
					else
						id = (frio and y == NIVEL_MAR and (bioma ~= BIOMA.oceanoHelado or fbm(wx * 0.07, wz * 0.07, s + 37, 2) < 0.64)) and Bl.hielo or Bl.agua
					end
				elseif self:esCuevaLocal(x, y, z, h, agua) then
					id = y <= 10 and Bl.lava or 0
				elseif y == h then
					if bioma == BIOMA.desierto or bioma == BIOMA.playa then
						id = Bl.arena
					elseif esBadlands(bioma) then
						id = Bl.arenaRoja
					elseif bioma == BIOMA.manglar then
						id = (h > NIVEL_MAR and hash2(wx, wz, s + 34) < 0.35) and Bl.cesped or Bl.barro
					elseif bioma == BIOMA.jardinPalido and not agua then
						id = hash2(wx, wz, s + 35) < 0.4 and Bl.musgoPalido or Bl.cesped
					elseif agua and bioma == BIOMA.oceanoCalido then
						id = Bl.arena
					elseif agua then
						if bioma == BIOMA.rio then
							id = hash2(wx, wz, s + 31) < 0.2 and Bl.arcilla or hash2(wx, wz, s + 32) < 0.5 and Bl.arena or Bl.grava
						else
							id = h < NIVEL_MAR - 8 and Bl.grava or Bl.arena
						end
					elseif bioma == BIOMA.montana then
						id = h > 172 and Bl.bloqueNieve or h > 158 and Bl.piedra or Bl.cesped
					elseif bioma == BIOMA.picosNevados then
						id = hash2(wx, wz, s + 38) < 0.1 and Bl.hieloCompacto or Bl.bloqueNieve
					elseif bioma == BIOMA.champinones then
						id = Bl.micelio
					elseif bioma == BIOMA.espigasHielo then
						id = Bl.bloqueNieve
					elseif bioma == BIOMA.picosPiedra then
						id = hash2(wx, wz, s + 39) < 0.25 and Bl.calcita or Bl.piedra
					elseif (bioma == BIOMA.taigaGigante and hash2(wx, wz, s + 40) < 0.6) or (bioma == BIOMA.junglaBambu and hash2(wx, wz, s + 41) < 0.35) then
						id = Bl.podzol
					elseif frio then
						id = Bl.cespedNevado
					else
						id = Bl.cesped
					end
				elseif y > h - 4 then
					if bioma == BIOMA.desierto then
						id = y > h - 3 and Bl.arena or Bl.arenisca
					elseif esBadlands(bioma) then
						id = Bl.terracota
					elseif bioma == BIOMA.manglar then
						id = Bl.barro
					elseif bioma == BIOMA.playa or agua then
						id = Bl.arena
					elseif bioma == BIOMA.montana and h > 158 then
						id = Bl.piedra
					elseif bioma == BIOMA.picosNevados then
						id = y > h - 2 and Bl.bloqueNieve or Bl.piedra
					elseif bioma == BIOMA.picosPiedra then
						id = Bl.piedra
					else
						id = Bl.tierra
					end
				elseif esBadlands(bioma) and y > h - 18 and y > NIVEL_MAR - 4 then
					local banda = floor(hash2(floor(y / 2), 7, s + 33) * 8)
					id = banda < 6 and Bl.terracota0 + banda or Bl.terracota
				else
					local pizarra = y < OY or (y < OY + 8 and hash3(wx, y, wz, s + 6) < (OY + 8 - y) / 8)
					id = pizarra and Bl.pizarra or Bl.piedra
				end
				if not saltar and id and id ~= 0 then
					wr(datos, idx(x, y, z), id)
				end
			end
		end
		if ceder then
			ceder()
		end
	end
	self:generarVetas(datos, cx, cz, montana)
	if ceder then
		ceder()
	end
	local rc = mulberry32(floor(hash2(cx, cz, s + 4100) * 4294967296))
	lagos(datos, info, rc)

	-- Árboles (también los de columnas vecinas que asoman a este chunk)
	local function poner(x, y, z, id, soloAire)
		local lx, lz = x - bx, z - bz
		if lx < 0 or lz < 0 or lx >= CX or lz >= CZ or y < 0 or y >= CY then
			return
		end
		local i = idx(lx, y, lz)
		local b = rd(datos, i)
		if soloAire and b ~= 0 and not REEMPL[b] then
			return
		end
		if not soloAire and b ~= 0 and SOLIDO[b] and not esHojas(b) and not esTronco(b) and b ~= Bl.tierra and b ~= Bl.cesped then
			return
		end
		wr(datos, i, id)
	end
	for wx = bx - 4, bx + CX + 3 do
		for wz = bz - 4, bz + CZ + 3 do
			local rh = hash2(wx, wz, s + 777)
			if rh <= 0.1 then
				local dentro = wx >= bx and wx < bx + CX and wz >= bz and wz < bz + CZ
				local h, bioma
				if dentro then
					local inf = info[(wz - bz) * CX + wx - bx + 1]
					h, bioma = inf[1], inf[2]
				else
					h, bioma = self:infoColumna(wx, wz)
				end
				local def = ARBOLES_BIOMA[bioma]
				if def and rh < def[1] then
					local mangle = bioma == BIOMA.manglar
					if h > NIVEL_MAR - (mangle and 3 or 0) then
						local ok = true
						if dentro then
							local sup = rd(datos, idx(wx - bx, h, wz - bz))
							if sup ~= Bl.cesped and sup ~= Bl.cespedNevado and sup ~= Bl.tierra and sup ~= Bl.barro and sup ~= Bl.musgoPalido and sup ~= Bl.micelio and sup ~= Bl.podzol then
								ok = false
							end
						end
						if ok then
							local r = mulberry32(floor(hash2(wx, wz, s + 778) * 4294967296))
							ponerArbolTipo(poner, def[2](r()), wx, h, wz, r)
							if dentro and not mangle then
								wr(datos, idx(wx - bx, h, wz - bz), Bl.tierra)
							end
						end
					end
				end
			end
		end
	end

	if ceder then
		ceder()
	end
	-- Vegetación
	for z = 0, CZ - 1 do
		for x = 0, CX - 1 do
			local wx, wz = bx + x, bz + z
			local inf = info[z * CX + x + 1]
			local h, bioma = inf[1], inf[2]
			local sup = rd(datos, idx(x, h, z))
			local arriba = h + 1 < CY and rd(datos, idx(x, h + 1, z)) or 1
			local r2 = hash2(wx, wz, s + 779)
			local r3 = hash2(wx, wz, s + 780)
			local function poner1(id)
				if arriba == 0 then
					wr(datos, idx(x, h + 1, z), id)
				end
			end
			repeat -- (para poder usar «break» como el «continue» del original)
				if bioma == BIOMA.cerezo and sup == Bl.cesped and r2 < 0.16 then
					poner1(r3 < 0.85 and B.petalos or B.hierbaAlta)
					break
				end
				if esBiomaFrio(bioma) then
					for y = math.min(CY - 2, h + 24), h + 1, -1 do
						local b = rd(datos, idx(x, y, z))
						if b ~= 0 then
							if esHojas(b) and rd(datos, idx(x, y + 1, z)) == 0 then
								wr(datos, idx(x, y + 1, z), B.capaNieve)
							end
							break
						end
					end
				end
				if sup == Bl.cesped and arriba == 0 then
					if bioma == BIOMA.prado and r2 < 0.3 then
						local flores = { B.florAmarilla, B.florRoja, B.aciano, B.margarita, B.floresSilvestres, B.aciano }
						wr(datos, idx(x, h + 1, z), r3 < 0.45 and B.hierbaAlta or flores[floor(r3 * 13) % 6 + 1])
						break
					end
					if bioma == BIOMA.llanura and fbm(wx * 0.02, wz * 0.02, s + 1900, 2) > 0.64 and r2 < 0.12 then
						wr(datos, idx(x, h + 1, z), B.girasol)
						break
					end
					if bioma == BIOMA.bosqueOscuro and r2 < 0.03 then
						wr(datos, idx(x, h + 1, z), r3 < 0.5 and B.champinonRojo or B.champinonMarron)
						break
					end
				end
				if (bioma == BIOMA.pantano or bioma == BIOMA.manglar) and h < NIVEL_MAR and rd(datos, idx(x, NIVEL_MAR + 1, z)) == 0 and rd(datos, idx(x, NIVEL_MAR, z)) == Bl.agua and r2 < 0.08 then
					wr(datos, idx(x, NIVEL_MAR + 1, z), B.nenufar)
					break
				end
				local r4 = hash2(wx, wz, s + 781)
				if bioma == BIOMA.jardinPalido and (sup == Bl.cesped or sup == Bl.musgoPalido) and arriba == 0 then
					if r4 < 0.2 then
						wr(datos, idx(x, h + 1, z), B.alfombraMusgo)
						break
					end
					if r4 < 0.225 then
						wr(datos, idx(x, h + 1, z), B.floresOjo)
						break
					end
				end
				if sup == Bl.cesped and arriba == 0 then
					if bioma == BIOMA.bosque and r4 < 0.05 then
						wr(datos, idx(x, h + 1, z), B.hojarasca)
						break
					end
					if (bioma == BIOMA.abedul and r4 < 0.04) or (bioma == BIOMA.llanura and r4 < 0.008) then
						wr(datos, idx(x, h + 1, z), B.floresSilvestres)
						break
					end
					if (bioma == BIOMA.llanura or bioma == BIOMA.bosque or bioma == BIOMA.taiga) and r4 > 0.985 then
						wr(datos, idx(x, h + 1, z), B.arbusto)
						break
					end
					if (bioma == BIOMA.pantano or bioma == BIOMA.manglar or bioma == BIOMA.bosque) and r4 > 0.975 and h <= NIVEL_MAR + 3 then
						wr(datos, idx(x, h + 1, z), B.arbustoLuciernagas)
						break
					end
				end
				if sup == Bl.cesped then
					local pasto = PASTO[bioma] or 0.05
					local flor = FLOR[bioma] or 0
					if r2 < pasto then
						poner1((bioma == BIOMA.taiga or (bioma == BIOMA.jungla and r3 < 0.4)) and B.helecho or B.hierbaAlta)
					elseif r2 < pasto + flor then
						local f = bioma == BIOMA.pantano and B.orquidea or ({ B.florAmarilla, B.florRoja, B.aciano, B.margarita })[floor(r3 * 4) + 1]
						poner1(f)
					elseif (bioma == BIOMA.taiga or bioma == BIOMA.bosque or bioma == BIOMA.pantano) and r2 < pasto + flor + 0.008 then
						poner1(r3 < 0.5 and B.champinonRojo or B.champinonMarron)
					elseif bioma == BIOMA.llanura and r2 > 0.9985 then
						poner1(B.calabaza)
					elseif bioma == BIOMA.jungla and r2 > 0.996 then
						poner1(B.sandia)
					elseif bioma == BIOMA.taiga and r2 < 0.05 + pasto then
						poner1(B.helecho)
					end
				elseif sup == Bl.cespedNevado or ((bioma == BIOMA.nevado or bioma == BIOMA.taigaNevada) and SOLIDO[sup] and OPACO[sup]) then
					if arriba == 0 then
						wr(datos, idx(x, h + 1, z), B.capaNieve)
					end
				elseif (bioma == BIOMA.desierto or bioma == BIOMA.badlands) and (sup == Bl.arena or sup == Bl.arenaRoja) then
					if r2 < 0.008 then
						local a = 1 + floor(r3 * 3)
						local ok = true
						for k = 1, a do
							if rd(datos, idx(x, h + k, z)) ~= 0 then
								ok = false
							end
						end
						if ok and x > 0 and x < 15 and z > 0 and z < 15 then
							for k = 1, a do
								wr(datos, idx(x, h + k, z), B.cactus)
							end
						end
					elseif r2 < 0.02 then
						poner1(B.arbustoSeco)
					end
				end
				if h == NIVEL_MAR and (sup == Bl.arena or sup == Bl.cesped or sup == Bl.tierra) and r2 > 0.88 then
					local cerca = false
					for _, ab in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
						local X, Z = x + ab[1], z + ab[2]
						if X >= 0 and Z >= 0 and X < CX and Z < CZ and esAgua(rd(datos, idx(X, NIVEL_MAR, Z))) then
							cerca = true
							break
						end
					end
					if cerca then
						local a = 1 + floor(r3 * 3)
						for k = 1, a do
							if rd(datos, idx(x, h + k, z)) == 0 then
								wr(datos, idx(x, h + k, z), B.cana)
							end
						end
					end
				end
			until true
		end
	end
	if ceder then
		ceder()
	end
	-- Estructuras, decoración de biomas y desgaste (lo mismo que añade el juego web)
	local cofres = Estructuras.superficie(self, datos, cx, cz, info, biomasCh)
	return biomasCh, cofres
end

-- Altura del terreno sin cambios de los jugadores
function Generador:altura(x, z)
	local h = self:infoColumna(x, z)
	return h
end

return Generador
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">MundoDatos</string><ProtectedString name="Source"><![CDATA[--[[
	Blockverse para Roblox · Datos del mundo
	Guarda los chunks (16 × 16 × 192 bloques) y los cambios que han hecho
	los jugadores. Lo usan el servidor y el cliente: los dos generan el
	terreno con la misma semilla y solo se envían los cambios.
]]
local Generador = require(script.Parent:WaitForChild("Generador"))
local Registro = require(script.Parent:WaitForChild("Registro"))

local CX, CZ, CY = Generador.CX, Generador.CZ, Generador.CY
local TAM = CX * CZ * CY * 2
local SOLIDO = Registro.SOLIDO

local MundoDatos = {}
MundoDatos.__index = MundoDatos
MundoDatos.CX, MundoDatos.CZ, MundoDatos.CY = CX, CZ, CY

local function clave(cx, cz)
	return (cx + 32768) * 65536 + (cz + 32768)
end
MundoDatos.clave = clave
function MundoDatos.desclave(k)
	return k // 65536 - 32768, k % 65536 - 32768
end

function MundoDatos.new(semilla, opc)
	local self = setmetatable({}, MundoDatos)
	self.semilla = semilla
	self.gen = Generador.new(semilla)
	self.datos = {} -- clave -> buffer
	self.biomas = {} -- clave -> buffer de 256 (bioma de cada columna)
	self.ediciones = {} -- clave -> {[indice] = id}
	self.alGenerar = opc and opc.alGenerar or nil -- function(cx, cz, datos) para añadir estructuras o modos
	self.vacio = opc and opc.vacio or false -- mundo vacío (One Block, Bed Wars)
	self._ucx, self._ucz, self._ubuf = math.huge, math.huge, nil
	return self
end

function MundoDatos:existe(cx, cz)
	return self.datos[clave(cx, cz)] ~= nil
end

-- Datos del chunk (lo genera si hace falta). `ceder` se llama de vez en cuando para repartir el trabajo.
function MundoDatos:obtener(cx, cz, ceder)
	local k = clave(cx, cz)
	local d = self.datos[k]
	if d then
		return d
	end
	d = buffer.create(TAM)
	local biomas, cofres
	if not self.vacio then
		biomas, cofres = self.gen:llenar(d, cx, cz, ceder)
	else
		biomas = buffer.create(256)
	end
	-- Mientras se generaba (si cedió) otro pudo crearlo
	if self.datos[k] then
		return self.datos[k]
	end
	if self.alGenerar then
		self.alGenerar(cx, cz, d)
	end
	local ed = self.ediciones[k]
	if ed then
		for i, id in ed do
			buffer.writeu16(d, i * 2, id)
		end
	end
	self.datos[k] = d
	self.biomas[k] = biomas
	-- Generadores de criaturas (mazmorras, fortaleza y cámaras de prueba)
	if self.buscarGeneradores then
		local lista = nil
		local G1, G2, G3 = self.buscarGeneradores[1], self.buscarGeneradores[2], self.buscarGeneradores[3]
		for i = 0, TAM // 2 - 1 do
			local b = buffer.readu16(d, i * 2)
			if b == G1 or b == G2 or b == G3 then
				lista = lista or {}
				table.insert(lista, { cx * CX + i % CX, i // (CX * CZ), cz * CZ + (i // CX) % CZ })
			end
		end
		self.generadores = self.generadores or {}
		self.generadores[k] = lista
	end
	if cofres and #cofres > 0 then
		-- Cofres de las estructuras: {x, y, z, tipo} para darles botín al abrirlos
		self.cofresGen = self.cofresGen or {}
		for _, c in cofres do
			self.cofresGen[c[1] .. "," .. c[2] .. "," .. c[3]] = c[4]
		end
	end
	return d
end

function MundoDatos:descargar(cx, cz)
	local k = clave(cx, cz)
	self.datos[k] = nil
	self.biomas[k] = nil
	if self._ucx == cx and self._ucz == cz then
		self._ucx = math.huge
	end
end

function MundoDatos:get(x, y, z)
	if y < 0 then
		return Registro.B.lecho
	end
	if y >= CY then
		return 0
	end
	local cx, cz = x // CX, z // CZ
	local d
	if cx == self._ucx and cz == self._ucz then
		d = self._ubuf
	else
		d = self:obtener(cx, cz)
		self._ucx, self._ucz, self._ubuf = cx, cz, d
	end
	return buffer.readu16(d, ((x - cx * CX) + (z - cz * CZ) * CX + y * CX * CZ) * 2)
end

-- Como get, pero devuelve -1 si el chunk no está cargado
function MundoDatos:getSiCargado(x, y, z)
	if y < 0 or y >= CY then
		return 0
	end
	local cx, cz = x // CX, z // CZ
	local d = self.datos[clave(cx, cz)]
	if not d then
		return -1
	end
	return buffer.readu16(d, ((x - cx * CX) + (z - cz * CZ) * CX + y * CX * CZ) * 2)
end

-- Cambia un bloque y lo apunta como edición. Devuelve el bloque anterior.
function MundoDatos:set(x, y, z, id)
	if y < 0 or y >= CY then
		return 0
	end
	local cx, cz = x // CX, z // CZ
	local k = clave(cx, cz)
	local i = (x - cx * CX) + (z - cz * CZ) * CX + y * CX * CZ
	local ed = self.ediciones[k]
	if not ed then
		ed = {}
		self.ediciones[k] = ed
	end
	ed[i] = id
	local d = self.datos[k]
	local antes = 0
	if d then
		antes = buffer.readu16(d, i * 2)
		buffer.writeu16(d, i * 2, id)
	end
	return antes
end

-- Ediciones que llegan del servidor
function MundoDatos:aplicarEdiciones(cx, cz, lista)
	local k = clave(cx, cz)
	local ed = self.ediciones[k] or {}
	self.ediciones[k] = ed
	local d = self.datos[k]
	for i, id in lista do
		i = tonumber(i) :: number
		ed[i] = id
		if d then
			buffer.writeu16(d, i * 2, id)
		end
	end
end

function MundoDatos:bioma(x, z)
	local cx, cz = x // CX, z // CZ
	local b = self.biomas[clave(cx, cz)]
	if not b then
		self:obtener(cx, cz)
		b = self.biomas[clave(cx, cz)]
	end
	return buffer.readu8(b, (x - cx * CX) + (z - cz * CZ) * CX)
end

-- Altura del bloque sólido más alto (sin hojas)
function MundoDatos:alturaSuelo(x, z)
	for y = CY - 1, 0, -1 do
		local b = self:get(x, y, z)
		if b ~= 0 and SOLIDO[b] and not Registro.esHojas(b) then
			return y
		end
	end
	return 0
end

-- ¿Le da el cielo? (nada opaco por encima)
function MundoDatos:alCielo(x, y, z)
	local OPACO = Registro.OPACO
	for yy = y, CY - 1 do
		if OPACO[self:get(x, yy, z)] then
			return false
		end
	end
	return true
end

return MundoDatos
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">Rayo</string><ProtectedString name="Source"><![CDATA[--[[
	Blockverse para Roblox · Rayo
	Recorre los bloques en línea recta (como lanzarRayo del juego web)
	para saber a qué bloque se apunta y por qué cara. Respeta las formas:
	losas, escaleras, puertas, plantas, antorchas, vallas, raíles…
]]
local Registro = require(script.Parent:WaitForChild("Registro"))
local Config = require(script.Parent:WaitForChild("Config"))

local BL = Registro.bloques
local FORMA = Registro.FORMA
local esLiquido = Registro.esLiquido
local BS = Config.BLOQUE

local Rayo = {}

-- Cajas que se pueden apuntar de un bloque (coordenadas dentro del bloque)
function Rayo.cajas(b)
	local def = BL[b]
	if not def then
		return nil
	end
	local f = FORMA[b]
	if f == 0 then
		return { { 0, 0, 0, 1, 1, 1 } }
	elseif f == 1 then
		return { { 0, 0, 0, 1, def.altura or 0.5, 1 } }
	elseif f == 2 then
		return { { 0.15, 0, 0.15, 0.85, 0.8, 0.85 } }
	elseif f == 3 then
		return { { 0.35, 0, 0.35, 0.65, 0.65, 0.65 } }
	elseif f == 6 then
		return def.cajas
	elseif f == 7 then
		return { { 0.25, 0, 0.25, 0.75, 1, 0.75 } }
	elseif f == 8 or f == 9 then
		return { { 0, 0, 0, 1, 0.0625, 1 } }
	elseif f == 5 then
		return { { 0, 0, 0.375, 1, 1, 0.625 } }
	end
	return nil
end

-- Intersección rayo-caja (método de las placas). Devuelve t y el eje de la normal.
local function rayoCaja(ox, oy, oz, dx, dy, dz, x0, y0, z0, x1, y1, z1)
	local tmin, tmax = -math.huge, math.huge
	local eje, signo = 0, 0
	local o = { ox, oy, oz }
	local d = { dx, dy, dz }
	local a = { x0, y0, z0 }
	local b = { x1, y1, z1 }
	for i = 1, 3 do
		if math.abs(d[i]) < 1e-9 then
			if o[i] < a[i] or o[i] > b[i] then
				return nil
			end
		else
			local t1 = (a[i] - o[i]) / d[i]
			local t2 = (b[i] - o[i]) / d[i]
			local s = -1
			if t1 > t2 then
				t1, t2 = t2, t1
				s = 1
			end
			if t1 > tmin then
				tmin = t1
				eje, signo = i, s
			end
			if t2 < tmax then
				tmax = t2
			end
			if tmin > tmax then
				return nil
			end
		end
	end
	if tmax < 0 then
		return nil
	end
	return math.max(tmin, 0), eje, signo
end

--[[
	md: MundoDatos (o algo con :get(x,y,z))
	origen: Vector3 en studs; dir: Vector3 unitario; alcance: en bloques
	Devuelve {x, y, z, b, n = {nx, ny, nz}, t = distancia en bloques} o nil
	opc.liquidos = true para apuntar también al agua y la lava
]]
function Rayo.lanzar(md, origen, dir, alcance, opc)
	local ox, oy, oz = origen.X / BS, origen.Y / BS, origen.Z / BS
	local dx, dy, dz = dir.X, dir.Y, dir.Z
	local x, y, z = math.floor(ox), math.floor(oy), math.floor(oz)
	local sx, sy, sz = dx > 0 and 1 or -1, dy > 0 and 1 or -1, dz > 0 and 1 or -1
	local tdx = dx ~= 0 and math.abs(1 / dx) or math.huge
	local tdy = dy ~= 0 and math.abs(1 / dy) or math.huge
	local tdz = dz ~= 0 and math.abs(1 / dz) or math.huge
	local tmx = dx ~= 0 and ((dx > 0 and (x + 1 - ox) or (ox - x)) * tdx) or math.huge
	local tmy = dy ~= 0 and ((dy > 0 and (y + 1 - oy) or (oy - y)) * tdy) or math.huge
	local tmz = dz ~= 0 and ((dz > 0 and (z + 1 - oz) or (oz - z)) * tdz) or math.huge
	local liquidos = opc and opc.liquidos
	for _ = 1, math.ceil(alcance * 3) + 3 do
		local b = md:get(x, y, z)
		if b ~= 0 and (liquidos or not esLiquido(b)) then
			local cajas = Rayo.cajas(b)
			if esLiquido(b) then
				cajas = { { 0, 0, 0, 1, 1, 1 } }
			end
			if cajas then
				local mejor, eje, signo
				for _, c in cajas do
					local t, e, s = rayoCaja(ox - x, oy - y, oz - z, dx, dy, dz, c[1], c[2], c[3], c[4], c[5], c[6])
					if t and (not mejor or t < mejor) then
						mejor, eje, signo = t, e, s
					end
				end
				if mejor and mejor <= alcance then
					local n = { 0, 0, 0 }
					if eje > 0 then
						n[eje] = signo
					end
					return { x = x, y = y, z = z, b = b, n = n, t = mejor }
				end
			end
		end
		-- Siguiente celda
		local t
		if tmx < tmy and tmx < tmz then
			t = tmx
			x += sx
			tmx += tdx
		elseif tmy < tmz then
			t = tmy
			y += sy
			tmy += tdy
		else
			t = tmz
			z += sz
			tmz += tdz
		end
		if t > alcance then
			break
		end
	end
	return nil
end

return Rayo
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">Registro</string><ProtectedString name="Source"><![CDATA[--[[
	Blockverse para Roblox · Registro
	Junta los datos exportados del juego web (Datos/*) y prepara tablas
	rápidas para el resto del juego: qué bloques son sólidos, opacos,
	reemplazables, cuánto alumbran, qué herramienta los rompe, etc.
]]
local Datos = script.Parent:WaitForChild("Datos")
local BL = require(Datos:WaitForChild("Bloques"))
local OB = require(Datos:WaitForChild("Objetos"))
local CL = require(Datos:WaitForChild("Claves"))

local Registro = {}
Registro.bloques = BL
Registro.objetos = OB
Registro.B = CL.B
Registro.I = CL.I

-- Objetos propios de la versión de Roblox (Bed Wars); usan el icono de otro objeto
local EXTRA = {
	[900] = { nombre = "Globo salvavidas", max = 4, clave = "globoBW", icono = 220 },
	[901] = { nombre = "Escudo de cama", max = 1, clave = "escudoCamaBW", icono = 597 },
	[902] = { nombre = "Trampolín", max = 8, clave = "trampolinBW", icono = CL.B.heno },
	[903] = { nombre = "Mina terrestre", max = 8, clave = "minaBW", icono = 1219 },
	[904] = { nombre = "Torreta de nieve", max = 4, clave = "torretaBW", icono = 114 },
}
for id, o in EXTRA do
	if not OB[id] then
		OB[id] = o
		CL.I[o.clave] = id
	end
end

local B = CL.B
local SOLIDO, OPACO, REEMPL, TRANS, LUZ, FORMA, TINTE, OCLUYE, LIQUIDO = {}, {}, {}, {}, {}, {}, {}, {}, {}
local FORMAS = { cubo = 0, losa = 1, cruz = 2, antorcha = 3, liquido = 4, portal = 5, cajas = 6, conecta = 7, cable = 8, riel = 9 }
Registro.FORMAS = FORMAS
local MAX = 0
for id, b in BL do
	MAX = math.max(MAX, id)
	SOLIDO[id] = b.solido == true
	OPACO[id] = b.opaco == true
	REEMPL[id] = b.reemplazable == true
	TRANS[id] = b.trans == true
	LUZ[id] = b.luz or 0
	FORMA[id] = FORMAS[b.forma] or 0
	TINTE[id] = b.tinte
	OCLUYE[id] = b.forma == "cubo" and not b.sinSombra
	LIQUIDO[id] = b.liquido
end
SOLIDO[0], OPACO[0], REEMPL[0], TRANS[0], LUZ[0], FORMA[0], OCLUYE[0] = false, false, true, false, 0, -1, false
Registro.SOLIDO, Registro.OPACO, Registro.REEMPL, Registro.TRANS = SOLIDO, OPACO, REEMPL, TRANS
Registro.LUZ, Registro.FORMA, Registro.TINTE, Registro.OCLUYE, Registro.LIQUIDO = LUZ, FORMA, TINTE, OCLUYE, LIQUIDO
Registro.MAX_BLOQUE = MAX

-- Igual que en registro.js
function Registro.esTronco(id)
	return id == 4 or (id >= 94 and id <= 97) or id == 1294 or id == 1299 or id == 1321 or id == 1463
end
function Registro.esHojas(id)
	return id == 5 or (id >= 98 and id <= 101) or id == 1295 or id == 1300 or id == 1322 or id == 1464
end
function Registro.esAgua(id)
	return id >= 53 and id <= 60
end
function Registro.esLava(id)
	return id >= 61 and id <= 68
end
function Registro.esLiquido(id)
	return id >= 53 and id <= 68
end
function Registro.esPuerta(id)
	return id >= 149 and id <= 164
end
Registro.DIRF = { { 0, -1 }, { 1, 0 }, { 0, 1 }, { -1, 0 } }

------------------------------------------------------------------
-- Objetos
------------------------------------------------------------------
function Registro.nombre(id)
	local o = OB[id]
	if o then
		return o.nombre
	end
	local b = BL[id]
	return b and b.nombre or "?"
end

function Registro.maxPila(id)
	local o = OB[id]
	return o and o.max or 64
end

function Registro.esBloqueColocable(id)
	local o = OB[id]
	return o ~= nil and o.bloque == true and BL[id] ~= nil
end

-- Pila nueva (las herramientas guardan su durabilidad en `dur`)
function Registro.pila(id, n)
	local o = OB[id]
	if o and o.dur then
		return { id = id, n = 1, dur = o.dur }
	end
	return { id = id, n = n or 1 }
end

------------------------------------------------------------------
-- Romper bloques (como jugador.js: dureza, herramienta y nivel)
------------------------------------------------------------------
-- Datos de la herramienta en la mano: {tipo = "pico"|"hacha"|"pala"|"azada"|"espada", nivel, vel, dano, cad}
function Registro.herramienta(id)
	local o = id and OB[id]
	return o and o.herr or nil
end

-- Igual que puedeCosechar() de jugador.js: los bloques con nivel necesitan un pico de ese nivel
function Registro.puedeRecoger(b, herrId)
	local d = BL[b]
	if not d or not d.nivel or d.nivel <= 0 then
		return true
	end
	local h = Registro.herramienta(herrId)
	return h ~= nil and h.tipo == "pico" and (h.nivel or 0) >= d.nivel
end

-- Igual que tiempoRomper() de jugador.js (segundos)
function Registro.tiempoRomper(b, herrId, creativo, opc)
	local d = BL[b]
	if not d or d.dureza < 0 then
		return math.huge
	end
	if creativo then
		return 0
	end
	if d.dureza == 0 then
		return 0
	end
	local h = Registro.herramienta(herrId)
	local vel = 1
	if h and (d.herr == h.tipo or (h.tipo == "espada" and b == B.hojas)) then
		vel = h.vel or 1
	end
	if h and h.tipo == "espada" and b ~= B.hojas then
		vel = (b == B.telarana) and 15 or 1
	end
	if opc then
		if opc.bajoAgua then
			vel /= 5
		end
		if opc.enAire then
			vel /= 5
		end
	end
	local porTick = vel / d.dureza / (Registro.puedeRecoger(b, herrId) and 30 or 100)
	if porTick > 1 then
		return 0
	end
	return math.ceil(1 / porTick) / 20
end

-- Lo que suelta un bloque al romperlo: lista de {id, n}
function Registro.sueltaDe(b, herrId)
	local d = BL[b]
	if not d then
		return {}
	end
	if not Registro.puedeRecoger(b, herrId) then
		return {}
	end
	if d.sueltaMuestra then
		local r = {}
		for _, m in d.sueltaMuestra do
			local id, mn, mx, p = m[1], m[2], m[3], m[4]
			if math.random() < p and (OB[id] or BL[id]) then
				table.insert(r, { id, math.random(mn, mx) })
			end
		end
		return r
	end
	local s = d.suelta
	if s == nil then
		return OB[b] and { { b, 1 } } or {}
	end
	if s == 0 or s == false then
		return {}
	end
	return { { s, 1 } }
end

return Registro
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">Ruido</string><ProtectedString name="Source"><![CDATA[--!native
--!optimize 2
--[[
	Blockverse para Roblox · Ruido
	Copia exacta de las funciones de base.js del juego web (hash2, hash3,
	mulberry32, valueNoise, valueNoise3, fbm) para que el mismo número de
	semilla dé el mismo mundo. JavaScript trabaja con enteros de 32 bits:
	aquí se imitan con bit32 y números sin signo.
]]
local Ruido = {}

local M32 = 4294967296
local bxor, bor, rshift = bit32.bxor, bit32.bor, bit32.rshift

-- Math.imul: multiplicación de 32 bits (resultado sin signo).
-- Se parte `a` en dos mitades de 16 bits para no perder precisión.
local function imul(a: number, b: number): number
	a %= M32
	b %= M32
	return ((((a // 65536) * b) % 65536) * 65536 + (a % 65536) * b) % M32
end
Ruido.imul = imul

-- Math.round de JavaScript (los .5 suben siempre)
function Ruido.redondear(v: number): number
	return math.floor(v + 0.5)
end

function Ruido.hash2(x: number, z: number, s: number): number
	local h = (imul(x, 374761393) + imul(z, 668265263) + imul(s, 1442695041)) % M32
	h = imul(bxor(h, rshift(h, 13)), 1274126177)
	h = bxor(h, rshift(h, 16))
	return h / M32
end
local hash2 = Ruido.hash2

function Ruido.hash3(x: number, y: number, z: number, s: number): number
	local h = (imul(x, 374761393) + imul(y, 668265263) + imul(z, 1274126177) + imul(s, 1442695041)) % M32
	h = imul(bxor(h, rshift(h, 13)), 1103515245)
	h = bxor(h, rshift(h, 16))
	h = imul(bxor(h, rshift(h, 15)), 2246822519)
	h = bxor(h, rshift(h, 13))
	return h / M32
end
local hash3 = Ruido.hash3

function Ruido.mulberry32(a: number): () -> number
	a %= M32
	return function()
		a = (a + 0x6D2B79F5) % M32
		local t = imul(bxor(a, rshift(a, 15)), bor(1, a))
		t = bxor((t + imul(bxor(t, rshift(t, 7)), bor(61, t))) % M32, t)
		return bxor(t, rshift(t, 14)) / M32
	end
end

local function smooth(t: number): number
	return t * t * (3 - 2 * t)
end
Ruido.smooth = smooth

function Ruido.clamp(v: number, a: number, b: number): number
	return math.max(a, math.min(b, v))
end

function Ruido.lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

function Ruido.valueNoise(x: number, z: number, s: number): number
	local x0, z0 = math.floor(x), math.floor(z)
	local fx, fz = smooth(x - x0), smooth(z - z0)
	local a, b = hash2(x0, z0, s), hash2(x0 + 1, z0, s)
	local c, d = hash2(x0, z0 + 1, s), hash2(x0 + 1, z0 + 1, s)
	local ab = a + (b - a) * fx
	return ab + ((c + (d - c) * fx) - ab) * fz
end
local valueNoise = Ruido.valueNoise

function Ruido.valueNoise3(x: number, y: number, z: number, s: number): number
	local x0, y0, z0 = math.floor(x), math.floor(y), math.floor(z)
	local fx, fy, fz = smooth(x - x0), smooth(y - y0), smooth(z - z0)
	local function L(a, b, t)
		return a + (b - a) * t
	end
	local c000, c100 = hash3(x0, y0, z0, s), hash3(x0 + 1, y0, z0, s)
	local c010, c110 = hash3(x0, y0 + 1, z0, s), hash3(x0 + 1, y0 + 1, z0, s)
	local c001, c101 = hash3(x0, y0, z0 + 1, s), hash3(x0 + 1, y0, z0 + 1, s)
	local c011, c111 = hash3(x0, y0 + 1, z0 + 1, s), hash3(x0 + 1, y0 + 1, z0 + 1, s)
	return L(L(L(c000, c100, fx), L(c010, c110, fx), fy), L(L(c001, c101, fx), L(c011, c111, fx), fy), fz)
end

function Ruido.fbm(x: number, z: number, s: number, oct: number): number
	local v, amp, tot, f = 0, 1, 0, 1
	for i = 0, oct - 1 do
		v += valueNoise(x * f, z * f, s + i * 101) * amp
		tot += amp
		amp *= 0.5
		f *= 2
	end
	return v / tot
end

return Ruido
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX00000030"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX0000002F"><Properties><string name="Name">Servidor</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[--[[
	Blockverse para Roblox · Script principal del servidor
	Une todo el juego, con las reglas del juego web:
	· Mundo (igual al web), simulación, criaturas, entidades, cofres y hornos.
	· Jugadores: inventario de 41 casillas, crafteo 2x2 y 3x3, vida,
	  hambre y saturación, experiencia, armadura, aire, fuego, efectos de
	  pociones, muerte (se sueltan los objetos) y reaparición en la cama.
	· Acciones: picar, poner (con orientación de escaleras, antorchas y
	  puertas), usar objetos (comer, arco, cubos, azada, semillas, polvo de
	  hueso, mechero, tijeras, huevos, perlas, pociones, armadura), abrir
	  mesas, hornos y cofres, dormir, abrir puertas y atacar.
	· Día y noche, iluminación y guardado del inventario.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")

------------------------------------------------------------------
-- Comunicación (se crea antes de cargar los módulos que la usan)
------------------------------------------------------------------
local remotos = Instance.new("Folder")
remotos.Name = "Remotos"
local function remoto(clase, nombre)
	local r = Instance.new(clase)
	r.Name = nombre
	r.Parent = remotos
	return r
end
local Accion = remoto("RemoteEvent", "Accion")
local Estado = remoto("RemoteEvent", "Estado")
remoto("RemoteEvent", "Bloques")
local Ediciones = remoto("RemoteFunction", "Ediciones")
remotos.Parent = ReplicatedStorage

local Comp = ReplicatedStorage:WaitForChild("Blockverse")
local Config = require(Comp.Config)
local Registro = require(Comp.Registro)
local Crafteo = require(Comp.Crafteo)
local Rayo = require(Comp.Rayo)
local MundoDatos = require(Comp.MundoDatos)
local Mundo = require(script.Mundo)
local Sim = require(script.Simulacion)
local Entidades = require(script.Entidades)
local Mobs = require(script.Mobs)
local Inv = require(script.Inventario)
local Cont = require(script.Contenedores)
local Modos = require(script.Modos)
local Habitantes = require(script.Habitantes)
local Dimension = require(script.Dimension)
local Redstone = require(script.Redstone)
local Mesas = require(script.Mesas)
local Generador = require(Comp.Generador)

local BS = Config.BLOQUE
local BL, OB = Registro.bloques, Registro.objetos
local B, I = Registro.B, Registro.I
local SOLIDO, OPACO, REEMPL, FORMA = Registro.SOLIDO, Registro.OPACO, Registro.REEMPL, Registro.FORMA
local esAgua, esLava, esLiquido, esPuerta = Registro.esAgua, Registro.esLava, Registro.esLiquido, Registro.esPuerta
local DIRF = Registro.DIRF
local CX, CZ, CY = MundoDatos.CX, MundoDatos.CZ, MundoDatos.CY

------------------------------------------------------------------
-- Iluminación, cielo y ciclo de día y noche
------------------------------------------------------------------
local function iluminacion()
	Lighting.Brightness = 2.6
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.2
	Lighting.GlobalShadows = true
	Lighting.Ambient = Color3.fromRGB(70, 74, 86)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 160)
	Lighting.ClockTime = 8
	Lighting.GeographicLatitude = 20
	Lighting.ShadowSoftness = 0.3
	for _, c in Lighting:GetChildren() do
		if c:IsA("PostEffect") or c:IsA("Atmosphere") or c:IsA("Sky") then
			c:Destroy()
		end
	end
	local atm = Instance.new("Atmosphere")
	atm.Density = 0.28
	atm.Offset = 0.08
	atm.Color = Color3.fromRGB(190, 214, 245)
	atm.Decay = Color3.fromRGB(120, 140, 170)
	atm.Glare = 0.25
	atm.Haze = 1.1
	atm.Parent = Lighting
	local sky = Instance.new("Sky")
	sky.StarCount = 3000
	sky.SunAngularSize = 12
	sky.MoonAngularSize = 9
	sky.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.35
	bloom.Size = 22
	bloom.Threshold = 1.8
	bloom.Parent = Lighting
	local rayos = Instance.new("SunRaysEffect")
	rayos.Intensity = 0.05
	rayos.Spread = 0.7
	rayos.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.15
	cc.Contrast = 0.05
	cc.Parent = Lighting
	local nubes = workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	nubes.Cover = 0.5
	nubes.Density = 0.75
	nubes.Parent = workspace.Terrain
	workspace.Terrain.WaterColor = Color3.fromRGB(63, 118, 228)
	workspace.Terrain.WaterTransparency = 0.55
	workspace.Terrain.WaterReflectance = 0.35
	workspace.Terrain.WaterWaveSize = 0.05
	workspace.Terrain.WaterWaveSpeed = 6
end
iluminacion()

RunService.Heartbeat:Connect(function(dt)
	Lighting.ClockTime = (Lighting.ClockTime + dt * 24 / Config.DIA_SEGUNDOS) % 24
end)

------------------------------------------------------------------
-- Mundo
------------------------------------------------------------------
local semilla = Random.new():NextInteger(1, 999999)
Mundo.iniciar(semilla)
Cont.md = Mundo.md
workspace:SetAttribute("Semilla", semilla)
print("[Blockverse] Semilla del mundo:", semilla)
Sim.iniciar()
Entidades.iniciar()
Cont.iniciar()
Mobs.iniciar()
Habitantes.iniciar()
Habitantes.alSonido = function(nombre, x, y, z)
	Estado:FireAllClients("sonido", nombre, Vector3.new(x + 0.5, y + 0.5, z + 0.5) * Config.BLOQUE)
end

local NIVEL_MAR = 126
local spawnX, spawnZ = 0, 0
do
	local gen = Mundo.md.gen
	local hecho = false
	for r = 0, 2000, 16 do
		local pasos = math.max(1, r // 8)
		for k = 0, pasos - 1 do
			local a = k / pasos * math.pi * 2
			local x, z = math.floor(math.cos(a) * r), math.floor(math.sin(a) * r)
			local h, bioma = gen:infoColumna(x, z)
			if h > NIVEL_MAR and bioma ~= 0 and bioma ~= 13 and bioma ~= 21 and bioma ~= 22 and bioma ~= 29 and bioma ~= 6 and bioma ~= 20 then
				spawnX, spawnZ = x, z
				hecho = true
				break
			end
		end
		if hecho then
			break
		end
	end
end
workspace:SetAttribute("SpawnX", spawnX)
workspace:SetAttribute("SpawnZ", spawnZ)

------------------------------------------------------------------
-- Estado de los jugadores
------------------------------------------------------------------
local estados = {}
local almacen
pcall(function()
	almacen = DataStoreService:GetDataStore("Blockverse_v2")
end)

local function st(plr)
	return estados[plr]
end

local function xpNecesaria(n)
	return n <= 15 and 2 * n + 7 or n <= 30 and 5 * n - 38 or 9 * n - 158
end

local function supervivencia(s)
	return s.modo ~= "creativo"
end

local function aviso(plr, texto)
	Estado:FireClient(plr, "aviso", texto)
end

local function humanoide(plr)
	local ch = plr.Character
	return ch and ch:FindFirstChildOfClass("Humanoid"), ch and ch:FindFirstChild("HumanoidRootPart")
end

-- Pies del personaje (en bloques)
local function piesDe(plr)
	local h, r = humanoide(plr)
	if not r then
		return nil
	end
	local p = r.Position
	local alto = (h and h.HipHeight or 2) + r.Size.Y / 2
	return Vector3.new(p.X / BS, (p.Y - alto) / BS, p.Z / BS)
end

local function enviarJugador(plr)
	local s = st(plr)
	if not s then
		return
	end
	local h = humanoide(plr)
	Estado:FireClient(plr, "jugador", {
		inv = s.inv, sel = s.sel, cursor = s.cursor or false, hambre = s.hambre, saturacion = s.saturacion,
		xp = s.xp, aire = s.aire, modo = s.modo, efectos = s.efectos, vida = h and h.Health or 20,
	})
	local p = s.inv[s.sel]
	plr:SetAttribute("EnMano", p and p.id or nil)
end

local function enviarUI(plr)
	local s = st(plr)
	if not s then
		return
	end
	local ui = s.ui
	local datos = { tipo = ui and ui.tipo or "inventario", cursor = s.cursor or false, inv = s.inv }
	if not ui or ui.tipo == "inventario" or ui.tipo == "mesa" then
		local w = (ui and ui.tipo == "mesa") and 3 or 2
		datos.rejilla = s.rejilla
		datos.w = w
		local res = Inv.resultado(s.rejilla, w)
		datos.salida = res or false
	elseif ui.tipo == "horno" then
		local hh = Cont.horno(ui.x, ui.y, ui.z)
		datos.horno = { entrada = hh.entrada, combustible = hh.combustible, salida = hh.salida,
			quema = hh.quemaMax > 0 and hh.quema / hh.quemaMax or 0, prog = hh.prog / Crafteo.TIEMPO_FUNDIR, tipo = hh.tipo }
	elseif ui.tipo == "cofre" then
		datos.cofre = Cont.cofre(ui.x, ui.y, ui.z)
	elseif ui.tipo == "extra" then
		datos.extra = Mesas.datos(plr, s)
	end
	Estado:FireClient(plr, "ui", datos)
end

local function dar(plr, pila)
	local s = st(plr)
	if not s then
		return pila.n
	end
	local sobra = Inv.dar(s.inv, pila)
	enviarJugador(plr)
	if s.ui then
		enviarUI(plr)
	end
	return sobra
end

-- Da al jugador o suelta lo que no cabe
local function darOSoltar(plr, pila)
	local sobra = dar(plr, pila)
	if sobra > 0 then
		local p = piesDe(plr)
		if p then
			local resto = Inv.copia(pila)
			resto.n = sobra
			Entidades.soltarItem(resto, p.X, p.Y + 1, p.Z, true)
		end
	end
end

local function ganarXP(plr, v)
	local s = st(plr)
	if not s then
		return
	end
	s.xp.puntos += v
	local subio = false
	while s.xp.puntos >= xpNecesaria(s.xp.nivel) do
		s.xp.puntos -= xpNecesaria(s.xp.nivel)
		s.xp.nivel += 1
		subio = true
	end
	if subio and s.xp.nivel % 5 == 0 then
		Estado:FireClient(plr, "sonido", "nivel")
	end
	enviarJugador(plr)
end

local function gastarEnMano(plr, s, n)
	if not supervivencia(s) then
		return
	end
	local p = s.inv[s.sel]
	if not p then
		return
	end
	local o = OB[p.id]
	if o and o.dur then
		p.dur = (p.dur or o.dur) - (n or 1)
		if p.dur <= 0 then
			s.inv[s.sel] = false
			Estado:FireClient(plr, "sonido", "rompeHerr")
		end
	end
end

local function consumirEnMano(s, n)
	if not supervivencia(s) then
		return
	end
	local p = s.inv[s.sel]
	if p then
		p.n -= n or 1
		if p.n <= 0 then
			s.inv[s.sel] = false
		end
	end
end

------------------------------------------------------------------
-- Daño (fórmulas de danarJugador del juego web)
------------------------------------------------------------------
local function armaduraTotal(s)
	local def, dur = 0, 0
	for i = 37, 40 do
		local p = s.inv[i]
		local o = p and OB[p.id]
		if o and o.armadura then
			def += o.armadura.def or 0
			dur += o.armadura.dureza or 0
		end
	end
	return def, dur
end

local function desgastarArmadura(s, n)
	for i = 37, 40 do
		local p = s.inv[i]
		local o = p and OB[p.id]
		if o and o.armadura and o.dur then
			p.dur = (p.dur or o.dur) - math.max(1, math.floor(n / 4))
			if p.dur <= 0 then
				s.inv[i] = false
			end
		end
	end
end

local function danar(plr, n, tipo, dir)
	local s = st(plr)
	local h, root = humanoide(plr)
	if not s or not h or h.Health <= 0 or n <= 0 then
		return
	end
	if not supervivencia(s) and tipo ~= "vacio" then
		return
	end
	n = Modos.modDano(plr, n, tipo)
	if n <= 0 then
		return
	end
	if s.efectos.resistenciaFuego and (tipo == "fuego" or tipo == "lava") then
		return
	end
	local ahora = os.clock()
	if ahora < s.invuln and tipo ~= "vacio" then
		if n <= s.ultimoDano then
			return
		end
		n -= s.ultimoDano
	end
	local d = n
	if tipo == "mob" or tipo == "flecha" or tipo == "explosion" or tipo == "jugador" then
		local def, dur = armaduraTotal(s)
		d = d * (1 - math.min(20, math.max(def / 5, def - d / (2 + dur / 4))) / 25)
		-- Protección (encantamiento): 4 % menos por nivel, hasta un 80 %
		local prot = 0
		for i = 37, 40 do
			local pz = s.inv[i]
			prot += pz and pz.enc and (pz.enc.proteccion or 0) or 0
		end
		d *= 1 - math.min(20, prot) * 0.04
		desgastarArmadura(s, n)
	end
	if s.efectos.resistencia then
		d *= 0.8
	end
	if ahora >= s.invuln then
		s.ultimoDano = n
	end
	s.invuln = ahora + 0.5
	s.agotamiento += 0.1
	h.Health = math.max(0, h.Health - d)
	s.ultimaCausa = tipo
	Estado:FireClient(plr, "dano", dir and Vector3.new(dir.x * 6 * BS / 3, 4.5 * BS / 3, dir.z * 6 * BS / 3) or nil)
	enviarJugador(plr)
end

------------------------------------------------------------------
-- Entradas y salidas de jugadores
------------------------------------------------------------------
local function nuevoEstado()
	return {
		inv = Inv.nuevo(), sel = 1, cursor = false, rejilla = table.create(9, false), ui = nil,
		hambre = 20, saturacion = 5, agotamiento = 0, xp = { nivel = 0, puntos = 0 }, modo = nil,
		aire = 15, fuego = 0, efectos = {}, invuln = 0, ultimoDano = 0, ultimoAtaque = 0, regenT = 0, hambreT = 0, aireT = 0,
		contactoT = 0, fuegoT = 0, efectoT = 0, cama = nil, golpe = nil, ultimaPos = nil,
	}
end

local function cargar(plr)
	local s = nuevoEstado()
	estados[plr] = s
	if almacen then
		local ok, g = pcall(function()
			return almacen:GetAsync("u_" .. plr.UserId)
		end)
		if ok and type(g) == "table" and type(g.inv) == "table" then
			for i = 1, Inv.TAM do
				local p = g.inv[i]
				if type(p) == "table" and (OB[p.id] or BL[p.id]) and type(p.n) == "number" then
					s.inv[i] = { id = p.id, n = math.clamp(p.n, 1, Registro.maxPila(p.id)), dur = p.dur }
				end
			end
			if type(g.xp) == "table" then
				s.xp = { nivel = tonumber(g.xp.nivel) or 0, puntos = tonumber(g.xp.puntos) or 0 }
			end
			s.hambre = tonumber(g.hambre) or 20
		end
	end
end

local function guardar(plr)
	local s = st(plr)
	if not s or not almacen or s.modo == "creativo" or s.ob or Modos.activo(plr) then
		return
	end
	pcall(function()
		almacen:SetAsync("u_" .. plr.UserId, { inv = s.inv, xp = s.xp, hambre = s.hambre })
	end)
end

local function puntoAparicion(plr, s)
	if s and s.cama then
		return s.cama[1], s.cama[3]
	end
	local m = Modos.puntoAparicion(plr)
	if m then
		return m[1], m[3]
	end
	return spawnX + math.random(-3, 3), spawnZ + math.random(-3, 3)
end

local function colocar(plr, char)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	local hum = char:WaitForChild("Humanoid", 10)
	if not root or not hum then
		return
	end
	hum.MaxHealth = 20
	hum.Health = 20
	hum.UseJumpPower = false
	hum.JumpHeight = 1.25 * BS + 0.4 -- un bloque y un poco
	hum.WalkSpeed = 4.3 * BS
	hum.BreakJointsOnDeath = false
	root.Anchored = true
	local s = st(plr)
	local x, z = puntoAparicion(plr, s)
	plr:SetAttribute("EsperaX", x)
	plr:SetAttribute("EsperaZ", z)
	local cx, cz = x // CX, z // CZ
	for dx = -1, 1 do
		for dz = -1, 1 do
			Mundo.asegurarFisica(cx + dx, cz + dz)
			task.wait()
		end
	end
	if not char.Parent then
		return
	end
	local y
	local mm = Modos.puntoAparicion(plr)
	if s and s.cama then
		y = s.cama[2] + 1
	elseif mm then
		y = mm[2]
	else
		y = Mundo.alturaSuelo(x, z) + 1
	end
	char:PivotTo(CFrame.new((x + 0.5) * BS, y * BS + 3.2, (z + 0.5) * BS))
	root.Anchored = false
	plr:SetAttribute("EsperaX", nil)
	plr:SetAttribute("EsperaZ", nil)
	Estado:FireClient(plr, "listo")
	Modos.alAparecer(plr)
	enviarJugador(plr)
end

-- Dinamita encendida: explota a los 4 segundos
local function activarTNT(x, y, z)
	Estado:FireAllClients("tnt", Vector3.new(x + 0.5, y + 0.5, z + 0.5) * BS)
	task.delay(4, function()
		Sim.explosion(x + 0.5, y + 0.5, z + 0.5, 4)
	end)
end

-- Lleva al jugador a (x, y, z) en bloques (pies); prepara las colisiones antes
local function teletransportar(plr, x, y, z, titulo)
	local h, root = humanoide(plr)
	if not root then
		return
	end
	local s = st(plr)
	if s and s.ui then
		s.ui = nil
	end
	root.Anchored = true
	Estado:FireClient(plr, "viaje", titulo)
	local cx, cz = math.floor(x) // CX, math.floor(z) // CZ
	for dx = -1, 1 do
		for dz = -1, 1 do
			Mundo.asegurarFisica(cx + dx, cz + dz)
			task.wait()
		end
	end
	if not root.Parent then
		return
	end
	root.Parent:PivotTo(CFrame.new(x * BS, y * BS + 3.2, z * BS))
	root.AssemblyLinearVelocity = Vector3.zero
	plr:SetAttribute("Dimension", Generador.dimensionBloque(math.floor(z)))
	task.delay(0.4, function()
		if root.Parent then
			root.Anchored = false
		end
	end)
	if titulo then
		Estado:FireClient(plr, "titulo", "", titulo, "#ffffff")
	end
	local _ = h
end

local function alMorir(plr)
	local s = st(plr)
	if not s then
		return
	end
	local p = s.ultimaPos
	local modoInv = Modos.inventarioAlMorir(plr, s)
	if modoInv == "borrar" then
		for i = 1, Inv.TAM do
			s.inv[i] = false
		end
		s.cursor = false
	end
	if p and supervivencia(s) and not modoInv and not Modos.mantenerInventario(plr) then
		for i = 1, Inv.TAM do
			if s.inv[i] then
				Entidades.soltarItem(s.inv[i], p.X, p.Y + 1, p.Z, true)
				s.inv[i] = false
			end
		end
		if s.cursor then
			Entidades.soltarItem(s.cursor, p.X, p.Y + 1, p.Z, true)
			s.cursor = false
		end
		Entidades.soltarXP(math.min(100, s.xp.nivel * 7), p.X, p.Y, p.Z)
		s.xp = { nivel = 0, puntos = 0 }
	end
	local textos = {
		caida = "Caíste desde muy alto.", mob = "Una criatura acabó contigo.", flecha = "Te dispararon una flecha.",
		hambre = "Moriste de hambre.", vacio = "Caíste al vacío.", lava = "Intentaste nadar en lava.", fuego = "Ardiste hasta morir.",
		ahogo = "Te ahogaste.", explosion = "Volaste por los aires.", cactus = "Te pinchaste hasta morir.", veneno = "El veneno pudo contigo.",
		jugador = "Otro jugador acabó contigo.",
	}
	enviarJugador(plr)
	Estado:FireClient(plr, "muerte", (textos[s.ultimaCausa or ""] or "Has muerto.") .. ((supervivencia(s) and not modoInv) and " Tus objetos quedaron donde caíste." or ""))
	s.efectos = {}
	s.fuego = 0
	Modos.alMorir(plr)
end

Players.PlayerAdded:Connect(function(plr)
	cargar(plr)
	plr.CharacterAdded:Connect(function(char)
		local s = st(plr)
		if s then
			s.hambre, s.saturacion, s.agotamiento, s.aire = 20, 5, 0, 15
		end
		task.spawn(colocar, plr, char)
		local hum = char:WaitForChild("Humanoid", 10)
		if hum then
			hum.Died:Connect(function()
				alMorir(plr)
			end)
		end
		task.defer(enviarJugador, plr)
	end)
	task.defer(enviarJugador, plr)
end)

Players.PlayerRemoving:Connect(function(plr)
	-- Si estaba en un modo (Bed Wars, Mazmorras, Leyendas), recupera su inventario antes de guardar
	pcall(Modos.alSalirJugador, plr)
	local s = st(plr)
	if s and s.ui then
		s.ui = nil
	end
	guardar(plr)
	estados[plr] = nil
end)

game:BindToClose(function()
	for _, plr in Players:GetPlayers() do
		guardar(plr)
	end
end)

------------------------------------------------------------------
-- Colisiones alrededor de los jugadores
------------------------------------------------------------------
task.spawn(function()
	local R = Config.RADIO_FISICA
	while true do
		local quiero = {}
		local centros = {}
		for _, plr in Players:GetPlayers() do
			local ex, ez = plr:GetAttribute("EsperaX"), plr:GetAttribute("EsperaZ")
			local cx, cz
			if ex then
				cx, cz = ex // CX, ez // CZ
			else
				local p = piesDe(plr)
				if p then
					cx, cz = math.floor(p.X) // CX, math.floor(p.Z) // CZ
				end
			end
			if cx then
				table.insert(centros, { cx, cz })
			end
		end
		local hecho = false
		for _, c in centros do
			for dx = -R, R do
				for dz = -R, R do
					quiero[MundoDatos.clave(c[1] + dx, c[2] + dz)] = true
				end
			end
		end
		-- El más cercano que falte
		for _, c in centros do
			if hecho then
				break
			end
			for r = 0, R do
				for dx = -r, r do
					for dz = -r, r do
						if not hecho and math.max(math.abs(dx), math.abs(dz)) == r and not Mundo.tieneFisica(c[1] + dx, c[2] + dz) then
							Mundo.asegurarFisica(c[1] + dx, c[2] + dz)
							hecho = true
						end
					end
				end
			end
		end
		for k in Mundo.fisica do
			if not quiero[k] then
				local cx, cz = MundoDatos.desclave(k)
				local lejos = true
				for _, c in centros do
					if math.max(math.abs(cx - c[1]), math.abs(cz - c[2])) <= R + 1 then
						lejos = false
					end
				end
				if lejos then
					Mundo.quitarFisica(cx, cz)
				end
			end
		end
		-- Liberar datos lejanos sin cambios
		for k in Mundo.md.datos do
			local cx, cz = MundoDatos.desclave(k)
			local lejos = true
			for _, c in centros do
				if math.max(math.abs(cx - c[1]), math.abs(cz - c[2])) <= R + 6 then
					lejos = false
				end
			end
			if lejos and not Mundo.fisica[k] then
				Mundo.md:descargar(cx, cz)
			end
		end
		task.wait(hecho and 0 or 0.25)
	end
end)

-- Los clientes piden las ediciones de los chunks que van a dibujar
Ediciones.OnServerInvoke = function(plr, lista)
	local r = {}
	if type(lista) ~= "table" then
		return r
	end
	for i, c in lista do
		if i > 64 then
			break
		end
		if type(c) == "table" and type(c[1]) == "number" and type(c[2]) == "number" then
			local ed = Mundo.ediciones(c[1], c[2])
			if ed and next(ed) then
				local t = {}
				for idx, id in ed do
					t[tostring(idx)] = id
				end
				r[tostring(MundoDatos.clave(c[1], c[2]))] = t
			end
		end
	end
	return r
end

------------------------------------------------------------------
-- Ayudas para las acciones
------------------------------------------------------------------
local function esEntero(v)
	return type(v) == "number" and v == math.floor(v) and math.abs(v) < 1e7
end

local function ojos(plr)
	local ch = plr.Character
	local h = ch and ch:FindFirstChild("Head")
	return h and h.Position
end

local function alAlcance(plr, x, y, z, extra)
	local p = ojos(plr)
	if not p then
		return false
	end
	local c = Vector3.new((x + 0.5) * BS, (y + 0.5) * BS, (z + 0.5) * BS)
	return (c - p).Magnitude <= (Config.ALCANCE + (extra or 2)) * BS
end

-- ¿El bloque (con sus cajas) se mete en algún jugador o criatura?
local function cubreEntidad(id, x, y, z)
	if not SOLIDO[id] then
		return false
	end
	local cajas = (FORMA[id] == 6 and BL[id].cajas) or (FORMA[id] == 1 and { { 0, 0, 0, 1, BL[id].altura or 0.5, 1 } }) or { { 0, 0, 0, 1, 1, 1 } }
	for _, c in cajas do
		local X0, Y0, Z0, X1, Y1, Z1 = x + c[1], y + c[2], z + c[3], x + c[4], y + c[5], z + c[6]
		for _, plr in Players:GetPlayers() do
			local p = piesDe(plr)
			if p and X1 > p.X - 0.3 and X0 < p.X + 0.3 and Y1 > p.Y and Y0 < p.Y + 1.8 and Z1 > p.Z - 0.3 and Z0 < p.Z + 0.3 then
				return true
			end
		end
		for _, m in Mobs.lista do
			if not m.muerto and X1 > m.x - m.ancho and X0 < m.x + m.ancho and Y1 > m.y and Y0 < m.y + m.alto and Z1 > m.z - m.ancho and Z0 < m.z + m.ancho then
				return true
			end
		end
	end
	return false
end

local function facing(dir)
	local dx, dz = dir.X, dir.Z
	if math.abs(dx) > math.abs(dz) then
		return dx > 0 and 1 or 3
	end
	return dz > 0 and 2 or 0
end

-- Soltar lo que da un bloque (con experiencia de las menas)
local function soltarBloque(id, x, y, z, herrId, plr)
	local s = plr and st(plr)
	local lista
	if herrId == I.tijeras and (Registro.esHojas(id) or id == B.hierbaAlta or id == B.helecho or (BL[id] and (BL[id].clave or ""):find("^hojas"))) then
		lista = { { id, 1 } }
	else
		lista = Registro.sueltaDe(id, herrId)
	end
	for _, d in lista do
		if d[2] > 0 and (OB[d[1]] or BL[d[1]]) then
			Entidades.soltarItem(Registro.pila(d[1], d[2]), x + 0.5, y + 0.3, z + 0.5, true)
		end
	end
	local def = BL[id]
	if def and def.xp and Registro.puedeRecoger(id, herrId) and (not s or supervivencia(s)) then
		local v = math.random(def.xp[1] or 0, def.xp[2] or 0)
		if v > 0 then
			Entidades.soltarXP(v, x + 0.5, y + 0.5, z + 0.5)
		end
	end
end

Sim.alRomper = function(id, x, y, z)
	if Cont.esCofre(id) or Cont.esHorno(id) then
		Cont.vaciar(x, y, z)
	end
	soltarBloque(id, x, y, z, nil, nil)
end

------------------------------------------------------------------
-- Explosiones, criaturas y proyectiles
------------------------------------------------------------------
local function danoExplosion(x, y, z, potencia, fuente)
	local alcance = potencia * 2
	local function calc(px, py, pz, alto)
		local cy = py + alto / 2
		local d = math.sqrt((px - x) ^ 2 + (cy - y) ^ 2 + (pz - z) ^ 2)
		if d > alcance then
			return nil
		end
		local imp = 1 - d / alcance
		local dano = math.floor(((imp * imp + imp) / 2) * 7 * alcance + 1)
		local l = d > 0 and d or 1
		return dano, { x = (px - x) / l * imp, y = (cy - y) / l * imp, z = (pz - z) / l * imp }
	end
	for _, plr in Players:GetPlayers() do
		local p = piesDe(plr)
		if p then
			local dano, dir = calc(p.X, p.Y, p.Z, 1.8)
			if dano then
				local lh = math.sqrt(dir.x * dir.x + dir.z * dir.z)
				danar(plr, dano, "explosion", { x = dir.x / (lh > 0 and lh or 1), z = dir.z / (lh > 0 and lh or 1) })
			end
		end
	end
	for _, m in Mobs.lista do
		if m ~= fuente and not m.muerto then
			local dano, dir = calc(m.x, m.y, m.z, m.alto)
			if dano then
				Mobs.herir(m, dano, { x = dir.x, z = dir.z }, "explosion")
				m.vy += dir.y * 6 + 2
			end
		end
	end
	for _, e in Entidades.lista do
		if e.tipo == "item" and not e.muerta and math.abs(e.x - x) + math.abs(e.y - y) + math.abs(e.z - z) < potencia then
			e.muerta = true
			e.pieza:Destroy()
		end
	end
	Estado:FireAllClients("explosion", Vector3.new(x, y, z) * BS, potencia)
end
Sim.alExplotar = danoExplosion
Mobs.alExplotar = function(x, y, z, potencia, fuente)
	Sim.explosion(x, y, z, potencia, { fuente = fuente })
end
Mobs.alDanarJugador = function(plr, dano, tipo, dir)
	danar(plr, dano, tipo, dir)
end
Mobs.esCreativo = function(plr)
	local s = st(plr)
	return s ~= nil and not supervivencia(s)
end

Entidades.alRecoger = function(plr, pila)
	local s = st(plr)
	if not s then
		return pila.n
	end
	local h = humanoide(plr)
	if not h or h.Health <= 0 then
		return pila.n
	end
	local sobra = Inv.dar(s.inv, pila)
	if sobra < pila.n then
		Estado:FireClient(plr, "sonido", "recoger")
		enviarJugador(plr)
		if s.ui then
			enviarUI(plr)
		end
	end
	return sobra
end
Entidades.alXP = function(plr, v)
	ganarXP(plr, v)
	Estado:FireClient(plr, "sonido", "xp")
end

-- Impacto de flechas, bolas de fuego y perlas
Entidades.alImpacto = function(e, modo)
	local opc = e.opc
	if modo == "buscar" then
		-- El dragón y los cristales del End
		if (e.tipo == "flecha" or e.tipo == "tridente") and Dimension.golpeProyectil(e.x, e.y, e.z, opc.dano) then
			return true
		end
		-- Criaturas
		for _, m in Mobs.lista do
			if not m.muerto and m ~= opc.dueno and e.x > m.x - m.ancho - 0.1 and e.x < m.x + m.ancho + 0.1 and e.y > m.y and e.y < m.y + m.alto
				and e.z > m.z - m.ancho - 0.1 and e.z < m.z + m.ancho + 0.1 then
				local v = math.sqrt(e.vx * e.vx + e.vy * e.vy + e.vz * e.vz)
				if e.tipo == "flecha" then
					local dano = opc.dano or math.ceil(v / 30 * 6)
					local l = math.sqrt(e.vx * e.vx + e.vz * e.vz)
					Mobs.herir(m, dano, { x = e.vx / (l > 0 and l or 1) * 0.5, z = e.vz / (l > 0 and l or 1) * 0.5 }, opc.jugador and "flechaJugador" or "flecha", 0, opc.jugador)
				elseif e.tipo == "bolaFuego" then
					Mobs.herir(m, 5, nil, "fuego")
					m.fuego = 5
				elseif e.tipo == "bolaGhast" then
					Sim.explosion(e.x, e.y, e.z, 1, { fuente = opc.dueno })
				elseif e.tipo == "perla" and opc.jugador then
					return true
				end
				return true
			end
		end
		-- Jugadores
		for _, plr in Players:GetPlayers() do
			if plr ~= opc.jugador and not (opc.jugador and Modos.pvp(opc.jugador, plr) == false) then
				local p = piesDe(plr)
				if p and e.x > p.X - 0.4 and e.x < p.X + 0.4 and e.y > p.Y and e.y < p.Y + 1.8 and e.z > p.Z - 0.4 and e.z < p.Z + 0.4 then
					local l = math.sqrt(e.vx * e.vx + e.vz * e.vz)
					local dir = { x = e.vx / (l > 0 and l or 1), z = e.vz / (l > 0 and l or 1) }
					if e.tipo == "flecha" then
						danar(plr, opc.dano or 3, "flecha", dir)
					elseif e.tipo == "bolaFuego" then
						danar(plr, 5, "fuego", dir)
						local s = st(plr)
						if s then
							s.fuego = math.max(s.fuego, 5)
						end
					elseif e.tipo == "bolaGhast" then
						Sim.explosion(e.x, e.y, e.z, 1, { fuente = opc.dueno })
					end
					return true
				end
			end
		end
		return nil
	end
	-- Choca con un bloque
	if e.tipo == "bolaGhast" then
		Sim.explosion(e.x, e.y, e.z, 1, { fuente = opc.dueno })
	elseif e.tipo == "bolaFuego" then
		local x, y, z = math.floor(e.x - e.vx * 0.02), math.floor(e.y - e.vy * 0.02), math.floor(e.z - e.vz * 0.02)
		if Mundo.get(x, y, z) == 0 then
			Mundo.set(x, y, z, B.fuego)
		end
	elseif e.tipo == "perla" and opc.jugador then
		local ch = opc.jugador.Character
		if ch then
			ch:PivotTo(CFrame.new(e.x * BS, (e.y + 1) * BS + 3, e.z * BS))
			danar(opc.jugador, 5, "caida")
		end
	end
	return nil
end

Cont.alCambiarHorno = function(k)
	local h = Cont.hornos[k]
	if h then
		-- Bloque encendido o apagado
		local id = Mundo.get(h.x, h.y, h.z)
		local par = { [17] = 1662, [1608] = 1663, [1609] = 1664 }
		local inv = { [1662] = 17, [1663] = 1608, [1664] = 1609 }
		if h.quema > 0 and par[id] then
			Mundo.set(h.x, h.y, h.z, par[id], { sinAviso = true })
		elseif h.quema <= 0 and inv[id] then
			Mundo.set(h.x, h.y, h.z, inv[id], { sinAviso = true })
		end
	end
	for plr, s in estados do
		if s.ui and s.ui.tipo == "horno" and Cont.clave(s.ui.x, s.ui.y, s.ui.z) == k then
			enviarUI(plr)
		end
	end
end

------------------------------------------------------------------
-- Acciones
------------------------------------------------------------------
local acciones = {}

function acciones.sel(plr, s, i)
	if esEntero(i) and i >= 1 and i <= 9 then
		s.sel = i
		s.comiendoDesde = nil
		s.arcoDesde = nil
		enviarJugador(plr)
	end
end

function acciones.golpe(plr, s, x, y, z)
	if esEntero(x) and esEntero(y) and esEntero(z) then
		s.golpe = { x = x, y = y, z = z, t = os.clock() }
		Modos.golpeBloque(plr, x, y, z)
	end
end

function acciones.romper(plr, s, x, y, z)
	if not (esEntero(x) and esEntero(y) and esEntero(z)) or not alAlcance(plr, x, y, z) then
		return
	end
	local b = Mundo.get(x, y, z)
	local def = BL[b]
	if b == 0 or not def or esLiquido(b) or not Modos.puedeRomper(plr, x, y, z, b) then
		return
	end
	local creativo = not supervivencia(s)
	local mano = s.inv[s.sel]
	local herrId = mano and mano.id or nil
	if creativo then
		if mano and OB[mano.id] and OB[mano.id].herr and OB[mano.id].herr.tipo == "espada" then
			return
		end
	else
		if def.dureza < 0 then
			return
		end
		local t = Registro.tiempoRomper(b, herrId)
		local g = s.golpe
		if t > 0.05 and (not g or g.x ~= x or g.y ~= y or g.z ~= z or os.clock() - g.t < t * 0.6 - 0.25) then
			return
		end
	end
	s.golpe = nil
	-- Puertas: se rompen las dos mitades
	if def.puerta then
		local otro = y + (def.puerta.m == 1 and -1 or 1)
		if BL[Mundo.get(x, otro, z)] and BL[Mundo.get(x, otro, z)].puerta then
			Mundo.set(x, otro, z, 0, { sinAviso = true })
		end
	end
	if Cont.esCofre(b) or Cont.esHorno(b) then
		Cont.vaciar(x, y, z)
		-- A quien lo tuviera abierto se le cierra la pantalla
		for otro, so in estados do
			if so.ui and (so.ui.tipo == "cofre" or so.ui.tipo == "horno") and so.ui.x == x and so.ui.y == y and so.ui.z == z then
				Estado:FireClient(otro, "cerrarUI")
			end
		end
	end
	Mundo.set(x, y, z, 0)
	if not creativo then
		soltarBloque(b, x, y, z, herrId, plr)
		if def.dureza > 0 then
			local h = Registro.herramienta(herrId)
			if h then
				gastarEnMano(plr, s, h.tipo == "espada" and 2 or 1)
			end
		end
		s.agotamiento += 0.005
	end
	Modos.alRomper(plr, x, y, z, b)
	enviarJugador(plr)
end

-- Colocar un bloque (colocarBloque de jugador.js)
local function colocarBloque(plr, s, id, x, y, z, n, dir)
	if y < 0 or y >= CY then
		return false
	end
	local actual = Mundo.get(x, y, z)
	if actual ~= 0 and not REEMPL[actual] then
		return false
	end
	local def = BL[id]
	if not def then
		return false
	end
	local real = id
	if def.orienta == "escalera" then
		real = def.base + facing(dir)
	elseif def.orienta == "pared" or id == B.antorcha then
		if n[2] ~= 0 then
			if id ~= B.antorcha then
				return false
			end
		else
			local f = -1
			for k, d in DIRF do
				if d[1] == -n[1] and d[2] == -n[3] then
					f = k - 1
				end
			end
			if f < 0 then
				return false
			end
			local pared = Mundo.get(x + DIRF[f + 1][1], y, z + DIRF[f + 1][2])
			if not SOLIDO[pared] or FORMA[pared] ~= 0 then
				return false
			end
			real = id == B.antorcha and 165 + f or def.base + f
		end
	end
	-- Pistones: miran hacia donde mira el jugador (como en jugador.js)
	if def.piston then
		local a = { math.abs(dir.X), math.abs(dir.Y), math.abs(dir.Z) }
		local eje = (a[1] >= a[2] and a[1] >= a[3]) and 0 or (a[2] >= a[3] and 1 or 2)
		local comp = ({ dir.X, dir.Y, dir.Z })[eje + 1]
		real = ((def.piston.peg and def.piston.peg ~= 0) and 1242 or 1224) + eje * 2 + (comp > 0 and 0 or 1)
	end
	-- Plantas y cosas que necesitan apoyo
	if real == id and (def.forma == "cruz" or def.forma == "antorcha") and not SOLIDO[Mundo.get(x, y - 1, z)] and id ~= B.nenufar then
		return false
	end
	if cubreEntidad(real, x, y, z) then
		return false
	end
	if not Modos.puedePoner(plr, x, y, z, real) then
		return false
	end
	if actual ~= 0 and not esLiquido(actual) then
		soltarBloque(actual, x, y, z, nil, plr)
	end
	Mundo.set(x, y, z, real)
	Modos.alPoner(plr, x, y, z, real)
	if Redstone.esRiel(real) then
		Redstone.colocarRiel(x, y, z, facing(dir))
	end
	if real == B.calabaza or real == B.linternaCalabaza then
		-- Gólem de hierro o de nieve
		local abajo, abajo2 = Mundo.get(x, y - 1, z), Mundo.get(x, y - 2, z)
		if abajo == B.bloqueNieve and abajo2 == B.bloqueNieve and Mobs.DEF.golemNieve then
			for k = 0, 2 do
				Mundo.set(x, y - k, z, 0)
			end
			Mobs.crear("golemNieve", x + 0.5, y - 2, z + 0.5)
		elseif abajo == B.bloqueHierro and abajo2 == B.bloqueHierro then
			Mundo.set(x, y, z, 0)
			Mundo.set(x, y - 1, z, 0)
			Mundo.set(x, y - 2, z, 0)
			local m = Mobs.crear("golem", x + 0.5, y - 2, z + 0.5)
			if m then
				m.domado = true
			end
		end
	end
	Estado:FireClient(plr, "sonido", "poner", Vector3.new(x + 0.5, y + 0.5, z + 0.5) * BS)
	return true
end

local function colocarPuerta(plr, s, x, y, z, dir)
	local a, b = Mundo.get(x, y, z), Mundo.get(x, y + 1, z)
	if (a ~= 0 and not REEMPL[a]) or (b ~= 0 and not REEMPL[b]) or not SOLIDO[Mundo.get(x, y - 1, z)] then
		return false
	end
	local f = facing(dir)
	local id = 149 + f * 4
	if cubreEntidad(id, x, y, z) or cubreEntidad(id + 1, x, y + 1, z) then
		return false
	end
	Mundo.set(x, y, z, id, { sinAviso = true })
	Mundo.set(x, y + 1, z, id + 1)
	return true
end

local function alternarPuerta(x, y, z)
	local b = Mundo.get(x, y, z)
	local pu = BL[b] and BL[b].puerta
	if not pu then
		return
	end
	local yb = pu.m == 1 and y - 1 or y
	local base = 149 + pu.f * 4 + (1 - pu.ab) * 2
	Mundo.set(x, yb, z, base, { sinAviso = true })
	Mundo.set(x, yb + 1, z, base + 1, { sinAviso = true })
end

local CULTIVOS = {}
for clave, bloque in { semillas = "trigo0", zanahoria = "zanahorias0", patata = "patatas0", semillasRemolacha = "remolachas0" } do
	if I[clave] and B[bloque] then
		CULTIVOS[I[clave]] = B[bloque]
	end
end
if not CULTIVOS[640] and B.zanahorias0 then
	CULTIVOS[640] = B.zanahorias0
end
if not CULTIVOS[641] and B.patatas0 then
	CULTIVOS[641] = B.patatas0
end
if not CULTIVOS[679] and B.remolachas0 then
	CULTIVOS[679] = B.remolachas0
end

local function aplicarEfecto(s, nombre, seg, nivel)
	if nombre == "curacion" then
		return "curar"
	end
	local e = s.efectos[nombre]
	if not e or e.t < seg then
		s.efectos[nombre] = { t = seg, n = nivel or 1 }
	end
end

-- Clic derecho (usarDerecho de jugador.js)
-- obj: {x, y, z, n} del bloque apuntado (o nil); dir: dirección de la mirada; mob: pieza de criatura apuntada
function acciones.derecho(plr, s, obj, dir, mobParte, agachado)
	if typeof(dir) ~= "Vector3" then
		return
	end
	dir = dir.Unit
	local p = s.inv[s.sel]
	local id = p and p.id or 0
	local o = id ~= 0 and OB[id] or nil
	local h = humanoide(plr)
	-- Criaturas: alimentar, esquilar, comerciar
	if typeof(mobParte) == "Instance" then
		local m = Mobs.desdeParte(mobParte)
		local pp = piesDe(plr)
		if m and pp and math.abs(m.x - pp.X) + math.abs(m.z - pp.Z) < 8 and Modos.usarMob(plr, s, m) then
			return
		end
		if m and pp and math.abs(m.x - pp.X) + math.abs(m.z - pp.Z) < 8 and m.tipo == "aldeano" and m.ofertas and #m.ofertas > 0
			and not agachado then
			-- Comerciar
			Mesas.abrir(plr, s, "aldeano", nil, nil, nil, m)
			enviarUI(plr)
			return
		end
		if m and pp and math.abs(m.x - pp.X) + math.abs(m.z - pp.Z) < 8 then
			if m.def.comida == id and m.bebe <= 0 and m.amor <= 0 then
				m.amor = 30
				consumirEnMano(s)
				enviarJugador(plr)
				return
			end
			if id == I.tijeras and m.tipo == "oveja" and not m.esquilada then
				m.esquilada = true
				m.pieza:SetAttribute("esquilada", true)
				Entidades.soltarItem(Registro.pila(B.lana, math.random(1, 3)), m.x, m.y + 1, m.z, true)
				gastarEnMano(plr, s, 1)
				enviarJugador(plr)
				return
			end
			if o and o.huevo then
				-- un huevo usado sobre una criatura crea una cría
				Mobs.crear(o.huevo, m.x, m.y, m.z, { bebe = true })
				consumirEnMano(s)
				enviarJugador(plr)
				return
			end
		end
	end
	-- Objetos especiales de los modos (bola de fuego, huevo puente, artefactos…)
	if Modos.usarObjeto(plr, s, p, dir, obj) then
		return
	end
	local x, y, z, n
	if type(obj) == "table" and esEntero(obj.x) and esEntero(obj.y) and esEntero(obj.z) and type(obj.n) == "table" then
		x, y, z = obj.x, obj.y, obj.z
		n = { math.clamp(tonumber(obj.n[1]) or 0, -1, 1), math.clamp(tonumber(obj.n[2]) or 0, -1, 1), math.clamp(tonumber(obj.n[3]) or 0, -1, 1) }
		if not alAlcance(plr, x, y, z) then
			return
		end
	end
	local b = x and Mundo.get(x, y, z) or 0
	-- Bloques con los que se interactúa
	if x and not agachado then
		local def = BL[b]
		local inter = def and def.inter
		if def and def.redstone and Redstone.usar(x, y, z, b) then
			return
		end
		if esPuerta(b) then
			alternarPuerta(x, y, z)
			Estado:FireClient(plr, "sonido", "puerta")
			return
		end
		if inter == "cama" and Modos.activo(plr) then
			inter = nil
		end
		if inter == "cama" then
			s.cama = { x, y, z }
			if not Mobs.esDeNoche() then
				aviso(plr, "Solo puedes dormir de noche. Punto de reaparición guardado.")
				return
			end
			for _, m in Mobs.lista do
				if not m.muerto and m.def.tipo == "hostil" and math.abs(m.x - x) + math.abs(m.z - z) < 8 then
					aviso(plr, "No puedes descansar ahora, hay monstruos cerca.")
					return
				end
			end
			Estado:FireClient(plr, "dormir")
			task.delay(2.2, function()
				Lighting.ClockTime = 6.2
				aviso(plr, "Buenos días. Punto de reaparición guardado.")
			end)
			return
		end
		if inter == "mesa" then
			s.ui = { tipo = "mesa", x = x, y = y, z = z }
			enviarUI(plr)
			return
		end
		if inter == "horno" then
			local tipo = (b == 1608 or b == 1663) and "ahumador" or (b == 1609 or b == 1664) and "altoHorno" or "horno"
			Cont.horno(x, y, z, tipo)
			s.ui = { tipo = "horno", x = x, y = y, z = z }
			enviarUI(plr)
			return
		end
		if inter == "cofre" then
			Cont.cofre(x, y, z)
			s.ui = { tipo = "cofre", x = x, y = y, z = z }
			enviarUI(plr)
			Estado:FireAllClients("cofreAbierto", Vector3.new(x, y, z), true)
			return
		end
		if inter == "encantar" or inter == "yunque" or inter == "afiladora" or inter == "herreria" or inter == "pociones" then
			Mesas.abrir(plr, s, inter, x, y, z)
			enviarUI(plr)
			return
		end
		if inter then
			return
		end
		if b == B.marcoEnd and id == I.ojoEnder then
			Mundo.set(x, y, z, B.marcoEndOjo)
			consumirEnMano(s)
			enviarJugador(plr)
			if Dimension.comprobarPortalEnd(x, y, z) then
				Estado:FireAllClients("sonido", "portal", Vector3.new(x + 0.5, y + 0.5, z + 0.5) * BS)
				aviso(plr, "El portal del End se ha activado.")
			end
			return
		end
		if b == B.boveda and id == 541 then
			if Habitantes.abrirBoveda(x, y, z) then
				consumirEnMano(s)
				enviarJugador(plr)
			end
			return
		end
		if b == B.tnt and id == I.mechero then
			Mundo.set(x, y, z, 0)
			activarTNT(x, y, z)
			gastarEnMano(plr, s, 1)
			enviarJugador(plr)
			return
		end
	end
	if not o and not (id ~= 0 and BL[id]) then
		return
	end
	o = o or {}
	-- Comer y beber (empieza; el cliente avisa al terminar)
	if (o.comida or o.bebida) and (s.hambre < 20 or o.siempre or o.bebida or not supervivencia(s)) then
		s.comiendoDesde = os.clock()
		s.comiendoId = id
		return
	end
	if id == I.arco then
		local tiene = not supervivencia(s) or Inv.contar(s.inv, I.flecha) > 0
		if tiene then
			s.arcoDesde = os.clock()
		end
		return
	end
	if o.armadura then
		local slot = 37 + o.armadura.pieza
		local prev = s.inv[slot]
		s.inv[slot] = p
		s.inv[s.sel] = prev or false
		Estado:FireClient(plr, "sonido", "armadura")
		enviarJugador(plr)
		return
	end
	if o.huevo and x then
		local tx, ty, tz = x + n[1], y + n[2], z + n[3]
		Mobs.crear(o.huevo, tx + 0.5, ty, tz + 0.5)
		consumirEnMano(s)
		enviarJugador(plr)
		return
	end
	if id == I.perlaEnder then
		local e = ojos(plr)
		if e then
			Entidades.disparar("perla", e.X / BS + dir.X, e.Y / BS + dir.Y, e.Z / BS + dir.Z, dir, 28, { jugador = plr })
			consumirEnMano(s)
			enviarJugador(plr)
		end
		return
	end
	if o.pocion and o.pocion.arrojadiza then
		-- Se rompe delante y afecta a quien esté cerca
		local e = ojos(plr)
		local cx, cy, cz = e.X / BS + dir.X * 3, e.Y / BS + dir.Y * 3, e.Z / BS + dir.Z * 3
		for _, otro in Players:GetPlayers() do
			local pp = piesDe(otro)
			local so = st(otro)
			if pp and so and math.abs(pp.X - cx) + math.abs(pp.Z - cz) < 4 then
				if aplicarEfecto(so, o.pocion.efecto, 30, 1) == "curar" then
					local hh = humanoide(otro)
					if hh then
						hh.Health = math.min(hh.MaxHealth, hh.Health + 4)
					end
				end
				enviarJugador(otro)
			end
		end
		Estado:FireAllClients("pocion", Vector3.new(cx, cy, cz) * BS, o.pocion.color or 0xff00ff)
		consumirEnMano(s)
		enviarJugador(plr)
		return
	end
	-- Cubos
	if id == I.cubo then
		local e = ojos(plr)
		local r = Rayo.lanzar(Mundo.md, e, dir, Config.ALCANCE, { liquidos = true })
		if r and esLiquido(r.b) and (BL[r.b].nivelL or 0) == 0 then
			Mundo.set(r.x, r.y, r.z, 0)
			Estado:FireClient(plr, "sonido", esAgua(r.b) and "agua" or "lava")
			if supervivencia(s) then
				local lleno = Registro.pila(esAgua(r.b) and I.cuboAgua or I.cuboLava, 1)
				if p.n == 1 then
					s.inv[s.sel] = lleno
				else
					p.n -= 1
					darOSoltar(plr, lleno)
				end
			end
			enviarJugador(plr)
		end
		return
	end
	if (id == I.cuboAgua or id == I.cuboLava) and x then
		local tx, ty, tz = x, y, z
		if not REEMPL[b] or esLiquido(b) then
			tx, ty, tz = x + n[1], y + n[2], z + n[3]
		end
		local act = Mundo.get(tx, ty, tz)
		if act ~= 0 and not REEMPL[act] then
			return
		end
		if act ~= 0 and not esLiquido(act) then
			soltarBloque(act, tx, ty, tz, nil, plr)
		end
		if id == I.cuboAgua and Dimension.de(tz) == "nether" then
			-- En el Nether el agua se evapora
			Estado:FireAllClients("particulas", Vector3.new(tx + 0.5, ty + 0.5, tz + 0.5) * BS, 0xdddddd)
		else
			Mundo.set(tx, ty, tz, id == I.cuboAgua and B.agua or B.lava)
		end
		if supervivencia(s) then
			s.inv[s.sel] = Registro.pila(I.cubo, 1)
		end
		enviarJugador(plr)
		return
	end
	if id == I.mechero and x then
		local tx, ty, tz = x + n[1], y + n[2], z + n[3]
		if Mundo.get(tx, ty, tz) ~= 0 then
			return
		end
		-- ¿Enciende un portal del Nether?
		if b == B.obsidiana and Dimension.encender(tx, ty, tz) then
			Estado:FireAllClients("sonido", "portal", Vector3.new(tx + 0.5, ty + 0.5, tz + 0.5) * BS)
			gastarEnMano(plr, s, 1)
			enviarJugador(plr)
			return
		end
		if SOLIDO[Mundo.get(tx, ty - 1, tz)] then
			Mundo.set(tx, ty, tz, B.fuego)
			gastarEnMano(plr, s, 1)
			enviarJugador(plr)
		end
		return
	end
	if id == I.harinaHueso and x then
		local usado = false
		if B.trigo0 and b >= B.trigo0 and b < B.trigo0 + 7 then
			Mundo.set(x, y, z, math.min(B.trigo0 + 7, b + math.random(2, 5)))
			usado = true
		elseif BL[b] and BL[b].cultivo and BL[b + 1] and BL[b + 1].cultivo then
			Mundo.set(x, y, z, b + 1)
			usado = true
		elseif Sim.TIPO_BROTE[b] then
			if math.random() < 0.45 then
				Sim.crecerArbol(x, y, z)
			end
			usado = true
		elseif b == B.cesped and Mundo.get(x, y + 1, z) == 0 then
			for _ = 1, 12 do
				local nx, nz = x + math.random(-3, 3), z + math.random(-3, 3)
				if Mundo.get(nx, y, nz) == B.cesped and Mundo.get(nx, y + 1, nz) == 0 then
					Mundo.set(nx, y + 1, nz, math.random() < 0.85 and B.hierbaAlta or (math.random() < 0.5 and B.florAmarilla or B.florRoja))
				end
			end
			usado = true
		end
		if usado then
			consumirEnMano(s)
			Estado:FireAllClients("particulas", Vector3.new(x + 0.5, y + 1, z + 0.5) * BS, 0x60ff60)
			enviarJugador(plr)
		end
		return
	end
	if o.tipoHerr == "azada" and x then
		if (b == B.cesped or b == B.tierra) and Mundo.get(x, y + 1, z) == 0 then
			Mundo.set(x, y, z, B.cultivo)
			gastarEnMano(plr, s, 1)
			enviarJugador(plr)
		end
		return
	end
	if CULTIVOS[id] and x then
		if b == B.cultivo and Mundo.get(x, y + 1, z) == 0 then
			Mundo.set(x, y + 1, z, CULTIVOS[id])
			consumirEnMano(s)
			enviarJugador(plr)
		end
		return
	end
	if o.coloca == "puerta" and x then
		local tx, ty, tz = x, y, z
		if not REEMPL[b] or esLiquido(b) then
			tx, ty, tz = x + n[1], y + n[2], z + n[3]
		end
		if colocarPuerta(plr, s, tx, ty, tz, dir) then
			consumirEnMano(s)
			enviarJugador(plr)
		end
		return
	end
	if o.coloca == "cable" and x then
		if colocarBloque(plr, s, B.cable0 or 0, x + n[1], y + n[2], z + n[3], n, dir) then
			consumirEnMano(s)
			enviarJugador(plr)
		end
		return
	end
	-- Poner bloques
	if (o.bloque or (BL[id] and not OB[id])) and x then
		local tx, ty, tz = x, y, z
		if not (REEMPL[b] and not esLiquido(b) and b ~= B.fuego) then
			tx, ty, tz = x + n[1], y + n[2], z + n[3]
		end
		if id == B.nenufar then
			local e = ojos(plr)
			local r = Rayo.lanzar(Mundo.md, e, dir, Config.ALCANCE, { liquidos = true })
			if not r or r.b ~= B.agua or Mundo.get(r.x, r.y + 1, r.z) ~= 0 then
				return
			end
			tx, ty, tz = r.x, r.y + 1, r.z
		end
		if colocarBloque(plr, s, id, tx, ty, tz, n, dir) then
			consumirEnMano(s)
			enviarJugador(plr)
		end
	end
end

function acciones.terminarComer(plr, s)
	local p = s.inv[s.sel]
	if not p or not s.comiendoDesde or p.id ~= s.comiendoId or os.clock() - s.comiendoDesde < 1.3 then
		return
	end
	s.comiendoDesde = nil
	local o = OB[p.id]
	if not o then
		return
	end
	local h = humanoide(plr)
	if o.comida then
		s.hambre = math.min(20, s.hambre + o.comida[1])
		s.saturacion = math.min(s.hambre, s.saturacion + (o.comida[2] or 0))
		if o.efecto and math.random() < (o.efecto[3] or 1) then
			aplicarEfecto(s, o.efecto[1], o.efecto[2], 1)
		end
	end
	if o.pocion then
		if aplicarEfecto(s, o.pocion.efecto, 180, 1) == "curar" and h then
			h.Health = math.min(h.MaxHealth, h.Health + 4)
		end
	end
	if supervivencia(s) then
		p.n -= 1
		if p.n <= 0 then
			s.inv[s.sel] = false
		end
		if o.bebida then
			darOSoltar(plr, Registro.pila(I.frascoVacio or 500, 1))
		elseif o.devuelve then
			darOSoltar(plr, Registro.pila(o.devuelve, 1))
		end
	end
	Estado:FireClient(plr, "sonido", o.bebida and "beber" or "comer")
	enviarJugador(plr)
end

function acciones.soltarArco(plr, s, dir)
	if not s.arcoDesde or typeof(dir) ~= "Vector3" then
		return
	end
	local carga = math.min(1, (os.clock() - s.arcoDesde) / 1)
	s.arcoDesde = nil
	if carga < 0.1 then
		return
	end
	local p = s.inv[s.sel]
	if not p or p.id ~= I.arco then
		return
	end
	if supervivencia(s) then
		if not Inv.quitar(s.inv, I.flecha, 1) then
			return
		end
		gastarEnMano(plr, s, 1)
	end
	local e = ojos(plr)
	dir = dir.Unit
	local vel = 10 + carga * 32
	local dano = math.ceil(carga * carga * 6 + 0.5) + (s.efectos.fuerza and 3 or 0)
	-- Poder (encantamiento): +25 % por nivel y un 25 % más
	local poder = p.enc and p.enc.poder or 0
	if poder > 0 then
		dano = math.ceil(dano * (1 + 0.25 * (poder + 1)))
	end
	Entidades.disparar("flecha", e.X / BS + dir.X * 0.5, e.Y / BS + dir.Y * 0.5, e.Z / BS + dir.Z * 0.5, dir, vel,
		{ jugador = plr, dano = dano, recogible = supervivencia(s) })
	Estado:FireClient(plr, "sonido", "arco")
	enviarJugador(plr)
end

-- Ataque a una criatura (carga = 0..1 según el tiempo desde el último golpe)
function acciones.atacar(plr, s, parte, carga, cayendo, corriendo)
	if typeof(parte) ~= "Instance" then
		return
	end
	-- El dragón y los cristales del End
	if parte.Name == "CristalEnd" then
		Dimension.romperCristal(parte:GetAttribute("Cristal"))
		return
	end
	if Dimension.esDragon(parte) then
		local p = s.inv[s.sel]
		local hh = p and OB[p.id] and OB[p.id].herr
		local cad = hh and hh.cad or 4
		local c = math.clamp((os.clock() - s.ultimoAtaque) * cad, 0, 1)
		s.ultimoAtaque = os.clock()
		local dano = (hh and hh.dano or 1) * (0.2 + 0.8 * c * c) + (s.efectos.fuerza and 3 or 0)
		if Dimension.herirDragon(dano, "jugador") then
			Estado:FireClient(plr, "golpeMob", parte.Position, dano, false)
		end
		if hh then
			gastarEnMano(plr, s, 1)
		end
		enviarJugador(plr)
		return
	end
	-- Otros jugadores: solo donde el modo lo permite (Bed Wars, entre equipos distintos)
	local otro = parte.Parent and (Players:GetPlayerFromCharacter(parte.Parent) or (parte.Parent.Parent and Players:GetPlayerFromCharacter(parte.Parent.Parent)))
	if otro then
		local e, po = ojos(plr), piesDe(otro)
		if otro == plr or not e or not po or ((po + Vector3.new(0, 0.9, 0)) * BS - e).Magnitude > (Config.ALCANCE + 1.5) * BS then
			return
		end
		if not Modos.pvp(plr, otro) then
			return
		end
		local p = s.inv[s.sel]
		local hh = p and OB[p.id] and OB[p.id].herr
		local cad = hh and hh.cad or 4
		local carga = math.clamp((os.clock() - s.ultimoAtaque) * cad, 0, 1)
		s.ultimoAtaque = os.clock()
		local dano = (hh and hh.dano or 1) * (0.2 + 0.8 * carga * carga) + (s.efectos.fuerza and 3 or 0)
		local filo = (p and p.enc and p.enc.filo or 0)
		if filo > 0 then
			dano += (0.5 * filo + 0.5) * carga
		end
		dano += Modos.extraDanoPvp(plr) * carga
		if cayendo == true and carga > 0.9 then
			dano *= 1.5
		end
		dano = Modos.golpePvp(plr, otro, dano)
		local pp = piesDe(plr)
		local dx, dz = po.X - pp.X, po.Z - pp.Z
		local l = math.sqrt(dx * dx + dz * dz)
		local emp = ((corriendo == true and carga > 0.9) and 1.6 or 1) * (1 + (p and p.enc and p.enc.retroceso or 0) * 0.6)
		danar(otro, dano, "jugador", { x = dx / (l > 0 and l or 1) * emp, z = dz / (l > 0 and l or 1) * emp })
		Estado:FireClient(plr, "golpeMob", (po + Vector3.new(0, 0.9, 0)) * BS, dano, cayendo == true and carga > 0.9)
		if hh then
			gastarEnMano(plr, s, hh.tipo == "espada" and 1 or 2)
		end
		enviarJugador(plr)
		return
	end
	local m = Mobs.desdeParte(parte)
	local e = ojos(plr)
	if not m or not e then
		return
	end
	local c = Vector3.new(m.x, m.y + m.alto / 2, m.z) * BS
	if (c - e).Magnitude > (Config.ALCANCE + 1.5) * BS then
		return
	end
	local p = s.inv[s.sel]
	local hh = p and OB[p.id] and OB[p.id].herr
	-- La carga la limita el servidor según el tiempo real
	local cad = hh and hh.cad or 4
	local cargaReal = math.clamp((os.clock() - s.ultimoAtaque) * cad, 0, 1)
	carga = math.min(type(carga) == "number" and carga or 1, cargaReal + 0.15)
	s.ultimoAtaque = os.clock()
	local dano = (hh and hh.dano or 1) * (0.2 + 0.8 * carga * carga)
	if s.efectos.fuerza then
		dano += 3
	end
	-- Filo (encantamiento), como en combate38.js
	local filo = p and p.enc and p.enc.filo or 0
	if filo > 0 then
		dano += (0.5 * filo + 0.5) * carga
	end
	local critico = cayendo == true and carga > 0.9
	if critico then
		dano *= 1.5
	end
	local pp = piesDe(plr)
	local dx, dz = m.x - pp.X, m.z - pp.Z
	local l = math.sqrt(dx * dx + dz * dz)
	local emp = ((corriendo == true and carga > 0.9) and 1.6 or 1) * (1 + (p and p.enc and p.enc.retroceso or 0) * 0.6)
	Mobs.herir(m, dano, { x = dx / (l > 0 and l or 1) * emp, z = dz / (l > 0 and l or 1) * emp }, "jugador", 0, plr)
	Estado:FireClient(plr, "golpeMob", c, dano, critico)
	if hh then
		gastarEnMano(plr, s, hh.tipo == "espada" and 1 or 2)
	end
	s.agotamiento += 0.1
	enviarJugador(plr)
end

------------------------------------------------------------------
-- Inventario e interfaz
------------------------------------------------------------------
local function cerrarUI(plr, s)
	Mesas.cerrar(plr, s)
	-- Lo que quedó en la rejilla y el cursor vuelve al inventario
	for k = 1, 9 do
		if s.rejilla[k] then
			darOSoltar(plr, s.rejilla[k])
			s.rejilla[k] = false
		end
	end
	if s.cursor then
		darOSoltar(plr, s.cursor)
		s.cursor = false
	end
	if s.ui and s.ui.tipo == "cofre" then
		Estado:FireAllClients("cofreAbierto", Vector3.new(s.ui.x, s.ui.y, s.ui.z), false)
	end
	s.ui = nil
	enviarJugador(plr)
end

function acciones.encantar(plr, s, i)
	if esEntero(i) then
		Mesas.encantar(plr, s, i)
		enviarJugador(plr)
		enviarUI(plr)
	end
end

-- Tiendas de los modos (Bed Wars): comprar una oferta (veces = mayúsculas + clic) o cambiar de pestaña
function acciones.comprar(plr, s, i, veces)
	if esEntero(i) and s.ui and s.ui.comprar then
		s.ui.comprar(plr, s, i, esEntero(veces) and veces or 1)
		enviarJugador(plr)
		enviarUI(plr)
	end
end

function acciones.pestana(plr, s, i)
	if esEntero(i) and s.ui and s.ui.pestana then
		s.ui.pestana(plr, s, i)
		enviarUI(plr)
	end
end

-- Órdenes de Leyendas (G, R, F, 1-6 o los botones del panel)
function acciones.modoCmd(plr, s, cmd, arg)
	if type(cmd) == "string" then
		Modos.comando(plr, cmd, type(arg) == "number" and arg or nil)
	end
end

function acciones.comerciar(plr, s, i)
	if esEntero(i) then
		Mesas.comerciar(plr, s, i)
		enviarJugador(plr)
		enviarUI(plr)
	end
end

function acciones.abrirInventario(plr, s)
	s.ui = { tipo = "inventario" }
	enviarUI(plr)
end

function acciones.cerrarUI(plr, s)
	cerrarUI(plr, s)
end

-- Mover rápido (mayúsculas + clic)
local function moverRapido(plr, s, zona, i)
	local inv = s.inv
	local ui = s.ui
	if zona == "inv" then
		local p = inv[i]
		if not p then
			return
		end
		inv[i] = false
		local sobra = p.n
		local o = OB[p.id]
		if ui and ui.tipo == "extra" and ui.sub ~= "aldeano" then
			sobra = Mesas.meterRapido(s, p)
		elseif ui and ui.tipo == "cofre" then
			sobra = Inv.meter(Cont.cofre(ui.x, ui.y, ui.z), p, 1, 27)
		elseif ui and ui.tipo == "horno" then
			local h = Cont.horno(ui.x, ui.y, ui.z)
			if Cont.sirve(h, p.id) and (not h.entrada or Inv.iguales(h.entrada, p)) then
				local t = { h.entrada }
				sobra = Inv.meter(t, p, 1, 1)
				h.entrada = t[1]
			elseif Crafteo.COMBUSTIBLE[p.id] and (not h.combustible or Inv.iguales(h.combustible, p)) then
				local t = { h.combustible }
				sobra = Inv.meter(t, p, 1, 1)
				h.combustible = t[1]
			end
		elseif o and o.armadura and not inv[37 + o.armadura.pieza] then
			inv[37 + o.armadura.pieza] = p
			sobra = 0
		elseif i <= 9 then
			sobra = Inv.meter(inv, p, 10, 36)
		elseif i <= 36 then
			sobra = Inv.meter(inv, p, 1, 9)
		else
			sobra = Inv.meter(inv, p, 10, 36)
			if sobra > 0 then
				local q = Inv.copia(p)
				q.n = sobra
				sobra = Inv.meter(inv, q, 1, 9)
			end
		end
		if sobra > 0 then
			local q = Inv.copia(p)
			q.n = sobra
			if inv[i] then
				Inv.dar(inv, q)
			else
				inv[i] = q
			end
		end
	elseif zona == "cofre" and ui and ui.tipo == "cofre" then
		local c = Cont.cofre(ui.x, ui.y, ui.z)
		local p = c[i]
		if p then
			c[i] = false
			local sobra = Inv.meter(inv, p, 10, 36, "inverso")
			if sobra > 0 then
				local q = Inv.copia(p)
				q.n = sobra
				sobra = Inv.meter(inv, q, 1, 9, "inverso")
			end
			if sobra > 0 then
				local q = Inv.copia(p)
				q.n = sobra
				c[i] = q
			end
		end
	elseif zona == "rejilla" then
		local p = s.rejilla[i]
		if p then
			s.rejilla[i] = false
			local sobra = Inv.dar(inv, p)
			if sobra > 0 then
				local q = Inv.copia(p)
				q.n = sobra
				s.rejilla[i] = q
			end
		end
	elseif zona == "horno" and ui and ui.tipo == "horno" then
		local h = Cont.horno(ui.x, ui.y, ui.z)
		local nom = ({ "entrada", "combustible", "salida" })[i]
		if nom and h[nom] then
			local sobra = Inv.dar(inv, h[nom])
			if sobra > 0 then
				h[nom].n = sobra
			else
				h[nom] = false
			end
		end
	end
end

-- Si otros jugadores tienen abierto el mismo cofre u horno, ven el cambio al momento
local function refrescarOtros(plr, s)
	local u = s.ui
	if not u or (u.tipo ~= "cofre" and u.tipo ~= "horno") then
		return
	end
	for otro, so in estados do
		if otro ~= plr and so.ui and so.ui.tipo == u.tipo and so.ui.x == u.x and so.ui.y == u.y and so.ui.z == u.z then
			enviarUI(otro)
		end
	end
end

function acciones.click(plr, s, zona, i, boton)
	if type(zona) ~= "string" or not esEntero(i) or not esEntero(boton) then
		return
	end
	local ui = s.ui or { tipo = "inventario" }
	s.ui = ui
	if boton == 3 then
		if zona == "salida" then
			-- Craftear todo lo que se pueda
			local w = ui.tipo == "mesa" and 3 or 2
			for _ = 1, 64 do
				local res = Inv.resultado(s.rejilla, w)
				if not res then
					break
				end
				local sobra = Inv.dar(s.inv, res)
				if sobra > 0 then
					local q = Inv.copia(res)
					q.n = sobra
					darOSoltar(plr, q)
					Inv.gastarRejilla(s.rejilla, w, s.inv)
					break
				end
				Inv.gastarRejilla(s.rejilla, w, s.inv)
			end
		else
			moverRapido(plr, s, zona, i)
		end
		enviarJugador(plr)
		enviarUI(plr)
		refrescarOtros(plr, s)
		return
	end
	if zona == "mesa" or zona == "mesaSalida" then
		Mesas.clic(plr, s, zona, i, boton)
	elseif zona == "inv" and i >= 1 and i <= Inv.TAM then
		Inv.clic(s, s.inv, i, boton, Inv.acepta)
	elseif zona == "rejilla" then
		local w = ui.tipo == "mesa" and 3 or 2
		if i >= 1 and i <= w * w then
			Inv.clic(s, s.rejilla, i, boton)
		end
	elseif zona == "salida" then
		local w = ui.tipo == "mesa" and 3 or 2
		local res = Inv.resultado(s.rejilla, w)
		if res then
			local c = s.cursor
			if not c then
				s.cursor = res
				Inv.gastarRejilla(s.rejilla, w, s.inv)
			elseif Inv.iguales(c, res) and c.n + res.n <= Registro.maxPila(c.id) then
				c.n += res.n
				Inv.gastarRejilla(s.rejilla, w, s.inv)
			end
		end
	elseif zona == "cofre" and ui.tipo == "cofre" and i >= 1 and i <= 27 then
		Inv.clic(s, Cont.cofre(ui.x, ui.y, ui.z), i, boton)
	elseif zona == "horno" and ui.tipo == "horno" and i >= 1 and i <= 3 then
		local h = Cont.horno(ui.x, ui.y, ui.z)
		local t = { h.entrada, h.combustible, h.salida }
		if i == 3 then
			-- La salida solo se recoge
			if t[3] and (not s.cursor or (Inv.iguales(s.cursor, t[3]) and s.cursor.n + t[3].n <= Registro.maxPila(t[3].id))) then
				if s.cursor then
					s.cursor.n += t[3].n
				else
					s.cursor = t[3]
				end
				h.salida = false
			end
		else
			Inv.clic(s, t, i, boton, function(k, pila)
				if k == 2 then
					return Crafteo.COMBUSTIBLE[pila.id] ~= nil
				end
				return true
			end)
			h.entrada, h.combustible = t[1] or false, t[2] or false
		end
	elseif zona == "borrar" then
		-- Papelera del inventario creativo
		if not supervivencia(s) then
			s.cursor = false
		end
	elseif zona == "fuera" then
		-- Tirar lo del cursor
		if s.cursor then
			local p = piesDe(plr)
			local e = ojos(plr)
			if p and e then
				local look = plr.Character.Head.CFrame.LookVector
				local soltar = s.cursor
				if boton == 2 then
					soltar = Inv.copia(s.cursor)
					soltar.n = 1
					s.cursor.n -= 1
					if s.cursor.n <= 0 then
						s.cursor = false
					end
				else
					s.cursor = false
				end
				Entidades.soltarItem(soltar, e.X / BS, e.Y / BS - 0.3, e.Z / BS, false, look * 5 + Vector3.new(0, 2, 0), 2)
			end
		end
	end
	enviarJugador(plr)
	enviarUI(plr)
	refrescarOtros(plr, s)
end

-- Libro de recetas: rellena la rejilla con los ingredientes de una receta
function acciones.receta(plr, s, k, todas)
	local r = Crafteo.RECETAS[k]
	if not esEntero(k) or not r then
		return
	end
	local ui = s.ui or { tipo = "inventario" }
	local w = ui.tipo == "mesa" and 3 or 2
	if Crafteo.necesitaMesa(r) and w < 3 then
		aviso(plr, "Necesitas una mesa de trabajo")
		return
	end
	-- Devolver lo que hubiera en la rejilla
	for i = 1, 9 do
		if s.rejilla[i] then
			Inv.dar(s.inv, s.rejilla[i])
			s.rejilla[i] = false
		end
	end
	local veces = todas and 64 or 1
	local g = Crafteo.rejillaDe(r, w)
	for _ = 1, veces do
		local ok = true
		local necesita = {}
		for i = 1, w * w do
			if g[i] ~= 0 then
				necesita[g[i]] = (necesita[g[i]] or 0) + 1
			end
		end
		for id, n in necesita do
			-- Acepta maderas equivalentes
			local hay = 0
			for j = 1, 36 do
				local p = s.inv[j]
				if p and Crafteo.equivale(p.id, id) then
					hay += p.n
				end
			end
			if hay < n then
				ok = false
			end
		end
		if not ok then
			break
		end
		for i = 1, w * w do
			if g[i] ~= 0 then
				for j = 36, 1, -1 do
					local p = s.inv[j]
					if p and Crafteo.equivale(p.id, g[i]) and (not s.rejilla[i] or s.rejilla[i].id == p.id) then
						p.n -= 1
						if s.rejilla[i] then
							s.rejilla[i].n += 1
						else
							s.rejilla[i] = { id = p.id, n = 1 }
						end
						if p.n <= 0 then
							s.inv[j] = false
						end
						break
					end
				end
			end
		end
		if s.rejilla[1] and s.rejilla[1].n >= Registro.maxPila(s.rejilla[1].id) then
			break
		end
	end
	enviarJugador(plr)
	enviarUI(plr)
end

-- Modo creativo: coger cualquier objeto
function acciones.creativo(plr, s, id, cantidad)
	if supervivencia(s) or not esEntero(id) or not (OB[id] or BL[id]) then
		return
	end
	local pila = Registro.pila(id, cantidad == "max" and Registro.maxPila(id) or 1)
	s.cursor = pila
	enviarUI(plr)
end

-- Vaciar todo el inventario (creativo, mayúsculas + papelera)
function acciones.vaciarCreativo(plr, s)
	if supervivencia(s) then
		return
	end
	for i = 1, Inv.TAM do
		s.inv[i] = false
	end
	s.cursor = false
	enviarJugador(plr)
	enviarUI(plr)
end

-- Elegir el bloque apuntado (botón central, creativo)
function acciones.elegirBloque(plr, s, id)
	if supervivencia(s) or not esEntero(id) or not OB[id] then
		return
	end
	for i = 1, 9 do
		local p = s.inv[i]
		if p and p.id == id then
			s.sel = i
			enviarJugador(plr)
			return
		end
	end
	s.inv[s.sel] = Registro.pila(id, Registro.maxPila(id))
	enviarJugador(plr)
end

-- Tirar lo que hay en la mano (tecla Q)
function acciones.tirar(plr, s, todo)
	local p = s.inv[s.sel]
	local e = ojos(plr)
	if not p or not e then
		return
	end
	local soltar = Inv.copia(p)
	if todo then
		s.inv[s.sel] = false
	else
		soltar.n = 1
		p.n -= 1
		if p.n <= 0 then
			s.inv[s.sel] = false
		end
	end
	local look = plr.Character.Head.CFrame.LookVector
	Entidades.soltarItem(soltar, e.X / BS, e.Y / BS - 0.3, e.Z / BS, false, look * 5 + Vector3.new(0, 2, 0), 2)
	enviarJugador(plr)
end

function acciones.modo(plr, s, m)
	if m ~= "creativo" and m ~= "supervivencia" then
		return
	end
	if Modos.activo(plr) then
		return
	end
	if s.modo == "supervivencia" and m == "creativo" then
		guardar(plr)
	end
	s.modo = m
	local h = humanoide(plr)
	if h then
		h.Health = h.MaxHealth
	end
	if m == "creativo" then
		s.hambre, s.saturacion = 20, 5
	end
	plr:SetAttribute("Modo", m)
	enviarJugador(plr)
end

-- El cliente avisa de caídas (en bloques), saltos y si corre
function acciones.caida(plr, s, n)
	if not supervivencia(s) or type(n) ~= "number" or n ~= n or n <= 3.5 then
		return
	end
	danar(plr, math.floor(math.min(n, 100) - 3), "caida")
end

function acciones.salto(plr, s)
	if supervivencia(s) then
		s.agotamiento += s.corriendo and 0.2 or 0.05
	end
end

function acciones.correr(plr, s, si)
	s.corriendo = si == true
	local h = humanoide(plr)
	if h then
		local vel = (s.corriendo and not (supervivencia(s) and s.hambre <= 6)) and 5.6 or 4.3
		if s.efectos.rapidez then
			vel *= 1.2
		end
		h.WalkSpeed = vel * BS
	end
end

-- Planear con élitros gasta 1 de durabilidad por segundo
function acciones.planeo(plr, s)
	local p = s.inv[38]
	if supervivencia(s) and p and p.id == I.elitros and p.dur and p.dur > 1 then
		p.dur -= 1
		if p.dur <= 1 then
			aviso(plr, "Tus élitros están rotos.")
		end
		enviarJugador(plr)
	end
end

-- Usar un cohete mientras se planea
function acciones.cohete(plr, s)
	local p = s.inv[s.sel]
	if p and p.id == I.cohete then
		consumirEnMano(s)
		enviarJugador(plr)
	end
end

function acciones.modoJuego(plr, s, nombre)
	Modos.pedir(plr, nombre)
end

Accion.OnServerEvent:Connect(function(plr, tipo, ...)
	local s = st(plr)
	local f = type(tipo) == "string" and acciones[tipo]
	if s and f then
		local ok, err = pcall(f, plr, s, ...)
		if not ok then
			warn("[Blockverse] Error en " .. tipo .. ": " .. tostring(err))
		end
	end
end)

------------------------------------------------------------------
-- Hambre, curación, aire, fuego, contacto con bloques y efectos
------------------------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
	for plr, s in estados do
		local h, root = humanoide(plr)
		if h and root and h.Health > 0 and not root.Anchored then
			local p = piesDe(plr)
			-- Movimiento (para el agotamiento)
			if s.ultimaPos and supervivencia(s) then
				local d = math.sqrt((p.X - s.ultimaPos.X) ^ 2 + (p.Z - s.ultimaPos.Z) ^ 2)
				if d < 3 then
					s.agotamiento += d * (s.corriendo and 0.1 or 0.0)
				end
			end
			s.ultimaPos = p
			-- Vacío
			if p.Y < -16 then
				danar(plr, 4 * dt * 10, "vacio")
				if p.Y < -64 then
					h.Health = 0
				end
			end
			local md = Mundo.md
			local bx, bz = math.floor(p.X), math.floor(p.Z)
			local bPies = md:get(bx, math.floor(p.Y + 0.1), bz)
			local bCuerpo = md:get(bx, math.floor(p.Y + 0.8), bz)
			local bOjos = md:get(bx, math.floor(p.Y + 1.62), bz)
			local enAgua = esAgua(bPies) or esAgua(bCuerpo)
			local enLava = esLava(bPies) or esLava(bCuerpo)
			-- Contacto con bloques peligrosos
			s.contactoT -= dt
			if s.contactoT <= 0 then
				s.contactoT = 0.5
				local cactus, fuego = false, false
				for x = math.floor(p.X - 0.32), math.floor(p.X + 0.32) do
					for y = math.floor(p.Y), math.floor(p.Y + 1.7) do
						for z = math.floor(p.Z - 0.32), math.floor(p.Z + 0.32) do
							local b = md:get(x, y, z)
							if b == B.cactus then
								cactus = true
							end
							if b == B.fuego then
								fuego = true
							end
						end
					end
				end
				if cactus then
					danar(plr, 1, "cactus")
				end
				if fuego then
					danar(plr, 1, "fuego")
					s.fuego = math.max(s.fuego, 8)
				end
				if enLava then
					danar(plr, 4, "lava")
					s.fuego = math.max(s.fuego, 15)
				end
			end
			if enAgua then
				s.fuego = 0
			end
			if s.fuego > 0 and supervivencia(s) then
				s.fuego -= dt
				s.fuegoT -= dt
				if s.fuegoT <= 0 then
					s.fuegoT = 1
					danar(plr, 1, "fuego")
				end
			end
			plr:SetAttribute("Ardiendo", s.fuego > 0)
			-- Aire bajo el agua
			local aireAntes = math.floor(s.aire)
			if esAgua(bOjos) and supervivencia(s) then
				s.aire -= dt
				if s.aire <= 0 then
					s.aire = 0
					s.aireT -= dt
					if s.aireT <= 0 then
						s.aireT = 1
						danar(plr, 2, "ahogo")
					end
				end
			else
				s.aire = math.min(15, s.aire + dt * 6)
			end
			if math.floor(s.aire) ~= aireAntes then
				enviarJugador(plr)
			end
			-- Efectos de pociones y comida
			local cambio = false
			for k, e in s.efectos do
				e.t -= dt
				if e.t <= 0 then
					s.efectos[k] = nil
					cambio = true
				end
			end
			s.efectoT -= dt
			if s.efectoT <= 0 then
				s.efectoT = 0.5
				if s.efectos.regeneracion and h.Health < h.MaxHealth then
					h.Health = math.min(h.MaxHealth, h.Health + (s.efectos.regeneracion.n > 1 and 1 or 0.5))
				end
				if s.efectos.veneno and h.Health > 1 then
					danar(plr, 0.5, "veneno")
				end
				if s.efectos.hambre then
					s.agotamiento += 0.05
				end
			end
			if supervivencia(s) then
				-- Hambre y saturación (igual que el juego web)
				local hambreAntes = s.hambre
				while s.agotamiento >= 4 do
					s.agotamiento -= 4
					if s.saturacion > 0 then
						s.saturacion = math.max(0, s.saturacion - 1)
					elseif s.hambre > 0 then
						s.hambre -= 1
					end
				end
				if s.hambre >= 20 and s.saturacion > 0 and h.Health < h.MaxHealth then
					s.regenT += dt
					if s.regenT >= 0.5 then
						s.regenT = 0
						local sat = math.min(s.saturacion, 6)
						h.Health = math.min(h.MaxHealth, h.Health + sat / 6)
						s.agotamiento += sat
					end
				elseif s.hambre >= 18 and h.Health < h.MaxHealth then
					s.regenT += dt
					if s.regenT >= 4 then
						s.regenT = 0
						h.Health = math.min(h.MaxHealth, h.Health + 1)
						s.agotamiento += 6
					end
				else
					s.regenT = 0
				end
				if s.hambre <= 0 then
					s.hambreT += dt
					if s.hambreT >= 4 then
						s.hambreT = 0
						if h.Health > 1 then
							danar(plr, 1, "hambre")
						end
					end
				else
					s.hambreT = 0
				end
				-- Tiempo que pasa: un poco de agotamiento al moverse
				s.agotamiento += dt * 0.005
				if s.hambre ~= hambreAntes then
					cambio = true
				end
			end
			if cambio then
				enviarJugador(plr)
			end
		end
	end
end)

------------------------------------------------------------------
-- Modos de juego (One Block…)
------------------------------------------------------------------
Mesas.iniciar({
	mobs = Mobs, aviso = aviso, supervivencia = supervivencia, darOSoltar = darOSoltar,
	sonido = function(nombre, x, y, z)
		Estado:FireAllClients("sonido", nombre, Vector3.new(x + 0.5, y + 0.5, z + 0.5) * BS)
	end,
})
Mobs.alCrearAldeano = Mesas.prepararAldeano
Mesas.alCambiar = function(k)
	for plr, so in estados do
		if so.ui and so.ui.tipo == "extra" and so.ui.sub == "pociones" and Cont.clave(so.ui.x, so.ui.y, so.ui.z) == k then
			enviarUI(plr)
		end
	end
end
Redstone.iniciar({
	activarTNT = activarTNT,
	sonido = function(nombre, x, y, z)
		Estado:FireAllClients("sonido", nombre, Vector3.new(x + 0.5, y + 0.5, z + 0.5) * BS)
	end,
	soltarBloque = function(b, x, y, z)
		soltarBloque(b, x, y, z, nil, nil)
	end,
})
Dimension.iniciar({
	teletransportar = teletransportar, Estado = Estado, estados = estados, ganarXP = ganarXP, danar = danar, aviso = aviso,
	explosion = function(x, y, z, p)
		Sim.explosion(x, y, z, p)
	end,
})
Modos.iniciar({
	Mundo = Mundo, Mobs = Mobs, Entidades = Entidades, estados = estados, enviarJugador = enviarJugador, aviso = aviso,
	Estado = Estado, colocar = colocar, Inv = Inv, danar = danar, teletransportar = teletransportar, darOSoltar = darOSoltar,
	enviarUI = enviarUI, ganarXP = ganarXP, activarTNT = activarTNT, guardar = guardar,
})
-- Las explosiones en la arena de Bed Wars solo rompen lo construido
Sim.puedeExplotar = Modos.puedeExplotar
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">BedWars</string><ProtectedString name="Source"><![CDATA[--[[
	Blockverse para Roblox · BED WARS (bedwars.js, bedwars2.js y tiendaBW37.js)
	Una partida para todo el servidor: sala de espera de cristal con cuenta
	atrás, 8 equipos (o 4 si hay más de 8 jugadores) en islas flotantes,
	cuatro mapas (Jardín, Invierno, Infierno y Desierto), camas de dos
	bloques, generadores de hierro, oro, diamante y esmeralda con sus
	niveles, tienda de objetos y de mejoras del equipo, trampas, objetos
	especiales (bola de fuego, huevo puente, torre compacta, defensor,
	chinche y leche mágica), eventos de la partida y bots que recogen,
	compran, tienden puentes, protegen su cama, rompen las ajenas y pelean.
	Mientras tu cama siga en pie reapareces a los 5 segundos.
	Novedades de la versión de Roblox:
	· Kits con niveles (KitsBW) y progreso guardado (PerfilBW): monedas, nivel con
	  estrellas, estadísticas, misiones diarias y efectos de baja final.
	· Votación de mapa en la sala, etiquetas de equipo encima de los jugadores y
	  compañeros resaltados, registro de bajas y pantalla final con recompensas.
	· Momentos de caos: lluvia de meteoritos, fiebre del oro, gravedad baja y el
	  cofre del cielo, que cae en el centro con botín raro.
	· Rachas de bajas (En racha, Imparable, Leyenda) y «cortarrachas».
	· Objetos nuevos: globo salvavidas, escudo de cama, trampolín, mina terrestre y
	  torreta de nieve. En la muerte súbita, además, el vacío sube.
]]
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Comp = ReplicatedStorage:WaitForChild("Blockverse")
local Config = require(Comp.Config)
local Registro = require(Comp.Registro)
local Arenas = require(Comp.Arenas)
local Cont = require(script.Parent.Contenedores)
local Perfil = require(script.Parent.PerfilBW)
local Kits = require(script.Parent.KitsBW)

local BS = Config.BLOQUE
local B, I, OB, BL = Registro.B, Registro.I, Registro.objetos, Registro.bloques
local BW_Y = Arenas.BW_Y
local BW_VACIO = BW_Y - 32

local BW = {}
local ctx
local P = nil -- la partida en curso

BW.EVENTOS = { { 300, "Diamante II" }, { 600, "Esmeralda II" }, { 900, "Diamante III" }, { 1200, "Esmeralda III" }, { 1500, "Camas destruidas" }, { 1800, "Fin de la partida" } }
local NOMBRES_BOT = { "xXProGamerXx", "NoobMaster69", "Pepito_PvP", "ElRusherYT", "Camila_BW", "DarkSoul", "MrClutch", "Tryhard77", "LaBestia", "SrPuentes",
	"NinjaKid", "ChoriPan", "ZeroLag", "Bedbreaker", "Kiwi_Craft", "Zorrito", "ElPanaMiguel", "Luna_Pixel", "Toby2010", "CapitanCama", "Wachin_PE",
	"MegaBuilder", "FrostByte", "Rayo_Mc" }
local FRASES = {
	mata = { "gg", "ez", "jajaja", "¡a casa!", "sin cama no hay paraíso", "otra más 😎", "muy fácil", "¿lag?" },
	muere = { "lag", "noooo", "bruh", "me lagueé", "ya verás", "gg" },
	cama = { "¡cama rota! 😈", "adiós camita", "esa cama era mía", "siguiente…" },
}
local LOBBY = 15 -- segundos de cuenta atrás en la sala de espera

local function idc(k)
	return B[k] or I[k]
end
local function pilaDe(id, n, enc)
	local p = Registro.pila(id, n)
	if enc then
		p.enc = table.clone(enc)
	end
	return p
end
local function fmt(s)
	s = math.max(0, s)
	return string.format("%d:%02d", s // 60, math.floor(s % 60))
end
local function ahora()
	return os.clock()
end

------------------------------------------------------------------
-- Mensajes a los jugadores de la partida
------------------------------------------------------------------
-- Registro de la partida (arriba a la derecha en el cliente): bajas, camas, eventos…
local function chat(texto, col)
	if not P then
		return
	end
	for plr in P.jug do
		ctx.Estado:FireClient(plr, "feed", { t = texto, c = col or "#ffffff" })
	end
end
local function tituloA(plr, a, g, col)
	ctx.Estado:FireClient(plr, "titulo", a, g, col)
end
local function tituloTodos(a, g, col)
	if not P then
		return
	end
	for plr in P.jug do
		tituloA(plr, a, g, col)
	end
end
local function sonidoTodos(nombre)
	if not P then
		return
	end
	for plr in P.jug do
		ctx.Estado:FireClient(plr, "sonido", nombre)
	end
end
local function hablaBot(m, tipo, prob)
	if not m or not m.bw or math.random() > (prob or 0.4) then
		return
	end
	local l = FRASES[tipo]
	local E = P.eqs[m.bw.equipo].E
	task.delay(0.4 + math.random() * 1.5, function()
		if P and not P.fin then
			chat(("[%s] %s: %s"):format(E.letra, m.bw.nombre, l[math.random(1, #l)]))
		end
	end)
end

-- Cartel con texto encima de una pieza (nombres de los bots, TIENDA, MEJORAS…)
local function cartel(pieza, texto, col, alto)
	local g = pieza:FindFirstChild("CartelBW")
	if not g then
		g = Instance.new("BillboardGui")
		g.Name = "CartelBW"
		g.Size = UDim2.fromOffset(200, 26)
		g.AlwaysOnTop = false
		g.MaxDistance = 60 * BS
		g.LightInfluence = 0
		g.Parent = pieza
		local t = Instance.new("TextLabel")
		t.Name = "Texto"
		t.BackgroundTransparency = 0.55
		t.BackgroundColor3 = Color3.new(0, 0, 0)
		t.BorderSizePixel = 0
		t.Size = UDim2.fromScale(1, 1)
		t.Font = Enum.Font.Code
		t.TextScaled = true
		t.TextStrokeTransparency = 0.4
		t.Parent = g
	end
	g.StudsOffset = Vector3.new(0, (alto or 1.2) * BS, 0)
	local t = g:FindFirstChild("Texto")
	if t then
		t.Text = texto
		local ok, c = pcall(Color3.fromHex, col or "#ffffff")
		t.TextColor3 = ok and c or Color3.new(1, 1, 1)
	end
	return g
end

