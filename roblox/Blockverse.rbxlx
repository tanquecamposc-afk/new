local marco = Instance.new("Part")
marco.Name = "Seleccion"
marco.Anchored = true
marco.CanCollide = false
marco.CanQuery = false
marco.CanTouch = false
marco.Transparency = 1
marco.Size = Vector3.new(BS, BS, BS)
marco.Parent = workspace
local caja = Instance.new("SelectionBox")
caja.Adornee = marco
caja.LineThickness = 0.03
caja.Color3 = Color3.new(0, 0, 0)
caja.Transparency = 0.45
caja.SurfaceTransparency = 1
caja.Parent = marco

-- Grietas: una caja un poco más grande con una calcomanía por cara
local grietas = Instance.new("Part")
grietas.Name = "Grietas"
grietas.Anchored = true
grietas.CanCollide = false
grietas.CanQuery = false
grietas.CanTouch = false
grietas.Transparency = 1
grietas.Size = Vector3.new(BS, BS, BS) * 1.006
grietas.Parent = workspace
local calcas = {}
for _, cara in Enum.NormalId:GetEnumItems() do
	local d = Instance.new("Decal")
	d.Face = cara
	d.Transparency = 1
	d.Parent = grietas
	table.insert(calcas, d)
end
local faseGrieta = -1
local function ponerGrietas(f)
	local fase = f and math.clamp(math.floor(f * 10), 0, 9) or -1
	if fase == faseGrieta then
		return
	end
	faseGrieta = fase
	local imgs = Iconos.grietas()
	for _, d in calcas do
		if fase < 0 or not imgs then
			d.Transparency = 1
		else
			Imagenes.enCalcomania(d, imgs[fase + 1])
			d.Transparency = 0
		end
	end
	if not imgs then
		caja.SurfaceColor3 = Color3.new(0, 0, 0)
		caja.SurfaceTransparency = fase < 0 and 1 or 1 - (fase + 1) / 10 * 0.6
	end
end

local filtroMobs = RaycastParams.new()
filtroMobs.FilterType = Enum.RaycastFilterType.Include
task.spawn(function()
	local criaturas = workspace:WaitForChild("Criaturas")
	while true do
		local lista = { criaturas }
		for _, o in Players:GetPlayers() do
			if o ~= jugador and o.Character then
				table.insert(lista, o.Character)
			end
		end
		filtroMobs.FilterDescendantsInstances = lista
		task.wait(1)
	end
end)

local function ojos()
	local ch = jugador.Character
	local cab = ch and ch:FindFirstChild("Head")
	return cab and cab.Position or nil
end

local objetivo = nil -- {tipo = "bloque", x, y, z, b, n} o {tipo = "mob", parte}
local function apuntar()
	local cam = workspace.CurrentCamera
	local e = ojos()
	if not cam or not e then
		return nil
	end
	local dir = cam.CFrame.LookVector
	if not tercera then
		e = cam.CFrame.Position
	end
	local r = Rayo.lanzar(md, e, dir, Config.ALCANCE, {})
	local dm = math.huge
	local mob
	local rr = workspace:Raycast(e, dir * (Config.ALCANCE + 1) * BS, filtroMobs)
	if rr then
		mob = rr.Instance
		dm = (rr.Position - e).Magnitude / BS
	end
	if mob and (not r or dm < (r.t or math.huge)) then
		return { tipo = "mob", parte = mob }
	end
	if r then
		return { tipo = "bloque", x = r.x, y = r.y, z = r.z, b = r.b, n = r.n }
	end
	return nil
end

------------------------------------------------------------------
-- Picar, atacar y usar
------------------------------------------------------------------
local picando, usando = false, false
local progreso, actual, espera = 0, nil, 0
local esperaUsar = 0
local comerDesde, arcoDesde = nil, nil
local ultimoAtaque = 0
local agachado, corriendo = false, false
local volando, vueloFuerza = false, nil

local function enMano()
	local p = est.inv[est.sel]
	return p and p.id or nil, p
end

local function creativo()
	return est.modo == "creativo"
end

local function cadencia()
	local id = enMano()
	local h = id and Registro.herramienta(id)
	return h and h.cad or 4
end

local function cargaAtaque()
	return math.clamp((os.clock() - ultimoAtaque) * cadencia(), 0, 1)
end

local function atacar()
	if not objetivo or objetivo.tipo ~= "mob" then
		return false
	end
	local ch = jugador.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local cayendo = root and root.AssemblyLinearVelocity.Y < -1 and hum and hum.FloorMaterial == Enum.Material.Air
	enviar("atacar", objetivo.parte, cargaAtaque(), cayendo == true, corriendo)
	ultimoAtaque = os.clock()
	Interfaz.balancear()
	return true
end

local function datosObjetivo()
	if objetivo and objetivo.tipo == "bloque" then
		return { x = objetivo.x, y = objetivo.y, z = objetivo.z, n = objetivo.n }
	end
	return nil
end

local function mirada()
	local cam = workspace.CurrentCamera
	return cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
end

local function usar(inicio)
	local id, p = enMano()
	local o = id and OB[id]
	local mobParte = objetivo and objetivo.tipo == "mob" and objetivo.parte or nil
	-- Comer y beber
	if o and (o.comida or o.bebida) and not (objetivo and objetivo.tipo == "bloque" and BL[objetivo.b] and BL[objetivo.b].inter and not agachado) then
		if est.hambre < 20 or o.siempre or o.bebida or creativo() then
			if inicio or not comerDesde then
				comerDesde = os.clock()
				enviar("derecho", datosObjetivo(), mirada(), mobParte, agachado)
			end
			return
		end
	end
	-- Cohete mientras se planea con élitros
	if id == Registro.I.cohete and est.planeando then
		if inicio then
			est.coheteT = 1.5
			enviar("cohete")
		end
		return
	end
	-- Arco
	if id == Registro.I.arco then
		if inicio and not arcoDesde then
			arcoDesde = os.clock()
			enviar("derecho", nil, mirada(), nil, agachado)
		end
		return
	end
	enviar("derecho", datosObjetivo(), mirada(), mobParte, agachado)
	Interfaz.balancear()
	local _ = p
end

------------------------------------------------------------------
-- Vuelo (creativo)
------------------------------------------------------------------
local function ponerVuelo(si)
	volando = si and creativo()
	local ch = jugador.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if vueloFuerza then
		vueloFuerza:Destroy()
		vueloFuerza = nil
	end
	if volando and root then
		vueloFuerza = Instance.new("BodyVelocity")
		vueloFuerza.MaxForce = Vector3.new(1e7, 1e7, 1e7)
		vueloFuerza.Velocity = Vector3.zero
		vueloFuerza.P = 4000
		vueloFuerza.Parent = root
	end
end

------------------------------------------------------------------
-- Velocidad al andar (correr, agacharse)
------------------------------------------------------------------
local function velocidad()
	local ch = jugador.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	local v = 4.3
	if agachado then
		v = 1.3
	elseif corriendo and (creativo() or est.hambre > 6) then
		v = 5.6
	end
	local ef = est.efectos or {}
	if ef.rapidez then
		v *= 1 + 0.2 * (ef.rapidez.n or 1)
	end
	if ef.lentitud then
		v *= math.max(0.2, 1 - 0.15 * (ef.lentitud.n or 1))
	end
	hum.WalkSpeed = v * BS
	-- Supersalto: medio bloque más por nivel
	hum.JumpHeight = (1.25 + (ef.salto and 0.5 * (ef.salto.n or 1) or 0)) * BS + 0.4
	local cab = ch:FindFirstChild("Humanoid") and hum
	if cab then
		hum.CameraOffset = agachado and Vector3.new(0, -0.3 * BS, 0) or Vector3.zero
	end
end

local function ponerCorrer(si)
	if corriendo ~= si then
		corriendo = si
		enviar("correr", si)
	end
	velocidad()
end

------------------------------------------------------------------
-- Interfaz y teclas
------------------------------------------------------------------
local function elegir(i)
	if est.sel ~= i then
		est.sel = i
		Interfaz.seleccion(i)
		enviar("sel", i)
		progreso, actual = 0, nil
		comerDesde, arcoDesde = nil, nil
	end
end
Interfaz.alSeleccionar = elegir

Interfaz.alCerrar = function()
	enviar("cerrarUI")
	aplicarCamara()
end

Interfaz.alElegirModo = function(m)
	if m == "oneblock" then
		enviar("modoJuego", "oneblock")
		enviar("modo", "supervivencia")
	elseif m == "bedwars" or m == "mazmorras" or m == "leyendas" then
		enviar("modoJuego", m)
	else
		if jugador:GetAttribute("OneBlock") or jugador:GetAttribute("BedWars") or jugador:GetAttribute("Mazmorras") or jugador:GetAttribute("Leyendas") then
			enviar("modoJuego", "normal")
		end
		enviar("modo", m)
	end
	Interfaz.menu(false)
	aplicarCamara()
end

local function alternarInventario()
	if Interfaz.abierto() then
		Interfaz.cerrar()
	else
		enviar("abrirInventario")
	end
	aplicarCamara()
end

local ultimoEspacio = 0
UserInputService.InputBegan:Connect(function(input, procesado)
	local t = input.UserInputType
	local bloqueado = Interfaz.abierto() or Interfaz.menuVisible()
	if t == Enum.UserInputType.MouseButton1 and not procesado and not bloqueado then
		picando = true
		if not atacar() then
			Interfaz.balancear()
		end
	elseif t == Enum.UserInputType.MouseButton2 and not procesado and not bloqueado then
		usando = true
		esperaUsar = 0.25
		usar(true)
	elseif t == Enum.UserInputType.MouseButton3 and not procesado and not bloqueado then
		if creativo() and objetivo and objetivo.tipo == "bloque" and OB[objetivo.b] then
			enviar("elegirBloque", objetivo.b)
		end
	elseif t == Enum.UserInputType.Keyboard then
		local k = input.KeyCode
		if k == Enum.KeyCode.Escape and Interfaz.abierto() then
			Interfaz.cerrar()
			return
		end
		if procesado then
			return
		end
		local n = k.Value - Enum.KeyCode.One.Value + 1
		local leyendas = jugador:GetAttribute("Leyendas") == true and not Interfaz.menuVisible() and not Interfaz.abierto()
		if leyendas and n >= 1 and n <= 6 then
			-- Leyendas: 1-6 construyen (como en el web)
			enviar("modoCmd", "construir", n)
		elseif k == Enum.KeyCode.G and jugador:GetAttribute("BedWars") == true and not Interfaz.menuVisible() and not Interfaz.abierto() then
			-- Bed Wars: habilidad del kit
			enviar("modoCmd", "habilidad")
		elseif leyendas and (k == Enum.KeyCode.G or k == Enum.KeyCode.R or (k == Enum.KeyCode.F and not creativo())) then
			enviar("modoCmd", k == Enum.KeyCode.G and "cosechar" or (k == Enum.KeyCode.R and "atacar" or "seguir"))
		elseif k == Enum.KeyCode.M and not Interfaz.abierto() then
			-- Menú de modos de juego
			Interfaz.menu(not Interfaz.menuVisible())
			aplicarCamara()
		elseif n >= 1 and n <= 9 and not Interfaz.menuVisible() then
			elegir(n)
		elseif k == Enum.KeyCode.E then
			if not Interfaz.menuVisible() then
				alternarInventario()
			end
		elseif k == Enum.KeyCode.V then
			tercera = not tercera
			aplicarCamara()
		elseif k == Enum.KeyCode.F then
			if creativo() then
				ponerVuelo(not volando)
				Interfaz.aviso(volando and "Volando: Espacio sube, Mayús baja" or "Ya no vuelas")
			end
		elseif k == Enum.KeyCode.Q and not bloqueado then
			enviar("tirar", UserInputService:IsKeyDown(Enum.KeyCode.LeftControl))
		elseif k == Enum.KeyCode.LeftControl then
			ponerCorrer(true)
		elseif k == Enum.KeyCode.LeftShift and not volando then
			agachado = true
			velocidad()
		elseif k == Enum.KeyCode.F3 then
			Interfaz.info(not Interfaz.infoVisible() and " " or nil)
		elseif k == Enum.KeyCode.Space and creativo() then
			if os.clock() - ultimoEspacio < 0.3 then
				ponerVuelo(not volando)
			end
			ultimoEspacio = os.clock()
		end
		if k == Enum.KeyCode.Space and not bloqueado then
			est.pedirPlaneo = true
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 then
		picando = false
	elseif t == Enum.UserInputType.MouseButton2 then
		usando = false
		comerDesde = nil
		if arcoDesde then
			arcoDesde = nil
			enviar("soltarArco", mirada())
		end
	elseif input.KeyCode == Enum.KeyCode.LeftShift then
		agachado = false
		velocidad()
	end
end)

UserInputService.InputChanged:Connect(function(input, procesado)
	if input.UserInputType == Enum.UserInputType.MouseWheel and not procesado and not Interfaz.abierto() and not Interfaz.menuVisible() then
		local d = input.Position.Z > 0 and -1 or 1
		elegir((est.sel - 1 + d) % 9 + 1)
	end
end)

Interfaz.botonesMovil({
	picar = function(si)
		picando = si
		if si then
			atacar()
		end
	end,
	usar = function(si)
		usando = si
		if si then
			esperaUsar = 0.25
			usar(true)
		else
			comerDesde = nil
			if arcoDesde then
				arcoDesde = nil
				enviar("soltarArco", mirada())
			end
		end
	end,
	inventario = alternarInventario,
	volar = function()
		ponerVuelo(not volando)
	end,
	agachar = function(si)
		agachado = si
		velocidad()
	end,
	tirar = function()
		enviar("tirar", false)
	end,
})

------------------------------------------------------------------
-- Mensajes del servidor
------------------------------------------------------------------
local listoServidor = false
------------------------------------------------------------------
-- Bed Wars: kits que se notan al moverse, habilidad, espectador, compañeros y efectos
------------------------------------------------------------------
local kitBW = nil -- {id, v, act}
local saltosExtra = 0
local espectando = nil

-- Los impulsos vienen en bloques/s con la gravedad del juego web (32 bloques/s²)
local function vRoblox(v)
	return v * math.sqrt(workspace.Gravity * BS / 32)
end

local function impulso(tipo, fuerza)
	local ch = jugador.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not root or not hum then
		return
	end
	if tipo == "embestida" then
		local cam = workspace.CurrentCamera
		local mira = cam and cam.CFrame.LookVector or root.CFrame.LookVector
		local dir = Vector3.new(mira.X, 0, mira.Z)
		dir = dir.Magnitude > 0.01 and dir.Unit or root.CFrame.LookVector
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
		sonido("arco", root.Position, 1.6)
		task.spawn(function()
			local t0 = os.clock()
			while os.clock() - t0 < 0.25 and root.Parent do
				root.AssemblyLinearVelocity = dir * fuerza * BS + Vector3.new(0, 4 * BS, 0)
				emitir(root.Position, Color3.fromRGB(200, 200, 255), 2, 1, 0.1, 0)
				task.wait()
			end
		end)
	else
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v.X, vRoblox(fuerza), v.Z)
		emitir(root.Position - Vector3.new(0, 2.5 * BS / 3, 0), Color3.fromRGB(230, 230, 230), 10, 3, 0.1, 4)
	end
end

-- Doble salto (Saltarín): Espacio otra vez en el aire
UserInputService.JumpRequest:Connect(function()
	if not kitBW or kitBW.id ~= "saltarin" then
		return
	end
	local ch = jugador.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 or hum.FloorMaterial ~= Enum.Material.Air then
		return
	end
	if saltosExtra > 0 and root.AssemblyLinearVelocity.Y < vRoblox(4) then
		saltosExtra -= 1
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v.X, math.sqrt(2 * workspace.Gravity * 1.3 * BS), v.Z)
		emitir(root.Position - Vector3.new(0, BS * 0.8, 0), Color3.fromRGB(255, 255, 255), 8, 2, 0.1, 2)
		sonido("paso", root.Position, 1.4)
	end
end)

-- Cada fotograma: recarga del doble salto, planear, compañeros resaltados y cámara de espectador
local tCompas = 0
RunService.Heartbeat:Connect(function(dt)
	local ch = jugador.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if kitBW and root and hum and hum.Health > 0 then
		if hum.FloorMaterial ~= Enum.Material.Air then
			saltosExtra = kitBW.v and kitBW.v.extra or 1
		end
		if kitBW.id == "planeador" and hum.FloorMaterial == Enum.Material.Air and (UserInputService:IsKeyDown(Enum.KeyCode.Space) or hum.Jump) then
			local v = root.AssemblyLinearVelocity
			local max = -(kitBW.v and kitBW.v.caida or 2) * BS
			if v.Y < max then
				root.AssemblyLinearVelocity = Vector3.new(v.X, max, v.Z)
			end
		end
	end
	tCompas -= dt
	if tCompas <= 0 then
		tCompas = 0.5
		local mio = jugador:GetAttribute("EquipoBW")
		for _, otro in Players:GetPlayers() do
			local och = otro.Character
			if otro ~= jugador and och then
				local hl = och:FindFirstChild("CompaneroBW")
				local es = mio ~= nil and otro:GetAttribute("EquipoBW") == mio
				if es and not hl then
					hl = Instance.new("Highlight")
					hl.Name = "CompaneroBW"
					hl.FillTransparency = 1
					hl.OutlineTransparency = 0.1
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					local ok, c = pcall(Color3.fromHex, otro:GetAttribute("ColorBW") or "#ffffff")
					hl.OutlineColor = ok and c or Color3.new(1, 1, 1)
					hl.Parent = och
				elseif not es and hl then
					hl:Destroy()
				end
			end
		end
	end
	-- Si el jugador al que miramos ya no está, la cámara vuelve
	if espectando and not espectando.Parent then
		espectando = nil
		local h = jugador.Character and jugador.Character:FindFirstChildOfClass("Humanoid")
		if workspace.CurrentCamera and h then
			workspace.CurrentCamera.CameraSubject = h
		end
		aplicarCamara()
	end
end)

local function colorHex(n)
	return Color3.fromRGB(n // 65536, (n // 256) % 256, n % 256)
end
local function efectoBaja(tipo, pos)
	if tipo == "fuegos" then
		sonido("explosion", pos, 1.8)
		for k = 0, 2 do
			task.delay(k * 0.25, function()
				local p = pos + Vector3.new((math.random() - 0.5) * 2, 3 + k, (math.random() - 0.5) * 2) * BS
				emitir(p, { colorHex(0xff5555), colorHex(0x55ff55), colorHex(0x5599ff), colorHex(0xffff55) }, 30, 8, 0.12, 1)
			end)
		end
	elseif tipo == "corazones" then
		sonido("xp", pos, 0.8)
		emitir(pos + Vector3.new(0, BS, 0), { colorHex(0xff6fae), colorHex(0xff2e7a) }, 30, 2, 0.18, -3)
	elseif tipo == "rayo" then
		sonido("explosion", pos, 0.6)
		local r = Instance.new("Part")
		r.Anchored = true
		r.CanCollide = false
		r.CanQuery = false
		r.Material = Enum.Material.Neon
		r.Color = Color3.fromRGB(200, 220, 255)
		r.Size = Vector3.new(0.4 * BS, 40 * BS, 0.4 * BS)
		r.CFrame = CFrame.new(pos + Vector3.new(0, 20 * BS, 0))
		r.Parent = workspace
		local l = Instance.new("PointLight")
		l.Brightness = 6
		l.Range = 20 * BS
		l.Parent = r
		emitir(pos, colorHex(0xddeeff), 25, 6, 0.1, 6)
		task.delay(0.35, function()
			r:Destroy()
		end)
	elseif tipo == "fantasma" then
		sonido("dano", pos, 0.6)
		emitir(pos + Vector3.new(0, BS, 0), { colorHex(0xffffff), colorHex(0xbbccff) }, 35, 1.2, 0.2, -4)
	elseif tipo == "confeti" then
		sonido("nivel", pos, 1.2)
		emitir(pos + Vector3.new(0, 2 * BS, 0), { colorHex(0xff5555), colorHex(0xffd84a), colorHex(0x55ff55), colorHex(0x55aaff), colorHex(0xff77dd) }, 60, 7, 0.1, 5)
	end
end

local function espectar(ch)
	local cam = workspace.CurrentCamera
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	if h and cam then
		espectando = ch
		jugador.CameraMode = Enum.CameraMode.Classic
		jugador.CameraMinZoomDistance = 12
		jugador.CameraMaxZoomDistance = 30
		cam.CameraSubject = h
		Interfaz.mostrarMano(false)
	else
		espectando = nil
		local mio = jugador.Character and jugador.Character:FindFirstChildOfClass("Humanoid")
		if cam and mio then
			cam.CameraSubject = mio
		end
		aplicarCamara()
	end
end
Interfaz.alMenu = aplicarCamara

Estado.OnClientEvent:Connect(function(tipo, a, b, c)
	if tipo == "jugador" then
		local modoAntes = est.modo
		Interfaz.jugador(a)
		if a.modo ~= modoAntes then
			if a.modo ~= "creativo" and volando then
				ponerVuelo(false)
			end
			if Interfaz.botonVolar then
				Interfaz.botonVolar.Visible = a.modo == "creativo"
			end
		end
		velocidad()
		-- Luz de la antorcha en la mano
		local id = enMano()
		local luz = id and BL[id] and BL[id].luz or 0
		local ch = jugador.Character
		local cab = ch and ch:FindFirstChild("Head")
		if cab then
			local pl = cab:FindFirstChild("LuzMano")
			if luz > 0 then
				if not pl then
					pl = Instance.new("PointLight")
					pl.Name = "LuzMano"
					pl.Color = Color3.fromRGB(255, 200, 130)
					pl.Shadows = true
					pl.Parent = cab
				end
				pl.Range = luz * 1.1 * BS / 3 * 2
				pl.Brightness = 1.4
			elseif pl then
				pl:Destroy()
			end
		end
	elseif tipo == "ui" then
		Interfaz.ui(a)
		aplicarCamara()
	elseif tipo == "aviso" then
		Interfaz.aviso(a)
	elseif tipo == "titulo" then
		Interfaz.titulo(a, b, c)
	elseif tipo == "oneblock" then
		Interfaz.oneblock(a)
	elseif tipo == "sonido" then
		sonido(a, b)
	elseif tipo == "dano" then
		Interfaz.dano()
		sonido("dano")
		local root = jugador.Character and jugador.Character:FindFirstChild("HumanoidRootPart")
		if a and root then
			root.AssemblyLinearVelocity += a
		end
	elseif tipo == "golpeMob" then
		sonido("golpe", a, b and 1 or 1)
		if c then
			emitir(a, { Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 200, 255) }, 10, 3, 0.07, 4)
		end
	elseif tipo == "explosion" then
		sonido("explosion", a)
		emitir(a, { Color3.fromRGB(240, 240, 240), Color3.fromRGB(150, 150, 150), Color3.fromRGB(80, 80, 80) }, 40, 10, 0.3, 2)
		local ex = Instance.new("Explosion")
		ex.BlastPressure = 0
		ex.BlastRadius = (b or 3) * BS
		ex.DestroyJointRadiusPercent = 0
		ex.Position = a
		ex.Parent = workspace
		local cam = workspace.CurrentCamera
		if cam and (cam.CFrame.Position - a).Magnitude < 30 * BS then
			task.spawn(function()
				for i = 1, 8 do
					local hum = jugador.Character and jugador.Character:FindFirstChildOfClass("Humanoid")
					if hum then
						hum.CameraOffset = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * (8 - i) * 0.08 * BS
					end
					task.wait(0.03)
				end
				velocidad()
			end)
		end
	elseif tipo == "tnt" then
		sonido("tnt", a)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Size = Vector3.new(BS, BS, BS) * 1.02
		p.Material = Enum.Material.Neon
		p.Color = Color3.new(1, 1, 1)
		p.Position = a
		p.Parent = workspace
		task.spawn(function()
			local t0 = os.clock()
			while os.clock() - t0 < 4 do
				local e = os.clock() - t0
				p.Transparency = math.floor(e * 4) % 2 == 0 and 0.3 or 0.9
				p.Size = Vector3.new(BS, BS, BS) * (1.02 + math.max(0, e - 3.6) * 0.3)
				task.wait(0.05)
			end
			p:Destroy()
		end)
	elseif tipo == "particulas" then
		emitir(a, Color3.fromRGB((b or 0x60ff60) // 65536, ((b or 0x60ff60) // 256) % 256, (b or 0x60ff60) % 256), 12, 2, 0.08, -1)
	elseif tipo == "pocion" then
		local col = b or 0xff00ff
		emitir(a, Color3.fromRGB(col // 65536, (col // 256) % 256, col % 256), 30, 6, 0.1, 6)
		sonido("rompeHerr", a, 1.6)
	elseif tipo == "dormir" then
		Interfaz.dormir()
	elseif tipo == "muerte" then
		Interfaz.muerte(a)
		picando, usando = false, false
		ponerVuelo(false)
	elseif tipo == "listo" then
		listoServidor = true
	elseif tipo == "viaje" then
		-- Cambio de dimensión o portal: pantalla de carga hasta que se vea el sitio
		est.viajando = true
		Interfaz.cerrar()
		Interfaz.carga(0.5, a and ("Entrando en " .. a .. "…") or "Viajando…")
	elseif tipo == "jefe" then
		Interfaz.jefe(a)
	elseif tipo == "panel" then
		Interfaz.panel(a)
	elseif tipo == "cerrarUI" then
		-- El servidor cierra la pantalla (alguien rompió el cofre que tenías abierto)
		if Interfaz.abierto() then
			Interfaz.cerrar()
		end
	elseif tipo == "menu" then
		Interfaz.menu(true)
		aplicarCamara()
	elseif tipo == "feed" then
		Interfaz.feed(a and a.t, a and a.c)
	elseif tipo == "finBW" then
		Interfaz.finBW(a)
		if a then
			sonido(a.gano and "nivel" or "dano")
			if a.gano then
				local root = jugador.Character and jugador.Character:FindFirstChild("HumanoidRootPart")
				if root then
					efectoBaja("confeti", root.Position)
				end
			end
		end
	elseif tipo == "kitBW" then
		kitBW = a
		saltosExtra = 0
		Interfaz.botonHabilidad(a ~= nil and a.act == true, function()
			enviar("modoCmd", "habilidad")
		end)
	elseif tipo == "impulso" then
		impulso(a, b or 10)
	elseif tipo == "habilidad" then
		local root = jugador.Character and jugador.Character:FindFirstChild("HumanoidRootPart")
		if root then
			emitir(root.Position, Color3.fromRGB(255, 220, 80), 14, 4, 0.1, 2)
		end
	elseif tipo == "efectoBaja" then
		if typeof(b) == "Vector3" then
			efectoBaja(a, b)
		end
	elseif tipo == "espectar" then
		espectar(a)
	end
end)

------------------------------------------------------------------
-- Personaje
------------------------------------------------------------------
local alturaCaida, ultimaY = nil, nil
local function alPersonaje(ch)
	local hum = ch:WaitForChild("Humanoid")
	listoServidor = false
	Interfaz.muerte(nil)
	local antes = hum.Health
	Interfaz.vida(hum.Health, hum.MaxHealth)
	hum.HealthChanged:Connect(function(h)
		antes = h
		Interfaz.vida(h, hum.MaxHealth)
	end)
	hum.StateChanged:Connect(function(_, nuevo)
		if nuevo == Enum.HumanoidStateType.Jumping then
			enviar("salto")
		end
	end)
	volando, vueloFuerza = false, nil
	alturaCaida, ultimaY = nil, nil
	velocidad()
	aplicarCamara()
	local _ = antes
end
if jugador.Character then
	task.spawn(alPersonaje, jugador.Character)
end
jugador.CharacterAdded:Connect(alPersonaje)

------------------------------------------------------------------
-- Bucle de cada fotograma
------------------------------------------------------------------
local menuMostrado = false
local tPaso = 0
local fps = 60

RunService.RenderStepped:Connect(function(dt)
	fps = fps * 0.95 + (1 / math.max(dt, 1e-3)) * 0.05
	local ch = jugador.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")

	-- Pantalla de carga hasta que el mundo alrededor está dibujado
	if not menuMostrado then
		if (listoServidor or (root and not root.Anchored)) and root and Render.listoEn(root.Position) then
			menuMostrado = true
			Interfaz.carga(nil)
			Interfaz.menu(true)
			aplicarCamara()
		elseif root then
			Interfaz.carga(listoServidor and 0.85 or 0.65, listoServidor and "Dibujando el mundo…" or "Generando el mundo…")
		end
	end

	-- Fin de un viaje entre dimensiones
	if est.viajando and root and not root.Anchored and Render.listoEn(root.Position) then
		est.viajando = false
		Interfaz.carga(nil)
	end

	-- Partículas
	for i = #vivas, 1, -1 do
		local q = vivas[i]
		q.vida -= dt
		if q.vida <= 0 then
			q.p:Destroy()
			vivas[i] = vivas[#vivas]
			vivas[#vivas] = nil
		else
			q.v -= Vector3.new(0, q.g * dt, 0)
			q.p.Position += q.v * dt
		end
	end

	local bloqueado = Interfaz.abierto() or Interfaz.menuVisible()
	if bloqueado then
		objetivo = nil
		picando, usando = false, false
	else
		objetivo = apuntar()
	end

	-- Marco del bloque apuntado (ajustado a la forma del bloque)
	if objetivo and objetivo.tipo == "bloque" then
		local cj = Rayo.cajas(objetivo.b) or { { 0, 0, 0, 1, 1, 1 } }
		local x0, y0, z0, x1, y1, z1 = 1, 1, 1, 0, 0, 0
		for _, c in cj do
			x0, y0, z0 = math.min(x0, c[1]), math.min(y0, c[2]), math.min(z0, c[3])
			x1, y1, z1 = math.max(x1, c[4]), math.max(y1, c[5]), math.max(z1, c[6])
		end
		marco.Size = Vector3.new(x1 - x0, y1 - y0, z1 - z0) * BS + Vector3.new(0.02, 0.02, 0.02)
		marco.Position = Vector3.new(objetivo.x + (x0 + x1) / 2, objetivo.y + (y0 + y1) / 2, objetivo.z + (z0 + z1) / 2) * BS
		caja.Visible = true
	else
		caja.Visible = false
	end

	-- Carga del ataque
	Interfaz.cargaAtaque(cargaAtaque())

	-- Picar
	espera -= dt
	if picando and objetivo and objetivo.tipo == "bloque" and espera <= 0 then
		local o = objetivo
		if not actual or actual.x ~= o.x or actual.y ~= o.y or actual.z ~= o.z or actual.b ~= o.b then
			actual = { x = o.x, y = o.y, z = o.z, b = o.b }
			progreso = 0
			enviar("golpe", o.x, o.y, o.z)
		end
		local ojosB = ojos()
		local bajoAgua = ojosB and esAgua(md:get(math.floor(ojosB.X / BS), math.floor(ojosB.Y / BS), math.floor(ojosB.Z / BS)))
		local enAire = hum and hum.FloorMaterial == Enum.Material.Air and not volando and not bajoAgua
		local t = Registro.tiempoRomper(o.b, enMano(), creativo(), { bajoAgua = bajoAgua, enAire = enAire })
		if t == math.huge then
			progreso = 0
		else
			local antes = progreso
			progreso += dt / math.max(t, 0.001)
			if math.floor(progreso * 4) ~= math.floor(antes * 4) then
				Interfaz.balancear()
				sonido("paso", o and Vector3.new(o.x + 0.5, o.y + 0.5, o.z + 0.5) * BS, 1.3)
			end
			if progreso >= 1 then
				enviar("romper", o.x, o.y, o.z)
				est.yoRompi = { x = o.x, y = o.y, z = o.z }
				trozos(o.x, o.y, o.z, o.b)
				sonido("romper", Vector3.new(o.x + 0.5, o.y + 0.5, o.z + 0.5) * BS)
				progreso, actual = 0, nil
				espera = creativo() and 0.2 or 0.05
			end
		end
	elseif not picando or (objetivo and objetivo.tipo ~= "bloque") then
		progreso, actual = 0, nil
	end
	if progreso > 0 and actual then
		grietas.Position = Vector3.new(actual.x + 0.5, actual.y + 0.5, actual.z + 0.5) * BS
		ponerGrietas(progreso)
	else
		ponerGrietas(nil)
	end

	-- Usar manteniendo el botón: poner seguido, comer y tensar el arco
	if usando then
		if comerDesde then
			local f = (os.clock() - comerDesde) / 1.6
			Interfaz.uso(f)
			if math.floor(f * 8) % 2 == 0 then
				Interfaz.balancear()
			end
			if f >= 1 then
				enviar("terminarComer")
				comerDesde = nil
			end
		elseif arcoDesde then
			Interfaz.uso(math.min(1, os.clock() - arcoDesde))
		else
			Interfaz.uso(nil)
			esperaUsar -= dt
			if esperaUsar <= 0 then
				esperaUsar = 0.22
				usar(false)
			end
		end
	else
		Interfaz.uso(nil)
	end

	-- Planear con élitros (fisicaEspecial del juego web)
	if hum and root then
		local pecho = est.inv[38]
		local tiene = pecho and pecho.id == Registro.I.elitros and (pecho.dur or 2) > 1
		local pies = root.Position / BS
		local bAgua = md:getSiCargado(math.floor(pies.X), math.floor(pies.Y - 1), math.floor(pies.Z))
		local enAgua = bAgua > 0 and Registro.esLiquido(bAgua)
		local enAire = hum.FloorMaterial == Enum.Material.Air
		if est.pedirPlaneo then
			est.pedirPlaneo = false
			if not est.planeando and tiene and enAire and not volando and not enAgua and root.AssemblyLinearVelocity.Y < 0 then
				est.planeando = true
				est.acumPlaneo = 0
				est.velPlaneo = root.AssemblyLinearVelocity / BS / 20
				est.fuerzaPlaneo = Instance.new("BodyVelocity")
				est.fuerzaPlaneo.MaxForce = Vector3.new(1e7, 1e7, 1e7)
				est.fuerzaPlaneo.P = 6000
				est.fuerzaPlaneo.Velocity = root.AssemblyLinearVelocity
				est.fuerzaPlaneo.Parent = root
				est.planeoT = 0
			end
		end
		if est.planeando then
			if not tiene or not enAire or enAgua or volando or not est.fuerzaPlaneo or not est.fuerzaPlaneo.Parent then
				est.planeando = false
				if est.fuerzaPlaneo then
					est.fuerzaPlaneo:Destroy()
					est.fuerzaPlaneo = nil
				end
			else
				local cam = workspace.CurrentCamera
				local look = cam.CFrame.LookVector
				local pitch = math.asin(math.clamp(look.Y, -1, 1))
				local cp = math.cos(pitch)
				local h = math.sqrt(look.X ^ 2 + look.Z ^ 2)
				local lx, ly, lz = (h > 0 and look.X / h or 0) * cp, math.sin(pitch), (h > 0 and look.Z / h or 0) * cp
				local f = -pitch
				local v = est.velPlaneo
				local vx, vy, vz = v.X, v.Y, v.Z
				est.acumPlaneo += dt
				est.coheteT = math.max(0, (est.coheteT or 0) - dt)
				while est.acumPlaneo >= 0.05 do
					est.acumPlaneo -= 0.05
					local d = math.sqrt(lx * lx + lz * lz)
					local d1 = math.sqrt(vx * vx + vz * vz)
					local f1 = math.cos(f) ^ 2
					vy += -0.08 + f1 * 0.06
					if vy < 0 and d > 0 then
						local d5 = vy * -0.1 * f1
						vx += lx * d5 / d
						vy += d5
						vz += lz * d5 / d
					end
					if f < 0 and d > 0 then
						local d9 = d1 * -math.sin(f) * 0.04
						vx += -lx * d9 / d
						vy += d9 * 3.2
						vz += -lz * d9 / d
					end
					if d > 0 then
						vx += (lx / d * d1 - vx) * 0.1
						vz += (lz / d * d1 - vz) * 0.1
					end
					vx *= 0.99
					vy *= 0.98
					vz *= 0.99
					if est.coheteT > 0 then
						vx += lx * 0.1 + (lx * 1.5 - vx) * 0.5
						vy += ly * 0.1 + (ly * 1.5 - vy) * 0.5
						vz += lz * 0.1 + (lz * 1.5 - vz) * 0.5
					end
				end
				est.velPlaneo = Vector3.new(vx, vy, vz)
				est.fuerzaPlaneo.Velocity = est.velPlaneo * 20 * BS
				if est.coheteT > 0 and math.random() < dt * 30 then
					emitir(root.Position - Vector3.new(0, 1, 0), { Color3.fromRGB(255, 224, 112), Color3.fromRGB(255, 128, 48) }, 1, 0.8, 0.08, 0)
				end
				-- Desgaste de los élitros (1 por segundo en supervivencia)
				est.planeoT += dt
				if est.planeoT >= 1 then
					est.planeoT = 0
					enviar("planeo")
				end
			end
		end
	end

	-- Vuelo
	if volando and vueloFuerza and hum then
		local subir = UserInputService:IsKeyDown(Enum.KeyCode.Space) or hum.Jump
		local bajar = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
		local v = corriendo and 22 or 11
		vueloFuerza.Velocity = hum.MoveDirection * v * BS + Vector3.new(0, ((subir and 1 or 0) - (bajar and 1 or 0)) * 8 * BS, 0)
		if hum.FloorMaterial ~= Enum.Material.Air and bajar then
			ponerVuelo(false)
		end
	end

	-- Correr se acaba al pararse
	if corriendo and hum and hum.MoveDirection.Magnitude < 0.1 then
		ponerCorrer(false)
	end

	-- Daño por caída: altura desde la que se cae (en bloques)
	if hum and root then
		local y = root.Position.Y
		local estadoH = hum:GetState()
		local tele = ultimaY and math.abs(y - ultimaY) > 15
		ultimaY = y
		local pies = root.Position / BS
		local enLiquido = Registro.esLiquido(md:get(math.floor(pies.X), math.floor(pies.Y - 1), math.floor(pies.Z)))
		if tele or root.Anchored or volando or enLiquido or estadoH == Enum.HumanoidStateType.Swimming or creativo() then
			alturaCaida = nil
		elseif estadoH == Enum.HumanoidStateType.Freefall or estadoH == Enum.HumanoidStateType.Jumping then
			alturaCaida = math.max(alturaCaida or y, y)
		elseif alturaCaida then
			local bloques = (alturaCaida - y) / BS
			alturaCaida = nil
			if bloques > 3.5 then
				enviar("caida", bloques)
				sonido("caer")
			end
		end
		-- Pasos
		if hum.MoveDirection.Magnitude > 0.1 and hum.FloorMaterial ~= Enum.Material.Air and not agachado then
			tPaso -= dt * (corriendo and 1.3 or 1)
			if tPaso <= 0 then
				tPaso = 0.42
				sonido("paso", nil, 0.9)
			end
		end
	end

	-- Bajo el agua o la lava
	local cam = workspace.CurrentCamera
	if cam then
		local p = cam.CFrame.Position / BS
		local b = md:getSiCargado(math.floor(p.X), math.floor(p.Y), math.floor(p.Z))
		Interfaz.agua(b > 0 and esAgua(b))
		Interfaz.fuego(b > 0 and esLava(b))
	end

	-- Información F3
	if Interfaz.infoVisible() and root then
		local p = root.Position / BS
		local x, y, z = math.floor(p.X), math.floor(p.Y - 1.5), math.floor(p.Z)
		local bio = md:getSiCargado(x, 0, z) >= 0 and md:bioma(x, z) or -1
		local Bi = require(Comp.Datos:WaitForChild("Biomas"))
		local Dm = require(Comp:WaitForChild("Dimensiones"))
		local dim, zl = Generador.dimensionBloque(z)
		local nomBio = bio >= 120 and "El End" or bio >= 100 and (Dm.NOMBRES_BIOMA_NETHER[bio - 99] or "Nether") or (Bi.nombres and Bi.nombres[bio + 1] or tostring(bio))
		local nomDim = ({ superficie = "Superficie", nether = "El Nether", ["end"] = "El End", vacio = "One Block" })[dim] or dim
		Interfaz.info(("Blockverse para Roblox\nDimensión: %s\nXYZ: %d / %d / %d\nChunk: %d, %d\nBioma: %s\nHora: %.1f\nFPS: %d · Render: %s\nSemilla: %d")
			:format(nomDim, x, y, zl, x // 16, zl // 16, nomBio, Lighting.ClockTime, fps, Render.modo, semilla))
	end
end)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">DimensionVista</string><ProtectedString name="Source"><![CDATA[--[[
	Blockverse para Roblox · El Nether y el End (cliente)
	· Ambiente de cada dimensión como en el juego web: niebla roja (del
	  color de cada bioma del Nether) y sin cielo en el Nether; niebla
	  morada oscura y estrellas en el End.
	· El Ender Dragon: el mismo modelo de cajas de dragon.js (cuerpo,
	  cuello, cabeza con ojos morados, cola y alas que aletean), con
	  destello al recibir daño y brillo al morir.
	· Los cristales del End: núcleo rosa con dos marcos que giran y el haz
	  que cura al dragón.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Comp = ReplicatedStorage:WaitForChild("Blockverse")
local Config = require(Comp:WaitForChild("Config"))
local Generador = require(Comp:WaitForChild("Generador"))
local Dimensiones = require(Comp:WaitForChild("Dimensiones"))

local BS = Config.BLOQUE
local jugador = Players.LocalPlayer
local DV = {}

local carpeta = Instance.new("Folder")
carpeta.Name = "DimensionVisible"
carpeta.Parent = workspace

local function hex(n)
	return Color3.fromRGB(n // 65536, (n // 256) % 256, n % 256)
end

------------------------------------------------------------------
-- Ambiente
------------------------------------------------------------------
local original = nil
local actual = "superficie"
local function guardarOriginal()
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	local nubes = workspace.Terrain:FindFirstChildOfClass("Clouds")
	original = {
		Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient, Brightness = Lighting.Brightness,
		FogColor = Lighting.FogColor, FogEnd = Lighting.FogEnd, GlobalShadows = Lighting.GlobalShadows,
		atm = atm and { Density = atm.Density, Color = atm.Color, Decay = atm.Decay, Haze = atm.Haze, Glare = atm.Glare } or nil,
		nubes = nubes and nubes.Enabled,
	}
end

local function aplicar(dim, biomaN)
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	local nubes = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if dim == "superficie" or dim == "vacio" then
		if original then
			for k, v in original do
				if k ~= "atm" and k ~= "nubes" then
					Lighting[k] = v
				end
			end
			if atm and original.atm then
				for k, v in original.atm do
					atm[k] = v
				end
			end
			if nubes and original.nubes ~= nil then
				nubes.Enabled = original.nubes
			end
		end
		return
	end
	if not original then
		guardarOriginal()
	end
	if nubes then
		nubes.Enabled = false
	end
	if dim == "nether" then
		local col = hex(Dimensiones.NIEBLA_NETHER[(biomaN or 0) + 1] or 0x3a100a)
		Lighting.Ambient = Color3.fromRGB(110, 70, 60)
		Lighting.OutdoorAmbient = Color3.fromRGB(110, 70, 60)
		Lighting.Brightness = 1
		Lighting.GlobalShadows = false
		if atm then
			atm.Density = 0.55
			atm.Color = col:Lerp(Color3.new(1, 0.3, 0.2), 0.25)
			atm.Decay = col
			atm.Haze = 2
			atm.Glare = 0
		end
	else
		Lighting.Ambient = Color3.fromRGB(95, 85, 120)
		Lighting.OutdoorAmbient = Color3.fromRGB(95, 85, 120)
		Lighting.Brightness = 0.8
		Lighting.GlobalShadows = false
		if atm then
			atm.Density = 0.4
			atm.Color = Color3.fromRGB(22, 18, 40)
			atm.Decay = Color3.fromRGB(12, 10, 22)
			atm.Haze = 1.2
			atm.Glare = 0
		end
	end
end

-- Dimensión de una posición en studs
function DV.dimensionEn(pos)
	local d = Generador.dimensionBloque(math.floor(pos.Z / BS))
	return d
end

------------------------------------------------------------------
-- Ender Dragon (dragon.js: crearModeloDragon)
------------------------------------------------------------------
local function caja(padre, w, h, d, col, x, y, z)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.SmoothPlastic
	p.Color = hex(col)
	p.Size = Vector3.new(w, h, d) * BS
	p.Parent = padre
	return { p = p, o = Vector3.new(x, y, z) * BS }
end

local dragones = {}
local function nuevoDragon(pieza)
	local m = Instance.new("Model")
	m.Name = "DragonVisible"
	local partes = {}
	local function c(w, h, d, col, x, y, z)
		local q = caja(m, w, h, d, col, x, y, z)
		table.insert(partes, q)
		return q
	end
	c(3, 2.4, 7, 0x1a1a1f, 0, 0, 0)
	for i = 0, 3 do
		c(0.4, 0.7, 0.8, 0x2a2a33, 0, 1.5, 2.5 - i * 1.8)
	end
	for i = 0, 4 do
		c(1.1, 1.1, 1.1, 0x1f1f25, 0, 0.6, 3.9 + i * 1.1)
	end
	local cab = {}
	local function cc(w, h, d, col, x, y, z)
		local q = caja(m, w, h, d, col, x, y + 0.7, z + 9.8)
		table.insert(cab, q)
		return q
	end
	cc(2, 1.6, 2.8, 0x1a1a1f, 0, 0, 0)
	cc(1.6, 0.6, 1.8, 0x222228, 0, -0.7, 0.6)
	local o1 = cc(0.5, 0.18, 0.05, 0xd050ff, -0.55, 0.25, 1.41)
	local o2 = cc(0.5, 0.18, 0.05, 0xd050ff, 0.55, 0.25, 1.41)
	o1.p.Material, o2.p.Material = Enum.Material.Neon, Enum.Material.Neon
	cc(0.3, 0.6, 0.3, 0x444450, -0.6, 1, -0.8)
	cc(0.3, 0.6, 0.3, 0x444450, 0.6, 1, -0.8)
	local cola = {}
	for i = 0, 9 do
		local q = c(1 - i * 0.06, 1 - i * 0.06, 1.1, 0x1f1f25, 0, 0, -4 - i * 1.1)
		q.i = i
		table.insert(cola, q)
	end
	for _, s in { -1, 1 } do
		c(0.6, 1.8, 0.6, 0x1a1a1f, s * 1.1, -1.8, 2)
		c(0.6, 1.8, 0.6, 0x1a1a1f, s * 1.1, -1.8, -2)
	end
	-- Alas: hueso y membrana que giran sobre el hombro
	local alas = {}
	for _, s in { -1, 1 } do
		local hueso = caja(m, 6, 0.25, 0.5, 0x2a2a33, s * 3, 0, 0)
		local mem = caja(m, 6, 0.08, 4.5, 0x333344, s * 3, 0, -2.3)
		table.insert(alas, { s = s, partes = { hueso, mem }, base = Vector3.new(s * 1.5, 0.9, 1) * BS })
	end
	local hl = Instance.new("Highlight")
	hl.Enabled = false
	hl.FillColor = Color3.fromRGB(255, 60, 60)
	hl.FillTransparency = 0.4
	hl.OutlineTransparency = 1
	hl.Parent = m
	m.Parent = carpeta
	local v = { pieza = pieza, m = m, partes = partes, cab = cab, cola = cola, alas = alas, hl = hl, cf = pieza.CFrame, flash = 0, t = 0 }
	v.con = pieza:GetAttributeChangedSignal("golpe"):Connect(function()
		v.flash = 0.3
	end)
	-- Haz de curación
	local a0 = Instance.new("Attachment")
	a0.Parent = workspace.Terrain
	local a1 = Instance.new("Attachment")
	a1.Parent = workspace.Terrain
	local haz = Instance.new("Beam")
	haz.Attachment0, haz.Attachment1 = a0, a1
	haz.Color = ColorSequence.new(Color3.fromRGB(255, 128, 255))
	haz.Width0, haz.Width1 = 0.3, 0.3
	haz.LightEmission = 1
	haz.FaceCamera = true
	haz.Enabled = false
	haz.Parent = workspace.Terrain
	v.haz, v.a0, v.a1 = haz, a0, a1
	dragones[pieza] = v
end

local function quitarDragon(pieza)
	local v = dragones[pieza]
	if v then
		dragones[pieza] = nil
		v.con:Disconnect()
		v.m:Destroy()
		v.haz:Destroy()
		v.a0:Destroy()
		v.a1:Destroy()
	end
end

-- Cristales
local cristales = {}
local function nuevoCristal(pieza)
	local nucleo = Instance.new("Part")
	nucleo.Anchored, nucleo.CanCollide, nucleo.CanQuery, nucleo.CanTouch = true, false, false, false
	nucleo.Size = Vector3.new(0.7, 0.7, 0.7) * BS
	nucleo.Material = Enum.Material.Neon
	nucleo.Color = Color3.fromRGB(255, 128, 208)
	nucleo.Parent = carpeta
	local marcos = {}
	for k, t in { 1.4, 1.12 } do
		local mrc = Instance.new("Part")
		mrc.Anchored, mrc.CanCollide, mrc.CanQuery, mrc.CanTouch = true, false, false, false
		mrc.Size = Vector3.new(t, t, t) * BS
		mrc.Transparency = 1
		local sb = Instance.new("SelectionBox")
		sb.Adornee = mrc
		sb.Color3 = Color3.fromRGB(224, 224, 255)
		sb.LineThickness = 0.05
		sb.Parent = mrc
		mrc.Parent = carpeta
		marcos[k] = mrc
	end
	local luz = Instance.new("PointLight")
	luz.Color = Color3.fromRGB(255, 140, 220)
	luz.Range = 16
	luz.Brightness = 2
	luz.Parent = nucleo
	cristales[pieza] = { nucleo = nucleo, marcos = marcos, edad = math.random() * 5 }
end
local function quitarCristal(pieza)
	local c = cristales[pieza]
	if c then
		cristales[pieza] = nil
		c.nucleo:Destroy()
		for _, m in c.marcos do
			m:Destroy()
		end
	end
end

------------------------------------------------------------------
-- Bucle
------------------------------------------------------------------
function DV.iniciar()
	local criaturas = workspace:WaitForChild("Criaturas")
	local function alAgregar(p)
		if p.Name == "EnderDragon" then
			nuevoDragon(p)
		elseif p.Name == "CristalEnd" then
			nuevoCristal(p)
		end
	end
	for _, p in criaturas:GetChildren() do
		alAgregar(p)
	end
	criaturas.ChildAdded:Connect(alAgregar)
	criaturas.ChildRemoved:Connect(function(p)
		quitarDragon(p)
		quitarCristal(p)
	end)
	local tiempo = 0
	local biomaT = 0
	RunService.RenderStepped:Connect(function(dt)
		tiempo += dt
		-- Ambiente según la dimensión
		local ch = jugador.Character
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		if root then
			local dim = DV.dimensionEn(root.Position)
			if dim == "superficie" and not original then
				-- todavía no se cambió nada
			elseif dim ~= actual or dim == "nether" then
				biomaT -= dt
				if dim ~= actual or biomaT <= 0 then
					biomaT = 1
					local bn = 0
					if dim == "nether" and DV.md then
						local p = root.Position / BS
						local b = DV.md:getSiCargado(math.floor(p.X), 0, math.floor(p.Z))
						if b >= 0 then
							bn = math.max(0, DV.md:bioma(math.floor(p.X), math.floor(p.Z)) - 100)
						end
					end
					aplicar(dim, bn)
				end
			end
			actual = dim
			-- En el Nether y el End no hay sol: siempre de noche sin estrellas del Nether
			if dim == "nether" then
				Lighting.ClockTime = 0
			elseif dim == "end" then
				Lighting.ClockTime = 0
			end
		end
		-- Dragones
		for pieza, v in dragones do
			if not pieza.Parent then
				quitarDragon(pieza)
				continue
			end
			local a = 1 - math.exp(-dt * 10)
			v.cf = v.cf and v.cf:Lerp(pieza.CFrame, a) or pieza.CFrame
			v.t += dt
			local base = v.cf * CFrame.Angles(0, math.pi, 0)
			local fase = pieza:GetAttribute("fase")
			local aleteo = math.sin(v.t * (fase == "embestir" and 5 or 3))
			for _, q in v.partes do
				q.p.CFrame = base * CFrame.new(q.o)
			end
			for _, q in v.cola do
				local i = q.i
				q.p.CFrame = base * CFrame.new(q.o + Vector3.new(math.sin(v.t * 2 - i * 0.5) * i * 0.15, math.sin(v.t * 1.5 - i * 0.4) * i * 0.08, 0) * BS)
			end
			local cabRot = CFrame.new(Vector3.new(0, 0.7, 9.8) * BS) * CFrame.Angles(math.sin(v.t * 2) * 0.1, 0, 0)
			for _, q in v.cab do
				q.p.CFrame = base * cabRot * CFrame.new(q.o - Vector3.new(0, 0.7, 9.8) * BS)
			end
			for _, al in v.alas do
				local rot = CFrame.new(al.base) * CFrame.Angles(0, 0, -al.s * aleteo * 0.6)
				for _, q in al.partes do
					q.p.CFrame = base * rot * CFrame.new(q.o)
				end
			end
			-- Destello rojo y brillo al morir
			v.flash = math.max(0, v.flash - dt)
			local muerto = pieza:GetAttribute("muerto")
			v.hl.Enabled = v.flash > 0 or muerto == true
			if muerto then
				v.hl.FillColor = Color3.new(1, 0.9, 1)
				v.hl.FillTransparency = 0.3
			end
			-- Haz desde el cristal que lo cura
			local ci = pieza:GetAttribute("Cristal")
			local cp = nil
			if ci then
				for p in cristales do
					if p:GetAttribute("Cristal") == ci then
						cp = p
					end
				end
			end
			if cp then
				v.a0.WorldPosition = cp.Position
				v.a1.WorldPosition = v.cf.Position
				v.haz.Enabled = true
			else
				v.haz.Enabled = false
			end
		end
		-- Cristales
		for pieza, c in cristales do
			if not pieza.Parent then
				quitarCristal(pieza)
				continue
			end
			c.edad += dt
			local pos = pieza.Position + Vector3.new(0, math.sin(c.edad * 2) * 0.3 * BS, 0)
			c.nucleo.CFrame = CFrame.new(pos) * CFrame.Angles(0, c.edad * 2, 0)
			c.marcos[1].CFrame = CFrame.new(pos) * CFrame.Angles(c.edad, c.edad * 1.3, 0)
			c.marcos[2].CFrame = CFrame.new(pos) * CFrame.Angles(-c.edad * 1.2, 0, c.edad)
		end
	end)
end

return DV
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">EntidadesVista</string><ProtectedString name="Source"><![CDATA[--[[
	Blockverse para Roblox · Entidades (cliente)
	Dibuja lo que hay en workspace.Entidades como en el juego web:
	· Objetos tirados: su icono girando y flotando (dos si es un montón).
	· Orbes de experiencia: bolitas verdes y amarillas que brillan.
	· Flechas con plumas y bolas de fuego encendidas.
	Todo sigue con suavidad a la pieza del servidor.
]]
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Comp = ReplicatedStorage:WaitForChild("Blockverse")
local Config = require(Comp:WaitForChild("Config"))
local Iconos = require(script.Parent:WaitForChild("Iconos"))

local BS = Config.BLOQUE
local EntidadesVista = {}

local carpeta = Instance.new("Folder")
carpeta.Name = "EntidadesVisibles"
carpeta.Parent = workspace

local vistas = {}
local tiempo = 0

local function pieza(tam, color, material)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = tam
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	return p
end

local function cartel(padre, tam)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromScale(tam, tam)
	bb.LightInfluence = 1
	bb.AlwaysOnTop = false
	bb.ResetOnSpawn = false
	bb.Adornee = padre
	local img = Instance.new("ImageLabel")
	img.Name = "Icono"
	img.BackgroundTransparency = 1
	img.Size = UDim2.fromScale(1, 1)
	img.ResampleMode = Enum.ResamplerMode.Pixelated
	img.Parent = bb
	bb.Parent = padre
	return bb, img
end

local function nueva(p)
	local v = { p = p, pos = nil, fase = math.random() * 6.28 }
	if p.Name == "Item" then
		local ancla = pieza(Vector3.new(0.1, 0.1, 0.1), Color3.new(1, 1, 1))
		ancla.Transparency = 1
		ancla.Parent = carpeta
		local bb, img = cartel(ancla, 0.9 * BS / 3 * 1.4)
		v.ancla, v.bb, v.img = ancla, bb, img
		local function actualizar()
			Iconos.poner(img, p:GetAttribute("id"))
			local n = p:GetAttribute("n") or 1
			if n > 1 and not v.img2 then
				local i2 = img:Clone()
				i2.Position = UDim2.fromScale(0.12, -0.1)
				i2.ZIndex = 0
				i2.Parent = bb
				v.img2 = i2
			elseif n <= 1 and v.img2 then
				v.img2:Destroy()
				v.img2 = nil
			end
			if v.img2 then
				Iconos.poner(v.img2, p:GetAttribute("id"))
			end
		end
		actualizar()
		v.con = { p:GetAttributeChangedSignal("n"):Connect(actualizar), p:GetAttributeChangedSignal("id"):Connect(actualizar) }
		v.tipo = "item"
	elseif p.Name == "Orbe" then
		local valor = p:GetAttribute("valor") or 1
		local t = (0.18 + math.min(valor, 17) / 17 * 0.14) * BS
		local o = pieza(Vector3.new(t, t, t), Color3.fromRGB(170, 255, 60), Enum.Material.Neon)
		o.Shape = Enum.PartType.Ball
		o.Transparency = 0.1
		local luz = Instance.new("PointLight")
		luz.Color = Color3.fromRGB(180, 255, 80)
		luz.Range = 4
		luz.Brightness = 0.6
		luz.Parent = o
		o.Parent = carpeta
		v.vis = o
		v.tipo = "orbe"
	elseif p.Name == "Flecha" then
		local m = Instance.new("Model")
		local asta = pieza(Vector3.new(0.06, 0.06, 0.9) * BS / 3 * 2, Color3.fromRGB(120, 90, 55), Enum.Material.Wood)
		asta.Parent = m
		local punta = pieza(Vector3.new(0.1, 0.1, 0.12) * BS / 3 * 2, Color3.fromRGB(190, 190, 195), Enum.Material.Metal)
		punta.Parent = m
		local pluma = pieza(Vector3.new(0.02, 0.16, 0.22) * BS / 3 * 2, Color3.fromRGB(235, 235, 235))
		pluma.Parent = m
		m.Parent = carpeta
		v.asta, v.punta, v.pluma, v.vis = asta, punta, pluma, m
		v.tipo = "flecha"
	elseif p.Name == "Bola" then
		local azul = p:GetAttribute("tipo") == "bolaWither"
		local o = pieza(Vector3.new(0.5, 0.5, 0.5) * BS / 3 * 2, azul and Color3.fromRGB(60, 60, 70) or Color3.fromRGB(255, 120, 20), Enum.Material.Neon)
		o.Shape = Enum.PartType.Ball
		local luz = Instance.new("PointLight")
		luz.Color = Color3.fromRGB(255, 150, 60)
		luz.Range = 14
		luz.Brightness = 2
		luz.Parent = o
		local fuego = Instance.new("Fire")
		fuego.Size = 2
		fuego.Heat = 4
		fuego.Parent = o
		o.Parent = carpeta
		v.vis = o
		v.tipo = "bola"
	else
		return
	end
	vistas[p] = v
end

local function quitar(p)
	local v = vistas[p]
	if not v then
		return
	end
	vistas[p] = nil
	if v.con then
		for _, c in v.con do
			c:Disconnect()
		end
	end
	if v.ancla then
		v.ancla:Destroy()
	end
	if v.vis then
		v.vis:Destroy()
	end
end

function EntidadesVista.iniciar()
	local ent = workspace:WaitForChild("Entidades")
	for _, p in ent:GetChildren() do
		nueva(p)
	end
	ent.ChildAdded:Connect(nueva)
	ent.ChildRemoved:Connect(quitar)
	RunService.RenderStepped:Connect(function(dt)
		tiempo += dt
		local a = 1 - math.exp(-dt * 16)
		for p, v in vistas do
			if not p.Parent then
				quitar(p)
				continue
			end
			v.pos = v.pos and v.pos:Lerp(p.Position, a) or p.Position
			if v.tipo == "item" then
				v.ancla.Position = v.pos + Vector3.new(0, (0.25 + math.sin(tiempo * 2.5 + v.fase) * 0.08) * BS, 0)
			elseif v.tipo == "orbe" then
				local c = 0.5 + math.sin(tiempo * 6 + v.fase) * 0.5
				v.vis.Color = Color3.fromRGB(150 + c * 105, 255, 40 + c * 40)
				v.vis.Position = v.pos + Vector3.new(0, 0.12 * BS, 0)
			elseif v.tipo == "flecha" then
				local cf = CFrame.new(v.pos) * p.CFrame.Rotation
				local largo = v.asta.Size.Z
				v.asta.CFrame = cf
				v.punta.CFrame = cf * CFrame.new(0, 0, -largo / 2)
				v.pluma.CFrame = cf * CFrame.new(0, 0, largo / 2 - v.pluma.Size.Z / 2)
			elseif v.tipo == "bola" then
				v.vis.CFrame = CFrame.new(v.pos) * CFrame.Angles(tiempo * 5, tiempo * 3, 0)
			end
		end
	end)
end

return EntidadesVista
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">Iconos</string><ProtectedString name="Source"><![CDATA[--[[
	Blockverse para Roblox · Iconos (cliente)
	· Los 778 iconos del juego web (cubos isométricos de 48 px para los
	  bloques y dibujos de 16 px para los objetos) en dos hojas de 1024 px.
	· Los iconos del HUD (corazones, comida, armadura y burbujas) con el
	  mismo pixel art que el juego web.
	· Las grietas al picar (las mismas 10 fases que texGrietas).
	Si Roblox no deja crear imágenes editables, se usa un cuadro de color
	con las iniciales del objeto.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Comp = ReplicatedStorage:WaitForChild("Blockverse")
local Codec = require(Comp:WaitForChild("Codec"))
local Ruido = require(Comp:WaitForChild("Ruido"))
local Registro = require(Comp:WaitForChild("Registro"))
local Imagenes = require(script.Parent:WaitForChild("Imagenes"))

local Iconos = {}

local CEL = 48
local HOJA = 1024
local POR_FILA = HOJA // CEL -- 21
local POR_HOJA = POR_FILA * POR_FILA

local hojas = {} -- índice -> EditableImage
local sitio = {} -- id -> {hoja, x, y}
local colorMedio = {} -- id -> Color3
local listo = false

-- Prepara las hojas de iconos (se llama una vez al empezar)
function Iconos.preparar()
	if listo then
		return
	end
	listo = true
	local Datos = require(Comp.Datos:WaitForChild("Iconos"))
	local px = Codec.leer(Datos.datos, Datos.tam)
	local ids = {}
	for id in Datos.indice do
		table.insert(ids, id)
	end
	table.sort(ids)
	local buffers = {}
	for k, id in ids do
		local h = (k - 1) // POR_HOJA + 1
		local c = (k - 1) % POR_HOJA
		local x, y = (c % POR_FILA) * CEL, (c // POR_FILA) * CEL
		local e = Datos.indice[id]
		local ofs, w, hh = e[1], e[2], e[3]
		buffers[h] = buffers[h] or buffer.create(HOJA * HOJA * 4)
		local esc = CEL // math.max(w, hh)
		local ox, oy = x + (CEL - w * esc) // 2, y + (CEL - hh * esc) // 2
		Imagenes.pegar(buffers[h], HOJA, ox, oy, px, ofs, w, hh, esc)
		sitio[id] = { h, x, y }
		-- Color medio (para el modo de respaldo y las partículas)
		local r, g, b, n = 0, 0, 0, 0
		for i = 0, w * hh - 1, 3 do
			local o = ofs + i * 4
			if buffer.readu8(px, o + 3) > 128 then
				r += buffer.readu8(px, o)
				g += buffer.readu8(px, o + 1)
				b += buffer.readu8(px, o + 2)
				n += 1
			end
		end
		n = math.max(n, 1)
		colorMedio[id] = Color3.fromRGB(r / n, g / n, b / n)
	end
	-- Objetos propios de Roblox (Bed Wars): usan el icono de otro objeto
	for id, o in Registro.objetos do
		if o.icono and sitio[o.icono] and not sitio[id] then
			sitio[id] = sitio[o.icono]
			colorMedio[id] = colorMedio[o.icono]
		end
	end
	for h, buf in buffers do
		hojas[h] = Imagenes.crear(HOJA, HOJA, buf)
		task.wait()
	end
end

function Iconos.color(id)
	return colorMedio[id] or Color3.fromRGB(150, 150, 150)
end

-- Pone el icono del objeto `id` en un ImageLabel (nil o 0 lo vacía)
function Iconos.poner(etiqueta, id)
	local s = id and sitio[id]
	local ini = etiqueta:FindFirstChild("Iniciales")
	if not s then
		etiqueta.ImageTransparency = 1
		if ini then
			ini.Visible = false
		end
		etiqueta.BackgroundTransparency = 1
		return
	end
	local img = hojas[s[1]]
	if img and Imagenes.enEtiqueta(etiqueta, img) then
		etiqueta.ImageRectOffset = Vector2.new(s[2], s[3])
		etiqueta.ImageRectSize = Vector2.new(CEL, CEL)
		etiqueta.ImageTransparency = 0
		etiqueta.BackgroundTransparency = 1
		if ini then
			ini.Visible = false
		end
		return
	end
	-- Respaldo: cuadro de color con las iniciales
	etiqueta.ImageTransparency = 1
	etiqueta.BackgroundTransparency = 0
	etiqueta.BackgroundColor3 = Iconos.color(id)
	if not ini then
		ini = Instance.new("TextLabel")
		ini.Name = "Iniciales"
		ini.BackgroundTransparency = 1
		ini.Size = UDim2.fromScale(1, 1)
		ini.Font = Enum.Font.GothamBold
		ini.TextScaled = true
		ini.TextColor3 = Color3.new(1, 1, 1)
		ini.TextStrokeTransparency = 0.3
		ini.Parent = etiqueta
	end
	ini.Visible = true
	ini.Text = string.sub(Registro.nombre(id), 1, 2)
end

------------------------------------------------------------------
-- Iconos del HUD (igual que iconoEstado / tresIconos del juego web)
------------------------------------------------------------------
local P_CORAZON = { ".kk...kk.", "krrk.krrk", "krwrkrrrk", "krrrrrrrk", "krrrrrrrk", ".krrrrrk.", "..krrrk..", "...krk...", "....k...." }
local P_COMIDA = { "....kkk..", "...kbbbk.", "..kbbbbbk", "..kbbbbbk", "..kbbbbk.", ".kkkkkk..", "kwk......", "kwk......", ".k......." }
local P_ARMADURA = { "kk.....kk", "kbbk.kbbk", "kbbbkbbbk", ".kbbbbbk.", ".kbbbbbk.", ".kbwbbbk.", ".kbbbbbk.", ".kbbbbbk.", "..kkkkk.." }
local P_BURBUJA = { ".........", "..kkkk...", ".kwwbbk..", ".kwbbbk..", ".kbbbbk..", ".kbbbbk..", "..kkkk...", ".........", "........." }

local function hex(s)
	local n = tonumber(string.sub(s, 2), 16)
	return { n // 65536, (n // 256) % 256, n % 256 }
end

-- Hoja del HUD: 9 px por icono ampliado x4 (36 px), una fila por tipo
local ESC_HUD = 4
local LADO = 9 * ESC_HUD
local hudImg
local hudSitio = {}
local HUD_TIPOS = {
	{ "vida", P_CORAZON, "#e0202c", "#ffc8c8" },
	{ "veneno", P_CORAZON, "#8a9a2a", "#d8e8a0" },
	{ "wither", P_CORAZON, "#2a2a2a", "#6a6a6a" },
	{ "comida", P_COMIDA, "#b8703a", "#f0f0e8" },
	{ "hambre", P_COMIDA, "#6a8a3a", "#d0e0a0" },
	{ "armadura", P_ARMADURA, "#c8c8d0", "#ffffff" },
}

local function prepararHud()
	local W = LADO * 3
	local H = LADO * (#HUD_TIPOS + 1)
	local buf = buffer.create(W * H * 4)
	local function punto(x, y, c)
		for ey = 0, ESC_HUD - 1 do
			for ex = 0, ESC_HUD - 1 do
				local o = ((y * ESC_HUD + ey) * W + x * ESC_HUD + ex) * 4
				buffer.writeu8(buf, o, c[1])
				buffer.writeu8(buf, o + 1, c[2])
				buffer.writeu8(buf, o + 2, c[3])
				buffer.writeu8(buf, o + 3, 255)
			end
		end
	end
	local vacio, borde = hex("#3a3434"), hex("#141010")
	for fila, t in HUD_TIPOS do
		local nombre, p, lleno, brillo = t[1], t[2], hex(t[3]), hex(t[4])
		for m, modo in { "lleno", "medio", "vacio" } do
			local ox, oy = (m - 1) * 9, (fila - 1) * 9
			for y, linea in p do
				for i = 1, #linea do
					local ch = string.sub(linea, i, i)
					if ch ~= "." then
						local c
						if ch == "k" then
							c = borde
						else
							local on = modo == "lleno" or (modo == "medio" and i - 1 <= 4)
							c = on and (ch == "w" and brillo or lleno) or vacio
						end
						punto(ox + i - 1, oy + y - 1, c)
					end
				end
			end
			hudSitio[nombre .. "_" .. modo] = Vector2.new(ox * ESC_HUD, oy * ESC_HUD)
		end
	end
	-- Burbuja
	local oy = #HUD_TIPOS * 9
	for y, linea in P_BURBUJA do
		for i = 1, #linea do
			local ch = string.sub(linea, i, i)
			if ch ~= "." then
				punto(i - 1, oy + y - 1, ch == "k" and hex("#1c3a6a") or ch == "w" and { 255, 255, 255 } or hex("#6ab0ff"))
			end
		end
	end
	hudSitio.burbuja = Vector2.new(0, oy * ESC_HUD)
	hudImg = Imagenes.crear(W, H, buf)
end

-- Pone un icono del HUD (p. ej. "vida_lleno") en un ImageLabel; devuelve false si no hay imágenes
function Iconos.hud(etiqueta, nombre)
	if hudImg == nil and Imagenes.disponible then
		prepararHud()
	end
	local s = hudSitio[nombre]
	if not hudImg or not s then
		return false
	end
	if etiqueta:GetAttribute("hud") ~= nombre then
		etiqueta:SetAttribute("hud", nombre)
		Imagenes.enEtiqueta(etiqueta, hudImg)
		etiqueta.ImageRectOffset = s
		etiqueta.ImageRectSize = Vector2.new(LADO, LADO)
	end
	return true
end

------------------------------------------------------------------
-- Grietas al picar (texGrietas del juego web: 10 fases de 16 px)
------------------------------------------------------------------
local grietas
function Iconos.grietas()
	if grietas ~= nil then
		return grietas or nil
	end
	grietas = false
	local r = Ruido.mulberry32(7)
	local segs = {}
	for _ = 1, 5 do
		local x, y = 7 + r() * 2, 7 + r() * 2
		for _ = 1, 8 do
			local a = r() * math.pi * 2
			local nx, ny = math.clamp(x + math.cos(a) * 2.4, 0, 15), math.clamp(y + math.sin(a) * 2.4, 0, 15)
			table.insert(segs, { x, y, nx, ny })
			x, y = nx, ny
		end
	end
	local ESC = 4
	local lista = {}
	for e = 0, 9 do
		local buf = buffer.create(64 * 64 * 4)
		local n = math.ceil(#segs * (e + 1) / 10)
		for i = 1, n do
			local x0, y0, x1, y1 = segs[i][1], segs[i][2], segs[i][3], segs[i][4]
			local m = math.max(math.abs(x1 - x0), math.abs(y1 - y0), 1)
			for t = 0, math.floor(m) do
				local px = math.clamp(math.floor(x0 + (x1 - x0) * t / m + 0.5), 0, 15)
				local py = math.clamp(math.floor(y0 + (y1 - y0) * t / m + 0.5), 0, 15)
				for ey = 0, ESC - 1 do
					for ex = 0, ESC - 1 do
						buffer.writeu32(buf, ((py * ESC + ey) * 64 + px * ESC + ex) * 4, 0xBF000000)
					end
				end
			end
		end
		local img = Imagenes.crear(64, 64, buf)
		if not img then
			return nil
		end
		lista[e + 1] = img
	end
	grietas = lista
	return lista
end

return Iconos
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000034"><Properties><string name="Name">Imagenes</string><ProtectedString name="Source"><![CDATA[--[[
	Blockverse para Roblox · Imágenes (cliente)
	Crea imágenes editables (EditableImage) a partir de los píxeles del
	juego web: atlas de texturas, iconos de objetos, texturas de criaturas
	y grietas al picar. Si Roblox no deja crearlas, devuelve nil y el
	juego usa colores planos.
]]
local AssetService = game:GetService("AssetService")

local Imagenes = {}
Imagenes.disponible = true

-- Crea una EditableImage de w × h con los píxeles RGBA del buffer
function Imagenes.crear(w, h, pixeles)
	if not Imagenes.disponible then
		return nil
	end
	local ok, img = pcall(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(w, h) })
	end)
	if not ok or not img then
		warn("[Blockverse] No se pudo crear una imagen editable: " .. tostring(img))
		Imagenes.disponible = false
		return nil
	end
	if pixeles then
		local ok2, err = pcall(function()
			img:WritePixelsBuffer(Vector2.zero, Vector2.new(w, h), pixeles)
		end)
		if not ok2 then
			warn("[Blockverse] No se pudieron escribir los píxeles: " .. tostring(err))
		end
	end
	return img
end

function Imagenes.contenido(img)
	local ok, c = pcall(function()
		return Content.fromObject(img)
	end)
	return ok and c or nil
end

-- Pone la imagen en un ImageLabel / ImageButton
function Imagenes.enEtiqueta(etiqueta, img)
	local c = img and Imagenes.contenido(img)
	if not c then
		return false
	end
	local ok = pcall(function()
		etiqueta.ImageContent = c
	end)
	return ok
end

-- Pone la imagen como textura de un MeshPart
function Imagenes.enMalla(parte, img)
	local c = img and Imagenes.contenido(img)
	if not c then
		return false
	end
	local ok = pcall(function()
		parte.TextureContent = c
	end)
	return ok
end

-- Pone la imagen en un Decal
function Imagenes.enCalcomania(decal, img)
	local c = img and Imagenes.contenido(img)
	if not c then
		return false
	end
	local ok = pcall(function()
		decal.TextureContent = c
	end)
	return ok
end

-- Copia un rectángulo RGBA (w × h, en `src` desde `ofs`) a `dst` (ancho dw) en (x, y), ampliado `esc` veces
function Imagenes.pegar(dst, dw, x, y, src, ofs, w, h, esc)
	for sy = 0, h - 1 do
		for sx = 0, w - 1 do
			local v = buffer.readu32(src, ofs + (sy * w + sx) * 4)
			for ey = 0, esc - 1 do
				local fila = ((y + sy * esc + ey) * dw + x + sx * esc) * 4
				for ex = 0, esc - 1 do
					buffer.writeu32(dst, fila + ex * 4, v)
				end
			end
		end
	end
end

return Imagenes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">Interfaz</string><ProtectedString name="Source"><![CDATA[--[[
	Blockverse para Roblox · Interfaz (cliente)
	Con el aspecto del juego web (paneles grises con relieve, casillas
	hundidas y los iconos del juego):
	· HUD: barra rápida, corazones, comida, armadura, burbujas de aire,
	  barra y nivel de experiencia, nombre del objeto, mira, carga de
	  ataque, barra de uso (comer, arco), avisos, títulos y barra de
	  One Block.
	· Pantallas: inventario (armadura, mano izquierda y crafteo 2x2),
	  mesa de trabajo 3x3, horno, cofre, paleta creativa con buscador y
	  pestañas, y libro de recetas.
	· Menú de inicio, pantalla de carga, pantalla de muerte, efectos en
	  pantalla (daño, agua, fuego, dormir), información F3 y botones
	  táctiles.
	Los clics se envían al servidor, que es quien mueve los objetos.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Comp = ReplicatedStorage:WaitForChild("Blockverse")
local Registro = require(Comp:WaitForChild("Registro"))
local Crafteo = require(Comp:WaitForChild("Crafteo"))
local Iconos = require(script.Parent:WaitForChild("Iconos"))
local Enc = require(Comp:WaitForChild("Encantamientos"))

local OB, BL = Registro.objetos, Registro.bloques
local jugador = Players.LocalPlayer

local Interfaz = {}
local obActivo = false -- la barra de arriba la usa One Block
Interfaz.enviar = function(...) end
Interfaz.alSeleccionar = function(i) end
Interfaz.alElegirModo = function(m) end
Interfaz.alCerrar = function() end

------------------------------------------------------------------
-- Colores del juego web
------------------------------------------------------------------
local C = {
	panel = Color3.fromHex("c6c6c6"), luz = Color3.fromHex("ffffff"), sombra = Color3.fromHex("555555"),
	borde = Color3.fromHex("000000"), slot = Color3.fromHex("8b8b8b"), slotLuz = Color3.fromHex("ffffff"),
	slotSombra = Color3.fromHex("373737"), texto = Color3.fromHex("3f3f3f"), xp = Color3.fromHex("80ff20"),
	hover = Color3.fromHex("a8a8a8"),
}
local FUENTE = Enum.Font.GothamBold
local FUENTE_N = Enum.Font.GothamBlack
local S = 40 -- tamaño de una casilla

------------------------------------------------------------------
-- Utilidades
------------------------------------------------------------------
local function nuevo(clase, props, padre)
	local o = Instance.new(clase)
	for k, v in props do
		o[k] = v
	end
	if padre then
		o.Parent = padre
	end
	return o
end

local function texto(props, padre)
	local t = nuevo("TextLabel", {
		BackgroundTransparency = 1, Font = FUENTE, TextColor3 = Color3.new(1, 1, 1), TextSize = 16,
		TextStrokeTransparency = 0.4,
	}, padre)
	for k, v in props do
		t[k] = v
	end
	return t
end

-- Relieve (luz arriba-izquierda, sombra abajo-derecha) como los box-shadow del CSS
local function relieve(f, luz, sombra, g)
	g = g or 2
	nuevo("Frame", { Name = "L1", BorderSizePixel = 0, BackgroundColor3 = luz, Size = UDim2.new(1, 0, 0, g), ZIndex = f.ZIndex }, f)
	nuevo("Frame", { Name = "L2", BorderSizePixel = 0, BackgroundColor3 = luz, Size = UDim2.new(0, g, 1, 0), ZIndex = f.ZIndex }, f)
	nuevo("Frame", { Name = "S1", BorderSizePixel = 0, BackgroundColor3 = sombra, Position = UDim2.new(0, 0, 1, -g), Size = UDim2.new(1, 0, 0, g), ZIndex = f.ZIndex }, f)
	nuevo("Frame", { Name = "S2", BorderSizePixel = 0, BackgroundColor3 = sombra, Position = UDim2.new(1, -g, 0, 0), Size = UDim2.new(0, g, 1, 0), ZIndex = f.ZIndex }, f)
end

local function panel(props, padre)
	local p = nuevo("Frame", { BackgroundColor3 = C.panel, BorderSizePixel = 0 }, padre)
	for k, v in props do
		p[k] = v
	end
	nuevo("UIStroke", { Color = C.borde, Thickness = 2 }, p)
	nuevo("UICorner", { CornerRadius = UDim.new(0, 4) }, p)
	relieve(p, C.luz, C.sombra, 3)
	return p
end

local function boton(txt, props, padre, alClic)
	local b = nuevo("TextButton", {
		BackgroundColor3 = Color3.fromHex("6f6f6f"), BorderSizePixel = 0, Font = FUENTE, Text = txt, TextSize = 17,
		TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.5, AutoButtonColor = true,
	}, padre)
	for k, v in props do
		b[k] = v
	end
	nuevo("UIStroke", { Color = C.borde, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, b)
	relieve(b, Color3.fromHex("aaaaaa"), Color3.fromHex("3a3a3a"), 2)
	if alClic then
		b.Activated:Connect(alClic)
	end
	return b
end

local function shift()
	return UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
end

