 = true}, [342] = {a = 3, c = 92, o = 498, al = true}, [345] = {a = 3, c = 93, o = 499, al = true}, [364] = {a = 3, c = 94, o = 500, al = true}, [367] = {a = 3, c = 95, o = 501, al = true}, [376] = {a = 3, c = 96, o = 502, al = true}, [377] = {a = 3, c = 97, o = 503, al = true}, [447] = {a = 3, c = 98, o = 504, al = true}, [448] = {a = 3, c = 99, o = 505, al = true}, [449] = {a = 3, c = 100, o = 506, al = true}, [450] = {a = 3, c = 101, o = 507, al = true}, [454] = {a = 3, c = 102, o = 508, al = true}, [456] = {a = 3, c = 103, o = 509, al = true}, [457] = {a = 3, c = 104, o = 510, al = true}, [459] = {a = 3, c = 105, o = 511, al = true}, [460] = {a = 3, c = 106, o = 512, al = true}, [462] = {a = 3, c = 107, o = 513, al = true}, [463] = {a = 3, c = 108, o = 514, al = true}, [465] = {a = 3, c = 109, o = 515, al = true}, [466] = {a = 3, c = 110, o = 516, al = true}, [468] = {a = 3, c = 111, o = 517, al = true}, [469] = {a = 3, c = 112, o = 518, al = true}, [485] = {a = 3, c = 113, o = 519, al = true}, [488] = {a = 3, c = 114, o = 520, al = true}, [490] = {a = 3, c = 115, o = 521, al = true}, [491] = {a = 3, c = 116, o = 522, al = true}, [498] = {a = 3, c = 117, o = 523, al = true}, [499] = {a = 3, c = 118, o = 524, al = true}, [500] = {a = 3, c = 119, o = 525, al = true}, [501] = {a = 3, c = 120, o = 526, al = true}, [502] = {a = 3, c = 121, o = 527, al = true}, [503] = {a = 3, c = 122, o = 528, al = true}, [505] = {a = 3, c = 123, o = 529, g = true, al = true}, [507] = {a = 3, c = 124, o = 530, al = true}, [508] = {a = 3, c = 125, o = 531, al = true}, [527] = {a = 3, c = 126, o = 532, al = true}, [532] = {a = 3, c = 127, o = 533, al = true}, [542] = {a = 3, c = 128, o = 534, al = true}, [543] = {a = 3, c = 129, o = 535, al = true}, [544] = {a = 3, c = 130, o = 536, al = true}, [545] = {a = 3, c = 131, o = 537, al = true}, [546] = {a = 3, c = 132, o = 538, al = true}, [547] = {a = 3, c = 133, o = 539, al = true}, [548] = {a = 3, c = 134, o = 540, al = true}, [549] = {a = 3, c = 135, o = 541, al = true}, [550] = {a = 3, c = 136, o = 542, al = true}, [551] = {a = 3, c = 137, o = 543, al = true}, [552] = {a = 3, c = 138, o = 544, al = true}, [553] = {a = 3, c = 139, o = 545, al = true}, [554] = {a = 3, c = 140, o = 546, al = true}, [556] = {a = 3, c = 141, o = 547, al = true}, [557] = {a = 3, c = 142, o = 548, al = true}, [558] = {a = 3, c = 143, o = 549, al = true}, [559] = {a = 3, c = 144, o = 550, al = true}},
