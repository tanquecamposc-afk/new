		Interfaz.alternarLibro()
	end)
	local cas, _ = bloqueInventario(p, 30 + 4 * (S + 2) + 10)
	pantallas.inventario = { panel = p, cas = cas, extra = arm, rejilla = rej, salida = sal, muneco = muneco, libro = libro, w = 2 }
end

