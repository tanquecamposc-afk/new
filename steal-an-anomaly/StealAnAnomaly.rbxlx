			<Item class="ModuleScript" referent="RBX00000825">
				<Properties>
					<string name="Name">AnomalyData</string>
					<ProtectedString name="Source"><![CDATA[-- Bestiario de anomalías. Cada una se construye con piezas (AnomalyBuilder),
-- así que no hace falta subir mallas: todo funciona al abrir el archivo.
