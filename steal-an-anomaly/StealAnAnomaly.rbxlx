		label({ Position = UDim2.fromOffset(16, 100), Size = UDim2.new(1, -32, 0, 26), Text = "+1 cápsula  •  +" .. Config.LockPerLevel .. "s de láser  •  menos fugas en el apagón", TextColor3 = T.Accent2, ZIndex = 7, Parent = c })
