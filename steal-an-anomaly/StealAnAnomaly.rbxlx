	end
	make(b, "Torso", BLOCK, V(1.8, 2.1, 0.9), CF(0, 3.25, 0), "P")
	make(b, "Shirt", BLOCK, V(0.5, 1.6, 0.05), CF(0, 3.5, -0.47), C(240, 240, 240))
