			<Item class="ModuleScript" referent="RBX00000826">
				<Properties>
					<string name="Name">Util</string>
					<ProtectedString name="Source"><![CDATA[local Config = require(script.Parent.Config)
local AnomalyData = require(script.Parent.AnomalyData)

local Util = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx" }

function Util.Format(n)
	n = math.floor(tonumber(n) or 0)
	if math.abs(n) < 1000 then
		return tostring(n)
	end
	local i = 1
	local v = n
	while math.abs(v) >= 1000 and i < #SUFFIXES do
		v = v / 1000
		i += 1
	end
	if math.abs(v) >= 100 then
		return string.format("%d%s", math.floor(v), SUFFIXES[i])
	end
	return string.format("%.1f%s", math.floor(v * 10) / 10, SUFFIXES[i])
end

function Util.Money(n)
	return "$" .. Util.Format(n)
end

function Util.Time(sec)
	sec = math.max(0, math.floor(sec))
	return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

function Util.MutMult(mutId)
	local m = mutId and Config.MutationById[mutId]
	return m and m.Mult or 1
end

-- Valor y producción de un registro {Id, Mut}
function Util.Value(record)
	local def = AnomalyData.ById[record.Id]
	if not def then
		return 0
	end
	return def.Price * Util.MutMult(record.Mut)
end

function Util.Income(record)
	local def = AnomalyData.ById[record.Id]
	if not def then
		return 0
	end
	return def.Income * Util.MutMult(record.Mut)
end

function Util.DisplayName(record)
	local def = AnomalyData.ById[record.Id]
	local name = def and def.Name or "???"
	local m = record.Mut and Config.MutationById[record.Mut]
	if m then
		return m.Name .. " " .. name
	end
	return name
end

function Util.WeightedPick(list, weightKey, rng)
	local total = 0
	for _, item in ipairs(list) do
		total += item[weightKey]
	end
	local roll = (rng and rng:NextNumber() or math.random()) * total
	for _, item in ipairs(list) do
		roll -= item[weightKey]
		if roll <= 0 then
			return item
		end
	end
	return list[#list]
end

-- Decide lo que contiene un huevo al aparecer en el mercado
function Util.RollEgg(eggId, mutBoost, allowContamination)
	local egg = Config.EggById[eggId]
	local pool = {}
	for rarityId, w in pairs(egg.Pool) do
		if AnomalyData.ByRarity[rarityId] then
			table.insert(pool, { Id = rarityId, W = w })
		end
	end
	table.sort(pool, function(a, b)
		return a.Id < b.Id
	end)
	local rarity = Util.WeightedPick(pool, "W")
	local defs = AnomalyData.ByRarity[rarity.Id]
	local def = defs[math.random(1, #defs)]
	local mut
	for i = #Config.Mutations, 1, -1 do
		local m = Config.Mutations[i]
		if math.random() < m.Chance * (mutBoost or 1) then
			mut = m.Id
			break
		end
	end
	local result = { Id = def.Id, Mut = mut }
	if allowContamination ~= false and egg.Order >= 2 and math.random() < Config.ContaminationChance then
		result.Mimic = true
		result.Tell = Config.MimicTells[math.random(1, #Config.MimicTells)]
	end
	return { Egg = eggId, Result = result }
end

function Util.EggName(record)
	local egg = Config.EggById[record.Egg]
	return egg and egg.Name or "Huevo"
end

return Util
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000827">
				<Properties>
					<string name="Name">AnomalyBuilder</string>
					<ProtectedString name="Source"><![CDATA[-- Construye los modelos de las anomalías a partir de piezas.
-- Las animaciones se describen con atributos (A_Type, A_Speed...) que
-- interpreta el LocalScript AnomalyAnimator en cada cliente.
local CollectionService = game:GetService("CollectionService")

local Config = require(script.Parent.Config)
local AnomalyData = require(script.Parent.AnomalyData)

local Builder = {}

local CYL = Enum.PartType.Cylinder
local BALL = Enum.PartType.Ball
local BLOCK = Enum.PartType.Block
local NEON = Enum.Material.Neon
local SMOOTH = Enum.Material.SmoothPlastic

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local C = Color3.fromRGB
local TAU = math.pi * 2

local UP = ANG(0, 0, math.pi / 2) -- cilindro vertical
local FACE = ANG(0, math.pi / 2, 0) -- cilindro como disco mirando a -Z

local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function make(b, name, shape, size, cf, role, material, anim, transparency)
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape
	p.Size = size * b.s
	if typeof(role) == "Color3" then
		p.Color = role
		p:SetAttribute("Role", "X")
	else
		p.Color = b[role]
		p:SetAttribute("Role", role)
	end
	p.Material = material or SMOOTH
	p.Transparency = transparency or 0
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.Anchored = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local off = CF(cf.Position * b.s) * cf.Rotation
	p.CFrame = b.root.CFrame * off
	local w = Instance.new("Weld")
	w.Name = "W"
	w.Part0 = b.root
	w.Part1 = p
	w.C0 = off
	w.Parent = p
	p:SetAttribute("BaseC0", off)
	p:SetAttribute("BaseSize", p.Size)
	p:SetAttribute("BaseT", p.Transparency)
	if anim then
		for k, v in pairs(anim) do
			if k == "Pivot" then
				v = v * b.s
			end
			p:SetAttribute("A_" .. k, v)
		end
	end
	p.Parent = b.model
	table.insert(b.parts, p)
	return p
end

-- Disco pegado a la superficie de una esfera
local function onSphere(center, radius, dir)
	local n = dir.Unit
	local pos = center + n * radius
	return CFrame.lookAt(pos, pos + n) * FACE
end

local Archetypes = {}

function Archetypes.watcher(b)
	b.h = 5.8
	b.model:SetAttribute("BobAmp", 0.35)
	make(b, "Foot", CYL, V(0.6, 2.6, 2.6), CF(0, 0.3, 0) * UP, "P")
	make(b, "Stalk", CYL, V(2.4, 0.6, 0.6), CF(0, 1.5, 0) * UP, "P")
	for i = 1, 5 do
		local a = i / 5 * TAU
		make(b, "Tendril", BLOCK, V(0.25, 1.4, 0.25), CF(math.cos(a) * 1.0, 0.9, math.sin(a) * 1.0) * ANG(math.sin(a) * 0.5, 0, math.cos(a) * 0.5), "P", nil, { Type = "wiggle", Speed = 3, Amp = 0.25, Phase = i })
	end
	local look = { Type = "swing", Pivot = V(0, 4, 0), Axis = V(0, 1, 0), Speed = 0.7, Amp = 0.35 }
	make(b, "Ball", BALL, V(3.4, 3.4, 3.4), CF(0, 4, 0), "S", nil, look)
	make(b, "Eye", CYL, V(0.2, 1.9, 1.9), CF(0, 4, -1.62) * FACE, "E", NEON, look)
	make(b, "Pupil", CYL, V(0.25, 0.8, 0.8), CF(0, 4, -1.7) * FACE, C(10, 10, 10), nil, look)
	for i = 1, 4 do
		local a = i / 4 * TAU + 0.4
		make(b, "Vein", BLOCK, V(0.1, 0.9, 0.1), CF(math.cos(a) * 1.05, 4 + math.sin(a) * 1.05, -1.25) * ANG(0, 0, a + math.pi / 2), C(210, 40, 50), NEON, look)
	end
end

function Archetypes.tvhead(b)
	b.h = 7.2
	b.model:SetAttribute("BobAmp", 0.15)
	for x = -1, 1, 2 do
		make(b, "Leg", BLOCK, V(0.5, 1.6, 0.5), CF(x * 0.6, 0.8, 0), C(25, 25, 30), nil, { Type = "swing", Pivot = V(x * 0.6, 1.6, 0), Axis = V(1, 0, 0), Speed = 6, Amp = 0.3, Phase = x * 1.5 })
	end
	make(b, "Body", BLOCK, V(2, 2, 1.2), CF(0, 2.6, 0), "P")
	for x = -1, 1, 2 do
		make(b, "Arm", BLOCK, V(0.45, 1.8, 0.45), CF(x * 1.25, 2.6, 0), "P", nil, { Type = "swing", Pivot = V(x * 1.25, 3.4, 0), Axis = V(1, 0, 0), Speed = 4, Amp = 0.4, Phase = x })
	end
	make(b, "TV", BLOCK, V(3.4, 2.6, 2.2), CF(0, 4.9, 0), "S")
	make(b, "Screen", BLOCK, V(2.8, 2.0, 0.1), CF(0, 4.9, -1.11), "E", NEON, { Type = "flicker", Speed = 0.6 })
	make(b, "Eye", BLOCK, V(0.45, 0.45, 0.06), CF(-0.55, 5.15, -1.18), C(10, 10, 15))
	make(b, "Eye", BLOCK, V(0.45, 0.45, 0.06), CF(0.55, 5.15, -1.18), C(10, 10, 15))
	make(b, "Mouth", BLOCK, V(1.3, 0.15, 0.06), CF(0, 4.45, -1.18), C(10, 10, 15))
	for x = -1, 1, 2 do
		local theta = x > 0 and math.rad(60) or math.rad(120)
		local dir = V(math.cos(theta), math.sin(theta), 0)
		local base = V(x * 0.4, 6.2, 0)
		local mid = base + dir * 0.9
		make(b, "Antenna", CYL, V(1.8, 0.12, 0.12), CF(mid) * ANG(0, 0, theta), C(160, 160, 170), Enum.Material.Metal)
		make(b, "AntennaTip", BALL, V(0.4, 0.4, 0.4), CF(base + dir * 1.8), "E", NEON, { Type = "pulse", Speed = 5, Amp = 0.3, Phase = x })
	end
end

