		Lore = "NO TE MUEVAS. NO TE MUEVAS. NO TE M̷U̷E̷V̷A̷S̷.",
	},
	{
		Id = "smile", Name = "Luna Sonriente", Rarity = "Mitico", Price = 1100000, Income = 5200,
