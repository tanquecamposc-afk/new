	make(b, "Head", BALL, V(1.3, 1.3, 1.3), CF(0, 5.05, 0), "P")
	make(b, "Eye", BLOCK, V(0.22, 0.22, 0.06), CF(-0.25, 5.15, -0.62), "E", NEON)
	make(b, "Eye", BLOCK, V(0.22, 0.22, 0.06), CF(0.25, 5.15, -0.62), "E", NEON)
	for i = 0, 9 do
		local a = i / 10 * TAU
		make(b, "Halo", BLOCK, V(0.5, 0.15, 0.2), CF(math.cos(a) * 0.85, 6.0, math.sin(a) * 0.85) * ANG(0, -a + math.pi / 2, 0), "E", NEON, { Type = "rot", Pivot = V(0, 6.0, 0), Axis = V(0, 1, 0), Speed = 1.5 })
	end
	for x = -1, 1, 2 do
		local flap = { Type = "swing", Pivot = V(x * 0.8, 4.0, 0.75), Axis = V(0, x, 0), Speed = 3, Amp = 0.35 }
		for j = 1, 3 do
			make(b, "Wing", BLOCK, V(0.2, 3.0 - j * 0.5, 0.9), CF(x * (0.7 + j * 0.55), 3.9 + j * 0.25, 0.8) * ANG(0, 0, -x * (0.25 + j * 0.25)), "S", nil, flap)
		end
	end
	for i = 1, 3 do
		local a = i / 3 * TAU
		make(b, "Glitch", BLOCK, V(0.35, 0.35, 0.35), CF(math.cos(a) * 1.6, 3 + i * 0.8, math.sin(a) * 1.6), C(255, 0, 200), NEON, { Type = "flicker", Speed = 1.5 })
	end
end

function Archetypes.smile(b)
	b.h = 7.2
	b.model:SetAttribute("BobAmp", 0.7)
	b.model:SetAttribute("BobSpeed", 1.1)
	local center = V(0, 4.6, 0)
	local r = 2.2
	make(b, "Moon", BALL, V(4.4, 4.4, 4.4), CF(center), "P", Enum.Material.Slate)
	for _, d in ipairs({ V(1.2, 1.2, -1.4), V(-1.5, -0.6, -1.2), V(1.6, -1.0, 0.6), V(-0.6, 1.6, 1.2) }) do
		make(b, "Crater", CYL, V(0.15, 0.8, 0.8), onSphere(center, r, d), "S")
	end
	for x = -1, 1, 2 do
		make(b, "Socket", CYL, V(0.15, 0.95, 0.95), onSphere(center, r, V(x * 0.75, 0.7, -1.95)), C(10, 10, 12))
		make(b, "Eye", CYL, V(0.18, 0.35, 0.35), onSphere(center, r + 0.03, V(x * 0.75, 0.7, -1.95)), "E", NEON)
	end
	for i = -4, 4 do
		local x = i * 0.32
		local y = -0.35 - (1 - (i / 4) ^ 2) * 0.45
		local z = -math.sqrt(math.max(0, r * r - x * x - y * y)) - 0.02
		local p = center + V(x, y, z)
		make(b, "Mouth", BLOCK, V(0.34, 0.2, 0.1), CF(p) * ANG(0, 0, -i * 0.12), C(220, 20, 40), NEON)
		if i % 2 == 0 then
			make(b, "Tooth", BLOCK, V(0.18, 0.18, 0.08), CF(p + V(0, 0.16, -0.01)), C(250, 250, 240))
		end
	end
	for i = 1, 4 do
		local a = i / 4 * TAU
		make(b, "Star", BALL, V(0.45, 0.45, 0.45), CF(math.cos(a) * 3.2, 4 + (i % 2) * 1.4, math.sin(a) * 3.2), "E", NEON, { Type = "rot", Pivot = center, Axis = V(0, 1, 0), Speed = 0.9 })
	end
end

function Archetypes.error404(b)
	b.h = 7.0
	b.model:SetAttribute("BobAmp", 0.5)
	local center = V(0, 4.4, 0)
	make(b, "Core", BLOCK, V(2.2, 2.2, 2.2), CF(center) * ANG(0.3, 0.6, 0.2), "P", nil, { Type = "rot", Pivot = center, Axis = V(0.3, 1, 0.2), Speed = 0.6 })
	make(b, "Eye", BLOCK, V(0.45, 0.45, 0.1), CF(-0.45, 4.7, -1.4), "E", NEON, { Type = "flicker", Speed = 0.3 })
	make(b, "Eye", BLOCK, V(0.45, 0.45, 0.1), CF(0.45, 4.7, -1.4), "E", NEON, { Type = "flicker", Speed = 0.3 })
	for i = -2, 2 do
		make(b, "Mouth", BLOCK, V(0.25, 0.2, 0.1), CF(i * 0.25, 4.05 + (i % 2) * 0.15, -1.4), "S", NEON)
	end
	local cubes = {
		{ 0.9, 2.4, 3.2, "S", 1.2 }, { 0.6, 2.8, 5.6, "E", -1.6 }, { 0.7, 2.2, 4.4, "P", 0.9 },
		{ 0.5, 3.0, 2.6, "S", -2.1 }, { 1.0, 2.6, 6.0, "E", 1.4 }, { 0.45, 2.0, 5.0, "S", 2.4 },
		{ 0.8, 3.1, 3.8, "P", -1.1 }, { 0.55, 2.5, 2.2, "E", 1.8 },
	}
	for i, c in ipairs(cubes) do
		local a = i / #cubes * TAU
		local mat = c[4] == "P" and SMOOTH or NEON
		local anim = { Type = "rot", Pivot = center, Axis = (i % 2 == 0) and V(0, 1, 0) or V(0.4, 1, 0).Unit, Speed = c[5] }
		make(b, "Shard", BLOCK, V(c[1], c[1], c[1]), CF(math.cos(a) * c[2], c[3], math.sin(a) * c[2]) * ANG(a, a * 2, 0), c[4], mat, anim)
	end
	for i = 1, 3 do
		make(b, "Scanline", BLOCK, V(3.6, 0.08, 0.08), CF(0, 3.4 + i * 0.6, -1.8), "S", NEON, { Type = "flicker", Speed = 2 })
	end
end

function Archetypes.entity(b)
	b.h = 8.0
	b.model:SetAttribute("BobAmp", 0.6)
	b.model:SetAttribute("BobSpeed", 0.9)
	local center = V(0, 4.8, 0)
	make(b, "Core", BALL, V(2.6, 2.6, 2.6), CF(center), "P", NEON)
	make(b, "Aura", BALL, V(3.6, 3.6, 3.6), CF(center), "E", Enum.Material.ForceField, { Type = "pulse", Speed = 2, Amp = 0.12 })
	make(b, "Eye", BALL, V(0.95, 0.95, 0.95), CF(0, 4.8, -1.0), "S")
	make(b, "Pupil", BALL, V(0.45, 0.45, 0.45), CF(0, 4.8, -1.4), "E", NEON)
	for i = 1, 8 do
		local a = i / 8 * TAU
		local anim = { Type = "rot", Pivot = center, Axis = V(0, 1, 0), Speed = 0.9 }
		make(b, "Eye", BALL, V(0.7, 0.7, 0.7), CF(math.cos(a) * 2.8, 4.8, math.sin(a) * 2.8), "S", nil, anim)
		make(b, "Iris", BALL, V(0.35, 0.35, 0.35), CF(math.cos(a) * 3.08, 4.8, math.sin(a) * 3.08), "E", NEON, anim)
	end
	for i = 1, 6 do
		local a = i / 6 * TAU
		make(b, "Orbit", BLOCK, V(0.4, 0.4, 0.4), CF(math.cos(a) * 2.2, 4.8 + math.sin(a) * 2.2, 0), "E", NEON, { Type = "rot", Pivot = center, Axis = V(0, 0, 1), Speed = -1.4 })
	end
	for i = 1, 6 do
		local a = i / 6 * TAU
		make(b, "Tentacle", BLOCK, V(0.3, 2.6, 0.3), CF(math.cos(a) * 0.8, 2.4, math.sin(a) * 0.8), "P", NEON, { Type = "wiggle", Speed = 2.2, Amp = 0.35, Phase = i })
	end
end

local function addEmitter(att, texture, color, rate, size, speed)
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture
	e.Color = ColorSequence.new(color)
	e.Rate = rate
	e.Lifetime = NumberRange.new(1, 2)
	e.Speed = NumberRange.new(speed or 1.5)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.LightEmission = 1
	e.Parent = att
	return e
end

local function applyMutation(b, mut)
	if not mut then
		return
	end
	b.model:SetAttribute("Mut", mut)
	for _, p in ipairs(b.parts) do
		local role = p:GetAttribute("Role")
		if mut == "Dorado" then
			if role == "P" then
				p.Color = C(255, 200, 50)
				p.Material = Enum.Material.Foil
			elseif role == "S" then
				p.Color = C(205, 150, 30)
				p.Material = Enum.Material.Metal
			end
		elseif mut == "Glitch" then
			if role == "E" then
				p.Color = C(255, 0, 200)
			elseif (role == "P" or role == "S") and math.random() < 0.3 and not p:GetAttribute("A_Type") then
				p:SetAttribute("A_Type", "flicker")
				p:SetAttribute("A_Speed", 0.8)
			end
		elseif mut == "Vacio" then
			if role == "P" then
				p.Color = C(20, 10, 35)
				p.Material = SMOOTH
			elseif role == "S" then
				p.Color = C(60, 25, 105)
				p.Material = SMOOTH
			elseif role == "E" then
				p.Color = C(190, 100, 255)
			end
		elseif mut == "Espectral" then
			if role == "P" or role == "S" then
				p.Material = Enum.Material.Glass
				p.Transparency = 0.25
				p:SetAttribute("BaseT", 0.25)
			end
		end
	end
	local m = Config.MutationById[mut]
	if mut == "Glitch" then
		b.model:SetAttribute("Glitch", true)
	elseif mut == "Espectral" then
		b.model:SetAttribute("Rainbow", true)
		addEmitter(b.fx, TEX_SPARK, m.Color, 8, 0.6, 2)
	elseif mut == "Dorado" then
		addEmitter(b.fx, TEX_SPARK, m.Color, 5, 0.5, 1.5)
	elseif mut == "Vacio" then
		local e = addEmitter(b.fx, TEX_SMOKE, m.Color, 6, 1.6, 1)
		e.LightEmission = 0.4
	end
end

-- Pistas visuales de los Imitadores (lo que el jugador atento puede notar)
local function applyTell(b, tell)
	if tell == "redeyes" then
		local found = false
		for _, p in ipairs(b.parts) do
			if p.Name == "Eye" then
				p.Color = C(255, 20, 20)
				p.Material = NEON
				found = true
			end
		end
		if not found then
			tell = "wrongcolor"
		end
	end
	if tell == "noshadow" then
		for _, p in ipairs(b.parts) do
			p.CastShadow = false
		end
		b.model:SetAttribute("TellFlicker", true)
	elseif tell == "inverted" then
		b.model:SetAttribute("Inverted", true)
	elseif tell == "flicker" then
		b.model:SetAttribute("TellFlicker", true)
	elseif tell == "wrongcolor" then
		for _, p in ipairs(b.parts) do
			if p:GetAttribute("Role") == "P" then
				local c = p.Color
				p.Color = Color3.new(1 - c.R, 1 - c.G, 1 - c.B)
			end
		end
	end
end

-- Construye una anomalía. opts: { Tell = string?, NoFx = bool? }
function Builder.Build(id, mut, opts)
	opts = opts or {}
	local def = AnomalyData.ById[id]
	assert(def, "Anomalía desconocida: " .. tostring(id))
	local rarity = Config.RarityById[def.Rarity]

	local model = Instance.new("Model")
	model.Name = def.Name

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = V(2, 0.2, 2)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.CFrame = CFrame.new()
	root.Parent = model
	model.PrimaryPart = root

	local b = { model = model, root = root, parts = {}, s = def.Scale or 1, P = def.P, S = def.S, E = def.E, h = 6 }

	local fx = Instance.new("Attachment")
	fx.Name = "FX"
	fx.Parent = root
	b.fx = fx

	Archetypes[def.Archetype](b)

	make(b, "RarityRing", CYL, V(0.1, 4.6, 4.6), CF(0, 0.08, 0) * UP, rarity.Color, NEON, { Type = "pulse", Speed = 2, Amp = 0.08 }, 0.45)

	local height = b.h * b.s
	fx.Position = V(0, height * 0.5, 0)
	local promptAtt = Instance.new("Attachment")
	promptAtt.Name = "PromptAtt"
	promptAtt.Position = V(0, math.min(height * 0.5, 3.5), 0)
	promptAtt.Parent = root
	local topAtt = Instance.new("Attachment")
	topAtt.Name = "Top"
	topAtt.Position = V(0, height + 0.5, 0)
	topAtt.Parent = root

	if not opts.NoFx then
		applyMutation(b, mut)
		if rarity.Order >= 4 then
			local light = Instance.new("PointLight")
			light.Color = rarity.Color
			light.Range = 12
			light.Brightness = 2
			light.Parent = fx
		end
		if rarity.Order >= 5 then
			addEmitter(fx, TEX_SPARK, rarity.Color, 10, 0.5, 3)
		end
	elseif mut then
		model:SetAttribute("Mut", mut)
	end

	if opts.Tell then
		applyTell(b, opts.Tell)
	end

	model:SetAttribute("AnomalyId", id)
	model:SetAttribute("Height", height)
	CollectionService:AddTag(model, "Anomaly")
	return model
end

-- Silueta negra para el Índice (anomalías no descubiertas)
function Builder.Silhouette(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Color = C(0, 0, 0)
			d.Material = SMOOTH
			if d.Name ~= "Root" then
				d.Transparency = 0
			end
		elseif d:IsA("ParticleEmitter") or d:IsA("Light") then
			d:Destroy()
		end
	end
	local ring = model:FindFirstChild("RarityRing")
	if ring then
		ring.Transparency = 1
	end
end

return Builder
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX00000564">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Script" referent="RBX00000565">
			<Properties>
				<string name="Name">Main</string>
				<ProtectedString name="Source"><![CDATA[-- Punto de entrada del servidor: crea los Remotes, inicia los módulos
-- y conecta jugadores, prompts y herramientas.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Modules = script.Parent:WaitForChild("Modules")

local ctx = {}

-- Remotes ---------------------------------------------------------------
local remotesFolder = Instance.new("Folder")
remotesFolder.Name = "Remotes"
local function remoteEvent(name)
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotesFolder
	return r
end
ctx.Remotes = {
	Notify = remoteEvent("Notify"),
	Announce = remoteEvent("Announce"),
	Sync = remoteEvent("Sync"),
	Tool = remoteEvent("Tool"),
	Knock = remoteEvent("Knock"),
	Alert = remoteEvent("Alert"),
	Effect = remoteEvent("Effect"),
	ScanResult = remoteEvent("ScanResult"),
}
local request = Instance.new("RemoteFunction")
request.Name = "Request"
request.Parent = remotesFolder
ctx.Request = request
remotesFolder.Parent = ReplicatedStorage

function ctx.Notify(player, text, color)
	ctx.Remotes.Notify:FireClient(player, text, color)
end
function ctx.NotifyAll(text, color)
	ctx.Remotes.Notify:FireAllClients(text, color)
end
function ctx.Announce(title, subtitle, color)
	ctx.Remotes.Announce:FireAllClients(title, subtitle, color)
end
function ctx.Effect(kind, position, color)
	ctx.Remotes.Effect:FireAllClients(kind, position, color)
end

-- Módulos ---------------------------------------------------------------
local ORDER = { "Data", "Anoms", "Bases", "Progression", "Rift", "Steal", "Cycle" }
for _, name in ipairs(ORDER) do
	ctx[name] = require(Modules:WaitForChild(name))
end
for _, name in ipairs(ORDER) do
	ctx[name].Init(ctx)
end

-- Jugadores -------------------------------------------------------------
local function onCharacter(player, char)
	ctx.Bases.OnCharacter(player, char)
	ctx.Steal.OnCharacter(player, char)
	ctx.Progression.OnCharacter(player, char)
end

local function onPlayerAdded(player)
	local data = ctx.Data.Load(player)
	if not player.Parent then
		ctx.Data.Release(player)
		return
	end
	local ok = ctx.Bases.Assign(player)
	if not ok then
		player:Kick("Este servidor está lleno de anomalías. ¡Prueba otro servidor!")
		return
	end
	ctx.Progression.Setup(player, data)
	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)
	if player.Character then
		onCharacter(player, player.Character)
	end
	ctx.Progression.Sync(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
	ctx.Steal.OnLeave(player)
	ctx.Progression.OnLeave(player)
	ctx.Bases.Release(player)
	ctx.Data.Release(player)
end)

game:BindToClose(function()
	ctx.Data.SaveAll()
end)

-- ProximityPrompts --------------------------------------------------------
ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
	local kind = prompt:GetAttribute("Kind")
	if not kind then
		return
	end
	local model = prompt:FindFirstAncestorOfClass("Model")
	if kind == "Lock" then
		ctx.Bases.Lock(player, model)
		return
	end
	local info = model and ctx.Anoms.Registry[model]
	if not info then
		return
	end
	if kind == "Buy" then
		ctx.Rift.Buy(player, info)
	elseif kind == "Steal" then
		ctx.Steal.StartSteal(player, info)
	elseif kind == "Sell" then
		ctx.Bases.Sell(player, info)
	elseif kind == "Capture" then
		ctx.Steal.Capture(player, info)
	elseif kind == "Catch" then
		ctx.Steal.CatchMimic(player, info)
	end
end)

-- Herramientas (Escáner y Bate) -----------------------------------------------
ctx.Remotes.Tool.OnServerEvent:Connect(function(player, action, target)
	if action == "Scan" then
		ctx.Steal.Scan(player, target)
	elseif action == "Swing" then
		ctx.Steal.Swing(player)
	end
end)

request.OnServerInvoke = function(player, action, arg)
	return ctx.Progression.HandleRequest(player, action, arg)
end
]]></ProtectedString>
				<bool name="Disabled">false</bool>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX00000566">
			<Properties>
				<string name="Name">Modules</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX00000567">
				<Properties>
					<string name="Name">Data</string>
					<ProtectedString name="Source"><![CDATA[-- Guardado de datos con DataStore (reintentos + guardado automático).
-- En Studio sin "Enable Studio Access to API Services" se juega sin guardar.
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Data = {}
local ctx
local store
local profiles = {}

local STORE_NAME = "StealAnAnomaly_v1"
local AUTOSAVE = 90

local function default()
	return {
		Cash = Config.StartCash,
		Rebirths = 0,
		BaseLevel = 0,
		Pods = {},
		Index = {},
		Codes = {},
		Daily = { Last = 0, Streak = 0 },
		Missions = nil,
		LastOnline = 0,
		Stats = { Buys = 0, Steals = 0, Exposed = 0, Captures = 0, Collected = 0 },
		Tutorial = false,
		Receipts = {},
	}
end

local function reconcile(t, d)
	for k, v in pairs(d) do
		if t[k] == nil then
			t[k] = v
		elseif type(v) == "table" and type(t[k]) == "table" and next(v) ~= nil then
			reconcile(t[k], v)
		end
	end
end

function Data.Init(c)
	ctx = c
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[Data] DataStore no disponible:", result)
	end
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE)
			for player in pairs(profiles) do
				task.spawn(Data.Save, player)
			end
		end
	end)
end

function Data.Load(player)
	local key = "u_" .. player.UserId
	local data
	local loaded = false
	if store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return store:GetAsync(key)
			end)
			if ok then
				data = result
				loaded = true
				break
			end
			warn(("[Data] Error cargando %s (intento %d): %s"):format(player.Name, attempt, tostring(result)))
			task.wait(1.5)
		end
	end
	if type(data) ~= "table" then
		data = default()
	else
		reconcile(data, default())
	end
	profiles[player] = { Data = data, CanSave = loaded }
	return data
end

function Data.Get(player)
	local p = profiles[player]
	return p and p.Data
end

function Data.Save(player)
	local p = profiles[player]
	if not p or not p.CanSave or not store then
		return
	end
	p.Data.LastOnline = os.time()
	local ok, err = pcall(function()
		store:SetAsync("u_" .. player.UserId, p.Data)
	end)
	if not ok then
		warn("[Data] Error guardando", player.Name, err)
	end
end

function Data.Release(player)
	Data.Save(player)
	profiles[player] = nil
end

function Data.SaveAll()
	local pending = 0
	for player in pairs(profiles) do
		pending += 1
		task.spawn(function()
			Data.Save(player)
			pending -= 1
		end)
	end
	local start = os.clock()
	while pending > 0 and os.clock() - start < 25 do
		task.wait(0.2)
	end
end

return Data
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000568">
				<Properties>
					<string name="Name">Anoms</string>
					<ProtectedString name="Source"><![CDATA[-- Registro de todas las anomalías vivas en el mundo: modelo, estado,
-- etiquetas flotantes y ProximityPrompts según el estado.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local AnomalyData = require(Shared.AnomalyData)
local Builder = require(Shared.AnomalyBuilder)
local Util = require(Shared.Util)

local Anoms = {}
local ctx
local Registry = {}
Anoms.Registry = Registry

local folder

function Anoms.Init(c)
	ctx = c
	folder = workspace:FindFirstChild("Anomalies")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Anomalies"
		folder.Parent = workspace
	end
	Anoms.Folder = folder
end

local function textLabel(parent, name, order, size, font, color)
	local t = Instance.new("TextLabel")
	t.Name = name
	t.LayoutOrder = order
	t.BackgroundTransparency = 1
	t.Size = UDim2.new(1, 0, 0, size)
	t.Font = font
	t.TextScaled = true
	t.TextColor3 = color
	t.Text = ""
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(10, 5, 20)
	stroke.Parent = t
	t.Parent = parent
	return t
end

local function ensureLabel(info)
	if info.Label and info.Label.Parent then
		return info.Label
	end
	local top = info.Model.Root:FindFirstChild("Top")
	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.fromOffset(220, 84)
	bb.StudsOffset = Vector3.new(0, 1.6, 0)
	bb.MaxDistance = 90
	bb.LightInfluence = 0
	bb.AlwaysOnTop = false
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.VerticalAlignment = Enum.VerticalAlignment.Bottom
	list.Parent = bb
	textLabel(bb, "Tag", 1, 18, Enum.Font.GothamBlack, Color3.new(1, 1, 1))
	textLabel(bb, "Title", 2, 26, Enum.Font.FredokaOne, Color3.new(1, 1, 1))
	textLabel(bb, "Rarity", 3, 18, Enum.Font.GothamBlack, Color3.new(1, 1, 1))
	textLabel(bb, "Info", 4, 20, Enum.Font.GothamBold, Color3.fromRGB(120, 255, 150))
	bb.Parent = top
	info.Label = bb
	return bb
end

function Anoms.SetLabel(info, tag, tagColor, infoText, infoColor)
	local bb = ensureLabel(info)
	local def = info.Def
	local rarity = Config.RarityById[def.Rarity]
	local mut = info.Record.Mut and Config.MutationById[info.Record.Mut]
	local title = bb:FindFirstChild("Title")
	local rar = bb:FindFirstChild("Rarity")
	local tagL = bb:FindFirstChild("Tag")
	local infoL = bb:FindFirstChild("Info")
	title.Text = def.Name
	rar.Text = rarity.Name .. (mut and ("  ✦ " .. mut.Name:upper() .. " x" .. mut.Mult) or "")
	rar.TextColor3 = mut and mut.Color or rarity.Color
	tagL.Text = tag or ""
	tagL.Visible = tag ~= nil
	tagL.TextColor3 = tagColor or Color3.new(1, 1, 1)
	infoL.Text = infoText or ""
	infoL.TextColor3 = infoColor or Color3.fromRGB(120, 255, 150)
end

function Anoms.Create(record, cframe)
	local model = Builder.Build(record.Id, record.Mut, { Tell = record.Mimic and record.Tell or nil })
	model:PivotTo(cframe)
	model.Parent = folder
	local info = {
		Model = model,
		Record = record,
		Def = AnomalyData.ById[record.Id],
		State = "none",
	}
	Registry[model] = info
	model.Destroying:Connect(function()
		Registry[model] = nil
	end)
	return info
end

local function addPrompt(info, kind, action, hold, key, ownerId)
	local p = Instance.new("ProximityPrompt")
	p.Name = kind
	p.ActionText = action
	p.ObjectText = Util.DisplayName(info.Record)
	p.HoldDuration = hold
	p.KeyboardKeyCode = key or Enum.KeyCode.E
	p.MaxActivationDistance = 11
	p.RequiresLineOfSight = false
	p.Style = Enum.ProximityPromptStyle.Default
	p:SetAttribute("Kind", kind)
	if ownerId then
		p:SetAttribute("OwnerId", ownerId)
	end
	p.Parent = info.Model.Root:FindFirstChild("PromptAtt")
	return p
end

function Anoms.ClearPrompts(info)
	local att = info.Model.Root:FindFirstChild("PromptAtt")
	if not att then
		return
	end
	for _, c in ipairs(att:GetChildren()) do
		if c:IsA("ProximityPrompt") then
			c:Destroy()
		end
	end
end

function Anoms.SetState(info, state, extra)
	info.State = state
	Anoms.ClearPrompts(info)
	local model = info.Model
	local rec = info.Record
	model:SetAttribute("State", state)
	model:SetAttribute("Owner", info.OwnerId or 0)
	model:SetAttribute("Walking", state == "conveyor" or state == "walking" or state == "roaming")
	local value = Util.Value(rec)
	local income = Util.Income(rec)
	if state == "conveyor" then
		addPrompt(info, "Buy", "Contener " .. Util.Money(value), 0.25)
		Anoms.SetLabel(info, nil, nil, Util.Money(value) .. "  •  +" .. Util.Money(income) .. "/s", Color3.fromRGB(255, 225, 90))
	elseif state == "pod" then
		addPrompt(info, "Steal", "Robar", Config.StealHold, Enum.KeyCode.E, info.OwnerId)
		addPrompt(info, "Sell", "Vender " .. Util.Money(math.floor(value * Config.SellRatio)), 1.2, Enum.KeyCode.F, info.OwnerId)
		Anoms.SetLabel(info, nil, nil, "+" .. Util.Money(income) .. "/s")
	elseif state == "roaming" then
		if rec.Mimic and info.Revealed then
			addPrompt(info, "Catch", "Atrapar Imitador", 0.4)
			Anoms.SetLabel(info, "☠ IMITADOR ☠", Color3.fromRGB(255, 40, 60), "¡Atrápalo por recompensa!", Color3.fromRGB(255, 120, 120))
		else
			addPrompt(info, "Capture", "Capturar", Config.CaptureHold)
			Anoms.SetLabel(info, "⚠ ¡FUGADA! ⚠", Color3.fromRGB(255, 80, 80), "¡Captúrala gratis!", Color3.fromRGB(255, 200, 90))
		end
	elseif state == "walking" then
		Anoms.SetLabel(info, extra and ("→ " .. extra) or nil, Color3.fromRGB(160, 220, 255), "+" .. Util.Money(income) .. "/s")
	elseif state == "carried" then
		Anoms.SetLabel(info, extra and ("✋ " .. extra) or nil, Color3.fromRGB(255, 150, 80), nil)
	end
end

function Anoms.Destroy(info, effect, color)
	if info.Tween then
		info.Tween:Cancel()
	end
	if info.Model and info.Model.Parent then
		if effect then
			ctx.Effect(effect, info.Model.Root.Position + Vector3.new(0, 3, 0), color or Config.RarityById[info.Def.Rarity].Color)
		end
		info.Model:Destroy()
	end
	Registry[info.Model] = nil
	info.Dead = true
end

return Anoms
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000569">
				<Properties>
					<string name="Name">Bases</string>
					<ProtectedString name="Source"><![CDATA[-- Bases de los jugadores: asignación, cápsulas (pods), ingresos,
-- recolector, cierre láser y ventas.
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local AnomalyData = require(Shared.AnomalyData)
local Util = require(Shared.Util)

local Bases = {}
local ctx
local list = {}
local byPlayer = {}
local byModel = {}

local POD_GLASS = Color3.fromRGB(150, 210, 255)
local POD_LOCKED = Color3.fromRGB(255, 70, 90)

local function now()
	return workspace:GetServerTimeNow()
end

local function makePodGui(pod)
	local bb = Instance.new("BillboardGui")
	bb.Name = "PodGui"
	bb.Size = UDim2.fromOffset(160, 56)
	bb.StudsOffset = Vector3.new(0, 2.2, 0)
	bb.MaxDistance = 70
	bb.LightInfluence = 0
	local cash = Instance.new("TextLabel")
	cash.Name = "Cash"
	cash.BackgroundTransparency = 1
	cash.Size = UDim2.new(1, 0, 0.6, 0)
	cash.Font = Enum.Font.FredokaOne
	cash.TextScaled = true
	cash.TextColor3 = Color3.fromRGB(110, 255, 140)
	cash.Text = ""
	local s1 = Instance.new("UIStroke")
	s1.Thickness = 2
	s1.Parent = cash
	cash.Parent = bb
	local sub = Instance.new("TextLabel")
	sub.Name = "Sub"
	sub.BackgroundTransparency = 1
	sub.Position = UDim2.new(0, 0, 0.6, 0)
	sub.Size = UDim2.new(1, 0, 0.4, 0)
	sub.Font = Enum.Font.GothamBold
	sub.TextScaled = true
	sub.TextColor3 = Color3.fromRGB(230, 230, 255)
	sub.Text = ""
	local s2 = Instance.new("UIStroke")
	s2.Thickness = 1.5
	s2.Parent = sub
	sub.Parent = bb
	bb.Parent = pod.Model:FindFirstChild("Cap")
	pod.CashLabel = cash
	pod.SubLabel = sub
	return bb
end

local function makeSign(b)
	local sign = b.Model:FindFirstChild("Sign")
	if not sign then
		return
	end
	local sg = Instance.new("SurfaceGui")
	sg.Name = "SignGui"
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.LightInfluence = 0
	local t = Instance.new("TextLabel")
	t.Name = "Owner"
	t.BackgroundTransparency = 1
	t.Size = UDim2.new(1, 0, 0.62, 0)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Text = "LIBRE"
	local st = Instance.new("UIStroke")
	st.Thickness = 3
	st.Parent = t
	t.Parent = sg
	local l = Instance.new("TextLabel")
	l.Name = "Status"
	l.BackgroundTransparency = 1
	l.Position = UDim2.new(0, 0, 0.62, 0)
	l.Size = UDim2.new(1, 0, 0.38, 0)
	l.Font = Enum.Font.GothamBlack
	l.TextScaled = true
	l.TextColor3 = Color3.fromRGB(120, 255, 150)
	l.Text = ""
	l.Parent = sg
	sg.Parent = sign
	b.SignGui = sg
	b.OwnerLabel = t
	b.StatusLabel = l
end

local function setLaser(b, on)
	local laser = b.Model:FindFirstChild("Laser")
	if laser then
		for _, bar in ipairs(laser:GetChildren()) do
			if bar:IsA("BasePart") then
				bar.Transparency = on and 0.1 or 1
				bar.CanCollide = on
			end
		end
	end
	local button = b.Model:FindFirstChild("LockButton")
	if button then
		button.Color = on and Color3.fromRGB(255, 60, 80) or Color3.fromRGB(60, 255, 130)
	end
	b.Model:SetAttribute("LockedUntil", on and b.LockedUntil or 0)
end

local function updateSign(b)
	if not b.SignGui then
		return
	end
	if b.Player then
		b.OwnerLabel.Text = "Base de " .. b.Player.DisplayName
		local left = b.LockedUntil - now()
		if left > 0 then
			b.StatusLabel.Text = "🔒 CERRADA " .. math.ceil(left) .. "s"
			b.StatusLabel.TextColor3 = Color3.fromRGB(255, 90, 100)
		else
			b.StatusLabel.Text = "🔓 ABIERTA"
			b.StatusLabel.TextColor3 = Color3.fromRGB(120, 255, 150)
		end
	else
		b.OwnerLabel.Text = "LIBRE"
		b.StatusLabel.Text = ""
	end
end

local function setupBase(model, index)
	local b = {
		Model = model,
		Index = index,
		Pods = {},
		LockedUntil = 0,
		Zone = model:FindFirstChild("Zone"),
	}
	local podsFolder = model:FindFirstChild("Pods")
	for i = 1, Config.MaxPods do
		local podModel = podsFolder and podsFolder:FindFirstChild("Pod" .. i)
		if podModel then
			local pod = { Model = podModel, Anchor = podModel:FindFirstChild("Anchor"), Stored = 0, Index = i }
			pod.Gui = makePodGui(pod)
			b.Pods[i] = pod
		end
	end

	-- Grupos de colisión: el dueño atraviesa su propio láser
	local laserGroup = "Laser" .. index
	local ownerGroup = "Owner" .. index
	pcall(function()
		PhysicsService:RegisterCollisionGroup(laserGroup)
		PhysicsService:RegisterCollisionGroup(ownerGroup)
		PhysicsService:CollisionGroupSetCollidable(laserGroup, ownerGroup, false)
	end)
	b.OwnerGroup = ownerGroup
	local laser = model:FindFirstChild("Laser")
	if laser then
		for _, bar in ipairs(laser:GetChildren()) do
			if bar:IsA("BasePart") then
				bar.CollisionGroup = laserGroup
			end
		end
	end

	local button = model:FindFirstChild("LockButton")
	if button then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "LockPrompt"
		prompt.ActionText = "Cerrar base"
		prompt.ObjectText = "Láser"
		prompt.HoldDuration = 0.3
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("Kind", "Lock")
		prompt:SetAttribute("OwnerId", 0)
		prompt.Parent = button
		b.LockPrompt = prompt
	end

	local collector = model:FindFirstChild("Collector")
	if collector then
		local debounce = {}
		collector.Touched:Connect(function(hit)
			local char = hit.Parent
			local player = char and Players:GetPlayerFromCharacter(char)
			if not player or player ~= b.Player then
				return
			end
			if debounce[player] and os.clock() - debounce[player] < 1 then
				return
			end
			debounce[player] = os.clock()
			Bases.Collect(player)
		end)
	end

	makeSign(b)
	setLaser(b, false)
	updateSign(b)
	byModel[model] = b
	return b
end

function Bases.Init(c)
	ctx = c
	local folder = workspace:WaitForChild("Bases")
	for i = 1, 8 do
		local model = folder:FindFirstChild("Base" .. i)
		if model then
			table.insert(list, setupBase(model, i))
		end
	end
	for _, b in ipairs(list) do
		Bases.RefreshPods(b)
	end
	task.spawn(function()
		while true do
			task.wait(1)
			Bases.Tick()
		end
	end)
end

function Bases.Get(player)
	return byPlayer[player]
end

function Bases.All()
	return list
end

function Bases.UnlockedCount(player)
	local data = ctx.Data.Get(player)
	return math.min(Config.MaxPods, Config.BaseStartPods + (data and data.BaseLevel or 0))
end

function Bases.RefreshPods(b)
	local unlocked = b.Player and Bases.UnlockedCount(b.Player) or Config.BaseStartPods
	for i, pod in pairs(b.Pods) do
		local open = i <= unlocked
		pod.Open = open
		local glass = pod.Model:FindFirstChild("Glass")
		if glass then
			glass.Color = open and POD_GLASS or POD_LOCKED
			glass.Transparency = open and 0.75 or 0.55
		end
		local ring = pod.Model:FindFirstChild("Ring")
		if ring then
			ring.Color = open and Color3.fromRGB(120, 200, 255) or POD_LOCKED
		end
		if not open then
			pod.CashLabel.Text = "🔒"
			pod.SubLabel.Text = "Mejora tu base"
		elseif not pod.Info then
			pod.CashLabel.Text = pod.Stored > 0 and Util.Money(pod.Stored) or ""
			pod.SubLabel.Text = b.Player and "Vacía" or ""
		end
	end
end

function Bases.FreePod(b)
	for i = 1, Config.MaxPods do
		local pod = b.Pods[i]
		if pod and pod.Open and not pod.Info and not pod.Reserved then
			return i
		end
	end
	return nil
end

function Bases.IsInside(b, position)
	if not b or not b.Zone then
		return false
	end
	local rel = b.Zone.CFrame:PointToObjectSpace(position)
	local half = b.Zone.Size / 2
	return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
end

function Bases.Assign(player)
	for _, b in ipairs(list) do
		if not b.Player then
			b.Player = player
			b.OwnerId = player.UserId
			byPlayer[player] = b
			b.Model:SetAttribute("OwnerId", player.UserId)
			player:SetAttribute("BaseIndex", b.Index)
			if b.LockPrompt then
				b.LockPrompt:SetAttribute("OwnerId", player.UserId)
				-- Recrear el prompt para que los clientes reevalúen su visibilidad
				local clone = b.LockPrompt:Clone()
				b.LockPrompt:Destroy()
				clone.Parent = b.Model:FindFirstChild("LockButton")
				b.LockPrompt = clone
			end
			b.LockedUntil = 0
			setLaser(b, false)
			for _, pod in pairs(b.Pods) do
				pod.Stored = 0
				pod.Reserved = false
			end
			Bases.RefreshPods(b)
			local data = ctx.Data.Get(player)
			for key, rec in pairs(data.Pods) do
				local i = tonumber(key)
				local pod = i and b.Pods[i]
				if pod and type(rec) == "table" and AnomalyData.ById[rec.Id] then
					Bases.SpawnInPod(b, i, rec)
				else
					data.Pods[key] = nil
				end
			end
			updateSign(b)
			return true
		end
	end
	return false
end

function Bases.Release(player)
	local b = byPlayer[player]
	if not b then
		return
	end
	for _, pod in pairs(b.Pods) do
		if pod.Info then
			ctx.Anoms.Destroy(pod.Info)
			pod.Info = nil
		end
		pod.Stored = 0
		pod.Reserved = false
	end
	b.Player = nil
	b.OwnerId = nil
	b.LockedUntil = 0
	b.Model:SetAttribute("OwnerId", 0)
	if b.LockPrompt then
		b.LockPrompt:SetAttribute("OwnerId", 0)
	end
	setLaser(b, false)
	byPlayer[player] = nil
	Bases.RefreshPods(b)
	updateSign(b)
end

function Bases.SpawnInPod(b, i, rec)
	local pod = b.Pods[i]
	local info = ctx.Anoms.Create(rec, pod.Anchor.CFrame)
	info.OwnerId = b.OwnerId
	info.Base = b
	info.PodIndex = i
	pod.Info = info
	ctx.Anoms.SetState(info, "pod")
	return info
end

-- Coloca un registro (y opcionalmente un modelo existente) en una cápsula del jugador
function Bases.PlaceInPod(player, i, rec, info)
	local b = byPlayer[player]
	local data = ctx.Data.Get(player)
	if not b or not data then
		if info then
			ctx.Anoms.Destroy(info)
		end
		return nil
	end
	local pod = b.Pods[i]
	pod.Reserved = false
	data.Pods[tostring(i)] = rec
	if info and info.Model.Parent then
		local root = info.Model.Root
		root.Anchored = true
		info.Model:PivotTo(pod.Anchor.CFrame)
		info.OwnerId = b.OwnerId
		info.Base = b
		info.PodIndex = i
		info.Revealed = nil
		pod.Info = info
		ctx.Anoms.SetState(info, "pod")
	else
		info = Bases.SpawnInPod(b, i, rec)
	end
	ctx.Effect("place", pod.Anchor.Position + Vector3.new(0, 3, 0), Config.RarityById[info.Def.Rarity].Color)
	ctx.Progression.Discover(player, rec.Id)
	return info
end

function Bases.RemoveFromPod(b, i)
	local pod = b.Pods[i]
	if not pod or not pod.Info then
		return nil
	end
	local info = pod.Info
	pod.Info = nil
	if b.Player then
		local data = ctx.Data.Get(b.Player)
		if data then
			data.Pods[tostring(i)] = nil
		end
	end
	info.Base = nil
	info.PodIndex = nil
	return info
end

-- Borra todas las anomalías del jugador (Ascender)
function Bases.ClearAll(player)
	local b = byPlayer[player]
	if not b then
		return
	end
	for i, pod in pairs(b.Pods) do
		local info = Bases.RemoveFromPod(b, i)
		if info then
			ctx.Anoms.Destroy(info, "poof")
		end
		pod.Stored = 0
	end
	local data = ctx.Data.Get(player)
	data.Pods = {}
	Bases.RefreshPods(b)
end

function Bases.Collect(player, silent)
	local b = byPlayer[player]
	if not b then
		return 0
	end
	local total = 0
	for _, pod in pairs(b.Pods) do
		total += pod.Stored
		pod.Stored = 0
	end
	total = math.floor(total)
	if total > 0 then
		ctx.Progression.AddCash(player, total)
		local data = ctx.Data.Get(player)
		data.Stats.Collected = (data.Stats.Collected or 0) + 1
		if not silent then
			local collector = b.Model:FindFirstChild("Collector")
			ctx.Effect("cash", collector and collector.Position or Vector3.zero, Color3.fromRGB(110, 255, 140))
			ctx.Notify(player, "💰 +" .. Util.Money(total), Color3.fromRGB(110, 255, 140))
			if not data.Tutorial then
				ctx.Progression.Sync(player)
			end
		end
	end
	Bases.RefreshPods(b)
	return total
end

function Bases.Lock(player, model)
	local b = byModel[model]
	if not b or b.Player ~= player then
		return
	end
	if workspace:GetAttribute("Phase") == "Blackout" then
		ctx.Notify(player, "⚡ ¡No hay energía durante el APAGÓN!", Color3.fromRGB(255, 90, 90))
		return
	end
	if b.LockedUntil > now() then
		return
	end
	local data = ctx.Data.Get(player)
	b.LockedUntil = now() + Config.LockDuration + (data.BaseLevel or 0) * Config.LockPerLevel
	setLaser(b, true)
	updateSign(b)
	ctx.Notify(player, "🔒 Base cerrada con láser", Color3.fromRGB(255, 120, 140))
end

function Bases.IsLocked(b)
	return b.LockedUntil > now()
end

function Bases.UnlockAll()
	for _, b in ipairs(list) do
		b.LockedUntil = 0
		setLaser(b, false)
		updateSign(b)
	end
end

function Bases.Sell(player, info)
	if info.State ~= "pod" or info.OwnerId ~= player.UserId or not info.Base then
		return
	end
	local b = info.Base
	Bases.RemoveFromPod(b, info.PodIndex)
	local rec = info.Record
	if rec.Mimic then
		ctx.Anoms.Destroy(info, "expose", Color3.fromRGB(255, 40, 60))
		ctx.Notify(player, "☠ ¡Era un IMITADOR! No vale nada... escanéalos antes 🔬", Color3.fromRGB(255, 80, 80))
	else
		local value = math.floor(Util.Value(rec) * Config.SellRatio)
		ctx.Anoms.Destroy(info, "cash", Color3.fromRGB(110, 255, 140))
		ctx.Progression.AddCash(player, value)
		ctx.Notify(player, "Vendiste " .. Util.DisplayName(rec) .. " por " .. Util.Money(value), Color3.fromRGB(110, 255, 140))
	end
	Bases.RefreshPods(b)
end

function Bases.Tick()
	local t = now()
	for _, b in ipairs(list) do
		local player = b.Player
		if player then
			local mult = ctx.Progression.Multiplier(player)
			local total = 0
			for _, pod in pairs(b.Pods) do
				local info = pod.Info
				if info and info.State == "pod" then
					local inc = Util.Income(info.Record) * mult
					total += inc
					pod.Stored += inc
					pod.CashLabel.Text = Util.Money(pod.Stored)
					pod.SubLabel.Text = "+" .. Util.Money(inc) .. "/s"
				end
			end
			player:SetAttribute("Income", math.floor(total))
			if player:GetAttribute("Pass_AutoCollect") then
				Bases.Collect(player, true)
			end
			if b.LockedUntil > 0 and t >= b.LockedUntil then
				b.LockedUntil = 0
				setLaser(b, false)
			end
			updateSign(b)
		end
	end
end

local function setGroup(b, char)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = b.OwnerGroup
		end
	end
end

function Bases.OnCharacter(player, char)
	local b = byPlayer[player]
	if not b then
		return
	end
	setGroup(b, char)
	char.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = b.OwnerGroup
		end
	end)
	task.defer(function()
		local hrp = char:WaitForChild("HumanoidRootPart", 5)
		local pad = b.Model:FindFirstChild("SpawnPad")
		if hrp and pad then
			char:PivotTo(pad.CFrame + Vector3.new(0, 4, 0))
		end
	end)
end

return Bases
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000056A">
				<Properties>
					<string name="Name">Progression</string>
					<ProtectedString name="Source"><![CDATA[-- Dinero, multiplicadores, Índice, misiones diarias, racha diaria,
-- códigos, mejoras, Ascensos, bonus de amigos, monetización y comandos admin.
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local AnomalyData = require(Shared.AnomalyData)
local Util = require(Shared.Util)

local Progression = {}
local ctx
local friends = {} -- [userId] = { [otherUserId] = true }

local function today()
	return math.floor(os.time() / 86400)
end

local function isAdmin(player)
	if RunService:IsStudio() then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
		return true
	end
	return table.find(Config.Admins, player.UserId) ~= nil
end

---------------------------------------------------------------------------
-- Dinero
---------------------------------------------------------------------------
function Progression.GetCash(player)
	local data = ctx.Data.Get(player)
	return data and data.Cash or 0
end

function Progression.UpdateLeaderstats(player)
	local data = ctx.Data.Get(player)
	local ls = player:FindFirstChild("leaderstats")
	if not data or not ls then
		return
	end
	ls.Dinero.Value = Util.Money(data.Cash)
	ls.Ascensos.Value = data.Rebirths
	ls.Robos.Value = data.Stats.Steals
end

local function setCash(player, amount)
	local data = ctx.Data.Get(player)
	if not data then
		return
	end
	data.Cash = math.max(0, math.floor(amount))
	player:SetAttribute("Cash", data.Cash)
	Progression.UpdateLeaderstats(player)
end

function Progression.AddCash(player, amount)
	setCash(player, Progression.GetCash(player) + amount)
end

function Progression.TrySpend(player, amount)
	local cash = Progression.GetCash(player)
	if cash < amount then
		return false
	end
	setCash(player, cash - amount)
	return true
end

function Progression.Multiplier(player, ignoreFriends)
	local data = ctx.Data.Get(player)
	if not data then
		return 1
	end
	local m = 1 + data.Rebirths * Config.RebirthBonus
	if player:GetAttribute("Pass_VIP") then
		m *= 2
	end
	if not ignoreFriends then
		m *= 1 + (player:GetAttribute("FriendBonus") or 0)
	end
	return m
end

local function rawIncome(player)
	local data = ctx.Data.Get(player)
	local total = 0
	for _, rec in pairs(data.Pods) do
		total += Util.Income(rec)
	end
	return total
end

---------------------------------------------------------------------------
-- Índice, misiones y diario
---------------------------------------------------------------------------
function Progression.Discover(player, id)
	local data = ctx.Data.Get(player)
	if not data or data.Index[id] then
		return
	end
	data.Index[id] = true
	local def = AnomalyData.ById[id]
	local bonus = math.floor(def.Price * 0.25)
	Progression.AddCash(player, bonus)
	ctx.Notify(player, "📖 ¡Nueva en tu Índice: " .. def.Name .. "! +" .. Util.Money(bonus), Config.RarityById[def.Rarity].Color)
	Progression.Sync(player)
end

local function ensureMissions(data)
	local d = today()
	if data.Missions and data.Missions.Day == d then
		return
	end
	local pool = table.clone(Config.Missions)
	local list = {}
	for _ = 1, 3 do
		local i = math.random(1, #pool)
		local m = table.remove(pool, i)
		table.insert(list, { Type = m.Type, Target = m.Target, Progress = 0, Claimed = false })
	end
	data.Missions = { Day = d, List = list }
end

local function missionDef(type_)
	for _, m in ipairs(Config.Missions) do
		if m.Type == type_ then
			return m
		end
	end
end

local function missionReward(player, m)
	local def = missionDef(m.Type)
	local perSec = rawIncome(player) * Progression.Multiplier(player, true)
	return math.floor(math.max(400, perSec * 150) * (def and def.Reward or 1))
end

function Progression.Progress(player, type_, amount)
	local data = ctx.Data.Get(player)
	if not data then
		return
	end
	ensureMissions(data)
	local changed = false
	for _, m in ipairs(data.Missions.List) do
		if m.Type == type_ and m.Progress < m.Target then
			m.Progress = math.min(m.Target, m.Progress + amount)
			changed = true
			if m.Progress >= m.Target then
				ctx.Notify(player, "📋 ¡Misión completada! Reclama tu premio", Color3.fromRGB(255, 220, 90))
			end
		end
	end
	if changed then
		Progression.Sync(player)
	end
end

local function dailyState(data)
	local d = today()
	local canClaim = (data.Daily.Last or 0) < d
	local nextStreak = 1
	if (data.Daily.Last or 0) == d - 1 then
		nextStreak = (data.Daily.Streak % 7) + 1
	elseif not canClaim then
		nextStreak = data.Daily.Streak
	end
	return canClaim, nextStreak
end

local function grantAnomaly(player, id, mut)
	local b = ctx.Bases.Get(player)
	local idx = b and ctx.Bases.FreePod(b)
	local rec = { Id = id, Mut = mut }
	if idx then
		ctx.Bases.PlaceInPod(player, idx, rec)
		return true
	end
	Progression.AddCash(player, Util.Value(rec))
	ctx.Notify(player, "Sin cápsulas libres: recibiste su valor en dinero", Color3.fromRGB(255, 200, 80))
	return false
end

---------------------------------------------------------------------------
-- Sincronización con el cliente
---------------------------------------------------------------------------
function Progression.Snapshot(player)
	local data = ctx.Data.Get(player)
	if not data then
		return nil
	end
	ensureMissions(data)
	local canClaim, nextStreak = dailyState(data)
	local missions = {}
	for i, m in ipairs(data.Missions.List) do
		local def = missionDef(m.Type)
		missions[i] = {
			Text = def and string.format(def.Text, m.Target) or m.Type,
			Progress = m.Progress,
			Target = m.Target,
			Claimed = m.Claimed,
			Reward = missionReward(player, m),
		}
	end
	local passes = {}
	for key in pairs(Config.GamePasses) do
		passes[key] = player:GetAttribute("Pass_" .. key) == true
	end
	return {
		Index = data.Index,
		Missions = missions,
		Daily = { CanClaim = canClaim, Next = nextStreak, Streak = data.Daily.Streak },
		BaseLevel = data.BaseLevel,
		Unlocked = ctx.Bases.UnlockedCount(player),
		UpgradeCost = Config.BaseUpgradeCost[data.BaseLevel + 1],
		Rebirths = data.Rebirths,
		RebirthCost = Config.RebirthCost(data.Rebirths),
		Multiplier = Progression.Multiplier(player),
		Passes = passes,
		Tutorial = data.Tutorial,
		Buys = data.Stats.Buys,
		Collected = data.Stats.Collected or 0,
	}
end

function Progression.Sync(player)
	local snap = Progression.Snapshot(player)
	if snap then
		ctx.Remotes.Sync:FireClient(player, snap)
	end
end

---------------------------------------------------------------------------
-- Bonus de amigos (co-juego)
---------------------------------------------------------------------------
local function updateFriendBonus(player)
	local count = 0
	for otherId in pairs(friends[player.UserId] or {}) do
		if Players:GetPlayerByUserId(otherId) then
			count += 1
		end
	end
	player:SetAttribute("FriendBonus", math.min(Config.MaxFriendBonus, count * Config.FriendBonus))
end

local function registerFriends(player)
	friends[player.UserId] = friends[player.UserId] or {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local ok, isFriend = pcall(function()
				return player:IsFriendsWith(other.UserId)
			end)
			if ok and isFriend then
				friends[player.UserId][other.UserId] = true
				friends[other.UserId] = friends[other.UserId] or {}
				friends[other.UserId][player.UserId] = true
				updateFriendBonus(other)
				ctx.Notify(other, "👥 ¡Tu amigo " .. player.DisplayName .. " llegó! +10% dinero", Color3.fromRGB(120, 200, 255))
			end
		end
	end
	updateFriendBonus(player)
end

---------------------------------------------------------------------------
-- Ciclo de vida del jugador
---------------------------------------------------------------------------
function Progression.Setup(player, data)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Dinero"
	cash.Parent = ls
	local reb = Instance.new("IntValue")
	reb.Name = "Ascensos"
	reb.Parent = ls
	local steals = Instance.new("IntValue")
	steals.Name = "Robos"
	steals.Parent = ls
	ls.Parent = player

	player:SetAttribute("Cash", data.Cash)
	player:SetAttribute("Rebirths", data.Rebirths)
	Progression.UpdateLeaderstats(player)
	ensureMissions(data)

	-- Pases
	for key, pass in pairs(Config.GamePasses) do
		if pass.Id and pass.Id > 0 then
			task.spawn(function()
				local ok, owns = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
				end)
				if ok and owns then
					player:SetAttribute("Pass_" .. key, true)
					Progression.Sync(player)
				end
			end)
		end
	end

	task.spawn(registerFriends, player)

	-- Ganancias offline
	if data.LastOnline and data.LastOnline > 0 then
		local secs = math.min(os.time() - data.LastOnline, Config.OfflineMaxSeconds)
		local earned = math.floor(rawIncome(player) * Progression.Multiplier(player, true) * Config.OfflineRatio * math.max(0, secs))
		if earned > 0 then
			Progression.AddCash(player, earned)
			task.delay(5, function()
				if player.Parent then
					ctx.Notify(player, "🌙 Mientras no estabas ganaste " .. Util.Money(earned), Color3.fromRGB(160, 140, 255))
				end
			end)
		end
	end

	player.Chatted:Connect(function(msg)
		Progression.OnChat(player, msg)
	end)
end

function Progression.OnLeave(player)
	friends[player.UserId] = nil
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and friends[other.UserId] and friends[other.UserId][player.UserId] then
			friends[other.UserId][player.UserId] = nil
			updateFriendBonus(other)
		end
	end
end

function Progression.OnCharacter(player, char)
	local head = char:WaitForChild("Head", 5)
	if not head then
		return
	end
	local data = ctx.Data.Get(player)
	local tags = {}
	if player:GetAttribute("Pass_VIP") then
		table.insert(tags, "👑 VIP")
	end
	if data and data.Rebirths > 0 then
		table.insert(tags, "✦ Ascendido " .. data.Rebirths)
	end
	if #tags == 0 then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "Title"
	bb.Size = UDim2.fromOffset(200, 30)
	bb.StudsOffset = Vector3.new(0, 2.6, 0)
	bb.MaxDistance = 60
	bb.LightInfluence = 0
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextColor3 = Color3.fromRGB(255, 215, 90)
	t.Text = table.concat(tags, "  ")
	local s = Instance.new("UIStroke")
	s.Thickness = 2
	s.Parent = t
	t.Parent = bb
	bb.Parent = head
end

---------------------------------------------------------------------------
-- Peticiones del cliente (menús)
---------------------------------------------------------------------------
local function reply(ok, msg)
	return { Ok = ok, Msg = msg }
end

local handlers = {}

function handlers.Sync(player)
	return Progression.Snapshot(player)
end

function handlers.Upgrade(player)
	local data = ctx.Data.Get(player)
	local cost = Config.BaseUpgradeCost[data.BaseLevel + 1]
	if not cost then
		return reply(false, "Tu base ya está al máximo")
	end
	if not Progression.TrySpend(player, cost) then
		return reply(false, "Necesitas " .. Util.Money(cost))
	end
	data.BaseLevel += 1
	local b = ctx.Bases.Get(player)
	if b then
		ctx.Bases.RefreshPods(b)
		local zone = b.Model:FindFirstChild("Collector")
		ctx.Effect("place", zone and zone.Position or Vector3.zero, Color3.fromRGB(120, 200, 255))
	end
	Progression.Sync(player)
	return reply(true, "🏗 ¡Base mejorada! Ahora tienes " .. ctx.Bases.UnlockedCount(player) .. " cápsulas")
end

function handlers.Rebirth(player)
	local data = ctx.Data.Get(player)
	local cost = Config.RebirthCost(data.Rebirths)
	if data.Cash < cost then
		return reply(false, "Necesitas " .. Util.Money(cost) .. " para Ascender")
	end
	if ctx.Steal.IsCarrying(player) then
		ctx.Steal.Drop(player, "rebirth")
	end
	ctx.Bases.ClearAll(player)
	data.Rebirths += 1
	setCash(player, Config.StartCash)
	player:SetAttribute("Rebirths", data.Rebirths)
	ctx.Announce("✦ " .. player.DisplayName .. " ASCENDIÓ ✦", "Nivel " .. data.Rebirths .. " • x" .. (1 + data.Rebirths * Config.RebirthBonus) .. " dinero para siempre", Color3.fromRGB(255, 215, 90))
	Progression.Sync(player)
	if player.Character then
		local old = player.Character:FindFirstChild("Head") and player.Character.Head:FindFirstChild("Title")
		if old then
			old:Destroy()
		end
		task.spawn(Progression.OnCharacter, player, player.Character)
	end
	return reply(true, "✦ ¡Ascendiste! Multiplicador x" .. (1 + data.Rebirths * Config.RebirthBonus))
end

function handlers.Redeem(player, code)
	if type(code) ~= "string" then
		return reply(false, "Código inválido")
	end
	code = code:upper():gsub("%s+", "")
	local data = ctx.Data.Get(player)
	local reward = Config.Codes[code]
	if not reward then
		return reply(false, "❌ Ese código no existe (o expiró)")
	end
	if data.Codes[code] then
		return reply(false, "Ya usaste ese código")
	end
	data.Codes[code] = true
	Progression.AddCash(player, reward)
	return reply(true, "🎉 ¡Código canjeado! +" .. Util.Money(reward))
end

function handlers.Daily(player)
	local data = ctx.Data.Get(player)
	local canClaim, nextStreak = dailyState(data)
	if not canClaim then
		return reply(false, "Vuelve mañana para el día " .. ((data.Daily.Streak % 7) + 1))
	end
	data.Daily.Last = today()
	data.Daily.Streak = nextStreak
	local cash = Config.DailyRewards[nextStreak] or 0
	if cash > 0 then
		Progression.AddCash(player, cash)
	end
	if nextStreak == 7 then
		grantAnomaly(player, Config.Day7Anomaly)
		Progression.Sync(player)
		return reply(true, "🎁 ¡Día 7! Recibiste " .. AnomalyData.ById[Config.Day7Anomaly].Name)
	end
	Progression.Sync(player)
	return reply(true, "🎁 Día " .. nextStreak .. ": +" .. Util.Money(cash))
end

function handlers.Mission(player, index)
	local data = ctx.Data.Get(player)
	ensureMissions(data)
	local m = type(index) == "number" and data.Missions.List[index]
	if not m then
		return reply(false, "Misión inválida")
	end
	if m.Claimed or m.Progress < m.Target then
		return reply(false, "Aún no está completa")
	end
	m.Claimed = true
	local reward = missionReward(player, m)
	Progression.AddCash(player, reward)
	Progression.Sync(player)
	return reply(true, "📋 ¡Premio de misión! +" .. Util.Money(reward))
end

function handlers.Tutorial(player)
	local data = ctx.Data.Get(player)
	data.Tutorial = true
	return reply(true)
end

function handlers.Pass(player, key)
	local pass = Config.GamePasses[key]
	if not pass then
		return reply(false, "Pase inválido")
	end
	if player:GetAttribute("Pass_" .. key) then
		return reply(false, "Ya tienes este pase")
	end
	if not pass.Id or pass.Id <= 0 then
		return reply(false, "⚙ Configura el Id de este pase en Shared/Config.lua")
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.Id)
	return reply(true)
end

function handlers.Product(player, key)
	local product = Config.Products[key]
	if not product then
		return reply(false, "Producto inválido")
	end
	if not product.Id or product.Id <= 0 then
		return reply(false, "⚙ Configura el Id de este producto en Shared/Config.lua")
	end
	MarketplaceService:PromptProductPurchase(player, product.Id)
	return reply(true)
end

function Progression.HandleRequest(player, action, arg)
	local h = handlers[action]
	if not h or not ctx.Data.Get(player) then
		return reply(false, "")
	end
	local ok, result = pcall(h, player, arg)
	if not ok then
		warn("[Progression]", action, result)
		return reply(false, "Error")
	end
	return result
end

---------------------------------------------------------------------------
-- Monetización
---------------------------------------------------------------------------
local function grantProduct(player, product)
	if product.Cash then
		Progression.AddCash(player, product.Cash)
	end
	if product.Minutes then
		local amount = math.max(product.Min or 0, math.floor(rawIncome(player) * Progression.Multiplier(player) * 60 * product.Minutes))
		Progression.AddCash(player, amount)
		ctx.Notify(player, "💼 +" .. Util.Money(amount), Color3.fromRGB(110, 255, 140))
	end
	if product.Anomaly then
		local defs = AnomalyData.ByRarity[product.Anomaly]
		grantAnomaly(player, defs[math.random(1, #defs)].Id)
	end
	if product.Blackout then
		ctx.Announce("🌑 " .. player.DisplayName .. " PROVOCÓ UN APAGÓN", "¡Prepárense!", Color3.fromRGB(255, 60, 60))
		ctx.Cycle.ForceBlackout()
	end
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local data = player and ctx.Data.Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if data.Receipts[receipt.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	for _, product in pairs(Config.Products) do
		if product.Id == receipt.ProductId then
			grantProduct(player, product)
			data.Receipts[receipt.PurchaseId] = true
			ctx.Data.Save(player)
			Progression.Sync(player)
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

---------------------------------------------------------------------------
-- Comandos de admin ("admin abuse" en vivo)
---------------------------------------------------------------------------
function Progression.OnChat(player, msg)
	if not isAdmin(player) or msg:sub(1, 1) ~= "/" then
		return
	end
	local args = string.split(msg:sub(2), " ")
	local cmd = (args[1] or ""):lower()
	if cmd == "apagon" then
		ctx.Cycle.ForceBlackout()
	elseif cmd == "surge" then
		ctx.Rift.SpawnSurge()
	elseif cmd == "secreto" then
		ctx.Rift.Spawn({ Id = "entity", Mut = args[2] })
		ctx.Announce("👁 ADMIN ABUSE 👁", "¡La Entidad ∞ salió de la Grieta!", Color3.fromRGB(30, 255, 205))
	elseif cmd == "spawn" and args[2] and AnomalyData.ById[args[2]] then
		ctx.Rift.Spawn({ Id = args[2], Mut = args[3] and Config.MutationById[args[3]] and args[3] or nil })
	elseif cmd == "imitador" then
		local rec = ctx.Rift.RollRecord(3, 1, false)
		rec.Mimic = true
		rec.Tell = Config.MimicTells[math.random(1, #Config.MimicTells)]
		ctx.Rift.Spawn(rec)
	elseif cmd == "dinero" then
		Progression.AddCash(player, tonumber(args[2]) or 100000)
	elseif cmd == "lluvia" then
		ctx.Announce("💸 LLUVIA DE ANOMALÍAS 💸", "¡Admin abuse en la Grieta!", Color3.fromRGB(255, 220, 90))
		task.spawn(function()
			for _ = 1, 12 do
				ctx.Rift.Spawn(ctx.Rift.RollRecord(3, 4, false))
				task.wait(0.8)
			end
		end)
	end
end

function Progression.Init(c)
	ctx = c
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for key, pass in pairs(Config.GamePasses) do
			if pass.Id == passId then
				player:SetAttribute("Pass_" .. key, true)
				ctx.Notify(player, "✅ ¡Gracias! " .. pass.Name .. " activado", Color3.fromRGB(255, 215, 90))
				if key == "Speed" and player.Character then
					local hum = player.Character:FindFirstChildOfClass("Humanoid")
					if hum then
						hum.WalkSpeed = Config.WalkSpeed * 1.25
					end
				end
				Progression.Sync(player)
			end
		end
	end)
	-- Comprobación de cambio de día para las misiones
	task.spawn(function()
		local last = today()
		while true do
			task.wait(30)
			if today() ~= last then
				last = today()
				for _, p in ipairs(Players:GetPlayers()) do
					Progression.Sync(p)
				end
			end
		end
	end)
end

return Progression
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000056B">
				<Properties>
					<string name="Name">Rift</string>
					<ProtectedString name="Source"><![CDATA[-- La Grieta: genera anomalías que desfilan por la cinta. Los jugadores
-- las compran ("Contener") y caminan solas hasta su base.
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local AnomalyData = require(Shared.AnomalyData)
local Util = require(Shared.Util)

local Rift = {}
local ctx
local startPos, endPos

local function flat(v, y)
	return Vector3.new(v.X, y, v.Z)
end

function Rift.Init(c)
	ctx = c
	local map = workspace:WaitForChild("Map")
	startPos = map:WaitForChild("PathStart").Position
	endPos = map:WaitForChild("PathEnd").Position
	startPos = flat(startPos, 1)
	endPos = flat(endPos, 1)
	task.spawn(function()
		task.wait(2)
		while true do
			Rift.Spawn(Rift.RollRecord())
			task.wait(Config.SpawnInterval)
		end
	end)
end

-- minOrder: rareza mínima (para el surge del apagón). mutBoost multiplica las mutaciones.
function Rift.RollRecord(minOrder, mutBoost, allowMimic)
	local pool = {}
	for _, r in ipairs(Config.Rarities) do
		if r.Order >= (minOrder or 1) and AnomalyData.ByRarity[r.Id] then
			table.insert(pool, r)
		end
	end
	local rarity = Util.WeightedPick(pool, "Weight")
	local defs = AnomalyData.ByRarity[rarity.Id]
	local def = defs[math.random(1, #defs)]
	local mut
	for i = #Config.Mutations, 1, -1 do
		local m = Config.Mutations[i]
		if math.random() < m.Chance * (mutBoost or 1) then
			mut = m.Id
			break
		end
	end
	local record = { Id = def.Id, Mut = mut }
	if allowMimic ~= false and not minOrder and rarity.Order >= 2 and math.random() < Config.MimicChance then
		record.Mimic = true
		record.Tell = Config.MimicTells[math.random(1, #Config.MimicTells)]
	end
	return record
end

function Rift.Spawn(record)
	local look = CFrame.lookAt(startPos, endPos)
	if record.Mimic and record.Tell == "inverted" then
		look *= CFrame.Angles(0, math.pi, 0)
	end
	local info = ctx.Anoms.Create(record, look)
	ctx.Anoms.SetState(info, "conveyor")
	local dist = (endPos - startPos).Magnitude
	local goal = look + (endPos - startPos)
	local tween = TweenService:Create(info.Model.Root, TweenInfo.new(dist / Config.ConveyorSpeed, Enum.EasingStyle.Linear), { CFrame = goal })
	info.Tween = tween
	tween.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed and info.State == "conveyor" then
			ctx.Anoms.Destroy(info, "poof", Color3.fromRGB(140, 60, 255))
		end
	end)
	tween:Play()
	ctx.Effect("spawn", startPos + Vector3.new(0, 4, 0), Config.RarityById[info.Def.Rarity].Color)
	local rarity = Config.RarityById[info.Def.Rarity]
	if rarity.Order >= 4 then
		ctx.NotifyAll("✦ ¡Una anomalía " .. rarity.Name:upper() .. " salió de la Grieta: " .. Util.DisplayName(record) .. "!", rarity.Color)
	end
	return info
end

function Rift.SpawnSurge()
	local record = Rift.RollRecord(4, 3, false)
	local info = Rift.Spawn(record)
	local rarity = Config.RarityById[info.Def.Rarity]
	ctx.Announce("¡SURGE EN LA GRIETA!", Util.DisplayName(record) .. " (" .. rarity.Name .. ")", rarity.Color)
	return info
end

local function walkTo(info, target, speed)
	local root = info.Model.Root
	local from = root.Position
	local to = Vector3.new(target.X, target.Y, target.Z)
	local dist = (to - from).Magnitude
	if dist < 0.1 then
		return true
	end
	local face = CFrame.lookAt(from, Vector3.new(to.X, from.Y, to.Z))
	if info.Record.Mimic and info.Record.Tell == "inverted" then
		face *= CFrame.Angles(0, math.pi, 0)
	end
	root.CFrame = face
	local tween = TweenService:Create(root, TweenInfo.new(dist / speed, Enum.EasingStyle.Linear), { CFrame = face + (to - from) })
	info.Tween = tween
	tween:Play()
	local state = tween.Completed:Wait()
	return state == Enum.PlaybackState.Completed and not info.Dead
end

function Rift.Buy(player, info)
	if info.State ~= "conveyor" or info.Dead then
		return
	end
	local b = ctx.Bases.Get(player)
	if not b then
		return
	end
	local podIndex = ctx.Bases.FreePod(b)
	if not podIndex then
		ctx.Notify(player, "📦 ¡Tus cápsulas están llenas! Vende o mejora tu base.", Color3.fromRGB(255, 180, 80))
		return
	end
	local price = Util.Value(info.Record)
	if not ctx.Progression.TrySpend(player, price) then
		ctx.Notify(player, "💸 Te faltan " .. Util.Money(price - ctx.Progression.GetCash(player)), Color3.fromRGB(255, 90, 90))
		return
	end
	local pod = b.Pods[podIndex]
	pod.Reserved = true
	if info.Tween then
		info.Tween:Cancel()
	end
	info.OwnerId = player.UserId
	ctx.Anoms.SetState(info, "walking", player.DisplayName)
	ctx.Progression.Progress(player, "Buy", 1)
	local data = ctx.Data.Get(player)
	data.Stats.Buys += 1
	ctx.Remotes.Effect:FireClient(player, "buy", info.Model.Root.Position + Vector3.new(0, 3, 0), Config.RarityById[info.Def.Rarity].Color)
	if data.Stats.Buys == 1 then
		ctx.Progression.Sync(player)
	end

	task.spawn(function()
		local door = b.Model:FindFirstChild("DoorPoint")
		local ok = true
		if door then
			ok = walkTo(info, Vector3.new(door.Position.X, 1, door.Position.Z), Config.WalkToBaseSpeed)
		end
		if ok and b.Player == player then
			ok = walkTo(info, pod.Anchor.Position, Config.WalkToBaseSpeed)
		end
		if info.Dead then
			pod.Reserved = false
			return
		end
		if not ok or b.Player ~= player then
			pod.Reserved = false
			ctx.Anoms.Destroy(info, "poof")
			return
		end
		ctx.Bases.PlaceInPod(player, podIndex, info.Record, info)
	end)
end

return Rift
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000056C">
				<Properties>
					<string name="Name">Steal</string>
					<ProtectedString name="Source"><![CDATA[-- Robos, capturas, anomalías fugadas, Imitadores, Escáner y Bate.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Steal = {}
local ctx
local carriers = {} -- [player] = { Info, Kind, FromPlayer, FromPod, ToPod }
local roaming = {} -- [info] = true
local cooldowns = { Scan = {}, Swing = {} }
local toolTemplates

local FIELD_X = 210
local FIELD_Z = 32

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function hrpOf(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hum and hrp and hum.Health > 0 then
		return hrp, hum
	end
	return nil
end

local function groundY(x, z)
	rayParams.FilterDescendantsInstances = { ctx.Anoms.Folder, workspace:FindFirstChild("Bases") }
	local hit = workspace:Raycast(Vector3.new(x, 60, z), Vector3.new(0, -120, 0), rayParams)
	return hit and hit.Position.Y or 0
end

local function baseSpeed(player)
	return Config.WalkSpeed * (player:GetAttribute("Pass_Speed") and 1.25 or 1)
end

---------------------------------------------------------------------------
-- Herramientas
---------------------------------------------------------------------------
local function weldTo(handle, part, offset)
	part.CFrame = handle.CFrame * offset
	part.Anchored = false
	part.CanCollide = false
	part.Massless = true
	local w = Instance.new("WeldConstraint")
	w.Part0 = handle
	w.Part1 = part
	w.Parent = part
	part.Parent = handle.Parent
end

local function buildTools()
	local folder = Instance.new("Folder")
	folder.Name = "ToolTemplates"

	-- Escáner
	local scanner = Instance.new("Tool")
	scanner.Name = "Escáner"
	scanner.ToolTip = "Apunta a una anomalía y haz clic para saber si es un IMITADOR"
	scanner.CanBeDropped = false
	scanner.Grip = CFrame.new(0, 0, -0.4, 0, 0, 1, 1, 0, 0, 0, 1, 0)
	local h = Instance.new("Part")
	h.Name = "Handle"
	h.Size = Vector3.new(0.5, 0.9, 1.6)
	h.Color = Color3.fromRGB(40, 40, 55)
	h.Material = Enum.Material.Metal
	h.Parent = scanner
	local screen = Instance.new("Part")
	screen.Name = "Screen"
	screen.Size = Vector3.new(0.52, 0.6, 0.7)
	screen.Color = Color3.fromRGB(80, 255, 170)
	screen.Material = Enum.Material.Neon
	weldTo(h, screen, CFrame.new(0, 0.2, 0.3))
	local lens = Instance.new("Part")
	lens.Name = "Lens"
	lens.Shape = Enum.PartType.Cylinder
	lens.Size = Vector3.new(0.3, 0.5, 0.5)
	lens.Color = Color3.fromRGB(160, 90, 255)
	lens.Material = Enum.Material.Neon
	weldTo(h, lens, CFrame.new(0, 0, 0.85) * CFrame.Angles(0, math.pi / 2, 0))
	local beamAtt = Instance.new("Attachment")
	beamAtt.Name = "Tip"
	beamAtt.Position = Vector3.new(0, 0, 0.95)
	beamAtt.Parent = h
	scanner.Parent = folder

	-- Bate
	local bat = Instance.new("Tool")
	bat.Name = "Bate"
	bat.ToolTip = "Golpea a los ladrones para que suelten tu anomalía"
	bat.CanBeDropped = false
	bat.Grip = CFrame.new(0, 0, -1.5, 0, 0, 1, 1, 0, 0, 0, 1, 0)
	local bh = Instance.new("Part")
	bh.Name = "Handle"
	bh.Size = Vector3.new(0.45, 0.45, 4.2)
	bh.Color = Color3.fromRGB(150, 100, 60)
	bh.Material = Enum.Material.Wood
	bh.Parent = bat
	local barrel = Instance.new("Part")
	barrel.Name = "Barrel"
	barrel.Size = Vector3.new(0.75, 0.75, 2.2)
	barrel.Color = Color3.fromRGB(170, 115, 70)
	barrel.Material = Enum.Material.Wood
	weldTo(bh, barrel, CFrame.new(0, 0, 1.1))
	for i = 0, 1 do
		local stripe = Instance.new("Part")
		stripe.Name = "Stripe"
		stripe.Size = Vector3.new(0.8, 0.8, 0.18)
		stripe.Color = Color3.fromRGB(255, 50, 90)
		stripe.Material = Enum.Material.Neon
		weldTo(bh, stripe, CFrame.new(0, 0, 0.5 + i * 0.9))
	end
	bat.Parent = folder

	folder.Parent = ServerStorage
	return folder
end

local function giveTools(player)
	local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
	if not backpack then
		return
	end
	for _, t in ipairs(toolTemplates:GetChildren()) do
		if not backpack:FindFirstChild(t.Name) and not (player.Character and player.Character:FindFirstChild(t.Name)) then
			t:Clone().Parent = backpack
		end
	end
end

---------------------------------------------------------------------------
-- Cargar anomalías sobre la cabeza
---------------------------------------------------------------------------
local function attach(player, info)
	local hrp, hum = hrpOf(player)
	if not hrp then
		return false
	end
	if info.Tween then
		info.Tween:Cancel()
	end
	local root = info.Model.Root
	root.Anchored = false
	root.Massless = true
	info.Model:PivotTo(hrp.CFrame * CFrame.new(0, 3.2, 0))
	local w = Instance.new("Weld")
	w.Name = "CarryWeld"
	w.Part0 = hrp
	w.Part1 = root
	w.C0 = CFrame.new(0, 3.2, 0)
	w.Parent = root
	hum.WalkSpeed = Config.CarrySpeed * (player:GetAttribute("Pass_Speed") and 1.25 or 1)
	player:SetAttribute("Carrying", Util.DisplayName(info.Record))
	return true
end

local function detach(player, info)
	local root = info.Model and info.Model:FindFirstChild("Root")
	if root then
		local w = root:FindFirstChild("CarryWeld")
		if w then
			w:Destroy()
		end
		root.Anchored = true
	end
	if player then
		local _, hum = hrpOf(player)
		if hum then
			hum.WalkSpeed = baseSpeed(player)
		end
		player:SetAttribute("Carrying", nil)
	end
end

function Steal.IsCarrying(player)
	return carriers[player] ~= nil
end

function Steal.MakeRoaming(info, position, originalOwner)
	info.State = "roaming"
	info.OwnerId = nil
	info.OriginalOwner = originalOwner
	info.RoamSince = os.clock()
	info.NextMove = 0
	local root = info.Model.Root
	root.Anchored = true
	local y = groundY(position.X, position.Z)
	info.Model:PivotTo(CFrame.new(position.X, y, position.Z))
	ctx.Anoms.SetState(info, "roaming")
	roaming[info] = true
end

local function reserveFree(player)
	local b = ctx.Bases.Get(player)
	local i = b and ctx.Bases.FreePod(b)
	if not i then
		ctx.Notify(player, "📦 ¡No tienes cápsulas libres!", Color3.fromRGB(255, 180, 80))
		return nil
	end
	b.Pods[i].Reserved = true
	return i
end

local function unreserve(player, i)
	local b = ctx.Bases.Get(player)
	if b and i and b.Pods[i] then
		b.Pods[i].Reserved = false
	end
end

function Steal.StartSteal(thief, info)
	if info.State ~= "pod" or carriers[thief] or not info.Base then
		return
	end
	local ownerBase = info.Base
	local owner = ownerBase.Player
	if not owner or owner == thief then
		return
	end
	if ctx.Bases.IsLocked(ownerBase) then
		ctx.Notify(thief, "🔒 Esa base está cerrada con láser", Color3.fromRGB(255, 90, 90))
		return
	end
	local hrp = hrpOf(thief)
	if not hrp or (hrp.Position - info.Model.Root.Position).Magnitude > 16 then
		return
	end
	local toPod = reserveFree(thief)
	if not toPod then
		return
	end
	local fromPod = info.PodIndex
	ctx.Bases.RemoveFromPod(ownerBase, fromPod)
	ctx.Bases.RefreshPods(ownerBase)
	carriers[thief] = { Info = info, Kind = "steal", FromPlayer = owner, FromPod = fromPod, ToPod = toPod }
	ctx.Anoms.SetState(info, "carried", thief.DisplayName)
	if not attach(thief, info) then
		Steal.Drop(thief, "fail")
		return
	end
	ctx.Remotes.Alert:FireClient(owner, thief, Util.DisplayName(info.Record))
	ctx.Notify(thief, "🏃 ¡Corre a tu base con " .. Util.DisplayName(info.Record) .. "!", Color3.fromRGB(255, 200, 80))
end

function Steal.Capture(player, info)
	if info.State ~= "roaming" or carriers[player] then
		return
	end
	if info.Record.Mimic and info.Revealed then
		Steal.CatchMimic(player, info)
		return
	end
	local toPod = reserveFree(player)
	if not toPod then
		return
	end
	roaming[info] = nil
	carriers[player] = { Info = info, Kind = "capture", FromPlayer = nil, ToPod = toPod, OriginalOwner = info.OriginalOwner }
	ctx.Anoms.SetState(info, "carried", player.DisplayName)
	if not attach(player, info) then
		Steal.Drop(player, "fail")
		return
	end
	ctx.Notify(player, "✋ ¡Atrapada! Llévala a tu base", Color3.fromRGB(255, 200, 80))
end

function Steal.CatchMimic(player, info)
	if info.State ~= "roaming" or not info.Record.Mimic then
		return
	end
	roaming[info] = nil
	local bounty = math.floor(Util.Value(info.Record) * Config.MimicBountyRatio * 0.5)
	ctx.Anoms.Destroy(info, "expose", Color3.fromRGB(255, 40, 60))
	ctx.Progression.AddCash(player, bounty)
	ctx.Progression.Progress(player, "Expose", 1)
	ctx.Notify(player, "☠ ¡Imitador atrapado! +" .. Util.Money(bounty), Color3.fromRGB(255, 120, 120))
end

function Steal.Deliver(player)
	local c = carriers[player]
	if not c then
		return
	end
	carriers[player] = nil
	local info = c.Info
	detach(player, info)
	local data = ctx.Data.Get(player)
	ctx.Bases.PlaceInPod(player, c.ToPod, info.Record, info)
	local name = Util.DisplayName(info.Record)
	if c.Kind == "steal" then
		data.Stats.Steals += 1
		ctx.Progression.Progress(player, "Steal", 1)
		ctx.Progression.UpdateLeaderstats(player)
		ctx.Notify(player, "😈 ¡Robaste " .. name .. "!", Color3.fromRGB(255, 200, 80))
		if c.FromPlayer and c.FromPlayer.Parent then
			ctx.Notify(c.FromPlayer, "😭 " .. player.DisplayName .. " te robó " .. name, Color3.fromRGB(255, 90, 90))
		end
		local rarity = Config.RarityById[info.Def.Rarity]
		if rarity.Order >= 4 then
			ctx.NotifyAll("🚨 " .. player.DisplayName .. " robó " .. name .. " (" .. rarity.Name .. ")" .. (c.FromPlayer and (" a " .. c.FromPlayer.DisplayName) or ""), rarity.Color)
		end
	else
		data.Stats.Captures += 1
		if c.OriginalOwner ~= player.UserId then
			ctx.Progression.Progress(player, "Capture", 1)
		end
		ctx.Notify(player, "✅ " .. name .. " contenida", Color3.fromRGB(120, 255, 150))
	end
end

function Steal.Drop(player, reason)
	local c = carriers[player]
	if not c then
		return
	end
	carriers[player] = nil
	local info = c.Info
	local hrp = hrpOf(player)
	local pos = (hrp and hrp.Position) or (info.Model.Parent and info.Model.Root.Position) or Vector3.zero
	detach(player, info)
	unreserve(player, c.ToPod)
	if info.Dead or not info.Model.Parent then
		return
	end
	local owner = c.FromPlayer
	if c.Kind == "steal" and owner and owner.Parent and ctx.Bases.Get(owner) then
		local ob = ctx.Bases.Get(owner)
		local pod = ob.Pods[c.FromPod]
		local idx = (pod and pod.Open and not pod.Info and not pod.Reserved) and c.FromPod or ctx.Bases.FreePod(ob)
		if idx then
			ctx.Effect("return", pos + Vector3.new(0, 3, 0), Color3.fromRGB(120, 200, 255))
			ctx.Bases.PlaceInPod(owner, idx, info.Record, info)
			ctx.Notify(owner, "🛡 ¡Recuperaste " .. Util.DisplayName(info.Record) .. "!", Color3.fromRGB(120, 255, 150))
			return
		end
	end
	Steal.MakeRoaming(info, pos, c.OriginalOwner or (owner and owner.UserId))
end

---------------------------------------------------------------------------
-- Apagón: fugas e Imitadores
---------------------------------------------------------------------------
function Steal.TriggerBreaches()
	for _, player in ipairs(Players:GetPlayers()) do
		local b = ctx.Bases.Get(player)
		local data = ctx.Data.Get(player)
		if b and data then
			local chance = math.max(0.03, Config.BreachChance - (data.BaseLevel or 0) * Config.BreachReducePerLevel)
			if math.random() < chance then
				local candidates = {}
				for i, pod in pairs(b.Pods) do
					if pod.Info and pod.Info.State == "pod" and not pod.Info.Record.Mimic then
						table.insert(candidates, i)
					end
				end
				if #candidates > 0 then
					local i = candidates[math.random(1, #candidates)]
					local pos = b.Pods[i].Anchor.Position
					local info = ctx.Bases.RemoveFromPod(b, i)
					ctx.Bases.RefreshPods(b)
					ctx.Effect("breach", pos + Vector3.new(0, 4, 0), Color3.fromRGB(255, 60, 60))
					Steal.MakeRoaming(info, pos, player.UserId)
					ctx.Notify(player, "⚠ ¡" .. Util.DisplayName(info.Record) .. " ESCAPÓ de tu base! ¡Atrápala!", Color3.fromRGB(255, 80, 80))
				end
			end
		end
	end
end

local function revealLook(info)
	for _, p in ipairs(info.Model:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "Root" then
			if p.Name == "Eye" or p.Name == "Pupil" or p.Name == "Iris" then
				p.Color = Color3.fromRGB(255, 20, 30)
				p.Material = Enum.Material.Neon
			else
				p.Color = Color3.fromRGB(15, 10, 15)
				p.Material = Enum.Material.SmoothPlastic
			end
		end
	end
	info.Model:SetAttribute("Glitch", true)
end

function Steal.RevealMimics()
	local any = false
	for _, b in ipairs(ctx.Bases.All()) do
		local owner = b.Player
		if owner then
			for i, pod in pairs(b.Pods) do
				local mimic = pod.Info
				if mimic and mimic.State == "pod" and mimic.Record.Mimic then
					any = true
					-- devora la anomalía más valiosa de la base
					local victimIndex, best = nil, -1
					for j, other in pairs(b.Pods) do
						if j ~= i and other.Info and other.Info.State == "pod" and not other.Info.Record.Mimic then
							local v = Util.Value(other.Info.Record)
							if v > best then
								best, victimIndex = v, j
							end
						end
					end
					if victimIndex then
						local victim = ctx.Bases.RemoveFromPod(b, victimIndex)
						local vname = Util.DisplayName(victim.Record)
						local target = victim.Model.Root.Position
						TweenService:Create(mimic.Model.Root, TweenInfo.new(0.6, Enum.EasingStyle.Back), { CFrame = CFrame.new(target) }):Play()
						task.delay(0.6, function()
							ctx.Anoms.Destroy(victim, "devour", Color3.fromRGB(255, 30, 50))
						end)
						ctx.Notify(owner, "☠ ¡Un IMITADOR devoró tu " .. vname .. "!", Color3.fromRGB(255, 60, 60))
					else
						ctx.Notify(owner, "☠ ¡Tenías un IMITADOR en tu base!", Color3.fromRGB(255, 60, 60))
					end
					local pos = pod.Anchor.Position
					ctx.Bases.RemoveFromPod(b, i)
					mimic.Revealed = true
					revealLook(mimic)
					task.delay(0.7, function()
						if not mimic.Dead then
							Steal.MakeRoaming(mimic, pos, nil)
						end
					end)
				end
			end
			ctx.Bases.RefreshPods(b)
		end
	end
	if any then
		ctx.Announce("☠ LOS IMITADORES DESPERTARON ☠", "Atrápalos para ganar recompensas", Color3.fromRGB(255, 40, 60))
	end
end

-- Amanecer: los imitadores vuelven a la Grieta y las fugadas regresan a casa
function Steal.OnDay()
	for info in pairs(roaming) do
		if info.Record.Mimic and info.Revealed then
			roaming[info] = nil
			ctx.Anoms.Destroy(info, "poof", Color3.fromRGB(140, 60, 255))
		end
	end
	task.delay(Config.BreachReturnDelay, function()
		for info in pairs(roaming) do
			if info.State == "roaming" and not info.Dead then
				local owner = info.OriginalOwner and Players:GetPlayerByUserId(info.OriginalOwner)
				local b = owner and ctx.Bases.Get(owner)
				local idx = b and ctx.Bases.FreePod(b)
				roaming[info] = nil
				if idx then
					ctx.Effect("return", info.Model.Root.Position + Vector3.new(0, 3, 0), Color3.fromRGB(120, 200, 255))
					ctx.Bases.PlaceInPod(owner, idx, info.Record, info)
					ctx.Notify(owner, "🏠 " .. Util.DisplayName(info.Record) .. " volvió a tu base", Color3.fromRGB(120, 200, 255))
				else
					ctx.Anoms.Destroy(info, "poof", Color3.fromRGB(140, 60, 255))
				end
			end
		end
	end)
end

local function roamStep()
	local t = os.clock()
	for info in pairs(roaming) do
		if info.Dead or not info.Model.Parent or info.State ~= "roaming" then
			roaming[info] = nil
		elseif t >= (info.NextMove or 0) then
			local root = info.Model.Root
			local x = math.clamp(root.Position.X + math.random(-60, 60), -FIELD_X, FIELD_X)
			local z = math.random(-FIELD_Z, FIELD_Z)
			local target = Vector3.new(x, groundY(x, z), z)
			local from = root.Position
			local dist = (target - from).Magnitude
			local speed = info.Revealed and 14 or 8
			local face = CFrame.lookAt(from, Vector3.new(target.X, from.Y, target.Z))
			root.CFrame = face
			local tween = TweenService:Create(root, TweenInfo.new(dist / speed, Enum.EasingStyle.Linear), { CFrame = face + (target - from) })
			info.Tween = tween
			tween:Play()
			info.NextMove = t + dist / speed + math.random(5, 25) / 10
		end
	end
end

---------------------------------------------------------------------------
-- Escáner y Bate
---------------------------------------------------------------------------
function Steal.Scan(player, model)
	if typeof(model) ~= "Instance" then
		return
	end
	local info = ctx.Anoms.Registry[model]
	if not info or info.Dead then
		return
	end
	local cd = player:GetAttribute("Pass_ScannerPro") and Config.ScanCooldownPro or Config.ScanCooldown
	if cooldowns.Scan[player] and os.clock() - cooldowns.Scan[player] < cd - 0.1 then
		return
	end
	if info.State ~= "conveyor" and info.State ~= "pod" and info.State ~= "roaming" then
		return
	end
	local hrp = hrpOf(player)
	if not hrp or (hrp.Position - info.Model.Root.Position).Magnitude > Config.ScanRange + 6 then
		return
	end
	cooldowns.Scan[player] = os.clock()
	ctx.Progression.Progress(player, "Scan", 1)
	local rec = info.Record
	if rec.Mimic then
		local bounty = math.floor(Util.Value(rec) * Config.MimicBountyRatio)
		if info.Revealed then
			bounty = math.floor(bounty * 0.5)
		end
		if info.State == "pod" and info.Base then
			local b = info.Base
			local owner = b.Player
			ctx.Bases.RemoveFromPod(b, info.PodIndex)
			ctx.Bases.RefreshPods(b)
			if owner and owner ~= player then
				ctx.Notify(owner, "🔬 " .. player.DisplayName .. " expuso un IMITADOR que tenías en tu base", Color3.fromRGB(255, 200, 80))
			end
		end
		roaming[info] = nil
		ctx.Anoms.Destroy(info, "expose", Color3.fromRGB(255, 40, 60))
		ctx.Progression.AddCash(player, bounty)
		ctx.Progression.Progress(player, "Expose", 1)
		local data = ctx.Data.Get(player)
		data.Stats.Exposed += 1
		ctx.Remotes.ScanResult:FireClient(player, { Mimic = true, Bounty = bounty, Name = info.Def.Name })
		ctx.NotifyAll("🔬 " .. player.DisplayName .. " expuso un IMITADOR disfrazado de " .. info.Def.Name, Color3.fromRGB(255, 120, 120))
	else
		ctx.Remotes.ScanResult:FireClient(player, {
			Mimic = false,
			Name = Util.DisplayName(rec),
			Rarity = info.Def.Rarity,
			Value = Util.Value(rec),
			Income = Util.Income(rec),
			Lore = info.Def.Lore,
		})
	end
end

function Steal.Swing(player)
	if cooldowns.Swing[player] and os.clock() - cooldowns.Swing[player] < Config.BatCooldown then
		return
	end
	local char = player.Character
	if not char or not char:FindFirstChild("Bate") then
		return
	end
	local hrp = hrpOf(player)
	if not hrp then
		return
	end
	cooldowns.Swing[player] = os.clock()
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local ohrp = hrpOf(other)
			if ohrp then
				local offset = ohrp.Position - hrp.Position
				local dist = offset.Magnitude
				if dist <= Config.BatRange and (dist < 4 or hrp.CFrame.LookVector:Dot(offset.Unit) > 0.2) then
					local dir = Vector3.new(offset.X, 0, offset.Z)
					dir = dir.Magnitude > 0.01 and dir.Unit or hrp.CFrame.LookVector
					ctx.Remotes.Knock:FireClient(other, dir, Config.BatForce)
					ctx.Effect("hit", ohrp.Position, Color3.fromRGB(255, 220, 120))
					if carriers[other] then
						ctx.Progression.Progress(player, "Hit", 1)
						ctx.Notify(player, "💥 ¡Le hiciste soltar el botín a " .. other.DisplayName .. "!", Color3.fromRGB(255, 220, 120))
						Steal.Drop(other, "hit")
					end
				end
			end
		end
	end
end

---------------------------------------------------------------------------
function Steal.OnCharacter(player, char)
	local hum = char:WaitForChild("Humanoid", 5)
	if hum then
		hum.WalkSpeed = baseSpeed(player)
		hum.Died:Connect(function()
			Steal.Drop(player, "died")
		end)
	end
	giveTools(player)
end

function Steal.OnLeave(player)
	Steal.Drop(player, "left")
	cooldowns.Scan[player] = nil
	cooldowns.Swing[player] = nil
end

function Steal.Init(c)
	ctx = c
	toolTemplates = buildTools()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.1 then
			return
		end
		acc = 0
		for player, c2 in pairs(carriers) do
			local hrp = hrpOf(player)
			if not hrp or c2.Info.Dead then
				Steal.Drop(player, "dead")
			elseif ctx.Bases.IsInside(ctx.Bases.Get(player), hrp.Position) then
				Steal.Deliver(player)
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			roamStep()
		end
	end)
end

return Steal
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000056D">
				<Properties>
					<string name="Name">Cycle</string>
					<ProtectedString name="Source"><![CDATA[-- Ciclo global de 5 minutos: Día -> ¡APAGÓN! (45 s).
-- Durante el apagón se apagan los láseres, la Grieta escupe una anomalía
-- Legendaria+, los Imitadores despiertan y algunas anomalías se fugan.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Cycle = {}
local ctx
local forced = false
local fx = {}
local lamps = {}

local function now()
	return workspace:GetServerTimeNow()
end

local function getOrMake(className, name, parent)
	local inst = parent:FindFirstChild(name)
	if not inst then
		inst = Instance.new(className)
		inst.Name = name
		inst.Parent = parent
	end
	return inst
end

local function setupWorld()
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.8
	Lighting.ClockTime = 17.4
	Lighting.GeographicLatitude = 30
	fx.Atmosphere = getOrMake("Atmosphere", "Atmosphere", Lighting)
	fx.Bloom = getOrMake("BloomEffect", "Bloom", Lighting)
	fx.Color = getOrMake("ColorCorrectionEffect", "ColorCorrection", Lighting)
	fx.SunRays = getOrMake("SunRaysEffect", "SunRays", Lighting)
	fx.Bloom.Intensity = 0.9
	fx.Bloom.Size = 30
	fx.Bloom.Threshold = 0.9
	fx.SunRays.Intensity = 0.08
	fx.Atmosphere.Offset = 0.15
	fx.Atmosphere.Glare = 0.3
	fx.Atmosphere.Haze = 1.6

	local map = workspace:WaitForChild("Map")
	for _, d in ipairs(map:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == "LampBulb" then
			local light = Instance.new("PointLight")
			light.Color = Color3.fromRGB(255, 200, 140)
			light.Range = 26
			light.Brightness = 1.6
			light.Shadows = false
			light.Parent = d
			table.insert(lamps, { Part = d, Light = light, Color = d.Color })
		end
	end

	-- Efectos de la Grieta
	local rift = map:FindFirstChild("Rift")
	local core = rift and rift:FindFirstChild("RiftCore")
	if core then
		local att = Instance.new("Attachment")
		att.Parent = core
		local e = Instance.new("ParticleEmitter")
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Color = ColorSequence.new(Color3.fromRGB(190, 90, 255), Color3.fromRGB(60, 255, 220))
		e.Rate = 40
		e.Lifetime = NumberRange.new(1.5, 3)
		e.Speed = NumberRange.new(4, 9)
		e.SpreadAngle = Vector2.new(25, 25)
		e.EmissionDirection = Enum.NormalId.Right
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
		e.LightEmission = 1
		e.Parent = att
		local smoke = Instance.new("ParticleEmitter")
		smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
		smoke.Color = ColorSequence.new(Color3.fromRGB(90, 20, 160))
		smoke.Rate = 12
		smoke.Lifetime = NumberRange.new(2, 4)
		smoke.Speed = NumberRange.new(1, 3)
		smoke.SpreadAngle = Vector2.new(180, 180)
		smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 10) })
		smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
		smoke.LightEmission = 0.5
		smoke.Parent = att
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(170, 80, 255)
		light.Range = 45
		light.Brightness = 4
		light.Parent = core
		fx.RiftLight = light
	end
	local function sign(part, face, text, color)
		if not part then
			return
		end
		local sg = Instance.new("SurfaceGui")
		sg.Face = face
		sg.LightInfluence = 0
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 30
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Font = Enum.Font.FredokaOne
		t.TextScaled = true
		t.TextColor3 = color
		t.Text = text
		local s = Instance.new("UIStroke")
		s.Thickness = 4
		s.Parent = t
		t.Parent = sg
		sg.Parent = part
	end
	local void = map:FindFirstChild("VoidExit")
	sign(rift and rift:FindFirstChild("RiftSign"), Enum.NormalId.Right, "LA GRIETA", Color3.fromRGB(200, 120, 255))
	sign(void and void:FindFirstChild("VoidSign"), Enum.NormalId.Left, "EL VACÍO", Color3.fromRGB(255, 80, 100))
	local vcore = void and void:FindFirstChild("VoidCore")
	if vcore then
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 60, 80)
		light.Range = 30
		light.Brightness = 3
		light.Parent = vcore
	end
end

local function tween(obj, t, props)
	local tw = TweenService:Create(obj, TweenInfo.new(t, Enum.EasingStyle.Sine), props)
	tw:Play()
	return tw
end

local function applyDay(t)
	tween(Lighting, t, {
		ClockTime = 17.4,
		Brightness = 2.4,
		Ambient = Color3.fromRGB(70, 60, 95),
		OutdoorAmbient = Color3.fromRGB(120, 100, 150),
		ExposureCompensation = 0.1,
	})
	tween(fx.Atmosphere, t, {
		Density = 0.32,
		Color = Color3.fromRGB(205, 170, 255),
		Decay = Color3.fromRGB(110, 70, 150),
	})
	tween(fx.Color, t, {
		TintColor = Color3.fromRGB(255, 245, 255),
		Saturation = 0.15,
		Contrast = 0.12,
		Brightness = 0.02,
	})
	for _, l in ipairs(lamps) do
		l.Light.Enabled = true
		l.Part.Material = Enum.Material.Neon
		l.Part.Color = l.Color
	end
	if fx.RiftLight then
		tween(fx.RiftLight, t, { Color = Color3.fromRGB(170, 80, 255), Brightness = 4 })
	end
end

local function applyNight(t)
	tween(Lighting, t, {
		ClockTime = 23.9,
		Brightness = 0.3,
		Ambient = Color3.fromRGB(40, 6, 12),
		OutdoorAmbient = Color3.fromRGB(55, 10, 18),
		ExposureCompensation = -0.2,
	})
	tween(fx.Atmosphere, t, {
		Density = 0.5,
		Color = Color3.fromRGB(110, 20, 35),
		Decay = Color3.fromRGB(40, 0, 10),
	})
	tween(fx.Color, t, {
		TintColor = Color3.fromRGB(255, 190, 190),
		Saturation = -0.25,
		Contrast = 0.3,
		Brightness = -0.03,
	})
	for _, l in ipairs(lamps) do
		l.Light.Enabled = false
		l.Part.Material = Enum.Material.SmoothPlastic
		l.Part.Color = Color3.fromRGB(40, 35, 30)
	end
	if fx.RiftLight then
		tween(fx.RiftLight, t, { Color = Color3.fromRGB(255, 40, 60), Brightness = 8 })
	end
end

local function setPhase(name, duration)
	workspace:SetAttribute("Phase", name)
	workspace:SetAttribute("PhaseEnds", now() + duration)
end

local function waitUntil(t, allowForce)
	while now() < t do
		if allowForce and forced then
			return
		end
		task.wait(0.2)
	end
end

function Cycle.ForceBlackout()
	if workspace:GetAttribute("Phase") == "Day" then
		forced = true
	end
end

function Cycle.Init(c)
	ctx = c
	setupWorld()
	applyDay(0.1)
	task.spawn(function()
		while true do
			-- DÍA
			forced = false
			local dayLen = Config.CycleLength - Config.BlackoutDuration
			setPhase("Day", dayLen)
			applyDay(4)
			ctx.Steal.OnDay()
			local ends = now() + dayLen
			waitUntil(ends - Config.BlackoutWarning, true)
			if forced then
				ends = now() + 5
				setPhase("Day", 5)
			end
			ctx.Announce("⚠ APAGÓN EN " .. math.max(1, math.floor(ends - now())) .. "s ⚠", "¡Protege tu base! La Grieta va a despertar", Color3.fromRGB(255, 120, 60))
			waitUntil(ends, false)

			-- APAGÓN
			setPhase("Blackout", Config.BlackoutDuration)
			applyNight(1.5)
			ctx.Bases.UnlockAll()
			ctx.Announce("☾ ¡APAGÓN! ☽", "Láseres caídos • Surge en la Grieta • Cuidado con los Imitadores", Color3.fromRGB(255, 40, 60))
			task.delay(1.5, function()
				ctx.Rift.SpawnSurge()
				ctx.Steal.RevealMimics()
				ctx.Steal.TriggerBreaches()
			end)
			waitUntil(now() + Config.BlackoutDuration, false)
			for _, player in ipairs(Players:GetPlayers()) do
				ctx.Progression.Progress(player, "Survive", 1)
			end
			ctx.Announce("☀ AMANECE ☀", "Sobreviviste al apagón", Color3.fromRGB(255, 220, 120))
		end
	end)
end

return Cycle
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
