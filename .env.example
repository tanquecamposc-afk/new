# Copia este archivo a .env.local y ajusta los valores. Nunca pongas secretos aquí.
# Entorno: development | production
VITE_APP_ENV=development
# Servidor de juego. Vacío = mismo origen en /ws (npm start, o el proxy de Vite en dev).
VITE_SERVER_URL=
VITE_WS_URL=
# Servidor (Node): puerto y carpeta del cliente compilado
PORT=2567
STATIC_DIR=dist
VITE_API_URL=
# Feature flags
VITE_ENABLE_DEBUG=true
